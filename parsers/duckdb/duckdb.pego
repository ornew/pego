package duckdb

// ===================================================================================================
// Names, literals and types
// ===================================================================================================

// An identifier, a keyword used as a name, or a string used as a name, as written (quotes included).
type Ident terminal
// A qualified name: a, a.b, a.b.c
type Name = { Parts []Ident }

type Number terminal    // an integer, decimal or real literal as written
type StringLit terminal // a string literal as written: '...', E'...', $$...$$, U&'...'
type BitLit terminal    // B'...' or X'...'
type BoolLit terminal   // TRUE or FALSE
type NullLit terminal   // NULL
type Param terminal     // ?, ?1, $1 or $name

// A type: its name as written ("int", "double precision", "a.b.t"), and its modifiers, fields and array dimensions.
type Type = {
    Name   string
    Mods   []Expr      // (10, 2) of decimal(10, 2); the length of varchar(20)
    Fields []TypeField // struct(a int, b text) and union(...)
    Elems  []Type      // the key and value types of map(k, v)
    Dims   []ArrayDim  // [] and [3]
    Zone   string      // WITH TIME ZONE, WITHOUT TIME ZONE
}
type TypeField = { Name Ident; Type Type }
type ArrayDim = { Size *Number }

// ===================================================================================================
// Expressions
// ===================================================================================================

type Paren = { X Expr }
type ColumnRef = { Parts []Ident }
type DefaultExpr terminal                  // DEFAULT
type PositionalRef = { Index Number } // #1

// * and t.* with their modifiers, and COLUMNS(...) and UNPACK(...)
type Star = {
    Qualifier *Ident
    Exclude   []Name
    Replace   []ReplaceItem
    Rename    []RenameItem
}
type ReplaceItem = { Expr Expr; Name Ident }
type RenameItem = { From Name; To Ident }
type ColumnsExpr = { Arg Expr; Star bool } // COLUMNS(expr) and *COLUMNS(expr)
type UnpackExpr = { Arg Expr }

type Binary = { Left Expr; Op Match; Right Expr } // a + b, a AND b, a = b, a -> b, a ~~ b, ...
type Unary = { Op Match; X Expr }                 // -a, +a, ~a
type PostfixOp = { X Expr; Op Match }             // a !
type Not = { X Expr }
type IsExpr = { X Expr; Negated bool; Test string } // IS [NOT] NULL|TRUE|FALSE|UNKNOWN, ISNULL, NOTNULL, NOT NULL
type DistinctFrom = { Left Expr; Right Expr; Negated bool }
type IsOf = { X Expr; Types []Type; Negated bool }
type Between = { X Expr; Lo Expr; Hi Expr; Negated bool; Symmetric bool }
// x IN (a, b), x IN (SELECT ...), x IN y
type In = { X Expr; Negated bool; Query *ParenQuery; Items []Expr; Source *Expr }
// x [NOT] LIKE|ILIKE|GLOB|SIMILAR TO pattern [ESCAPE esc]
type Like = { X Expr; Negated bool; Op string; Pattern Expr; Escape *Expr }
// x = ANY (subquery), x < ALL (...)
type AnyAll = { X Expr; Op string; Quantifier string; Source Expr }
type AtTimeZone = { X Expr; Zone Expr }
type Collate = { X Expr; Collation Name }
type Cast = { X Expr; Type Type; Try bool; Shorthand bool } // CAST(x AS t), TRY_CAST, x::t
type Case = { Arg *Expr; Whens []When; Else *Expr }
type When = { Cond Expr; Then Expr }
type Row = { Items []Expr; Keyword bool } // ROW(a, b) and (a, b)
type ListLit = { Items []Expr }           // [a, b]
type ArrayLit = { Items []Expr }          // ARRAY[a, b]
type StructLit = { Fields []StructField } // {'a': 1, b: 2}
type StructField = { Name Ident; Value Expr }
type MapLit = { Entries []MapEntry } // MAP {k: v}
type MapEntry = { Key Expr; Value Expr }
type ListComp = { Expr Expr; Vars []Ident; Source Expr; Cond Expr } // [x + 1 FOR x IN l IF x > 1]
type Lambda = { Params []Ident; Body Expr; Keyword bool }           // x -> body is a Binary; LAMBDA x: body
type Subquery = { Query ParenQuery }                                // (SELECT ...)
type Exists = { Query ParenQuery }
type ArraySubquery = { Query ParenQuery }              // ARRAY(SELECT ...)
type Grouping = { Name string; Args []Expr }           // GROUPING(a, b), GROUPING_ID(a, b)
type TypedLit = { Type Type; Value StringLit }         // DATE '2020-01-01', DECIMAL(10, 2) '1.5'
type IntervalLit = { Value Expr; Unit *IntervalUnit }  // INTERVAL '1' DAY, INTERVAL (x) HOUR, INTERVAL 5 DAY
type IntervalUnit terminal                                  // DAY, YEAR TO MONTH, ...
type NamedArg = { Name Ident; Value Expr; Arrow bool } // name := value, name => value (Arrow)
// A function call, with the clauses that follow it.
type FuncCall = {
    Name        Name
    Quantifier  string // ALL or DISTINCT
    Args        []Expr
    Variadic    *Expr
    OrderBy     *OrderBy
    Nulls       string // IGNORE NULLS or RESPECT NULLS
    WithinGroup *OrderBy
    Filter      *Expr
    ExportState bool
    Over        *WindowOver
}
// The functions with a syntax of their own: COALESCE, NULLIF, EXTRACT(part FROM x), OVERLAY(x PLACING y FROM a FOR b),
// POSITION(a IN b), SUBSTRING(x FROM a FOR b), TRIM([BOTH|LEADING|TRAILING] chars FROM x), TREAT(x AS t),
// COLLATION FOR (x)
type SpecialCall = {
    Name    string
    Spec    string // the part of EXTRACT, the side of TRIM
    Args    []Expr
    From    []Expr
    For     *Expr
    Placing *Expr
    Chars   *Expr // the characters of TRIM(BOTH chars FROM x)
    Type    *Type
}
// An indirection of an expression: x.field, x.method(args), x[i], x[lo:hi], x[lo:hi:step]; x.a[1] is two of them.
type Indirection = { X Expr; Step Step }
type Step ~ FieldStep | IndexStep | SliceStep
type FieldStep = { Name Ident; Call bool; Args []Expr }
type IndexStep = { Index Expr }
type SliceStep = { Lo *Expr; Hi *Expr; Stride *Expr; Dash bool }

type WindowOver = { Name *Ident; Spec *WindowSpec }
type WindowSpec = { Base *Ident; PartitionBy []Expr; OrderBy *OrderBy; Frame *Frame }
type Frame = { Unit string; Start FrameBound; End *FrameBound; Exclude string }
type FrameBound = { Kind string; Expr *Expr }
type WindowDef = { Name Ident; Spec WindowSpec }

type OrderBy = { Items []SortItem; All bool; Direction string; Nulls string }
type SortItem = { Expr Expr; Using string; Direction string; Nulls string }

type Expr ~ Number | StringLit | BitLit | BoolLit | NullLit | Param | Paren | ColumnRef | DefaultExpr | PositionalRef | Star | ColumnsExpr | UnpackExpr | Binary | Unary | PostfixOp | Not | IsExpr | DistinctFrom | IsOf | Between | In | Like | AnyAll | AtTimeZone | Collate | Cast | Case | Row | ListLit | ArrayLit | StructLit | MapLit | ListComp | Lambda | Subquery | Exists | ArraySubquery | Grouping | TypedLit | IntervalLit | NamedArg | FuncCall | SpecialCall | Indirection | GroupingSet
type GroupingSet = { Kind string; Items []Expr } // CUBE(...), ROLLUP(...), GROUPING SETS(...), ()
// ===================================================================================================
// Queries
// ===================================================================================================

// A query as a statement or in parentheses: WITH, a body (SELECT, set operations, VALUES, ...), and what orders and
// limits it.
type Select = {
    With    *With
    Body    QueryBody
    OrderBy *OrderBy
    Limit   *LimitClause
    Offset  *OffsetClause
    Locking []LockClause
}
type ParenQuery = { Query ParenContent }
type ParenContent ~ Select | ParenQuery | ShowStmt
type QueryBody ~ SelectCore | ValuesClause | TableQuery | PivotQuery | UnpivotQuery | SetOp | ParenQuery

type With = { Recursive bool; CTEs []CTE }
type CTE = { Name Ident; Columns []Ident; UsingKey []Ident; Materialized *Match; Query Statement }

// UNION, EXCEPT and INTERSECT
type SetOp = { Left QueryBody; Op string; Quantifier string; ByName bool; Right QueryBody }

type SelectCore = {
    FromFirst bool // FROM t SELECT ...
    Distinct  *DistinctClause
    Items     []SelectItem
    Into      *IntoClause
    From      []TableRef
    Where     *Expr
    GroupBy   *GroupBy
    Having    *Expr
    Windows   []WindowDef
    Qualify   *Expr
    Sample    *SampleClause
}
type DistinctClause = { On []Expr }
type SelectItem = { Expr Expr; Alias *Ident; As bool; Prefix bool } // expr AS alias, expr alias, alias: expr
type IntoClause = { Temp string; Table Name }
type GroupBy = { All bool; Items []Expr }
type ValuesClause = { Rows []ValuesRow }
type ValuesRow = { Items []Expr }
type TableQuery = { Table Name } // TABLE t
type PivotQuery = { Source TableRef; On []PivotColumn; Using []SelectItem; GroupBy []Ident }
type PivotColumn = { Expr Expr; In []SelectItem; Query *Select; Enum *Ident }
type UnpivotQuery = { Source TableRef; On []SelectItem; Name *Ident; Values []Ident }

type LimitClause = { Keyword string; All bool; Value *Expr; Percent string; Offset *Expr }
type OffsetClause = { Value Expr; Rows string }
type LockClause = { Strength string; Of []Name; Wait string }

type SampleClause = { Method *Ident; Value Expr; Unit string; Repeatable *Number; Seed *Number }
type AtClause = { Unit string; Value Expr }

// ---- Tables in FROM ----

// An alias of a table: t, AS t, t(a, b); that of a function can name the columns with their types (t(a int)), and may
// have no name (AS (a int)).
type TableAlias = { Name *Ident; Columns []Ident; ColDefs []ColDef; As bool }
type ColDef = { Name Ident; Type Type; Collate *Name }
type BaseTable = { Prefix *Ident; Name Name; Only bool; Star bool; Alias *TableAlias; At *AtClause; Sample *SampleClause }
type FuncTable = {
    Prefix     *Ident // the alias in alias: f(x)
    Func       Expr
    RowsFrom   []RowsFromItem
    Lateral    bool
    Ordinality bool
    Alias      *TableAlias
    Sample     *SampleClause
}
type RowsFromItem = { Func Expr; ColDefs []ColDef }
type SubqueryRef = { Prefix *Ident; Query ParenQuery; Lateral bool; Alias *TableAlias; Sample *SampleClause }
type ValuesRef = { Prefix *Ident; Values ValuesClause; Alias TableAlias; Sample *SampleClause }
type ParenTable = { Prefix *Ident; Table TableRef; Alias *TableAlias }
// Kind: the words before JOIN: LEFT OUTER, NATURAL, CROSS, ...
type Join = { Left TableRef; Kind string; Right TableRef; On *Expr; Using []Ident }
type PivotRef = { Source TableRef; Aggregates []SelectItem; Values []PivotValue; GroupBy []Ident; Alias *TableAlias }
type PivotValue = { Header []Expr; Items []SelectItem; Enum *Ident }
type UnpivotRef = { Source TableRef; IncludeNulls *Match; Header []Ident; Values []UnpivotValue; Alias *TableAlias }
type UnpivotValue = { Header []Ident; Items []SelectItem }
type TableRef ~ BaseTable | FuncTable | SubqueryRef | ValuesRef | ParenTable | Join | PivotRef | UnpivotRef
// ===================================================================================================
// Statements
// ===================================================================================================

// The statements of a script, separated by semicolons.
type Script = { Statements []Statement }

type Statement ~ Select | InsertStmt | UpdateStmt | DeleteStmt | MergeStmt | CreateTableStmt | CreateTableAsStmt | CreateViewStmt | CreateIndexStmt | CreateSchemaStmt | CreateSequenceStmt | CreateTypeStmt | CreateMacroStmt | CreateSecretStmt | AlterTableStmt | AlterSequenceStmt | AlterDatabaseStmt | AlterObjectSchemaStmt | RenameStmt | DropStmt | DropSecretStmt | CopyStmt | CopyDatabaseStmt | ExportStmt | ImportStmt | AttachStmt | DetachStmt | UseStmt | LoadStmt | PragmaStmt | SetStmt | ResetStmt | ShowStmt | ExplainStmt | PrepareStmt | ExecuteStmt | DeallocateStmt | TransactionStmt | VacuumStmt | AnalyzeStmt | CheckpointStmt | CallStmt | CommentStmt | UpdateExtensionsStmt

// The table of INSERT, UPDATE, DELETE and MERGE, with its alias.
type TargetTable = { Name Name; Only bool; Star bool; Alias *Ident; As bool }

// ---- DML ----

type InsertStmt = {
    With          *With
    OrAction      string // OR REPLACE, OR IGNORE
    Table         Name
    Alias         *Ident
    By            string // BY NAME, BY POSITION
    Columns       []Name
    Overriding    string // OVERRIDING USER VALUE, OVERRIDING SYSTEM VALUE
    Query         *Select
    DefaultValues bool
    OnConflict    *OnConflict
    Returning     []SelectItem
}
type OnConflict = {
    Target      []IndexElem
    TargetWhere *Expr
    Constraint  *Ident
    Nothing     bool
    Set         []SetClause
    Where       *Expr
}
type IndexElem = { Expr Expr; Collate *Name; Class *Name; Direction string; Nulls string }
type SetClause = { Targets []Name; Value Expr; Paren bool }

type UpdateStmt = { With *With; Table TargetTable; Set []SetClause; From []TableRef; Where *Expr; Returning []SelectItem }
type DeleteStmt = { With *With; Table TargetTable; Using []TableRef; Where *Expr; Returning []SelectItem; Truncate bool }
type MergeStmt = { With *With; Target TargetTable; Source TableRef; On *Expr; Using []Ident; Whens []MergeWhen; Returning []SelectItem }
type MergeWhen = { Not bool; By string; Cond *Expr; Action MergeAction }
// UPDATE SET ..., UPDATE SET *, UPDATE [BY NAME], DELETE, INSERT (cols) VALUES (...), INSERT [BY NAME] [*], INSERT DEFAULT VALUES,
// DO NOTHING, ERROR [message]
type MergeAction = {
    Kind          string
    Set           []SetClause
    ByName        string
    Star          bool
    Columns       []Ident
    Values        []Expr
    DefaultValues bool
    Message       *Expr
}

// ---- CREATE ----

type CreateTableStmt = {
    OrReplace       bool
    Temp            string
    IfNotExists     bool
    Name            Name
    Elements        []TableElement
    PartitionSorted []PartitionSorted
    With            []Reloption
    OnCommit        string
}
// PARTITIONED BY (...) or SORTED BY (...)
type PartitionSorted = { Kind Match; Exprs []Expr }
type TableElement ~ ColumnDef | TableConstraint | TableLike
type ColumnDef = { Name Ident; Type *Type; Generated *GeneratedColumn; Constraints []ColumnConstraint }
// GENERATED ALWAYS AS IDENTITY, GENERATED ALWAYS AS (expr) [VIRTUAL|STORED], AS (expr)
type GeneratedColumn = { When string; Identity bool; SeqOptions []SeqOption; Expr *Expr; Storage string }
type ColumnConstraint = {
    Name        *Ident
    Kind        string // NOT NULL, NULL, UNIQUE, PRIMARY KEY, CHECK, DEFAULT, REFERENCES, COLLATE, USING COMPRESSION, DEFERRABLE, ...
    Expr        *Expr
    Reference   *Reference
    Collation   *Name
    Compression *Ident
    Options     []DefElem
}
type Reference = { Table Name; Columns []Ident; Match *Match; OnUpdate *Match; OnDelete *Match }
type TableConstraint = {
    Name       *Ident
    Kind       string // CHECK, UNIQUE, PRIMARY KEY, FOREIGN KEY
    Columns    []Ident
    Expr       *Expr
    Reference  *Reference
    Index      *Ident // USING INDEX name
    Options    []DefElem
    Attributes []Match // DEFERRABLE, NOT VALID, ...
}
type TableLike = { Table Name; Options []Match }
// name = value in WITH (...) options: the value is a type, a keyword, an operator, a number or a string.
type DefElem = { Name Ident; Value string }
// A storage option: name, name = expr, a.b = value
type Reloption = { Name Name; Value *Expr; Arg *Match }
type GenericOption = { Name Ident; Value *Expr }

type CreateTableAsStmt = {
    OrReplace       bool
    Temp            string
    IfNotExists     bool
    Name            Name
    Columns         []Ident
    PartitionSorted []PartitionSorted
    With            []Reloption
    OnCommit        string
    Source          Statement // a query, or EXECUTE
    WithData        string    // WITH DATA, WITH NO DATA
}
type CreateViewStmt = {
    OrReplace   bool
    Temp        string
    Recursive   bool
    IfNotExists bool
    Name        Name
    Columns     []Ident
    Options     []Reloption
    Query       Select
    CheckOption string
}
type CreateIndexStmt = {
    Unique       bool
    Concurrently bool
    IfNotExists  bool
    Name         *Ident
    Table        Name
    Method       *Ident
    Params       []IndexElem
    Options      []Reloption
    Where        *Expr
}
type CreateSchemaStmt = { OrReplace bool; IfNotExists bool; Name Name; Elements []Statement }
type CreateSequenceStmt = { OrReplace bool; Temp string; IfNotExists bool; Name Name; Options []SeqOption }
type SeqOption = { Kind string; Type *Type; Value string; Owner *Name }
type CreateTypeStmt = {
    OrReplace   bool
    Temp        string
    IfNotExists bool
    Name        Name
    Enum        bool
    Values      []StringLit
    Query       *ParenQuery
    Type        *Type
}
type CreateMacroStmt = { OrReplace bool; Temp string; Function bool; IfNotExists bool; Name Name; Definitions []MacroDef }
type MacroDef = { Params []MacroParam; Expr *Expr; Query *ParenContent }
type MacroParam = { Name Ident; Type *Type; Default *Expr; Arrow bool }
type CreateSecretStmt = { OrReplace bool; Persist string; IfNotExists bool; Name *Ident; Storage *Ident; Options []SecretOption }
type SecretOption = { Name Ident; Value Expr }

// ---- ALTER, RENAME, DROP ----

type AlterTableStmt = { Object string; IfExists bool; Name Name; Only bool; Star bool; Commands []AlterCmd }
// One command of ALTER TABLE: Kind holds its words (ADD COLUMN, DROP CONSTRAINT, ALTER COLUMN ... SET DEFAULT, ...)
type AlterCmd = {
    Kind        string
    IfExists    bool
    IfNotExists bool
    Column      *Name
    Type        *Type
    Generated   *GeneratedColumn
    Constraints []ColumnConstraint
    Constraint  *TableConstraint
    Name        *Ident
    Expr        *Expr
    Exprs       []Expr
    SortBy      []SortItem
    Collate     *Name
    Using       *Expr
    Value       string
    Options     []Reloption
    Identity    []SeqOption
    When        string
    Behavior    string
    Generic     []GenericAlterOption
}
type GenericAlterOption = { Action string; Name Ident; Value *StringLit }
type AlterSequenceStmt = { IfExists bool; Name Name; Options []SeqOption }
type AlterDatabaseStmt = { IfExists bool; Name Ident; Setting Ident; Value Ident }
type AlterObjectSchemaStmt = { Object string; IfExists bool; Name Name; Schema Ident }
type RenameStmt = { Object string; IfExists bool; Name Name; Column *Name; Constraint *Ident; NewName Ident }
type DropStmt = { Type string; IfExists bool; Names []Name; On *Name; Behavior string }
type DropSecretStmt = { Persist string; IfExists bool; Name Ident; Storage *Ident }

// ---- COPY, EXPORT, ATTACH, ... ----

type CopyStmt = {
    Binary     bool
    Table      *Name
    Columns    []Ident
    Query      *Select
    Direction  string // FROM or TO
    Program    bool
    File       *Expr
    Std        string // STDIN, STDOUT
    Delimiters *StringLit
    Legacy     []CopyOption
    Options    []GenericOption
}
type CopyOption = { Name string; Value string; Columns []Ident }
type CopyDatabaseStmt = { From Ident; To Ident; Flag string }
type ExportStmt = { Database *Ident; Path StringLit; Legacy []CopyOption; Options []GenericOption }
type ImportStmt = { Path StringLit }
type AttachStmt = { OrReplace bool; IfNotExists bool; Database bool; Path StringLit; Alias *Ident; Options []GenericOption }
type DetachStmt = { Database bool; IfExists bool; Name Ident }
type UseStmt = { Name Name }
type LoadStmt = { Install bool; Force bool; Name Ident; Source *Ident; Version *Ident }
type PragmaStmt = { Name Ident; Values []Expr; Args []Expr; Call bool }
type SetStmt = { Scope string; Name *Name; Values []Expr; TimeZone string; FromCurrent bool; Schema *StringLit }
type ResetStmt = { Scope string; Name *Name; All bool; Special string }
// SHOW, DESCRIBE and SUMMARIZE
type ShowStmt = { Kind string; Query *Select; Name *Name; Tables bool; From *Name; Special string; All bool }
type ExplainStmt = { Analyze string; Verbose bool; Options []ExplainOption; Stmt Statement }
type ExplainOption = { Name string; Value string }
type PrepareStmt = { Name Ident; Types []Type; Stmt Statement }
type ExecuteStmt = { Name Ident; Params []Expr }
type DeallocateStmt = { Name *Ident; All bool }
type TransactionStmt = { Kind string; Work string; Mode string }
type VacuumStmt = { Full bool; Freeze bool; Verbose bool; Options []Match; Analyze *AnalyzeStmt; Table *Name; Columns []Ident }
type AnalyzeStmt = { Verbose bool; Table *Name; Columns []Ident }
type CheckpointStmt = { Force bool; Database *Ident }
type CallStmt = { Func FuncCall }
type CommentStmt = { Object string; Name *Name; Column *Expr; Comment *StringLit }
type UpdateExtensionsStmt = { With *With; Names []Ident }
// ===================================================================================================
// Lexical structure (scan.l)
//
// The scanner of DuckDB (PostgreSQL's flex scanner) is part of the grammar: a rule for a token matches the
// token only, and whitespace and comments are skipped between tokens, where a rule needs them, with ws
// written before the token it precedes. The keywords are rules of their own (SELECT, GROUP, ...),
// generated at the end of the file.
// ===================================================================================================

// Whitespace is the five characters of the scanner's {space}, "--" comments, and /* */ comments, which nest.
rule ws = [\t\n\u{c}\r \u{a0}\u{2000}-\u{200b}\u{202f}\u{205f}\u{2060}\u{3000}\u{feff}]* (comment [\t\n\u{c}\r \u{a0}\u{2000}-\u{200b}\u{202f}\u{205f}\u{2060}\u{3000}\u{feff}]*)*
rule comment = "--" [^\r\n]* / block_comment
rule block_comment = "/*" (block_comment / !"*/" .)* "*/"

// A character that can continue an identifier or a keyword: the scanner's {ident_cont}, which takes every byte
// of a non-ASCII character.
rule wc = [a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]
rule ident_start = [a-zA-Z_\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

// ---- Identifiers ----

// An unquoted word or a quoted identifier. Case is preserved: the scanner of DuckDB does not fold it.
// NULLS before FIRST or LAST is the token NULLS_LA of the scanner, which is not a name
rule word = !([eEbBxXnN] "'" / [uU] "&'") !(&[nN] NULLS ws (FIRST / LAST)) ident_start wc*
rule quoted_ident = "\"" ([^"]+ / "\"\"")+ "\""
// U&"..." with Unicode escapes
rule uquoted_ident = [uU] "&" quoted_ident (ws [uU] [eE] [sS] [cC] [aA] [pP] [eE] ws "'" [^'] "'")?

// The kinds of names of the grammar differ in the keywords they may not be (see keywords.py). A quoted
// identifier is always a name.
rule col_id Ident = quoted_ident / uquoted_ident / !kw_not_col_id word
rule type_function_name Ident = quoted_ident / uquoted_ident / !kw_not_type_func word
rule function_name_token Ident = quoted_ident / uquoted_ident / !kw_not_func_name word
rule type_name_token Ident = quoted_ident / uquoted_ident / !kw_not_type_name word
// IDENT: not a keyword at all
rule ident_only Ident = quoted_ident / uquoted_ident / !kw_any word
// ColLabel: any word
// NOT before BETWEEN, IN, LIKE, ILIKE and SIMILAR is a token of its own (NOT_LA) that no name accepts
rule col_label Ident = quoted_ident / uquoted_ident / !(NOT ws (BETWEEN / IN / LIKE / ILIKE / SIMILAR)) word
rule non_reserved_word Ident = quoted_ident / uquoted_ident / !kw_reserved word

// ---- Strings ----

rule sq_cont = ([\t\u{c} ] / "--" [^\r\n]*)* [\r\n] ([\t\n\u{c}\r ]+ / "--" [^\r\n]* [\r\n])* "'"
// A standard string: '' is a quote, and strings separated by whitespace with a newline in it are one.
rule sq_string = "'" ([^']+ / "''")* "'" (sq_cont ([^']+ / "''")* "'")*
// An escape string: E'...' where \ escapes. \u and \U need four and eight hexadecimal digits.
rule e_body = ([^\\']+ / "''" / "\\" ([uU] &hex4 / ![uU] .))*
rule e_string = [eE] "'" e_body "'" (sq_cont e_body "'")*
rule u_string = [uU] "&'" ([^']+ / "''")* "'"
rule hex4 = [0-9a-fA-F] #repeat(4)
// Dollar quoting: $$...$$ and $tag$...$tag$; the string ends at the same tag.
rule dollar_string = "$" t:dq_tag "$" {tag := text($t)} ([^$]+ / !dq_close "$")* dq_close
rule dq_close = "$" u:dq_tag "$" {text($u) == tag}
rule dq_tag = [a-zA-Z_\u{80}-\u{10ffff}] [a-zA-Z_0-9\u{80}-\u{10ffff}]* / _
rule bit_string = [bBxX] "'" [^']* "'" (sq_cont [^']* "'")*

rule sconst StringLit = e_string / sq_string / dollar_string / u_string
rule bit_lit BitLit = bit_string

// ---- Numbers ----

rule digits = [0-9] ([0-9] / "_" [0-9])*
// An integer, a decimal or a real, as one token; an integer outside the range of an int32 is a float constant for
// the grammar (see iconst).
rule number Number = (digits ("." !"." digits?)? / "." digits) exp?
rule exp = [eE] [+\-]? digits
// ICONST: an integer literal that fits in 32 bits
rule iconst Number = i:int_lit {len(text($i)) < 10 || len(text($i)) == 10 && text($i) <= "2147483647"}
rule int_lit = (digits !("." !".") ![eE]) #atomic

// ---- Operators ----

// op_chars of the scanner, and the characters that make an operator "special": an operator that has one of them
// is never shortened (see the {operator} rule).
rule opc = [~!@\^&|`+\-*/%<>=]
rule cut = "--" / "/*"
// a character of an operator: one that does not begin a comment
rule rc = !cut opc
// the rest of an operator is only + and -: they are trimmed from the end of an operator without special characters
rule pm_end = (!cut [+\-])* !rc

rule op_plus = ("+" &pm_end) #atomic
rule op_minus = ("-" &pm_end) #atomic
rule op_star = ("*" &pm_end) #atomic
rule op_slash = ("/" &pm_end) #atomic
rule op_lt = ("<" &pm_end) #atomic
rule op_gt = (">" &pm_end) #atomic
rule op_eq = ("=" &pm_end) #atomic
rule op_le = ("<=" &pm_end) #atomic
rule op_ge = (">=" &pm_end) #atomic
rule op_ne = ("<>" &pm_end / "!=" !rc) #atomic
rule op_eq_gt = ("=>" &pm_end) #atomic
rule op_percent = ("%" !rc) #atomic
rule op_caret = ("^" !rc) #atomic
rule op_pow = ("**" !opc) #atomic
rule op_idiv = ("//" !opc) #atomic
rule op_arrow = ("->" !opc) #atomic
rule op_darrow = ("->>" !opc) #atomic
// Any other operator: one with a special character, or a longer or unknown one made of + - * / < > =.
rule op_generic Match = &opc o:(op_special / op_plain) #atomic => $o
rule op_special = !(("^" / "%" / "!=") !rc) (!cut [+\-*/<>=])* [~!@\^&|`%] (!cut opc)*
rule op_plain = &core_long !(("<=" / ">=" / "=>" / "<>") &pm_end) !(("**" / "//" / "->>" / "->") !opc) core
rule core = ((!cut [+\-])* !cut [*/<>=])+
rule core_long = !([*/<>=] &pm_end) core
// ===================================================================================================
// Names
// ===================================================================================================

rule col_id_or_string Ident = col_id / sconst
rule name Ident = col_id_or_string
rule attr_name Ident = col_label
rule param_name Ident = type_function_name

// qualified_name: ColIdOrString | ColId indirection (the dots)
rule qualified_name Name = qn_dotted / qn_string
rule qn_dotted Name = p:col_id rest:(-ws -"." -ws a:attr_name)+ => Name{Parts: concat(list($p), map($rest, (r) => r.a))}
rule qn_string Name = s:col_id_or_string => Name{Parts: list($s)}
// any_name: ColId | ColId attrs
rule any_name Name = p:col_id rest:(-ws -"." -ws a:attr_name)* => Name{Parts: concat(list($p), map($rest, (r) => r.a))}
rule name_list []Ident = first:name rest:(-ws -"," -ws n:name)* => concat(list($first), map($rest, (r) => r.n))
rule name_list_opt_comma []Ident = l:name_list (ws ",")? => $l
rule col_id_list []Ident = first:col_id rest:(-ws -"," -ws n:col_id)* => concat(list($first), map($rest, (r) => r.n))

// func_name: function_name_token | ColId indirection
rule func_name Name = fn_single / fn_dotted
rule fn_dotted Name = p:col_id rest:(-ws -"." -ws a:attr_name)+ => Name{Parts: concat(list($p), map($rest, (r) => r.a))}
rule fn_single Name = n:function_name_token &(ws "(") => Name{Parts: list($n)}

// ===================================================================================================
// Expressions
// ===================================================================================================

// The operators are ordered as the %left/%right declarations of the grammar of DuckDB order their tokens, from
// the loosest. An operator that takes its right operand itself (postfix with r:...) is one whose rule has a
// precedence of its own in the grammar (see comments at the levels).
rule expr Expr = operators {
    skip ws
    operand star_primary
    operand chained

    // a -> b and a ->> b. As a token, ->> has the lowest precedence (an expression on its left side is complete),
    // but its rule has the precedence of Op, so its right side is an operand of the arithmetic operators.
    level lv_arrow {
        infix left &"-" op_arrow => Binary{Left: $lhs, Op: $op, Right: $rhs}
        postfix &"-" o:op_darrow ws r:level(expr, lv_add) => Binary{Left: $lhs, Op: $o, Right: $r}
    }
    level lv_or {
        infix left &[oO] OR => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_and {
        infix left &[aA] AND => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_not {
        prefix NOT => Not{X: $rhs}
    }
    // IS and its relatives take no right operand (except IS DISTINCT FROM)
    level lv_is {
        postfix &[iInN] (IS ws n:NOT? ws t:(NULL / TRUE / FALSE / UNKNOWN) / t:ISNULL / nn:NOT ws t:NULL) => IsExpr{X: $lhs, Negated: len($n) > 0 || len($nn) > 0, Test: text($t)}
        postfix &[nN] t:NOTNULL => IsExpr{X: $lhs, Negated: true, Test: text($t)}
        postfix &[iI] IS ws n:NOT? ws DISTINCT ws FROM ws r:level(expr, lv_cmp) !(ws is_start) => DistinctFrom{Left: $lhs, Right: $r, Negated: len($n) > 0}
        postfix &[iI] IS ws n:NOT? ws OF ws "(" ws ts:type_list ws ")" !(ws is_start) => IsOf{X: $lhs, Types: $ts, Negated: len($n) > 0}
    }
    level lv_cmp {
        postfix &[<>=!] o:cmp_op ws r:level(expr, lv_like) !(ws cmp_op) => Binary{Left: $lhs, Op: $o, Right: $r}
        postfix &[+\-*/<>=~!@\^&|`%oOnNlLgGiI] o:subquery_op ws q:(ANY / SOME / ALL) ws s:any_source => AnyAll{X: $lhs, Op: text($o), Quantifier: text($q), Source: $s}
    }
    // BETWEEN, IN, LIKE, ILIKE, GLOB and SIMILAR TO: the rule of each has this precedence, so its operands do not
    // contain an operator of this level; ESCAPE belongs to the rule.
    level lv_like {
        postfix &[nNlLiIsS] n:(NOT ws)? o:(LIKE / ILIKE / (SIMILAR ws TO) #atomic) ws p:level(expr, lv_op) (ws ESCAPE ws e:level(expr, lv_op))? !(ws like_start) => Like{X: $lhs, Negated: len($n) > 0, Op: text($o), Pattern: $p, Escape: $e}
        postfix &[gG] o:GLOB ws p:level(expr, lv_op) !(ws like_start) => Like{X: $lhs, Negated: false, Op: text($o), Pattern: $p}
        postfix &[nNiI] n:(NOT ws)? IN ws (q:select_with_parens / "(" ws is:expr_list_opt_comma ws ")" / s:in_source) => In{X: $lhs, Negated: len($n) > 0, Query: $q, Items: concat($is), Source: $s}
        postfix &[nNbB] n:(NOT ws)? BETWEEN ws sy:SYMMETRIC? ws ASYMMETRIC? ws lo:b_expr ws AND ws hi:level(expr, lv_op) !(ws like_start) => Between{X: $lhs, Lo: $lo, Hi: $hi, Negated: len($n) > 0, Symmetric: len($sy) > 0}
    }
    // Op (the operators that are not one of the others) and OPERATOR(...); it may be a postfix operator.
    level lv_op {
        prefix o:qual_op => Unary{Op: $o, X: $rhs}
        postfix &[+\-*/<>=~!@\^&|`%oO] o:qual_op ws !(BETWEEN / ESCAPE / NOT / LIKE / ILIKE / SIMILAR) r:(op_rhs_prefix / level(expr, lv_add)) => Binary{Left: $lhs, Op: $o, Right: $r}
        postfix &[+\-*/<>=~!@\^&|`%oO] o:qual_op !(ws AT) !(ws qual_op) => PostfixOp{X: $lhs, Op: $o}
    }
    level lv_add {
        infix left &[+\-] op_plus / op_minus => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_mul {
        infix left &[*/%] op_star / op_slash / op_idiv / op_percent => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_pow {
        infix left &[*\^] op_caret / op_pow => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_at {
        postfix &[aA] AT ws TIME ws ZONE ws z:level(expr, lv_collate) => AtTimeZone{X: $lhs, Zone: $z}
    }
    level lv_collate {
        postfix &[cC] COLLATE ws n:any_name => Collate{X: $lhs, Collation: $n}
    }
    level lv_uminus {
        prefix op_plus / op_minus => Unary{Op: $op, X: $rhs}
    }
    level lv_cast {
        postfix &":" "::" ws t:typename => Cast{X: $lhs, Type: $t, Try: false, Shorthand: true}
    }
}

// The right operand of an operator: an expression of the levels above Op, or a prefix operator and its operand.
rule op_rhs_prefix Unary = o:qual_op ws x:(op_rhs_prefix / level(expr, lv_add)) => Unary{Op: $o, X: $x}

// b_expr: the expressions that may be the lower bound of BETWEEN, a default value, ...: no AND, OR, NOT, IS NULL,
// LIKE, IN, BETWEEN, COLLATE or AT TIME ZONE.
rule b_expr Expr = operators {
    skip ws
    operand chained
    level lv_is {
        postfix IS ws n:NOT? ws DISTINCT ws FROM ws r:level(b_expr, lv_cmp) !(ws is_start) => DistinctFrom{Left: $lhs, Right: $r, Negated: len($n) > 0}
        postfix IS ws n:NOT? ws OF ws "(" ws ts:type_list ws ")" !(ws is_start) => IsOf{X: $lhs, Types: $ts, Negated: len($n) > 0}
    }
    level lv_cmp {
        postfix o:cmp_op ws r:level(b_expr, lv_add) !(ws cmp_op) => Binary{Left: $lhs, Op: $o, Right: $r}
    }
    level lv_op {
        prefix o:qual_op => Unary{Op: $o, X: $rhs}
        postfix o:qual_op ws !BETWEEN r:level(b_expr, lv_add) => Binary{Left: $lhs, Op: $o, Right: $r}
        postfix o:qual_op !(ws AT) => PostfixOp{X: $lhs, Op: $o}
    }
    level lv_add {
        infix left op_plus / op_minus => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_mul {
        infix left op_star / op_slash / op_idiv / op_percent => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_pow {
        infix left op_caret / op_pow => Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_uminus {
        prefix op_plus / op_minus => Unary{Op: $op, X: $rhs}
    }
    level lv_cast {
        postfix "::" ws t:typename => Cast{X: $lhs, Type: $t, Try: false, Shorthand: true}
    }
}

rule colon = ":" !(":" / "=")
// The comparison operators do not associate: a < b < c is an error, also as the right side of AND and the like.
rule cmp_op Match = (op_lt / op_gt / op_eq / op_le / op_ge / op_ne) #atomic
// The operators of the level of BETWEEN, IN and LIKE do not associate either; IS DISTINCT FROM and IS OF do not
// take IS after them.
rule like_start = (NOT ws)? (LIKE / ILIKE / GLOB / SIMILAR / IN / BETWEEN)
rule is_start = IS / ISNULL / NOTNULL

// qual_Op, subquery_Op
rule qual_op Match = op_generic / operator_call
rule operator_call Match = (OPERATOR ws "(" ws any_operator ws ")") #atomic
rule any_operator = (col_id ws "." ws)* all_op
rule all_op Match = (
    op_generic / op_plus / op_minus / op_star / op_slash / op_idiv / op_percent / op_caret / op_pow
    / op_lt / op_gt / op_eq / op_le / op_ge / op_ne
)
rule subquery_op = all_op / operator_call / (NOT ws (LIKE / ILIKE)) #atomic / LIKE / GLOB / ILIKE
rule any_source Expr = any_source_query / paren_expr
rule any_source_query Subquery = q:select_with_parens => Subquery{Query: $q}
// the right side of IN that is not parenthesized: columnref_opt_indirection | indirection_expr
rule in_source Expr = indirection_expr / in_column
rule in_column Expr = operators {
    skip ws
    operand column_ref
    level lv_chain {
        postfix "." ws n:attr_name => Indirection{X: $lhs, Step: FieldStep{Name: $n}}
        postfix "[" ws i:expr ws "]" => Indirection{X: $lhs, Step: IndexStep{Index: $i}}
        postfix "[" ws lo:expr? ws colon ws hi:expr? ws "]" => Indirection{X: $lhs, Step: SliceStep{Lo: $lo, Hi: $hi}}
        postfix "[" ws lo:expr? ws colon ws hi:expr? ws colon ws st:expr? ws "]" => Indirection{X: $lhs, Step: SliceStep{Lo: $lo, Hi: $hi, Stride: $st}}
    }
}

// ===================================================================================================
// Operands
// ===================================================================================================

// c_expr: the expressions that are not made of operators, with the indirections that follow them in expr.
rule c_expr Expr = chained

// An operand with its indirections: x.field, x.method(args), x[i], x[lo:hi]. They follow only an operand, not the
// result of an operator, so they are not operators of expr. A column reference with indirections is a column
// reference of the grammar of DuckDB, which no method call can follow: x[1].f() is a syntax error, but (x)[1].f() is
// not.
rule chained Expr = col_chained / call_chained
rule col_chained Expr = operators {
    skip ws
    operand plain_column
    level lv_chain {
        postfix "." ws n:attr_name => Indirection{X: $lhs, Step: FieldStep{Name: $n}}
        postfix "[" ws i:expr ws "]" => Indirection{X: $lhs, Step: IndexStep{Index: $i}}
        postfix "[" ws lo:expr? ws colon ws (d:"-" ws colon ws st:expr? / hi:expr? (ws colon ws st:expr?)?) ws "]" => Indirection{X: $lhs, Step: SliceStep{Lo: $lo, Hi: $hi, Stride: $st, Dash: len($d) > 0}}
    }
}
rule call_chained Expr = operators {
    skip ws
    operand primary_other
    level lv_chain {
        postfix "." ws n:attr_name (ws c:"(" ws a:func_arg_list? ws ")")? => Indirection{X: $lhs, Step: FieldStep{Name: $n, Call: len($c) > 0, Args: concat($a)}}
        postfix "[" ws i:expr ws "]" => Indirection{X: $lhs, Step: IndexStep{Index: $i}}
        postfix "[" ws lo:expr? ws colon ws (d:"-" ws colon ws st:expr? / hi:expr? (ws colon ws st:expr?)?) ws "]" => Indirection{X: $lhs, Step: SliceStep{Lo: $lo, Hi: $hi, Stride: $st, Dash: len($d) > 0}}
    }
}

rule primary_other Expr = (
    literal_primary
    / paren_primary
    / indirection_expr
    / keyword_primary
    / typed_literal
    / column_ref
)

// Constants.
rule literal_primary Expr = plain_literal / string_literal
rule plain_literal Expr = l:(number / bit_lit) !(ws ("." / "[")) => $l
// a string may be followed by .name and [i], but a call needs an expression in parentheses
rule string_literal Expr = l:sconst !(ws "." ws attr_name ws "(") => $l
// ICONST in positions where the grammar does not allow a float
rule param Param = "?" [0-9]* / "$" digits / "$" ws dollar_name
// the name of a parameter has no $ in it: $a$ begins a dollar-quoted string
rule dollar_name = quoted_ident / uquoted_ident / ident_start [a-zA-Z0-9_\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]*
rule positional_ref PositionalRef = "#" ws i:iconst => PositionalRef{Index: $i}

// An identifier that does not begin a call, a typed literal or another construct that starts with a name: the common
// case, which is tried first.
rule plain_column ColumnRef = (
    !(DOUBLE ws PRECISION / (CHARACTER / CHAR / NCHAR / NATIONAL / BIT) ws (VARYING / CHARACTER / CHAR) / INTERVAL ws (iconst / "("))
    ps:dotted_idents !(ws ("(" / "{" / "'" / "$" / [eEbBxXnN] "'" / [uU] "&'"))
) => ColumnRef{Parts: $ps}
rule column_ref ColumnRef = ps:dotted_idents => ColumnRef{Parts: $ps}
rule dotted_idents []Ident = first:col_id rest:(-ws -"." -ws a:attr_name)* => concat(list($first), map($rest, (r) => r.a))

// ( ... ): a subquery, an expression in parentheses, or a row
rule paren_primary Expr = subquery_expr / row_expr / paren_expr
rule subquery_expr Subquery = q:select_with_parens => Subquery{Query: $q}
rule row_expr Row = "(" ws first:expr rest:(-ws -"," -ws e:expr)+ ws ")" => Row{Items: concat(list($first), map($rest, (r) => r.e)), Keyword: false}
rule paren_expr Paren = "(" ws e:expr ws ")" => Paren{X: $e}

// The expressions that the grammar of DuckDB calls indirection_expr: they can be followed by .method(...)
rule indirection_expr Expr = (
    param
    / struct_lit
    / map_lit
    / list_comprehension
    / list_lit
    / case_expr
    / array_expr
    / positional_ref
    / qualified_row
    / func_expr
)

rule func_expr Expr = !(OPERATOR ws "(") e:(cast_expr / special_call / func_call_plain / typed_literal_args) => $e
// a call that is not followed by a string (otherwise it is the type of a literal)
rule func_call_plain FuncCall = c:func_call !(ws sconst) => $c

rule list_lit ListLit = "[" ws xs:expr_list_opt_comma? ws "]" => ListLit{Items: concat($xs)}
rule array_expr Expr = array_subquery / array_lit
rule array_subquery ArraySubquery = ARRAY ws q:select_with_parens => ArraySubquery{Query: $q}
rule array_lit ArrayLit = ARRAY ws "[" ws xs:expr_list_opt_comma? ws "]" => ArrayLit{Items: concat($xs)}
rule struct_lit StructLit = (
    "{" ws first:struct_field rest:(-ws -"," -ws f:struct_field)* (ws ",")? ws "}"
) => StructLit{Fields: concat(list($first), map($rest, (r) => r.f))}
rule struct_field StructField = n:col_id_or_string ws colon ws v:expr => StructField{Name: $n, Value: $v}
rule map_lit MapLit = MAP ws "{" ws es:map_entries? ws "}" => MapLit{Entries: concat($es)}
rule map_entries []MapEntry = first:map_entry rest:(-ws -"," -ws e:map_entry)* (ws ",")? => concat(list($first), map($rest, (r) => r.e))
rule map_entry MapEntry = k:expr ws colon ws v:expr => MapEntry{Key: $k, Value: $v}
rule list_comprehension ListComp = list_comp_if / list_comp
rule list_comp_if ListComp = "[" ws e:expr ws FOR ws vs:name_list ws IN ws s:c_expr ws IF ws c:expr ws "]" => ListComp{Expr: $e, Vars: $vs, Source: $s, Cond: $c}
rule list_comp ListComp = "[" ws e:expr ws FOR ws vs:name_list ws IN ws s:expr ws "]" => ListComp{Expr: $e, Vars: $vs, Source: $s}

rule case_expr Case = (
    CASE (ws !WHEN a:expr)? ws whens:when_clause_list (ws ELSE ws e:expr)? ws END
) => Case{Arg: $a, Whens: $whens, Else: $e}
rule when_clause_list []When = first:when_clause rest:(-ws w:when_clause)* => concat(list($first), map($rest, (r) => r.w))
rule when_clause When = WHEN ws c:expr ws THEN ws t:expr => When{Cond: $c, Then: $t}

rule qualified_row Row = ROW ws "(" ws xs:expr_list_opt_comma? ws ")" => Row{Items: concat($xs), Keyword: true}

rule expr_list []Expr = first:expr rest:(-ws -"," -ws e:expr)* => concat(list($first), map($rest, (r) => r.e))
rule expr_list_opt_comma []Expr = l:expr_list (ws ",")? => $l

// ---- Stars, COLUMNS, DEFAULT, lambdas ----

rule star_primary Expr = star_columns / star_expr / qualified_star / columns_expr / unpack_expr / default_expr / lambda_expr
rule default_expr DefaultExpr = DEFAULT
rule columns_expr ColumnsExpr = COLUMNS ws "(" ws a:expr ws ")" => ColumnsExpr{Arg: $a, Star: false}
rule star_columns ColumnsExpr = op_star ws COLUMNS ws "(" ws a:expr ws ")" => ColumnsExpr{Arg: $a, Star: true}
rule unpack_expr UnpackExpr = UNPACK ws "(" ws a:expr ws ")" => UnpackExpr{Arg: $a}
rule star_expr Star = op_star (ws ex:exclude_list)? (ws rp:replace_list)? (ws rn:rename_list)? => Star{Exclude: concat($ex), Replace: concat($rp), Rename: concat($rn)}
rule qualified_star Star = (
    q:col_id ws "." ws op_star (ws ex:exclude_list)? (ws rp:replace_list)? (ws rn:rename_list)?
) => Star{Qualifier: $q, Exclude: concat($ex), Replace: concat($rp), Rename: concat($rn)}
rule lambda_expr Lambda = LAMBDA ws ps:name_list ws colon ws b:expr => Lambda{Params: $ps, Body: $b, Keyword: true}

rule except_name Name = first:col_id_or_string rest:(-ws -"." -ws n:col_id_or_string)* => Name{Parts: concat(list($first), map($rest, (r) => r.n))}
rule except_name_list []Name = first:except_name rest:(-ws -"," -ws n:except_name)* (ws ",")? => concat(list($first), map($rest, (r) => r.n))
rule exclude_list []Name = exclude_paren / exclude_single
rule exclude_paren []Name = EXCLUDE ws "(" ws l:except_name_list ws ")" => $l
rule exclude_single []Name = EXCLUDE ws n:except_name => list($n)
rule replace_item ReplaceItem = e:expr ws AS ws n:col_id => ReplaceItem{Expr: $e, Name: $n}
rule replace_list []ReplaceItem = replace_paren / replace_single
rule replace_paren []ReplaceItem = REPLACE ws "(" ws first:replace_item rest:(-ws -"," -ws i:replace_item)* (ws ",")? ws ")" => concat(list($first), map($rest, (r) => r.i))
rule replace_single []ReplaceItem = REPLACE ws i:replace_item => list($i)
rule rename_item RenameItem = f:except_name ws AS ws t:col_id => RenameItem{From: $f, To: $t}
rule rename_list []RenameItem = rename_paren / rename_single
rule rename_paren []RenameItem = RENAME ws "(" ws first:rename_item rest:(-ws -"," -ws i:rename_item)* (ws ",")? ws ")" => concat(list($first), map($rest, (r) => r.i))
rule rename_single []RenameItem = RENAME ws i:rename_item => list($i)

// ---- Keyword expressions and special functions ----

rule keyword_primary Expr = k:(bool_lit / null_lit / exists_expr / interval_lit / grouping_expr) !(ws ("." / "[")) => $k
rule bool_lit BoolLit = TRUE / FALSE
rule null_lit NullLit = NULL
rule exists_expr Exists = EXISTS ws q:select_with_parens => Exists{Query: $q}
rule grouping_expr Grouping = n:(GROUPING_ID / GROUPING) #atomic ws "(" ws xs:expr_list_opt_comma ws ")" => Grouping{Name: text($n), Args: $xs}
rule cast_expr Cast = cast_plain / cast_try
rule cast_plain Cast = CAST ws "(" ws x:expr ws AS ws t:typename ws ")" => Cast{X: $x, Type: $t, Try: false, Shorthand: false}
rule cast_try Cast = TRY_CAST ws "(" ws x:expr ws AS ws t:typename ws ")" => Cast{X: $x, Type: $t, Try: true, Shorthand: false}

rule interval_lit IntervalLit = interval_paren / interval_const
rule interval_paren IntervalLit = INTERVAL ws "(" ws v:expr ws ")" (ws u:interval_unit)? => IntervalLit{Value: $v, Unit: $u}
rule interval_const IntervalLit = INTERVAL ws v:(iconst / sconst) (ws u:interval_unit)? => IntervalLit{Value: $v, Unit: $u}
rule interval_unit IntervalUnit = interval_to / interval_field
rule interval_to = (
    (YEARS / YEAR) ws TO ws (MONTHS / MONTH)
    / (DAYS / DAY) ws TO ws (HOURS / HOUR / MINUTES / MINUTE / SECONDS / SECOND)
    / (HOURS / HOUR) ws TO ws (MINUTES / MINUTE / SECONDS / SECOND)
    / (MINUTES / MINUTE) ws TO ws (SECONDS / SECOND)
)
rule interval_field = (
    YEARS / YEAR / MONTHS / MONTH / DAYS / DAY / HOURS / HOUR / MINUTES / MINUTE / SECONDS / SECOND
    / MILLISECONDS / MILLISECOND / MICROSECONDS / MICROSECOND / WEEKS / WEEK / QUARTERS / QUARTER / DECADES / DECADE
    / CENTURIES / CENTURY / MILLENNIA / MILLENNIUM
)

rule special_call Expr = (
    sc_coalesce / sc_nullif / sc_extract / sc_extract_empty / sc_overlay / sc_position / sc_position_empty
    / sc_substring_from / sc_substring_for_from / sc_substring_for / sc_substring_list / sc_substring_empty / sc_treat / sc_trim_chars / sc_trim / sc_collation
)
rule sc_coalesce SpecialCall = n:COALESCE ws "(" ws a:expr_list_opt_comma ws ")" => SpecialCall{Name: text($n), Args: $a}
rule sc_nullif SpecialCall = n:NULLIF ws "(" ws a:expr ws "," ws b:expr ws ")" => SpecialCall{Name: text($n), Args: list($a, $b)}
rule sc_extract SpecialCall = n:EXTRACT ws "(" ws p:extract_arg ws FROM ws x:expr ws ")" => SpecialCall{Name: text($n), Spec: text($p), Args: list($x)}
rule sc_extract_empty SpecialCall = n:EXTRACT ws "(" ws ")" => SpecialCall{Name: text($n)}
rule sc_overlay SpecialCall = (
    n:OVERLAY ws "(" ws x:expr ws PLACING ws y:expr ws FROM ws a:expr (ws FOR ws b:expr)? ws ")"
) => SpecialCall{Name: text($n), Args: list($x), Placing: $y, From: list($a), For: $b}
rule sc_position SpecialCall = n:POSITION ws "(" ws a:b_expr ws IN ws b:b_expr ws ")" => SpecialCall{Name: text($n), Args: list($a, $b)}
rule sc_position_empty SpecialCall = n:POSITION ws "(" ws ")" => SpecialCall{Name: text($n)}
// SUBSTRING(x FROM a FOR b), SUBSTRING(x FOR b FROM a), SUBSTRING(x, a, b) and SUBSTRING()
rule sc_substring_from SpecialCall = (
    n:SUBSTRING ws "(" ws x:expr ws FROM ws a:expr (ws FOR ws b:expr)? ws ")"
) => SpecialCall{Name: text($n), Args: list($x), From: list($a), For: $b}
rule sc_substring_for_from SpecialCall = (
    n:SUBSTRING ws "(" ws x:expr ws FOR ws b:expr ws FROM ws a:expr ws ")"
) => SpecialCall{Name: text($n), Args: list($x), From: list($a), For: $b}
rule sc_substring_for SpecialCall = n:SUBSTRING ws "(" ws x:expr ws FOR ws b:expr ws ")" => SpecialCall{Name: text($n), Args: list($x), For: $b}
rule sc_substring_list SpecialCall = n:SUBSTRING ws "(" ws l:expr_list ws ")" => SpecialCall{Name: text($n), Args: $l}
rule sc_substring_empty SpecialCall = n:SUBSTRING ws "(" ws ")" => SpecialCall{Name: text($n)}
rule sc_treat SpecialCall = n:TREAT ws "(" ws x:expr ws AS ws t:typename ws ")" => SpecialCall{Name: text($n), Args: list($x), Type: $t}
rule sc_trim_chars SpecialCall = (
    n:TRIM ws "(" ws (s:(BOTH / LEADING / TRAILING) ws)? c:expr ws FROM ws l:expr_list_opt_comma ws ")"
) => SpecialCall{Name: text($n), Spec: text($s), Args: $l, Chars: $c}
rule sc_trim SpecialCall = n:TRIM ws "(" ws (s:(BOTH / LEADING / TRAILING) ws)? a:(trim_from / expr_list_opt_comma) ws ")" => SpecialCall{Name: text($n), Spec: text($s), Args: $a}
rule sc_collation SpecialCall = n:(COLLATION ws FOR) #atomic ws "(" ws x:expr ws ")" => SpecialCall{Name: text($n), Args: list($x)}
rule extract_arg Match = (ident_only / year_kw / sconst) #atomic
rule year_kw = (
    YEARS / YEAR / MONTHS / MONTH / DAYS / DAY / HOURS / HOUR / MINUTES / MINUTE / SECONDS / SECOND
    / MILLISECONDS / MILLISECOND / MICROSECONDS / MICROSECOND / WEEKS / WEEK / QUARTERS / QUARTER / DECADES / DECADE
    / CENTURIES / CENTURY / MILLENNIA / MILLENNIUM
)
// trim_list: a_expr FROM expr_list | FROM expr_list | expr_list
rule trim_from []Expr = FROM ws l:expr_list_opt_comma => $l

// ---- Function calls ----

rule func_call FuncCall = (
    n:func_name ws "(" ws
    (q:(ALL / DISTINCT) ws a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)? / a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)? / VARIADIC ws v:func_arg_expr)?
    (ws o:sort_clause)? (ws nl:opt_ignore_nulls)? ws ")"
    (ws WITHIN ws GROUP ws "(" ws wg:sort_clause ws ")")?
    (ws f:filter_clause)?
    (ws ex:EXPORT_STATE)?
    (ws ov:over_clause)?
) => FuncCall{Name: $n, Quantifier: text($q), Args: concat($a), Variadic: $v, OrderBy: $o, Nulls: text($nl), WithinGroup: $wg, Filter: $f, ExportState: len($ex) > 0, Over: $ov}
// func_name '(' ... ')' Sconst: a literal of a type with arguments
rule typed_literal_args TypedLit = t:func_name_type ws "(" ws a:func_arg_list ws ")" ws s:sconst => TypedLit{Type: Type{Name: text($t), Mods: $a}, Value: $s}
rule func_name_type Match = (fn_dotted / function_name_token) #atomic
rule func_arg_list []Expr = first:func_arg_expr rest:(-ws -"," -ws e:func_arg_expr)* => concat(list($first), map($rest, (r) => r.e))
rule func_arg_expr Expr = named_arg / expr
rule named_arg NamedArg = n:param_name ws (":=" / op_eq_gt) ws v:expr => NamedArg{Name: $n, Value: $v}
rule opt_ignore_nulls Match = ((IGNORE / RESPECT) ws NULLS) #atomic
rule filter_clause Expr = FILTER ws "(" ws (WHERE ws)? e:expr ws ")" => $e
rule over_clause WindowOver = OVER ws (s:window_specification / n:col_id) => WindowOver{Name: $n, Spec: $s}
rule window_specification WindowSpec = (
    "(" ws (!(PARTITION / RANGE / ROWS / GROUPS) b:col_id)?
    (ws PARTITION ws BY ws xs:expr_list)? (ws o:sort_clause)? (ws f:frame_clause)? ws ")"
) => WindowSpec{Base: $b, PartitionBy: concat($xs), OrderBy: $o, Frame: $f}
// BETWEEN can also name a column in a single-bound expression. Bison reduces
// that keyword before NOT, so a two-bound frame cannot start with bare NOT.
// Its nonassociative operator lookaheads reject either interpretation.
rule frame_clause Frame = !frame_conflict f:(frame_between / frame_single) => $f
rule frame_conflict = (
    (RANGE / ROWS / GROUPS) ws BETWEEN ws
    (BETWEEN / GLOB / ILIKE / LIKE / SIMILAR / NOT ws (BETWEEN / IN / LIKE / ILIKE / SIMILAR))
)
// These shifted tokens could also extend or terminate a BETWEEN column
// expression. Do not retry that interpretation after a two-bound failure.
rule frame_shift = (
    AT / OPERATOR / PRECEDING / FOLLOWING / op_generic / op_plus / op_minus / op_star
    / "[" / "(" / "?" / "{" / "#" / "$"
)
rule frame_single Frame = u:(RANGE / ROWS / GROUPS) ws !(BETWEEN ws frame_shift) b:frame_bound (ws e:window_exclusion)? => Frame{Unit: text($u), Start: $b, Exclude: text($e)}
rule frame_between Frame = (
    u:(RANGE / ROWS / GROUPS) ws BETWEEN ws !NOT b:frame_bound ws AND ws c:frame_bound (ws e:window_exclusion)?
) => Frame{Unit: text($u), Start: $b, End: $c, Exclude: text($e)}
rule frame_bound FrameBound = frame_bound_kw / frame_bound_expr
rule frame_bound_kw FrameBound = k:(UNBOUNDED ws (PRECEDING / FOLLOWING) / CURRENT ws ROW) #atomic => FrameBound{Kind: text($k)}
rule frame_bound_expr FrameBound = e:expr ws k:(PRECEDING / FOLLOWING) => FrameBound{Kind: text($k), Expr: $e}
rule window_exclusion Match = (EXCLUDE ws (CURRENT ws ROW / GROUP / TIES / NO ws OTHERS)) #atomic
// ===================================================================================================
// Types
// ===================================================================================================

rule type_list []Type = first:typename rest:(-ws -"," -ws t:typename)* => concat(list($first), map($rest, (r) => r.t))

// SETOF is ignored in the AST, but its operand follows SimpleTypename: constructed types are not eligible,
// and qualified names require explicit ARRAY or ARRAY[n]. Recursive member types still use typename.
rule typename Type = SETOF ws t:type_setof / t:type_base => $t
rule type_base Type = type_struct / type_map / type_qualified / type_simple
rule type_setof Type = type_setof_qualified / type_simple
rule type_simple Type = type_interval / type_datetime / type_char / type_bit / type_numeric / type_generic
rule type_setof_qualified Type = n:(ident_only (ws "." ws ident_only)+) #atomic &(ws ARRAY) ds:array_dims => Type{Name: text($n), Dims: $ds}

// The array dimensions that may follow a type: [], [3], and ARRAY, ARRAY[3]
rule array_dims []ArrayDim = array_dims_only / array_keyword_sized / array_keyword
rule array_dim ArrayDim = "[" ws s:iconst? ws "]" => ArrayDim{Size: $s}
rule array_dims_only []ArrayDim = ds:(-ws d:array_dim)+ => map($ds, (x) => x.d)
rule array_keyword_sized []ArrayDim = ws ARRAY ws "[" ws s:iconst ws "]" => list(ArrayDim{Size: $s})
rule array_keyword []ArrayDim = ws ARRAY => list(ArrayDim{})

rule type_mods []Expr = "(" ws xs:expr_list_opt_comma? ws ")" => concat($xs)
rule type_struct Type = n:(ROW / STRUCT / UNION) #atomic ws "(" ws fs:colid_type_list ws ")" ds:array_dims_only? => Type{Name: text($n), Fields: $fs, Dims: concat($ds)}
rule colid_type_list []TypeField = first:colid_type rest:(-ws -"," -ws f:colid_type)* => concat(list($first), map($rest, (r) => r.f))
rule colid_type TypeField = n:col_id ws t:typename => TypeField{Name: $n, Type: $t}
rule type_map Type = n:MAP #atomic ws "(" ws ts:type_list ws ")" ds:array_dims_only? => Type{Name: text($n), Elems: $ts, Dims: concat($ds)}
// INTERVAL(3) and INTERVAL DAY TO HOUR
rule type_interval Type = n:(INTERVAL (ws "(" ws iconst ws ")" / ws interval_unit)?) #atomic ds:array_dims? => Type{Name: text($n), Dims: concat($ds)}
rule type_datetime Type = (
    n:(TIMESTAMP / TIME) #atomic ps:(-ws -"(" -ws n:iconst -ws -")") #repeat(0, 1) (ws z:time_zone_spec)? ds:array_dims?
) => Type{Name: text($n), Mods: map($ps, (x) => x.n), Zone: text($z), Dims: concat($ds)}
rule time_zone_spec Match = ((WITH / WITHOUT) ws TIME ws ZONE) #atomic
rule type_char Type = n:char_name ps:(-ws -"(" -ws n:iconst -ws -")") #repeat(0, 1) ds:array_dims? => Type{Name: text($n), Mods: map($ps, (x) => x.n), Dims: concat($ds)}
rule char_name Match = (NATIONAL ws (CHARACTER / CHAR) (ws VARYING)? / NCHAR (ws VARYING)? / CHARACTER (ws VARYING)? / CHAR (ws VARYING)? / VARCHAR) #atomic
rule type_bit Type = n:(BIT (ws VARYING)?) #atomic (ws "(" ws xs:expr_list_opt_comma ws ")")? ds:array_dims? => Type{Name: text($n), Mods: concat($xs), Dims: concat($ds)}
rule type_numeric Type = type_double / type_numeric_mods / type_numeric_plain
rule type_double Type = n:(DOUBLE ws PRECISION) #atomic ds:array_dims? => Type{Name: text($n), Dims: concat($ds)}
rule type_numeric_mods Type = type_float / type_decimal
rule type_float Type = n:FLOAT #atomic ps:(-ws -"(" -ws p:iconst -ws -")") #repeat(0, 1) ds:array_dims? => Type{Name: text($n), Mods: map($ps, (x) => x.p), Dims: concat($ds)}
rule type_decimal Type = n:(DECIMAL / DEC / NUMERIC) #atomic (ws ms:type_mods)? ds:array_dims? => Type{Name: text($n), Mods: concat($ms), Dims: concat($ds)}
rule type_numeric_plain Type = n:(INTEGER / INT / SMALLINT / BIGINT / REAL / BOOLEAN) #atomic ds:array_dims? => Type{Name: text($n), Dims: concat($ds)}
rule type_qualified Type = n:(ident_only (ws "." ws ident_only)+) #atomic ds:array_dims? => Type{Name: text($n), Dims: concat($ds)}
rule type_generic Type = n:type_name_token #atomic (ws ms:type_mods)? ds:array_dims? => Type{Name: text($n), Mods: concat($ms), Dims: concat($ds)}

// A literal of a type: DATE '2020-01-01', INT '5', DECIMAL(10, 2) '1.5'
rule typed_literal TypedLit = tl:(typed_literal_nchar / typed_literal_const / typed_literal_name) !(ws ("." / "[")) => $tl
rule typed_literal_nchar TypedLit = n:[nN] #atomic &"'" s:sconst => TypedLit{Type: Type{Name: text($n)}, Value: $s}
rule typed_literal_const TypedLit = t:const_type ws s:sconst => TypedLit{Type: $t, Value: $s}
rule typed_literal_name TypedLit = !([eEbBxXnN] "'") t:func_name_type ws s:sconst => TypedLit{Type: Type{Name: text($t)}, Value: $s}
rule const_type Type = type_numeric_const / type_char_const / type_bit_const / type_datetime_const
rule type_numeric_const Type = type_double_const / type_numeric_mods_const / type_numeric_plain_const
rule type_double_const Type = n:(DOUBLE ws PRECISION) #atomic => Type{Name: text($n)}
rule type_numeric_mods_const Type = type_float_const / type_decimal_const
rule type_float_const Type = n:FLOAT #atomic ps:(-ws -"(" -ws p:iconst -ws -")") #repeat(0, 1) => Type{Name: text($n), Mods: map($ps, (x) => x.p)}
rule type_decimal_const Type = n:(DECIMAL / DEC / NUMERIC) #atomic (ws ms:type_mods)? => Type{Name: text($n), Mods: concat($ms)}
rule type_numeric_plain_const Type = n:(INTEGER / INT / SMALLINT / BIGINT / REAL / BOOLEAN) #atomic => Type{Name: text($n)}
rule type_char_const Type = n:char_name ps:(-ws -"(" -ws n:iconst -ws -")") #repeat(0, 1) => Type{Name: text($n), Mods: map($ps, (x) => x.n)}
rule type_bit_const Type = n:(BIT (ws VARYING)?) #atomic (ws "(" ws xs:expr_list_opt_comma ws ")")? => Type{Name: text($n), Mods: concat($xs)}
rule type_datetime_const Type = n:(TIMESTAMP / TIME) #atomic ps:(-ws -"(" -ws n:iconst -ws -")") #repeat(0, 1) (ws z:time_zone_spec)? => Type{Name: text($n), Mods: map($ps, (x) => x.n), Zone: text($z)}
// ===================================================================================================
// SELECT (select.y)
// ===================================================================================================

// SelectStmt: select_no_parens | select_with_parens
rule select_stmt Select = select_no_parens / select_paren_stmt
rule select_paren_stmt Select = pq:select_with_parens => Select{Body: $pq}

rule select_with_parens ParenQuery = "(" ws q:paren_content ws ")" => ParenQuery{Query: $q}
rule paren_content ParenContent = select_no_parens / select_with_parens / show_stmt

rule select_no_parens Select = (
    (w:with_clause ws)? b:select_body
    (ws o:sort_clause)?
    (ws l1:locking_clauses)?
    (ws (l:limit_clause (ws of:offset_clause)? / of:offset_clause (ws l:limit_clause)?))?
    (ws l2:locking_clauses)?
) => Select{With: $w, Body: $b, OrderBy: $o, Limit: $l, Offset: $of, Locking: concat($l1, $l2)}

// ---- WITH ----

rule with_clause With = with_recursive / with_plain
rule with_recursive With = WITH ws RECURSIVE ws first:cte rest:(-ws -"," -ws c:cte)* => With{Recursive: true, CTEs: concat(list($first), map($rest, (x) => x.c))}
rule with_plain With = WITH ws first:cte rest:(-ws -"," -ws c:cte)* => With{CTEs: concat(list($first), map($rest, (x) => x.c))}
rule cte CTE = (
    n:name (ws "(" ws cs:name_list_opt_comma ws ")")? (ws USING ws KEY ws "(" ws k:col_id_list (ws ",")? ws ")")?
    ws AS (ws m:materialized)? ws "(" ws q:preparable ws ")"
) => CTE{Name: $n, Columns: concat($cs), UsingKey: concat($k), Materialized: $m, Query: $q}
rule materialized Match = (MATERIALIZED / NOT ws MATERIALIZED) #atomic

// ---- Set operations ----

rule select_body QueryBody = operators {
    skip ws
    operand select_core
    operand from_first
    operand values_clause
    operand table_query
    operand pivot_query
    operand unpivot_query
    operand select_with_parens

    level lv_union {
        infix left o:(UNION / EXCEPT) (ws q:(ALL / DISTINCT))? bn:(ws BY ws NAME)? => SetOp{Left: $lhs, Op: text($o), Quantifier: text($q), ByName: len($bn) > 0, Right: $rhs}
    }
    level lv_intersect {
        infix left o:INTERSECT (ws q:(ALL / DISTINCT))? bn:(ws BY ws NAME)? => SetOp{Left: $lhs, Op: text($o), Quantifier: text($q), ByName: len($bn) > 0, Right: $rhs}
    }
}

// ---- SELECT ----

rule select_core SelectCore = (
    SELECT
    (ws d:distinct_clause ws is:target_list_opt_comma / (ws ALL)? (ws is:target_list_opt_comma)?)
    (ws into:into_clause)?
    (ws FROM ws f:from_list_opt_comma)?
    (ws WHERE ws w:expr)?
    (ws g:group_clause)?
    (ws HAVING ws h:expr)?
    (ws wd:window_clause)?
    (ws QUALIFY ws q:expr)?
    (ws s:sample_clause)?
) => SelectCore{Distinct: $d, Items: concat($is), Into: $into, From: concat($f), Where: $w, GroupBy: $g, Having: $h, Windows: concat($wd), Qualify: $q, Sample: $s}

rule from_first SelectCore = (
    FROM ws f:from_list
    (ws SELECT (ws d:distinct_clause ws is:target_list_opt_comma / (ws ALL)? (ws is:target_list_opt_comma)?))?
    (ws into:into_clause)?
    (ws WHERE ws w:expr)?
    (ws g:group_clause)?
    (ws HAVING ws h:expr)?
    (ws wd:window_clause)?
    (ws QUALIFY ws q:expr)?
    (ws s:sample_clause)?
) => SelectCore{FromFirst: true, Distinct: $d, Items: concat($is), Into: $into, From: $f, Where: $w, GroupBy: $g, Having: $h, Windows: concat($wd), Qualify: $q, Sample: $s}

rule distinct_clause DistinctClause = DISTINCT (ws ON ws "(" ws xs:expr_list_opt_comma ws ")")? => DistinctClause{On: concat($xs)}

rule target_list_opt_comma []SelectItem = first:select_item rest:(-ws -"," -ws i:select_item)* (ws ",")? => concat(list($first), map($rest, (r) => r.i))
rule select_item SelectItem = item_prefixed / item_plain
rule item_prefixed SelectItem = a:col_id ws colon ws e:expr => SelectItem{Expr: $e, Alias: $a, Prefix: true}
rule item_plain SelectItem = e:expr (ws kw:AS ws al:col_label_or_string / ws al:ident_only)? => SelectItem{Expr: $e, Alias: $al, As: len($kw) > 0}
rule col_label_or_string Ident = col_label / sconst

rule into_clause IntoClause = INTO ws t:opt_temp_table_name => $t
rule opt_temp_table_name IntoClause = into_temp / into_table / into_plain
rule into_temp IntoClause = t:((TEMPORARY / TEMP) / LOCAL ws (TEMPORARY / TEMP) / GLOBAL ws (TEMPORARY / TEMP) / UNLOGGED) #atomic ws (TABLE ws)? n:qualified_name => IntoClause{Temp: text($t), Table: $n}
rule into_table IntoClause = TABLE ws n:qualified_name => IntoClause{Table: $n}
rule into_plain IntoClause = n:qualified_name => IntoClause{Table: $n}

rule group_clause GroupBy = group_all / group_list
rule group_all GroupBy = GROUP ws BY ws ALL => GroupBy{All: true}
rule group_list GroupBy = GROUP ws BY ws first:group_by_item rest:(-ws -"," -ws i:group_by_item)* (ws ",")? => GroupBy{Items: concat(list($first), map($rest, (r) => r.i))}
rule group_by_item Expr = grouping_set / group_expr
rule group_expr Expr = !((CUBE / ROLLUP) ws "(") e:expr => $e
rule grouping_set GroupingSet = gs_rollup / gs_sets / gs_empty
rule gs_rollup GroupingSet = k:(ROLLUP / CUBE) #atomic ws "(" ws xs:expr_list_opt_comma ws ")" => GroupingSet{Kind: text($k), Items: $xs}
rule gs_sets GroupingSet = k:(GROUPING ws SETS) #atomic ws "(" ws xs:group_by_list_opt_comma ws ")" => GroupingSet{Kind: text($k), Items: $xs}
rule gs_empty GroupingSet = "(" ws ")" => GroupingSet{}
rule group_by_list_opt_comma []Expr = first:group_by_item rest:(-ws -"," -ws i:group_by_item)* (ws ",")? => concat(list($first), map($rest, (r) => r.i))

rule window_clause []WindowDef = WINDOW ws first:window_definition rest:(-ws -"," -ws w:window_definition)* => concat(list($first), map($rest, (r) => r.w))
rule window_definition WindowDef = n:col_id ws AS ws s:window_specification => WindowDef{Name: $n, Spec: $s}

// ---- VALUES, TABLE, PIVOT ----

rule values_clause ValuesClause = VALUES ws first:values_row rest:(-ws -"," -ws r:values_row)* (ws ",")? => ValuesClause{Rows: concat(list($first), map($rest, (x) => x.r))}
rule values_row ValuesRow = "(" ws xs:expr_list_opt_comma ws ")" => ValuesRow{Items: $xs}
rule table_query TableQuery = TABLE ws n:qualified_name => TableQuery{Table: $n}

rule pivot_query PivotQuery = (
    pivot_keyword ws s:table_ref &(ws (ON / USING / GROUP))
    (ws ON ws on:pivot_column_list)?
    (ws USING ws us:target_list_opt_comma)?
    (ws GROUP ws BY ws g:name_list_opt_comma_opt_bracket)?
) => PivotQuery{Source: $s, On: concat($on), Using: concat($us), GroupBy: concat($g)}
rule pivot_keyword = PIVOT_WIDER / PIVOT
rule unpivot_keyword = PIVOT_LONGER / UNPIVOT
rule unpivot_query UnpivotQuery = (
    unpivot_keyword ws s:table_ref ws ON ws on:target_list_opt_comma (ws INTO ws NAME ws n:name ws (VALUE / VALUES) ws vs:name_list_opt_comma_opt_bracket)?
) => UnpivotQuery{Source: $s, On: $on, Name: $n, Values: concat($vs)}
rule name_list_opt_comma_opt_bracket []Ident = bracketed_names / name_list_opt_comma
rule bracketed_names []Ident = "(" ws l:name_list_opt_comma ws ")" => $l
rule pivot_column_list []PivotColumn = first:pivot_column_entry rest:(-ws -"," -ws e:pivot_column_entry)* (ws ",")? => concat(list($first), map($rest, (r) => r.e))
rule pivot_column_entry PivotColumn = (
    e:b_expr (ws IN ws ("(" ws q:select_no_parens ws ")" / "(" ws is:target_list_opt_comma ws ")" / n:col_id_or_string))?
) => PivotColumn{Expr: $e, Query: $q, In: concat($is), Enum: $n}

// ---- ORDER BY, LIMIT, locking ----

rule sort_clause OrderBy = sort_all / sort_list
rule sort_all OrderBy = ORDER ws BY ws ALL (ws d:asc_desc)? (ws n:nulls_order)? => OrderBy{All: true, Direction: text($d), Nulls: text($n)}
rule sort_list OrderBy = ORDER ws BY ws first:sortby rest:(-ws -"," -ws s:sortby)* => OrderBy{Items: concat(list($first), map($rest, (r) => r.s))}
rule sortby SortItem = sortby_using / sortby_plain
rule sortby_using SortItem = e:expr ws USING ws u:qual_all_op (ws n:nulls_order)? => SortItem{Expr: $e, Using: text($u), Nulls: text($n)}
rule sortby_plain SortItem = e:expr (ws d:asc_desc)? (ws n:nulls_order)? => SortItem{Expr: $e, Direction: text($d), Nulls: text($n)}
rule asc_desc = ASC / DESC
rule nulls_order Match = (NULLS ws (FIRST / LAST)) #atomic
rule qual_all_op Match = all_op / operator_call

rule limit_clause LimitClause = limit_comma / limit_all / limit_percent / limit_plain / limit_percent_sign / fetch_value_clause / fetch_clause
rule limit_comma LimitClause = k:LIMIT ws v:expr ws "," ws o:expr => LimitClause{Keyword: text($k), Value: $v, Offset: $o}
rule limit_all LimitClause = k:LIMIT ws ALL => LimitClause{Keyword: text($k), All: true}
rule limit_percent LimitClause = k:LIMIT ws p:number ws pc:PERCENT => LimitClause{Keyword: text($k), Value: $p, Percent: text($pc)}
rule limit_percent_sign LimitClause = k:LIMIT ws !(NOT / qual_op) v:level(expr, lv_mul) ws pc:op_percent => LimitClause{Keyword: text($k), Value: $v, Percent: text($pc)}
rule limit_plain LimitClause = k:LIMIT ws v:expr !(ws op_percent) => LimitClause{Keyword: text($k), Value: $v}
rule fetch_value_clause LimitClause = k:FETCH ws (FIRST / NEXT) ws v:fetch_value ws (ROW / ROWS) ws ONLY => LimitClause{Keyword: text($k), Value: $v}
rule fetch_clause LimitClause = k:FETCH ws (FIRST / NEXT) ws (ROW / ROWS) ws ONLY => LimitClause{Keyword: text($k)}
rule fetch_value Expr = fetch_signed / c_expr
rule fetch_signed Number = (op_plus / op_minus) ws n:number => $n
rule offset_clause OffsetClause = offset_rows / offset_plain
rule offset_plain OffsetClause = OFFSET ws v:expr => OffsetClause{Value: $v}
rule offset_rows OffsetClause = OFFSET ws v:fetch_value ws r:(ROW / ROWS) => OffsetClause{Value: $v, Rows: text($r)}

rule locking_clauses []LockClause = first:locking_clause rest:(-ws c:locking_clause)* => concat(list($first), map($rest, (r) => r.c))
rule locking_clause LockClause = lock_read_only / lock_for
rule lock_read_only LockClause = s:(FOR ws READ ws ONLY) #atomic => LockClause{Strength: text($s)}
rule lock_for LockClause = (
    s:(FOR ws (UPDATE / NO ws KEY ws UPDATE / SHARE / KEY ws SHARE)) #atomic (ws OF ws os:qualified_name_list)? (ws w:(NOWAIT / (SKIP ws LOCKED) #atomic))?
) => LockClause{Strength: text($s), Of: concat($os), Wait: text($w)}
rule qualified_name_list []Name = first:qualified_name rest:(-ws -"," -ws n:qualified_name)* => concat(list($first), map($rest, (r) => r.n))

// ---- SAMPLE ----

rule sample_clause SampleClause = USING ws SAMPLE ws s:tablesample_entry => $s
rule tablesample_clause SampleClause = TABLESAMPLE ws s:tablesample_entry => $s
rule sample_value Expr = number / param
// opt_sample_func '(' sample_count ')' opt_repeatable_clause | sample_count | sample_count '(' ColId [, ICONST] ')'
rule tablesample_entry SampleClause = sample_func / sample_seeded / sample_count
rule sample_func SampleClause = (
    (f:col_id ws)? "(" ws v:sample_value (ws u:sample_unit)? ws ")" (ws REPEATABLE ws "(" ws r:iconst ws ")")?
) => SampleClause{Method: $f, Value: $v, Unit: text($u), Repeatable: $r}
rule sample_seeded SampleClause = v:sample_value (ws u:sample_unit)? ws "(" ws f:col_id (ws "," ws sd:iconst)? ws ")" => SampleClause{Method: $f, Value: $v, Unit: text($u), Seed: $sd}
rule sample_count SampleClause = v:sample_value (ws u:sample_unit)? => SampleClause{Value: $v, Unit: text($u)}
rule sample_unit = op_percent / PERCENT / ROWS

// ---- Table references ----

rule from_list []TableRef = first:table_ref rest:(-ws -"," -ws t:table_ref)* => concat(list($first), map($rest, (r) => r.t))
rule from_list_opt_comma []TableRef = first:table_ref rest:(-ws -"," -ws t:table_ref)* (ws ",")? => concat(list($first), map($rest, (r) => r.t))

// table_ref and its joins: a join is left associative unless it needs a qualification that comes after its
// right side (a JOIN b JOIN c ON x ON y), so the right side of a qualified join is a table_ref of its own. The
// joins that need none take only a table without joins, which makes them left associative.
rule table_ref TableRef = operators {
    skip ws
    operand table_primary

    level lv_join {
        postfix k:CROSS #atomic ws JOIN ws r:table_primary => Join{Left: $lhs, Kind: text($k), Right: $r}
        postfix k:(NATURAL ws (join_type ws)?) #atomic JOIN ws r:table_primary => Join{Left: $lhs, Kind: text($k), Right: $r}
        postfix k:POSITIONAL #atomic ws JOIN ws r:table_primary => Join{Left: $lhs, Kind: text($k), Right: $r}
        postfix k:(ASOF ws (join_type ws)?) #atomic JOIN ws r:table_ref ws q:join_qual_on => Join{Left: $lhs, Kind: text($k), Right: $r, On: $q}
        postfix k:(ASOF ws (join_type ws)?) #atomic JOIN ws r:table_ref ws q:join_qual_using => Join{Left: $lhs, Kind: text($k), Right: $r, Using: $q}
        postfix k:(join_type ws)? #atomic JOIN ws r:table_ref ws q:join_qual_on => Join{Left: $lhs, Kind: text($k), Right: $r, On: $q}
        postfix k:(join_type ws)? #atomic JOIN ws r:table_ref ws q:join_qual_using => Join{Left: $lhs, Kind: text($k), Right: $r, Using: $q}
        postfix PIVOT ws "(" ws as:target_list_opt_comma ws FOR ws vs:pivot_value_list (ws GROUP ws BY ws g:name_list_opt_comma)? ws ")" (ws a:alias_clause)? => PivotRef{Source: $lhs, Aggregates: $as, Values: $vs, GroupBy: concat($g), Alias: $a}
        postfix UNPIVOT (ws n:include_nulls)? ws "(" ws h:unpivot_header ws FOR ws vs:unpivot_value_list ws ")" (ws a:alias_clause)? => UnpivotRef{Source: $lhs, IncludeNulls: $n, Header: $h, Values: $vs, Alias: $a}
    }
}
rule join_type Match = (FULL (ws OUTER)? / LEFT (ws OUTER)? / RIGHT (ws OUTER)? / SEMI / ANTI / INNER) #atomic
rule join_qual_on Expr = ON ws e:expr => $e
rule join_qual_using []Ident = USING ws "(" ws l:name_list_opt_comma ws ")" => $l
rule include_nulls Match = ((INCLUDE / EXCLUDE) ws NULLS) #atomic
rule unpivot_header []Ident = bracketed_names / unpivot_single
rule unpivot_single []Ident = n:col_id_or_string => list($n)
rule unpivot_value_list []UnpivotValue = first:unpivot_value rest:(-ws v:unpivot_value)* => concat(list($first), map($rest, (r) => r.v))
rule unpivot_value UnpivotValue = h:unpivot_header ws IN ws "(" ws is:target_list_opt_comma ws ")" => UnpivotValue{Header: $h, Items: $is}
rule pivot_value_list []PivotValue = first:pivot_value rest:(-ws v:pivot_value)* => concat(list($first), map($rest, (r) => r.v))
rule pivot_value PivotValue = h:pivot_header ws IN ws ("(" ws is:target_list_opt_comma ws ")" / n:col_id_or_string) => PivotValue{Header: $h, Items: concat($is), Enum: $n}
rule pivot_header []Expr = pivot_header_list / pivot_header_single
rule pivot_header_list []Expr = "(" ws l:c_expr_list_opt_comma ws ")" => $l
rule pivot_header_single []Expr = e:c_expr => list($e)
rule c_expr_list_opt_comma []Expr = first:c_expr rest:(-ws -"," -ws e:c_expr)* (ws ",")? => concat(list($first), map($rest, (r) => r.e))

rule table_primary TableRef = values_ref / subquery_ref / paren_table / rows_from_ref / func_ref / base_ref

// alias_prefix_colon_clause: ColIdOrString ':' (the alias comes first)
rule alias_prefix Ident = n:col_id_or_string ws colon => $n

rule base_ref BaseTable = (
    (pa:alias_prefix ws)? (n:qualified_name st:(ws op_star)? / o:ONLY ws "(" ws n:qualified_name ws ")" / o:ONLY ws n:qualified_name) (ws a:alias_clause {len($pa) == 0})? (ws at:at_clause)? (ws s:tablesample_clause)?
) => BaseTable{Prefix: $pa, Name: $n, Only: len($o) > 0, Star: len($st) > 0, Alias: $a, At: $at, Sample: $s}
rule at_clause AtClause = AT ws "(" ws u:(TIMESTAMP / VERSION) #atomic ws op_eq_gt ws v:expr ws ")" => AtClause{Unit: text($u), Value: $v}

rule subquery_ref SubqueryRef = (
    (pa:alias_prefix ws)? (l:LATERAL ws)? q:select_with_parens (ws a:alias_clause {len($pa) == 0})? (ws s:tablesample_clause)?
) => SubqueryRef{Prefix: $pa, Query: $q, Lateral: len($l) > 0, Alias: $a, Sample: $s}
// a table in parentheses must be a join
rule paren_table ParenTable = (
    (pa:alias_prefix ws)? "(" ws &(table_primary ws join_start) t:table_ref ws ")" (ws a:alias_clause {len($pa) == 0})?
) => ParenTable{Prefix: $pa, Table: $t, Alias: $a}
rule join_start = CROSS / NATURAL / POSITIONAL / ASOF / FULL / LEFT / RIGHT / SEMI / ANTI / INNER / JOIN
rule values_ref ValuesRef = (
    (pa:alias_prefix ws)? v:values_clause ws a:alias_clause (ws s:tablesample_clause)?
) => ValuesRef{Prefix: $pa, Values: $v, Alias: $a, Sample: $s}

rule func_ref FuncTable = (
    (pa:alias_prefix ws)? (l:LATERAL ws)? f:func_expr_windowless (ws WITH ws o:ORDINALITY)? (ws a:func_alias_clause {len($pa) == 0})? (ws s:tablesample_clause)?
) => FuncTable{Prefix: $pa, Func: $f, Lateral: len($l) > 0, Ordinality: len($o) > 0, Alias: $a, Sample: $s}
rule rows_from_ref FuncTable = (
    (pa:alias_prefix ws)? ROWS ws FROM ws "(" ws first:rowsfrom_item rest:(-ws -"," -ws i:rowsfrom_item)* ws ")" (ws WITH ws o:ORDINALITY)? (ws a:func_alias_clause {len($pa) == 0})? (ws s:tablesample_clause)?
) => FuncTable{Prefix: $pa, RowsFrom: concat(list($first), map($rest, (r) => r.i)), Ordinality: len($o) > 0, Alias: $a, Sample: $s}
rule rowsfrom_item RowsFromItem = f:func_expr_windowless (ws AS ws "(" ws cd:table_func_element_list ws ")")? => RowsFromItem{Func: $f, ColDefs: concat($cd)}
rule func_expr_windowless Expr = cast_expr / special_call / func_call_bare
rule func_call_bare FuncCall = (
    n:func_name ws "(" ws
    (q:(ALL / DISTINCT) ws a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)? / a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)? / VARIADIC ws v:func_arg_expr)?
    (ws o:sort_clause)? (ws nl:opt_ignore_nulls)? ws ")"
) => FuncCall{Name: $n, Quantifier: text($q), Args: concat($a), Variadic: $v, OrderBy: $o, Nulls: text($nl)}

rule alias_clause TableAlias = alias_as_cols / alias_as / alias_cols / alias_bare
rule alias_as_cols TableAlias = AS ws n:col_id_or_string ws "(" ws cs:name_list_opt_comma ws ")" => TableAlias{Name: $n, Columns: $cs, As: true}
rule alias_as TableAlias = AS ws n:col_id_or_string => TableAlias{Name: $n, As: true}
rule alias_cols TableAlias = n:col_id ws "(" ws cs:name_list_opt_comma ws ")" => TableAlias{Name: $n, Columns: $cs}
rule alias_bare TableAlias = n:col_id => TableAlias{Name: $n}
// func_alias_clause: the alias may name the columns with their types
rule func_alias_clause TableAlias = alias_as_cols / falias_as_defs / falias_defs_only / alias_cols / falias_defs / alias_as / alias_bare
rule falias_as_defs TableAlias = AS ws n:col_id_or_string ws "(" ws cd:table_func_element_list ws ")" => TableAlias{Name: $n, ColDefs: $cd, As: true}
rule falias_defs_only TableAlias = AS ws "(" ws cd:table_func_element_list ws ")" => TableAlias{ColDefs: $cd, As: true}
rule falias_defs TableAlias = n:col_id ws "(" ws cd:table_func_element_list ws ")" => TableAlias{Name: $n, ColDefs: $cd}
rule table_func_element_list []ColDef = first:table_func_element rest:(-ws -"," -ws e:table_func_element)* => concat(list($first), map($rest, (r) => r.e))
rule table_func_element ColDef = n:col_id_or_string ws t:typename (ws COLLATE ws c:any_name)? => ColDef{Name: $n, Type: $t, Collate: $c}
// ===================================================================================================
// INSERT, UPDATE, DELETE, MERGE (insert.y, update.y, delete.y, merge_into.y)
// ===================================================================================================

rule target_list []SelectItem = first:select_item rest:(-ws -"," -ws i:select_item)* => concat(list($first), map($rest, (r) => r.i))

rule insert_stmt InsertStmt = (
    (w:with_clause ws)? INSERT (ws oa:(OR ws (REPLACE / IGNORE)) #atomic)? ws INTO ws n:qualified_name (ws AS ws al:col_id)?
    (ws by:(BY ws (NAME / POSITION)) #atomic)?
    ws (dv:(DEFAULT ws VALUES) #atomic / (cs:insert_columns ws)? (ov:overriding ws)? q:select_stmt)
    (ws oc:on_conflict)?
    (ws RETURNING ws r:target_list)?
) => InsertStmt{With: $w, OrAction: text($oa), Table: $n, Alias: $al, By: text($by), Columns: concat($cs), Overriding: text($ov), Query: $q, DefaultValues: len($dv) > 0, OnConflict: $oc, Returning: concat($r)}
rule insert_columns []Name = "(" ws l:insert_column_list ws ")" => $l
rule insert_column_list []Name = first:set_target rest:(-ws -"," -ws c:set_target)* => concat(list($first), map($rest, (r) => r.c))
rule set_target Name = any_name
rule overriding Match = (OVERRIDING ws (USER / SYSTEM) ws VALUE) #atomic

rule on_conflict OnConflict = (
    ON ws CONFLICT
    (ws "(" ws ip:index_params ws ")" (ws WHERE ws tw:expr)? / ws ON ws CONSTRAINT ws c:name)?
    ws DO ws (UPDATE ws SET ws st:set_clause_list_opt_comma (ws WHERE ws w:expr)? / nothing:NOTHING)
) => OnConflict{Target: concat($ip), TargetWhere: $tw, Constraint: $c, Nothing: len($nothing) > 0, Set: concat($st), Where: $w}
rule index_params []IndexElem = first:index_elem rest:(-ws -"," -ws e:index_elem)* => concat(list($first), map($rest, (r) => r.e))
rule index_elem IndexElem = index_elem_func / index_elem_col / index_elem_expr
rule index_elem_col IndexElem = (
    c:col_id (ws COLLATE ws co:any_name)? (ws cl:opt_class)? (ws d:asc_desc)? (ws n:nulls_order)?
) => IndexElem{Expr: ColumnRef{Parts: list($c)}, Collate: $co, Class: $cl, Direction: text($d), Nulls: text($n)}
rule index_elem_func IndexElem = (
    f:func_expr_windowless (ws COLLATE ws co:any_name)? (ws cl:opt_class)? (ws d:asc_desc)? (ws n:nulls_order)?
) => IndexElem{Expr: $f, Collate: $co, Class: $cl, Direction: text($d), Nulls: text($n)}
rule index_elem_expr IndexElem = (
    "(" ws e:expr ws ")" (ws COLLATE ws co:any_name)? (ws cl:opt_class)? (ws d:asc_desc)? (ws n:nulls_order)?
) => IndexElem{Expr: $e, Collate: $co, Class: $cl, Direction: text($d), Nulls: text($n)}
rule opt_class Name = !(NULLS ws (FIRST / LAST)) n:any_name => $n

rule set_clause_list_opt_comma []SetClause = first:set_clause rest:(-ws -"," -ws c:set_clause)* (ws ",")? => concat(list($first), map($rest, (r) => r.c))
rule set_clause SetClause = set_clause_paren / set_clause_one
rule set_clause_one SetClause = t:set_target ws op_eq ws v:expr => SetClause{Targets: list($t), Value: $v}
rule set_clause_paren SetClause = (
    "(" ws first:set_target rest:(-ws -"," -ws c:set_target)* ws ")" ws op_eq ws v:expr
) => SetClause{Targets: concat(list($first), map($rest, (r) => r.c)), Value: $v, Paren: true}

// relation_expr_opt_alias. SET is an unreserved keyword that follows the table of UPDATE.
rule target_table TargetTable = (
    (n:qualified_name st:(ws op_star)? / o:ONLY ws "(" ws n:qualified_name ws ")" / o:ONLY ws n:qualified_name) (ws kw:AS ws al:col_id / ws !SET al:col_id)?
) => TargetTable{Name: $n, Only: len($o) > 0, Star: len($st) > 0, Alias: $al, As: len($kw) > 0}

rule update_stmt UpdateStmt = (
    (w:with_clause ws)? UPDATE ws t:target_table ws SET ws s:set_clause_list_opt_comma
    (ws FROM ws f:from_list_opt_comma)? (ws WHERE ws wh:expr)? (ws RETURNING ws r:target_list)?
) => UpdateStmt{With: $w, Table: $t, Set: $s, From: concat($f), Where: $wh, Returning: concat($r)}

rule delete_stmt DeleteStmt = (
    (w:with_clause ws)? DELETE ws FROM ws t:target_table (ws USING ws u:from_list_opt_comma)? (ws WHERE ws wh:expr)? (ws RETURNING ws r:target_list)?
) => DeleteStmt{With: $w, Table: $t, Using: concat($u), Where: $wh, Returning: concat($r)}
rule truncate_stmt DeleteStmt = TRUNCATE (ws TABLE)? ws t:target_table => DeleteStmt{Table: $t, Truncate: true}

rule merge_stmt MergeStmt = (
    (w:with_clause ws)? MERGE ws INTO ws t:target_table ws USING ws s:table_ref
    ws (ON ws on:expr / USING ws "(" ws us:name_list_opt_comma ws ")")
    ws first:merge_when rest:(-ws m:merge_when)* (ws RETURNING ws r:target_list)?
) => MergeStmt{With: $w, Target: $t, Source: $s, On: $on, Using: concat($us), Whens: concat(list($first), map($rest, (x) => x.m)), Returning: concat($r)}
rule merge_when MergeWhen = merge_when_matched / merge_when_not
rule merge_when_matched MergeWhen = WHEN ws MATCHED (ws AND ws c:expr)? ws THEN ws a:merge_action => MergeWhen{Not: false, Cond: $c, Action: $a}
rule merge_when_not MergeWhen = (
    WHEN ws NOT ws MATCHED (ws by:(BY ws (SOURCE / TARGET)) #atomic)? (ws AND ws c:expr)? ws THEN ws a:merge_action
) => MergeWhen{Not: true, By: text($by), Cond: $c, Action: $a}
rule merge_action MergeAction = ma_update_set / ma_update_star / ma_update / ma_delete / ma_insert_values / ma_insert_default / ma_insert / ma_nothing / ma_error
rule ma_update_set MergeAction = k:UPDATE ws SET ws s:set_clause_list_opt_comma => MergeAction{Kind: text($k), Set: $s}
rule ma_update_star MergeAction = k:UPDATE ws SET ws op_star => MergeAction{Kind: text($k), Star: true}
rule ma_update MergeAction = k:UPDATE (ws by:(BY ws (NAME / POSITION)) #atomic)? => MergeAction{Kind: text($k), ByName: text($by)}
rule ma_delete MergeAction = k:DELETE => MergeAction{Kind: text($k)}
rule ma_insert_values MergeAction = (
    k:INSERT (ws "(" ws cs:insert_column_ident_list ws ")")? ws VALUES ws "(" ws vs:expr_list_opt_comma ws ")"
) => MergeAction{Kind: text($k), Columns: concat($cs), Values: $vs}
rule insert_column_ident_list []Ident = first:col_id rest:(-ws -"," -ws c:col_id)* => concat(list($first), map($rest, (r) => r.c))
rule ma_insert_default MergeAction = k:INSERT ws DEFAULT ws VALUES => MergeAction{Kind: text($k), DefaultValues: true}
rule ma_insert MergeAction = k:INSERT (ws by:(BY ws (NAME / POSITION)) #atomic)? (ws st:op_star)? => MergeAction{Kind: text($k), ByName: text($by), Star: len($st) > 0}
rule ma_nothing MergeAction = k:(DO ws NOTHING) #atomic => MergeAction{Kind: text($k)}
rule ma_error MergeAction = k:ERROR (ws m:expr)? => MergeAction{Kind: text($k), Message: $m}
// ===================================================================================================
// CREATE (create.y, create_as.y, view.y, index.y, create_schema.y, create_sequence.y, create_type.y,
// create_function.y, create_secret.y)
// ===================================================================================================

rule opt_temp Match = (TEMPORARY / TEMP / LOCAL ws (TEMPORARY / TEMP) / GLOBAL ws (TEMPORARY / TEMP) / UNLOGGED) #atomic
rule if_not_exists Match = (IF ws NOT ws EXISTS) #atomic
rule if_exists Match = (IF ws EXISTS) #atomic
rule or_replace Match = (OR ws REPLACE) #atomic

// ---- CREATE TABLE ----

rule create_table_stmt CreateTableStmt = (
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws TABLE (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name
    ws "(" ws els:table_element_list ws ")"
    ps:(-ws p:partition_sorted_option)* (ws wo:opt_with_options)? (ws oc:on_commit_option)?
) => CreateTableStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Elements: $els, PartitionSorted: map($ps, (x) => x.p), With: concat($wo), OnCommit: text($oc)}
rule table_element_list []TableElement = first:table_element rest:(-ws -"," -ws e:table_element)* (ws ",")? => concat(list($first), map($rest, (r) => r.e))
rule table_element TableElement = table_constraint / table_like / column_def
rule partition_sorted_option PartitionSorted = k:(PARTITIONED / SORTED) #atomic ws BY ws "(" ws xs:expr_list_opt_comma ws ")" => PartitionSorted{Kind: $k, Exprs: $xs}
// OptWith: WITH reloptions | WITH OIDS | WITHOUT OIDS
rule opt_with_options []Reloption = with_reloptions / with_oids
rule with_reloptions []Reloption = WITH ws "(" ws l:reloption_list ws ")" => $l
rule with_oids []Reloption = WITH ws OIDS / WITHOUT ws OIDS => list()
rule on_commit_option Match = (ON ws COMMIT ws (DROP / DELETE ws ROWS / PRESERVE ws ROWS)) #atomic

rule reloption_list []Reloption = first:reloption_elem rest:(-ws -"," -ws e:reloption_elem)* => concat(list($first), map($rest, (r) => r.e))
rule reloption_elem Reloption = reloption_def / reloption_expr
rule reloption_def Reloption = a:col_label ws "." ws b:col_label (ws op_eq ws v:def_arg)? => Reloption{Name: Name{Parts: list($a, $b)}, Arg: $v}
rule reloption_expr Reloption = n:reloption_name (ws op_eq ws v:expr)? => Reloption{Name: $n, Value: $v}
rule reloption_name Name = c:col_label_or_string => Name{Parts: list($c)}
// def_arg: func_type | reserved_keyword | qual_all_Op | NumericOnly | Sconst | NONE
rule def_arg Match = (typename / &kw_reserved word / qual_all_op / numeric_only / sconst / NONE) #atomic
rule numeric_only Match = ((op_plus / op_minus)? ws number) #atomic
rule def_list []DefElem = first:def_elem rest:(-ws -"," -ws e:def_elem)* => concat(list($first), map($rest, (r) => r.e))
rule def_elem DefElem = n:col_label (ws op_eq ws v:def_arg)? => DefElem{Name: $n, Value: text($v)}
rule definition []DefElem = "(" ws l:def_list ws ")" => $l
rule opt_definition []DefElem = WITH ws d:definition => $d

// ---- Table elements ----

rule column_def ColumnDef = column_def_generated / column_def_regular
rule column_def_regular ColumnDef = n:col_id ws t:typename cs:(-ws c:col_constraint)* => ColumnDef{Name: $n, Type: $t, Constraints: map($cs, (x) => x.c)}
rule column_def_generated ColumnDef = (
    n:col_id (ws t:typename)? ws g:generated_constraint cs:(-ws c:col_constraint)*
) => ColumnDef{Name: $n, Type: $t, Generated: $g, Constraints: map($cs, (x) => x.c)}
rule generated_constraint GeneratedColumn = gen_identity / gen_expr / gen_as
rule gen_identity GeneratedColumn = GENERATED ws w:generated_when ws AS ws IDENTITY (ws "(" ws so:seq_opt_list ws ")")? => GeneratedColumn{When: text($w), Identity: true, SeqOptions: concat($so)}
rule gen_expr GeneratedColumn = GENERATED ws w:generated_when ws AS ws "(" ws e:expr ws ")" (ws st:generated_storage)? => GeneratedColumn{When: text($w), Expr: $e, Storage: text($st)}
rule gen_as GeneratedColumn = AS ws "(" ws e:expr ws ")" (ws st:generated_storage)? => GeneratedColumn{Expr: $e, Storage: text($st)}
rule generated_when Match = (ALWAYS / BY ws DEFAULT) #atomic
rule generated_storage = VIRTUAL / STORED

rule constraint_name Ident = CONSTRAINT ws n:name => $n
rule col_constraint ColumnConstraint = cc_not_null / cc_null / cc_unique / cc_primary / cc_check / cc_compression / cc_default / cc_references / cc_attr / cc_collate
rule cc_not_null ColumnConstraint = (cn:constraint_name ws)? k:(NOT ws NULL) #atomic => ColumnConstraint{Name: $cn, Kind: text($k)}
rule cc_null ColumnConstraint = (cn:constraint_name ws)? k:NULL => ColumnConstraint{Name: $cn, Kind: text($k)}
rule cc_unique ColumnConstraint = (cn:constraint_name ws)? k:UNIQUE (ws o:opt_definition)? => ColumnConstraint{Name: $cn, Kind: text($k), Options: concat($o)}
rule cc_primary ColumnConstraint = (cn:constraint_name ws)? k:(PRIMARY ws KEY) #atomic (ws o:opt_definition)? => ColumnConstraint{Name: $cn, Kind: text($k), Options: concat($o)}
rule cc_check ColumnConstraint = (cn:constraint_name ws)? k:CHECK ws "(" ws e:expr ws ")" (ws NO ws INHERIT)? => ColumnConstraint{Name: $cn, Kind: text($k), Expr: $e}
rule cc_compression ColumnConstraint = (cn:constraint_name ws)? k:(USING ws COMPRESSION) #atomic ws c:name => ColumnConstraint{Name: $cn, Kind: text($k), Compression: $c}
rule cc_default ColumnConstraint = (cn:constraint_name ws)? k:DEFAULT ws e:b_expr => ColumnConstraint{Name: $cn, Kind: text($k), Expr: $e}
rule cc_references ColumnConstraint = (cn:constraint_name ws)? k:REFERENCES ws r:reference => ColumnConstraint{Name: $cn, Kind: text($k), Reference: $r}
rule cc_attr ColumnConstraint = k:constraint_attr => ColumnConstraint{Kind: text($k)}
rule cc_collate ColumnConstraint = k:COLLATE ws c:any_name => ColumnConstraint{Kind: text($k), Collation: $c}
rule constraint_attr Match = (DEFERRABLE / NOT ws DEFERRABLE / INITIALLY ws (DEFERRED / IMMEDIATE)) #atomic

rule reference Reference = (
    t:qualified_name (ws "(" ws cs:column_list ws ")")? (ws m:key_match)?
    (ws (ku:key_update (ws kd:key_delete)? / kd:key_delete (ws ku:key_update)?))?
) => Reference{Table: $t, Columns: concat($cs), Match: $m, OnUpdate: $ku, OnDelete: $kd}
rule column_list []Ident = col_id_list
rule column_list_opt_comma []Ident = l:col_id_list (ws ",")? => $l
rule key_match Match = (MATCH ws (FULL / PARTIAL / SIMPLE)) #atomic
rule key_update Match = (ON ws UPDATE ws key_action) #atomic
rule key_delete Match = (ON ws DELETE ws key_action) #atomic
rule key_action = NO ws ACTION / RESTRICT / CASCADE / SET ws NULL / SET ws DEFAULT

rule table_constraint TableConstraint = tc_check / tc_unique / tc_unique_index / tc_primary / tc_primary_index / tc_foreign
rule constraint_attrs []Match = as:(-ws a:constraint_attribute)* => map($as, (x) => x.a)
rule constraint_attribute Match = (NOT ws DEFERRABLE / DEFERRABLE / INITIALLY ws IMMEDIATE / INITIALLY ws DEFERRED / NOT ws VALID / NO ws INHERIT) #atomic
rule tc_check TableConstraint = (cn:constraint_name ws)? k:CHECK ws "(" ws e:expr ws ")" at:constraint_attrs => TableConstraint{Name: $cn, Kind: text($k), Expr: $e, Attributes: $at}
rule tc_unique TableConstraint = (
    (cn:constraint_name ws)? k:UNIQUE ws "(" ws cs:column_list_opt_comma ws ")" (ws o:opt_definition)? at:constraint_attrs
) => TableConstraint{Name: $cn, Kind: text($k), Columns: $cs, Options: concat($o), Attributes: $at}
rule tc_unique_index TableConstraint = (cn:constraint_name ws)? k:UNIQUE ws USING ws INDEX ws i:col_id at:constraint_attrs => TableConstraint{Name: $cn, Kind: text($k), Index: $i, Attributes: $at}
rule tc_primary TableConstraint = (
    (cn:constraint_name ws)? k:(PRIMARY ws KEY) #atomic ws "(" ws cs:column_list_opt_comma ws ")" (ws o:opt_definition)? at:constraint_attrs
) => TableConstraint{Name: $cn, Kind: text($k), Columns: $cs, Options: concat($o), Attributes: $at}
rule tc_primary_index TableConstraint = (cn:constraint_name ws)? k:(PRIMARY ws KEY) #atomic ws USING ws INDEX ws i:col_id at:constraint_attrs => TableConstraint{Name: $cn, Kind: text($k), Index: $i, Attributes: $at}
rule tc_foreign TableConstraint = (
    (cn:constraint_name ws)? k:(FOREIGN ws KEY) #atomic ws "(" ws cs:column_list_opt_comma ws ")" ws REFERENCES ws r:reference at:constraint_attrs
) => TableConstraint{Name: $cn, Kind: text($k), Columns: $cs, Reference: $r, Attributes: $at}

rule table_like TableLike = LIKE ws t:qualified_name os:(-ws o:table_like_option)* => TableLike{Table: $t, Options: map($os, (x) => x.o)}
rule table_like_option Match = ((INCLUDING / EXCLUDING) ws (COMMENTS / CONSTRAINTS / DEFAULTS / IDENTITY / INDEXES / STATISTICS / STORAGE / ALL)) #atomic

// ---- CREATE TABLE AS ----

rule create_table_as_stmt CreateTableAsStmt = (
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws TABLE (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name
    (ws "(" ws cs:column_list ws ")")?
    ps:(-ws p:partition_sorted_option)* (ws wo:opt_with_options)? (ws oc:on_commit_option)?
    ws AS ws src:(select_stmt / execute_stmt) (ws wd:with_data)?
) => CreateTableAsStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Columns: concat($cs), PartitionSorted: map($ps, (x) => x.p), With: concat($wo), OnCommit: text($oc), Source: $src, WithData: text($wd)}
rule with_data Match = (WITH ws (NO ws)? DATA) #atomic

// ---- CREATE VIEW ----

rule create_view_stmt CreateViewStmt = (
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? (ws r:RECURSIVE)? ws VIEW (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name
    (ws "(" ws cs:column_list ws ")")? (ws WITH ws "(" ws o:reloption_list ws ")")? ws AS ws q:select_stmt (ws co:check_option)?
) => CreateViewStmt{OrReplace: len($orr) > 0, Temp: text($t), Recursive: len($r) > 0, IfNotExists: len($ine) > 0, Name: $n, Columns: concat($cs), Options: concat($o), Query: $q, CheckOption: text($co)}
rule check_option Match = (WITH ws (CASCADED ws / LOCAL ws)? CHECK ws OPTION) #atomic

// ---- CREATE INDEX ----

rule create_index_stmt CreateIndexStmt = (
    CREATE (ws u:UNIQUE)? ws INDEX (ws cc:CONCURRENTLY)? (ws ine:if_not_exists ws n:col_id / ws n:col_id)? ws ON ws t:qualified_name
    (ws USING ws m:col_id)? ws "(" ws ps:index_params ws ")" (ws WITH ws "(" ws o:reloption_list ws ")")? (ws WHERE ws w:expr)?
) => CreateIndexStmt{Unique: len($u) > 0, Concurrently: len($cc) > 0, IfNotExists: len($ine) > 0, Name: $n, Table: $t, Method: $m, Params: $ps, Options: concat($o), Where: $w}

// ---- CREATE SCHEMA, SEQUENCE, TYPE ----

rule create_schema_stmt CreateSchemaStmt = (
    CREATE (ws orr:or_replace)? ws SCHEMA (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name es:(-ws e:schema_stmt)*
) => CreateSchemaStmt{OrReplace: len($orr) > 0, IfNotExists: len($ine) > 0, Name: $n, Elements: map($es, (x) => x.e)}
rule schema_stmt Statement = create_table_stmt / create_index_stmt / create_sequence_stmt / create_view_stmt

rule create_sequence_stmt CreateSequenceStmt = (
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws SEQUENCE (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name (ws os:seq_opt_list)?
) => CreateSequenceStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Options: concat($os)}
rule seq_opt_list []SeqOption = first:seq_opt_elem rest:(-ws o:seq_opt_elem)* => concat(list($first), map($rest, (r) => r.o))
rule seq_opt_elem SeqOption = so_as / so_num / so_flag / so_owned / so_seqname / so_restart
rule so_as SeqOption = k:AS ws t:typename => SeqOption{Kind: text($k), Type: $t}
rule so_num SeqOption = k:(CACHE / INCREMENT (ws BY)? / MAXVALUE / MINVALUE / START (ws WITH)?) #atomic ws v:numeric_only => SeqOption{Kind: text($k), Value: text($v)}
rule so_flag SeqOption = k:(CYCLE / NO ws (CYCLE / MAXVALUE / MINVALUE)) #atomic => SeqOption{Kind: text($k)}
rule so_owned SeqOption = k:(OWNED ws BY) #atomic ws o:any_name => SeqOption{Kind: text($k), Owner: $o}
rule so_seqname SeqOption = k:(SEQUENCE ws NAME) #atomic ws o:any_name => SeqOption{Kind: text($k), Owner: $o}
rule so_restart SeqOption = k:RESTART (ws (WITH ws)? v:numeric_only)? => SeqOption{Kind: text($k), Value: text($v)}

rule create_type_stmt CreateTypeStmt = (
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws TYPE (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name ws AS ws
    (en:ENUM ws (q:select_with_parens / "(" ws vs:enum_val_list? ws ")") / !(ENUM ws "(") ty:typename)
) => CreateTypeStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Enum: len($en) > 0, Values: concat($vs), Query: $q, Type: $ty}
rule enum_val_list []StringLit = first:sconst rest:(-ws -"," -ws s:sconst)* => concat(list($first), map($rest, (r) => r.s))

// ---- CREATE MACRO ----

rule create_macro_stmt CreateMacroStmt = (
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws (f:FUNCTION / MACRO) (ws ine:if_not_exists {len($orr) == 0})? ws n:qualified_name ws ds:macro_definitions
) => CreateMacroStmt{OrReplace: len($orr) > 0, Temp: text($t), Function: len($f) > 0, IfNotExists: len($ine) > 0, Name: $n, Definitions: $ds}
rule macro_definitions []MacroDef = macro_table_list / macro_expr_list
rule macro_expr_list []MacroDef = first:macro_expr_def rest:(-ws -"," -ws d:macro_expr_def)* => concat(list($first), map($rest, (r) => r.d))
rule macro_expr_def MacroDef = ps:param_list ws AS ws e:expr => MacroDef{Params: $ps, Expr: $e}
rule macro_table_list []MacroDef = macro_table_one_end / macro_table_many
rule macro_table_one_end []MacroDef = l:macro_table_one &stmt_end => $l
rule macro_table_one []MacroDef = ps:param_list ws AS ws TABLE ws q:select_no_parens => list(MacroDef{Params: $ps, Query: $q})
rule macro_table_many []MacroDef = first:macro_table_paren rest:(-ws -"," -ws d:macro_table_paren)* => concat(list($first), map($rest, (r) => r.d))
rule macro_table_paren MacroDef = ps:param_list ws AS ws TABLE ws q:select_with_parens => MacroDef{Params: $ps, Query: $q}
rule param_list []MacroParam = "(" ws ps:macro_params? ws ")" => concat($ps)
rule macro_params []MacroParam = first:macro_param rest:(-ws -"," -ws p:macro_param)* (ws ",")? => concat(list($first), map($rest, (r) => r.p))
rule macro_param MacroParam = n:param_name (ws t:typename)? (ws (":=" / ar:op_eq_gt) ws d:expr)? => MacroParam{Name: $n, Type: $t, Default: $d, Arrow: len($ar) > 0}

// ---- CREATE SECRET ----

rule create_secret_stmt CreateSecretStmt = (
    CREATE (ws orr:or_replace)? (ws p:(TEMPORARY / PERSISTENT) #atomic)? ws SECRET (ws ine:if_not_exists {len($orr) == 0})? (ws n:col_id)? (ws IN ws st:ident_only)? ws "(" ws os:secret_options ws ")"
) => CreateSecretStmt{OrReplace: len($orr) > 0, Persist: text($p), IfNotExists: len($ine) > 0, Name: $n, Storage: $st, Options: $os}
rule secret_options []SecretOption = first:secret_option rest:(-ws -"," -ws o:secret_option)* => concat(list($first), map($rest, (r) => r.o))
rule secret_option SecretOption = n:col_label ws v:expr => SecretOption{Name: $n, Value: $v}
// ===================================================================================================
// ALTER, RENAME, DROP (alter_table.y, alter_sequence.y, alter_database.y, alter_schema.y, rename.y, drop.y)
// ===================================================================================================

rule alter_table_stmt AlterTableStmt = alter_relation_stmt / alter_name_stmt
rule alter_relation_stmt AlterTableStmt = (
    ALTER ws k:TABLE (ws ie:if_exists)? ws (n:qualified_name st:(ws op_star)? / o:ONLY ws "(" ws n:qualified_name ws ")" / o:ONLY ws n:qualified_name) ws cs:alter_table_cmds
) => AlterTableStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Only: len($o) > 0, Star: len($st) > 0, Commands: $cs}
rule alter_name_stmt AlterTableStmt = (
    ALTER ws k:(INDEX / SEQUENCE / VIEW) (ws ie:if_exists)? ws n:qualified_name ws cs:alter_table_cmds
) => AlterTableStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Commands: $cs}
rule alter_table_cmds []AlterCmd = first:alter_table_cmd rest:(-ws -"," -ws c:alter_table_cmd)* => concat(list($first), map($rest, (r) => r.c))

// a column that may be a path into a struct: a.b.c
rule qualified_column Name = n:any_name => $n

rule alter_table_cmd AlterCmd = (
    ac_add_constraint / ac_add_generated / ac_add_column / ac_set_partitioned / ac_reset_partitioned / ac_set_sorted / ac_reset_sorted
    / ac_alter_column / ac_drop_column / ac_alter_constraint / ac_validate / ac_drop_constraint
    / ac_set_logged / ac_set_options / ac_reset_options / ac_generic
)
rule ac_add_constraint AlterCmd = k:ADD ws c:table_constraint => AlterCmd{Kind: text($k), Constraint: $c}
rule ac_add_column AlterCmd = (
    k:(ADD (ws COLUMN)?) #atomic (ws ine:if_not_exists)? ws q:qualified_column ws t:typename cs:(-ws c:col_constraint)*
) => AlterCmd{Kind: text($k), IfNotExists: len($ine) > 0, Column: $q, Type: $t, Constraints: map($cs, (x) => x.c)}
rule ac_add_generated AlterCmd = (
    k:(ADD (ws COLUMN)?) #atomic (ws ine:if_not_exists)? ws q:qualified_column (ws t:typename)? ws g:generated_constraint cs:(-ws c:col_constraint)*
) => AlterCmd{Kind: text($k), IfNotExists: len($ine) > 0, Column: $q, Type: $t, Generated: $g, Constraints: map($cs, (x) => x.c)}
rule ac_set_partitioned AlterCmd = k:(SET ws PARTITIONED ws BY) #atomic ws "(" ws xs:expr_list_opt_comma ws ")" => AlterCmd{Kind: text($k), Exprs: $xs}
rule ac_reset_partitioned AlterCmd = k:(RESET ws PARTITIONED ws BY) #atomic => AlterCmd{Kind: text($k)}
rule ac_set_sorted AlterCmd = k:(SET ws SORTED ws BY) #atomic ws "(" ws l:sortby_list ws ")" => AlterCmd{Kind: text($k), SortBy: $l}
rule ac_reset_sorted AlterCmd = k:(RESET ws SORTED ws BY) #atomic => AlterCmd{Kind: text($k)}
rule sortby_list []SortItem = first:sortby rest:(-ws -"," -ws s:sortby)* => concat(list($first), map($rest, (r) => r.s))

rule ac_alter_column AlterCmd = (
    ac_col_default / ac_col_drop_default / ac_col_not_null / ac_col_statistics / ac_col_set_options / ac_col_reset_options
    / ac_col_storage / ac_col_add_identity / ac_col_drop_identity / ac_col_identity / ac_col_type / ac_col_generic
)
rule alter_column_head Match = (ALTER (ws COLUMN)?) #atomic
rule ac_col_default AlterCmd = k:alter_column_head ws c:col_id ws SET ws DEFAULT ws e:expr => AlterCmd{Kind: text($k), Name: $c, Expr: $e}
rule ac_col_drop_default AlterCmd = k:alter_column_head ws c:col_id ws DROP ws DEFAULT => AlterCmd{Kind: text($k), Name: $c}
rule ac_col_not_null AlterCmd = k:alter_column_head ws c:col_id ws (DROP / SET) ws NOT ws NULL => AlterCmd{Kind: text($k), Name: $c}
rule ac_col_statistics AlterCmd = k:alter_column_head ws c:col_id ws SET ws STATISTICS ws v:signed_iconst => AlterCmd{Kind: text($k), Name: $c, Value: text($v)}
rule ac_col_set_options AlterCmd = k:alter_column_head ws c:col_id ws SET ws "(" ws o:reloption_list ws ")" => AlterCmd{Kind: text($k), Name: $c, Options: $o}
rule ac_col_reset_options AlterCmd = k:alter_column_head ws c:col_id ws RESET ws "(" ws o:reloption_list ws ")" => AlterCmd{Kind: text($k), Name: $c, Options: $o}
rule ac_col_storage AlterCmd = k:alter_column_head ws c:col_id ws SET ws STORAGE ws v:col_id #atomic => AlterCmd{Kind: text($k), Name: $c, Value: text($v)}
rule ac_col_add_identity AlterCmd = (
    k:alter_column_head ws c:col_id ws ADD ws GENERATED ws w:generated_when ws AS ws IDENTITY (ws "(" ws so:seq_opt_list ws ")")?
) => AlterCmd{Kind: text($k), Name: $c, When: text($w), Identity: concat($so)}
rule ac_col_drop_identity AlterCmd = k:alter_column_head ws c:col_id ws DROP ws IDENTITY (ws ie:if_exists)? => AlterCmd{Kind: text($k), Name: $c, IfExists: len($ie) > 0}
rule ac_col_identity AlterCmd = k:alter_column_head ws c:col_id ws is:identity_options => AlterCmd{Kind: text($k), Name: $c, Identity: $is}
rule identity_options []SeqOption = first:identity_option rest:(-ws o:identity_option)* => concat(list($first), map($rest, (r) => r.o))
rule identity_option SeqOption = so_restart / io_set / io_generated
rule io_set SeqOption = SET ws o:seq_opt_elem => $o
rule io_generated SeqOption = k:(SET ws GENERATED) #atomic ws w:generated_when => SeqOption{Kind: text($k), Value: text($w)}
rule ac_col_type AlterCmd = (
    k:alter_column_head ws c:col_id ws (SET ws DATA ws / SET ws)? TYPE (ws t:typename)? (ws COLLATE ws co:any_name)? (ws USING ws u:expr)?
) => AlterCmd{Kind: text($k), Name: $c, Type: $t, Collate: $co, Using: $u}
rule ac_col_generic AlterCmd = k:alter_column_head ws c:col_id ws g:alter_generic_options => AlterCmd{Kind: text($k), Name: $c, Generic: $g}
rule signed_iconst Match = ((op_plus / op_minus)? ws iconst) #atomic

rule ac_drop_column AlterCmd = k:(DROP (ws COLUMN)?) #atomic (ws ie:if_exists)? ws q:qualified_column (ws b:drop_behavior)? => AlterCmd{Kind: text($k), IfExists: len($ie) > 0, Column: $q, Behavior: text($b)}
rule ac_alter_constraint AlterCmd = k:(ALTER ws CONSTRAINT) #atomic ws n:name constraint_attrs => AlterCmd{Kind: text($k), Name: $n}
rule ac_validate AlterCmd = k:(VALIDATE ws CONSTRAINT) #atomic ws n:name => AlterCmd{Kind: text($k), Name: $n}
rule ac_drop_constraint AlterCmd = k:(DROP ws CONSTRAINT) #atomic (ws ie:if_exists)? ws n:name (ws b:drop_behavior)? => AlterCmd{Kind: text($k), IfExists: len($ie) > 0, Name: $n, Behavior: text($b)}
rule ac_set_logged AlterCmd = k:(SET ws (LOGGED / UNLOGGED)) #atomic => AlterCmd{Kind: text($k)}
rule ac_set_options AlterCmd = k:SET ws "(" ws o:reloption_list ws ")" => AlterCmd{Kind: text($k), Options: $o}
rule ac_reset_options AlterCmd = k:RESET ws "(" ws o:reloption_list ws ")" => AlterCmd{Kind: text($k), Options: $o}
rule ac_generic AlterCmd = k:OPTIONS ws g:alter_generic_list => AlterCmd{Kind: text($k), Generic: $g}
rule alter_generic_options []GenericAlterOption = OPTIONS ws g:alter_generic_list => $g
rule alter_generic_list []GenericAlterOption = "(" ws first:alter_generic_option rest:(-ws -"," -ws o:alter_generic_option)* ws ")" => concat(list($first), map($rest, (r) => r.o))
rule alter_generic_option GenericAlterOption = ago_value / ago_drop
rule ago_value GenericAlterOption = (a:(SET / ADD) ws)? n:col_label ws v:sconst => GenericAlterOption{Action: text($a), Name: $n, Value: $v}
rule ago_drop GenericAlterOption = a:DROP ws n:col_label => GenericAlterOption{Action: text($a), Name: $n}
rule drop_behavior = CASCADE / RESTRICT

rule alter_sequence_stmt AlterSequenceStmt = ALTER ws SEQUENCE (ws ie:if_exists)? ws n:qualified_name ws os:seq_opt_list => AlterSequenceStmt{IfExists: len($ie) > 0, Name: $n, Options: $os}
rule alter_database_stmt AlterDatabaseStmt = ALTER ws DATABASE (ws ie:if_exists)? ws n:col_id ws SET ws s:ident_only ws TO ws v:col_id => AlterDatabaseStmt{IfExists: len($ie) > 0, Name: $n, Setting: $s, Value: $v}
rule alter_object_schema_stmt AlterObjectSchemaStmt = alter_schema_relation / alter_schema_name
rule alter_schema_relation AlterObjectSchemaStmt = (
    ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws SET ws SCHEMA ws s:name
) => AlterObjectSchemaStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Schema: $s}
rule alter_schema_name AlterObjectSchemaStmt = (
    ALTER ws k:(SEQUENCE / VIEW) (ws ie:if_exists)? ws n:qualified_name ws SET ws SCHEMA ws s:name
) => AlterObjectSchemaStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Schema: $s}

rule rename_stmt RenameStmt = rename_schema / rename_column / rename_constraint / rename_object
rule rename_schema RenameStmt = k:(ALTER ws SCHEMA) #atomic ws n:name ws RENAME ws TO ws t:name => RenameStmt{Object: text($k), Name: Name{Parts: list($n)}, NewName: $t}
rule rename_object RenameStmt = rename_relation / rename_name
rule rename_relation RenameStmt = (
    ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws RENAME ws TO ws t:name
) => RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, NewName: $t}
rule rename_name RenameStmt = (
    ALTER ws k:(SEQUENCE / VIEW / INDEX) (ws ie:if_exists)? ws n:qualified_name ws RENAME ws TO ws t:name
) => RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, NewName: $t}
rule rename_column RenameStmt = (
    ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws RENAME (ws COLUMN)? ws c:qualified_column ws TO ws t:name
) => RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Column: $c, NewName: $t}
rule rename_constraint RenameStmt = (
    ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws RENAME ws CONSTRAINT ws c:name ws TO ws t:name
) => RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Constraint: $c, NewName: $t}

// ---- DROP ----

rule drop_stmt DropStmt = drop_any_name / drop_name / drop_on
rule drop_any_name DropStmt = DROP ws k:drop_type_any_name (ws ie:if_exists)? ws ns:any_name_list (ws b:drop_behavior)? => DropStmt{Type: text($k), IfExists: len($ie) > 0, Names: $ns, Behavior: text($b)}
rule drop_name DropStmt = DROP ws k:drop_type_name (ws ie:if_exists)? ws ns:name_as_name_list (ws b:drop_behavior)? => DropStmt{Type: text($k), IfExists: len($ie) > 0, Names: $ns, Behavior: text($b)}
rule drop_on DropStmt = (
    DROP ws k:(POLICY / RULE / TRIGGER) #atomic (ws ie:if_exists)? ws n:name ws ON ws o:any_name (ws b:drop_behavior)?
) => DropStmt{Type: text($k), IfExists: len($ie) > 0, Names: list(Name{Parts: list($n)}), On: $o, Behavior: text($b)}
rule drop_type_any_name Match = (TABLE / SEQUENCE / FUNCTION / MACRO (ws TABLE)? / VIEW / MATERIALIZED ws VIEW / INDEX / FOREIGN ws TABLE / COLLATION / CONVERSION / SCHEMA / STATISTICS / TEXT ws SEARCH ws (PARSER / DICTIONARY / TEMPLATE / CONFIGURATION) / TYPE) #atomic
rule drop_type_name Match = (ACCESS ws METHOD / EVENT ws TRIGGER / EXTENSION / FOREIGN ws DATA ws WRAPPER / PUBLICATION / SERVER) #atomic
rule any_name_list []Name = first:any_name rest:(-ws -"," -ws n:any_name)* => concat(list($first), map($rest, (r) => r.n))
rule name_as_name_list []Name = first:name rest:(-ws -"," -ws n:name)* => concat(list(Name{Parts: list($first)}), map($rest, (r) => Name{Parts: list(r.n)}))
rule drop_secret_stmt DropSecretStmt = (
    DROP (ws p:(TEMPORARY / PERSISTENT) #atomic)? ws SECRET (ws ie:if_exists)? ws n:col_id (ws FROM ws st:ident_only)?
) => DropSecretStmt{Persist: text($p), IfExists: len($ie) > 0, Name: $n, Storage: $st}
// ===================================================================================================
// COPY, EXPORT, ATTACH, SET, SHOW, EXPLAIN, ... (copy.y, export.y, attach.y, load.y, pragma.y, ...)
// ===================================================================================================

// ---- COPY ----

rule copy_stmt Statement = copy_table / copy_query / copy_database
rule copy_table CopyStmt = (
    COPY (ws b:BINARY)? ws t:qualified_name (ws "(" ws cs:column_list ws ")")? (ws WITH ws OIDS)?
    ws d:(FROM / TO) (ws pr:PROGRAM)? ws (f:copy_file / s:(STDIN / STDOUT) #atomic)
    (ws (USING ws)? DELIMITERS ws dl:sconst)? (ws WITH)?
    (ws g:generic_opt_list / ls:(-ws o:copy_opt_item)*)
) => CopyStmt{Binary: len($b) > 0, Table: $t, Columns: concat($cs), Direction: text($d), Program: len($pr) > 0, File: $f, Std: text($s), Delimiters: $dl, Legacy: map($ls, (x) => x.o), Options: concat($g)}
rule copy_query CopyStmt = (
    COPY ws "(" ws q:select_stmt ws ")" ws d:TO (ws pr:PROGRAM)? ws (f:copy_file / s:(STDIN / STDOUT) #atomic) (ws WITH)?
    (ws g:generic_opt_list / ls:(-ws o:copy_opt_item)*)
) => CopyStmt{Query: $q, Direction: text($d), Program: len($pr) > 0, File: $f, Std: text($s), Legacy: map($ls, (x) => x.o), Options: concat($g)}
rule copy_database CopyDatabaseStmt = COPY ws FROM ws DATABASE ws f:col_id ws TO ws t:col_id (ws fl:copy_database_flag)? => CopyDatabaseStmt{From: $f, To: $t, Flag: text($fl)}
rule copy_database_flag Match = ("(" ws (SCHEMA / DATA) ws ")") #atomic
// Sconst | IDENT '.' ColId | IDENT | '(' a_expr ')' | param_expr
rule copy_file Expr = sconst / copy_ident_file / paren_expr / param
rule copy_ident_file ColumnRef = a:ident_only bs:(-ws -"." -ws c:col_id) #repeat(0, 1) => ColumnRef{Parts: concat(list($a), map($bs, (x) => x.c))}
rule generic_opt_list []GenericOption = "(" ws first:generic_opt_elem rest:(-ws -"," -ws o:generic_opt_elem)* ws ")" => concat(list($first), map($rest, (r) => r.o))
rule generic_opt_elem GenericOption = n:col_label (ws v:expr)? => GenericOption{Name: $n, Value: $v}
rule copy_opt_item CopyOption = co_flag / co_string / co_force_cols / co_force_star / co_partition_cols / co_partition_star
rule co_flag CopyOption = k:(BINARY / OIDS / FREEZE / CSV / HEADER) => CopyOption{Name: text($k)}
rule co_string CopyOption = k:(DELIMITER / NULL / QUOTE / ESCAPE / ENCODING) (ws AS)? ws v:sconst #atomic => CopyOption{Name: text($k), Value: text($v)}
rule co_force_cols CopyOption = k:(FORCE ws (QUOTE / NOT ws NULL / NULL)) #atomic ws cs:column_list => CopyOption{Name: text($k), Columns: $cs}
rule co_force_star CopyOption = k:(FORCE ws QUOTE) #atomic ws v:op_star => CopyOption{Name: text($k), Value: text($v)}
rule co_partition_cols CopyOption = k:(PARTITION ws BY) #atomic ws cs:column_list => CopyOption{Name: text($k), Columns: $cs}
rule co_partition_star CopyOption = k:(PARTITION ws BY) #atomic ws v:op_star => CopyOption{Name: text($k), Value: text($v)}

rule export_stmt ExportStmt = (
    EXPORT ws DATABASE (ws d:col_id ws TO)? ws p:sconst (ws g:generic_opt_list / ls:(-ws o:copy_opt_item)*)
) => ExportStmt{Database: $d, Path: $p, Legacy: map($ls, (x) => x.o), Options: concat($g)}
rule import_stmt ImportStmt = IMPORT ws DATABASE ws p:sconst => ImportStmt{Path: $p}

// ---- ATTACH, DETACH, USE, LOAD ----

rule attach_stmt AttachStmt = (
    ATTACH (ws ine:if_not_exists / ws orr:or_replace)? (ws db:DATABASE)? ws p:sconst (ws AS ws a:col_id)? (ws o:generic_opt_list)?
) => AttachStmt{OrReplace: len($orr) > 0, IfNotExists: len($ine) > 0, Database: len($db) > 0, Path: $p, Alias: $a, Options: concat($o)}
rule detach_stmt DetachStmt = detach_database / detach_plain
rule detach_database DetachStmt = DETACH ws DATABASE (ws ie:if_exists)? ws n:col_label => DetachStmt{Database: true, IfExists: len($ie) > 0, Name: $n}
rule detach_plain DetachStmt = DETACH ws n:col_label => DetachStmt{Name: $n}
rule use_stmt UseStmt = USE ws n:qualified_name => UseStmt{Name: $n}
rule load_stmt LoadStmt = load_install / load_load
rule load_load LoadStmt = LOAD ws n:col_id_or_string => LoadStmt{Name: $n}
rule load_install LoadStmt = (
    (f:FORCE ws)? INSTALL ws n:col_id_or_string (ws FROM ws s:col_id_or_string)? (ws VERSION ws v:col_id_or_string)?
) => LoadStmt{Install: true, Force: len($f) > 0, Name: $n, Source: $s, Version: $v}

// ---- PRAGMA, SET, RESET, SHOW ----

rule pragma_stmt PragmaStmt = pragma_call / pragma_set / pragma_plain
rule pragma_call PragmaStmt = PRAGMA ws n:col_id ws "(" ws a:func_arg_list ws ")" => PragmaStmt{Name: $n, Args: $a, Call: true}
rule pragma_set PragmaStmt = PRAGMA ws n:col_id ws op_eq ws v:expr_list => PragmaStmt{Name: $n, Values: $v}
rule pragma_plain PragmaStmt = PRAGMA ws n:col_id => PragmaStmt{Name: $n}

rule var_name Name = first:col_id rest:(-ws -"." -ws c:col_id)* => Name{Parts: concat(list($first), map($rest, (r) => r.c))}
rule set_scope = LOCAL / SESSION / GLOBAL / VARIABLE
rule set_stmt SetStmt = set_scoped / set_unscoped
rule set_scoped SetStmt = (
    SET ws sc:set_scope ws
    (n:var_name ws (TO / op_eq) ws v:expr_list / n:var_name ws fc:(FROM ws CURRENT) #atomic / TIME ws ZONE ws z:zone_value / SCHEMA ws s:sconst)
) => SetStmt{Scope: text($sc), Name: $n, Values: concat($v), TimeZone: text($z), FromCurrent: len($fc) > 0, Schema: $s}
rule set_unscoped SetStmt = (
    SET ws
    (n:var_name ws (TO / op_eq) ws v:expr_list / n:var_name ws fc:(FROM ws CURRENT) #atomic / TIME ws ZONE ws z:zone_value / SCHEMA ws s:sconst)
) => SetStmt{Name: $n, Values: concat($v), TimeZone: text($z), FromCurrent: len($fc) > 0, Schema: $s}
rule zone_value Match = (sconst / ident_only / INTERVAL ws sconst (ws interval_unit)? / INTERVAL ws "(" ws iconst ws ")" ws sconst / numeric_only / DEFAULT / LOCAL) #atomic

rule reset_stmt ResetStmt = reset_scoped / reset_unscoped
rule reset_scoped ResetStmt = (
    RESET ws sc:set_scope ws (a:ALL / sp:(TIME ws ZONE / TRANSACTION ws ISOLATION ws LEVEL) #atomic / n:var_name)
) => ResetStmt{Scope: text($sc), Name: $n, All: len($a) > 0, Special: text($sp)}
rule reset_unscoped ResetStmt = (
    RESET ws (a:ALL / sp:(TIME ws ZONE / TRANSACTION ws ISOLATION ws LEVEL) #atomic / n:var_name)
) => ResetStmt{Name: $n, All: len($a) > 0, Special: text($sp)}

rule show_stmt ShowStmt = show_query / summarize_query / summarize_table / show_tables / show_time_zone / show_isolation / show_all / show_name / show_bare
rule show_word = SHOW / DESCRIBE / DESC
rule show_query ShowStmt = k:show_word ws q:select_stmt => ShowStmt{Kind: text($k), Query: $q}
rule summarize_query ShowStmt = k:SUMMARIZE ws q:select_stmt => ShowStmt{Kind: text($k), Query: $q}
rule summarize_table ShowStmt = k:SUMMARIZE ws n:qualified_name => ShowStmt{Kind: text($k), Name: $n}
rule show_tables ShowStmt = k:show_word ws TABLES ws FROM ws n:qualified_name => ShowStmt{Kind: text($k), Tables: true, From: $n}
rule show_time_zone ShowStmt = k:show_word ws s:(TIME ws ZONE) #atomic => ShowStmt{Kind: text($k), Special: text($s)}
rule show_isolation ShowStmt = k:show_word ws s:(TRANSACTION ws ISOLATION ws LEVEL) #atomic => ShowStmt{Kind: text($k), Special: text($s)}
rule show_all ShowStmt = k:show_word ws ALL (ws t:TABLES)? => ShowStmt{Kind: text($k), All: true, Tables: len($t) > 0}
rule show_name ShowStmt = k:show_word ws n:qualified_name => ShowStmt{Kind: text($k), Name: $n}
rule show_bare ShowStmt = k:show_word => ShowStmt{Kind: text($k)}

// ---- EXPLAIN, PREPARE, EXECUTE ----

rule explain_stmt ExplainStmt = explain_options / explain_analyze / explain_verbose / explain_plain
rule explain_options ExplainStmt = EXPLAIN ws "(" ws os:explain_option_list ws ")" ws s:explainable => ExplainStmt{Options: $os, Stmt: $s}
rule explain_analyze ExplainStmt = EXPLAIN ws a:(ANALYZE / ANALYSE) (ws v:VERBOSE)? ws s:explainable => ExplainStmt{Analyze: text($a), Verbose: len($v) > 0, Stmt: $s}
rule explain_verbose ExplainStmt = EXPLAIN ws VERBOSE ws s:explainable => ExplainStmt{Verbose: true, Stmt: $s}
rule explain_plain ExplainStmt = EXPLAIN ws s:explainable => ExplainStmt{Stmt: $s}
rule explain_option_list []ExplainOption = first:explain_option rest:(-ws -"," -ws o:explain_option)* => concat(list($first), map($rest, (r) => r.o))
rule explain_option ExplainOption = n:(non_reserved_word / ANALYZE / ANALYSE) #atomic (ws v:(TRUE / FALSE / ON / non_reserved_word / sconst / numeric_only) #atomic)? => ExplainOption{Name: text($n), Value: text($v)}
// ExplainableStmt: everything but EXPLAIN, ANALYZE, USE, ATTACH, DETACH, EXPORT, IMPORT, COMMENT, DROP SECRET, CREATE SECRET...
rule explainable Statement = (
    alter_table_stmt / alter_sequence_stmt / alter_object_schema_stmt / rename_stmt / call_stmt / checkpoint_stmt / copy_stmt
    / create_table_stmt / create_table_as_stmt / create_macro_stmt / create_schema_stmt / create_sequence_stmt / create_type_stmt / create_index_stmt / create_view_stmt
    / deallocate_stmt / delete_stmt / drop_stmt / execute_stmt / insert_stmt / load_stmt / merge_stmt / pragma_stmt / prepare_stmt / select_stmt / truncate_stmt
    / transaction_stmt / update_stmt / update_extensions_stmt / vacuum_stmt / reset_stmt / set_stmt / show_stmt
)

rule prepare_stmt PrepareStmt = PREPARE ws n:name (ws "(" ws ts:type_list ws ")")? ws AS ws s:preparable => PrepareStmt{Name: $n, Types: concat($ts), Stmt: $s}
rule preparable Statement = select_stmt / insert_stmt / update_stmt / copy_stmt / delete_stmt / show_stmt / truncate_stmt
rule execute_stmt ExecuteStmt = EXECUTE ws n:name (ws "(" ws ps:execute_params ws ")")? => ExecuteStmt{Name: $n, Params: concat($ps)}
rule execute_params []Expr = first:execute_param rest:(-ws -"," -ws p:execute_param)* => concat(list($first), map($rest, (r) => r.p))
rule execute_param Expr = named_arg / expr
rule deallocate_stmt DeallocateStmt = deallocate_prepare / deallocate_plain
rule deallocate_prepare DeallocateStmt = DEALLOCATE ws PREPARE ws (a:ALL / n:name) => DeallocateStmt{Name: $n, All: len($a) > 0}
rule deallocate_plain DeallocateStmt = DEALLOCATE ws (a:ALL / n:name) => DeallocateStmt{Name: $n, All: len($a) > 0}

// ---- Transactions, maintenance, ... ----

rule transaction_stmt TransactionStmt = tx_start / tx_end
rule tx_start TransactionStmt = k:(BEGIN / START) (ws w:(WORK / TRANSACTION))? (ws m:(READ ws (ONLY / WRITE)) #atomic)? => TransactionStmt{Kind: text($k), Work: text($w), Mode: text($m)}
rule tx_end TransactionStmt = k:(ABORT / COMMIT / END / ROLLBACK) (ws w:(WORK / TRANSACTION))? => TransactionStmt{Kind: text($k), Work: text($w)}

rule vacuum_stmt VacuumStmt = vacuum_options / vacuum_plain
rule vacuum_options VacuumStmt = VACUUM ws "(" ws os:vacuum_option_list ws ")" (ws t:qualified_name (ws "(" ws cs:name_list_opt_comma ws ")")?)? => VacuumStmt{Options: $os, Table: $t, Columns: concat($cs)}
rule vacuum_option_list []Match = first:vacuum_option rest:(-ws -"," -ws o:vacuum_option)* => concat(list($first), map($rest, (r) => r.o))
rule vacuum_option Match = (ANALYZE / ANALYSE / VERBOSE / FREEZE / FULL / ident_only) #atomic
rule vacuum_plain VacuumStmt = (
    VACUUM (ws f:FULL)? (ws fr:FREEZE)? (ws v:VERBOSE)? (ws (a:analyze_stmt / t:qualified_name (ws "(" ws cs:name_list_opt_comma ws ")")?))?
) => VacuumStmt{Full: len($f) > 0, Freeze: len($fr) > 0, Verbose: len($v) > 0, Analyze: $a, Table: $t, Columns: concat($cs)}
rule analyze_stmt AnalyzeStmt = (ANALYZE / ANALYSE) (ws v:VERBOSE)? (ws t:qualified_name (ws "(" ws cs:name_list_opt_comma ws ")")?)? => AnalyzeStmt{Verbose: len($v) > 0, Table: $t, Columns: concat($cs)}
rule checkpoint_stmt CheckpointStmt = (f:FORCE ws)? CHECKPOINT (ws d:col_id)? => CheckpointStmt{Force: len($f) > 0, Database: $d}
rule call_stmt CallStmt = CALL ws f:func_call => CallStmt{Func: $f}
rule comment_stmt CommentStmt = comment_column / comment_object
rule comment_column CommentStmt = k:(COMMENT ws ON ws COLUMN) #atomic ws c:c_expr ws IS ws v:comment_value => CommentStmt{Object: text($k), Column: $c, Comment: $v}
rule comment_object CommentStmt = (
    COMMENT ws ON ws k:(TABLE / SEQUENCE / FUNCTION / MACRO (ws TABLE)? / VIEW / DATABASE / INDEX / SCHEMA / TYPE) #atomic ws n:qualified_name ws IS ws v:comment_value
) => CommentStmt{Object: text($k), Name: $n, Comment: $v}
rule comment_value StringLit = sconst / null_text
rule null_text StringLit = NULL
rule update_extensions_stmt UpdateExtensionsStmt = (w:with_clause ws)? UPDATE ws EXTENSIONS (ws "(" ws ns:column_list ws ")")? => UpdateExtensionsStmt{With: $w, Names: concat($ns)}

// ===================================================================================================
// Scripts
// ===================================================================================================

rule stmt_end = ws (";" / $$)

rule main Script = (
    ws (";" ws)* first:statement #repeat(0, 1) rest:(-ws -";" -ws (-";" -ws)* s:statement)* ws (";" ws)* $$
) => Script{Statements: concat($first, map($rest, (r) => r.s))}

rule statement Statement = (
    select_stmt / insert_stmt / update_stmt / delete_stmt / merge_stmt
    / create_table_stmt / create_table_as_stmt / create_view_stmt / create_index_stmt / create_schema_stmt / create_sequence_stmt / create_type_stmt / create_macro_stmt / create_secret_stmt
    / drop_secret_stmt / drop_stmt / alter_table_stmt / alter_sequence_stmt / alter_database_stmt / alter_object_schema_stmt / rename_stmt
    / copy_stmt / export_stmt / import_stmt / attach_stmt / detach_stmt / use_stmt / load_stmt
    / set_stmt / reset_stmt / pragma_stmt / show_stmt / explain_stmt / prepare_stmt / execute_stmt / deallocate_stmt
    / transaction_stmt / vacuum_stmt / analyze_stmt / checkpoint_stmt / call_stmt / comment_stmt / update_extensions_stmt / truncate_stmt
)

// BEGIN GENERATED KEYWORDS (internal/refgen/keywords.py; do not edit)

// The keywords are matched without regard to ASCII case, and only as whole words.

rule ABORT = [aA] [bB] [oO] [rR] [tT] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ACCESS = [aA] [cC] [cC] [eE] [sS] [sS] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ACTION = [aA] [cC] [tT] [iI] [oO] [nN] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ADD = [aA] [dD] [dD] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ALL = [aA] [lL] [lL] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ALTER = [aA] [lL] [tT] [eE] [rR] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ALWAYS = [aA] [lL] [wW] [aA] [yY] [sS] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ANALYSE = [aA] [nN] [aA] [lL] [yY] [sS] [eE] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ANALYZE = [aA] [nN] [aA] [lL] [yY] [zZ] [eE] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule AND = [aA] [nN] [dD] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ANTI = [aA] [nN] [tT] [iI] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ANY = [aA] [nN] [yY] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ARRAY = [aA] [rR] [rR] [aA] [yY] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule AS = [aA] [sS] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ASC = [aA] [sS] [cC] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ASOF = [aA] [sS] [oO] [fF] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ASYMMETRIC = [aA] [sS] [yY] [mM] [mM] [eE] [tT] [rR] [iI] [cC] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule AT = [aA] [tT] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule ATTACH = [aA] [tT] [tT] [aA] [cC] [hH] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BEGIN = [bB] [eE] [gG] [iI] [nN] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BETWEEN = [bB] [eE] [tT] [wW] [eE] [eE] [nN] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BIGINT = [bB] [iI] [gG] [iI] [nN] [tT] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BINARY = [bB] [iI] [nN] [aA] [rR] [yY] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BIT = [bB] [iI] [tT] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BOOLEAN = [bB] [oO] [oO] [lL] [eE] [aA] [nN] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BOTH = [bB] [oO] [tT] [hH] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule BY = [bB] [yY] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CACHE = [cC] [aA] [cC] [hH] [eE] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CALL = [cC] [aA] [lL] [lL] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CASCADE = [cC] [aA] [sS] [cC] [aA] [dD] [eE] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CASCADED = [cC] [aA] [sS] [cC] [aA] [dD] [eE] [dD] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CASE = [cC] [aA] [sS] [eE] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CAST = [cC] [aA] [sS] [tT] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CENTURIES = [cC] [eE] [nN] [tT] [uU] [rR] [iI] [eE] [sS] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CENTURY = [cC] [eE] [nN] [tT] [uU] [rR] [yY] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CHAR = [cC] [hH] [aA] [rR] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CHARACTER = [cC] [hH] [aA] [rR] [aA] [cC] [tT] [eE] [rR] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CHECK = [cC] [hH] [eE] [cC] [kK] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

rule CHECKPOINT = [cC] [hH] [eE] [cC] [kK] [pP] [oO] [iI] [nN] [tT] ![a-zA-Z0-9_$\u{80}-\u{9f}¡-\u{1fff}\u{200c}-\u{202e}‰-⁞\u{2061}-⿿、-\u{fefe}\u{ff00}-\u{10ffff}]

