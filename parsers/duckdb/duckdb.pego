package duckdb

// ===================================================================================================
// Names, literals and types
// ===================================================================================================

// An identifier, a keyword used as a name, or a string used as a name, as written (quotes included).
type Ident terminal
// A qualified name: a, a.b, a.b.c
type Name struct { Parts []Ident }

type Number terminal    // an integer, decimal or real literal as written
type StringLit terminal // a string literal as written: '...', E'...', $$...$$, U&'...'
type BitLit terminal    // B'...' or X'...'
type BoolLit terminal   // TRUE or FALSE
type NullLit terminal   // NULL
type Param terminal     // ?, ?1, $1 or $name

// A type: its name as written ("int", "double precision", "a.b.t"), and its modifiers, fields and array dimensions.
type Type struct {
    Name   string
    Mods   []Expr      // (10, 2) of decimal(10, 2); the length of varchar(20)
    Fields []TypeField // struct(a int, b text) and union(...)
    Elems  []Type      // the key and value types of map(k, v)
    Dims   []ArrayDim  // [] and [3]
    Zone   string      // WITH TIME ZONE, WITHOUT TIME ZONE
}
type TypeField struct { Name Ident, Type Type }
type ArrayDim struct { Size *Number }

// ===================================================================================================
// Expressions
// ===================================================================================================

type Paren struct { X Expr }
type ColumnRef struct { Parts []Ident }
type DefaultExpr terminal // DEFAULT
type PositionalRef struct { Index Number } // #1

// * and t.* with their modifiers, and COLUMNS(...) and UNPACK(...)
type Star struct {
    Qualifier *Ident
    Exclude   []Name
    Replace   []ReplaceItem
    Rename    []RenameItem
}
type ReplaceItem struct { Expr Expr, Name Ident }
type RenameItem struct { From Name, To Ident }
type ColumnsExpr struct { Arg Expr, Star bool } // COLUMNS(expr) and *COLUMNS(expr)
type UnpackExpr struct { Arg Expr }

type Binary struct { Left Expr, Op Match, Right Expr }   // a + b, a AND b, a = b, a -> b, a ~~ b, ...
type Unary struct { Op Match, X Expr }                    // -a, +a, ~a
type PostfixOp struct { X Expr, Op Match }                // a !
type Not struct { X Expr }
type IsExpr struct { X Expr, Negated bool, Test string }   // IS [NOT] NULL|TRUE|FALSE|UNKNOWN, ISNULL, NOTNULL, NOT NULL
type DistinctFrom struct { Left Expr, Right Expr, Negated bool }
type IsOf struct { X Expr, Types []Type, Negated bool }
type Between struct { X Expr, Lo Expr, Hi Expr, Negated bool, Symmetric bool }
// x IN (a, b), x IN (SELECT ...), x IN y
type In struct { X Expr, Negated bool, Query *ParenQuery, Items []Expr, Source *Expr }
// x [NOT] LIKE|ILIKE|GLOB|SIMILAR TO pattern [ESCAPE esc]
type Like struct { X Expr, Negated bool, Op string, Pattern Expr, Escape *Expr }
// x = ANY (subquery), x < ALL (...)
type AnyAll struct { X Expr, Op string, Quantifier string, Source Expr }
type AtTimeZone struct { X Expr, Zone Expr }
type Collate struct { X Expr, Collation Name }
type Cast struct { X Expr, Type Type, Try bool, Shorthand bool } // CAST(x AS t), TRY_CAST, x::t
type Case struct { Arg *Expr, Whens []When, Else *Expr }
type When struct { Cond Expr, Then Expr }
type Row struct { Items []Expr, Keyword bool }            // ROW(a, b) and (a, b)
type ListLit struct { Items []Expr }                      // [a, b]
type ArrayLit struct { Items []Expr }                     // ARRAY[a, b]
type StructLit struct { Fields []StructField }            // {'a': 1, b: 2}
type StructField struct { Name Ident, Value Expr }
type MapLit struct { Entries []MapEntry }                 // MAP {k: v}
type MapEntry struct { Key Expr, Value Expr }
type ListComp struct { Expr Expr, Vars []Ident, Source Expr, Cond Expr } // [x + 1 FOR x IN l IF x > 1]
type Lambda struct { Params []Ident, Body Expr, Keyword bool }          // x -> body is a Binary; LAMBDA x: body
type Subquery struct { Query ParenQuery }                 // (SELECT ...)
type Exists struct { Query ParenQuery }
type ArraySubquery struct { Query ParenQuery }            // ARRAY(SELECT ...)
type Grouping struct { Name string, Args []Expr }          // GROUPING(a, b), GROUPING_ID(a, b)
type TypedLit struct { Type Type, Value StringLit }       // DATE '2020-01-01', DECIMAL(10, 2) '1.5'
type IntervalLit struct { Value Expr, Unit *IntervalUnit } // INTERVAL '1' DAY, INTERVAL (x) HOUR, INTERVAL 5 DAY
type IntervalUnit terminal                                // DAY, YEAR TO MONTH, ...
type NamedArg struct { Name Ident, Value Expr, Arrow bool } // name := value, name => value (Arrow)
// A function call, with the clauses that follow it.
type FuncCall struct {
    Name        Name
    Quantifier  string      // ALL or DISTINCT
    Args        []Expr
    Variadic    *Expr
    OrderBy     *OrderBy
    Nulls       string      // IGNORE NULLS or RESPECT NULLS
    WithinGroup *OrderBy
    Filter      *Expr
    ExportState bool
    Over        *WindowOver
}
// The functions with a syntax of their own: COALESCE, NULLIF, EXTRACT(part FROM x), OVERLAY(x PLACING y FROM a FOR b),
// POSITION(a IN b), SUBSTRING(x FROM a FOR b), TRIM([BOTH|LEADING|TRAILING] chars FROM x), TREAT(x AS t),
// COLLATION FOR (x)
type SpecialCall struct {
    Name    string
    Spec    string   // the part of EXTRACT, the side of TRIM
    Args    []Expr
    From    []Expr
    For     *Expr
    Placing *Expr
    Chars   *Expr    // the characters of TRIM(BOTH chars FROM x)
    Type    *Type
}
// An indirection of an expression: x.field, x.method(args), x[i], x[lo:hi], x[lo:hi:step]; x.a[1] is two of them.
type Indirection struct { X Expr, Step Step }
type Step = FieldStep | IndexStep | SliceStep
type FieldStep struct { Name Ident, Call bool, Args []Expr }
type IndexStep struct { Index Expr }
type SliceStep struct { Lo *Expr, Hi *Expr, Stride *Expr, Dash bool }

type WindowOver struct { Name *Ident, Spec *WindowSpec }
type WindowSpec struct { Base *Ident, PartitionBy []Expr, OrderBy *OrderBy, Frame *Frame }
type Frame struct { Unit string, Start FrameBound, End *FrameBound, Exclude string }
type FrameBound struct { Kind string, Expr *Expr }
type WindowDef struct { Name Ident, Spec WindowSpec }

type OrderBy struct { Items []SortItem, All bool, Direction string, Nulls string }
type SortItem struct { Expr Expr, Using string, Direction string, Nulls string }

type Expr = Number | StringLit | BitLit | BoolLit | NullLit | Param | Paren | ColumnRef | DefaultExpr | PositionalRef
    | Star | ColumnsExpr | UnpackExpr | Binary | Unary | PostfixOp | Not | IsExpr | DistinctFrom | IsOf | Between | In
    | Like | AnyAll | AtTimeZone | Collate | Cast | Case | Row | ListLit | ArrayLit | StructLit | MapLit | ListComp
    | Lambda | Subquery | Exists | ArraySubquery | Grouping | TypedLit | IntervalLit | NamedArg | FuncCall
    | SpecialCall | Indirection | GroupingSet
type GroupingSet struct { Kind string, Items []Expr }       // CUBE(...), ROLLUP(...), GROUPING SETS(...), ()
// ===================================================================================================
// Queries
// ===================================================================================================

// A query as a statement or in parentheses: WITH, a body (SELECT, set operations, VALUES, ...), and what orders and
// limits it.
type Select struct {
    With    *With
    Body    QueryBody
    OrderBy *OrderBy
    Limit   *LimitClause
    Offset  *OffsetClause
    Locking []LockClause
}
type ParenQuery struct { Query ParenContent }
type ParenContent = Select | ParenQuery | ShowStmt
type QueryBody = SelectCore | ValuesClause | TableQuery | PivotQuery | UnpivotQuery | SetOp | ParenQuery

type With struct { Recursive bool, CTEs []CTE }
type CTE struct { Name Ident, Columns []Ident, UsingKey []Ident, Materialized *Match, Query Statement }

// UNION, EXCEPT and INTERSECT
type SetOp struct { Left QueryBody, Op string, Quantifier string, ByName bool, Right QueryBody }

type SelectCore struct {
    FromFirst bool            // FROM t SELECT ...
    Distinct  *DistinctClause
    Items     []SelectItem
    Into      *IntoClause
    From      []TableRef
    Where     *Expr
    GroupBy   *GroupBy
    Having    *Expr
    Windows   []WindowDef
    Qualify   *Expr
    Sample    *SampleClause
}
type DistinctClause struct { On []Expr }
type SelectItem struct { Expr Expr, Alias *Ident, As bool, Prefix bool } // expr AS alias, expr alias, alias: expr
type IntoClause struct { Temp string, Table Name }
type GroupBy struct { All bool, Items []Expr }
type ValuesClause struct { Rows []ValuesRow }
type ValuesRow struct { Items []Expr }
type TableQuery struct { Table Name }                    // TABLE t
type PivotQuery struct { Source TableRef, On []PivotColumn, Using []SelectItem, GroupBy []Ident }
type PivotColumn struct { Expr Expr, In []SelectItem, Query *Select, Enum *Ident }
type UnpivotQuery struct { Source TableRef, On []SelectItem, Name *Ident, Values []Ident }

type LimitClause struct { Keyword string, All bool, Value *Expr, Percent string, Offset *Expr }
type OffsetClause struct { Value Expr, Rows string }
type LockClause struct { Strength string, Of []Name, Wait string }

type SampleClause struct { Method *Ident, Value Expr, Unit string, Repeatable *Number, Seed *Number }
type AtClause struct { Unit string, Value Expr }

// ---- Tables in FROM ----

// An alias of a table: t, AS t, t(a, b); that of a function can name the columns with their types (t(a int)), and may
// have no name (AS (a int)).
type TableAlias struct { Name *Ident, Columns []Ident, ColDefs []ColDef, As bool }
type ColDef struct { Name Ident, Type Type, Collate *Name }
type BaseTable struct { Prefix *Ident, Name Name, Only bool, Star bool, Alias *TableAlias, At *AtClause, Sample *SampleClause }
type FuncTable struct {
    Prefix     *Ident         // the alias in alias: f(x)
    Func       Expr
    RowsFrom   []RowsFromItem
    Lateral    bool
    Ordinality bool
    Alias      *TableAlias
    Sample     *SampleClause
}
type RowsFromItem struct { Func Expr, ColDefs []ColDef }
type SubqueryRef struct { Prefix *Ident, Query ParenQuery, Lateral bool, Alias *TableAlias, Sample *SampleClause }
type ValuesRef struct { Prefix *Ident, Values ValuesClause, Alias TableAlias, Sample *SampleClause }
type ParenTable struct { Prefix *Ident, Table TableRef, Alias *TableAlias }
// Kind: the words before JOIN: LEFT OUTER, NATURAL, CROSS, ...
type Join struct { Left TableRef, Kind string, Right TableRef, On *Expr, Using []Ident }
type PivotRef struct { Source TableRef, Aggregates []SelectItem, Values []PivotValue, GroupBy []Ident, Alias *TableAlias }
type PivotValue struct { Header []Expr, Items []SelectItem, Enum *Ident }
type UnpivotRef struct { Source TableRef, IncludeNulls *Match, Header []Ident, Values []UnpivotValue, Alias *TableAlias }
type UnpivotValue struct { Header []Ident, Items []SelectItem }
type TableRef = BaseTable | FuncTable | SubqueryRef | ValuesRef | ParenTable | Join | PivotRef | UnpivotRef
// ===================================================================================================
// Statements
// ===================================================================================================

// The statements of a script, separated by semicolons.
type Script struct { Statements []Statement }

type Statement = Select | InsertStmt | UpdateStmt | DeleteStmt | MergeStmt | CreateTableStmt | CreateTableAsStmt
    | CreateViewStmt | CreateIndexStmt | CreateSchemaStmt | CreateSequenceStmt | CreateTypeStmt | CreateMacroStmt
    | CreateSecretStmt | AlterTableStmt | AlterSequenceStmt | AlterDatabaseStmt | AlterObjectSchemaStmt | RenameStmt
    | DropStmt | DropSecretStmt | CopyStmt | CopyDatabaseStmt | ExportStmt | ImportStmt | AttachStmt | DetachStmt
    | UseStmt | LoadStmt | PragmaStmt | SetStmt | ResetStmt | ShowStmt | ExplainStmt | PrepareStmt | ExecuteStmt
    | DeallocateStmt | TransactionStmt | VacuumStmt | AnalyzeStmt | CheckpointStmt | CallStmt | CommentStmt
    | UpdateExtensionsStmt

// The table of INSERT, UPDATE, DELETE and MERGE, with its alias.
type TargetTable struct { Name Name, Only bool, Star bool, Alias *Ident, As bool }

// ---- DML ----

type InsertStmt struct {
    With          *With
    OrAction      string      // OR REPLACE, OR IGNORE
    Table         Name
    Alias         *Ident
    By            string      // BY NAME, BY POSITION
    Columns       []Name
    Overriding    string      // OVERRIDING USER VALUE, OVERRIDING SYSTEM VALUE
    Query         *Select
    DefaultValues bool
    OnConflict    *OnConflict
    Returning     []SelectItem
}
type OnConflict struct {
    Target      []IndexElem
    TargetWhere *Expr
    Constraint  *Ident
    Nothing     bool
    Set         []SetClause
    Where       *Expr
}
type IndexElem struct { Expr Expr, Collate *Name, Class *Name, Direction string, Nulls string }
type SetClause struct { Targets []Name, Value Expr, Paren bool }

type UpdateStmt struct { With *With, Table TargetTable, Set []SetClause, From []TableRef, Where *Expr, Returning []SelectItem }
type DeleteStmt struct { With *With, Table TargetTable, Using []TableRef, Where *Expr, Returning []SelectItem, Truncate bool }
type MergeStmt struct { With *With, Target TargetTable, Source TableRef, On *Expr, Using []Ident, Whens []MergeWhen, Returning []SelectItem }
type MergeWhen struct { Not bool, By string, Cond *Expr, Action MergeAction }
// UPDATE SET ..., UPDATE SET *, UPDATE [BY NAME], DELETE, INSERT (cols) VALUES (...), INSERT [BY NAME] [*], INSERT DEFAULT VALUES,
// DO NOTHING, ERROR [message]
type MergeAction struct {
    Kind          string
    Set           []SetClause
    ByName        string
    Star          bool
    Columns       []Ident
    Values        []Expr
    DefaultValues bool
    Message       *Expr
}

// ---- CREATE ----

type CreateTableStmt struct {
    OrReplace     bool
    Temp          string
    IfNotExists   bool
    Name          Name
    Elements      []TableElement
    PartitionSorted []PartitionSorted
    With          []Reloption
    OnCommit      string
}
// PARTITIONED BY (...) or SORTED BY (...)
type PartitionSorted struct { Kind Match, Exprs []Expr }
type TableElement = ColumnDef | TableConstraint | TableLike
type ColumnDef struct { Name Ident, Type *Type, Generated *GeneratedColumn, Constraints []ColumnConstraint }
// GENERATED ALWAYS AS IDENTITY, GENERATED ALWAYS AS (expr) [VIRTUAL|STORED], AS (expr)
type GeneratedColumn struct { When string, Identity bool, SeqOptions []SeqOption, Expr *Expr, Storage string }
type ColumnConstraint struct {
    Name        *Ident
    Kind        string        // NOT NULL, NULL, UNIQUE, PRIMARY KEY, CHECK, DEFAULT, REFERENCES, COLLATE, USING COMPRESSION, DEFERRABLE, ...
    Expr        *Expr
    Reference   *Reference
    Collation   *Name
    Compression *Ident
    Options     []DefElem
}
type Reference struct { Table Name, Columns []Ident, Match *Match, OnUpdate *Match, OnDelete *Match }
type TableConstraint struct {
    Name       *Ident
    Kind       string         // CHECK, UNIQUE, PRIMARY KEY, FOREIGN KEY
    Columns    []Ident
    Expr       *Expr
    Reference  *Reference
    Index      *Ident        // USING INDEX name
    Options    []DefElem
    Attributes []Match       // DEFERRABLE, NOT VALID, ...
}
type TableLike struct { Table Name, Options []Match }
// name = value in WITH (...) options: the value is a type, a keyword, an operator, a number or a string.
type DefElem struct { Name Ident, Value string }
// A storage option: name, name = expr, a.b = value
type Reloption struct { Name Name, Value *Expr, Arg *Match }
type GenericOption struct { Name Ident, Value *Expr }

type CreateTableAsStmt struct {
    OrReplace     bool
    Temp          string
    IfNotExists   bool
    Name          Name
    Columns       []Ident
    PartitionSorted []PartitionSorted
    With          []Reloption
    OnCommit      string
    Source        Statement    // a query, or EXECUTE
    WithData      string       // WITH DATA, WITH NO DATA
}
type CreateViewStmt struct {
    OrReplace   bool
    Temp        string
    Recursive   bool
    IfNotExists bool
    Name        Name
    Columns     []Ident
    Options     []Reloption
    Query       Select
    CheckOption string
}
type CreateIndexStmt struct {
    Unique       bool
    Concurrently bool
    IfNotExists  bool
    Name         *Ident
    Table        Name
    Method       *Ident
    Params       []IndexElem
    Options      []Reloption
    Where        *Expr
}
type CreateSchemaStmt struct { OrReplace bool, IfNotExists bool, Name Name, Elements []Statement }
type CreateSequenceStmt struct { OrReplace bool, Temp string, IfNotExists bool, Name Name, Options []SeqOption }
type SeqOption struct { Kind string, Type *Type, Value string, Owner *Name }
type CreateTypeStmt struct {
    OrReplace   bool
    Temp        string
    IfNotExists bool
    Name        Name
    Enum        bool
    Values      []StringLit
    Query       *ParenQuery
    Type        *Type
}
type CreateMacroStmt struct { OrReplace bool, Temp string, Function bool, IfNotExists bool, Name Name, Definitions []MacroDef }
type MacroDef struct { Params []MacroParam, Expr *Expr, Query *ParenContent }
type MacroParam struct { Name Ident, Type *Type, Default *Expr, Arrow bool }
type CreateSecretStmt struct { OrReplace bool, Persist string, IfNotExists bool, Name *Ident, Storage *Ident, Options []SecretOption }
type SecretOption struct { Name Ident, Value Expr }

// ---- ALTER, RENAME, DROP ----

type AlterTableStmt struct { Object string, IfExists bool, Name Name, Only bool, Star bool, Commands []AlterCmd }
// One command of ALTER TABLE: Kind holds its words (ADD COLUMN, DROP CONSTRAINT, ALTER COLUMN ... SET DEFAULT, ...)
type AlterCmd struct {
    Kind        string
    IfExists    bool
    IfNotExists bool
    Column      *Name
    Type        *Type
    Generated   *GeneratedColumn
    Constraints []ColumnConstraint
    Constraint  *TableConstraint
    Name        *Ident
    Expr        *Expr
    Exprs       []Expr
    SortBy      []SortItem
    Collate     *Name
    Using       *Expr
    Value       string
    Options     []Reloption
    Identity    []SeqOption
    When        string
    Behavior    string
    Generic     []GenericAlterOption
}
type GenericAlterOption struct { Action string, Name Ident, Value *StringLit }
type AlterSequenceStmt struct { IfExists bool, Name Name, Options []SeqOption }
type AlterDatabaseStmt struct { IfExists bool, Name Ident, Setting Ident, Value Ident }
type AlterObjectSchemaStmt struct { Object string, IfExists bool, Name Name, Schema Ident }
type RenameStmt struct { Object string, IfExists bool, Name Name, Column *Name, Constraint *Ident, NewName Ident }
type DropStmt struct { Type string, IfExists bool, Names []Name, On *Name, Behavior string }
type DropSecretStmt struct { Persist string, IfExists bool, Name Ident, Storage *Ident }

// ---- COPY, EXPORT, ATTACH, ... ----

type CopyStmt struct {
    Binary     bool
    Table      *Name
    Columns    []Ident
    Query      *Select
    Direction  string        // FROM or TO
    Program    bool
    File       *Expr
    Std        string       // STDIN, STDOUT
    Delimiters *StringLit
    Legacy     []CopyOption
    Options    []GenericOption
}
type CopyOption struct { Name string, Value string, Columns []Ident }
type CopyDatabaseStmt struct { From Ident, To Ident, Flag string }
type ExportStmt struct { Database *Ident, Path StringLit, Legacy []CopyOption, Options []GenericOption }
type ImportStmt struct { Path StringLit }
type AttachStmt struct { OrReplace bool, IfNotExists bool, Database bool, Path StringLit, Alias *Ident, Options []GenericOption }
type DetachStmt struct { Database bool, IfExists bool, Name Ident }
type UseStmt struct { Name Name }
type LoadStmt struct { Install bool, Force bool, Name Ident, Source *Ident, Version *Ident }
type PragmaStmt struct { Name Ident, Values []Expr, Args []Expr, Call bool }
type SetStmt struct { Scope string, Name *Name, Values []Expr, TimeZone string, FromCurrent bool, Schema *StringLit }
type ResetStmt struct { Scope string, Name *Name, All bool, Special string }
// SHOW, DESCRIBE and SUMMARIZE
type ShowStmt struct { Kind string, Query *Select, Name *Name, Tables bool, From *Name, Special string, All bool }
type ExplainStmt struct { Analyze string, Verbose bool, Options []ExplainOption, Stmt Statement }
type ExplainOption struct { Name string, Value string }
type PrepareStmt struct { Name Ident, Types []Type, Stmt Statement }
type ExecuteStmt struct { Name Ident, Params []Expr }
type DeallocateStmt struct { Name *Ident, All bool }
type TransactionStmt struct { Kind string, Work string, Mode string }
type VacuumStmt struct { Full bool, Freeze bool, Verbose bool, Options []Match, Analyze *AnalyzeStmt, Table *Name, Columns []Ident }
type AnalyzeStmt struct { Verbose bool, Table *Name, Columns []Ident }
type CheckpointStmt struct { Force bool, Database *Ident }
type CallStmt struct { Func FuncCall }
type CommentStmt struct { Object string, Name *Name, Column *Expr, Comment *StringLit }
type UpdateExtensionsStmt struct { With *With, Names []Ident }
// ===================================================================================================
// Lexical structure (scan.l)
//
// The scanner of DuckDB (PostgreSQL's flex scanner) is part of the grammar: a rule for a token matches the
// token only, and whitespace and comments are skipped between tokens, where a rule needs them, with ws
// written before the token it precedes. The keywords are rules of their own (SELECT, GROUP, ...),
// generated at the end of the file.
// ===================================================================================================

// Whitespace is the five characters of the scanner's {space}, "--" comments, and /* */ comments, which nest.
def ws = (?\t\n\f\r \u{a0}\u{2000}-\u{200b}\u{202f}\u{205f}\u{2060}\u{3000}\u{feff})* (comment (?\t\n\f\r \u{a0}\u{2000}-\u{200b}\u{202f}\u{205f}\u{2060}\u{3000}\u{feff})*)*
def comment = "--" (?^\r\n)* / block_comment
def block_comment = "/*" (block_comment / !"*/" .)* "*/"

// A character that can continue an identifier or a keyword: the scanner's {ident_cont}, which takes every byte
// of a non-ASCII character.
def wc = (?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})
def ident_start = (?a-zA-Z_\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

// ---- Identifiers ----

// An unquoted word or a quoted identifier. Case is preserved: the scanner of DuckDB does not fold it.
// NULLS before FIRST or LAST is the token NULLS_LA of the scanner, which is not a name
def word = !((?eEbBxXnN) "'" / (?uU) "&'") !(&(?nN) NULLS ws (FIRST / LAST)) ident_start wc*
def quoted_ident = "\"" ((?^")+ / "\"\"")+ "\""
// U&"..." with Unicode escapes
def uquoted_ident = (?uU) "&" quoted_ident (ws (?uU)(?eE)(?sS)(?cC)(?aA)(?pP)(?eE) ws "'" (?^') "'")?

// The kinds of names of the grammar differ in the keywords they may not be (see keywords.py). A quoted
// identifier is always a name.
def col_id: Ident = quoted_ident / uquoted_ident / !kw_not_col_id word
def type_function_name: Ident = quoted_ident / uquoted_ident / !kw_not_type_func word
def function_name_token: Ident = quoted_ident / uquoted_ident / !kw_not_func_name word
def type_name_token: Ident = quoted_ident / uquoted_ident / !kw_not_type_name word
// IDENT: not a keyword at all
def ident_only: Ident = quoted_ident / uquoted_ident / !kw_any word
// ColLabel: any word
// NOT before BETWEEN, IN, LIKE, ILIKE and SIMILAR is a token of its own (NOT_LA) that no name accepts
def col_label: Ident = quoted_ident / uquoted_ident / !(NOT ws (BETWEEN / IN / LIKE / ILIKE / SIMILAR)) word
def non_reserved_word: Ident = quoted_ident / uquoted_ident / !kw_reserved word

// ---- Strings ----

def sq_cont = ((?\t\f ) / "--" (?^\r\n)*)* (?\r\n) ((?\t\n\f\r )+ / "--" (?^\r\n)* (?\r\n))* "'"
// A standard string: '' is a quote, and strings separated by whitespace with a newline in it are one.
def sq_string = "'" ((?^')+ / "''")* "'" (sq_cont ((?^')+ / "''")* "'")*
// An escape string: E'...' where \ escapes. \u and \U need four and eight hexadecimal digits.
def e_body = ((?^\\')+ / "''" / "\\" ((?uU) &(hex4) / !(?uU) .))*
def e_string = (?eE) "'" e_body "'" (sq_cont e_body "'")*
def u_string = (?uU) "&'" ((?^')+ / "''")* "'"
def hex4 = (?0-9a-fA-F){4}
// Dollar quoting: $$...$$ and $tag$...$tag$; the string ends at the same tag.
def dollar_string = "$" t:dq_tag "$" [tag = text($t)] ((?^$)+ / !dq_close "$")* dq_close
def dq_close = "$" u:dq_tag "$" [text($u) == tag]
def dq_tag = (?a-zA-Z_\u{80}-\u{10ffff}) (?a-zA-Z_0-9\u{80}-\u{10ffff})* / _
def bit_string = (?bBxX) "'" (?^')* "'" (sq_cont (?^')* "'")*

def sconst: StringLit = e_string / sq_string / dollar_string / u_string
def bit_lit: BitLit = bit_string

// ---- Numbers ----

def digits = (?0-9) ((?0-9) / "_" (?0-9))*
// An integer, a decimal or a real, as one token; an integer outside the range of an int32 is a float constant for
// the grammar (see iconst).
def number: Number = (digits ("." !"." digits?)? / "." digits) exp?
def exp = (?eE) (?+\-)? digits
// ICONST: an integer literal that fits in 32 bits
def iconst: Number = i:int_lit [len(text($i)) < 10 || len(text($i)) == 10 && text($i) <= "2147483647"]
def int_lit = @(digits !("." !".") !(?eE))

// ---- Operators ----

// op_chars of the scanner, and the characters that make an operator "special": an operator that has one of them
// is never shortened (see the {operator} rule).
def opc = (?~!@^&|`+\-*/%<>=)
def cut = "--" / "/*"
// a character of an operator: one that does not begin a comment
def rc = !cut opc
// the rest of an operator is only + and -: they are trimmed from the end of an operator without special characters
def pm_end = (!cut (?+\-))* !rc

def op_plus = @("+" &pm_end)
def op_minus = @("-" &pm_end)
def op_star = @("*" &pm_end)
def op_slash = @("/" &pm_end)
def op_lt = @("<" &pm_end)
def op_gt = @(">" &pm_end)
def op_eq = @("=" &pm_end)
def op_le = @("<=" &pm_end)
def op_ge = @(">=" &pm_end)
def op_ne = @("<>" &pm_end / "!=" !rc)
def op_eq_gt = @("=>" &pm_end)
def op_percent = @("%" !rc)
def op_caret = @("^" !rc)
def op_pow = @("**" !opc)
def op_idiv = @("//" !opc)
def op_arrow = @("->" !opc)
def op_darrow = @("->>" !opc)
// Any other operator: one with a special character, or a longer or unknown one made of + - * / < > =.
def op_generic: Match = &opc o:@(op_special / op_plain) -> $o
def op_special = !(("^" / "%" / "!=") !rc) (!cut (?+\-*/<>=))* (?~!@^&|`%) (!cut opc)*
def op_plain = &(core_long) !(("<=" / ">=" / "=>" / "<>") &pm_end) !(("**" / "//" / "->>" / "->") !opc) core
def core = ((!cut (?+\-))* !cut (?*/<>=))+
def core_long = !((?*/<>=) &pm_end) core
// ===================================================================================================
// Names
// ===================================================================================================

def col_id_or_string: Ident = col_id / sconst
def name: Ident = col_id_or_string
def attr_name: Ident = col_label
def param_name: Ident = type_function_name

// qualified_name: ColIdOrString | ColId indirection (the dots)
def qualified_name: Name = qn_dotted / qn_string
def qn_dotted: Name = p:col_id rest:(-ws -"." -ws a:attr_name)+ -> new Name{Parts: concat(list($p), map($rest, (r) => $r.a))}
def qn_string: Name = s:col_id_or_string -> new Name{Parts: list($s)}
// any_name: ColId | ColId attrs
def any_name: Name = p:col_id rest:(-ws -"." -ws a:attr_name)* -> new Name{Parts: concat(list($p), map($rest, (r) => $r.a))}
def name_list: []Ident = first:name rest:(-ws -"," -ws n:name)* -> concat(list($first), map($rest, (r) => $r.n))
def name_list_opt_comma: []Ident = l:name_list (ws ",")? -> $l
def col_id_list: []Ident = first:col_id rest:(-ws -"," -ws n:col_id)* -> concat(list($first), map($rest, (r) => $r.n))

// func_name: function_name_token | ColId indirection
def func_name: Name = fn_single / fn_dotted
def fn_dotted: Name = p:col_id rest:(-ws -"." -ws a:attr_name)+ -> new Name{Parts: concat(list($p), map($rest, (r) => $r.a))}
def fn_single: Name = n:function_name_token &(ws "(") -> new Name{Parts: list($n)}

// ===================================================================================================
// Expressions
// ===================================================================================================

// The operators are ordered as the %left/%right declarations of the grammar of DuckDB order their tokens, from
// the loosest. An operator that takes its right operand itself (postfix with r:...) is one whose rule has a
// precedence of its own in the grammar (see comments at the levels).
def expr: Expr = pratt {
    skip ws
    operand star_primary
    operand chained

    // a -> b and a ->> b. As a token, ->> has the lowest precedence (an expression on its left side is complete),
    // but its rule has the precedence of Op, so its right side is an operand of the arithmetic operators.
    level lv_arrow {
        infix left &"-" op_arrow -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
        postfix &"-" o:op_darrow ws r:expr(lv_add) -> new Binary{Left: $lhs, Op: $o, Right: $r}
    }
    level lv_or {
        infix left &(?oO) OR -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_and {
        infix left &(?aA) AND -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_not {
        prefix NOT -> new Not{X: $rhs}
    }
    // IS and its relatives take no right operand (except IS DISTINCT FROM)
    level lv_is {
        postfix &(?iInN) (IS ws n:NOT? ws t:(NULL / TRUE / FALSE / UNKNOWN) / t:ISNULL / nn:NOT ws t:NULL) -> new IsExpr{X: $lhs, Negated: len($n) > 0 || len($nn) > 0, Test: text($t)}
        postfix &(?nN) t:NOTNULL -> new IsExpr{X: $lhs, Negated: true, Test: text($t)}
        postfix &(?iI) IS ws n:NOT? ws DISTINCT ws FROM ws r:expr(lv_cmp) !(ws is_start) -> new DistinctFrom{Left: $lhs, Right: $r, Negated: len($n) > 0}
        postfix &(?iI) IS ws n:NOT? ws OF ws "(" ws ts:type_list ws ")" !(ws is_start) -> new IsOf{X: $lhs, Types: $ts, Negated: len($n) > 0}
    }
    level lv_cmp {
        postfix &(?<>=!) o:cmp_op ws r:expr(lv_like) !(ws cmp_op) -> new Binary{Left: $lhs, Op: $o, Right: $r}
        postfix &(?+\-*/<>=~!@^&|`%oOnNlLgGiI) o:subquery_op ws q:(ANY / SOME / ALL) ws s:any_source -> new AnyAll{X: $lhs, Op: text($o), Quantifier: text($q), Source: $s}
    }
    // BETWEEN, IN, LIKE, ILIKE, GLOB and SIMILAR TO: the rule of each has this precedence, so its operands do not
    // contain an operator of this level; ESCAPE belongs to the rule.
    level lv_like {
        postfix &(?nNlLiIsS) n:(NOT ws)? o:(LIKE / ILIKE / @(SIMILAR ws TO)) ws p:expr(lv_op) (ws ESCAPE ws e:expr(lv_op))? !(ws like_start)
            -> new Like{X: $lhs, Negated: len($n) > 0, Op: text($o), Pattern: $p, Escape: $e}
        postfix &(?gG) o:GLOB ws p:expr(lv_op) !(ws like_start) -> new Like{X: $lhs, Negated: false, Op: text($o), Pattern: $p}
        postfix &(?nNiI) n:(NOT ws)? IN ws (q:select_with_parens / "(" ws is:expr_list_opt_comma ws ")" / s:in_source) -> new In{X: $lhs, Negated: len($n) > 0, Query: $q, Items: concat($is), Source: $s}
        postfix &(?nNbB) n:(NOT ws)? BETWEEN ws sy:SYMMETRIC? ws ASYMMETRIC? ws lo:b_expr ws AND ws hi:expr(lv_op) !(ws like_start)
            -> new Between{X: $lhs, Lo: $lo, Hi: $hi, Negated: len($n) > 0, Symmetric: len($sy) > 0}
    }
    // Op (the operators that are not one of the others) and OPERATOR(...); it may be a postfix operator.
    level lv_op {
        prefix o:qual_op -> new Unary{Op: $o, X: $rhs}
        postfix &(?+\-*/<>=~!@^&|`%oO) o:qual_op ws !(BETWEEN / ESCAPE / NOT / LIKE / ILIKE / SIMILAR) r:(op_rhs_prefix / expr(lv_add)) -> new Binary{Left: $lhs, Op: $o, Right: $r}
        postfix &(?+\-*/<>=~!@^&|`%oO) o:qual_op !(ws AT) !(ws qual_op) -> new PostfixOp{X: $lhs, Op: $o}
    }
    level lv_add {
        infix left &(?+\-) op_plus / op_minus -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_mul {
        infix left &(?*/%) op_star / op_slash / op_idiv / op_percent -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_pow {
        infix left &(?*^) op_caret / op_pow -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_at {
        postfix &(?aA) AT ws TIME ws ZONE ws z:expr(lv_collate) -> new AtTimeZone{X: $lhs, Zone: $z}
    }
    level lv_collate {
        postfix &(?cC) COLLATE ws n:any_name -> new Collate{X: $lhs, Collation: $n}
    }
    level lv_uminus {
        prefix op_plus / op_minus -> new Unary{Op: $op, X: $rhs}
    }
    level lv_cast {
        postfix &":" "::" ws t:typename -> new Cast{X: $lhs, Type: $t, Try: false, Shorthand: true}
    }
}

// The right operand of an operator: an expression of the levels above Op, or a prefix operator and its operand.
def op_rhs_prefix: Unary = o:qual_op ws x:(op_rhs_prefix / expr(lv_add)) -> new Unary{Op: $o, X: $x}

// b_expr: the expressions that may be the lower bound of BETWEEN, a default value, ...: no AND, OR, NOT, IS NULL,
// LIKE, IN, BETWEEN, COLLATE or AT TIME ZONE.
def b_expr: Expr = pratt {
    skip ws
    operand chained
    level lv_is {
        postfix IS ws n:NOT? ws DISTINCT ws FROM ws r:b_expr(lv_cmp) !(ws is_start) -> new DistinctFrom{Left: $lhs, Right: $r, Negated: len($n) > 0}
        postfix IS ws n:NOT? ws OF ws "(" ws ts:type_list ws ")" !(ws is_start) -> new IsOf{X: $lhs, Types: $ts, Negated: len($n) > 0}
    }
    level lv_cmp {
        postfix o:cmp_op ws r:b_expr(lv_add) !(ws cmp_op) -> new Binary{Left: $lhs, Op: $o, Right: $r}
    }
    level lv_op {
        prefix o:qual_op -> new Unary{Op: $o, X: $rhs}
        postfix o:qual_op ws !BETWEEN r:b_expr(lv_add) -> new Binary{Left: $lhs, Op: $o, Right: $r}
        postfix o:qual_op !(ws AT) -> new PostfixOp{X: $lhs, Op: $o}
    }
    level lv_add {
        infix left op_plus / op_minus -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_mul {
        infix left op_star / op_slash / op_idiv / op_percent -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_pow {
        infix left op_caret / op_pow -> new Binary{Left: $lhs, Op: $op, Right: $rhs}
    }
    level lv_uminus {
        prefix op_plus / op_minus -> new Unary{Op: $op, X: $rhs}
    }
    level lv_cast {
        postfix "::" ws t:typename -> new Cast{X: $lhs, Type: $t, Try: false, Shorthand: true}
    }
}

def colon = ":" !(":" / "=")
// The comparison operators do not associate: a < b < c is an error, also as the right side of AND and the like.
def cmp_op: Match = @(op_lt / op_gt / op_eq / op_le / op_ge / op_ne)
// The operators of the level of BETWEEN, IN and LIKE do not associate either; IS DISTINCT FROM and IS OF do not
// take IS after them.
def like_start = (NOT ws)? (LIKE / ILIKE / GLOB / SIMILAR / IN / BETWEEN)
def is_start = IS / ISNULL / NOTNULL

// qual_Op, subquery_Op
def qual_op: Match = op_generic / operator_call
def operator_call: Match = @(OPERATOR ws "(" ws any_operator ws ")")
def any_operator = (col_id ws "." ws)* all_op
def all_op: Match = op_generic / op_plus / op_minus / op_star / op_slash / op_idiv / op_percent / op_caret / op_pow
    / op_lt / op_gt / op_eq / op_le / op_ge / op_ne
def subquery_op = all_op / operator_call / @(NOT ws (LIKE / ILIKE)) / LIKE / GLOB / ILIKE
def any_source: Expr = any_source_query / paren_expr
def any_source_query: Subquery = q:select_with_parens -> new Subquery{Query: $q}
// the right side of IN that is not parenthesized: columnref_opt_indirection | indirection_expr
def in_source: Expr = indirection_expr / in_column
def in_column: Expr = pratt {
    skip ws
    operand column_ref
    level lv_chain {
        postfix "." ws n:attr_name -> new Indirection{X: $lhs, Step: new FieldStep{Name: $n}}
        postfix "[" ws i:expr ws "]" -> new Indirection{X: $lhs, Step: new IndexStep{Index: $i}}
        postfix "[" ws lo:expr? ws colon ws hi:expr? ws "]" -> new Indirection{X: $lhs, Step: new SliceStep{Lo: $lo, Hi: $hi}}
        postfix "[" ws lo:expr? ws colon ws hi:expr? ws colon ws st:expr? ws "]" -> new Indirection{X: $lhs, Step: new SliceStep{Lo: $lo, Hi: $hi, Stride: $st}}
    }
}

// ===================================================================================================
// Operands
// ===================================================================================================

// c_expr: the expressions that are not made of operators, with the indirections that follow them in expr.
def c_expr: Expr = chained

// An operand with its indirections: x.field, x.method(args), x[i], x[lo:hi]. They follow only an operand, not the
// result of an operator, so they are not operators of expr. A column reference with indirections is a column
// reference of the grammar of DuckDB, which no method call can follow: x[1].f() is a syntax error, but (x)[1].f() is
// not.
def chained: Expr = col_chained / call_chained
def col_chained: Expr = pratt {
    skip ws
    operand plain_column
    level lv_chain {
        postfix "." ws n:attr_name -> new Indirection{X: $lhs, Step: new FieldStep{Name: $n}}
        postfix "[" ws i:expr ws "]" -> new Indirection{X: $lhs, Step: new IndexStep{Index: $i}}
        postfix "[" ws lo:expr? ws colon ws (d:"-" ws colon ws st:expr? / hi:expr? (ws colon ws st:expr?)?) ws "]"
            -> new Indirection{X: $lhs, Step: new SliceStep{Lo: $lo, Hi: $hi, Stride: $st, Dash: len($d) > 0}}
    }
}
def call_chained: Expr = pratt {
    skip ws
    operand primary_other
    level lv_chain {
        postfix "." ws n:attr_name (ws c:"(" ws a:func_arg_list? ws ")")? -> new Indirection{X: $lhs, Step: new FieldStep{Name: $n, Call: len($c) > 0, Args: concat($a)}}
        postfix "[" ws i:expr ws "]" -> new Indirection{X: $lhs, Step: new IndexStep{Index: $i}}
        postfix "[" ws lo:expr? ws colon ws (d:"-" ws colon ws st:expr? / hi:expr? (ws colon ws st:expr?)?) ws "]"
            -> new Indirection{X: $lhs, Step: new SliceStep{Lo: $lo, Hi: $hi, Stride: $st, Dash: len($d) > 0}}
    }
}

def primary_other: Expr =
      literal_primary
    / paren_primary
    / indirection_expr
    / keyword_primary
    / typed_literal
    / column_ref

// Constants.
def literal_primary: Expr = plain_literal / string_literal
def plain_literal: Expr = l:(number / bit_lit) !(ws ("." / "[")) -> $l
// a string may be followed by .name and [i], but a call needs an expression in parentheses
def string_literal: Expr = l:sconst !(ws "." ws attr_name ws "(") -> $l
// ICONST in positions where the grammar does not allow a float
def param: Param = "?" (?0-9)* / "$" digits / "$" ws dollar_name
// the name of a parameter has no $ in it: $a$ begins a dollar-quoted string
def dollar_name = quoted_ident / uquoted_ident / ident_start (?a-zA-Z0-9_\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})*
def positional_ref: PositionalRef = "#" ws i:iconst -> new PositionalRef{Index: $i}

// An identifier that does not begin a call, a typed literal or another construct that starts with a name: the common
// case, which is tried first.
def plain_column: ColumnRef = !((DOUBLE ws PRECISION) / ((CHARACTER / CHAR / NCHAR / NATIONAL / BIT) ws (VARYING / CHARACTER / CHAR)) / (INTERVAL ws (iconst / "(")))
    ps:dotted_idents !(ws ("(" / "{" / "\'" / "$" / (?eEbBxXnN) "\'" / (?uU) "&\'")) -> new ColumnRef{Parts: $ps}
def column_ref: ColumnRef = ps:dotted_idents -> new ColumnRef{Parts: $ps}
def dotted_idents: []Ident = first:col_id rest:(-ws -"." -ws a:attr_name)* -> concat(list($first), map($rest, (r) => $r.a))

// ( ... ): a subquery, an expression in parentheses, or a row
def paren_primary: Expr = subquery_expr / row_expr / paren_expr
def subquery_expr: Subquery = q:select_with_parens -> new Subquery{Query: $q}
def row_expr: Row = "(" ws first:expr rest:(-ws -"," -ws e:expr)+ ws ")" -> new Row{Items: concat(list($first), map($rest, (r) => $r.e)), Keyword: false}
def paren_expr: Paren = "(" ws e:expr ws ")" -> new Paren{X: $e}

// The expressions that the grammar of DuckDB calls indirection_expr: they can be followed by .method(...)
def indirection_expr: Expr =
      param
    / struct_lit
    / map_lit
    / list_comprehension
    / list_lit
    / case_expr
    / array_expr
    / positional_ref
    / qualified_row
    / func_expr

def func_expr: Expr = !(OPERATOR ws "(") e:(cast_expr / special_call / func_call_plain / typed_literal_args) -> $e
// a call that is not followed by a string (otherwise it is the type of a literal)
def func_call_plain: FuncCall = c:func_call !(ws sconst) -> $c

def list_lit: ListLit = "[" ws xs:expr_list_opt_comma? ws "]" -> new ListLit{Items: concat($xs)}
def array_expr: Expr = array_subquery / array_lit
def array_subquery: ArraySubquery = ARRAY ws q:select_with_parens -> new ArraySubquery{Query: $q}
def array_lit: ArrayLit = ARRAY ws "[" ws xs:expr_list_opt_comma? ws "]" -> new ArrayLit{Items: concat($xs)}
def struct_lit: StructLit = "{" ws first:struct_field rest:(-ws -"," -ws f:struct_field)* (ws ",")? ws "}"
    -> new StructLit{Fields: concat(list($first), map($rest, (r) => $r.f))}
def struct_field: StructField = n:col_id_or_string ws colon ws v:expr -> new StructField{Name: $n, Value: $v}
def map_lit: MapLit = MAP ws "{" ws es:map_entries? ws "}" -> new MapLit{Entries: concat($es)}
def map_entries: []MapEntry = first:map_entry rest:(-ws -"," -ws e:map_entry)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.e))
def map_entry: MapEntry = k:expr ws colon ws v:expr -> new MapEntry{Key: $k, Value: $v}
def list_comprehension: ListComp = list_comp_if / list_comp
def list_comp_if: ListComp = "[" ws e:expr ws FOR ws vs:name_list ws IN ws s:c_expr ws IF ws c:expr ws "]" -> new ListComp{Expr: $e, Vars: $vs, Source: $s, Cond: $c}
def list_comp: ListComp = "[" ws e:expr ws FOR ws vs:name_list ws IN ws s:expr ws "]" -> new ListComp{Expr: $e, Vars: $vs, Source: $s}

def case_expr: Case = CASE (ws !WHEN a:expr)? ws whens:when_clause_list (ws ELSE ws e:expr)? ws END
    -> new Case{Arg: $a, Whens: $whens, Else: $e}
def when_clause_list: []When = first:when_clause rest:(-ws w:when_clause)* -> concat(list($first), map($rest, (r) => $r.w))
def when_clause: When = WHEN ws c:expr ws THEN ws t:expr -> new When{Cond: $c, Then: $t}

def qualified_row: Row = ROW ws "(" ws xs:expr_list_opt_comma? ws ")" -> new Row{Items: concat($xs), Keyword: true}

def expr_list: []Expr = first:expr rest:(-ws -"," -ws e:expr)* -> concat(list($first), map($rest, (r) => $r.e))
def expr_list_opt_comma: []Expr = l:expr_list (ws ",")? -> $l

// ---- Stars, COLUMNS, DEFAULT, lambdas ----

def star_primary: Expr = star_columns / star_expr / qualified_star / columns_expr / unpack_expr / default_expr / lambda_expr
def default_expr: DefaultExpr = DEFAULT
def columns_expr: ColumnsExpr = COLUMNS ws "(" ws a:expr ws ")" -> new ColumnsExpr{Arg: $a, Star: false}
def star_columns: ColumnsExpr = op_star ws COLUMNS ws "(" ws a:expr ws ")" -> new ColumnsExpr{Arg: $a, Star: true}
def unpack_expr: UnpackExpr = UNPACK ws "(" ws a:expr ws ")" -> new UnpackExpr{Arg: $a}
def star_expr: Star = op_star (ws ex:exclude_list)? (ws rp:replace_list)? (ws rn:rename_list)? -> new Star{Exclude: concat($ex), Replace: concat($rp), Rename: concat($rn)}
def qualified_star: Star = q:col_id ws "." ws op_star (ws ex:exclude_list)? (ws rp:replace_list)? (ws rn:rename_list)?
    -> new Star{Qualifier: $q, Exclude: concat($ex), Replace: concat($rp), Rename: concat($rn)}
def lambda_expr: Lambda = LAMBDA ws ps:name_list ws colon ws b:expr -> new Lambda{Params: $ps, Body: $b, Keyword: true}

def except_name: Name = first:col_id_or_string rest:(-ws -"." -ws n:col_id_or_string)* -> new Name{Parts: concat(list($first), map($rest, (r) => $r.n))}
def except_name_list: []Name = first:except_name rest:(-ws -"," -ws n:except_name)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.n))
def exclude_list: []Name = exclude_paren / exclude_single
def exclude_paren: []Name = EXCLUDE ws "(" ws l:except_name_list ws ")" -> $l
def exclude_single: []Name = EXCLUDE ws n:except_name -> list($n)
def replace_item: ReplaceItem = e:expr ws AS ws n:col_id -> new ReplaceItem{Expr: $e, Name: $n}
def replace_list: []ReplaceItem = replace_paren / replace_single
def replace_paren: []ReplaceItem = REPLACE ws "(" ws first:replace_item rest:(-ws -"," -ws i:replace_item)* (ws ",")? ws ")" -> concat(list($first), map($rest, (r) => $r.i))
def replace_single: []ReplaceItem = REPLACE ws i:replace_item -> list($i)
def rename_item: RenameItem = f:except_name ws AS ws t:col_id -> new RenameItem{From: $f, To: $t}
def rename_list: []RenameItem = rename_paren / rename_single
def rename_paren: []RenameItem = RENAME ws "(" ws first:rename_item rest:(-ws -"," -ws i:rename_item)* (ws ",")? ws ")" -> concat(list($first), map($rest, (r) => $r.i))
def rename_single: []RenameItem = RENAME ws i:rename_item -> list($i)

// ---- Keyword expressions and special functions ----

def keyword_primary: Expr = k:(bool_lit / null_lit / exists_expr / interval_lit / grouping_expr) !(ws ("." / "[")) -> $k
def bool_lit: BoolLit = TRUE / FALSE
def null_lit: NullLit = NULL
def exists_expr: Exists = EXISTS ws q:select_with_parens -> new Exists{Query: $q}
def grouping_expr: Grouping = n:@(GROUPING_ID / GROUPING) ws "(" ws xs:expr_list_opt_comma ws ")" -> new Grouping{Name: text($n), Args: $xs}
def cast_expr: Cast = cast_plain / cast_try
def cast_plain: Cast = CAST ws "(" ws x:expr ws AS ws t:typename ws ")" -> new Cast{X: $x, Type: $t, Try: false, Shorthand: false}
def cast_try: Cast = TRY_CAST ws "(" ws x:expr ws AS ws t:typename ws ")" -> new Cast{X: $x, Type: $t, Try: true, Shorthand: false}

def interval_lit: IntervalLit = interval_paren / interval_const
def interval_paren: IntervalLit = INTERVAL ws "(" ws v:expr ws ")" (ws u:interval_unit)? -> new IntervalLit{Value: $v, Unit: $u}
def interval_const: IntervalLit = INTERVAL ws v:(iconst / sconst) (ws u:interval_unit)? -> new IntervalLit{Value: $v, Unit: $u}
def interval_unit: IntervalUnit = interval_to / interval_field
def interval_to = (YEARS / YEAR) ws TO ws (MONTHS / MONTH)
    / (DAYS / DAY) ws TO ws (HOURS / HOUR / MINUTES / MINUTE / SECONDS / SECOND)
    / (HOURS / HOUR) ws TO ws (MINUTES / MINUTE / SECONDS / SECOND)
    / (MINUTES / MINUTE) ws TO ws (SECONDS / SECOND)
def interval_field = YEARS / YEAR / MONTHS / MONTH / DAYS / DAY / HOURS / HOUR / MINUTES / MINUTE / SECONDS / SECOND
    / MILLISECONDS / MILLISECOND / MICROSECONDS / MICROSECOND / WEEKS / WEEK / QUARTERS / QUARTER / DECADES / DECADE
    / CENTURIES / CENTURY / MILLENNIA / MILLENNIUM

def special_call: Expr = sc_coalesce / sc_nullif / sc_extract / sc_extract_empty / sc_overlay / sc_position / sc_position_empty
    / sc_substring_from / sc_substring_for_from / sc_substring_for / sc_substring_list / sc_substring_empty / sc_treat / sc_trim_chars / sc_trim / sc_collation
def sc_coalesce: SpecialCall = n:COALESCE ws "(" ws a:expr_list_opt_comma ws ")" -> new SpecialCall{Name: text($n), Args: $a}
def sc_nullif: SpecialCall = n:NULLIF ws "(" ws a:expr ws "," ws b:expr ws ")" -> new SpecialCall{Name: text($n), Args: list($a, $b)}
def sc_extract: SpecialCall = n:EXTRACT ws "(" ws p:extract_arg ws FROM ws x:expr ws ")" -> new SpecialCall{Name: text($n), Spec: text($p), Args: list($x)}
def sc_extract_empty: SpecialCall = n:EXTRACT ws "(" ws ")" -> new SpecialCall{Name: text($n)}
def sc_overlay: SpecialCall = n:OVERLAY ws "(" ws x:expr ws PLACING ws y:expr ws FROM ws a:expr (ws FOR ws b:expr)? ws ")"
    -> new SpecialCall{Name: text($n), Args: list($x), Placing: $y, From: list($a), For: $b}
def sc_position: SpecialCall = n:POSITION ws "(" ws a:b_expr ws IN ws b:b_expr ws ")" -> new SpecialCall{Name: text($n), Args: list($a, $b)}
def sc_position_empty: SpecialCall = n:POSITION ws "(" ws ")" -> new SpecialCall{Name: text($n)}
// SUBSTRING(x FROM a FOR b), SUBSTRING(x FOR b FROM a), SUBSTRING(x, a, b) and SUBSTRING()
def sc_substring_from: SpecialCall = n:SUBSTRING ws "(" ws x:expr ws FROM ws a:expr (ws FOR ws b:expr)? ws ")"
    -> new SpecialCall{Name: text($n), Args: list($x), From: list($a), For: $b}
def sc_substring_for_from: SpecialCall = n:SUBSTRING ws "(" ws x:expr ws FOR ws b:expr ws FROM ws a:expr ws ")"
    -> new SpecialCall{Name: text($n), Args: list($x), From: list($a), For: $b}
def sc_substring_for: SpecialCall = n:SUBSTRING ws "(" ws x:expr ws FOR ws b:expr ws ")" -> new SpecialCall{Name: text($n), Args: list($x), For: $b}
def sc_substring_list: SpecialCall = n:SUBSTRING ws "(" ws l:expr_list ws ")" -> new SpecialCall{Name: text($n), Args: $l}
def sc_substring_empty: SpecialCall = n:SUBSTRING ws "(" ws ")" -> new SpecialCall{Name: text($n)}
def sc_treat: SpecialCall = n:TREAT ws "(" ws x:expr ws AS ws t:typename ws ")" -> new SpecialCall{Name: text($n), Args: list($x), Type: $t}
def sc_trim_chars: SpecialCall = n:TRIM ws "(" ws (s:(BOTH / LEADING / TRAILING) ws)? c:expr ws FROM ws l:expr_list_opt_comma ws ")"
    -> new SpecialCall{Name: text($n), Spec: text($s), Args: $l, Chars: $c}
def sc_trim: SpecialCall = n:TRIM ws "(" ws (s:(BOTH / LEADING / TRAILING) ws)? a:(trim_from / expr_list_opt_comma) ws ")" -> new SpecialCall{Name: text($n), Spec: text($s), Args: $a}
def sc_collation: SpecialCall = n:@(COLLATION ws FOR) ws "(" ws x:expr ws ")" -> new SpecialCall{Name: text($n), Args: list($x)}
def extract_arg: Match = @(ident_only / year_kw / sconst)
def year_kw = YEARS / YEAR / MONTHS / MONTH / DAYS / DAY / HOURS / HOUR / MINUTES / MINUTE / SECONDS / SECOND
    / MILLISECONDS / MILLISECOND / MICROSECONDS / MICROSECOND / WEEKS / WEEK / QUARTERS / QUARTER / DECADES / DECADE
    / CENTURIES / CENTURY / MILLENNIA / MILLENNIUM
// trim_list: a_expr FROM expr_list | FROM expr_list | expr_list
def trim_from: []Expr = FROM ws l:expr_list_opt_comma -> $l

// ---- Function calls ----

def func_call: FuncCall =
    n:func_name ws "(" ws
    ( q:(ALL / DISTINCT) ws a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)?
    / a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)?
    / VARIADIC ws v:func_arg_expr
    )?
    (ws o:sort_clause)? (ws nl:opt_ignore_nulls)? ws ")"
    (ws WITHIN ws GROUP ws "(" ws wg:sort_clause ws ")")?
    (ws f:filter_clause)?
    (ws ex:EXPORT_STATE)?
    (ws ov:over_clause)?
    -> new FuncCall{Name: $n, Quantifier: text($q), Args: concat($a), Variadic: $v, OrderBy: $o, Nulls: text($nl), WithinGroup: $wg, Filter: $f, ExportState: len($ex) > 0, Over: $ov}
// func_name '(' ... ')' Sconst: a literal of a type with arguments
def typed_literal_args: TypedLit = t:func_name_type ws "(" ws a:func_arg_list ws ")" ws s:sconst -> new TypedLit{Type: new Type{Name: text($t), Mods: $a}, Value: $s}
def func_name_type: Match = @(fn_dotted / function_name_token)
def func_arg_list: []Expr = first:func_arg_expr rest:(-ws -"," -ws e:func_arg_expr)* -> concat(list($first), map($rest, (r) => $r.e))
def func_arg_expr: Expr = named_arg / expr
def named_arg: NamedArg = n:param_name ws (":=" / op_eq_gt) ws v:expr -> new NamedArg{Name: $n, Value: $v}
def opt_ignore_nulls: Match = @((IGNORE / RESPECT) ws NULLS)
def filter_clause: Expr = FILTER ws "(" ws (WHERE ws)? e:expr ws ")" -> $e
def over_clause: WindowOver = OVER ws (s:window_specification / n:col_id) -> new WindowOver{Name: $n, Spec: $s}
def window_specification: WindowSpec = "(" ws (!(PARTITION / RANGE / ROWS / GROUPS) b:col_id)?
    (ws PARTITION ws BY ws xs:expr_list)? (ws o:sort_clause)? (ws f:frame_clause)? ws ")"
    -> new WindowSpec{Base: $b, PartitionBy: concat($xs), OrderBy: $o, Frame: $f}
def frame_clause: Frame = frame_between / frame_single
def frame_single: Frame = u:(RANGE / ROWS / GROUPS) ws !BETWEEN b:frame_bound (ws e:window_exclusion)? -> new Frame{Unit: text($u), Start: $b, Exclude: text($e)}
def frame_between: Frame = u:(RANGE / ROWS / GROUPS) ws BETWEEN ws b:frame_bound ws AND ws c:frame_bound (ws e:window_exclusion)?
    -> new Frame{Unit: text($u), Start: $b, End: $c, Exclude: text($e)}
def frame_bound: FrameBound = frame_bound_kw / frame_bound_expr
def frame_bound_kw: FrameBound = k:@(UNBOUNDED ws (PRECEDING / FOLLOWING) / CURRENT ws ROW) -> new FrameBound{Kind: text($k)}
def frame_bound_expr: FrameBound = e:expr ws k:(PRECEDING / FOLLOWING) -> new FrameBound{Kind: text($k), Expr: $e}
def window_exclusion: Match = @(EXCLUDE ws (CURRENT ws ROW / GROUP / TIES / NO ws OTHERS))
// ===================================================================================================
// Types
// ===================================================================================================

def type_list: []Type = first:typename rest:(-ws -"," -ws t:typename)* -> concat(list($first), map($rest, (r) => $r.t))

// Typename: a type name with modifiers, or a struct, map or union type, followed by array dimensions. SETOF is
// accepted and ignored.
def typename: Type = (SETOF ws)? t:type_base -> $t
def type_base: Type = type_struct / type_map / type_interval / type_datetime / type_char / type_bit / type_numeric / type_qualified / type_generic

// The array dimensions that may follow a type: [], [3], and ARRAY, ARRAY[3]
def array_dims: []ArrayDim = array_dims_only / array_keyword_sized / array_keyword
def array_dim: ArrayDim = "[" ws s:iconst? ws "]" -> new ArrayDim{Size: $s}
def array_dims_only: []ArrayDim = ds:(-ws d:array_dim)+ -> map($ds, (x) => $x.d)
def array_keyword_sized: []ArrayDim = ws ARRAY ws "[" ws s:iconst ws "]" -> list(new ArrayDim{Size: $s})
def array_keyword: []ArrayDim = ws ARRAY -> list(new ArrayDim{})

def type_mods: []Expr = "(" ws xs:expr_list_opt_comma? ws ")" -> concat($xs)
def type_struct: Type = n:@(ROW / STRUCT / UNION) ws "(" ws fs:colid_type_list ws ")" ds:array_dims_only? -> new Type{Name: text($n), Fields: $fs, Dims: concat($ds)}
def colid_type_list: []TypeField = first:colid_type rest:(-ws -"," -ws f:colid_type)* -> concat(list($first), map($rest, (r) => $r.f))
def colid_type: TypeField = n:col_id ws t:typename -> new TypeField{Name: $n, Type: $t}
def type_map: Type = n:@MAP ws "(" ws ts:type_list ws ")" ds:array_dims_only? -> new Type{Name: text($n), Elems: $ts, Dims: concat($ds)}
// INTERVAL(3) and INTERVAL DAY TO HOUR
def type_interval: Type = n:@(INTERVAL (ws "(" ws iconst ws ")" / ws interval_unit)?) ds:array_dims? -> new Type{Name: text($n), Dims: concat($ds)}
def type_datetime: Type = n:@(TIMESTAMP / TIME) ps:(-ws -"(" -ws n:iconst -ws -")"){0,1} (ws z:time_zone_spec)? ds:array_dims?
    -> new Type{Name: text($n), Mods: map($ps, (x) => $x.n), Zone: text($z), Dims: concat($ds)}
def time_zone_spec: Match = @((WITH / WITHOUT) ws TIME ws ZONE)
def type_char: Type = n:char_name ps:(-ws -"(" -ws n:iconst -ws -")"){0,1} ds:array_dims? -> new Type{Name: text($n), Mods: map($ps, (x) => $x.n), Dims: concat($ds)}
def char_name: Match = @(NATIONAL ws (CHARACTER / CHAR) (ws VARYING)? / NCHAR (ws VARYING)? / CHARACTER (ws VARYING)? / CHAR (ws VARYING)? / VARCHAR)
def type_bit: Type = n:@(BIT (ws VARYING)?) (ws "(" ws xs:expr_list_opt_comma ws ")")? ds:array_dims? -> new Type{Name: text($n), Mods: concat($xs), Dims: concat($ds)}
def type_numeric: Type = type_double / type_numeric_mods / type_numeric_plain
def type_double: Type = n:@(DOUBLE ws PRECISION) ds:array_dims? -> new Type{Name: text($n), Dims: concat($ds)}
def type_numeric_mods: Type = type_float / type_decimal
def type_float: Type = n:@FLOAT ps:(-ws -"(" -ws p:iconst -ws -")"){0,1} ds:array_dims? -> new Type{Name: text($n), Mods: map($ps, (x) => $x.p), Dims: concat($ds)}
def type_decimal: Type = n:@(DECIMAL / DEC / NUMERIC) (ws ms:type_mods)? ds:array_dims? -> new Type{Name: text($n), Mods: concat($ms), Dims: concat($ds)}
def type_numeric_plain: Type = n:@(INTEGER / INT / SMALLINT / BIGINT / REAL / BOOLEAN) ds:array_dims? -> new Type{Name: text($n), Dims: concat($ds)}
def type_qualified: Type = n:@(ident_only (ws "." ws ident_only)+) ds:array_dims? -> new Type{Name: text($n), Dims: concat($ds)}
def type_generic: Type = n:@type_name_token (ws ms:type_mods)? ds:array_dims? -> new Type{Name: text($n), Mods: concat($ms), Dims: concat($ds)}

// A literal of a type: DATE '2020-01-01', INT '5', DECIMAL(10, 2) '1.5'
def typed_literal: TypedLit = tl:(typed_literal_nchar / typed_literal_const / typed_literal_name) !(ws ("." / "[")) -> $tl
def typed_literal_nchar: TypedLit = n:@((?nN)) &"'" s:sconst -> new TypedLit{Type: new Type{Name: text($n)}, Value: $s}
def typed_literal_const: TypedLit = t:const_type ws s:sconst -> new TypedLit{Type: $t, Value: $s}
def typed_literal_name: TypedLit = !((?eEbBxXnN) "'") t:func_name_type ws s:sconst -> new TypedLit{Type: new Type{Name: text($t)}, Value: $s}
def const_type: Type = type_numeric_const / type_char_const / type_bit_const / type_datetime_const
def type_numeric_const: Type = type_double_const / type_numeric_mods_const / type_numeric_plain_const
def type_double_const: Type = n:@(DOUBLE ws PRECISION) -> new Type{Name: text($n)}
def type_numeric_mods_const: Type = type_float_const / type_decimal_const
def type_float_const: Type = n:@FLOAT ps:(-ws -"(" -ws p:iconst -ws -")"){0,1} -> new Type{Name: text($n), Mods: map($ps, (x) => $x.p)}
def type_decimal_const: Type = n:@(DECIMAL / DEC / NUMERIC) (ws ms:type_mods)? -> new Type{Name: text($n), Mods: concat($ms)}
def type_numeric_plain_const: Type = n:@(INTEGER / INT / SMALLINT / BIGINT / REAL / BOOLEAN) -> new Type{Name: text($n)}
def type_char_const: Type = n:char_name ps:(-ws -"(" -ws n:iconst -ws -")"){0,1} -> new Type{Name: text($n), Mods: map($ps, (x) => $x.n)}
def type_bit_const: Type = n:@(BIT (ws VARYING)?) (ws "(" ws xs:expr_list_opt_comma ws ")")? -> new Type{Name: text($n), Mods: concat($xs)}
def type_datetime_const: Type = n:@(TIMESTAMP / TIME) ps:(-ws -"(" -ws n:iconst -ws -")"){0,1} (ws z:time_zone_spec)? -> new Type{Name: text($n), Mods: map($ps, (x) => $x.n), Zone: text($z)}
// ===================================================================================================
// SELECT (select.y)
// ===================================================================================================

// SelectStmt: select_no_parens | select_with_parens
def select_stmt: Select = select_no_parens / select_paren_stmt
def select_paren_stmt: Select = pq:select_with_parens -> new Select{Body: $pq}

def select_with_parens: ParenQuery = "(" ws q:paren_content ws ")" -> new ParenQuery{Query: $q}
def paren_content: ParenContent = select_no_parens / select_with_parens / show_stmt

def select_no_parens: Select =
    (w:with_clause ws)? b:select_body
    (ws o:sort_clause)?
    (ws l1:locking_clauses)?
    ( ws (l:limit_clause (ws of:offset_clause)? / of:offset_clause (ws l:limit_clause)?) )?
    (ws l2:locking_clauses)?
    -> new Select{With: $w, Body: $b, OrderBy: $o, Limit: $l, Offset: $of, Locking: concat($l1, $l2)}

// ---- WITH ----

def with_clause: With = with_recursive / with_plain
def with_recursive: With = WITH ws RECURSIVE ws first:cte rest:(-ws -"," -ws c:cte)* -> new With{Recursive: true, CTEs: concat(list($first), map($rest, (x) => $x.c))}
def with_plain: With = WITH ws first:cte rest:(-ws -"," -ws c:cte)* -> new With{CTEs: concat(list($first), map($rest, (x) => $x.c))}
def cte: CTE = n:name (ws "(" ws cs:name_list_opt_comma ws ")")? (ws USING ws KEY ws "(" ws k:col_id_list (ws ",")? ws ")")?
    ws AS (ws m:materialized)? ws "(" ws q:preparable ws ")"
    -> new CTE{Name: $n, Columns: concat($cs), UsingKey: concat($k), Materialized: $m, Query: $q}
def materialized: Match = @(MATERIALIZED / NOT ws MATERIALIZED)

// ---- Set operations ----

def select_body: QueryBody = pratt {
    skip ws
    operand select_core
    operand from_first
    operand values_clause
    operand table_query
    operand pivot_query
    operand unpivot_query
    operand select_with_parens

    level lv_union {
        infix left o:(UNION / EXCEPT) (ws q:(ALL / DISTINCT))? bn:(ws BY ws NAME)?
            -> new SetOp{Left: $lhs, Op: text($o), Quantifier: text($q), ByName: len($bn) > 0, Right: $rhs}
    }
    level lv_intersect {
        infix left o:INTERSECT (ws q:(ALL / DISTINCT))? bn:(ws BY ws NAME)?
            -> new SetOp{Left: $lhs, Op: text($o), Quantifier: text($q), ByName: len($bn) > 0, Right: $rhs}
    }
}

// ---- SELECT ----

def select_core: SelectCore =
    SELECT
    ( ws d:distinct_clause ws is:target_list_opt_comma
    / (ws ALL)? (ws is:target_list_opt_comma)? )
    (ws into:into_clause)?
    (ws FROM ws f:from_list_opt_comma)?
    (ws WHERE ws w:expr)?
    (ws g:group_clause)?
    (ws HAVING ws h:expr)?
    (ws wd:window_clause)?
    (ws QUALIFY ws q:expr)?
    (ws s:sample_clause)?
    -> new SelectCore{Distinct: $d, Items: concat($is), Into: $into, From: concat($f), Where: $w, GroupBy: $g, Having: $h, Windows: concat($wd), Qualify: $q, Sample: $s}

def from_first: SelectCore =
    FROM ws f:from_list
    (ws SELECT ( ws d:distinct_clause ws is:target_list_opt_comma
               / (ws ALL)? (ws is:target_list_opt_comma)? ))?
    (ws into:into_clause)?
    (ws WHERE ws w:expr)?
    (ws g:group_clause)?
    (ws HAVING ws h:expr)?
    (ws wd:window_clause)?
    (ws QUALIFY ws q:expr)?
    (ws s:sample_clause)?
    -> new SelectCore{FromFirst: true, Distinct: $d, Items: concat($is), Into: $into, From: $f, Where: $w, GroupBy: $g, Having: $h, Windows: concat($wd), Qualify: $q, Sample: $s}

def distinct_clause: DistinctClause = DISTINCT (ws ON ws "(" ws xs:expr_list_opt_comma ws ")")? -> new DistinctClause{On: concat($xs)}

def target_list_opt_comma: []SelectItem = first:select_item rest:(-ws -"," -ws i:select_item)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.i))
def select_item: SelectItem = item_prefixed / item_plain
def item_prefixed: SelectItem = a:col_id ws colon ws e:expr -> new SelectItem{Expr: $e, Alias: $a, Prefix: true}
def item_plain: SelectItem = e:expr (ws kw:AS ws al:col_label_or_string / ws al:ident_only)? -> new SelectItem{Expr: $e, Alias: $al, As: len($kw) > 0}
def col_label_or_string: Ident = col_label / sconst

def into_clause: IntoClause = INTO ws t:opt_temp_table_name -> $t
def opt_temp_table_name: IntoClause = into_temp / into_table / into_plain
def into_temp: IntoClause = t:@((TEMPORARY / TEMP) / LOCAL ws (TEMPORARY / TEMP) / GLOBAL ws (TEMPORARY / TEMP) / UNLOGGED) ws (TABLE ws)? n:qualified_name -> new IntoClause{Temp: text($t), Table: $n}
def into_table: IntoClause = TABLE ws n:qualified_name -> new IntoClause{Table: $n}
def into_plain: IntoClause = n:qualified_name -> new IntoClause{Table: $n}

def group_clause: GroupBy = group_all / group_list
def group_all: GroupBy = GROUP ws BY ws ALL -> new GroupBy{All: true}
def group_list: GroupBy = GROUP ws BY ws first:group_by_item rest:(-ws -"," -ws i:group_by_item)* (ws ",")? -> new GroupBy{Items: concat(list($first), map($rest, (r) => $r.i))}
def group_by_item: Expr = grouping_set / group_expr
def group_expr: Expr = !((CUBE / ROLLUP) ws "(") e:expr -> $e
def grouping_set: GroupingSet = gs_rollup / gs_sets / gs_empty
def gs_rollup: GroupingSet = k:@(ROLLUP / CUBE) ws "(" ws xs:expr_list_opt_comma ws ")" -> new GroupingSet{Kind: text($k), Items: $xs}
def gs_sets: GroupingSet = k:@(GROUPING ws SETS) ws "(" ws xs:group_by_list_opt_comma ws ")" -> new GroupingSet{Kind: text($k), Items: $xs}
def gs_empty: GroupingSet = "(" ws ")" -> new GroupingSet{}
def group_by_list_opt_comma: []Expr = first:group_by_item rest:(-ws -"," -ws i:group_by_item)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.i))

def window_clause: []WindowDef = WINDOW ws first:window_definition rest:(-ws -"," -ws w:window_definition)* -> concat(list($first), map($rest, (r) => $r.w))
def window_definition: WindowDef = n:col_id ws AS ws s:window_specification -> new WindowDef{Name: $n, Spec: $s}

// ---- VALUES, TABLE, PIVOT ----

def values_clause: ValuesClause = VALUES ws first:values_row rest:(-ws -"," -ws r:values_row)* (ws ",")? -> new ValuesClause{Rows: concat(list($first), map($rest, (x) => $x.r))}
def values_row: ValuesRow = "(" ws xs:expr_list_opt_comma ws ")" -> new ValuesRow{Items: $xs}
def table_query: TableQuery = TABLE ws n:qualified_name -> new TableQuery{Table: $n}

def pivot_query: PivotQuery =
    pivot_keyword ws s:table_ref &(ws (ON / USING / GROUP))
    (ws ON ws on:pivot_column_list)?
    (ws USING ws us:target_list_opt_comma)?
    (ws GROUP ws BY ws g:name_list_opt_comma_opt_bracket)?
    -> new PivotQuery{Source: $s, On: concat($on), Using: concat($us), GroupBy: concat($g)}
def pivot_keyword = PIVOT_WIDER / PIVOT
def unpivot_keyword = PIVOT_LONGER / UNPIVOT
def unpivot_query: UnpivotQuery =
    unpivot_keyword ws s:table_ref ws ON ws on:target_list_opt_comma (ws INTO ws NAME ws n:name ws (VALUE / VALUES) ws vs:name_list_opt_comma_opt_bracket)?
    -> new UnpivotQuery{Source: $s, On: $on, Name: $n, Values: concat($vs)}
def name_list_opt_comma_opt_bracket: []Ident = bracketed_names / name_list_opt_comma
def bracketed_names: []Ident = "(" ws l:name_list_opt_comma ws ")" -> $l
def pivot_column_list: []PivotColumn = first:pivot_column_entry rest:(-ws -"," -ws e:pivot_column_entry)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.e))
def pivot_column_entry: PivotColumn = e:b_expr (ws IN ws ( "(" ws q:select_no_parens ws ")" / "(" ws is:target_list_opt_comma ws ")" / n:col_id_or_string))?
    -> new PivotColumn{Expr: $e, Query: $q, In: concat($is), Enum: $n}

// ---- ORDER BY, LIMIT, locking ----

def sort_clause: OrderBy = sort_all / sort_list
def sort_all: OrderBy = ORDER ws BY ws ALL (ws d:asc_desc)? (ws n:nulls_order)? -> new OrderBy{All: true, Direction: text($d), Nulls: text($n)}
def sort_list: OrderBy = ORDER ws BY ws first:sortby rest:(-ws -"," -ws s:sortby)* -> new OrderBy{Items: concat(list($first), map($rest, (r) => $r.s))}
def sortby: SortItem = sortby_using / sortby_plain
def sortby_using: SortItem = e:expr ws USING ws u:qual_all_op (ws n:nulls_order)? -> new SortItem{Expr: $e, Using: text($u), Nulls: text($n)}
def sortby_plain: SortItem = e:expr (ws d:asc_desc)? (ws n:nulls_order)? -> new SortItem{Expr: $e, Direction: text($d), Nulls: text($n)}
def asc_desc = ASC / DESC
def nulls_order: Match = @(NULLS ws (FIRST / LAST))
def qual_all_op: Match = all_op / operator_call

def limit_clause: LimitClause = limit_comma / limit_all / limit_percent / limit_plain / limit_percent_sign / fetch_value_clause / fetch_clause
def limit_comma: LimitClause = k:LIMIT ws v:expr ws "," ws o:expr -> new LimitClause{Keyword: text($k), Value: $v, Offset: $o}
def limit_all: LimitClause = k:LIMIT ws ALL -> new LimitClause{Keyword: text($k), All: true}
def limit_percent: LimitClause = k:LIMIT ws p:number ws pc:PERCENT -> new LimitClause{Keyword: text($k), Value: $p, Percent: text($pc)}
def limit_percent_sign: LimitClause = k:LIMIT ws !(NOT / qual_op) v:expr(lv_mul) ws pc:op_percent -> new LimitClause{Keyword: text($k), Value: $v, Percent: text($pc)}
def limit_plain: LimitClause = k:LIMIT ws v:expr !(ws op_percent) -> new LimitClause{Keyword: text($k), Value: $v}
def fetch_value_clause: LimitClause = k:FETCH ws (FIRST / NEXT) ws v:fetch_value ws (ROW / ROWS) ws ONLY -> new LimitClause{Keyword: text($k), Value: $v}
def fetch_clause: LimitClause = k:FETCH ws (FIRST / NEXT) ws (ROW / ROWS) ws ONLY -> new LimitClause{Keyword: text($k)}
def fetch_value: Expr = fetch_signed / c_expr
def fetch_signed: Number = (op_plus / op_minus) ws n:number -> $n
def offset_clause: OffsetClause = offset_rows / offset_plain
def offset_plain: OffsetClause = OFFSET ws v:expr -> new OffsetClause{Value: $v}
def offset_rows: OffsetClause = OFFSET ws v:fetch_value ws r:(ROW / ROWS) -> new OffsetClause{Value: $v, Rows: text($r)}

def locking_clauses: []LockClause = first:locking_clause rest:(-ws c:locking_clause)* -> concat(list($first), map($rest, (r) => $r.c))
def locking_clause: LockClause = lock_read_only / lock_for
def lock_read_only: LockClause = s:@(FOR ws READ ws ONLY) -> new LockClause{Strength: text($s)}
def lock_for: LockClause = s:@(FOR ws (UPDATE / NO ws KEY ws UPDATE / SHARE / KEY ws SHARE)) (ws OF ws os:qualified_name_list)? (ws w:(NOWAIT / @(SKIP ws LOCKED)))?
    -> new LockClause{Strength: text($s), Of: concat($os), Wait: text($w)}
def qualified_name_list: []Name = first:qualified_name rest:(-ws -"," -ws n:qualified_name)* -> concat(list($first), map($rest, (r) => $r.n))

// ---- SAMPLE ----

def sample_clause: SampleClause = USING ws SAMPLE ws s:tablesample_entry -> $s
def tablesample_clause: SampleClause = TABLESAMPLE ws s:tablesample_entry -> $s
def sample_value: Expr = number / param
// opt_sample_func '(' sample_count ')' opt_repeatable_clause | sample_count | sample_count '(' ColId [, ICONST] ')'
def tablesample_entry: SampleClause = sample_func / sample_seeded / sample_count
def sample_func: SampleClause = (f:col_id ws)? "(" ws v:sample_value (ws u:sample_unit)? ws ")" (ws REPEATABLE ws "(" ws r:iconst ws ")")?
    -> new SampleClause{Method: $f, Value: $v, Unit: text($u), Repeatable: $r}
def sample_seeded: SampleClause = v:sample_value (ws u:sample_unit)? ws "(" ws f:col_id (ws "," ws sd:iconst)? ws ")" -> new SampleClause{Method: $f, Value: $v, Unit: text($u), Seed: $sd}
def sample_count: SampleClause = v:sample_value (ws u:sample_unit)? -> new SampleClause{Value: $v, Unit: text($u)}
def sample_unit = op_percent / PERCENT / ROWS

// ---- Table references ----

def from_list: []TableRef = first:table_ref rest:(-ws -"," -ws t:table_ref)* -> concat(list($first), map($rest, (r) => $r.t))
def from_list_opt_comma: []TableRef = first:table_ref rest:(-ws -"," -ws t:table_ref)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.t))

// table_ref and its joins: a join is left associative unless it needs a qualification that comes after its
// right side (a JOIN b JOIN c ON x ON y), so the right side of a qualified join is a table_ref of its own. The
// joins that need none take only a table without joins, which makes them left associative.
def table_ref: TableRef = pratt {
    skip ws
    operand table_primary

    level lv_join {
        postfix k:@(CROSS) ws JOIN ws r:table_primary -> new Join{Left: $lhs, Kind: text($k), Right: $r}
        postfix k:@(NATURAL ws (join_type ws)?) JOIN ws r:table_primary -> new Join{Left: $lhs, Kind: text($k), Right: $r}
        postfix k:@(POSITIONAL) ws JOIN ws r:table_primary -> new Join{Left: $lhs, Kind: text($k), Right: $r}
        postfix k:@(ASOF ws (join_type ws)?) JOIN ws r:table_ref ws q:join_qual_on -> new Join{Left: $lhs, Kind: text($k), Right: $r, On: $q}
        postfix k:@(ASOF ws (join_type ws)?) JOIN ws r:table_ref ws q:join_qual_using -> new Join{Left: $lhs, Kind: text($k), Right: $r, Using: $q}
        postfix k:@(join_type ws)? JOIN ws r:table_ref ws q:join_qual_on -> new Join{Left: $lhs, Kind: text($k), Right: $r, On: $q}
        postfix k:@(join_type ws)? JOIN ws r:table_ref ws q:join_qual_using -> new Join{Left: $lhs, Kind: text($k), Right: $r, Using: $q}
        postfix PIVOT ws "(" ws as:target_list_opt_comma ws FOR ws vs:pivot_value_list (ws GROUP ws BY ws g:name_list_opt_comma)? ws ")" (ws a:alias_clause)?
            -> new PivotRef{Source: $lhs, Aggregates: $as, Values: $vs, GroupBy: concat($g), Alias: $a}
        postfix UNPIVOT (ws n:include_nulls)? ws "(" ws h:unpivot_header ws FOR ws vs:unpivot_value_list ws ")" (ws a:alias_clause)?
            -> new UnpivotRef{Source: $lhs, IncludeNulls: $n, Header: $h, Values: $vs, Alias: $a}
    }
}
def join_type: Match = @(FULL (ws OUTER)? / LEFT (ws OUTER)? / RIGHT (ws OUTER)? / SEMI / ANTI / INNER)
def join_qual_on: Expr = ON ws e:expr -> $e
def join_qual_using: []Ident = USING ws "(" ws l:name_list_opt_comma ws ")" -> $l
def include_nulls: Match = @((INCLUDE / EXCLUDE) ws NULLS)
def unpivot_header: []Ident = bracketed_names / unpivot_single
def unpivot_single: []Ident = n:col_id_or_string -> list($n)
def unpivot_value_list: []UnpivotValue = first:unpivot_value rest:(-ws v:unpivot_value)* -> concat(list($first), map($rest, (r) => $r.v))
def unpivot_value: UnpivotValue = h:unpivot_header ws IN ws "(" ws is:target_list_opt_comma ws ")" -> new UnpivotValue{Header: $h, Items: $is}
def pivot_value_list: []PivotValue = first:pivot_value rest:(-ws v:pivot_value)* -> concat(list($first), map($rest, (r) => $r.v))
def pivot_value: PivotValue = h:pivot_header ws IN ws ( "(" ws is:target_list_opt_comma ws ")" / n:col_id_or_string ) -> new PivotValue{Header: $h, Items: concat($is), Enum: $n}
def pivot_header: []Expr = pivot_header_list / pivot_header_single
def pivot_header_list: []Expr = "(" ws l:c_expr_list_opt_comma ws ")" -> $l
def pivot_header_single: []Expr = e:c_expr -> list($e)
def c_expr_list_opt_comma: []Expr = first:c_expr rest:(-ws -"," -ws e:c_expr)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.e))

def table_primary: TableRef = values_ref / subquery_ref / paren_table / rows_from_ref / func_ref / base_ref

// alias_prefix_colon_clause: ColIdOrString ':' (the alias comes first)
def alias_prefix: Ident = n:col_id_or_string ws colon -> $n

def base_ref: BaseTable = (pa:alias_prefix ws)? (n:qualified_name st:(ws op_star)? / o:ONLY ws "(" ws n:qualified_name ws ")" / o:ONLY ws n:qualified_name) (ws a:alias_clause [len($pa) == 0])? (ws at:at_clause)? (ws s:tablesample_clause)?
    -> new BaseTable{Prefix: $pa, Name: $n, Only: len($o) > 0, Star: len($st) > 0, Alias: $a, At: $at, Sample: $s}
def at_clause: AtClause = AT ws "(" ws u:@(TIMESTAMP / VERSION) ws op_eq_gt ws v:expr ws ")" -> new AtClause{Unit: text($u), Value: $v}

def subquery_ref: SubqueryRef = (pa:alias_prefix ws)? (l:LATERAL ws)? q:select_with_parens (ws a:alias_clause [len($pa) == 0])? (ws s:tablesample_clause)?
    -> new SubqueryRef{Prefix: $pa, Query: $q, Lateral: len($l) > 0, Alias: $a, Sample: $s}
// a table in parentheses must be a join
def paren_table: ParenTable = (pa:alias_prefix ws)? "(" ws &(table_primary ws join_start) t:table_ref ws ")" (ws a:alias_clause [len($pa) == 0])?
    -> new ParenTable{Prefix: $pa, Table: $t, Alias: $a}
def join_start = CROSS / NATURAL / POSITIONAL / ASOF / FULL / LEFT / RIGHT / SEMI / ANTI / INNER / JOIN
def values_ref: ValuesRef = (pa:alias_prefix ws)? v:values_clause ws a:alias_clause (ws s:tablesample_clause)?
    -> new ValuesRef{Prefix: $pa, Values: $v, Alias: $a, Sample: $s}

def func_ref: FuncTable = (pa:alias_prefix ws)? (l:LATERAL ws)? f:func_expr_windowless (ws WITH ws o:ORDINALITY)? (ws a:func_alias_clause [len($pa) == 0])? (ws s:tablesample_clause)?
    -> new FuncTable{Prefix: $pa, Func: $f, Lateral: len($l) > 0, Ordinality: len($o) > 0, Alias: $a, Sample: $s}
def rows_from_ref: FuncTable = (pa:alias_prefix ws)? ROWS ws FROM ws "(" ws first:rowsfrom_item rest:(-ws -"," -ws i:rowsfrom_item)* ws ")" (ws WITH ws o:ORDINALITY)? (ws a:func_alias_clause [len($pa) == 0])? (ws s:tablesample_clause)?
    -> new FuncTable{Prefix: $pa, RowsFrom: concat(list($first), map($rest, (r) => $r.i)), Ordinality: len($o) > 0, Alias: $a, Sample: $s}
def rowsfrom_item: RowsFromItem = f:func_expr_windowless (ws AS ws "(" ws cd:table_func_element_list ws ")")? -> new RowsFromItem{Func: $f, ColDefs: concat($cd)}
def func_expr_windowless: Expr = cast_expr / special_call / func_call_bare
def func_call_bare: FuncCall =
    n:func_name ws "(" ws
    ( q:(ALL / DISTINCT) ws a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)?
    / a:func_arg_list (ws "," ws VARIADIC ws v:func_arg_expr)?
    / VARIADIC ws v:func_arg_expr
    )?
    (ws o:sort_clause)? (ws nl:opt_ignore_nulls)? ws ")"
    -> new FuncCall{Name: $n, Quantifier: text($q), Args: concat($a), Variadic: $v, OrderBy: $o, Nulls: text($nl)}

def alias_clause: TableAlias = alias_as_cols / alias_as / alias_cols / alias_bare
def alias_as_cols: TableAlias = AS ws n:col_id_or_string ws "(" ws cs:name_list_opt_comma ws ")" -> new TableAlias{Name: $n, Columns: $cs, As: true}
def alias_as: TableAlias = AS ws n:col_id_or_string -> new TableAlias{Name: $n, As: true}
def alias_cols: TableAlias = n:col_id ws "(" ws cs:name_list_opt_comma ws ")" -> new TableAlias{Name: $n, Columns: $cs}
def alias_bare: TableAlias = n:col_id -> new TableAlias{Name: $n}
// func_alias_clause: the alias may name the columns with their types
def func_alias_clause: TableAlias = alias_as_cols / falias_as_defs / falias_defs_only / alias_cols / falias_defs / alias_as / alias_bare
def falias_as_defs: TableAlias = AS ws n:col_id_or_string ws "(" ws cd:table_func_element_list ws ")" -> new TableAlias{Name: $n, ColDefs: $cd, As: true}
def falias_defs_only: TableAlias = AS ws "(" ws cd:table_func_element_list ws ")" -> new TableAlias{ColDefs: $cd, As: true}
def falias_defs: TableAlias = n:col_id ws "(" ws cd:table_func_element_list ws ")" -> new TableAlias{Name: $n, ColDefs: $cd}
def table_func_element_list: []ColDef = first:table_func_element rest:(-ws -"," -ws e:table_func_element)* -> concat(list($first), map($rest, (r) => $r.e))
def table_func_element: ColDef = n:col_id_or_string ws t:typename (ws COLLATE ws c:any_name)? -> new ColDef{Name: $n, Type: $t, Collate: $c}
// ===================================================================================================
// INSERT, UPDATE, DELETE, MERGE (insert.y, update.y, delete.y, merge_into.y)
// ===================================================================================================

def target_list: []SelectItem = first:select_item rest:(-ws -"," -ws i:select_item)* -> concat(list($first), map($rest, (r) => $r.i))

def insert_stmt: InsertStmt =
    (w:with_clause ws)? INSERT (ws oa:@(OR ws (REPLACE / IGNORE)))? ws INTO ws n:qualified_name (ws AS ws al:col_id)?
    (ws by:@(BY ws (NAME / POSITION)))?
    ws ( dv:@(DEFAULT ws VALUES)
       / (cs:insert_columns ws)? (ov:overriding ws)? q:select_stmt )
    (ws oc:on_conflict)?
    (ws RETURNING ws r:target_list)?
    -> new InsertStmt{With: $w, OrAction: text($oa), Table: $n, Alias: $al, By: text($by), Columns: concat($cs), Overriding: text($ov), Query: $q, DefaultValues: len($dv) > 0, OnConflict: $oc, Returning: concat($r)}
def insert_columns: []Name = "(" ws l:insert_column_list ws ")" -> $l
def insert_column_list: []Name = first:set_target rest:(-ws -"," -ws c:set_target)* -> concat(list($first), map($rest, (r) => $r.c))
def set_target: Name = any_name
def overriding: Match = @(OVERRIDING ws (USER / SYSTEM) ws VALUE)

def on_conflict: OnConflict = ON ws CONFLICT
    ( ws "(" ws ip:index_params ws ")" (ws WHERE ws tw:expr)? / ws ON ws CONSTRAINT ws c:name )?
    ws DO ws ( UPDATE ws SET ws st:set_clause_list_opt_comma (ws WHERE ws w:expr)? / nothing:NOTHING )
    -> new OnConflict{Target: concat($ip), TargetWhere: $tw, Constraint: $c, Nothing: len($nothing) > 0, Set: concat($st), Where: $w}
def index_params: []IndexElem = first:index_elem rest:(-ws -"," -ws e:index_elem)* -> concat(list($first), map($rest, (r) => $r.e))
def index_elem: IndexElem = index_elem_func / index_elem_col / index_elem_expr
def index_elem_col: IndexElem = c:col_id (ws COLLATE ws co:any_name)? (ws cl:opt_class)? (ws d:asc_desc)? (ws n:nulls_order)?
    -> new IndexElem{Expr: new ColumnRef{Parts: list($c)}, Collate: $co, Class: $cl, Direction: text($d), Nulls: text($n)}
def index_elem_func: IndexElem = f:func_expr_windowless (ws COLLATE ws co:any_name)? (ws cl:opt_class)? (ws d:asc_desc)? (ws n:nulls_order)?
    -> new IndexElem{Expr: $f, Collate: $co, Class: $cl, Direction: text($d), Nulls: text($n)}
def index_elem_expr: IndexElem = "(" ws e:expr ws ")" (ws COLLATE ws co:any_name)? (ws cl:opt_class)? (ws d:asc_desc)? (ws n:nulls_order)?
    -> new IndexElem{Expr: $e, Collate: $co, Class: $cl, Direction: text($d), Nulls: text($n)}
def opt_class: Name = !(NULLS ws (FIRST / LAST)) n:any_name -> $n

def set_clause_list_opt_comma: []SetClause = first:set_clause rest:(-ws -"," -ws c:set_clause)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.c))
def set_clause: SetClause = set_clause_paren / set_clause_one
def set_clause_one: SetClause = t:set_target ws op_eq ws v:expr -> new SetClause{Targets: list($t), Value: $v}
def set_clause_paren: SetClause = "(" ws first:set_target rest:(-ws -"," -ws c:set_target)* ws ")" ws op_eq ws v:expr
    -> new SetClause{Targets: concat(list($first), map($rest, (r) => $r.c)), Value: $v, Paren: true}

// relation_expr_opt_alias. SET is an unreserved keyword that follows the table of UPDATE.
def target_table: TargetTable = (n:qualified_name st:(ws op_star)? / o:ONLY ws "(" ws n:qualified_name ws ")" / o:ONLY ws n:qualified_name) (ws kw:AS ws al:col_id / ws !SET al:col_id)?
    -> new TargetTable{Name: $n, Only: len($o) > 0, Star: len($st) > 0, Alias: $al, As: len($kw) > 0}

def update_stmt: UpdateStmt =
    (w:with_clause ws)? UPDATE ws t:target_table ws SET ws s:set_clause_list_opt_comma
    (ws FROM ws f:from_list_opt_comma)? (ws WHERE ws wh:expr)? (ws RETURNING ws r:target_list)?
    -> new UpdateStmt{With: $w, Table: $t, Set: $s, From: concat($f), Where: $wh, Returning: concat($r)}

def delete_stmt: DeleteStmt =
    (w:with_clause ws)? DELETE ws FROM ws t:target_table (ws USING ws u:from_list_opt_comma)? (ws WHERE ws wh:expr)? (ws RETURNING ws r:target_list)?
    -> new DeleteStmt{With: $w, Table: $t, Using: concat($u), Where: $wh, Returning: concat($r)}
def truncate_stmt: DeleteStmt = TRUNCATE (ws TABLE)? ws t:target_table -> new DeleteStmt{Table: $t, Truncate: true}

def merge_stmt: MergeStmt =
    (w:with_clause ws)? MERGE ws INTO ws t:target_table ws USING ws s:table_ref
    ws ( ON ws on:expr / USING ws "(" ws us:name_list_opt_comma ws ")" )
    ws first:merge_when rest:(-ws m:merge_when)* (ws RETURNING ws r:target_list)?
    -> new MergeStmt{With: $w, Target: $t, Source: $s, On: $on, Using: concat($us), Whens: concat(list($first), map($rest, (x) => $x.m)), Returning: concat($r)}
def merge_when: MergeWhen = merge_when_matched / merge_when_not
def merge_when_matched: MergeWhen = WHEN ws MATCHED (ws AND ws c:expr)? ws THEN ws a:merge_action -> new MergeWhen{Not: false, Cond: $c, Action: $a}
def merge_when_not: MergeWhen = WHEN ws NOT ws MATCHED (ws by:@(BY ws (SOURCE / TARGET)))? (ws AND ws c:expr)? ws THEN ws a:merge_action
    -> new MergeWhen{Not: true, By: text($by), Cond: $c, Action: $a}
def merge_action: MergeAction = ma_update_set / ma_update_star / ma_update / ma_delete / ma_insert_values / ma_insert_default / ma_insert / ma_nothing / ma_error
def ma_update_set: MergeAction = k:UPDATE ws SET ws s:set_clause_list_opt_comma -> new MergeAction{Kind: text($k), Set: $s}
def ma_update_star: MergeAction = k:UPDATE ws SET ws op_star -> new MergeAction{Kind: text($k), Star: true}
def ma_update: MergeAction = k:UPDATE (ws by:@(BY ws (NAME / POSITION)))? -> new MergeAction{Kind: text($k), ByName: text($by)}
def ma_delete: MergeAction = k:DELETE -> new MergeAction{Kind: text($k)}
def ma_insert_values: MergeAction = k:INSERT (ws "(" ws cs:insert_column_ident_list ws ")")? ws VALUES ws "(" ws vs:expr_list_opt_comma ws ")"
    -> new MergeAction{Kind: text($k), Columns: concat($cs), Values: $vs}
def insert_column_ident_list: []Ident = first:col_id rest:(-ws -"," -ws c:col_id)* -> concat(list($first), map($rest, (r) => $r.c))
def ma_insert_default: MergeAction = k:INSERT ws DEFAULT ws VALUES -> new MergeAction{Kind: text($k), DefaultValues: true}
def ma_insert: MergeAction = k:INSERT (ws by:@(BY ws (NAME / POSITION)))? (ws st:op_star)? -> new MergeAction{Kind: text($k), ByName: text($by), Star: len($st) > 0}
def ma_nothing: MergeAction = k:@(DO ws NOTHING) -> new MergeAction{Kind: text($k)}
def ma_error: MergeAction = k:ERROR (ws m:expr)? -> new MergeAction{Kind: text($k), Message: $m}
// ===================================================================================================
// CREATE (create.y, create_as.y, view.y, index.y, create_schema.y, create_sequence.y, create_type.y,
// create_function.y, create_secret.y)
// ===================================================================================================

def opt_temp: Match = @(TEMPORARY / TEMP / LOCAL ws (TEMPORARY / TEMP) / GLOBAL ws (TEMPORARY / TEMP) / UNLOGGED)
def if_not_exists: Match = @(IF ws NOT ws EXISTS)
def if_exists: Match = @(IF ws EXISTS)
def or_replace: Match = @(OR ws REPLACE)

// ---- CREATE TABLE ----

def create_table_stmt: CreateTableStmt =
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws TABLE (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name
    ws "(" ws els:table_element_list ws ")"
    ps:(-ws p:partition_sorted_option)* (ws wo:opt_with_options)? (ws oc:on_commit_option)?
    -> new CreateTableStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Elements: $els, PartitionSorted: map($ps, (x) => $x.p), With: concat($wo), OnCommit: text($oc)}
def table_element_list: []TableElement = first:table_element rest:(-ws -"," -ws e:table_element)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.e))
def table_element: TableElement = table_constraint / table_like / column_def
def partition_sorted_option: PartitionSorted = k:@(PARTITIONED / SORTED) ws BY ws "(" ws xs:expr_list_opt_comma ws ")" -> new PartitionSorted{Kind: $k, Exprs: $xs}
// OptWith: WITH reloptions | WITH OIDS | WITHOUT OIDS
def opt_with_options: []Reloption = with_reloptions / with_oids
def with_reloptions: []Reloption = WITH ws "(" ws l:reloption_list ws ")" -> $l
def with_oids: []Reloption = (WITH ws OIDS / WITHOUT ws OIDS) -> list()
def on_commit_option: Match = @(ON ws COMMIT ws (DROP / DELETE ws ROWS / PRESERVE ws ROWS))

def reloption_list: []Reloption = first:reloption_elem rest:(-ws -"," -ws e:reloption_elem)* -> concat(list($first), map($rest, (r) => $r.e))
def reloption_elem: Reloption = reloption_def / reloption_expr
def reloption_def: Reloption = a:col_label ws "." ws b:col_label (ws op_eq ws v:def_arg)? -> new Reloption{Name: new Name{Parts: list($a, $b)}, Arg: $v}
def reloption_expr: Reloption = n:reloption_name (ws op_eq ws v:expr)? -> new Reloption{Name: $n, Value: $v}
def reloption_name: Name = c:col_label_or_string -> new Name{Parts: list($c)}
// def_arg: func_type | reserved_keyword | qual_all_Op | NumericOnly | Sconst | NONE
def def_arg: Match = @(typename / &kw_reserved word / qual_all_op / numeric_only / sconst / NONE)
def numeric_only: Match = @((op_plus / op_minus)? ws number)
def def_list: []DefElem = first:def_elem rest:(-ws -"," -ws e:def_elem)* -> concat(list($first), map($rest, (r) => $r.e))
def def_elem: DefElem = n:col_label (ws op_eq ws v:def_arg)? -> new DefElem{Name: $n, Value: text($v)}
def definition: []DefElem = "(" ws l:def_list ws ")" -> $l
def opt_definition: []DefElem = WITH ws d:definition -> $d

// ---- Table elements ----

def column_def: ColumnDef = column_def_generated / column_def_regular
def column_def_regular: ColumnDef = n:col_id ws t:typename cs:(-ws c:col_constraint)* -> new ColumnDef{Name: $n, Type: $t, Constraints: map($cs, (x) => $x.c)}
def column_def_generated: ColumnDef = n:col_id (ws t:typename)? ws g:generated_constraint cs:(-ws c:col_constraint)*
    -> new ColumnDef{Name: $n, Type: $t, Generated: $g, Constraints: map($cs, (x) => $x.c)}
def generated_constraint: GeneratedColumn = gen_identity / gen_expr / gen_as
def gen_identity: GeneratedColumn = GENERATED ws w:generated_when ws AS ws IDENTITY (ws "(" ws so:seq_opt_list ws ")")? -> new GeneratedColumn{When: text($w), Identity: true, SeqOptions: concat($so)}
def gen_expr: GeneratedColumn = GENERATED ws w:generated_when ws AS ws "(" ws e:expr ws ")" (ws st:generated_storage)? -> new GeneratedColumn{When: text($w), Expr: $e, Storage: text($st)}
def gen_as: GeneratedColumn = AS ws "(" ws e:expr ws ")" (ws st:generated_storage)? -> new GeneratedColumn{Expr: $e, Storage: text($st)}
def generated_when: Match = @(ALWAYS / BY ws DEFAULT)
def generated_storage = VIRTUAL / STORED

def constraint_name: Ident = CONSTRAINT ws n:name -> $n
def col_constraint: ColumnConstraint = cc_not_null / cc_null / cc_unique / cc_primary / cc_check / cc_compression / cc_default / cc_references / cc_attr / cc_collate
def cc_not_null: ColumnConstraint = (cn:constraint_name ws)? k:@(NOT ws NULL) -> new ColumnConstraint{Name: $cn, Kind: text($k)}
def cc_null: ColumnConstraint = (cn:constraint_name ws)? k:NULL -> new ColumnConstraint{Name: $cn, Kind: text($k)}
def cc_unique: ColumnConstraint = (cn:constraint_name ws)? k:UNIQUE (ws o:opt_definition)? -> new ColumnConstraint{Name: $cn, Kind: text($k), Options: concat($o)}
def cc_primary: ColumnConstraint = (cn:constraint_name ws)? k:@(PRIMARY ws KEY) (ws o:opt_definition)? -> new ColumnConstraint{Name: $cn, Kind: text($k), Options: concat($o)}
def cc_check: ColumnConstraint = (cn:constraint_name ws)? k:CHECK ws "(" ws e:expr ws ")" (ws NO ws INHERIT)? -> new ColumnConstraint{Name: $cn, Kind: text($k), Expr: $e}
def cc_compression: ColumnConstraint = (cn:constraint_name ws)? k:@(USING ws COMPRESSION) ws c:name -> new ColumnConstraint{Name: $cn, Kind: text($k), Compression: $c}
def cc_default: ColumnConstraint = (cn:constraint_name ws)? k:DEFAULT ws e:b_expr -> new ColumnConstraint{Name: $cn, Kind: text($k), Expr: $e}
def cc_references: ColumnConstraint = (cn:constraint_name ws)? k:REFERENCES ws r:reference -> new ColumnConstraint{Name: $cn, Kind: text($k), Reference: $r}
def cc_attr: ColumnConstraint = k:constraint_attr -> new ColumnConstraint{Kind: text($k)}
def cc_collate: ColumnConstraint = k:COLLATE ws c:any_name -> new ColumnConstraint{Kind: text($k), Collation: $c}
def constraint_attr: Match = @(DEFERRABLE / NOT ws DEFERRABLE / INITIALLY ws (DEFERRED / IMMEDIATE))

def reference: Reference = t:qualified_name (ws "(" ws cs:column_list ws ")")? (ws m:key_match)?
    (ws (ku:key_update (ws kd:key_delete)? / kd:key_delete (ws ku:key_update)?))?
    -> new Reference{Table: $t, Columns: concat($cs), Match: $m, OnUpdate: $ku, OnDelete: $kd}
def column_list: []Ident = col_id_list
def column_list_opt_comma: []Ident = l:col_id_list (ws ",")? -> $l
def key_match: Match = @(MATCH ws (FULL / PARTIAL / SIMPLE))
def key_update: Match = @(ON ws UPDATE ws key_action)
def key_delete: Match = @(ON ws DELETE ws key_action)
def key_action = NO ws ACTION / RESTRICT / CASCADE / SET ws NULL / SET ws DEFAULT

def table_constraint: TableConstraint = tc_check / tc_unique / tc_unique_index / tc_primary / tc_primary_index / tc_foreign
def constraint_attrs: []Match = as:(-ws a:constraint_attribute)* -> map($as, (x) => $x.a)
def constraint_attribute: Match = @(NOT ws DEFERRABLE / DEFERRABLE / INITIALLY ws IMMEDIATE / INITIALLY ws DEFERRED / NOT ws VALID / NO ws INHERIT)
def tc_check: TableConstraint = (cn:constraint_name ws)? k:CHECK ws "(" ws e:expr ws ")" at:constraint_attrs -> new TableConstraint{Name: $cn, Kind: text($k), Expr: $e, Attributes: $at}
def tc_unique: TableConstraint = (cn:constraint_name ws)? k:UNIQUE ws "(" ws cs:column_list_opt_comma ws ")" (ws o:opt_definition)? at:constraint_attrs
    -> new TableConstraint{Name: $cn, Kind: text($k), Columns: $cs, Options: concat($o), Attributes: $at}
def tc_unique_index: TableConstraint = (cn:constraint_name ws)? k:UNIQUE ws USING ws INDEX ws i:col_id at:constraint_attrs -> new TableConstraint{Name: $cn, Kind: text($k), Index: $i, Attributes: $at}
def tc_primary: TableConstraint = (cn:constraint_name ws)? k:@(PRIMARY ws KEY) ws "(" ws cs:column_list_opt_comma ws ")" (ws o:opt_definition)? at:constraint_attrs
    -> new TableConstraint{Name: $cn, Kind: text($k), Columns: $cs, Options: concat($o), Attributes: $at}
def tc_primary_index: TableConstraint = (cn:constraint_name ws)? k:@(PRIMARY ws KEY) ws USING ws INDEX ws i:col_id at:constraint_attrs -> new TableConstraint{Name: $cn, Kind: text($k), Index: $i, Attributes: $at}
def tc_foreign: TableConstraint = (cn:constraint_name ws)? k:@(FOREIGN ws KEY) ws "(" ws cs:column_list_opt_comma ws ")" ws REFERENCES ws r:reference at:constraint_attrs
    -> new TableConstraint{Name: $cn, Kind: text($k), Columns: $cs, Reference: $r, Attributes: $at}

def table_like: TableLike = LIKE ws t:qualified_name os:(-ws o:table_like_option)* -> new TableLike{Table: $t, Options: map($os, (x) => $x.o)}
def table_like_option: Match = @((INCLUDING / EXCLUDING) ws (COMMENTS / CONSTRAINTS / DEFAULTS / IDENTITY / INDEXES / STATISTICS / STORAGE / ALL))

// ---- CREATE TABLE AS ----

def create_table_as_stmt: CreateTableAsStmt =
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws TABLE (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name
    (ws "(" ws cs:column_list ws ")")?
    ps:(-ws p:partition_sorted_option)* (ws wo:opt_with_options)? (ws oc:on_commit_option)?
    ws AS ws src:(select_stmt / execute_stmt) (ws wd:with_data)?
    -> new CreateTableAsStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Columns: concat($cs), PartitionSorted: map($ps, (x) => $x.p), With: concat($wo), OnCommit: text($oc), Source: $src, WithData: text($wd)}
def with_data: Match = @(WITH ws (NO ws)? DATA)

// ---- CREATE VIEW ----

def create_view_stmt: CreateViewStmt =
    CREATE (ws orr:or_replace)? (ws t:opt_temp)? (ws r:RECURSIVE)? ws VIEW (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name
    (ws "(" ws cs:column_list ws ")")? (ws WITH ws "(" ws o:reloption_list ws ")")? ws AS ws q:select_stmt (ws co:check_option)?
    -> new CreateViewStmt{OrReplace: len($orr) > 0, Temp: text($t), Recursive: len($r) > 0, IfNotExists: len($ine) > 0, Name: $n, Columns: concat($cs), Options: concat($o), Query: $q, CheckOption: text($co)}
def check_option: Match = @(WITH ws (CASCADED ws / LOCAL ws)? CHECK ws OPTION)

// ---- CREATE INDEX ----

def create_index_stmt: CreateIndexStmt =
    CREATE (ws u:UNIQUE)? ws INDEX (ws cc:CONCURRENTLY)? (ws ine:if_not_exists ws n:col_id / ws n:col_id)? ws ON ws t:qualified_name
    (ws USING ws m:col_id)? ws "(" ws ps:index_params ws ")" (ws WITH ws "(" ws o:reloption_list ws ")")? (ws WHERE ws w:expr)?
    -> new CreateIndexStmt{Unique: len($u) > 0, Concurrently: len($cc) > 0, IfNotExists: len($ine) > 0, Name: $n, Table: $t, Method: $m, Params: $ps, Options: concat($o), Where: $w}

// ---- CREATE SCHEMA, SEQUENCE, TYPE ----

def create_schema_stmt: CreateSchemaStmt = CREATE (ws orr:or_replace)? ws SCHEMA (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name es:(-ws e:schema_stmt)*
    -> new CreateSchemaStmt{OrReplace: len($orr) > 0, IfNotExists: len($ine) > 0, Name: $n, Elements: map($es, (x) => $x.e)}
def schema_stmt: Statement = create_table_stmt / create_index_stmt / create_sequence_stmt / create_view_stmt

def create_sequence_stmt: CreateSequenceStmt = CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws SEQUENCE (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name (ws os:seq_opt_list)?
    -> new CreateSequenceStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Options: concat($os)}
def seq_opt_list: []SeqOption = first:seq_opt_elem rest:(-ws o:seq_opt_elem)* -> concat(list($first), map($rest, (r) => $r.o))
def seq_opt_elem: SeqOption = so_as / so_num / so_flag / so_owned / so_seqname / so_restart
def so_as: SeqOption = k:AS ws t:typename -> new SeqOption{Kind: text($k), Type: $t}
def so_num: SeqOption = k:@(CACHE / INCREMENT (ws BY)? / MAXVALUE / MINVALUE / START (ws WITH)?) ws v:numeric_only -> new SeqOption{Kind: text($k), Value: text($v)}
def so_flag: SeqOption = k:@(CYCLE / NO ws (CYCLE / MAXVALUE / MINVALUE)) -> new SeqOption{Kind: text($k)}
def so_owned: SeqOption = k:@(OWNED ws BY) ws o:any_name -> new SeqOption{Kind: text($k), Owner: $o}
def so_seqname: SeqOption = k:@(SEQUENCE ws NAME) ws o:any_name -> new SeqOption{Kind: text($k), Owner: $o}
def so_restart: SeqOption = k:RESTART (ws (WITH ws)? v:numeric_only)? -> new SeqOption{Kind: text($k), Value: text($v)}

def create_type_stmt: CreateTypeStmt = CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws TYPE (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name ws AS ws
    ( en:ENUM ws ( q:select_with_parens / "(" ws vs:enum_val_list? ws ")" ) / !(ENUM ws "(") ty:typename )
    -> new CreateTypeStmt{OrReplace: len($orr) > 0, Temp: text($t), IfNotExists: len($ine) > 0, Name: $n, Enum: len($en) > 0, Values: concat($vs), Query: $q, Type: $ty}
def enum_val_list: []StringLit = first:sconst rest:(-ws -"," -ws s:sconst)* -> concat(list($first), map($rest, (r) => $r.s))

// ---- CREATE MACRO ----

def create_macro_stmt: CreateMacroStmt = CREATE (ws orr:or_replace)? (ws t:opt_temp)? ws (f:FUNCTION / MACRO) (ws ine:if_not_exists [len($orr) == 0])? ws n:qualified_name ws ds:macro_definitions
    -> new CreateMacroStmt{OrReplace: len($orr) > 0, Temp: text($t), Function: len($f) > 0, IfNotExists: len($ine) > 0, Name: $n, Definitions: $ds}
def macro_definitions: []MacroDef = macro_table_list / macro_expr_list
def macro_expr_list: []MacroDef = first:macro_expr_def rest:(-ws -"," -ws d:macro_expr_def)* -> concat(list($first), map($rest, (r) => $r.d))
def macro_expr_def: MacroDef = ps:param_list ws AS ws e:expr -> new MacroDef{Params: $ps, Expr: $e}
def macro_table_list: []MacroDef = macro_table_one_end / macro_table_many
def macro_table_one_end: []MacroDef = l:macro_table_one &stmt_end -> $l
def macro_table_one: []MacroDef = ps:param_list ws AS ws TABLE ws q:select_no_parens -> list(new MacroDef{Params: $ps, Query: $q})
def macro_table_many: []MacroDef = first:macro_table_paren rest:(-ws -"," -ws d:macro_table_paren)* -> concat(list($first), map($rest, (r) => $r.d))
def macro_table_paren: MacroDef = ps:param_list ws AS ws TABLE ws q:select_with_parens -> new MacroDef{Params: $ps, Query: $q}
def param_list: []MacroParam = "(" ws ps:macro_params? ws ")" -> concat($ps)
def macro_params: []MacroParam = first:macro_param rest:(-ws -"," -ws p:macro_param)* (ws ",")? -> concat(list($first), map($rest, (r) => $r.p))
def macro_param: MacroParam = n:param_name (ws t:typename)? (ws (":=" / ar:op_eq_gt) ws d:expr)? -> new MacroParam{Name: $n, Type: $t, Default: $d, Arrow: len($ar) > 0}

// ---- CREATE SECRET ----

def create_secret_stmt: CreateSecretStmt = CREATE (ws orr:or_replace)? (ws p:@(TEMPORARY / PERSISTENT))? ws SECRET (ws ine:if_not_exists [len($orr) == 0])? (ws n:col_id)? (ws IN ws st:ident_only)? ws "(" ws os:secret_options ws ")"
    -> new CreateSecretStmt{OrReplace: len($orr) > 0, Persist: text($p), IfNotExists: len($ine) > 0, Name: $n, Storage: $st, Options: $os}
def secret_options: []SecretOption = first:secret_option rest:(-ws -"," -ws o:secret_option)* -> concat(list($first), map($rest, (r) => $r.o))
def secret_option: SecretOption = n:col_label ws v:expr -> new SecretOption{Name: $n, Value: $v}
// ===================================================================================================
// ALTER, RENAME, DROP (alter_table.y, alter_sequence.y, alter_database.y, alter_schema.y, rename.y, drop.y)
// ===================================================================================================

def alter_table_stmt: AlterTableStmt = alter_relation_stmt / alter_name_stmt
def alter_relation_stmt: AlterTableStmt = ALTER ws k:TABLE (ws ie:if_exists)? ws (n:qualified_name st:(ws op_star)? / o:ONLY ws "(" ws n:qualified_name ws ")" / o:ONLY ws n:qualified_name) ws cs:alter_table_cmds
    -> new AlterTableStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Only: len($o) > 0, Star: len($st) > 0, Commands: $cs}
def alter_name_stmt: AlterTableStmt = ALTER ws k:(INDEX / SEQUENCE / VIEW) (ws ie:if_exists)? ws n:qualified_name ws cs:alter_table_cmds
    -> new AlterTableStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Commands: $cs}
def alter_table_cmds: []AlterCmd = first:alter_table_cmd rest:(-ws -"," -ws c:alter_table_cmd)* -> concat(list($first), map($rest, (r) => $r.c))

// a column that may be a path into a struct: a.b.c
def qualified_column: Name = n:any_name -> $n

def alter_table_cmd: AlterCmd =
      ac_add_constraint / ac_add_generated / ac_add_column / ac_set_partitioned / ac_reset_partitioned / ac_set_sorted / ac_reset_sorted
    / ac_alter_column / ac_drop_column / ac_alter_constraint / ac_validate / ac_drop_constraint
    / ac_set_logged / ac_set_options / ac_reset_options / ac_generic
def ac_add_constraint: AlterCmd = k:ADD ws c:table_constraint -> new AlterCmd{Kind: text($k), Constraint: $c}
def ac_add_column: AlterCmd = k:@(ADD (ws COLUMN)?) (ws ine:if_not_exists)? ws q:qualified_column ws t:typename cs:(-ws c:col_constraint)*
    -> new AlterCmd{Kind: text($k), IfNotExists: len($ine) > 0, Column: $q, Type: $t, Constraints: map($cs, (x) => $x.c)}
def ac_add_generated: AlterCmd = k:@(ADD (ws COLUMN)?) (ws ine:if_not_exists)? ws q:qualified_column (ws t:typename)? ws g:generated_constraint cs:(-ws c:col_constraint)*
    -> new AlterCmd{Kind: text($k), IfNotExists: len($ine) > 0, Column: $q, Type: $t, Generated: $g, Constraints: map($cs, (x) => $x.c)}
def ac_set_partitioned: AlterCmd = k:@(SET ws PARTITIONED ws BY) ws "(" ws xs:expr_list_opt_comma ws ")" -> new AlterCmd{Kind: text($k), Exprs: $xs}
def ac_reset_partitioned: AlterCmd = k:@(RESET ws PARTITIONED ws BY) -> new AlterCmd{Kind: text($k)}
def ac_set_sorted: AlterCmd = k:@(SET ws SORTED ws BY) ws "(" ws l:sortby_list ws ")" -> new AlterCmd{Kind: text($k), SortBy: $l}
def ac_reset_sorted: AlterCmd = k:@(RESET ws SORTED ws BY) -> new AlterCmd{Kind: text($k)}
def sortby_list: []SortItem = first:sortby rest:(-ws -"," -ws s:sortby)* -> concat(list($first), map($rest, (r) => $r.s))

def ac_alter_column: AlterCmd = ac_col_default / ac_col_drop_default / ac_col_not_null / ac_col_statistics / ac_col_set_options / ac_col_reset_options
    / ac_col_storage / ac_col_add_identity / ac_col_drop_identity / ac_col_identity / ac_col_type / ac_col_generic
def alter_column_head: Match = @(ALTER (ws COLUMN)?)
def ac_col_default: AlterCmd = k:alter_column_head ws c:col_id ws SET ws DEFAULT ws e:expr -> new AlterCmd{Kind: text($k), Name: $c, Expr: $e}
def ac_col_drop_default: AlterCmd = k:alter_column_head ws c:col_id ws DROP ws DEFAULT -> new AlterCmd{Kind: text($k), Name: $c}
def ac_col_not_null: AlterCmd = k:alter_column_head ws c:col_id ws (DROP / SET) ws NOT ws NULL -> new AlterCmd{Kind: text($k), Name: $c}
def ac_col_statistics: AlterCmd = k:alter_column_head ws c:col_id ws SET ws STATISTICS ws v:signed_iconst -> new AlterCmd{Kind: text($k), Name: $c, Value: text($v)}
def ac_col_set_options: AlterCmd = k:alter_column_head ws c:col_id ws SET ws "(" ws o:reloption_list ws ")" -> new AlterCmd{Kind: text($k), Name: $c, Options: $o}
def ac_col_reset_options: AlterCmd = k:alter_column_head ws c:col_id ws RESET ws "(" ws o:reloption_list ws ")" -> new AlterCmd{Kind: text($k), Name: $c, Options: $o}
def ac_col_storage: AlterCmd = k:alter_column_head ws c:col_id ws SET ws STORAGE ws v:@col_id -> new AlterCmd{Kind: text($k), Name: $c, Value: text($v)}
def ac_col_add_identity: AlterCmd = k:alter_column_head ws c:col_id ws ADD ws GENERATED ws w:generated_when ws AS ws IDENTITY (ws "(" ws so:seq_opt_list ws ")")?
    -> new AlterCmd{Kind: text($k), Name: $c, When: text($w), Identity: concat($so)}
def ac_col_drop_identity: AlterCmd = k:alter_column_head ws c:col_id ws DROP ws IDENTITY (ws ie:if_exists)? -> new AlterCmd{Kind: text($k), Name: $c, IfExists: len($ie) > 0}
def ac_col_identity: AlterCmd = k:alter_column_head ws c:col_id ws is:identity_options -> new AlterCmd{Kind: text($k), Name: $c, Identity: $is}
def identity_options: []SeqOption = first:identity_option rest:(-ws o:identity_option)* -> concat(list($first), map($rest, (r) => $r.o))
def identity_option: SeqOption = so_restart / io_set / io_generated
def io_set: SeqOption = SET ws o:seq_opt_elem -> $o
def io_generated: SeqOption = k:@(SET ws GENERATED) ws w:generated_when -> new SeqOption{Kind: text($k), Value: text($w)}
def ac_col_type: AlterCmd = k:alter_column_head ws c:col_id ws (SET ws DATA ws / SET ws)? TYPE (ws t:typename)? (ws COLLATE ws co:any_name)? (ws USING ws u:expr)?
    -> new AlterCmd{Kind: text($k), Name: $c, Type: $t, Collate: $co, Using: $u}
def ac_col_generic: AlterCmd = k:alter_column_head ws c:col_id ws g:alter_generic_options -> new AlterCmd{Kind: text($k), Name: $c, Generic: $g}
def signed_iconst: Match = @((op_plus / op_minus)? ws iconst)

def ac_drop_column: AlterCmd = k:@(DROP (ws COLUMN)?) (ws ie:if_exists)? ws q:qualified_column (ws b:drop_behavior)? -> new AlterCmd{Kind: text($k), IfExists: len($ie) > 0, Column: $q, Behavior: text($b)}
def ac_alter_constraint: AlterCmd = k:@(ALTER ws CONSTRAINT) ws n:name constraint_attrs -> new AlterCmd{Kind: text($k), Name: $n}
def ac_validate: AlterCmd = k:@(VALIDATE ws CONSTRAINT) ws n:name -> new AlterCmd{Kind: text($k), Name: $n}
def ac_drop_constraint: AlterCmd = k:@(DROP ws CONSTRAINT) (ws ie:if_exists)? ws n:name (ws b:drop_behavior)? -> new AlterCmd{Kind: text($k), IfExists: len($ie) > 0, Name: $n, Behavior: text($b)}
def ac_set_logged: AlterCmd = k:@(SET ws (LOGGED / UNLOGGED)) -> new AlterCmd{Kind: text($k)}
def ac_set_options: AlterCmd = k:SET ws "(" ws o:reloption_list ws ")" -> new AlterCmd{Kind: text($k), Options: $o}
def ac_reset_options: AlterCmd = k:RESET ws "(" ws o:reloption_list ws ")" -> new AlterCmd{Kind: text($k), Options: $o}
def ac_generic: AlterCmd = k:OPTIONS ws g:alter_generic_list -> new AlterCmd{Kind: text($k), Generic: $g}
def alter_generic_options: []GenericAlterOption = OPTIONS ws g:alter_generic_list -> $g
def alter_generic_list: []GenericAlterOption = "(" ws first:alter_generic_option rest:(-ws -"," -ws o:alter_generic_option)* ws ")" -> concat(list($first), map($rest, (r) => $r.o))
def alter_generic_option: GenericAlterOption = ago_value / ago_drop
def ago_value: GenericAlterOption = (a:(SET / ADD) ws)? n:col_label ws v:sconst -> new GenericAlterOption{Action: text($a), Name: $n, Value: $v}
def ago_drop: GenericAlterOption = a:DROP ws n:col_label -> new GenericAlterOption{Action: text($a), Name: $n}
def drop_behavior = CASCADE / RESTRICT

def alter_sequence_stmt: AlterSequenceStmt = ALTER ws SEQUENCE (ws ie:if_exists)? ws n:qualified_name ws os:seq_opt_list -> new AlterSequenceStmt{IfExists: len($ie) > 0, Name: $n, Options: $os}
def alter_database_stmt: AlterDatabaseStmt = ALTER ws DATABASE (ws ie:if_exists)? ws n:col_id ws SET ws s:ident_only ws TO ws v:col_id -> new AlterDatabaseStmt{IfExists: len($ie) > 0, Name: $n, Setting: $s, Value: $v}
def alter_object_schema_stmt: AlterObjectSchemaStmt = alter_schema_relation / alter_schema_name
def alter_schema_relation: AlterObjectSchemaStmt = ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws SET ws SCHEMA ws s:name
    -> new AlterObjectSchemaStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Schema: $s}
def alter_schema_name: AlterObjectSchemaStmt = ALTER ws k:(SEQUENCE / VIEW) (ws ie:if_exists)? ws n:qualified_name ws SET ws SCHEMA ws s:name
    -> new AlterObjectSchemaStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Schema: $s}

def rename_stmt: RenameStmt = rename_schema / rename_column / rename_constraint / rename_object
def rename_schema: RenameStmt = k:@(ALTER ws SCHEMA) ws n:name ws RENAME ws TO ws t:name -> new RenameStmt{Object: text($k), Name: new Name{Parts: list($n)}, NewName: $t}
def rename_object: RenameStmt = rename_relation / rename_name
def rename_relation: RenameStmt = ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws RENAME ws TO ws t:name
    -> new RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, NewName: $t}
def rename_name: RenameStmt = ALTER ws k:(SEQUENCE / VIEW / INDEX) (ws ie:if_exists)? ws n:qualified_name ws RENAME ws TO ws t:name
    -> new RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, NewName: $t}
def rename_column: RenameStmt = ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws RENAME (ws COLUMN)? ws c:qualified_column ws TO ws t:name
    -> new RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Column: $c, NewName: $t}
def rename_constraint: RenameStmt = ALTER ws k:TABLE (ws ie:if_exists)? ws (ONLY ws "(" ws n:qualified_name ws ")" / ONLY ws n:qualified_name / n:qualified_name (ws op_star)?) ws RENAME ws CONSTRAINT ws c:name ws TO ws t:name
    -> new RenameStmt{Object: text($k), IfExists: len($ie) > 0, Name: $n, Constraint: $c, NewName: $t}

// ---- DROP ----

def drop_stmt: DropStmt = drop_any_name / drop_name / drop_on
def drop_any_name: DropStmt = DROP ws k:drop_type_any_name (ws ie:if_exists)? ws ns:any_name_list (ws b:drop_behavior)? -> new DropStmt{Type: text($k), IfExists: len($ie) > 0, Names: $ns, Behavior: text($b)}
def drop_name: DropStmt = DROP ws k:drop_type_name (ws ie:if_exists)? ws ns:name_as_name_list (ws b:drop_behavior)? -> new DropStmt{Type: text($k), IfExists: len($ie) > 0, Names: $ns, Behavior: text($b)}
def drop_on: DropStmt = DROP ws k:@(POLICY / RULE / TRIGGER) (ws ie:if_exists)? ws n:name ws ON ws o:any_name (ws b:drop_behavior)?
    -> new DropStmt{Type: text($k), IfExists: len($ie) > 0, Names: list(new Name{Parts: list($n)}), On: $o, Behavior: text($b)}
def drop_type_any_name: Match = @(TABLE / SEQUENCE / FUNCTION / MACRO (ws TABLE)? / VIEW / MATERIALIZED ws VIEW / INDEX / FOREIGN ws TABLE / COLLATION / CONVERSION / SCHEMA / STATISTICS
    / TEXT ws SEARCH ws (PARSER / DICTIONARY / TEMPLATE / CONFIGURATION) / TYPE)
def drop_type_name: Match = @(ACCESS ws METHOD / EVENT ws TRIGGER / EXTENSION / FOREIGN ws DATA ws WRAPPER / PUBLICATION / SERVER)
def any_name_list: []Name = first:any_name rest:(-ws -"," -ws n:any_name)* -> concat(list($first), map($rest, (r) => $r.n))
def name_as_name_list: []Name = first:name rest:(-ws -"," -ws n:name)* -> concat(list(new Name{Parts: list($first)}), map($rest, (r) => new Name{Parts: list($r.n)}))
def drop_secret_stmt: DropSecretStmt = DROP (ws p:@(TEMPORARY / PERSISTENT))? ws SECRET (ws ie:if_exists)? ws n:col_id (ws FROM ws st:ident_only)?
    -> new DropSecretStmt{Persist: text($p), IfExists: len($ie) > 0, Name: $n, Storage: $st}
// ===================================================================================================
// COPY, EXPORT, ATTACH, SET, SHOW, EXPLAIN, ... (copy.y, export.y, attach.y, load.y, pragma.y, ...)
// ===================================================================================================

// ---- COPY ----

def copy_stmt: Statement = copy_table / copy_query / copy_database
def copy_table: CopyStmt =
    COPY (ws b:BINARY)? ws t:qualified_name (ws "(" ws cs:column_list ws ")")? (ws WITH ws OIDS)?
    ws d:(FROM / TO) (ws pr:PROGRAM)? ws (f:copy_file / s:@(STDIN / STDOUT))
    (ws (USING ws)? DELIMITERS ws dl:sconst)? (ws WITH)?
    (ws g:generic_opt_list / ls:(-ws o:copy_opt_item)*)
    -> new CopyStmt{Binary: len($b) > 0, Table: $t, Columns: concat($cs), Direction: text($d), Program: len($pr) > 0, File: $f, Std: text($s), Delimiters: $dl, Legacy: map($ls, (x) => $x.o), Options: concat($g)}
def copy_query: CopyStmt =
    COPY ws "(" ws q:select_stmt ws ")" ws d:TO (ws pr:PROGRAM)? ws (f:copy_file / s:@(STDIN / STDOUT)) (ws WITH)?
    (ws g:generic_opt_list / ls:(-ws o:copy_opt_item)*)
    -> new CopyStmt{Query: $q, Direction: text($d), Program: len($pr) > 0, File: $f, Std: text($s), Legacy: map($ls, (x) => $x.o), Options: concat($g)}
def copy_database: CopyDatabaseStmt = COPY ws FROM ws DATABASE ws f:col_id ws TO ws t:col_id (ws fl:copy_database_flag)? -> new CopyDatabaseStmt{From: $f, To: $t, Flag: text($fl)}
def copy_database_flag: Match = @("(" ws (SCHEMA / DATA) ws ")")
// Sconst | IDENT '.' ColId | IDENT | '(' a_expr ')' | param_expr
def copy_file: Expr = sconst / copy_ident_file / paren_expr / param
def copy_ident_file: ColumnRef = a:ident_only bs:(-ws -"." -ws c:col_id){0,1} -> new ColumnRef{Parts: concat(list($a), map($bs, (x) => $x.c))}
def generic_opt_list: []GenericOption = "(" ws first:generic_opt_elem rest:(-ws -"," -ws o:generic_opt_elem)* ws ")" -> concat(list($first), map($rest, (r) => $r.o))
def generic_opt_elem: GenericOption = n:col_label (ws v:expr)? -> new GenericOption{Name: $n, Value: $v}
def copy_opt_item: CopyOption = co_flag / co_string / co_force_cols / co_force_star / co_partition_cols / co_partition_star
def co_flag: CopyOption = k:(BINARY / OIDS / FREEZE / CSV / HEADER) -> new CopyOption{Name: text($k)}
def co_string: CopyOption = k:(DELIMITER / NULL / QUOTE / ESCAPE / ENCODING) (ws AS)? ws v:@sconst -> new CopyOption{Name: text($k), Value: text($v)}
def co_force_cols: CopyOption = k:@(FORCE ws (QUOTE / NOT ws NULL / NULL)) ws cs:column_list -> new CopyOption{Name: text($k), Columns: $cs}
def co_force_star: CopyOption = k:@(FORCE ws QUOTE) ws v:op_star -> new CopyOption{Name: text($k), Value: text($v)}
def co_partition_cols: CopyOption = k:@(PARTITION ws BY) ws cs:column_list -> new CopyOption{Name: text($k), Columns: $cs}
def co_partition_star: CopyOption = k:@(PARTITION ws BY) ws v:op_star -> new CopyOption{Name: text($k), Value: text($v)}

def export_stmt: ExportStmt = EXPORT ws DATABASE (ws d:col_id ws TO)? ws p:sconst (ws g:generic_opt_list / ls:(-ws o:copy_opt_item)*)
    -> new ExportStmt{Database: $d, Path: $p, Legacy: map($ls, (x) => $x.o), Options: concat($g)}
def import_stmt: ImportStmt = IMPORT ws DATABASE ws p:sconst -> new ImportStmt{Path: $p}

// ---- ATTACH, DETACH, USE, LOAD ----

def attach_stmt: AttachStmt = ATTACH (ws ine:if_not_exists / ws orr:or_replace)? (ws db:DATABASE)? ws p:sconst (ws AS ws a:col_id)? (ws o:generic_opt_list)?
    -> new AttachStmt{OrReplace: len($orr) > 0, IfNotExists: len($ine) > 0, Database: len($db) > 0, Path: $p, Alias: $a, Options: concat($o)}
def detach_stmt: DetachStmt = detach_database / detach_plain
def detach_database: DetachStmt = DETACH ws DATABASE (ws ie:if_exists)? ws n:col_label -> new DetachStmt{Database: true, IfExists: len($ie) > 0, Name: $n}
def detach_plain: DetachStmt = DETACH ws n:col_label -> new DetachStmt{Name: $n}
def use_stmt: UseStmt = USE ws n:qualified_name -> new UseStmt{Name: $n}
def load_stmt: LoadStmt = load_install / load_load
def load_load: LoadStmt = LOAD ws n:col_id_or_string -> new LoadStmt{Name: $n}
def load_install: LoadStmt = (f:FORCE ws)? INSTALL ws n:col_id_or_string (ws FROM ws s:col_id_or_string)? (ws VERSION ws v:col_id_or_string)?
    -> new LoadStmt{Install: true, Force: len($f) > 0, Name: $n, Source: $s, Version: $v}

// ---- PRAGMA, SET, RESET, SHOW ----

def pragma_stmt: PragmaStmt = pragma_call / pragma_set / pragma_plain
def pragma_call: PragmaStmt = PRAGMA ws n:col_id ws "(" ws a:func_arg_list ws ")" -> new PragmaStmt{Name: $n, Args: $a, Call: true}
def pragma_set: PragmaStmt = PRAGMA ws n:col_id ws op_eq ws v:expr_list -> new PragmaStmt{Name: $n, Values: $v}
def pragma_plain: PragmaStmt = PRAGMA ws n:col_id -> new PragmaStmt{Name: $n}

def var_name: Name = first:col_id rest:(-ws -"." -ws c:col_id)* -> new Name{Parts: concat(list($first), map($rest, (r) => $r.c))}
def set_scope = LOCAL / SESSION / GLOBAL / VARIABLE
def set_stmt: SetStmt = set_scoped / set_unscoped
def set_scoped: SetStmt = SET ws sc:set_scope ws
    ( n:var_name ws (TO / op_eq) ws v:expr_list / n:var_name ws fc:@(FROM ws CURRENT) / TIME ws ZONE ws z:zone_value / SCHEMA ws s:sconst )
    -> new SetStmt{Scope: text($sc), Name: $n, Values: concat($v), TimeZone: text($z), FromCurrent: len($fc) > 0, Schema: $s}
def set_unscoped: SetStmt = SET ws
    ( n:var_name ws (TO / op_eq) ws v:expr_list / n:var_name ws fc:@(FROM ws CURRENT) / TIME ws ZONE ws z:zone_value / SCHEMA ws s:sconst )
    -> new SetStmt{Name: $n, Values: concat($v), TimeZone: text($z), FromCurrent: len($fc) > 0, Schema: $s}
def zone_value: Match = @(sconst / ident_only / INTERVAL ws sconst (ws interval_unit)? / INTERVAL ws "(" ws iconst ws ")" ws sconst / numeric_only / DEFAULT / LOCAL)

def reset_stmt: ResetStmt = reset_scoped / reset_unscoped
def reset_scoped: ResetStmt = RESET ws sc:set_scope ws ( a:ALL / sp:@(TIME ws ZONE / TRANSACTION ws ISOLATION ws LEVEL) / n:var_name )
    -> new ResetStmt{Scope: text($sc), Name: $n, All: len($a) > 0, Special: text($sp)}
def reset_unscoped: ResetStmt = RESET ws ( a:ALL / sp:@(TIME ws ZONE / TRANSACTION ws ISOLATION ws LEVEL) / n:var_name )
    -> new ResetStmt{Name: $n, All: len($a) > 0, Special: text($sp)}

def show_stmt: ShowStmt = show_query / summarize_query / summarize_table / show_tables / show_time_zone / show_isolation / show_all / show_name / show_bare
def show_word = SHOW / DESCRIBE / DESC
def show_query: ShowStmt = k:show_word ws q:select_stmt -> new ShowStmt{Kind: text($k), Query: $q}
def summarize_query: ShowStmt = k:SUMMARIZE ws q:select_stmt -> new ShowStmt{Kind: text($k), Query: $q}
def summarize_table: ShowStmt = k:SUMMARIZE ws n:qualified_name -> new ShowStmt{Kind: text($k), Name: $n}
def show_tables: ShowStmt = k:show_word ws TABLES ws FROM ws n:qualified_name -> new ShowStmt{Kind: text($k), Tables: true, From: $n}
def show_time_zone: ShowStmt = k:show_word ws s:@(TIME ws ZONE) -> new ShowStmt{Kind: text($k), Special: text($s)}
def show_isolation: ShowStmt = k:show_word ws s:@(TRANSACTION ws ISOLATION ws LEVEL) -> new ShowStmt{Kind: text($k), Special: text($s)}
def show_all: ShowStmt = k:show_word ws ALL (ws t:TABLES)? -> new ShowStmt{Kind: text($k), All: true, Tables: len($t) > 0}
def show_name: ShowStmt = k:show_word ws n:qualified_name -> new ShowStmt{Kind: text($k), Name: $n}
def show_bare: ShowStmt = k:show_word -> new ShowStmt{Kind: text($k)}

// ---- EXPLAIN, PREPARE, EXECUTE ----

def explain_stmt: ExplainStmt = explain_options / explain_analyze / explain_verbose / explain_plain
def explain_options: ExplainStmt = EXPLAIN ws "(" ws os:explain_option_list ws ")" ws s:explainable -> new ExplainStmt{Options: $os, Stmt: $s}
def explain_analyze: ExplainStmt = EXPLAIN ws a:(ANALYZE / ANALYSE) (ws v:VERBOSE)? ws s:explainable -> new ExplainStmt{Analyze: text($a), Verbose: len($v) > 0, Stmt: $s}
def explain_verbose: ExplainStmt = EXPLAIN ws VERBOSE ws s:explainable -> new ExplainStmt{Verbose: true, Stmt: $s}
def explain_plain: ExplainStmt = EXPLAIN ws s:explainable -> new ExplainStmt{Stmt: $s}
def explain_option_list: []ExplainOption = first:explain_option rest:(-ws -"," -ws o:explain_option)* -> concat(list($first), map($rest, (r) => $r.o))
def explain_option: ExplainOption = n:@(non_reserved_word / ANALYZE / ANALYSE) (ws v:@(TRUE / FALSE / ON / non_reserved_word / sconst / numeric_only))? -> new ExplainOption{Name: text($n), Value: text($v)}
// ExplainableStmt: everything but EXPLAIN, ANALYZE, USE, ATTACH, DETACH, EXPORT, IMPORT, COMMENT, DROP SECRET, CREATE SECRET...
def explainable: Statement = alter_table_stmt / alter_sequence_stmt / alter_object_schema_stmt / rename_stmt / call_stmt / checkpoint_stmt / copy_stmt
    / create_table_stmt / create_table_as_stmt / create_macro_stmt / create_schema_stmt / create_sequence_stmt / create_type_stmt / create_index_stmt / create_view_stmt
    / deallocate_stmt / delete_stmt / drop_stmt / execute_stmt / insert_stmt / load_stmt / merge_stmt / pragma_stmt / prepare_stmt / select_stmt / truncate_stmt
    / transaction_stmt / update_stmt / update_extensions_stmt / vacuum_stmt / reset_stmt / set_stmt / show_stmt

def prepare_stmt: PrepareStmt = PREPARE ws n:name (ws "(" ws ts:type_list ws ")")? ws AS ws s:preparable -> new PrepareStmt{Name: $n, Types: concat($ts), Stmt: $s}
def preparable: Statement = select_stmt / insert_stmt / update_stmt / copy_stmt / delete_stmt / show_stmt / truncate_stmt
def execute_stmt: ExecuteStmt = EXECUTE ws n:name (ws "(" ws ps:execute_params ws ")")? -> new ExecuteStmt{Name: $n, Params: concat($ps)}
def execute_params: []Expr = first:execute_param rest:(-ws -"," -ws p:execute_param)* -> concat(list($first), map($rest, (r) => $r.p))
def execute_param: Expr = named_arg / expr
def deallocate_stmt: DeallocateStmt = deallocate_prepare / deallocate_plain
def deallocate_prepare: DeallocateStmt = DEALLOCATE ws PREPARE ws (a:ALL / n:name) -> new DeallocateStmt{Name: $n, All: len($a) > 0}
def deallocate_plain: DeallocateStmt = DEALLOCATE ws (a:ALL / n:name) -> new DeallocateStmt{Name: $n, All: len($a) > 0}

// ---- Transactions, maintenance, ... ----

def transaction_stmt: TransactionStmt = tx_start / tx_end
def tx_start: TransactionStmt = k:(BEGIN / START) (ws w:(WORK / TRANSACTION))? (ws m:@(READ ws (ONLY / WRITE)))? -> new TransactionStmt{Kind: text($k), Work: text($w), Mode: text($m)}
def tx_end: TransactionStmt = k:(ABORT / COMMIT / END / ROLLBACK) (ws w:(WORK / TRANSACTION))? -> new TransactionStmt{Kind: text($k), Work: text($w)}

def vacuum_stmt: VacuumStmt = vacuum_options / vacuum_plain
def vacuum_options: VacuumStmt = VACUUM ws "(" ws os:vacuum_option_list ws ")" (ws t:qualified_name (ws "(" ws cs:name_list_opt_comma ws ")")?)? -> new VacuumStmt{Options: $os, Table: $t, Columns: concat($cs)}
def vacuum_option_list: []Match = first:vacuum_option rest:(-ws -"," -ws o:vacuum_option)* -> concat(list($first), map($rest, (r) => $r.o))
def vacuum_option: Match = @(ANALYZE / ANALYSE / VERBOSE / FREEZE / FULL / ident_only)
def vacuum_plain: VacuumStmt = VACUUM (ws f:FULL)? (ws fr:FREEZE)? (ws v:VERBOSE)? (ws (a:analyze_stmt / t:qualified_name (ws "(" ws cs:name_list_opt_comma ws ")")?))?
    -> new VacuumStmt{Full: len($f) > 0, Freeze: len($fr) > 0, Verbose: len($v) > 0, Analyze: $a, Table: $t, Columns: concat($cs)}
def analyze_stmt: AnalyzeStmt = (ANALYZE / ANALYSE) (ws v:VERBOSE)? (ws t:qualified_name (ws "(" ws cs:name_list_opt_comma ws ")")?)? -> new AnalyzeStmt{Verbose: len($v) > 0, Table: $t, Columns: concat($cs)}
def checkpoint_stmt: CheckpointStmt = (f:FORCE ws)? CHECKPOINT (ws d:col_id)? -> new CheckpointStmt{Force: len($f) > 0, Database: $d}
def call_stmt: CallStmt = CALL ws f:func_call -> new CallStmt{Func: $f}
def comment_stmt: CommentStmt = comment_column / comment_object
def comment_column: CommentStmt = k:@(COMMENT ws ON ws COLUMN) ws c:c_expr ws IS ws v:comment_value -> new CommentStmt{Object: text($k), Column: $c, Comment: $v}
def comment_object: CommentStmt = COMMENT ws ON ws k:@(TABLE / SEQUENCE / FUNCTION / MACRO (ws TABLE)? / VIEW / DATABASE / INDEX / SCHEMA / TYPE) ws n:qualified_name ws IS ws v:comment_value
    -> new CommentStmt{Object: text($k), Name: $n, Comment: $v}
def comment_value: StringLit = sconst / null_text
def null_text: StringLit = NULL
def update_extensions_stmt: UpdateExtensionsStmt = (w:with_clause ws)? UPDATE ws EXTENSIONS (ws "(" ws ns:column_list ws ")")? -> new UpdateExtensionsStmt{With: $w, Names: concat($ns)}

// ===================================================================================================
// Scripts
// ===================================================================================================

def stmt_end = ws (";" / $$)

def main: Script = ws (";" ws)* first:statement{0,1} rest:(-ws -";" -ws (-";" -ws)* s:statement)* ws (";" ws)* $$
    -> new Script{Statements: concat($first, map($rest, (r) => $r.s))}

def statement: Statement =
      select_stmt / insert_stmt / update_stmt / delete_stmt / merge_stmt
    / create_table_stmt / create_table_as_stmt / create_view_stmt / create_index_stmt / create_schema_stmt / create_sequence_stmt / create_type_stmt / create_macro_stmt / create_secret_stmt
    / drop_secret_stmt / drop_stmt / alter_table_stmt / alter_sequence_stmt / alter_database_stmt / alter_object_schema_stmt / rename_stmt
    / copy_stmt / export_stmt / import_stmt / attach_stmt / detach_stmt / use_stmt / load_stmt
    / set_stmt / reset_stmt / pragma_stmt / show_stmt / explain_stmt / prepare_stmt / execute_stmt / deallocate_stmt
    / transaction_stmt / vacuum_stmt / analyze_stmt / checkpoint_stmt / call_stmt / comment_stmt / update_extensions_stmt / truncate_stmt

// BEGIN GENERATED KEYWORDS (internal/refgen/keywords.py; do not edit)

// The keywords are matched without regard to ASCII case, and only as whole words.

def ABORT = (?aA) (?bB) (?oO) (?rR) (?tT) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ACCESS = (?aA) (?cC) (?cC) (?eE) (?sS) (?sS) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ACTION = (?aA) (?cC) (?tT) (?iI) (?oO) (?nN) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ADD = (?aA) (?dD) (?dD) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ALL = (?aA) (?lL) (?lL) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ALTER = (?aA) (?lL) (?tT) (?eE) (?rR) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ALWAYS = (?aA) (?lL) (?wW) (?aA) (?yY) (?sS) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ANALYSE = (?aA) (?nN) (?aA) (?lL) (?yY) (?sS) (?eE) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ANALYZE = (?aA) (?nN) (?aA) (?lL) (?yY) (?zZ) (?eE) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def AND = (?aA) (?nN) (?dD) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ANTI = (?aA) (?nN) (?tT) (?iI) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ANY = (?aA) (?nN) (?yY) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ARRAY = (?aA) (?rR) (?rR) (?aA) (?yY) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def AS = (?aA) (?sS) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ASC = (?aA) (?sS) (?cC) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ASOF = (?aA) (?sS) (?oO) (?fF) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ASYMMETRIC = (?aA) (?sS) (?yY) (?mM) (?mM) (?eE) (?tT) (?rR) (?iI) (?cC) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def AT = (?aA) (?tT) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def ATTACH = (?aA) (?tT) (?tT) (?aA) (?cC) (?hH) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BEGIN = (?bB) (?eE) (?gG) (?iI) (?nN) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BETWEEN = (?bB) (?eE) (?tT) (?wW) (?eE) (?eE) (?nN) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BIGINT = (?bB) (?iI) (?gG) (?iI) (?nN) (?tT) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BINARY = (?bB) (?iI) (?nN) (?aA) (?rR) (?yY) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BIT = (?bB) (?iI) (?tT) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BOOLEAN = (?bB) (?oO) (?oO) (?lL) (?eE) (?aA) (?nN) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BOTH = (?bB) (?oO) (?tT) (?hH) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def BY = (?bB) (?yY) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

def CACHE = (?cC) (?aA) (?cC) (?hH) (?eE) !(?a-zA-Z0-9_$\u{80}-\u{9f}\u{a1}-\u{1fff}\u{200c}-\u{202e}\u{2030}-\u{205e}\u{2061}-\u{2fff}\u{3001}-\u{fefe}\u{ff00}-\u{10ffff})

