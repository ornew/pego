// Go source files (The Go Programming Language Specification), parsed as go/parser parses them:
// the grammar accepts exactly the files go/parser accepts and builds the same tree as go/ast. Where
// go/parser accepts more than the specification (types where expressions are expected, x.(type)
// outside type switches, any simple statement as a for post statement, and so on), so does the
// grammar; the type checker rejects those programs, not the parser.
//
// Tokens and automatic semicolons
//
// Rules neither start nor end with whitespace: the caller skips what may come between two tokens.
// After a token that ends a statement at a newline (an identifier, a literal, break, continue,
// fallthrough, return, ++, --, ")", "]" or "}"), the caller skips sp, which stops at a newline; after
// any other token it skips ws, which does not. Where a statement may end, semi matches the semicolon
// that follows: ";", a newline, a block comment that contains a newline, or the end of the file.
//
// Choices that commit
//
// go/parser decides by the next token and does not backtrack: once it sees "[" after a type name, it
// parses type arguments, and a failure there is an error. The grammar mirrors each such decision
// with a negative lookahead (`!(-sp "[")` after a type name that has no type arguments, for
// example), so that a failed alternative never falls back to a shorter one that go/parser would not
// have chosen.
//
// Composite literals and control clauses
//
// In the header of an if, for or switch statement, a composite literal whose type is a name
// (T{}, p.T{}, T[int]{}) must be parenthesized, since its "{" would begin the block. The
// expressions of headers therefore have rules of their own (hexpr and the rules it calls, prefixed
// with h), which take a "{" as the end of the expression; brackets, parentheses and braces inside a
// header switch back to the ordinary rules, as they do in go/parser.
package golang

// ===================================================================
// Types
// ===================================================================

type File = { Name Ident; Decls []Decl }

// --- Declarations ---
type GenDecl = { Tok string; Specs []Spec } // Tok is "import", "const", "type" or "var"
type FuncDecl = { Recv *FieldList; Name Ident; Type FuncType; Body *BlockStmt }
type ImportSpec = { Name *Ident; Path StringLit } // Name is a package name, "_" or "."
type ValueSpec = { Names []Ident; Type *Expr; Values []Expr }
type TypeSpec = { Name Ident; TypeParams *FieldList; Assign *node[string]; Type Expr } // Assign is the "=" of an alias
type Decl ~ GenDecl | FuncDecl
type Spec ~ ImportSpec | ValueSpec | TypeSpec

// A list of parameters, results, type parameters, struct fields or interface elements. Its range
// covers the parentheses, brackets or braces, if any.
type FieldList = { List []Field }
type Field = { Names []Ident; Type Expr; Tag *StringLit }

// --- Expressions and types ---
type Ident = node[string]
type IntLit = node[string]
type FloatLit = node[string]
type ImagLit = node[string]
type CharLit = node[string]
type StringLit = node[string]                   // including the quotes
type Ellipsis = { Elt *Expr }                   // ...T in a parameter list, or the length of [...]T (no Elt)
type CompositeLit = { Type *Expr; Elts []Expr } // Type is nil in an elided literal {...}
type FuncLit = { Type FuncType; Body BlockStmt }
type ParenExpr = { X Expr }
type SelectorExpr = { X Expr; Sel Ident }
type IndexExpr = { X Expr; Index Expr }
type IndexListExpr = { X Expr; Indices []Expr }
type SliceExpr = { X Expr; Low *Expr; High *Expr; Max *Expr }
type TypeAssertExpr = { X Expr; Type *Expr }                      // Type is nil in x.(type)
type CallExpr = { Fun Expr; Args []Expr; Ellipsis *node[string] } // Ellipsis is the "..." of f(s...)
type StarExpr = { X Expr }
type UnaryExpr = { Op string; X Expr }
type BinaryExpr = { X Expr; Op string; Y Expr }
type KeyValueExpr = { Key Expr; Value Expr }
type ArrayType = { Len *Expr; Elt Expr } // Len is nil for a slice type and an Ellipsis for [...]T
type StructType = { Fields FieldList }
type FuncType = { TypeParams *FieldList; Params FieldList; Results *FieldList }
type InterfaceType = { Methods FieldList }
type MapType = { Key Expr; Value Expr }
type ChanType = { Dir int; Value Expr } // Dir is 1 (chan<-), 2 (<-chan) or 3 (chan), as go/ast.ChanDir
type Expr ~ Ident | IntLit | FloatLit | ImagLit | CharLit | StringLit | Ellipsis | CompositeLit | FuncLit | ParenExpr | SelectorExpr | IndexExpr | IndexListExpr | SliceExpr | TypeAssertExpr | CallExpr | StarExpr | UnaryExpr | BinaryExpr | KeyValueExpr | ArrayType | StructType | FuncType | InterfaceType | MapType | ChanType

// --- Statements ---
type DeclStmt = { Decl GenDecl }
type EmptyStmt = {} // an explicit ";", or an empty statement before "}" after a label (empty range)
type LabeledStmt = { Label Ident; Stmt Stmt }
type ExprStmt = { X Expr }
type SendStmt = { Chan Expr; Value Expr }
type IncDecStmt = { X Expr; Tok string }
type AssignStmt = { Lhs []Expr; Tok string; Rhs []Expr }
type GoStmt = { Call CallExpr }
type DeferStmt = { Call CallExpr }
type ReturnStmt = { Results []Expr }
type BranchStmt = { Tok string; Label *Ident }
type BlockStmt = { List []Stmt }
type IfStmt = { Init *Stmt; Cond Expr; Body BlockStmt; Else *Stmt }
type CaseClause = { List []Expr; Body []Stmt }              // List is empty for default
type SwitchStmt = { Init *Stmt; Tag *Expr; Body BlockStmt } // the body lists CaseClauses
type TypeSwitchStmt = { Init *Stmt; Assign Stmt; Body BlockStmt }
type CommClause = { Comm *Stmt; Body []Stmt } // Comm is nil for default
type SelectStmt = { Body BlockStmt }          // the body lists CommClauses
type ForStmt = { Init *Stmt; Cond *Expr; Post *Stmt; Body BlockStmt }
type RangeStmt = { Key *Expr; Value *Expr; Tok string; X Expr; Body BlockStmt } // Tok is "" in for range x
type Stmt ~ DeclStmt | EmptyStmt | LabeledStmt | ExprStmt | SendStmt | IncDecStmt | AssignStmt | GoStmt | DeferStmt | ReturnStmt | BranchStmt | BlockStmt | IfStmt | CaseClause | SwitchStmt | TypeSwitchStmt | CommClause | SelectStmt | ForStmt | RangeStmt

// ===================================================================
// Source files
// ===================================================================

// A byte order mark is allowed only as the first character. Imports come before the other
// declarations; each declaration ends with a semicolon.
@start
rule main File = (
    -"\u{feff}"? -ws kw_package -ws n:ident -sp -semi -ws
    is:(d:importDecl -sp -semi -ws)* ds:(d:topDecl -sp -semi -ws)* $$
) => File{Name: $n, Decls: concat(map($is, (x) => x.$d), map($ds, (x) => x.$d))}

rule topDecl Decl = funcDecl / constDecl / varDecl / typeDecl

// ===================================================================
// Declarations
// ===================================================================

rule importDecl GenDecl = kw_import -ws ss:(importGroup / importOne) => GenDecl{Tok: "import", Specs: $ss}
rule importOne = s:importSpec => list($s)
rule importGroup = "(" -ws ss:(s:importSpec -sp -groupTerm -ws)* ")" => map($ss, (x) => x.$s)
rule importSpec ImportSpec = n:importName? p:stringLit => ImportSpec{Name: $n, Path: $p}
rule importName Ident = i:ident -sp / i:dotName -ws => $i
rule dotName Ident = ("." !"..") #atomic

rule constDecl GenDecl = kw_const -ws ss:(constGroup / constOne) => GenDecl{Tok: "const", Specs: $ss}
rule constOne = s:constSpec => list($s)
rule constGroup = "(" -ws ss:(s:constSpec -sp -groupTerm -ws)* ")" => map($ss, (x) => x.$s)
// The type and the values of a constant are optional (go/parser leaves the checks to the type
// checker).
rule constSpec ValueSpec = ns:identList t:typeSp? vs:valuesSp? => ValueSpec{Names: $ns, Type: $t, Values: concat($vs)}
rule typeSp Expr = -sp t:typ => $t
rule identList = first:ident rest:(-sp "," -ws n:ident)* => concat(list($first), map($rest, (r) => r.$n))
rule valuesSp = -sp "=" !"=" -ws vs:exprList => $vs

rule varDecl GenDecl = kw_var -ws ss:(varGroup / varOne) => GenDecl{Tok: "var", Specs: $ss}
rule varOne = s:varSpec => list($s)
rule varGroup = "(" -ws ss:(s:varSpec -sp -groupTerm -ws)* ")" => map($ss, (x) => x.$s)
rule varSpec ValueSpec = varSpecTyped / varSpecUntyped
rule varSpecTyped ValueSpec = ns:identList -sp t:typ vs:valuesSp? => ValueSpec{Names: $ns, Type: $t, Values: concat($vs)}
rule varSpecUntyped ValueSpec = ns:identList -sp "=" !"=" -ws vs:exprList => ValueSpec{Names: $ns, Values: $vs}

rule typeDecl GenDecl = kw_type -ws ss:(typeGroup / typeOne) => GenDecl{Tok: "type", Specs: $ss}
rule typeOne = s:typeSpec => list($s)
rule typeGroup = "(" -ws ss:(s:typeSpec -sp -groupTerm -ws)* ")" => map($ss, (x) => x.$s)

// A type specification is generic or an array type when "[" follows the name. go/parser decides it
// as follows (parseTypeSpec), and so does the grammar:
//   - "[" P "[" ...: type parameters (genericParams with a constraint that starts with "[").
//   - "[" P x where P x cannot continue as an expression (P any, P ~int, P, Q any): type parameters.
//   - "[" P *E "," / "[" P(E) ","...: type parameters, and so are P *E and P(E) before "]" when E
//     (or a term of a following "|" union) is a type literal or ~T and therefore no expression
//     (splitDecision).
//   - otherwise an array type whose length is the expression.
rule typeSpec TypeSpec = typeSpecGeneric / typeSpecArray / typeSpecPlain
rule typeSpecGeneric TypeSpec = (
    n:ident -sp tp:genericParams -sp a:aliasEq? t:typ
) => TypeSpec{Name: $n, TypeParams: $tp, Assign: $a, Type: $t}
rule typeSpecArray TypeSpec = n:ident -sp !genericStart t:arrayType => TypeSpec{Name: $n, Type: $t}
rule typeSpecPlain TypeSpec = n:ident -sp !"[" a:aliasEq? t:typ => TypeSpec{Name: $n, Assign: $a, Type: $t}
rule aliasEq node[string] = e:("=" !"=") #atomic -ws => $e

rule genericStart = "[" -ws ident -sp "[" / generalStart / "[" -ws splitDecision
rule generalStart = "[" -ws ident -sp !("]" / binaryOp / dot / "(" / "{" / "[")
rule genericParams FieldList = &("[" -ws ident -sp "[") p:typeParams / &generalStart p:typeParams / p:splitParams => $p

// The first type parameter is P *E or P(E), possibly followed by "|" terms (go/parser's extractName).
rule splitParams FieldList = (
    &("[" -ws splitDecision) "[" -ws p:ident -sp t:splitType
    rest:(-sp "," -ws g:typeParam)* -sp ("," -ws)? "]"
) => FieldList{List: concat(list(Field{Names: list($p), Type: $t}), map($rest, (r) => r.$g))}
rule splitType Expr = (
    h:splitHead rest:(-sp "|" ![|=] -ws t:mulExpr)*
) => foldl($h, $rest, (acc, i) => BinaryExpr{X: acc, Op: "|", Y: i.$t})
rule splitHead Expr = splitStar / splitParen
rule splitStar StarExpr = "*" !"=" -ws u:unaryExpr => StarExpr{X: $u}
rule splitParen ParenExpr = "(" -ws a:expr -sp ("," -ws)? ")" !(-sp [.\[(]) => ParenExpr{X: $a}

// P *E or P(E) is a type parameter if a "," follows, or if E or a "|" term is a type element.
rule splitDecision = (
    ident -sp splitHeadShape (-sp "|" ![|=] -ws mulExpr)* -sp ","
    / ident -sp splitHeadTE (-sp "|" ![|=] -ws mulExpr)* -sp "]"
    / ident -sp splitHeadShape (-sp "|" ![|=] -ws !termTE mulExpr)* -sp "|" ![|=] -ws termTE
      (-sp "|" ![|=] -ws mulExpr)* -sp "]"
)
rule splitHeadShape = "*" !"=" -ws unaryExpr / "(" -ws expr -sp ("," -ws)? ")" !(-sp [.\[(])
rule splitHeadTE = (
    "*" !"=" -ws &unaryTE unaryExpr
    / "(" -ws &exprTE expr -sp ("," -ws)? ")" !(-sp [.\[(])
)

// Type elements (go/parser's isTypeElem): a unary expression that is a type literal, ~x or a
// parenthesized type element, and a binary expression with such an operand.
rule unaryTE = (
    "~" -ws unaryExpr
    / recvChanType
    / (arrayType / structType / funcType / mapType) !(-sp [.\[({])
    / (interfaceType / chanType) !(-sp [.\[(])
    / "(" -ws exprTE -sp ")" !(-sp [.\[(])
)
rule exprTE = (!unaryTE unaryExpr -sp binaryOp -ws)* unaryTE (-sp binaryOp -ws unaryExpr)*
rule termTE = (!unaryTE unaryExpr -sp mulOp -ws)* unaryTE (-sp mulOp -ws unaryExpr)*

rule funcDecl FuncDecl = (
    kw_func -ws r:recvSp? n:ident tp:typeParamsSp? -sp ps:params rs:resultsSp?
    ({$rs != nil} / !(-sp typeStart)) b:bodySp?
) => FuncDecl{Recv: $r, Name: $n, Type: FuncType{TypeParams: $tp, Params: $ps, Results: $rs}, Body: $b}
rule recvSp FieldList = r:params -sp => $r
rule typeParamsSp FieldList = -sp t:typeParams => $t
rule bodySp BlockStmt = -sp b:block => $b

// ===================================================================
// Parameters
// ===================================================================

// A parameter list is either all named (a, b int, c ...string) or all unnamed (int, ...string),
// as go/parser's parseParameterList decides. Only the last parameter may be variadic.
rule params FieldList = "(" -ws l:paramList? ")" => FieldList{List: concat($l)}
rule paramList = namedParams / unnamedParams
rule namedParams = (
    first:paramGroup rest:(-sp "," -ws g:paramGroup)* -sp ("," -ws)?
) => concat(list($first), map($rest, (r) => r.$g))
rule paramGroup Field = g:variadicGroup &(-sp ("," -ws)? ")") / g:namedGroup => $g
rule variadicGroup Field = n:ident -sp t:variadicType => Field{Names: list($n), Type: $t}
rule namedGroup Field = ns:identList -sp t:namedParamType => Field{Names: $ns, Type: $t}
rule namedParamType Expr = t:arrayFieldType / !"[" !"..." t:typ => $t
rule variadicType Ellipsis = "..." -ws t:typ => Ellipsis{Elt: $t}
rule unnamedParams = (
    first:unnamedParam rest:(-sp "," -ws p:unnamedParam)* -sp ("," -ws)?
) => concat(list($first), map($rest, (r) => r.$p))
rule unnamedParam Field = t:variadicType &(-sp ("," -ws)? ")") / t:unnamedType => Field{Type: $t}
// An unnamed parameter that starts with a name: a type name, or an instance whose arguments are
// expressions (go/parser's parseArrayFieldOrTypeInstance).
rule unnamedType Expr = t:identIndexList / t:identIndex / t:qualifiedIdent !(-sp ("[" / dot)) / t:qualifiedInstance / !ident t:typ => $t

// Results: a parameter list without "...", or a single type.
rule resultsSp FieldList = -sp r:results => $r
rule results FieldList = resultParams / resultType
rule resultType FieldList = t:typ => FieldList{List: list(Field{Type: $t})}
rule resultParams FieldList = "(" -ws l:resultList? ")" => FieldList{List: concat($l)}
rule resultList = namedResults / unnamedResults
rule namedResults = (
    first:namedGroup rest:(-sp "," -ws g:namedGroup)* -sp ("," -ws)?
) => concat(list($first), map($rest, (r) => r.$g))
rule unnamedResults = (
    first:unnamedResult rest:(-sp "," -ws p:unnamedResult)* -sp ("," -ws)?
) => concat(list($first), map($rest, (r) => r.$p))
rule unnamedResult Field = t:unnamedType => Field{Type: $t}

// Type parameters: [K comparable, V any], [S ~[]E, E any], [T ~int | ~string].
rule typeParams FieldList = (
    "[" -ws first:typeParam rest:(-sp "," -ws g:typeParam)* -sp ("," -ws)? "]"
) => FieldList{List: concat(list($first), map($rest, (r) => r.$g))}
rule typeParam Field = ns:identList -sp c:constraint => Field{Names: $ns, Type: $c}
rule constraint Expr = (
    first:constraintFirst rest:(-sp "|" ![|=] -ws t:embeddedTerm)*
) => foldl($first, $rest, (acc, i) => BinaryExpr{X: acc, Op: "|", Y: i.$t})
rule constraintFirst Expr = t:tildeTerm / t:arrayFieldType / !"[" !"..." t:typ => $t
rule embeddedTerm Expr = tildeTerm / typ
rule tildeTerm UnaryExpr = "~" -ws t:typ => UnaryExpr{Op: "~", X: $t}

// x []E and x [N]E after a parameter or field name (parseArrayFieldOrTypeInstance): the length is an
// expression, so [...]E is an error here.
rule arrayFieldType ArrayType = "[" -ws n:exprSp? "]" -sp t:typ => ArrayType{Len: $n, Elt: $t}
rule exprSp Expr = x:expr -sp => $x

// x[A] and x[A, B] where the arguments are expressions.
rule identIndex IndexExpr = x:ident -sp "[" -ws i:expr -sp ("," -ws)? "]" => IndexExpr{X: $x, Index: $i}
rule identIndexList IndexListExpr = (
    x:ident -sp "[" -ws first:expr rest:(-sp "," -ws e:expr)+ -sp ("," -ws)? "]"
) => IndexListExpr{X: $x, Indices: concat(list($first), map($rest, (r) => r.$e))}

// ===================================================================
// Types
// ===================================================================

rule typ Expr = typeGuard (t:typeName / t:arrayType / t:structType / t:pointerType / t:funcType / t:interfaceType / t:mapType / t:chanType / t:parenType) => $t
// As operandGuard, for types.
rule typeGuard = &[a-zA-Z_\[*<(\u{80}-\u{10ffff}] / _|_ @error(message="expected type")
// The tokens with which a type can start.
rule typeStart = ident / "[" / kw_struct / "*" !"=" / kw_func / kw_interface / kw_map / kw_chan / "<-" / "("

rule parenType ParenExpr = "(" -ws t:typ -sp ")" => ParenExpr{X: $t}
rule pointerType StarExpr = "*" !"=" -ws t:typ => StarExpr{X: $t}

// T, p.T, T[A], p.T[A, B]: type arguments are types here.
rule typeName Expr = t:qualifiedInstance / t:qualifiedIdent !(-sp "[") => $t
rule qualifiedInstance Expr = typeInstanceList / typeInstance
rule typeInstance IndexExpr = x:qualifiedIdent -sp "[" -ws t:typ -sp ("," -ws)? "]" => IndexExpr{X: $x, Index: $t}
rule typeInstanceList IndexListExpr = (
    x:qualifiedIdent -sp "[" -ws first:typ rest:(-sp "," -ws t:typ)+ -sp ("," -ws)? "]"
) => IndexListExpr{X: $x, Indices: concat(list($first), map($rest, (r) => r.$t))}
rule qualifiedIdent Expr = t:selectorIdent / t:ident !(-sp "." !"..") => $t
rule selectorIdent SelectorExpr = x:ident -sp "." !".." -ws s:ident => SelectorExpr{X: $x, Sel: $s}

// [N]T, []T and [...]T. The length is any expression.
rule arrayType ArrayType = "[" -ws n:arrayLen? "]" -sp t:typ => ArrayType{Len: $n, Elt: $t}
rule arrayLen Expr = x:ellipsisLen -ws / x:expr -sp => $x
rule ellipsisLen Ellipsis = "..." => Ellipsis{}

rule mapType MapType = kw_map -ws "[" -ws k:typ -sp "]" -sp v:typ => MapType{Key: $k, Value: $v}

// "<-" binds to the leftmost "chan": chan<- chan int is chan<- (chan int).
rule chanType ChanType = sendChanType / bothChanType / recvChanTypeT
rule sendChanType ChanType = kw_chan -ws "<-" -ws t:typ => ChanType{Dir: 1, Value: $t}
rule bothChanType ChanType = kw_chan -ws !"<-" t:typ => ChanType{Dir: 3, Value: $t}
rule recvChanTypeT ChanType = "<-" -ws kw_chan -ws t:typ => ChanType{Dir: 2, Value: $t}

// Type parameters are an error in a function type (go/parser accepts and complains), so there are
// none. A type that follows the parameters on the same line must be the result.
rule funcType FuncType = (
    kw_func -ws ps:params rs:resultsSp? ({$rs != nil} / !(-sp typeStart))
) => FuncType{Params: $ps, Results: $rs}

rule structType StructType = kw_struct -ws l:fieldBlock => StructType{Fields: $l}
rule fieldBlock FieldList = "{" -ws fs:(f:fieldDecl -sp -fieldTerm -ws)* "}" => FieldList{List: map($fs, (x) => x.$f)}
// go/parser's parseFieldDecl: a name followed by ".", a tag or the end of the field is an embedded
// type; one name followed by "[" begins an array type or an embedded instance.
rule fieldDecl Field = embeddedField / starField / multiNameField / arrayNameField / oneNameField / instanceField
rule embeddedField Field = &(ident -sp (dot / "\"" / "`" / semi / "}")) t:typeName g:tagSp? => Field{Type: $t, Tag: $g}
rule starField Field = t:starEmbedded g:tagSp? => Field{Type: $t, Tag: $g}
rule starEmbedded StarExpr = "*" !"=" -ws t:typeName => StarExpr{X: $t}
rule multiNameField Field = (
    first:ident rest:(-sp "," -ws n:ident)+ -sp t:typ g:tagSp?
) => Field{Names: concat(list($first), map($rest, (r) => r.$n)), Type: $t, Tag: $g}
rule arrayNameField Field = n:ident -sp t:arrayFieldType g:tagSp? => Field{Names: list($n), Type: $t, Tag: $g}
rule oneNameField Field = n:ident -sp !"[" t:typ g:tagSp? => Field{Names: list($n), Type: $t, Tag: $g}
rule instanceField Field = t:(identIndexList / identIndex) g:tagSp? => Field{Type: $t, Tag: $g}
rule tagSp StringLit = -sp s:stringLit => $s

rule interfaceType InterfaceType = kw_interface -ws l:methodBlock => InterfaceType{Methods: $l}
rule methodBlock FieldList = "{" -ws es:(e:interfaceElem -sp -fieldTerm -ws)* "}" => FieldList{List: map($es, (x) => x.$e)}
rule interfaceElem Field = methodSpec / embeddedElem
rule methodSpec Field = n:ident -sp t:signature => Field{Names: list($n), Type: $t}
rule signature FuncType = ps:params rs:resultsSp? ({$rs != nil} / !(-sp typeStart)) => FuncType{Params: $ps, Results: $rs}
// An embedded element: T, p.T, T[A], ~T, and unions of them. The first argument of T[...] is
// parsed as an expression (go/parser's parseMethodSpec).
rule embeddedElem Field = (
    first:embeddedFirst rest:(-sp "|" ![|=] -ws t:embeddedTerm)*
) => Field{Type: foldl($first, $rest, (acc, i) => BinaryExpr{X: acc, Op: "|", Y: i.$t})}
rule embeddedFirst Expr = embeddedIndexList / embeddedIndex / embeddedTerm
rule embeddedIndex IndexExpr = x:ident -sp "[" -ws i:expr -sp ("," -ws)? "]" => IndexExpr{X: $x, Index: $i}
rule embeddedIndexList IndexListExpr = (
    x:ident -sp "[" -ws first:expr rest:(-sp "," -ws t:typ)+ -sp ("," -ws)? "]"
) => IndexListExpr{X: $x, Indices: concat(list($first), map($rest, (r) => r.$t))}

// ===================================================================
// Statements
// ===================================================================

rule block BlockStmt = "{" -ws ss:(s:stmt -ws)* "}" => BlockStmt{List: map($ss, (x) => x.$s)}

// A statement and its semicolon. A label and an empty statement need none.
rule stmt Stmt = emptyStmt / labeledEmpty / terminatedStmt
rule terminatedStmt Stmt = s:(labeledStmt / plainStmt) -sp -stmtTerm => $s
rule emptyStmt EmptyStmt = ";" => EmptyStmt{}
rule implicitEmpty EmptyStmt = &"}" => EmptyStmt{}
// A label followed by "}" labels an empty statement (with an empty range).
rule labeledEmpty LabeledStmt = (
    l:ident -sp ":" !"=" -ws s:(implicitEmpty / emptyStmt / labeledEmpty)
) => LabeledStmt{Label: $l, Stmt: $s}
rule labeledStmt LabeledStmt = l:ident -sp ":" !"=" -ws s:(labeledStmt / plainStmt) => LabeledStmt{Label: $l, Stmt: $s}

// The statements of a case clause. The semicolon after the last one is left to the caller, so that
// the clause ends with its last statement.
rule clauseBody = ss:(-ws s:clauseStmt)* l:lastClauseStmt? => concat(map($ss, (x) => x.$s), $l)
// A statement followed by another one.
rule clauseStmt Stmt = s:(emptyStmt / labeledEmpty / clauseTerminated) &(-ws !clauseEnd) => $s
rule clauseTerminated Stmt = s:(labeledStmt / plainStmt) -sp -stmtTerm => $s
// The last statement, whose semicolon is not consumed.
rule lastClauseStmt = -ws s:(emptyStmt / labeledEmpty / lastClauseTerminated) => list($s)
rule lastClauseTerminated Stmt = s:(labeledStmt / plainStmt) &(-sp stmtTerm) => $s
rule clauseEnd = kw_case / kw_default / "}"

// go/parser starts a simple statement only at the tokens that start an expression, which "~" does not.
// (The lookahead for a keyword spares the other statements the expectations of the keywords, which
// cost more than the lookahead.)
rule plainStmt Stmt = &keyword s:(declStmt / goStmt / deferStmt / returnStmt / branchStmt / ifStmt / switchStmt / selectStmt / forStmt) / s:block / !"~" s:simpleStmt => $s

rule declStmt DeclStmt = d:(constDecl / varDecl / typeDecl) => DeclStmt{Decl: $d}

// (Trying the expression statement first, since most statements are calls, was not faster.)
rule simpleStmt Stmt = assignStmt / sendStmt / incDecStmt / exprStmt
rule assignStmt AssignStmt = l:exprList -sp t:assignOp -ws r:exprList => AssignStmt{Lhs: $l, Tok: text($t), Rhs: $r}
rule sendStmt SendStmt = c:expr -sp "<-" -ws v:expr => SendStmt{Chan: $c, Value: $v}
rule incDecStmt IncDecStmt = x:expr -sp t:incDecOp => IncDecStmt{X: $x, Tok: text($t)}
rule exprStmt ExprStmt = x:expr => ExprStmt{X: $x}

// The same in the header of an if, for or switch statement.
rule hsimpleStmt Stmt = hassignStmt / hsendStmt / hincDecStmt / hexprStmt
rule hassignStmt AssignStmt = l:hexprList -sp t:assignOp -ws r:hexprList => AssignStmt{Lhs: $l, Tok: text($t), Rhs: $r}
rule hsendStmt SendStmt = c:hexpr -sp "<-" -ws v:hexpr => SendStmt{Chan: $c, Value: $v}
rule hincDecStmt IncDecStmt = x:hexpr -sp t:incDecOp => IncDecStmt{X: $x, Tok: text($t)}
rule hexprStmt ExprStmt = x:hexpr => ExprStmt{X: $x}

// The expression of go and defer must be a call that is not parenthesized: the operand of the
// last call is parsed by goPrimary, which does not apply a call that ends the statement.
rule goStmt GoStmt = kw_go -ws c:goCall => GoStmt{Call: $c}
rule deferStmt DeferStmt = kw_defer -ws c:goCall => DeferStmt{Call: $c}
rule goCall CallExpr = goCallEmpty / goCallArgs
rule goCallEmpty CallExpr = f:goPrimary -sp "(" -ws ")" => CallExpr{Fun: $f}
rule goCallArgs CallExpr = (
    f:goPrimary -sp "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")"
) => CallExpr{Fun: $f, Args: $as, Ellipsis: $e}
rule dotsWs node[string] = d:"..." #atomic -ws => $d

rule returnStmt ReturnStmt = kw_return xs:returnValues? => ReturnStmt{Results: concat($xs)}
rule returnValues = -sp xs:exprList => $xs

rule branchStmt BranchStmt = breakStmt / continueStmt / gotoStmt / fallthroughStmt
rule breakStmt BranchStmt = kw_break l:labelSp? => BranchStmt{Tok: "break", Label: $l}
rule continueStmt BranchStmt = kw_continue l:labelSp? => BranchStmt{Tok: "continue", Label: $l}
rule gotoStmt BranchStmt = kw_goto -ws l:ident => BranchStmt{Tok: "goto", Label: $l}
rule fallthroughStmt BranchStmt = kw_fallthrough => BranchStmt{Tok: "fallthrough"}
rule labelSp Ident = -sp l:ident => $l

// if [init;] cond {...} [else ...]. The semicolon after init may be a newline.
rule ifStmt IfStmt = (
    kw_if -ws (i:hsimpleSemi / -";" -ws)? c:hexpr -sp b:block e:elseSp?
) => IfStmt{Init: $i, Cond: $c, Body: $b, Else: $e}
rule hsimpleSemi Stmt = s:hsimpleStmt -sp -hsemi -ws => $s
rule elseSp Stmt = -sp kw_else -ws s:(ifStmt / block) => $s

rule switchStmt Stmt = typeSwitchStmt / exprSwitchStmt
rule switchInit = s:hsimpleStmt? -sp -hsemi -ws => $s
rule exprSwitchStmt SwitchStmt = (
    kw_switch -ws i:switchInit? t:hexpr? -sp b:caseBlock
) => SwitchStmt{Init: $i, Tag: $t, Body: $b}
rule typeSwitchStmt TypeSwitchStmt = (
    kw_switch -ws i:switchInit? g:typeSwitchGuard -sp b:caseBlock
) => TypeSwitchStmt{Init: $i, Assign: $g, Body: $b}
// x.(type) or v := x.(type), where x is parsed by guardPrimary, which does not apply the .(type)
// before "{".
rule typeSwitchGuard Stmt = guardAssign / guardExpr
rule guardAssign AssignStmt = l:hexpr -sp ":=" -ws x:guardAssert => AssignStmt{Lhs: list($l), Tok: ":=", Rhs: list($x)}
rule guardExpr ExprStmt = x:guardAssert => ExprStmt{X: $x}
rule guardAssert TypeAssertExpr = x:guardPrimary -sp dot -ws "(" -ws kw_type -ws ")" => TypeAssertExpr{X: $x}
rule caseBlock BlockStmt = "{" -ws cs:(c:caseClause (-sp -stmtTerm)? -ws)* "}" => BlockStmt{List: map($cs, (x) => x.$c)}
rule caseClause CaseClause = caseClauseList / caseClauseDefault
rule caseClauseList CaseClause = kw_case -ws xs:exprList -sp ":" !"=" b:clauseBody => CaseClause{List: $xs, Body: $b}
rule caseClauseDefault CaseClause = kw_default -ws ":" !"=" b:clauseBody => CaseClause{Body: $b}

rule selectStmt SelectStmt = kw_select -ws b:commBlock => SelectStmt{Body: $b}
rule commBlock BlockStmt = "{" -ws cs:(c:commClause (-sp -stmtTerm)? -ws)* "}" => BlockStmt{List: map($cs, (x) => x.$c)}
rule commClause CommClause = commClauseCase / commClauseDefault
rule commClauseCase CommClause = kw_case -ws c:commStmt -sp ":" !"=" b:clauseBody => CommClause{Comm: $c, Body: $b}
rule commClauseDefault CommClause = kw_default -ws ":" !"=" b:clauseBody => CommClause{Body: $b}
// go/parser does not check that a communication receives or sends.
rule commStmt Stmt = sendStmt / commRecv / exprStmt
rule commRecv AssignStmt = (
    first:expr rest:(-sp "," -ws x:expr) #repeat(,1) -sp t:(":=" / "=" !"=") #atomic -ws r:expr
) => AssignStmt{Lhs: concat(list($first), map($rest, (q) => q.$x)), Tok: text($t), Rhs: list($r)}

rule forStmt Stmt = forInfinite / forRange / forClause / forCond
rule forInfinite ForStmt = kw_for -ws b:block => ForStmt{Body: $b}
rule forCond ForStmt = kw_for -ws c:hexpr -sp b:block => ForStmt{Cond: $c, Body: $b}
// The semicolons may be newlines.
rule forClause ForStmt = (
    kw_for -ws i:hsimpleStmt? -sp -hsemi -ws c:hexpr? -sp -hsemi -ws p:hsimpleStmt? -sp b:block
) => ForStmt{Init: $i, Cond: $c, Post: $p, Body: $b}
rule forRange RangeStmt = (
    kw_for -ws (k:hexpr v:rangeValue? -sp t:(":=" / "=" !"=") #atomic -ws)? kw_range -ws x:hexpr -sp b:block
) => RangeStmt{Key: $k, Value: $v, Tok: text($t), X: $x, Body: $b}
rule rangeValue Expr = -sp "," -ws v:hexpr => $v

// ===================================================================
// Expressions
// ===================================================================

// Most expressions have no binary operator: a unary expression that no operator follows is the
// expression, without the five rules of the precedence levels (about 15% of the time of a parse).
rule expr Expr = x:unaryExpr !(-sp binaryOp) / x:orExpr => $x
rule exprList = first:expr rest:(-sp "," -ws x:expr)* => concat(list($first), map($rest, (r) => r.$x))

rule orExpr Expr = (
    l:andExpr rest:(-sp o:orOp -ws r:andExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule andExpr Expr = (
    l:cmpExpr rest:(-sp o:andOp -ws r:cmpExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule cmpExpr Expr = (
    l:addExpr rest:(-sp o:relOp -ws r:addExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule addExpr Expr = (
    l:mulExpr rest:(-sp o:addOp -ws r:mulExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule mulExpr Expr = (
    l:unaryExpr rest:(-sp o:mulOp -ws r:unaryExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})

// <-chan T is a channel type, not a receive; go/parser reassociates the arrow when the operand of
// "<-" is a channel type, which yields the type <-chan T or an error.
rule unaryExpr Expr = &[<+\-!\^&~*] u:(recvChanType / recvExpr / unaryOpExpr / starExpr) / u:primaryExpr => $u
rule recvChanType ChanType = t:recvChanTypeT !(-sp [.\[(]) => $t
rule recvExpr UnaryExpr = "<-" -ws !(chanType !(-sp [.\[(])) x:unaryExpr => UnaryExpr{Op: "<-", X: $x}
rule unaryOpExpr UnaryExpr = o:unaryOp -ws x:unaryExpr => UnaryExpr{Op: text($o), X: $x}
rule starExpr StarExpr = "*" !"=" -ws x:unaryExpr => StarExpr{X: $x}

// Primary expressions: an operand and selectors, indexes, slices, type assertions, calls and
// composite literals. Outside headers, a "{" after an operand is a composite literal, which
// go/parser allows only after a name, a selector, an index or an array, struct or map type: the
// other operands and suffixes do not match before a "{" (any "{" after them would be an error).
rule primaryExpr Expr = o:primaryOperand !(-sp [.\[({]) / o:operatorsExpr => $o
rule operatorsExpr Expr = #operators {
    skip sp
    operand primaryOperand
    level {
        postfix dot -ws s:ident => SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" !(-sp "{") => TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" !(-sp "{") => TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" => IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" => IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" !(-sp "{") => SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]" !(-sp "{") => SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" !(-sp "{") => CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" !(-sp "{") => CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
        postfix v:litValue !(-sp "{") => CompositeLit{Type: $lhs, Elts: $v}
    }
}
// A name, an array, struct or map type may be followed by a composite literal value.
rule primaryOperand Expr = operandGuard (o:ident / o:literalOperand !(-sp "{") / o:arrayType / o:structType / o:mapType) => $o
// An expression is often tried where none is (an optional one, or a list that ends): where no
// operand can start, the guard records one message instead of the sixteen tokens that can begin
// an operand, which every expression memoized there would merge again (about a fifth of the
// time of a parse).
rule operandGuard = &[a-zA-Z_0-9.'"`(\[<\u{80}-\u{10ffff}] / _|_ @error(message="expected operand")
rule literalOperand Expr = basicLit / parenExpr / funcLit / funcType / chanType / interfaceType
rule indexList = first:expr rest:(-sp "," -ws t:typ)+ -sp ("," -ws)? => concat(list($first), map($rest, (r) => r.$t))

rule parenExpr ParenExpr = "(" -ws x:expr -sp ")" => ParenExpr{X: $x}
rule funcLit FuncLit = t:funcType -sp b:block => FuncLit{Type: $t, Body: $b}

rule litValue = "{" -ws es:elements? "}" => concat($es)
rule elements = first:element rest:(-sp "," -ws e:element)* -sp ("," -ws)? => concat(list($first), map($rest, (r) => r.$e))
rule element Expr = keyValue / elementValue
rule keyValue KeyValueExpr = k:elementValue -sp ":" !"=" -ws v:elementValue => KeyValueExpr{Key: $k, Value: $v}
rule elementValue Expr = elidedLit / expr
rule elidedLit CompositeLit = v:litValue => CompositeLit{Elts: $v}

// go and defer: the same, except that a call followed by the end of the statement is not applied.
rule goPrimary Expr = #operators {
    skip sp
    operand primaryOperand
    level {
        postfix dot -ws s:ident => SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" !(-sp "{") => TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" !(-sp "{") => TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" => IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" => IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" !(-sp "{") => SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]" !(-sp "{") => SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" !(-sp ("{" / goEnd)) => CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" !(-sp ("{" / goEnd)) => CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
        postfix v:litValue !(-sp "{") => CompositeLit{Type: $lhs, Elts: $v}
    }
}
rule goEnd = semi / "}" / ")"

// ===================================================================
// Expressions in headers
// ===================================================================

rule hexpr Expr = x:hunaryExpr !(-sp binaryOp) / x:horExpr => $x
rule hexprList = first:hexpr rest:(-sp "," -ws x:hexpr)* => concat(list($first), map($rest, (r) => r.$x))

rule horExpr Expr = (
    l:handExpr rest:(-sp o:orOp -ws r:handExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule handExpr Expr = (
    l:hcmpExpr rest:(-sp o:andOp -ws r:hcmpExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule hcmpExpr Expr = (
    l:haddExpr rest:(-sp o:relOp -ws r:haddExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule haddExpr Expr = (
    l:hmulExpr rest:(-sp o:addOp -ws r:hmulExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})
rule hmulExpr Expr = (
    l:hunaryExpr rest:(-sp o:mulOp -ws r:hunaryExpr)*
) => foldl($l, $rest, (acc, i) => BinaryExpr{X: acc, Op: text(i.$o), Y: i.$r})

rule hunaryExpr Expr = &[<+\-!\^&~*] u:(recvChanType / hrecvExpr / hunaryOpExpr / hstarExpr) / u:hprimaryExpr => $u
rule hrecvExpr UnaryExpr = "<-" -ws !(chanType !(-sp [.\[(])) x:hunaryExpr => UnaryExpr{Op: "<-", X: $x}
rule hunaryOpExpr UnaryExpr = o:unaryOp -ws x:hunaryExpr => UnaryExpr{Op: text($o), X: $x}
rule hstarExpr StarExpr = "*" !"=" -ws x:hunaryExpr => StarExpr{X: $x}

// Only array, struct and map types take a composite literal here. A parenthesized one followed by
// "{" is an error in go/parser, not the end of the header.
rule hprimaryExpr Expr = o:hoperand !(-sp [.\[(]) / o:hoperatorsExpr => $o
rule hoperatorsExpr Expr = #operators {
    skip sp
    operand hoperand
    level {
        postfix dot -ws s:ident => SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" => TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" => TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" => IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" => IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" => SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]" => SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" => CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" => CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
    }
}
rule hoperand Expr = operandGuard (o:ident / o:basicLit / !(parenCompositeType -sp "{") o:parenExpr / o:funcLit / o:funcType / o:compositeLitH / o:arrayType !(-sp "{") / o:structType !(-sp "{") / o:mapType !(-sp "{") / o:chanType / o:interfaceType) => $o
rule compositeLitH CompositeLit = t:(arrayType / structType / mapType) -sp v:litValue => CompositeLit{Type: $t, Elts: $v}
rule parenCompositeType = "(" -ws (parenCompositeType / arrayType / structType / mapType) -sp ")"

// The type switch guard: the same, except that .(type) before "{" is not applied.
rule guardPrimary Expr = #operators {
    skip sp
    operand hoperand
    level {
        postfix dot -ws s:ident => SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" !(-sp "{") => TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" => TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" => IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" => IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" => SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]" => SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" => CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" => CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
    }
}

// ===================================================================
// Operators
// ===================================================================

// Each operator must not be the beginning of a longer token.
rule dot = "." !".."
// An operator is tried after every operand, mostly where none follows: the lookahead for its first
// character keeps those failures out of the expectations of syntax errors, which go/parser does not
// report either, and recording them was about a third of the time of a parse.
rule binaryOp = &[|&=!<>+\-\^*/%] (orOp / andOp / relOp / addOp / mulOp)
rule orOp = &"|" "||" #atomic
rule andOp = &"&" "&&" #atomic
rule relOp = &[=!<>] ("==" / "!=" / "<=" / ">=" / "<" ![<\-] / ">" !">") #atomic
rule addOp = &[+\-|\^] ("+" ![+=] / "-" ![\-=] / "|" ![|=] / "^" !"=") #atomic
rule mulOp = &[*/%<>&] ("*" !"=" / "/" ![/*=] / "%" !"=" / "<<" !"=" / ">>" !"=" / "&^" !"=" / "&" ![&=\^]) #atomic
rule unaryOp = &[+\-!\^&~] ("+" ![+=] / "-" ![\-=] / "!" !"=" / "^" !"=" / "&" ![&=\^] / "~") #atomic
rule assignOp = &[=:+\-*/%&|\^<>] ("=" !"=" / ":=" / "+=" / "-=" / "*=" / "/=" / "%=" / "&=" / "|=" / "^=" / "<<=" / ">>=" / "&^=") #atomic
rule incDecOp = &[+\-] ("++" / "--") #atomic

// ===================================================================
// Semicolons and whitespace
// ===================================================================

// A semicolon after a token that ends a statement at a newline, once sp has been skipped: ";", a
// newline, a block comment with a newline in it, or the end of the file.
rule semi = ";" / "\n" / blockComment / $$
// Where the semicolon may be left out: before "}" (statements, fields) and ")" (grouped specs).
rule stmtTerm = semi / &"}"
rule fieldTerm = semi / &"}"
rule groupTerm = semi / &")"
// The semicolons of headers, which go/parser does not let the end of the file or "}" replace.
rule hsemi = ";" / "\n" / blockComment

// sp: spaces and comments that do not end the line. ws: all whitespace and comments.
//
// They are called at almost every position, often several times: they call no other rule, so that
// the parser does not memoize them (which took a tenth of the time of a parse), and they spell out
// the comments by hand: blockComment below is what the block comments in them match, with the line
// directives of dirBlock expanded in place. For a //line comment the same checks apply to the end
// of the line instead of "*/", where a final "\r" of a "\r\n" line end is not part of the directive
// (the tests compare every case with go/scanner). A //line directive must start a line, which a
// comment that sp reads never does (sp follows a token on the same line). The lookaheads keep the
// expectations of whitespace, which is optional everywhere, out of syntax errors.
rule sp = (&[ \t\r/] ([ \t\r] (&[ \t\r] [ \t\r])* / "//" ([^\n\u{0}\u{feff}�]+ / c1:"�" {text($c1) == "�"})* / !("/*" (!"*/" [^\n])* "\n") "/*" ("line " (([^:*\u{0}\u{feff}�]+ / "*" !"/" / c2:"�" {text($c2) == "�"})* &"*/" / (!(":" ([^:*]+ / "*" !"/")* ":" ([^:*]+ / "*" !"/")* "*/") ([^*\u{0}\u{feff}�] / "*" !"/" / c3:"�" {text($c3) == "�"}))* ":" ("0"* n1:([1-9] [0-9]*) #atomic &":" {len($n1) < 10 || len($n1) == 10 && text($n1) <= "1073741824" || len($n1) == 19 && text($n1) >= "9223372036854775808" || len($n1) == 20 && text($n1) <= "18446744073709551615"} / "0"* n2:([1-9] [0-9]*) #atomic &":" {len($n2) > 20 || len($n2) == 20 && text($n2) > "18446744073709551615"} / !([0-9]+ ":") ([^:*\u{0}\u{feff}�]+ / "*" !"/" / c4:"�" {text($c4) == "�"})*) ":" "0"* n3:([1-9] [0-9]*) #atomic &"*/" {len($n3) < 10 || len($n3) == 10 && text($n3) <= "1073741824" || len($n3) == 19 && text($n3) >= "9223372036854775808" || len($n3) == 20 && text($n3) <= "18446744073709551615"} / ([^:*\u{0}\u{feff}�]+ / "*" !"/" / c5:"�" {text($c5) == "�"})* ":" "0"* n4:([1-9] [0-9]*) #atomic &"*/" {len($n4) < 10 || len($n4) == 10 && text($n4) <= "1073741824" || len($n4) == 19 && text($n4) >= "9223372036854775808" || len($n4) == 20 && text($n4) <= "18446744073709551615"}) / !"line " ([^*\u{0}\u{feff}�]+ / "*" !"/" / c6:"�" {text($c6) == "�"})*) "*/"))*
rule ws = (&[ \t\r\n/] ([ \t\r\n] (&[ \t\r\n] [ \t\r\n])* / ^ "//line " (([^:\n\r\u{0}\u{feff}�]+ / "\r" !("\n" / $$) / c1:"�" {text($c1) == "�"})* "\r"? &("\n" / $$) / (!(":" ([^:\n\r]+ / "\r" !("\n" / $$))* ":" ([^:\n\r]+ / "\r" !("\n" / $$))* "\r"? &("\n" / $$)) ([^\n\u{0}\u{feff}�] / c2:"�" {text($c2) == "�"}))* ":" ("0"* n1:([1-9] [0-9]*) #atomic &":" {len($n1) < 10 || len($n1) == 10 && text($n1) <= "1073741824" || len($n1) == 19 && text($n1) >= "9223372036854775808" || len($n1) == 20 && text($n1) <= "18446744073709551615"} / "0"* n2:([1-9] [0-9]*) #atomic &":" {len($n2) > 20 || len($n2) == 20 && text($n2) > "18446744073709551615"} / !([0-9]+ ":") ([^:\n\r\u{0}\u{feff}�]+ / "\r" !("\n" / $$) / c3:"�" {text($c3) == "�"})*) ":" "0"* n3:([1-9] [0-9]*) #atomic "\r"? &("\n" / $$) {len($n3) < 10 || len($n3) == 10 && text($n3) <= "1073741824" || len($n3) == 19 && text($n3) >= "9223372036854775808" || len($n3) == 20 && text($n3) <= "18446744073709551615"} / ([^:\n\r\u{0}\u{feff}�]+ / "\r" !("\n" / $$) / c4:"�" {text($c4) == "�"})* ":" "0"* n4:([1-9] [0-9]*) #atomic "\r"? &("\n" / $$) {len($n4) < 10 || len($n4) == 10 && text($n4) <= "1073741824" || len($n4) == 19 && text($n4) >= "9223372036854775808" || len($n4) == 20 && text($n4) <= "18446744073709551615"}) / !(^ "//line ") "//" ([^\n\u{0}\u{feff}�]+ / c5:"�" {text($c5) == "�"})* / "/*" ("line " (([^:*\u{0}\u{feff}�]+ / "*" !"/" / c6:"�" {text($c6) == "�"})* &"*/" / (!(":" ([^:*]+ / "*" !"/")* ":" ([^:*]+ / "*" !"/")* "*/") ([^*\u{0}\u{feff}�] / "*" !"/" / c7:"�" {text($c7) == "�"}))* ":" ("0"* n5:([1-9] [0-9]*) #atomic &":" {len($n5) < 10 || len($n5) == 10 && text($n5) <= "1073741824" || len($n5) == 19 && text($n5) >= "9223372036854775808" || len($n5) == 20 && text($n5) <= "18446744073709551615"} / "0"* n6:([1-9] [0-9]*) #atomic &":" {len($n6) > 20 || len($n6) == 20 && text($n6) > "18446744073709551615"} / !([0-9]+ ":") ([^:*\u{0}\u{feff}�]+ / "*" !"/" / c8:"�" {text($c8) == "�"})*) ":" "0"* n7:([1-9] [0-9]*) #atomic &"*/" {len($n7) < 10 || len($n7) == 10 && text($n7) <= "1073741824" || len($n7) == 19 && text($n7) >= "9223372036854775808" || len($n7) == 20 && text($n7) <= "18446744073709551615"} / ([^:*\u{0}\u{feff}�]+ / "*" !"/" / c9:"�" {text($c9) == "�"})* ":" "0"* n8:([1-9] [0-9]*) #atomic &"*/" {len($n8) < 10 || len($n8) == 10 && text($n8) <= "1073741824" || len($n8) == 19 && text($n8) >= "9223372036854775808" || len($n8) == 20 && text($n8) <= "18446744073709551615"}) / !"line " ([^*\u{0}\u{feff}�]+ / "*" !"/" / c10:"�" {text($c10) == "�"})*) "*/"))*

// Comments must not contain NUL, a byte order mark or invalid UTF-8 (see validFFFD).
rule blockComment = "/*" ("line " dirBlock / !"line " blockText) "*/"
rule blockText = ([^*\u{0}\u{feff}�]+ / "*" !"/" / validFFFD)*
// U+FFFD is valid only if it is spelled out: invalid UTF-8 is read as U+FFFD too, but its text is
// the invalid byte (with the Bytes position unit; see the package documentation).
rule validFFFD = c:"�" {text($c) == "�"}

// Line directives: //line at the beginning of a line and /*line anywhere. go/scanner checks the
// numbers after the last one or two colons: the line (and the column, if both are numbers) must be
// between 1 and 2^30. Text without a colon is no directive.
rule dirBlock = (
    dirSegBlock &"*/"
    / (!(":" dirSegBlock ":" dirSegBlock "*/") dirCharBlock)* ":" dirMidBlock ":" dirNum &"*/"
    / dirSegBlock ":" dirNum &"*/"
)
rule dirCharBlock = [^*\u{0}\u{feff}�] / "*" !"/" / validFFFD
rule dirSegBlock = ([^:*\u{0}\u{feff}�]+ / "*" !"/" / validFFFD)*
rule dirMidBlock = dirNum &":" / !(dirUint &":") dirSegBlock
// A number from 1 to 2^30, or from 2^63 to 2^64-1: go/scanner converts the number to an int, and
// those that do not fit (on 64-bit platforms) become negative and pass its check.
rule dirNum = "0"* n:([1-9] [0-9]*) #atomic {len($n) < 10 || len($n) == 10 && text($n) <= "1073741824" || len($n) == 19 && text($n) >= "9223372036854775808" || len($n) == 20 && text($n) <= "18446744073709551615"}
// A number that strconv.ParseUint accepts (at most 2^64-1).
rule dirUint = &[0-9] "0"* n:([1-9] [0-9]*)? #atomic {len($n) < 20 || len($n) == 20 && text($n) <= "18446744073709551615"}

// ===================================================================
// Identifiers and keywords
// ===================================================================

// Letters and digits are those of Unicode (unicode.IsLetter, unicode.IsDigit), see uLetter and
// uDigit.
rule ident Ident = (!keyword idStart idRest) #atomic
rule idStart = [a-zA-Z_] / &[\u{80}-\u{10ffff}] uLetter
rule idRest = (&[a-zA-Z0-9_\u{80}-\u{10ffff}] ([a-zA-Z0-9_] (&[a-zA-Z0-9_] [a-zA-Z0-9_])* / uLetter / uDigit))*
// A keyword must not be followed by a letter or digit. (Any other non-ASCII character is an error
// anyway.)
rule idChar = [a-zA-Z0-9_\u{80}-\u{10ffff}]
rule keyword = ("break" / "case" / "chan" / "const" / "continue" / "default" / "defer" / "else" / "fallthrough" / "for" / "func" / "goto" / "go" / "if" / "import" / "interface" / "map" / "package" / "range" / "return" / "select" / "struct" / "switch" / "type" / "var") !idChar

rule kw_break = "break" !idChar
rule kw_case = "case" !idChar
rule kw_chan = "chan" !idChar
rule kw_const = "const" !idChar
rule kw_continue = "continue" !idChar
rule kw_default = "default" !idChar
rule kw_defer = "defer" !idChar
rule kw_else = "else" !idChar
rule kw_fallthrough = "fallthrough" !idChar
rule kw_for = "for" !idChar
rule kw_func = "func" !idChar
rule kw_go = "go" !idChar
rule kw_goto = "goto" !idChar
rule kw_if = "if" !idChar
rule kw_import = "import" !idChar
rule kw_interface = "interface" !idChar
rule kw_map = "map" !idChar
rule kw_package = "package" !idChar
rule kw_range = "range" !idChar
rule kw_return = "return" !idChar
rule kw_select = "select" !idChar
rule kw_struct = "struct" !idChar
rule kw_switch = "switch" !idChar
rule kw_type = "type" !idChar
rule kw_var = "var" !idChar

// ===================================================================
// Literals
// ===================================================================

rule basicLit Expr = imagLit / floatLit / intLit / charLit / stringLit

// Numbers: each form must not be followed by a character that go/scanner would read as part of the
// same literal (it would report an error), nor by a letter or digit (two literals, or a literal and
// a name, never follow each other).
rule intLit IntLit = (("0" [xX] "_"? hexDigits / "0" [oO] "_"? octDigits / "0" [bB] "_"? binDigits / "0" ("_"? [0-7])* / [1-9] ("_"? [0-9])*) ![0-9a-zA-Z_.]) #atomic
rule floatLit FloatLit = ((decimalFloat / hexFloat) ![0-9a-zA-Z_]) #atomic
rule imagLit ImagLit = ((decimalFloat "i" / hexFloat "i" / imagInt "i") ![0-9a-zA-Z_]) #atomic
// The integer part of an imaginary literal may hold digits invalid for its base (as go/scanner
// allows), and 0123i is decimal.
rule imagInt = "0" [xX] "_"? hexDigits / "0" [oObB] "_"? decDigits / decDigits
rule decimalFloat = decDigits "." decDigits? decimalExp? / decDigits decimalExp / "." decDigits decimalExp?
rule decimalExp = [eE] [+\-]? decDigits
rule hexFloat = "0" [xX] ("_"? hexDigits ("." hexDigits?)? / "." hexDigits) [pP] [+\-]? decDigits
rule decDigits = [0-9] ("_"? [0-9])*
rule hexDigits = [0-9a-fA-F] ("_"? [0-9a-fA-F])*
rule octDigits = [0-7] ("_"? [0-7])*
rule binDigits = [01] ("_"? [01])*

rule charLit CharLit = ("'" (charEscape / !['\\\n] srcChar) "'") #atomic
rule stringLit StringLit = ("`" (!"`" srcChar)* "`" / "\"" ([^"\\\n\u{0}\u{feff}�]+ / stringEscape / validFFFD)* "\"") #atomic
// A character of the source: not NUL, nor a byte order mark, nor invalid UTF-8.
rule srcChar = [^\u{0}\u{feff}�] / validFFFD
rule charEscape = "\\" ([abfnrtv\\'] / escapeValue)
rule stringEscape = "\\" ([abfnrtv\\"] / escapeValue)
// Octal escapes up to \377; \u and \U escapes of code points, not surrogate halves.
rule escapeValue = (
    [0-3] [0-7] [0-7] / "x" hexDigit hexDigit / "u" !([dD] [89a-fA-F]) hexDigit hexDigit hexDigit hexDigit
    / "U" "00" ("0" !("0" [dD] [89a-fA-F]) hexDigit hexDigit hexDigit hexDigit hexDigit / "10" hexDigit hexDigit hexDigit hexDigit)
)
rule hexDigit = [0-9a-fA-F]

