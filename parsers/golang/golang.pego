// Go source files (The Go Programming Language Specification), parsed as go/parser parses them:
// the grammar accepts exactly the files go/parser accepts and builds the same tree as go/ast. Where
// go/parser accepts more than the specification (types where expressions are expected, x.(type)
// outside type switches, any simple statement as a for post statement, and so on), so does the
// grammar; the type checker rejects those programs, not the parser.
//
// Tokens and automatic semicolons
//
// Rules neither start nor end with whitespace: the caller skips what may come between two tokens.
// After a token that ends a statement at a newline (an identifier, a literal, break, continue,
// fallthrough, return, ++, --, ")", "]" or "}"), the caller skips sp, which stops at a newline; after
// any other token it skips ws, which does not. Where a statement may end, semi matches the semicolon
// that follows: ";", a newline, a block comment that contains a newline, or the end of the file.
//
// Choices that commit
//
// go/parser decides by the next token and does not backtrack: once it sees "[" after a type name, it
// parses type arguments, and a failure there is an error. The grammar mirrors each such decision
// with a negative lookahead (`!(-sp "[")` after a type name that has no type arguments, for
// example), so that a failed alternative never falls back to a shorter one that go/parser would not
// have chosen.
//
// Composite literals and control clauses
//
// In the header of an if, for or switch statement, a composite literal whose type is a name
// (T{}, p.T{}, T[int]{}) must be parenthesized, since its "{" would begin the block. The
// expressions of headers therefore have rules of their own (hexpr and the rules it calls, prefixed
// with h), which take a "{" as the end of the expression; brackets, parentheses and braces inside a
// header switch back to the ordinary rules, as they do in go/parser.
package golang

// ===================================================================
// Types
// ===================================================================

type File struct { Name Ident, Decls []Decl }

// --- Declarations ---
type GenDecl struct { Tok string, Specs []Spec }  // Tok is "import", "const", "type" or "var"
type FuncDecl struct { Recv *FieldList, Name Ident, Type FuncType, Body *BlockStmt }
type ImportSpec struct { Name *Ident, Path StringLit }  // Name is a package name, "_" or "."
type ValueSpec struct { Names []Ident, Type *Expr, Values []Expr }
type TypeSpec struct { Name Ident, TypeParams *FieldList, Assign *Match, Type Expr }  // Assign is the "=" of an alias
type Decl = GenDecl | FuncDecl
type Spec = ImportSpec | ValueSpec | TypeSpec

// A list of parameters, results, type parameters, struct fields or interface elements. Its range
// covers the parentheses, brackets or braces, if any.
type FieldList struct { List []Field }
type Field struct { Names []Ident, Type Expr, Tag *StringLit }

// --- Expressions and types ---
type Ident terminal
type IntLit terminal
type FloatLit terminal
type ImagLit terminal
type CharLit terminal
type StringLit terminal  // including the quotes
type Ellipsis struct { Elt *Expr }  // ...T in a parameter list, or the length of [...]T (no Elt)
type CompositeLit struct { Type *Expr, Elts []Expr }  // Type is nil in an elided literal {...}
type FuncLit struct { Type FuncType, Body BlockStmt }
type ParenExpr struct { X Expr }
type SelectorExpr struct { X Expr, Sel Ident }
type IndexExpr struct { X Expr, Index Expr }
type IndexListExpr struct { X Expr, Indices []Expr }
type SliceExpr struct { X Expr, Low *Expr, High *Expr, Max *Expr }
type TypeAssertExpr struct { X Expr, Type *Expr }  // Type is nil in x.(type)
type CallExpr struct { Fun Expr, Args []Expr, Ellipsis *Match }  // Ellipsis is the "..." of f(s...)
type StarExpr struct { X Expr }
type UnaryExpr struct { Op string, X Expr }
type BinaryExpr struct { X Expr, Op string, Y Expr }
type KeyValueExpr struct { Key Expr, Value Expr }
type ArrayType struct { Len *Expr, Elt Expr }  // Len is nil for a slice type and an Ellipsis for [...]T
type StructType struct { Fields FieldList }
type FuncType struct { TypeParams *FieldList, Params FieldList, Results *FieldList }
type InterfaceType struct { Methods FieldList }
type MapType struct { Key Expr, Value Expr }
type ChanType struct { Dir int, Value Expr }  // Dir is 1 (chan<-), 2 (<-chan) or 3 (chan), as go/ast.ChanDir
type Expr = Ident | IntLit | FloatLit | ImagLit | CharLit | StringLit | Ellipsis | CompositeLit | FuncLit
    | ParenExpr | SelectorExpr | IndexExpr | IndexListExpr | SliceExpr | TypeAssertExpr | CallExpr
    | StarExpr | UnaryExpr | BinaryExpr | KeyValueExpr | ArrayType | StructType | FuncType
    | InterfaceType | MapType | ChanType

// --- Statements ---
type DeclStmt struct { Decl GenDecl }
type EmptyStmt struct {}  // an explicit ";", or an empty statement before "}" after a label (empty range)
type LabeledStmt struct { Label Ident, Stmt Stmt }
type ExprStmt struct { X Expr }
type SendStmt struct { Chan Expr, Value Expr }
type IncDecStmt struct { X Expr, Tok string }
type AssignStmt struct { Lhs []Expr, Tok string, Rhs []Expr }
type GoStmt struct { Call CallExpr }
type DeferStmt struct { Call CallExpr }
type ReturnStmt struct { Results []Expr }
type BranchStmt struct { Tok string, Label *Ident }
type BlockStmt struct { List []Stmt }
type IfStmt struct { Init *Stmt, Cond Expr, Body BlockStmt, Else *Stmt }
type CaseClause struct { List []Expr, Body []Stmt }  // List is empty for default
type SwitchStmt struct { Init *Stmt, Tag *Expr, Body BlockStmt }  // the body lists CaseClauses
type TypeSwitchStmt struct { Init *Stmt, Assign Stmt, Body BlockStmt }
type CommClause struct { Comm *Stmt, Body []Stmt }  // Comm is nil for default
type SelectStmt struct { Body BlockStmt }  // the body lists CommClauses
type ForStmt struct { Init *Stmt, Cond *Expr, Post *Stmt, Body BlockStmt }
type RangeStmt struct { Key *Expr, Value *Expr, Tok string, X Expr, Body BlockStmt }  // Tok is "" in for range x
type Stmt = DeclStmt | EmptyStmt | LabeledStmt | ExprStmt | SendStmt | IncDecStmt | AssignStmt | GoStmt
    | DeferStmt | ReturnStmt | BranchStmt | BlockStmt | IfStmt | CaseClause | SwitchStmt | TypeSwitchStmt
    | CommClause | SelectStmt | ForStmt | RangeStmt

// ===================================================================
// Source files
// ===================================================================

// A byte order mark is allowed only as the first character. Imports come before the other
// declarations; each declaration ends with a semicolon.
def main: File = -"\u{FEFF}"? -ws kw_package -ws n:ident -sp -semi -ws
    is:(d:importDecl -sp -semi -ws)* ds:(d:topDecl -sp -semi -ws)* $$
    -> new File{Name: $n, Decls: concat(map($is, (x) => $x.d), map($ds, (x) => $x.d))}

def topDecl: Decl = funcDecl / constDecl / varDecl / typeDecl

// ===================================================================
// Declarations
// ===================================================================

def importDecl: GenDecl = kw_import -ws ss:(importGroup / importOne) -> new GenDecl{Tok: "import", Specs: $ss}
def importOne = s:importSpec -> list($s)
def importGroup = "(" -ws ss:(s:importSpec -sp -groupTerm -ws)* ")" -> map($ss, (x) => $x.s)
def importSpec: ImportSpec = n:importName? p:stringLit -> new ImportSpec{Name: $n, Path: $p}
def importName: Ident = (i:ident -sp / i:dotName -ws) -> $i
def dotName: Ident = "." !".."

def constDecl: GenDecl = kw_const -ws ss:(constGroup / constOne) -> new GenDecl{Tok: "const", Specs: $ss}
def constOne = s:constSpec -> list($s)
def constGroup = "(" -ws ss:(s:constSpec -sp -groupTerm -ws)* ")" -> map($ss, (x) => $x.s)
// The type and the values of a constant are optional (go/parser leaves the checks to the type
// checker).
def constSpec: ValueSpec = ns:identList t:typeSp? vs:valuesSp? -> new ValueSpec{Names: $ns, Type: $t, Values: concat($vs)}
def typeSp: Expr = -sp t:typ -> $t
def identList = first:ident rest:(-sp "," -ws n:ident)* -> concat(list($first), map($rest, (r) => $r.n))
def valuesSp = -sp "=" !"=" -ws vs:exprList -> $vs

def varDecl: GenDecl = kw_var -ws ss:(varGroup / varOne) -> new GenDecl{Tok: "var", Specs: $ss}
def varOne = s:varSpec -> list($s)
def varGroup = "(" -ws ss:(s:varSpec -sp -groupTerm -ws)* ")" -> map($ss, (x) => $x.s)
def varSpec: ValueSpec = varSpecTyped / varSpecUntyped
def varSpecTyped: ValueSpec = ns:identList -sp t:typ vs:valuesSp? -> new ValueSpec{Names: $ns, Type: $t, Values: concat($vs)}
def varSpecUntyped: ValueSpec = ns:identList -sp "=" !"=" -ws vs:exprList -> new ValueSpec{Names: $ns, Values: $vs}

def typeDecl: GenDecl = kw_type -ws ss:(typeGroup / typeOne) -> new GenDecl{Tok: "type", Specs: $ss}
def typeOne = s:typeSpec -> list($s)
def typeGroup = "(" -ws ss:(s:typeSpec -sp -groupTerm -ws)* ")" -> map($ss, (x) => $x.s)

// A type specification is generic or an array type when "[" follows the name. go/parser decides it
// as follows (parseTypeSpec), and so does the grammar:
//   - "[" P "[" ...: type parameters (genericParams with a constraint that starts with "[").
//   - "[" P x where P x cannot continue as an expression (P any, P ~int, P, Q any): type parameters.
//   - "[" P *E "," / "[" P(E) ","...: type parameters, and so are P *E and P(E) before "]" when E
//     (or a term of a following "|" union) is a type literal or ~T and therefore no expression
//     (splitDecision).
//   - otherwise an array type whose length is the expression.
def typeSpec: TypeSpec = typeSpecGeneric / typeSpecArray / typeSpecPlain
def typeSpecGeneric: TypeSpec = n:ident -sp tp:genericParams -sp a:aliasEq? t:typ
    -> new TypeSpec{Name: $n, TypeParams: $tp, Assign: $a, Type: $t}
def typeSpecArray: TypeSpec = n:ident -sp !genericStart t:arrayType -> new TypeSpec{Name: $n, Type: $t}
def typeSpecPlain: TypeSpec = n:ident -sp !"[" a:aliasEq? t:typ -> new TypeSpec{Name: $n, Assign: $a, Type: $t}
def aliasEq: Match = e:@("=" !"=") -ws -> $e

def genericStart = "[" -ws ident -sp "[" / generalStart / "[" -ws splitDecision
def generalStart = "[" -ws ident -sp !("]" / binaryOp / dot / "(" / "{" / "[")
def genericParams: FieldList = (&("[" -ws ident -sp "[") p:typeParams / &generalStart p:typeParams / p:splitParams) -> $p

// The first type parameter is P *E or P(E), possibly followed by "|" terms (go/parser's extractName).
def splitParams: FieldList = &("[" -ws splitDecision) "[" -ws p:ident -sp t:splitType
    rest:(-sp "," -ws g:typeParam)* -sp ("," -ws)? "]"
    -> new FieldList{List: concat(list(new Field{Names: list($p), Type: $t}), map($rest, (r) => $r.g))}
def splitType: Expr = h:splitHead rest:(-sp "|" !(?|=) -ws t:mulExpr)*
    -> foldl($h, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: "|", Y: $i.t})
def splitHead: Expr = splitStar / splitParen
def splitStar: StarExpr = "*" !"=" -ws u:unaryExpr -> new StarExpr{X: $u}
def splitParen: ParenExpr = "(" -ws a:expr -sp ("," -ws)? ")" !(-sp (?.[()) -> new ParenExpr{X: $a}

// P *E or P(E) is a type parameter if a "," follows, or if E or a "|" term is a type element.
def splitDecision = ident -sp splitHeadShape (-sp "|" !(?|=) -ws mulExpr)* -sp ","
    / ident -sp splitHeadTE (-sp "|" !(?|=) -ws mulExpr)* -sp "]"
    / ident -sp splitHeadShape (-sp "|" !(?|=) -ws !termTE mulExpr)* -sp "|" !(?|=) -ws termTE
      (-sp "|" !(?|=) -ws mulExpr)* -sp "]"
def splitHeadShape = "*" !"=" -ws unaryExpr / "(" -ws expr -sp ("," -ws)? ")" !(-sp (?.[())
def splitHeadTE = "*" !"=" -ws &unaryTE unaryExpr
    / "(" -ws &exprTE expr -sp ("," -ws)? ")" !(-sp (?.[())

// Type elements (go/parser's isTypeElem): a unary expression that is a type literal, ~x or a
// parenthesized type element, and a binary expression with such an operand.
def unaryTE = "~" -ws unaryExpr
    / recvChanType
    / (arrayType / structType / funcType / mapType) !(-sp (?.[({))
    / (interfaceType / chanType) !(-sp (?.[())
    / "(" -ws exprTE -sp ")" !(-sp (?.[())
def exprTE = (!unaryTE unaryExpr -sp binaryOp -ws)* unaryTE (-sp binaryOp -ws unaryExpr)*
def termTE = (!unaryTE unaryExpr -sp mulOp -ws)* unaryTE (-sp mulOp -ws unaryExpr)*

def funcDecl: FuncDecl = kw_func -ws r:recvSp? n:ident tp:typeParamsSp? -sp ps:params rs:resultsSp?
    ([$rs != nil] / !(-sp typeStart)) b:bodySp?
    -> new FuncDecl{Recv: $r, Name: $n, Type: new FuncType{TypeParams: $tp, Params: $ps, Results: $rs}, Body: $b}
def recvSp: FieldList = r:params -sp -> $r
def typeParamsSp: FieldList = -sp t:typeParams -> $t
def bodySp: BlockStmt = -sp b:block -> $b

// ===================================================================
// Parameters
// ===================================================================

// A parameter list is either all named (a, b int, c ...string) or all unnamed (int, ...string),
// as go/parser's parseParameterList decides. Only the last parameter may be variadic.
def params: FieldList = "(" -ws l:paramList? ")" -> new FieldList{List: concat($l)}
def paramList = namedParams / unnamedParams
def namedParams = first:paramGroup rest:(-sp "," -ws g:paramGroup)* -sp ("," -ws)?
    -> concat(list($first), map($rest, (r) => $r.g))
def paramGroup: Field = (g:variadicGroup &(-sp ("," -ws)? ")") / g:namedGroup) -> $g
def variadicGroup: Field = n:ident -sp t:variadicType -> new Field{Names: list($n), Type: $t}
def namedGroup: Field = ns:identList -sp t:namedParamType -> new Field{Names: $ns, Type: $t}
def namedParamType: Expr = (t:arrayFieldType / !"[" !"..." t:typ) -> $t
def variadicType: Ellipsis = "..." -ws t:typ -> new Ellipsis{Elt: $t}
def unnamedParams = first:unnamedParam rest:(-sp "," -ws p:unnamedParam)* -sp ("," -ws)?
    -> concat(list($first), map($rest, (r) => $r.p))
def unnamedParam: Field = (t:variadicType &(-sp ("," -ws)? ")") / t:unnamedType) -> new Field{Type: $t}
// An unnamed parameter that starts with a name: a type name, or an instance whose arguments are
// expressions (go/parser's parseArrayFieldOrTypeInstance).
def unnamedType: Expr = (t:identIndexList / t:identIndex / t:qualifiedIdent !(-sp ("[" / dot)) / t:qualifiedInstance
    / !ident t:typ) -> $t

// Results: a parameter list without "...", or a single type.
def resultsSp: FieldList = -sp r:results -> $r
def results: FieldList = resultParams / resultType
def resultType: FieldList = t:typ -> new FieldList{List: list(new Field{Type: $t})}
def resultParams: FieldList = "(" -ws l:resultList? ")" -> new FieldList{List: concat($l)}
def resultList = namedResults / unnamedResults
def namedResults = first:namedGroup rest:(-sp "," -ws g:namedGroup)* -sp ("," -ws)?
    -> concat(list($first), map($rest, (r) => $r.g))
def unnamedResults = first:unnamedResult rest:(-sp "," -ws p:unnamedResult)* -sp ("," -ws)?
    -> concat(list($first), map($rest, (r) => $r.p))
def unnamedResult: Field = t:unnamedType -> new Field{Type: $t}

// Type parameters: [K comparable, V any], [S ~[]E, E any], [T ~int | ~string].
def typeParams: FieldList = "[" -ws first:typeParam rest:(-sp "," -ws g:typeParam)* -sp ("," -ws)? "]"
    -> new FieldList{List: concat(list($first), map($rest, (r) => $r.g))}
def typeParam: Field = ns:identList -sp c:constraint -> new Field{Names: $ns, Type: $c}
def constraint: Expr = first:constraintFirst rest:(-sp "|" !(?|=) -ws t:embeddedTerm)*
    -> foldl($first, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: "|", Y: $i.t})
def constraintFirst: Expr = (t:tildeTerm / t:arrayFieldType / !"[" !"..." t:typ) -> $t
def embeddedTerm: Expr = tildeTerm / typ
def tildeTerm: UnaryExpr = "~" -ws t:typ -> new UnaryExpr{Op: "~", X: $t}

// x []E and x [N]E after a parameter or field name (parseArrayFieldOrTypeInstance): the length is an
// expression, so [...]E is an error here.
def arrayFieldType: ArrayType = "[" -ws n:exprSp? "]" -sp t:typ -> new ArrayType{Len: $n, Elt: $t}
def exprSp: Expr = x:expr -sp -> $x

// x[A] and x[A, B] where the arguments are expressions.
def identIndex: IndexExpr = x:ident -sp "[" -ws i:expr -sp ("," -ws)? "]" -> new IndexExpr{X: $x, Index: $i}
def identIndexList: IndexListExpr = x:ident -sp "[" -ws first:expr rest:(-sp "," -ws e:expr)+ -sp ("," -ws)? "]"
    -> new IndexListExpr{X: $x, Indices: concat(list($first), map($rest, (r) => $r.e))}

// ===================================================================
// Types
// ===================================================================

def typ: Expr = typeGuard (t:typeName / t:arrayType / t:structType / t:pointerType / t:funcType / t:interfaceType
    / t:mapType / t:chanType / t:parenType) -> $t
// As operandGuard, for types.
def typeGuard = &(?a-zA-Z_[*<(\u{80}-\u{10FFFF}) / _|_ #error(message="expected type")
// The tokens with which a type can start.
def typeStart = ident / "[" / kw_struct / "*" !"=" / kw_func / kw_interface / kw_map / kw_chan / "<-" / "("

def parenType: ParenExpr = "(" -ws t:typ -sp ")" -> new ParenExpr{X: $t}
def pointerType: StarExpr = "*" !"=" -ws t:typ -> new StarExpr{X: $t}

// T, p.T, T[A], p.T[A, B]: type arguments are types here.
def typeName: Expr = (t:qualifiedInstance / t:qualifiedIdent !(-sp "[")) -> $t
def qualifiedInstance: Expr = typeInstanceList / typeInstance
def typeInstance: IndexExpr = x:qualifiedIdent -sp "[" -ws t:typ -sp ("," -ws)? "]" -> new IndexExpr{X: $x, Index: $t}
def typeInstanceList: IndexListExpr = x:qualifiedIdent -sp "[" -ws first:typ rest:(-sp "," -ws t:typ)+ -sp ("," -ws)? "]"
    -> new IndexListExpr{X: $x, Indices: concat(list($first), map($rest, (r) => $r.t))}
def qualifiedIdent: Expr = (t:selectorIdent / t:ident !(-sp "." !"..")) -> $t
def selectorIdent: SelectorExpr = x:ident -sp "." !".." -ws s:ident -> new SelectorExpr{X: $x, Sel: $s}

// [N]T, []T and [...]T. The length is any expression.
def arrayType: ArrayType = "[" -ws n:arrayLen? "]" -sp t:typ -> new ArrayType{Len: $n, Elt: $t}
def arrayLen: Expr = (x:ellipsisLen -ws / x:expr -sp) -> $x
def ellipsisLen: Ellipsis = "..." -> new Ellipsis{}

def mapType: MapType = kw_map -ws "[" -ws k:typ -sp "]" -sp v:typ -> new MapType{Key: $k, Value: $v}

// "<-" binds to the leftmost "chan": chan<- chan int is chan<- (chan int).
def chanType: ChanType = sendChanType / bothChanType / recvChanTypeT
def sendChanType: ChanType = kw_chan -ws "<-" -ws t:typ -> new ChanType{Dir: 1, Value: $t}
def bothChanType: ChanType = kw_chan -ws !"<-" t:typ -> new ChanType{Dir: 3, Value: $t}
def recvChanTypeT: ChanType = "<-" -ws kw_chan -ws t:typ -> new ChanType{Dir: 2, Value: $t}

// Type parameters are an error in a function type (go/parser accepts and complains), so there are
// none. A type that follows the parameters on the same line must be the result.
def funcType: FuncType = kw_func -ws ps:params rs:resultsSp? ([$rs != nil] / !(-sp typeStart))
    -> new FuncType{Params: $ps, Results: $rs}

def structType: StructType = kw_struct -ws l:fieldBlock -> new StructType{Fields: $l}
def fieldBlock: FieldList = "{" -ws fs:(f:fieldDecl -sp -fieldTerm -ws)* "}" -> new FieldList{List: map($fs, (x) => $x.f)}
// go/parser's parseFieldDecl: a name followed by ".", a tag or the end of the field is an embedded
// type; one name followed by "[" begins an array type or an embedded instance.
def fieldDecl: Field = embeddedField / starField / multiNameField / arrayNameField / oneNameField / instanceField
def embeddedField: Field = &(ident -sp (dot / "\"" / "`" / semi / "}")) t:typeName g:tagSp? -> new Field{Type: $t, Tag: $g}
def starField: Field = t:starEmbedded g:tagSp? -> new Field{Type: $t, Tag: $g}
def starEmbedded: StarExpr = "*" !"=" -ws t:typeName -> new StarExpr{X: $t}
def multiNameField: Field = first:ident rest:(-sp "," -ws n:ident)+ -sp t:typ g:tagSp?
    -> new Field{Names: concat(list($first), map($rest, (r) => $r.n)), Type: $t, Tag: $g}
def arrayNameField: Field = n:ident -sp t:arrayFieldType g:tagSp? -> new Field{Names: list($n), Type: $t, Tag: $g}
def oneNameField: Field = n:ident -sp !"[" t:typ g:tagSp? -> new Field{Names: list($n), Type: $t, Tag: $g}
def instanceField: Field = t:(identIndexList / identIndex) g:tagSp? -> new Field{Type: $t, Tag: $g}
def tagSp: StringLit = -sp s:stringLit -> $s

def interfaceType: InterfaceType = kw_interface -ws l:methodBlock -> new InterfaceType{Methods: $l}
def methodBlock: FieldList = "{" -ws es:(e:interfaceElem -sp -fieldTerm -ws)* "}" -> new FieldList{List: map($es, (x) => $x.e)}
def interfaceElem: Field = methodSpec / embeddedElem
def methodSpec: Field = n:ident -sp t:signature -> new Field{Names: list($n), Type: $t}
def signature: FuncType = ps:params rs:resultsSp? ([$rs != nil] / !(-sp typeStart)) -> new FuncType{Params: $ps, Results: $rs}
// An embedded element: T, p.T, T[A], ~T, and unions of them. The first argument of T[...] is
// parsed as an expression (go/parser's parseMethodSpec).
def embeddedElem: Field = first:embeddedFirst rest:(-sp "|" !(?|=) -ws t:embeddedTerm)*
    -> new Field{Type: foldl($first, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: "|", Y: $i.t})}
def embeddedFirst: Expr = embeddedIndexList / embeddedIndex / embeddedTerm
def embeddedIndex: IndexExpr = x:ident -sp "[" -ws i:expr -sp ("," -ws)? "]" -> new IndexExpr{X: $x, Index: $i}
def embeddedIndexList: IndexListExpr = x:ident -sp "[" -ws first:expr rest:(-sp "," -ws t:typ)+ -sp ("," -ws)? "]"
    -> new IndexListExpr{X: $x, Indices: concat(list($first), map($rest, (r) => $r.t))}

// ===================================================================
// Statements
// ===================================================================

def block: BlockStmt = "{" -ws ss:(s:stmt -ws)* "}" -> new BlockStmt{List: map($ss, (x) => $x.s)}

// A statement and its semicolon. A label and an empty statement need none.
def stmt: Stmt = emptyStmt / labeledEmpty / terminatedStmt
def terminatedStmt: Stmt = s:(labeledStmt / plainStmt) -sp -stmtTerm -> $s
def emptyStmt: EmptyStmt = ";" -> new EmptyStmt{}
def implicitEmpty: EmptyStmt = &"}" -> new EmptyStmt{}
// A label followed by "}" labels an empty statement (with an empty range).
def labeledEmpty: LabeledStmt = l:ident -sp ":" !"=" -ws s:(implicitEmpty / emptyStmt / labeledEmpty)
    -> new LabeledStmt{Label: $l, Stmt: $s}
def labeledStmt: LabeledStmt = l:ident -sp ":" !"=" -ws s:(labeledStmt / plainStmt) -> new LabeledStmt{Label: $l, Stmt: $s}

// The statements of a case clause. The semicolon after the last one is left to the caller, so that
// the clause ends with its last statement.
def clauseBody = ss:(-ws s:clauseStmt)* l:lastClauseStmt? -> concat(map($ss, (x) => $x.s), $l)
// A statement followed by another one.
def clauseStmt: Stmt = s:(emptyStmt / labeledEmpty / clauseTerminated) &(-ws !clauseEnd) -> $s
def clauseTerminated: Stmt = s:(labeledStmt / plainStmt) -sp -stmtTerm -> $s
// The last statement, whose semicolon is not consumed.
def lastClauseStmt = -ws s:(emptyStmt / labeledEmpty / lastClauseTerminated) -> list($s)
def lastClauseTerminated: Stmt = s:(labeledStmt / plainStmt) &(-sp stmtTerm) -> $s
def clauseEnd = kw_case / kw_default / "}"

// go/parser starts a simple statement only at the tokens that start an expression, which "~" does not.
// (The lookahead for a keyword spares the other statements the expectations of the keywords, which
// cost more than the lookahead.)
def plainStmt: Stmt = (&keyword s:(declStmt / goStmt / deferStmt / returnStmt / branchStmt / ifStmt / switchStmt
    / selectStmt / forStmt) / s:block / !"~" s:simpleStmt) -> $s

def declStmt: DeclStmt = d:(constDecl / varDecl / typeDecl) -> new DeclStmt{Decl: $d}

// (Trying the expression statement first, since most statements are calls, was not faster.)
def simpleStmt: Stmt = assignStmt / sendStmt / incDecStmt / exprStmt
def assignStmt: AssignStmt = l:exprList -sp t:assignOp -ws r:exprList -> new AssignStmt{Lhs: $l, Tok: text($t), Rhs: $r}
def sendStmt: SendStmt = c:expr -sp "<-" -ws v:expr -> new SendStmt{Chan: $c, Value: $v}
def incDecStmt: IncDecStmt = x:expr -sp t:incDecOp -> new IncDecStmt{X: $x, Tok: text($t)}
def exprStmt: ExprStmt = x:expr -> new ExprStmt{X: $x}

// The same in the header of an if, for or switch statement.
def hsimpleStmt: Stmt = hassignStmt / hsendStmt / hincDecStmt / hexprStmt
def hassignStmt: AssignStmt = l:hexprList -sp t:assignOp -ws r:hexprList -> new AssignStmt{Lhs: $l, Tok: text($t), Rhs: $r}
def hsendStmt: SendStmt = c:hexpr -sp "<-" -ws v:hexpr -> new SendStmt{Chan: $c, Value: $v}
def hincDecStmt: IncDecStmt = x:hexpr -sp t:incDecOp -> new IncDecStmt{X: $x, Tok: text($t)}
def hexprStmt: ExprStmt = x:hexpr -> new ExprStmt{X: $x}

// The expression of go and defer must be a call that is not parenthesized: the operand of the
// last call is parsed by goPrimary, which does not apply a call that ends the statement.
def goStmt: GoStmt = kw_go -ws c:goCall -> new GoStmt{Call: $c}
def deferStmt: DeferStmt = kw_defer -ws c:goCall -> new DeferStmt{Call: $c}
def goCall: CallExpr = goCallEmpty / goCallArgs
def goCallEmpty: CallExpr = f:goPrimary -sp "(" -ws ")" -> new CallExpr{Fun: $f}
def goCallArgs: CallExpr = f:goPrimary -sp "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")"
    -> new CallExpr{Fun: $f, Args: $as, Ellipsis: $e}
def dotsWs: Match = d:@"..." -ws -> $d

def returnStmt: ReturnStmt = kw_return xs:returnValues? -> new ReturnStmt{Results: concat($xs)}
def returnValues = -sp xs:exprList -> $xs

def branchStmt: BranchStmt = breakStmt / continueStmt / gotoStmt / fallthroughStmt
def breakStmt: BranchStmt = kw_break l:labelSp? -> new BranchStmt{Tok: "break", Label: $l}
def continueStmt: BranchStmt = kw_continue l:labelSp? -> new BranchStmt{Tok: "continue", Label: $l}
def gotoStmt: BranchStmt = kw_goto -ws l:ident -> new BranchStmt{Tok: "goto", Label: $l}
def fallthroughStmt: BranchStmt = kw_fallthrough -> new BranchStmt{Tok: "fallthrough"}
def labelSp: Ident = -sp l:ident -> $l

// if [init;] cond {...} [else ...]. The semicolon after init may be a newline.
def ifStmt: IfStmt = kw_if -ws (i:hsimpleSemi / -";" -ws)? c:hexpr -sp b:block e:elseSp?
    -> new IfStmt{Init: $i, Cond: $c, Body: $b, Else: $e}
def hsimpleSemi: Stmt = s:hsimpleStmt -sp -hsemi -ws -> $s
def elseSp: Stmt = -sp kw_else -ws s:(ifStmt / block) -> $s

def switchStmt: Stmt = typeSwitchStmt / exprSwitchStmt
def switchInit = s:hsimpleStmt? -sp -hsemi -ws -> $s
def exprSwitchStmt: SwitchStmt = kw_switch -ws i:switchInit? t:hexpr? -sp b:caseBlock
    -> new SwitchStmt{Init: $i, Tag: $t, Body: $b}
def typeSwitchStmt: TypeSwitchStmt = kw_switch -ws i:switchInit? g:typeSwitchGuard -sp b:caseBlock
    -> new TypeSwitchStmt{Init: $i, Assign: $g, Body: $b}
// x.(type) or v := x.(type), where x is parsed by guardPrimary, which does not apply the .(type)
// before "{".
def typeSwitchGuard: Stmt = guardAssign / guardExpr
def guardAssign: AssignStmt = l:hexpr -sp ":=" -ws x:guardAssert -> new AssignStmt{Lhs: list($l), Tok: ":=", Rhs: list($x)}
def guardExpr: ExprStmt = x:guardAssert -> new ExprStmt{X: $x}
def guardAssert: TypeAssertExpr = x:guardPrimary -sp dot -ws "(" -ws kw_type -ws ")" -> new TypeAssertExpr{X: $x}
def caseBlock: BlockStmt = "{" -ws cs:(c:caseClause (-sp -stmtTerm)? -ws)* "}" -> new BlockStmt{List: map($cs, (x) => $x.c)}
def caseClause: CaseClause = caseClauseList / caseClauseDefault
def caseClauseList: CaseClause = kw_case -ws xs:exprList -sp ":" !"=" b:clauseBody -> new CaseClause{List: $xs, Body: $b}
def caseClauseDefault: CaseClause = kw_default -ws ":" !"=" b:clauseBody -> new CaseClause{Body: $b}

def selectStmt: SelectStmt = kw_select -ws b:commBlock -> new SelectStmt{Body: $b}
def commBlock: BlockStmt = "{" -ws cs:(c:commClause (-sp -stmtTerm)? -ws)* "}" -> new BlockStmt{List: map($cs, (x) => $x.c)}
def commClause: CommClause = commClauseCase / commClauseDefault
def commClauseCase: CommClause = kw_case -ws c:commStmt -sp ":" !"=" b:clauseBody -> new CommClause{Comm: $c, Body: $b}
def commClauseDefault: CommClause = kw_default -ws ":" !"=" b:clauseBody -> new CommClause{Body: $b}
// go/parser does not check that a communication receives or sends.
def commStmt: Stmt = sendStmt / commRecv / exprStmt
def commRecv: AssignStmt = first:expr rest:(-sp "," -ws x:expr){0,1} -sp t:@(":=" / "=" !"=") -ws r:expr
    -> new AssignStmt{Lhs: concat(list($first), map($rest, (q) => $q.x)), Tok: text($t), Rhs: list($r)}

def forStmt: Stmt = forInfinite / forRange / forClause / forCond
def forInfinite: ForStmt = kw_for -ws b:block -> new ForStmt{Body: $b}
def forCond: ForStmt = kw_for -ws c:hexpr -sp b:block -> new ForStmt{Cond: $c, Body: $b}
// The semicolons may be newlines.
def forClause: ForStmt = kw_for -ws i:hsimpleStmt? -sp -hsemi -ws c:hexpr? -sp -hsemi -ws p:hsimpleStmt? -sp b:block
    -> new ForStmt{Init: $i, Cond: $c, Post: $p, Body: $b}
def forRange: RangeStmt = kw_for -ws (k:hexpr v:rangeValue? -sp t:@(":=" / "=" !"=") -ws)? kw_range -ws x:hexpr -sp b:block
    -> new RangeStmt{Key: $k, Value: $v, Tok: text($t), X: $x, Body: $b}
def rangeValue: Expr = -sp "," -ws v:hexpr -> $v

// ===================================================================
// Expressions
// ===================================================================

// Most expressions have no binary operator: a unary expression that no operator follows is the
// expression, without the five rules of the precedence levels (about 15% of the time of a parse).
def expr: Expr = (x:unaryExpr !(-sp binaryOp) / x:orExpr) -> $x
def exprList = first:expr rest:(-sp "," -ws x:expr)* -> concat(list($first), map($rest, (r) => $r.x))

def orExpr: Expr = l:andExpr rest:(-sp o:orOp -ws r:andExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def andExpr: Expr = l:cmpExpr rest:(-sp o:andOp -ws r:cmpExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def cmpExpr: Expr = l:addExpr rest:(-sp o:relOp -ws r:addExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def addExpr: Expr = l:mulExpr rest:(-sp o:addOp -ws r:mulExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def mulExpr: Expr = l:unaryExpr rest:(-sp o:mulOp -ws r:unaryExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})

// <-chan T is a channel type, not a receive; go/parser reassociates the arrow when the operand of
// "<-" is a channel type, which yields the type <-chan T or an error.
def unaryExpr: Expr = (&(?<+\-!^&~*) u:(recvChanType / recvExpr / unaryOpExpr / starExpr) / u:primaryExpr) -> $u
def recvChanType: ChanType = t:recvChanTypeT !(-sp (?.[()) -> $t
def recvExpr: UnaryExpr = "<-" -ws !(chanType !(-sp (?.[())) x:unaryExpr -> new UnaryExpr{Op: "<-", X: $x}
def unaryOpExpr: UnaryExpr = o:unaryOp -ws x:unaryExpr -> new UnaryExpr{Op: text($o), X: $x}
def starExpr: StarExpr = "*" !"=" -ws x:unaryExpr -> new StarExpr{X: $x}

// Primary expressions: an operand and selectors, indexes, slices, type assertions, calls and
// composite literals. Outside headers, a "{" after an operand is a composite literal, which
// go/parser allows only after a name, a selector, an index or an array, struct or map type: the
// other operands and suffixes do not match before a "{" (any "{" after them would be an error).
def primaryExpr: Expr = (o:primaryOperand !(-sp (?.[({)) / o:prattExpr) -> $o
def prattExpr: Expr = pratt {
    skip sp
    operand primaryOperand
    level {
        postfix dot -ws s:ident -> new SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" !(-sp "{") -> new TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" !(-sp "{") -> new TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" -> new IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" -> new IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" !(-sp "{") -> new SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]" !(-sp "{")
            -> new SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" !(-sp "{") -> new CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" !(-sp "{") -> new CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
        postfix v:litValue !(-sp "{") -> new CompositeLit{Type: $lhs, Elts: $v}
    }
}
// A name, an array, struct or map type may be followed by a composite literal value.
def primaryOperand: Expr = operandGuard (o:ident / o:literalOperand !(-sp "{") / o:arrayType / o:structType / o:mapType) -> $o
// An expression is often tried where none is (an optional one, or a list that ends): where no
// operand can start, the guard records one message instead of the sixteen tokens that can begin
// an operand, which every expression memoized there would merge again (about a fifth of the
// time of a parse).
def operandGuard = &(?a-zA-Z_0-9.'"`([<\u{80}-\u{10FFFF}) / _|_ #error(message="expected operand")
def literalOperand: Expr = basicLit / parenExpr / funcLit / funcType / chanType / interfaceType
def indexList = first:expr rest:(-sp "," -ws t:typ)+ -sp ("," -ws)? -> concat(list($first), map($rest, (r) => $r.t))

def parenExpr: ParenExpr = "(" -ws x:expr -sp ")" -> new ParenExpr{X: $x}
def funcLit: FuncLit = t:funcType -sp b:block -> new FuncLit{Type: $t, Body: $b}

def litValue = "{" -ws es:elements? "}" -> concat($es)
def elements = first:element rest:(-sp "," -ws e:element)* -sp ("," -ws)? -> concat(list($first), map($rest, (r) => $r.e))
def element: Expr = keyValue / elementValue
def keyValue: KeyValueExpr = k:elementValue -sp ":" !"=" -ws v:elementValue -> new KeyValueExpr{Key: $k, Value: $v}
def elementValue: Expr = elidedLit / expr
def elidedLit: CompositeLit = v:litValue -> new CompositeLit{Elts: $v}

// go and defer: the same, except that a call followed by the end of the statement is not applied.
def goPrimary: Expr = pratt {
    skip sp
    operand primaryOperand
    level {
        postfix dot -ws s:ident -> new SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" !(-sp "{") -> new TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" !(-sp "{") -> new TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" -> new IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" -> new IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" !(-sp "{") -> new SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]" !(-sp "{")
            -> new SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" !(-sp ("{" / goEnd)) -> new CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" !(-sp ("{" / goEnd))
            -> new CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
        postfix v:litValue !(-sp "{") -> new CompositeLit{Type: $lhs, Elts: $v}
    }
}
def goEnd = semi / "}" / ")"

// ===================================================================
// Expressions in headers
// ===================================================================

def hexpr: Expr = (x:hunaryExpr !(-sp binaryOp) / x:horExpr) -> $x
def hexprList = first:hexpr rest:(-sp "," -ws x:hexpr)* -> concat(list($first), map($rest, (r) => $r.x))

def horExpr: Expr = l:handExpr rest:(-sp o:orOp -ws r:handExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def handExpr: Expr = l:hcmpExpr rest:(-sp o:andOp -ws r:hcmpExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def hcmpExpr: Expr = l:haddExpr rest:(-sp o:relOp -ws r:haddExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def haddExpr: Expr = l:hmulExpr rest:(-sp o:addOp -ws r:hmulExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})
def hmulExpr: Expr = l:hunaryExpr rest:(-sp o:mulOp -ws r:hunaryExpr)*
    -> foldl($l, $rest, (acc, i) => new BinaryExpr{X: $acc, Op: text($i.o), Y: $i.r})

def hunaryExpr: Expr = (&(?<+\-!^&~*) u:(recvChanType / hrecvExpr / hunaryOpExpr / hstarExpr) / u:hprimaryExpr) -> $u
def hrecvExpr: UnaryExpr = "<-" -ws !(chanType !(-sp (?.[())) x:hunaryExpr -> new UnaryExpr{Op: "<-", X: $x}
def hunaryOpExpr: UnaryExpr = o:unaryOp -ws x:hunaryExpr -> new UnaryExpr{Op: text($o), X: $x}
def hstarExpr: StarExpr = "*" !"=" -ws x:hunaryExpr -> new StarExpr{X: $x}

// Only array, struct and map types take a composite literal here. A parenthesized one followed by
// "{" is an error in go/parser, not the end of the header.
def hprimaryExpr: Expr = (o:hoperand !(-sp (?.[()) / o:hprattExpr) -> $o
def hprattExpr: Expr = pratt {
    skip sp
    operand hoperand
    level {
        postfix dot -ws s:ident -> new SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" -> new TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" -> new TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" -> new IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" -> new IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" -> new SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]"
            -> new SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" -> new CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" -> new CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
    }
}
def hoperand: Expr = operandGuard (o:ident / o:basicLit / !(parenCompositeType -sp "{") o:parenExpr / o:funcLit / o:funcType
    / o:compositeLitH / o:arrayType !(-sp "{") / o:structType !(-sp "{") / o:mapType !(-sp "{") / o:chanType
    / o:interfaceType) -> $o
def compositeLitH: CompositeLit = t:(arrayType / structType / mapType) -sp v:litValue -> new CompositeLit{Type: $t, Elts: $v}
def parenCompositeType = "(" -ws (parenCompositeType / arrayType / structType / mapType) -sp ")"

// The type switch guard: the same, except that .(type) before "{" is not applied.
def guardPrimary: Expr = pratt {
    skip sp
    operand hoperand
    level {
        postfix dot -ws s:ident -> new SelectorExpr{X: $lhs, Sel: $s}
        postfix dot -ws "(" -ws kw_type -ws ")" !(-sp "{") -> new TypeAssertExpr{X: $lhs}
        postfix dot -ws "(" -ws t:typ -sp ")" -> new TypeAssertExpr{X: $lhs, Type: $t}
        postfix "[" -ws i:expr -sp ("," -ws)? "]" -> new IndexExpr{X: $lhs, Index: $i}
        postfix "[" -ws i:indexList "]" -> new IndexListExpr{X: $lhs, Indices: $i}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp? "]" -> new SliceExpr{X: $lhs, Low: $l, High: $h}
        postfix "[" -ws l:exprSp? ":" !"=" -ws h:exprSp ":" !"=" -ws m:exprSp "]"
            -> new SliceExpr{X: $lhs, Low: $l, High: $h, Max: $m}
        postfix "(" -ws ")" -> new CallExpr{Fun: $lhs}
        postfix "(" -ws as:exprList -sp e:dotsWs? ("," -ws)? ")" -> new CallExpr{Fun: $lhs, Args: $as, Ellipsis: $e}
    }
}

// ===================================================================
// Operators
// ===================================================================

// Each operator must not be the beginning of a longer token.
def dot = "." !".."
// An operator is tried after every operand, mostly where none follows: the lookahead for its first
// character keeps those failures out of the expectations of syntax errors, which go/parser does not
// report either, and recording them was about a third of the time of a parse.
def binaryOp = &(?|&=!<>+\-^*/%) (orOp / andOp / relOp / addOp / mulOp)
def orOp = &"|" @"||"
def andOp = &"&" @"&&"
def relOp = &(?=!<>) @("==" / "!=" / "<=" / ">=" / "<" !(?<\-) / ">" !">")
def addOp = &(?+\-|^) @("+" !(?+=) / "-" !(?\-=) / "|" !(?|=) / "^" !"=")
def mulOp = &(?*/%<>&) @("*" !"=" / "/" !(?/*=) / "%" !"=" / "<<" !"=" / ">>" !"=" / "&^" !"=" / "&" !(?&=^))
def unaryOp = &(?+\-!^&~) @("+" !(?+=) / "-" !(?\-=) / "!" !"=" / "^" !"=" / "&" !(?&=^) / "~")
def assignOp = &(?=:+\-*/%&|^<>) @("=" !"=" / ":=" / "+=" / "-=" / "*=" / "/=" / "%=" / "&=" / "|=" / "^=" / "<<=" / ">>=" / "&^=")
def incDecOp = &(?+\-) @("++" / "--")

// ===================================================================
// Semicolons and whitespace
// ===================================================================

// A semicolon after a token that ends a statement at a newline, once sp has been skipped: ";", a
// newline, a block comment with a newline in it, or the end of the file.
def semi = ";" / "\n" / blockComment / $$
// Where the semicolon may be left out: before "}" (statements, fields) and ")" (grouped specs).
def stmtTerm = semi / &"}"
def fieldTerm = semi / &"}"
def groupTerm = semi / &")"
// The semicolons of headers, which go/parser does not let the end of the file or "}" replace.
def hsemi = ";" / "\n" / blockComment

// sp: spaces and comments that do not end the line. ws: all whitespace and comments.
//
// They are called at almost every position, often several times: they call no other rule, so that
// the parser does not memoize them (which took a tenth of the time of a parse), and they spell out
// the comments by hand: blockComment below is what the block comments in them match, with the line
// directives of dirBlock expanded in place. For a //line comment the same checks apply to the end
// of the line instead of "*/", where a final "\r" of a "\r\n" line end is not part of the directive
// (the tests compare every case with go/scanner). A //line directive must start a line, which a
// comment that sp reads never does (sp follows a token on the same line). The lookaheads keep the
// expectations of whitespace, which is optional everywhere, out of syntax errors.
def sp = (&(? \t\r/) ((? \t\r) (&(? \t\r) (? \t\r))*
    / "//" ((?^\n\u{0}\u{FEFF}\u{FFFD})+ / c1:"\u{FFFD}" [text($c1) == "\u{FFFD}"])*
    / !("/*" (!"*/" (?^\n))* "\n") "/*" ("line " (
        ((?^:*\u{0}\u{FEFF}\u{FFFD})+ / "*" !"/" / c2:"\u{FFFD}" [text($c2) == "\u{FFFD}"])* &"*/"
      / (!(":" ((?^:*)+ / "*" !"/")* ":" ((?^:*)+ / "*" !"/")* "*/") ((?^*\u{0}\u{FEFF}\u{FFFD}) / "*" !"/"
          / c3:"\u{FFFD}" [text($c3) == "\u{FFFD}"]))*
        ":" ("0"* n1:@((?1-9) (?0-9)*) &":" [len($n1) < 10 || len($n1) == 10 && text($n1) <= "1073741824"
              || 2147483647 + 1 > 0 && (len($n1) == 19 && text($n1) >= "9223372036854775808" || len($n1) == 20 && text($n1) <= "18446744073709551615")
              || 2147483647 + 1 < 0 && len($n1) == 10 && text($n1) >= "2147483648" && text($n1) <= "4294967295"]
            / "0"* n2:@((?1-9) (?0-9)*) &":" [2147483647 + 1 > 0 && (len($n2) > 20 || len($n2) == 20 && text($n2) > "18446744073709551615")
              || 2147483647 + 1 < 0 && (len($n2) > 10 || len($n2) == 10 && text($n2) > "4294967295")]
            / !((?0-9)+ ":") ((?^:*\u{0}\u{FEFF}\u{FFFD})+ / "*" !"/" / c4:"\u{FFFD}" [text($c4) == "\u{FFFD}"])*)
        ":" "0"* n3:@((?1-9) (?0-9)*) &"*/" [len($n3) < 10 || len($n3) == 10 && text($n3) <= "1073741824"
            || 2147483647 + 1 > 0 && (len($n3) == 19 && text($n3) >= "9223372036854775808" || len($n3) == 20 && text($n3) <= "18446744073709551615")
            || 2147483647 + 1 < 0 && len($n3) == 10 && text($n3) >= "2147483648" && text($n3) <= "4294967295"]
      / ((?^:*\u{0}\u{FEFF}\u{FFFD})+ / "*" !"/" / c5:"\u{FFFD}" [text($c5) == "\u{FFFD}"])* ":"
        "0"* n4:@((?1-9) (?0-9)*) &"*/" [len($n4) < 10 || len($n4) == 10 && text($n4) <= "1073741824"
            || 2147483647 + 1 > 0 && (len($n4) == 19 && text($n4) >= "9223372036854775808" || len($n4) == 20 && text($n4) <= "18446744073709551615")
            || 2147483647 + 1 < 0 && len($n4) == 10 && text($n4) >= "2147483648" && text($n4) <= "4294967295"])
      / !"line " ((?^*\u{0}\u{FEFF}\u{FFFD})+ / "*" !"/" / c6:"\u{FFFD}" [text($c6) == "\u{FFFD}"])*) "*/"))*
def ws = (&(? \t\r\n/) ((? \t\r\n) (&(? \t\r\n) (? \t\r\n))*
    / ^ "//line " (
        ((?^:\n\r\u{0}\u{FEFF}\u{FFFD})+ / "\r" !("\n" / $$) / c1:"\u{FFFD}" [text($c1) == "\u{FFFD}"])* "\r"? &("\n" / $$)
      / (!(":" ((?^:\n\r)+ / "\r" !("\n" / $$))* ":" ((?^:\n\r)+ / "\r" !("\n" / $$))* "\r"? &("\n" / $$))
          ((?^\n\u{0}\u{FEFF}\u{FFFD}) / c2:"\u{FFFD}" [text($c2) == "\u{FFFD}"]))*
        ":" ("0"* n1:@((?1-9) (?0-9)*) &":" [len($n1) < 10 || len($n1) == 10 && text($n1) <= "1073741824"
