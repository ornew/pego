Module{Body: [Assign{Targets: [Name{Ctx: "Store", Id: "s"}], Value: BinOp{Left: "'a' \"b\" r'\\d' u'''multi\nline'''", Op: "+", Right: "b'\\x00' rb\"\\n\""}} Assign{Targets: [Name{Ctx: "Store", Id: "f"}], Value: JoinedStr{Values: [FormattedValue{Conversion: "r", Debug: "", FormatSpec: JoinedStr{Values: [">" FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "width", Value: Name{Ctx: "Load", Id: "width"}}]}, Str: "x", Value: Name{Ctx: "Load", Id: "x"}} " " FormattedValue{Conversion: "", Debug: "=", FormatSpec: nil, Str: "y", Value: Name{Ctx: "Load", Id: "y"}} " {{literal}}" FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "z", Value: Name{Ctx: "Load", Id: "z"}} "\\n" FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "f\"{1}\"", Value: JoinedStr{Values: [FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "1", Value: "1"}]}}]}} Assign{Targets: [Name{Ctx: "Store", Id: "t"}], Value: TemplateStr{Values: [Interpolation{Conversion: "s", Debug: "", FormatSpec: JoinedStr{Values: ["^10"]}, Str: "name", Value: Name{Ctx: "Load", Id: "name"}}]}} Assign{Targets: [Name{Ctx: "Store", Id: "n"}], Value: IfExp{Body: BinOp{Left: BinOp{Left: BinOp{Left: BinOp{Left: BinOp{Left: BinOp{Left: "0x_ff", Op: "+", Right: "0o17"}, Op: "+", Right: "0b1"}, Op: "+", Right: "1_000"}, Op: "+", Right: "1.5e-3"}, Op: "+", Right: ".5j"}, Op: "+", Right: "1"}, OrElse: "2", Test: Name{Ctx: "Load", Id: "x"}}}]}
