Module{Body: [Assign{Targets: [Name{Ctx: "Store", Id: "s"}], Value: BinOp{Left: Constant("'a' \"b\" r'\\d' u'''multi\nline'''"), Op: Op("+"), Right: Constant("b'\\x00' rb\"\\n\"")}} Assign{Targets: [Name{Ctx: "Store", Id: "f"}], Value: JoinedStr{Values: [FormattedValue{Conversion: "r", Debug: "", FormatSpec: JoinedStr{Values: [FStringMiddle(">") FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "width", Value: Name{Ctx: "Load", Id: "width"}}]}, Str: "x", Value: Name{Ctx: "Load", Id: "x"}} FStringMiddle(" ") FormattedValue{Conversion: "", Debug: "=", FormatSpec: nil, Str: "y", Value: Name{Ctx: "Load", Id: "y"}} FStringMiddle(" {{literal}}") FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "z", Value: Name{Ctx: "Load", Id: "z"}} FStringRawMiddle("\\n") FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "f\"{1}\"", Value: JoinedStr{Values: [FormattedValue{Conversion: "", Debug: "", FormatSpec: nil, Str: "1", Value: Constant("1")}]}}]}} Assign{Targets: [Name{Ctx: "Store", Id: "t"}], Value: TemplateStr{Values: [Interpolation{Conversion: "s", Debug: "", FormatSpec: JoinedStr{Values: [FStringMiddle("^10")]}, Str: "name", Value: Name{Ctx: "Load", Id: "name"}}]}} Assign{Targets: [Name{Ctx: "Store", Id: "n"}], Value: IfExp{Body: BinOp{Left: BinOp{Left: BinOp{Left: BinOp{Left: BinOp{Left: BinOp{Left: Constant("0x_ff"), Op: Op("+"), Right: Constant("0o17")}, Op: Op("+"), Right: Constant("0b1")}, Op: Op("+"), Right: Constant("1_000")}, Op: Op("+"), Right: Constant("1.5e-3")}, Op: Op("+"), Right: Constant(".5j")}, Op: Op("+"), Right: Constant("1")}, OrElse: Constant("2"), Test: Name{Ctx: "Load", Id: "x"}}}]}
