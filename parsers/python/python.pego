// Python 3.14 as CPython 3.14.0 parses it (Grammar/python.gram and the tokenizer), parsed into a
// typed AST modeled on Python's ast module.
//
// The grammar works on characters: there is no separate tokenizer. What CPython's tokenizer does is
// done here as follows.
//
//   - Whitespace. `ws` skips spaces, tabs, form feeds and backslash continuations between tokens, and
//     inside brackets also newlines and comments. Rules never consume whitespace at their start or
//     end, so the span of every node is exactly its text.
//   - Brackets. The low part of the variable `lv` (lv % 512) is twice the bracket depth, plus one at the
//     top level of an f-string or t-string replacement field (where a lambda would end at the ':' of
//     the format spec, and CPython rejects it). Every rule that opens a bracket defines `lv` anew, so
//     the depth is restored when it returns; CPython allows 200 levels.
//   - Indentation. `indCol` is the current block's column (tabs advance to a multiple of 8;
//     a form feed resets it), and `indAlt` counts tabs as one to detect inconsistent tab use.
//     The block depth is lv / 32768, at most 99. A block defines both columns and increments that
//     depth in its own rule; returning restores the enclosing state (INDENT and DEDENT without
//     tokens). A line that matches no enclosing indentation is an error, as in CPython.
//   - Line ends. A statement does not consume the end of its line: the separator before the next
//     statement does, so compound statements end with their last statement.
//   - Tokens. Operators are matched with the longest-match rule of the tokenizer written out as
//     lookaheads (`"<" !(?<=>)`), keywords and names with `!idcont` after them, and numbers with the
//     tokenizer's check of what may follow them.
//   - f-strings and t-strings (PEP 701, 750). The middle of `lv` holds the kind of the
//     innermost string's quote (1 ', 2 ", 3 ''', 4 """; lv / 512 % 8), whether it is raw (lv / 4096 % 2),
//     and the number of enclosing format specs (lv / 8192 % 4; fields may be nested in format specs
//     twice). String entry resets these middle bits while preserving block depth. Replacement fields
//     contain any expression, including strings with the same quotes. The combined state is less
//     than 100 * 32768 and fits a 32-bit int.
//
// Bracket, string and block depths share `lv` to keep variable-dependent memo keys small. Indentation
// columns remain separate native integers, without a fixed radix or an artificial column limit.
// `from __future__ import barry_as_FLUFL` (which makes '<>' the inequality operator and '!=' an error)
// is checked after the parse, in Check; the grammar accepts both operators.
//
// The AST follows Python's ast module, with these differences: identifiers are strings, and an absent
// one (Python's None) is ""; ctx is the string "Load", "Store" or "Del"; operators are the source
// tokens (`Op`); booleans replace the ints of AnnAssign.simple and comprehension.is_async; constants,
// and the literal parts of f-strings and t-strings, are their source text (see python.go for their
// values); FormattedValue and Interpolation keep the source text of their expression (Str) and of
// their `=` (Debug) and their conversion character as a string. Python's List and Match are ListExpr
// and MatchStmt (List and Match are reserved in PEGO), and its Expr statement is ExprStmt.
package python

type Module struct { Body []Stmt }

// --- Statements ---
type FunctionDef struct {
    Name          string
    Args          Arguments
    Body          []Stmt
    DecoratorList []Expr
    Returns       *Expr
    TypeParams    []TypeParam
}
type AsyncFunctionDef struct {
    Name          string
    Args          Arguments
    Body          []Stmt
    DecoratorList []Expr
    Returns       *Expr
    TypeParams    []TypeParam
}
type ClassDef struct {
    Name          string
    Bases         []Expr
    Keywords      []Keyword
    Body          []Stmt
    DecoratorList []Expr
    TypeParams    []TypeParam
}
type Return struct { Value *Expr }
type Delete struct { Targets []Expr }
type Assign struct { Targets []Expr, Value Expr }
type TypeAlias struct { Name Name, TypeParams []TypeParam, Value Expr }
type AugAssign struct { Target Expr, Op Op, Value Expr }
type AnnAssign struct { Target Expr, Annotation Expr, Value *Expr, Simple bool }
type For struct { Target Expr, Iter Expr, Body []Stmt, OrElse []Stmt }
type AsyncFor struct { Target Expr, Iter Expr, Body []Stmt, OrElse []Stmt }
type While struct { Test Expr, Body []Stmt, OrElse []Stmt }
type If struct { Test Expr, Body []Stmt, OrElse []Stmt }
type With struct { Items []WithItem, Body []Stmt }
type AsyncWith struct { Items []WithItem, Body []Stmt }
type MatchStmt struct { Subject Expr, Cases []MatchCase }
type Raise struct { Exc *Expr, Cause *Expr }
type Try struct { Body []Stmt, Handlers []ExceptHandler, OrElse []Stmt, FinalBody []Stmt }
type TryStar struct { Body []Stmt, Handlers []ExceptHandler, OrElse []Stmt, FinalBody []Stmt }
type Assert struct { Test Expr, Msg *Expr }
type Import struct { Names []Alias }
type ImportFrom struct { Module string, Names []Alias, Level int }
type Global struct { Names []Identifier }
type Nonlocal struct { Names []Identifier }
type ExprStmt struct { Value Expr }
type Pass struct {}
type Break struct {}
type Continue struct {}
type Stmt = FunctionDef | AsyncFunctionDef | ClassDef | Return | Delete | Assign | TypeAlias
    | AugAssign | AnnAssign | For | AsyncFor | While | If | With | AsyncWith | MatchStmt | Raise
    | Try | TryStar | Assert | Import | ImportFrom | Global | Nonlocal | ExprStmt | Pass | Break
    | Continue

// --- Expressions ---
type BoolOp struct { Op Op, Values []Expr }
type NamedExpr struct { Target Name, Value Expr }
type BinOp struct { Left Expr, Op Op, Right Expr }
type UnaryOp struct { Op Op, Operand Expr }
type Lambda struct { Args Arguments, Body Expr }
type IfExp struct { Test Expr, Body Expr, OrElse Expr }
// Keys has a nil key for each `**` item.
type Dict struct { Keys []*Expr, Values []Expr }
type Set struct { Elts []Expr }
type ListComp struct { Elt Expr, Generators []Comprehension }
type SetComp struct { Elt Expr, Generators []Comprehension }
type DictComp struct { Key Expr, Value Expr, Generators []Comprehension }
type GeneratorExp struct { Elt Expr, Generators []Comprehension }
type Await struct { Value Expr }
type Yield struct { Value *Expr }
type YieldFrom struct { Value Expr }
type Compare struct { Left Expr, Ops []Op, Comparators []Expr }
type Call struct { Func Expr, Args []Expr, Keywords []Keyword }
// A replacement field of an f-string, or of a format spec. Str is the source of the expression
// (from after the '{'), Debug the '=' with the whitespace around it ("" without), Conversion the
// conversion character ("" without).
type FormattedValue struct { Value Expr, Str string, Debug string, Conversion string, FormatSpec *JoinedStr }
// A replacement field of a t-string, like FormattedValue.
type Interpolation struct { Value Expr, Str string, Debug string, Conversion string, FormatSpec *JoinedStr }
// Adjacent f-strings and string literals, or a format spec. The values are the parts in source
// order: whole string literals (Constant), the literal text of f-strings (FStringMiddle, or
// FStringRawMiddle in raw f-strings) and replacement fields.
type JoinedStr struct { Values []StrPart }
// Adjacent t-strings: their literal text and Interpolations.
type TemplateStr struct { Values []StrPart }
// A number, True, False, None, `...`, or adjacent string or bytes literals: the source text.
type Constant terminal
type Attribute struct { Value Expr, Attr string, Ctx string }
type Subscript struct { Value Expr, Slice Expr, Ctx string }
type Starred struct { Value Expr, Ctx string }
type Name struct { Id string, Ctx string }
type ListExpr struct { Elts []Expr, Ctx string }
type Tuple struct { Elts []Expr, Ctx string }
type Slice struct { Lower *Expr, Upper *Expr, Step *Expr }
type Expr = BoolOp | NamedExpr | BinOp | UnaryOp | Lambda | IfExp | Dict | Set | ListComp | SetComp
    | DictComp | GeneratorExp | Await | Yield | YieldFrom | Compare | Call | FormattedValue
    | Interpolation | JoinedStr | TemplateStr | Constant | Attribute | Subscript | Starred | Name
    | ListExpr | Tuple | Slice

// The literal text of an f-string or t-string between replacement fields, with its escape
// sequences and doubled braces as written.
type FStringMiddle terminal
// The same in a raw f-string or t-string.
type FStringRawMiddle terminal
type StrPart = Constant | FStringMiddle | FStringRawMiddle | FormattedValue | Interpolation

// --- Patterns ---
type MatchCase struct { Pattern Pattern, Guard *Expr, Body []Stmt }
type MatchValue struct { Value Expr }
type MatchSingleton struct { Value Constant }
type MatchSequence struct { Patterns []Pattern }
type MatchMapping struct { Keys []Expr, Patterns []Pattern, Rest string }
type MatchClass struct { Cls Expr, Patterns []Pattern, KwdAttrs []Identifier, KwdPatterns []Pattern }
type MatchStar struct { Name string }
type MatchAs struct { Pattern *Pattern, Name string }
type MatchOr struct { Patterns []Pattern }
type Pattern = MatchValue | MatchSingleton | MatchSequence | MatchMapping | MatchClass | MatchStar
    | MatchAs | MatchOr

// --- Other nodes ---
// The parameters of a function or lambda. Defaults are those of the last positional parameters;
// KwDefaults has one entry per keyword-only parameter, nil where it has no default.
type Arguments struct {
    PosOnlyArgs []Arg
    Args        []Arg
    VarArg      *Arg
    KwOnlyArgs  []Arg
    KwDefaults  []*Expr
    KwArg       *Arg
    Defaults    []Expr
}
type Arg struct { Arg string, Annotation *Expr }
// Arg is "" for `**value`.
type Keyword struct { Arg string, Value Expr }
type Alias struct { Name string, AsName string }
type WithItem struct { ContextExpr Expr, OptionalVars *Expr }
type Comprehension struct { Target Expr, Iter Expr, Ifs []Expr, IsAsync bool }
type ExceptHandler struct { Type *Expr, Name string, Body []Stmt }
type TypeVar struct { Name string, Bound *Expr, DefaultValue *Expr }
type ParamSpec struct { Name string, DefaultValue *Expr }
type TypeVarTuple struct { Name string, DefaultValue *Expr }
type TypeParam = TypeVar | ParamSpec | TypeVarTuple
// A name in a list of names (Global, Nonlocal, MatchClass.KwdAttrs).
type Identifier terminal
// An operator as written: "+", "not in", "+=", "and", ...
type Op terminal

// ============================================================================
// Module, blocks and lines
// ============================================================================

def main: Module = [indCol = 0] [indAlt = 0] [lv = 0]
    -blank* b:first_stmts? -module_end $$ #error(message="invalid syntax") -> new Module{Body: concat($b)}
// The first statement must not be indented.
def first_stmts = i:indentation
    [foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail) == 0
        && foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail) == 0]
    #error(message="unexpected indent")
    s:stmts (-ws -";")? -> $s

// After the last statement (and its ';'): the end of its line, blank lines, and whitespace, a
// continuation (not at the very end) or a comment on a last line without a newline.
def module_end = (eol blank*)? (? \t\u{c})* ("\\" newline !$$ (? \t\u{c})*)* comment?

// The statements of a block, the first at the current position (its indentation consumed by the
// caller). Simple statements on one line are separated by ';'; lines by stmt_sep, which requires the
// block's indentation.
def stmts = f:stmt r:(-ws -";" -ws s:simple_stmt / -stmt_sep s:stmt)*
    -> concat(list($f), map($r, (x) => $x.s))
def stmt_sep = (ws ";")? eol blank* i:indentation
    [foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail)
        == indCol && foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail) == indAlt]

// The body of a compound statement, after its ':': simple statements on the same line, or an
// indented block on the following lines.
def block = -ws b:(indented_block / simple_stmts) -> $b
def indented_block = -eol -blank* i:indentation
    [foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail) > indCol
        && foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail) > indAlt]
        #error(message="expected an indented block")
    [lv / 32768 < 99] #error(message="too many levels of indentation")
    [indCol = foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail)]
    [indAlt = foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail)]
    [lv = lv + 32768]
    s:stmts -> $s
def simple_stmts = f:simple_stmt r:(-ws -";" -ws s:simple_stmt)* -> concat(list($f), map($r, (x) => $x.s))

// The line end, blank lines and indentation before a clause that continues a compound statement
// (elif, else, except, finally, case) or before the next decorator: the indentation of the block.
def clause_sep = (ws ";")? eol blank* i:indentation
    [foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail)
        == indCol && foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail) == indAlt]

// The indentation of a line: segments of spaces ended by a tab, then spaces. Only what follows the
// last form feed counts. A backslash continuation at the start of the line is skipped (CPython then
// counts the whitespace after it); continuations after some whitespace end the indentation (CPython
// keeps the column of the first one).
def indentation = -((? \t)* "\u{c}")* -("\\" newline !$$ ((? \t)* "\u{c}")*)*
    segs:(sp:@" "* "\t")* tail:@" "* -("\\" newline !$$ (? \t\u{c})*)*

def blank = (? \t\u{c})* ("\\" newline !$$ (? \t\u{c})*)* comment? newline
def eol = ws comment? (newline / $$)
def newline = "\r\n" / (?\n\r)
def comment = "#" (?^\n\r\u{0})*

// Whitespace between tokens: spaces, tabs, form feeds and backslash continuations, and inside
// brackets newlines and comments. A continuation must not end the input.
def ws = ((? \t\u{c})+ / "\\" ("\r\n" / (?\n\r)) !$$ / &(?#\n\r) [lv % 512 >= 2] ("#" (?^\n\r\u{0})* / "\r\n" / (?\n\r)))*

// ============================================================================
// Statements
// ============================================================================

def stmt: Stmt = compound_stmt / simple_stmt

def simple_stmt: Stmt = pass_stmt / break_stmt / continue_stmt / return_stmt / raise_stmt
    / global_stmt / nonlocal_stmt / del_stmt / assert_stmt / import_stmt / from_stmt / yield_stmt
    / type_alias / expr_stmt / assignment

// An expression statement is parsed first, since most statements are: the expression is parsed
// once. Only if it is followed by '=', an augmented assignment operator or ':' is the statement an
// assignment, parsed again from its start (as CPython's assignment rule, which it tries first).
def expr_stmt: ExprStmt = e:star_expressions !(ws ("=" !"=" / ":" !"=" / augassign_op)) -> new ExprStmt{Value: $e}

def assignment: Stmt = ann_simple / ann_complex / assign_one / assign_chain / aug_assign
def ann_simple: AnnAssign = t:store_name -ws ":" !"=" -ws a:expression (-ws "=" !"=" -ws x:annotated_rhs)?
    -> new AnnAssign{Target: $t, Annotation: $a, Value: $x, Simple: true}
def ann_complex: AnnAssign = t:(paren_single_target / single_subscript_attribute_target) -ws ":" !"=" -ws a:expression
    (-ws "=" !"=" -ws x:annotated_rhs)?
    -> new AnnAssign{Target: $t, Annotation: $a, Value: $x, Simple: false}
// `x = value` is parsed with one target first, so that the value is not first tried as a target.
def assign_one: Assign = t:star_targets -ws "=" !"=" -ws v:annotated_rhs !(ws "=" !"=")
    -> new Assign{Targets: list($t), Value: $v}
def assign_chain: Assign = ts:(t:star_targets -ws "=" !"=" -ws)+ v:annotated_rhs !(ws "=" !"=")
    -> new Assign{Targets: map($ts, (x) => $x.t), Value: $v}
def aug_assign: AugAssign = t:single_target -ws o:augassign_op -ws v:annotated_rhs
    -> new AugAssign{Target: $t, Op: $o, Value: $v}
def augassign_op: Op = "+=" / "-=" / "*=" / "@=" / "/=" / "%=" / "&=" / "|=" / "^=" / "<<=" / ">>=" / "**=" / "//="
def annotated_rhs: Expr = yield_expr / star_expressions

def pass_stmt: Pass = kw_pass -> new Pass{}
def break_stmt: Break = kw_break -> new Break{}
def continue_stmt: Continue = kw_continue -> new Continue{}
def return_stmt: Return = kw_return (-ws e:star_expressions)? -> new Return{Value: $e}
def raise_stmt: Raise = kw_raise (-ws e:expression (-ws kw_from -ws c:expression)?)? -> new Raise{Exc: $e, Cause: $c}
def global_stmt: Global = kw_global -ws f:identifier r:(-ws -"," -ws n:identifier)*
    -> new Global{Names: concat(list($f), map($r, (x) => $x.n))}
def nonlocal_stmt: Nonlocal = kw_nonlocal -ws f:identifier r:(-ws -"," -ws n:identifier)*
    -> new Nonlocal{Names: concat(list($f), map($r, (x) => $x.n))}
def del_stmt: Delete = kw_del -ws f:del_target r:(-ws -"," -ws t:del_target)* (-ws -",")? &(ws (";" / "#" / newline / $$))
    -> new Delete{Targets: concat(list($f), map($r, (x) => $x.t))}
def assert_stmt: Assert = kw_assert -ws t:expression (-ws "," -ws m:expression)? -> new Assert{Test: $t, Msg: $m}
def yield_stmt: ExprStmt = y:yield_expr -> new ExprStmt{Value: $y}
def type_alias: TypeAlias = kw_type -ws n:store_name (-ws p:type_params)? -ws "=" !"=" -ws v:expression
    -> new TypeAlias{Name: $n, TypeParams: concat($p), Value: $v}

def import_stmt: Import = kw_import -ws f:dotted_as_name r:(-ws -"," -ws a:dotted_as_name)*
    -> new Import{Names: concat(list($f), map($r, (x) => $x.a))}
def dotted_as_name: Alias = d:dotted_name (-ws kw_as -ws a:ident)?
    -> new Alias{Name: foldl(text($d.f), $d.r, (acc, x) => $acc + "." + text($x.n)), AsName: text($a)}
def dotted_name = f:ident r:(-ws -"." -ws n:ident)*
// `from` dots and an optional module (at least one of them), `import` and the names.
def from_stmt: ImportFrom = kw_from ds:(-ws d:("..." / "."))* m:from_module [len($ds) > 0 || $m.f != nil]
    -ws kw_import -ws ns:import_from_targets
    -> new ImportFrom{Module: foldl(text($m.f), $m.r, (acc, x) => $acc + "." + text($x.n)), Names: $ns,
        Level: foldl(0, $ds, (acc, x) => $acc + len($x.d))}
// Always a record (the empty match `_` makes it one), with the fields f and r when there is a module.
def from_module = _ (-ws f:ident r:(-ws -"." -ws n:ident)*)?
def import_from_targets = paren_import_names / plain_import_names / star_import
def paren_import_names = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:import_from_as_name
    r:(-ws -"," -ws a:import_from_as_name)* (-ws -",")? -ws ")"
    -> concat(list($f), map($r, (x) => $x.a))
def plain_import_names = f:import_from_as_name r:(-ws -"," -ws a:import_from_as_name)* !(ws ",")
    -> concat(list($f), map($r, (x) => $x.a))
def star_import = a:star_alias -> list($a)
def star_alias: Alias = "*" -> new Alias{Name: "*"}
def import_from_as_name: Alias = n:ident (-ws kw_as -ws a:ident)? -> new Alias{Name: text($n), AsName: text($a)}


// ============================================================================
// Compound statements
// ============================================================================

def compound_stmt: Stmt = if_stmt / while_stmt / for_stmt / try_stmt / with_stmt / funcdef / classdef
    / async_funcdef / async_for / async_with / match_stmt

def if_stmt: If = kw_if -ws t:named_expression -ws ":" b:block o:(elif_part / else_part)?
    -> new If{Test: $t, Body: $b, OrElse: concat($o)}
def elif_part = -clause_sep e:elif_stmt -> list($e)
def elif_stmt: If = kw_elif -ws t:named_expression -ws ":" b:block o:(elif_part / else_part)?
    -> new If{Test: $t, Body: $b, OrElse: concat($o)}
def else_part = -clause_sep kw_else -ws ":" b:block -> $b

def while_stmt: While = kw_while -ws t:named_expression -ws ":" b:block o:else_part?
    -> new While{Test: $t, Body: $b, OrElse: concat($o)}

def for_stmt: For = kw_for -ws t:star_targets -ws kw_in -ws i:star_expressions -ws ":" b:block o:else_part?
    -> new For{Target: $t, Iter: $i, Body: $b, OrElse: concat($o)}
def async_for: AsyncFor = kw_async -ws kw_for -ws t:star_targets -ws kw_in -ws i:star_expressions -ws ":" b:block
    o:else_part? -> new AsyncFor{Target: $t, Iter: $i, Body: $b, OrElse: concat($o)}

def with_stmt: With = kw_with -ws is:with_items -ws ":" b:block -> new With{Items: $is, Body: $b}
def async_with: AsyncWith = kw_async -ws kw_with -ws is:with_items -ws ":" b:block -> new AsyncWith{Items: $is, Body: $b}
// `with (a as b, c):` is tried before taking the parenthesis as part of an expression.
def with_items = paren_with_items / plain_with_items
def paren_with_items = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:with_item r:(-ws -"," -ws w:with_item)*
    (-ws -",")? -ws ")" &(ws ":") -> concat(list($f), map($r, (x) => $x.w))
def plain_with_items = f:with_item r:(-ws -"," -ws w:with_item)* -> concat(list($f), map($r, (x) => $x.w))
def with_item: WithItem = with_item_as / with_item_plain
def with_item_as: WithItem = e:expression -ws kw_as -ws t:star_target &(ws (?,\):))
    -> new WithItem{ContextExpr: $e, OptionalVars: $t}
def with_item_plain: WithItem = e:expression -> new WithItem{ContextExpr: $e}

// The handlers are either all `except` or all `except*`; with `except*` the statement is a TryStar
// (made once for each handler: the last is the result).
def try_stmt: Stmt = kw_try -ws ":" b:block hs:(-clause_sep h:except_handler)* xs:(-clause_sep h:except_star_handler)*
    e:else_part? f:finally_part?
    [len($hs) == 0 || len($xs) == 0] [len($hs) + len($xs) > 0 || $f != nil && $e == nil]
    #error(message="expected 'except' or 'finally' block")
    -> foldl(new Try{Body: $b, Handlers: map($hs, (x) => $x.h), OrElse: concat($e), FinalBody: concat($f)}, $xs,
        (acc, y) => new TryStar{Body: $b, Handlers: map($xs, (x) => $x.h), OrElse: concat($e), FinalBody: concat($f)})
def finally_part = -clause_sep kw_finally -ws ":" b:block -> $b
def except_handler: ExceptHandler = except_as / except_plain / except_bare
def except_as: ExceptHandler = kw_except -ws t:expression -ws kw_as -ws n:ident -ws ":" b:block
    -> new ExceptHandler{Type: $t, Name: text($n), Body: $b}
// Several types without parentheses (PEP 758) make a tuple.
def except_plain: ExceptHandler = kw_except -ws t:expressions -ws ":" b:block -> new ExceptHandler{Type: $t, Body: $b}
def except_bare: ExceptHandler = kw_except -ws ":" b:block -> new ExceptHandler{Body: $b}
def except_star_handler: ExceptHandler = except_star_as / except_star_plain
def except_star_as: ExceptHandler = kw_except -ws "*" -ws t:expression -ws kw_as -ws n:ident -ws ":" b:block
    -> new ExceptHandler{Type: $t, Name: text($n), Body: $b}
def except_star_plain: ExceptHandler = kw_except -ws "*" -ws t:expressions -ws ":" b:block
    -> new ExceptHandler{Type: $t, Body: $b}

// Decorators are lines of their own, at the indentation of the definition. The span of a decorated
// definition starts at its first decorator.
def decorators = ds:("@" -ws e:named_expression -dec_sep)* -> map($ds, (x) => $x.e)
def dec_sep = eol blank* i:indentation
    [foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail)
        == indCol && foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail) == indAlt]

def funcdef: FunctionDef = ds:decorators kw_def -ws n:ident (-ws p:type_params)? -ws a:def_params
    (-ws "->" -ws r:expression)? -ws ":" b:block
    -> new FunctionDef{Name: text($n), Args: $a, Body: $b, DecoratorList: $ds, Returns: $r, TypeParams: concat($p)}
def async_funcdef: AsyncFunctionDef = ds:decorators kw_async -ws kw_def -ws n:ident (-ws p:type_params)? -ws a:def_params
    (-ws "->" -ws r:expression)? -ws ":" b:block
    -> new AsyncFunctionDef{Name: text($n), Args: $a, Body: $b, DecoratorList: $ds, Returns: $r, TypeParams: concat($p)}
def def_params: Arguments = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws a:params -ws ")" -> $a

def classdef: Stmt = classdef_args / classdef_plain
def classdef_args: ClassDef = ds:decorators kw_class -ws n:ident (-ws p:type_params)? -ws c:call_args -ws ":" b:block
    -> new ClassDef{Name: text($n), Bases: concat(map($c.pos, (x) => $x.a), foldl(list(), $c.kw1, (acc, x) => concat($acc, $x.ss))),
        Keywords: concat(foldl(list(), $c.kw1, (acc, x) => concat($acc, $x.ks)), map($c.kw2, (x) => $x.k)),
        Body: $b, DecoratorList: $ds, TypeParams: concat($p)}
def classdef_plain: ClassDef = ds:decorators kw_class -ws n:ident (-ws p:type_params)? -ws ":" b:block
    -> new ClassDef{Name: text($n), Body: $b, DecoratorList: $ds, TypeParams: concat($p)}

// The cases are lines of their own in a deeper block.
def match_stmt: MatchStmt = kw_match -ws s:subject_expr -ws ":" cs:case_blocks -> new MatchStmt{Subject: $s, Cases: $cs}
def subject_expr: Expr = subject_tuple / named_expression
def subject_tuple: Tuple = f:star_named_expression -ws "," r:(-ws x:star_named_expression -ws -",")*
    l:(-ws y:star_named_expression){0,1}
    -> new Tuple{Elts: concat(list($f), map($r, (z) => $z.x), map($l, (z) => $z.y)), Ctx: "Load"}
def case_blocks = -ws -eol -blank* i:indentation
    [foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail) > indCol
        && foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail) > indAlt]
        #error(message="expected an indented block")
    [lv / 32768 < 99] #error(message="too many levels of indentation")
    [indCol = foldl(0, $i.segs, (a, s) => ($a + len($s.sp)) / 8 * 8 + 8) + len($i.tail)]
    [indAlt = foldl(0, $i.segs, (a, s) => $a + len($s.sp) + 1) + len($i.tail)]
    [lv = lv + 32768]
    f:case_block r:(-clause_sep c:case_block)* -> concat(list($f), map($r, (x) => $x.c))
def case_block: MatchCase = kw_case -ws p:patterns (-ws kw_if -ws g:named_expression)? -ws ":" b:block
    -> new MatchCase{Pattern: $p, Guard: $g, Body: $b}

// ============================================================================
// Patterns
// ============================================================================

def patterns: Pattern = open_sequence_pattern / pattern
def open_sequence_pattern: MatchSequence = s:open_seq_items
    -> new MatchSequence{Patterns: concat(list($s.f), map($s.r, (x) => $x.p), map($s.l, (x) => $x.q))}
// A sequence pattern without brackets: at least one comma.
def open_seq_items = f:maybe_star_pattern -ws "," r:(-ws p:maybe_star_pattern -ws -",")* l:(-ws q:maybe_star_pattern){0,1}
def pattern: Pattern = as_pattern / or_pattern
def as_pattern: MatchAs = p:or_pattern -ws kw_as -ws n:capture_name -> new MatchAs{Pattern: $p, Name: text($n)}
def or_pattern: Pattern = f:closed_pattern t:(rs:(-ws -"|" !"=" -ws p:closed_pattern)+){0,1}
    -> foldl($f, $t, (acc, x) => new MatchOr{Patterns: concat(list($f), map($x.rs, (y) => $y.p))})
def closed_pattern: Pattern = literal_pattern / capture_pattern / wildcard_pattern / value_pattern
    / group_pattern / sequence_pattern / mapping_pattern / class_pattern

def literal_pattern: Pattern = signed_number_pattern / complex_pattern / string_pattern / singleton_pattern
def signed_number_pattern: MatchValue = v:signed_number !(ws (?+\-)) -> new MatchValue{Value: $v}
def complex_pattern: MatchValue = v:complex_number -> new MatchValue{Value: $v}
def string_pattern: MatchValue = v:strings -> new MatchValue{Value: $v}
def singleton_pattern: MatchSingleton = v:singleton -> new MatchSingleton{Value: $v}
def singleton: Constant = ("None" / "True" / "False") !idcont
// The keys of mapping patterns.
def literal_expr: Expr = signed_number_lit / complex_number / strings / singleton
def signed_number_lit: Expr = v:signed_number !(ws (?+\-)) -> $v
def signed_number: Expr = number / neg_number
def neg_number: UnaryOp = o:minus_op -ws n:number -> new UnaryOp{Op: $o, Operand: $n}
// The real part must be a real number and the imaginary part an imaginary one.
def complex_number: BinOp = r:signed_real_number -ws o:plus_minus_op -ws i:imag_number -> new BinOp{Left: $r, Op: $o, Right: $i}
def signed_real_number: Expr = real_number / neg_real_number
def neg_real_number: UnaryOp = o:minus_op -ws n:real_number -> new UnaryOp{Op: $o, Operand: $n}
def minus_op: Op = "-" !(?=>)
def plus_minus_op: Op = "+" !"=" / "-" !(?=>)

def capture_pattern: MatchAs = n:capture_name -> new MatchAs{Name: text($n)}
def capture_name = !("_" !idcont) n:ident !(ws ("." !".." / "(" / "=" !"=")) -> $n
def wildcard_pattern: MatchAs = "_" !idcont -> new MatchAs{}
def value_pattern: MatchValue = a:attr !(ws ("." !".." / "(" / "=" !"=")) -> new MatchValue{Value: $a}
// A dotted name of at least two names. (The spans of the inner attributes cover only their value.)
def attr: Expr = f:name r:(-ws -"." !".." -ws n:ident)+
    -> foldl($f, $r, (acc, x) => new Attribute{Value: $acc, Attr: text($x.n), Ctx: "Load"})
def name_or_attr: Expr = attr / name
def group_pattern: Pattern = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws p:pattern -ws ")" -> $p
def sequence_pattern: MatchSequence = list_pattern / empty_tuple_pattern / tuple_pattern
def empty_tuple_pattern: MatchSequence = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws ")" -> new MatchSequence{}
def list_pattern: MatchSequence = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws ps:star_patterns? -ws "]"
    -> new MatchSequence{Patterns: concat($ps)}
def star_patterns = f:maybe_star_pattern r:(-ws -"," -ws p:maybe_star_pattern)* (-ws -",")?
    -> concat(list($f), map($r, (x) => $x.p))
def tuple_pattern: MatchSequence = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws s:open_seq_items -ws ")"
    -> new MatchSequence{Patterns: concat(list($s.f), map($s.r, (x) => $x.p), map($s.l, (x) => $x.q))}
def maybe_star_pattern: Pattern = star_pattern / pattern
def star_pattern: MatchStar = "*" -ws (n:capture_name / "_" !idcont) -> new MatchStar{Name: text($n)}

def mapping_pattern: MatchMapping = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws
    (ks:kv_patterns (-ws -"," -ws "**" -ws r:capture_name)? / "**" -ws r:capture_name)?
    (-ws -",")? -ws "}"
    -> new MatchMapping{Keys: map($ks, (x) => $x.k), Patterns: map($ks, (x) => $x.v), Rest: text($r)}
def kv_patterns = f:key_value_pattern r:(-ws -"," -ws p:key_value_pattern)* -> concat(list($f), map($r, (x) => $x.p))
def key_value_pattern = k:(literal_expr / attr) -ws ":" -ws v:pattern

def class_pattern: MatchClass = c:name_or_attr -ws "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws
    (ps:positional_patterns (-ws -"," -ws ks:keyword_patterns)? / ks:keyword_patterns)?
    (-ws -",")? -ws ")"
    -> new MatchClass{Cls: $c, Patterns: concat($ps), KwdAttrs: map($ks, (x) => $x.n), KwdPatterns: map($ks, (x) => $x.v)}
def positional_patterns = f:pattern r:(-ws -"," -ws p:pattern)* -> concat(list($f), map($r, (x) => $x.p))
def keyword_patterns = f:keyword_pattern r:(-ws -"," -ws p:keyword_pattern)* -> concat(list($f), map($r, (x) => $x.p))
def keyword_pattern = n:identifier -ws "=" !"=" -ws v:pattern

// ============================================================================
// Type parameters
// ============================================================================

def type_params = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:type_param r:(-ws -"," -ws p:type_param)* (-ws -",")? -ws "]"
    -> concat(list($f), map($r, (x) => $x.p))
def type_param: TypeParam = type_var / type_var_tuple / param_spec
def type_var: TypeVar = n:ident (-ws ":" -ws b:expression)? (-ws "=" !"=" -ws d:expression)?
    -> new TypeVar{Name: text($n), Bound: $b, DefaultValue: $d}
def type_var_tuple: TypeVarTuple = "*" !"*" -ws n:ident (-ws "=" !"=" -ws d:star_expression)?
    -> new TypeVarTuple{Name: text($n), DefaultValue: $d}
def param_spec: ParamSpec = "**" -ws n:ident (-ws "=" !"=" -ws d:expression)?
    -> new ParamSpec{Name: text($n), DefaultValue: $d}

// ============================================================================
// Parameters
// ============================================================================

// The parameters of a def (the lambda's, without annotations and ended by ':', are lambda_params):
// positional ones, optionally '/' after which the ones before it are positional-only and more
// positional ones may follow, then '*' with the keyword-only ones, and '**'. A positional parameter
// without a default may not follow one with a default. (`$sl` has one element if there is a '/'.)
def params: Arguments = g1nd:param_nd* g1wd:param_wd* sl:slash{0,1} g2nd:param_nd* g2wd:param_wd* st:star_etc
    [len($sl) == 0 || len($g1nd) + len($g1wd) > 0] #error(message="at least one argument must precede /")
    [len($sl) > 0 || len($g2nd) + len($g2wd) == 0] [len($g1wd) == 0 || len($g2nd) == 0]
    #error(message="parameter without a default follows parameter with a default")
    -> new Arguments{
        PosOnlyArgs: foldl(list(), $sl, (acc, x) => concat($g1nd, map($g1wd, (y) => $y.p))),
        Args: concat(foldl(concat($g1nd, map($g1wd, (y) => $y.p)), $sl, (acc, x) => list()), $g2nd, map($g2wd, (y) => $y.p)),
        VarArg: $st.va,
        KwOnlyArgs: map($st.ko, (x) => $x.p),
        KwDefaults: map($st.ko, (x) => $x.d),
        KwArg: $st.kw,
        Defaults: concat(map($g1wd, (y) => $y.d), map($g2wd, (y) => $y.d))}
def param_nd: Arg = p:param -pend -> $p
def param_wd = p:param -ws "=" !"=" -ws d:expression -pend
def slash = s:"/" -pend
// After '*': a parameter (the var-positional one) or a comma and at least one keyword-only
// parameter. The rule always matches, so that its record always exists.
def star_etc = _ ("*" !(?*=) -ws (va:vararg_param -pend / "," -ws) ko:(p:param (-ws "=" !"=" -ws d:expression)? -pend)*
        [$va != nil || len($ko) > 0] #error(message="named arguments must follow bare *"))?
    (kw:kwds)?
def kwds: Arg = "**" -ws p:param -pend -> $p
def param: Arg = n:ident (-ws ":" !"=" -ws a:expression)? -> new Arg{Arg: text($n), Annotation: $a}
// The annotation of *args may be starred (*args: *Ts).
def vararg_param: Arg = n:ident (-ws ":" !"=" -ws a:star_expression)? -> new Arg{Arg: text($n), Annotation: $a}
// A parameter is followed by a comma, or ends the list.
def pend = -ws ("," -ws / &")")

// ============================================================================
// Expressions
// ============================================================================

// Comma-separated expressions make a Tuple; one expression without a comma is returned as is.
def expressions: Expr = f:expression t:(rs:(-ws -"," -ws x:expression)+ (-ws -",")? / -ws c:","){0,1}
    -> foldl($f, $t, (acc, y) => new Tuple{Elts: concat(list($f), map($y.rs, (z) => $z.x)), Ctx: "Load"})
def star_expressions: Expr = f:star_expression t:(rs:(-ws -"," -ws x:star_expression)+ (-ws -",")? / -ws c:","){0,1}
    -> foldl($f, $t, (acc, y) => new Tuple{Elts: concat(list($f), map($y.rs, (z) => $z.x)), Ctx: "Load"})
def star_expression: Expr = starred_bitor / expression
def star_named_expression: Expr = starred_bitor / named_expression
def starred_bitor: Starred = "*" !(?*=) -ws v:bitwise_or -> new Starred{Value: $v, Ctx: "Load"}
def starred_expression: Starred = "*" !(?*=) -ws v:expression -> new Starred{Value: $v, Ctx: "Load"}
def named_expression: Expr = walrus / plain_named_expression
def plain_named_expression: Expr = e:expression !(ws ":=") -> $e
def walrus: NamedExpr = n:store_name -ws ":=" -ws v:expression -> new NamedExpr{Target: $n, Value: $v}
def expression: Expr = conditional / lambdef
def conditional: Expr = d:disjunction t:(-ws kw_if -ws c:disjunction -ws kw_else -ws o:expression){0,1}
    -> foldl($d, $t, (acc, x) => new IfExp{Test: $x.c, Body: $d, OrElse: $x.o})
// A lambda may not be at the top level of a replacement field, where its ':' starts the format spec.
def lambdef: Lambda = kw_lambda [lv % 2 == 0] #error(message="f-string: lambda expressions are not allowed without parentheses")
    -ws a:lambda_params -ws ":" !"=" -ws b:expression -> new Lambda{Args: $a, Body: $b}
// The parameters of a lambda: as those of a def, without annotations, and ended by ':'.
def lambda_params: Arguments = g1nd:lparam_nd* g1wd:lparam_wd* sl:lslash{0,1} g2nd:lparam_nd* g2wd:lparam_wd* st:lstar_etc
    [len($sl) == 0 || len($g1nd) + len($g1wd) > 0] #error(message="at least one argument must precede /")
    [len($sl) > 0 || len($g2nd) + len($g2wd) == 0] [len($g1wd) == 0 || len($g2nd) == 0]
    #error(message="parameter without a default follows parameter with a default")
    -> new Arguments{
        PosOnlyArgs: foldl(list(), $sl, (acc, x) => concat($g1nd, map($g1wd, (y) => $y.p))),
        Args: concat(foldl(concat($g1nd, map($g1wd, (y) => $y.p)), $sl, (acc, x) => list()), $g2nd, map($g2wd, (y) => $y.p)),
        VarArg: $st.va,
        KwOnlyArgs: map($st.ko, (x) => $x.p),
        KwDefaults: map($st.ko, (x) => $x.d),
        KwArg: $st.kw,
        Defaults: concat(map($g1wd, (y) => $y.d), map($g2wd, (y) => $y.d))}
def lparam_nd: Arg = p:lparam -lpend -> $p
def lparam_wd = p:lparam -ws "=" !"=" -ws d:expression -lpend
def lslash = s:"/" -lpend
def lstar_etc = _ ("*" !(?*=) -ws (va:lparam -lpend / "," -ws) ko:(p:lparam (-ws "=" !"=" -ws d:expression)? -lpend)*
        [$va != nil || len($ko) > 0] #error(message="named arguments must follow bare *"))?
    (kw:lkwds)?
def lkwds: Arg = "**" -ws p:lparam -lpend -> $p
def lparam: Arg = n:ident -> new Arg{Arg: text($n)}
def lpend = -ws ("," -ws / &(":" !"="))

def yield_expr: Expr = yield_from / yield_plain
def yield_from: YieldFrom = kw_yield -ws kw_from -ws v:expression -> new YieldFrom{Value: $v}
def yield_plain: Yield = kw_yield (-ws v:star_expressions)? -> new Yield{Value: $v}

// Boolean operations are flat (BoolOp with all the operands), as in Python; Op is the first
// operator.
def disjunction: Expr = f:conjunction t:(-ws o:or_op -ws c:conjunction rs:(-ws -or_op -ws x:conjunction)*){0,1}
    -> foldl($f, $t, (acc, y) => new BoolOp{Op: $y.o, Values: concat(list($f), list($y.c), map($y.rs, (z) => $z.x))})
def conjunction: Expr = f:inversion t:(-ws o:and_op -ws c:inversion rs:(-ws -and_op -ws x:inversion)*){0,1}
    -> foldl($f, $t, (acc, y) => new BoolOp{Op: $y.o, Values: concat(list($f), list($y.c), map($y.rs, (z) => $z.x))})
def or_op: Op = "or" !idcont
def and_op: Op = "and" !idcont
def inversion: Expr = not_expr / comparison
def not_expr: UnaryOp = o:not_op -ws v:inversion -> new UnaryOp{Op: $o, Operand: $v}
def not_op: Op = "not" !idcont

// Chained comparisons are one Compare, as in Python.
def comparison: Expr = f:bitwise_or t:(rs:(-ws o:comp_op -ws x:bitwise_or)+){0,1}
    -> foldl($f, $t, (acc, y) => new Compare{Left: $f, Ops: map($y.rs, (z) => $z.o), Comparators: map($y.rs, (z) => $z.x)})
def comp_op: Op = "==" / "!=" / "<>" / "<=" / ">=" / "<" !(?<=>) / ">" !(?>=)
    / "not" !idcont ws "in" !idcont / "in" !idcont / "is" !idcont ws "not" !idcont / "is" !idcont

// The arithmetic and bitwise operators are one Pratt expression, which parses the operand once
// instead of descending through a rule for each of the nine levels. `**` binds tighter than the
// unary operators on its left (-x ** y is -(x ** y)) and takes a unary operator on its right
// (x ** -y), as in Python's grammar. This is 3 to 8% faster than a rule for each level.
def bitwise_or: Expr = pratt {
    skip ws
    operand await_expr
    operand primary
    level { infix left o:bor_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
    level { infix left o:bxor_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
    level { infix left o:band_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
    level { infix left o:shift_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
    level { infix left o:sum_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
    level { infix left o:term_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
    level { prefix o:unary_op -> new UnaryOp{Op: $o, Operand: $rhs} }
    level { infix right o:pow_op -> new BinOp{Left: $lhs, Op: $o, Right: $rhs} }
}
def bor_op: Op = "|" !"="
def bxor_op: Op = "^" !"="
def band_op: Op = "&" !"="
def shift_op: Op = "<<" !"=" / ">>" !"="
def sum_op: Op = "+" !"=" / "-" !(?=>)
def term_op: Op = "*" !(?*=) / "//" !"=" / "/" !(?/=) / "%" !"=" / "@" !"="
def unary_op: Op = "+" !"=" / "-" !(?=>) / "~"
def pow_op: Op = "**" !"="
def await_expr: Await = kw_await -ws v:primary -> new Await{Value: $v}

// An atom followed by attributes, calls and subscripts. Most atoms are followed by none, and are
// returned without running the Pratt expression.
def primary: Expr = atom_only / primary_chain
def atom_only: Expr = a:atom !(ws ((?([) / "." !"..")) -> $a
def primary_chain: Expr = pratt {
    skip ws
    operand atom
    level {
        postfix "." !".." -ws n:ident -> new Attribute{Value: $lhs, Attr: text($n), Ctx: "Load"}
        postfix g:genexp -> new Call{Func: $lhs, Args: list($g)}
        postfix c:call_args -> new Call{Func: $lhs,
            Args: concat(map($c.pos, (x) => $x.a), foldl(list(), $c.kw1, (acc, x) => concat($acc, $x.ss))),
            Keywords: concat(foldl(list(), $c.kw1, (acc, x) => concat($acc, $x.ks)), map($c.kw2, (x) => $x.k))}
        postfix s:subscript -> new Subscript{Value: $lhs, Slice: $s, Ctx: "Load"}
    }
}

// Call arguments: positional ones (and *x), then keyword arguments and *x, then keyword
// arguments and **x. Starred arguments among the keyword arguments are positional arguments of
// the Call, after the others.
def call_args = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws
    pos:(a:pos_arg -arg_sep)*
    kw1:((ks:kwarg_list / ss:starred_list) -arg_sep)*
    kw2:(k:(kwarg / dstar_arg) -arg_sep)*
    ")"
def arg_sep = -ws ("," -ws / &")")
def pos_arg: Expr = starred_expression / positional_named
def positional_named: Expr = e:named_expression !(ws "=" !"=") -> $e
def kwarg_list = k:kwarg -> list($k)
def starred_list = s:starred_expression -> list($s)
def kwarg: Keyword = n:ident -ws "=" !"=" -ws v:expression -> new Keyword{Arg: text($n), Value: $v}
def dstar_arg: Keyword = "**" -ws v:expression -> new Keyword{Value: $v}
// A generator expression as the only argument needs no parentheses of its own: f(x for x in y).
def genexp: GeneratorExp = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws e:named_expression -ws g:for_if_clauses -ws ")"
    -> new GeneratorExp{Elt: $e, Generators: $g}

def subscript = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws s:slices -ws "]" -> $s
// Several items, or a starred one, make a Tuple.
def slices: Expr = star_first_slices / plain_slices
def star_first_slices: Tuple = f:starred_expression rs:(-ws -"," -ws x:slice_or_star)* (-ws -",")?
    -> new Tuple{Elts: concat(list($f), map($rs, (y) => $y.x)), Ctx: "Load"}
def plain_slices: Expr = f:slice t:(rs:(-ws -"," -ws x:slice_or_star)+ (-ws -",")? / -ws c:","){0,1}
    -> foldl($f, $t, (acc, y) => new Tuple{Elts: concat(list($f), map($y.rs, (z) => $z.x)), Ctx: "Load"})
def slice_or_star: Expr = slice / starred_expression
def slice: Expr = slice_colon / named_expression
def slice_colon: Slice = (l:expression -ws)? ":" !"=" (-ws u:expression)? (-ws ":" !"=" (-ws s:expression)?)?
    -> new Slice{Lower: $l, Upper: $u, Step: $s}

// --- Comprehensions ---
def for_if_clauses = f:for_if_clause r:(-ws c:for_if_clause)* -> concat(list($f), map($r, (x) => $x.c))
def for_if_clause: Comprehension = a:(kw_async -ws)? kw_for -ws t:star_targets -ws kw_in -ws i:disjunction
    ifs:(-ws kw_if -ws c:disjunction)*
    -> new Comprehension{Target: $t, Iter: $i, Ifs: map($ifs, (x) => $x.c), IsAsync: $a != nil}

// --- Atoms ---
def atom: Expr = strings / name / number / constant_kw / paren / list_display / braces / ellipsis
def name: Name = n:ident -> new Name{Id: text($n), Ctx: "Load"}
def constant_kw: Constant = ("True" / "False" / "None") !idcont
def ellipsis: Constant = "..."

// (), (x), (x,), (x, y), (*x, y), (x for x in y), (yield x)
def paren: Expr = empty_tuple / yield_group / star_first_tuple / paren_named
def empty_tuple: Tuple = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws ")" -> new Tuple{Ctx: "Load"}
def yield_group: Expr = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws y:yield_expr -ws ")" -> $y
def star_first_tuple: Tuple = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:starred_bitor
    rs:(-ws -"," -ws x:star_named_expression)* c:(-ws ",")? -ws ")" [len($rs) > 0 || $c != nil]
    -> new Tuple{Elts: concat(list($f), map($rs, (y) => $y.x)), Ctx: "Load"}
// The first element is parsed once; what follows it decides the node.
def paren_named: Expr = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws e:named_expression
    t:(rs:(-ws -"," -ws x:star_named_expression)+ (-ws -",")? / -ws c:","){0,1}
    g:(-ws cs:for_if_clauses){0,1}
    -ws ")" [len($t) + len($g) <= 1]
    -> foldl(foldl($e, $t, (acc, y) => new Tuple{Elts: concat(list($e), map($y.rs, (z) => $z.x)), Ctx: "Load"}),
        $g, (acc, y) => new GeneratorExp{Elt: $e, Generators: $y.cs})

// [], [x, *y], [x for x in y]
def list_display: Expr = empty_list / list_items
def empty_list: ListExpr = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws "]" -> new ListExpr{Ctx: "Load"}
def list_items: Expr = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:(s:starred_bitor / named_expression)
    rs:(-ws -"," -ws x:star_named_expression)* c:(-ws ",")?
    g:(-ws cs:for_if_clauses){0,1}
    -ws "]" [len($g) == 0 || $s == nil && len($rs) == 0 && $c == nil]
    -> foldl(new ListExpr{Elts: concat(list($f), map($rs, (y) => $y.x)), Ctx: "Load"},
        $g, (acc, y) => new ListComp{Elt: $f, Generators: $y.cs})

// {}, {k: v, **d}, {k: v for ...}, {x, *y}, {x for ...}
def braces: Expr = empty_dict / dict_unpack_first / set_star_first / brace_items
def empty_dict: Dict = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws "}" -> new Dict{}
def dict_unpack_first: Dict = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws "**" -ws f:bitwise_or
    rs:(-ws -"," -ws (-"**" -ws v:bitwise_or / k:expression -ws -":" !"=" -ws v:expression))* (-ws -",")? -ws "}"
    -> new Dict{Keys: concat(list(nil), map($rs, (y) => $y.k)), Values: concat(list($f), map($rs, (y) => $y.v))}
def set_star_first: Set = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:starred_bitor
    rs:(-ws -"," -ws x:star_named_expression)* (-ws -",")? -ws "}"
    -> new Set{Elts: concat(list($f), map($rs, (y) => $y.x))}
// The first element is parsed once. A ':' after it makes the display a dict (whose key may not be
// an assignment expression), and comprehension clauses after it (and its value) a comprehension.
def brace_items: Expr = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:(w:walrus / expression)
    kv:(-ws ":" !"=" -ws v:expression){0,1}
    [isdict = len($kv) > 0] [$w == nil || !isdict]
    g:(-ws cs:for_if_clauses){0,1}
    dr:([isdict] -ws -"," -ws (-"**" -ws v:bitwise_or / k:expression -ws -":" !"=" -ws v:expression))*
    sr:([!isdict] -ws -"," -ws x:star_named_expression)*
    c:(-ws ",")?
    -ws "}" [len($g) == 0 || len($dr) + len($sr) == 0 && $c == nil]
    -> foldl(
        foldl(new Set{Elts: concat(list($f), map($sr, (y) => $y.x))},
            $kv, (acc, x) => new Dict{Keys: concat(list($f), map($dr, (y) => $y.k)), Values: concat(list($x.v), map($dr, (y) => $y.v))}),
        $g, (acc, y) => foldl(new SetComp{Elt: $f, Generators: $y.cs},
            $kv, (acc2, x) => new DictComp{Key: $f, Value: $x.v, Generators: $y.cs}))

// ============================================================================
// Assignment targets
// ============================================================================

def star_targets: Expr = f:star_target t:(rs:(-ws -"," -ws x:star_target)+ (-ws -",")? / -ws c:","){0,1}
    -> foldl($f, $t, (acc, y) => new Tuple{Elts: concat(list($f), map($y.rs, (z) => $z.x)), Ctx: "Store"})
def star_target: Expr = starred_target / target_with_star_atom
def starred_target: Starred = "*" !(?*=) -ws !"*" t:star_target -> new Starred{Value: $t, Ctx: "Store"}
def target_with_star_atom: Expr = attr_target / subscript_target / star_atom
def attr_target: Attribute = t:t_primary -ws "." !".." -ws n:ident !(ws t_lookahead)
    -> new Attribute{Value: $t, Attr: text($n), Ctx: "Store"}
def subscript_target: Subscript = t:t_primary -ws s:subscript !(ws t_lookahead)
    -> new Subscript{Value: $t, Slice: $s, Ctx: "Store"}
def star_atom: Expr = store_name / paren_target / empty_tuple_target / star_tuple_target / empty_list_target / star_list_target
def paren_target: Expr = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws t:target_with_star_atom -ws ")" -> $t
def empty_tuple_target: Tuple = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws ")" -> new Tuple{Ctx: "Store"}
def star_tuple_target: Tuple = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:star_target
    rs:(-ws -"," -ws x:star_target)* c:(-ws ",")? -ws ")" [len($rs) > 0 || $c != nil]
    -> new Tuple{Elts: concat(list($f), map($rs, (y) => $y.x)), Ctx: "Store"}
def empty_list_target: ListExpr = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws "]" -> new ListExpr{Ctx: "Store"}
def star_list_target: ListExpr = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws f:star_target
    rs:(-ws -"," -ws x:star_target)* (-ws -",")? -ws "]"
    -> new ListExpr{Elts: concat(list($f), map($rs, (y) => $y.x)), Ctx: "Store"}
def single_target: Expr = single_subscript_attribute_target / store_name / paren_single_target
def single_subscript_attribute_target: Expr = attr_target / subscript_target
def paren_single_target: Expr = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws t:single_target -ws ")" -> $t
def store_name: Name = n:ident -> new Name{Id: text($n), Ctx: "Store"}

// The value of an attribute or subscript target: a primary followed by another trailer.
def t_primary: Expr = pratt {
    skip ws
    operand a:atom &(ws t_lookahead) -> $a
    level {
        postfix "." !".." -ws n:ident &(ws t_lookahead) -> new Attribute{Value: $lhs, Attr: text($n), Ctx: "Load"}
        postfix g:genexp &(ws t_lookahead) -> new Call{Func: $lhs, Args: list($g)}
        postfix c:call_args &(ws t_lookahead) -> new Call{Func: $lhs,
            Args: concat(map($c.pos, (x) => $x.a), foldl(list(), $c.kw1, (acc, x) => concat($acc, $x.ss))),
            Keywords: concat(foldl(list(), $c.kw1, (acc, x) => concat($acc, $x.ks)), map($c.kw2, (x) => $x.k))}
        postfix s:subscript &(ws t_lookahead) -> new Subscript{Value: $lhs, Slice: $s, Ctx: "Load"}
    }
}
def t_lookahead = (?([) / "." !".."

def del_target: Expr = del_attr / del_subscript / del_name / paren_del_target / del_tuple / del_list
def del_attr: Attribute = t:t_primary -ws "." !".." -ws n:ident !(ws t_lookahead)
    -> new Attribute{Value: $t, Attr: text($n), Ctx: "Del"}
def del_subscript: Subscript = t:t_primary -ws s:subscript !(ws t_lookahead)
    -> new Subscript{Value: $t, Slice: $s, Ctx: "Del"}
def del_name: Name = n:ident -> new Name{Id: text($n), Ctx: "Del"}
def paren_del_target: Expr = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws t:del_target -ws ")" -> $t
def del_tuple: Tuple = "(" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws ts:del_targets? -ws ")" -> new Tuple{Elts: concat($ts), Ctx: "Del"}
def del_list: ListExpr = "[" [lv % 512 < 400] [lv = lv / 2 * 2 + 2] -ws ts:del_targets? -ws "]" -> new ListExpr{Elts: concat($ts), Ctx: "Del"}
def del_targets = f:del_target r:(-ws -"," -ws t:del_target)* (-ws -",")? -> concat(list($f), map($r, (x) => $x.t))

// ============================================================================
// Strings
// ============================================================================

// Adjacent literals form one node: a Constant for string or bytes literals (bytes and others may
// not be mixed), a JoinedStr if one of them is an f-string, a TemplateStr for t-strings (which
// may not be mixed with others).
def strings: Expr = &string_start s:(tstrings / plain_strings / bytes_strings / fjoined) -> $s
def string_start = (?rRbBuUfFtT){0,2} (?'")
def plain_strings: Constant = str_lit (ws str_lit)* !(ws string_start)
def bytes_strings: Constant = bytes_lit (ws bytes_lit)* !(ws string_start)
def fjoined: JoinedStr = f:fjoin_item r:(-ws p:fjoin_item)* !(ws string_start)
    -> new JoinedStr{Values: foldl($f, $r, (acc, x) => concat($acc, $x.p))}
def fjoin_item = fstring / str_part
def str_part = c:str_constant -> list($c)
def str_constant: Constant = str_lit
def tstrings: TemplateStr = f:tstring r:(-ws p:tstring)* !(ws string_start)
    -> new TemplateStr{Values: foldl($f, $r, (acc, x) => concat($acc, $x.p))}

def str_lit = (?uU) str_body / (?rR) raw_str_body / str_body
def bytes_lit = ((?bB) (?rR) / (?rR) (?bB)) raw_bytes_body / (?bB) bytes_body
def str_body = "'''" ((?^'\\\u{0})+ / !"'''" "'" / str_esc)* "'''"
    / "\"\"\"" ((?^"\\\u{0})+ / !"\"\"\"" "\"" / str_esc)* "\"\"\""
    / !"'''" "'" ((?^'\\\n\r\u{0})+ / str_esc)* "'"
    / !"\"\"\"" "\"" ((?^"\\\n\r\u{0})+ / str_esc)* "\""
// Escape sequences: those that CPython rejects (a \x, \u or \U escape with too few digits or out
// of range, a malformed \N{...}) fail; an unknown escape is the backslash and the character.
def str_esc = "\\" (newline / "x" hex hex / "u" hex hex hex hex / "U" ("0010" hex hex hex hex / "000" hex hex hex hex hex)
    / "N{" (?A-Za-z0-9 \-)+ "}" / (?^xuUN\n\r\u{0}))
def raw_str_body = "'''" ((?^'\\\u{0})+ / !"'''" "'" / "\\" (?^\u{0}))* "'''"
    / "\"\"\"" ((?^"\\\u{0})+ / !"\"\"\"" "\"" / "\\" (?^\u{0}))* "\"\"\""
    / !"'''" "'" ((?^'\\\n\r\u{0})+ / "\\" ("\r\n" / (?^\u{0})))* "'"
    / !"\"\"\"" "\"" ((?^"\\\n\r\u{0})+ / "\\" ("\r\n" / (?^\u{0})))* "\""
// Bytes literals may contain only ASCII characters.
def bytes_body = "'''" ((?^'\\\u{0}\u{80}-\u{10FFFF})+ / !"'''" "'" / bytes_esc)* "'''"
    / "\"\"\"" ((?^"\\\u{0}\u{80}-\u{10FFFF})+ / !"\"\"\"" "\"" / bytes_esc)* "\"\"\""
    / !"'''" "'" ((?^'\\\n\r\u{0}\u{80}-\u{10FFFF})+ / bytes_esc)* "'"
    / !"\"\"\"" "\"" ((?^"\\\n\r\u{0}\u{80}-\u{10FFFF})+ / bytes_esc)* "\""
def bytes_esc = "\\" (newline / "x" hex hex / (?^x\n\r\u{0}\u{80}-\u{10FFFF}))
def raw_bytes_body = "'''" ((?^'\\\u{0}\u{80}-\u{10FFFF})+ / !"'''" "'" / "\\" (?^\u{0}\u{80}-\u{10FFFF}))* "'''"
    / "\"\"\"" ((?^"\\\u{0}\u{80}-\u{10FFFF})+ / !"\"\"\"" "\"" / "\\" (?^\u{0}\u{80}-\u{10FFFF}))* "\"\"\""
    / !"'''" "'" ((?^'\\\n\r\u{0}\u{80}-\u{10FFFF})+ / "\\" ("\r\n" / (?^\u{0}\u{80}-\u{10FFFF})))* "'"
    / !"\"\"\"" "\"" ((?^"\\\n\r\u{0}\u{80}-\u{10FFFF})+ / "\\" ("\r\n" / (?^\u{0}\u{80}-\u{10FFFF})))* "\""
def hex = (?0-9a-fA-F)

// --- f-strings and t-strings ---
// The prefix and the opening quote define the quote and the rawness in lv (see the top of the file); the parts are the literal
// text between replacement fields and the fields.
def fstring = ((?rR) (?fF) [lv = lv / 32768 * 32768 + lv % 512 + 4096] / (?fF) (?rR) [lv = lv / 32768 * 32768 + lv % 512 + 4096] / (?fF) [lv = lv / 32768 * 32768 + lv % 512])
    ("'''" [lv = lv + 3 * 512] / "\"\"\"" [lv = lv + 4 * 512] / "'" [lv = lv + 512] / "\"" [lv = lv + 2 * 512])
    ps:fpart* fclose #error(message="unterminated f-string literal") -> $ps
def tstring = ((?rR) (?tT) [lv = lv / 32768 * 32768 + lv % 512 + 4096] / (?tT) (?rR) [lv = lv / 32768 * 32768 + lv % 512 + 4096] / (?tT) [lv = lv / 32768 * 32768 + lv % 512])
    ("'''" [lv = lv + 3 * 512] / "\"\"\"" [lv = lv + 4 * 512] / "'" [lv = lv + 512] / "\"" [lv = lv + 2 * 512])
    ps:tpart* fclose #error(message="unterminated t-string literal") -> $ps
def fclose = [lv / 512 % 8 == 1] "'" / [lv / 512 % 8 == 2] "\"" / [lv / 512 % 8 == 3] "'''" / [lv / 512 % 8 == 4] "\"\"\""
def fpart: StrPart = fraw_text / ftext / ffield
def tpart: StrPart = fraw_text / ftext / tfield
// Literal text: doubled braces stand for braces; a single '}' is an error.
def ftext: FStringMiddle = [lv / 4096 % 2 == 0] ((?^'"\\{}\n\r\u{0})+ / fquote / "{{" / "}}" / fesc)+
def fraw_text: FStringRawMiddle = [lv / 4096 % 2 == 1] ((?^'"\\{}\n\r\u{0})+ / fquote / "{{" / "}}" / frawesc)+
// The quotes and newlines that do not end the string.
def fquote = [lv / 512 % 8 == 1] "\"" / [lv / 512 % 8 == 2] "'"
    / [lv / 512 % 8 == 3] (!"'''" "'" / "\"" / newline) / [lv / 512 % 8 == 4] (!"\"\"\"" "\"" / "'" / newline)
// As in string literals, except that a backslash before a brace is a character of its own and the
// brace is not escaped.
def fesc = "\\" (newline / "x" hex hex / "u" hex hex hex hex / "U" ("0010" hex hex hex hex / "000" hex hex hex hex hex)
    / "N{" (?A-Za-z0-9 \-)+ "}" / (?^xuUN{}\n\r\u{0}) / &(?{}))
def frawesc = "\\" ("\r\n" / (?^{}\u{0}) / &(?{}))

// A replacement field: the expression (any expression, including strings with the same quotes;
// inside the braces, newlines are whitespace), an optional '=', conversion and format spec.
def ffield: FormattedValue = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 3]
    [lv / 8192 % 4 <= 2] #error(message="f-string: expressions nested too deeply")
    s:(-ws v:annotated_rhs) d:fdebug? c:fconv? (-ws f:fspec / -ws) "}"
    -> new FormattedValue{Value: $v, Str: text($s), Debug: text($d), Conversion: text($c), FormatSpec: $f}
def tfield: Interpolation = "{" [lv % 512 < 400] [lv = lv / 2 * 2 + 3]
    [lv / 8192 % 4 <= 2] #error(message="t-string: expressions nested too deeply")
    s:(-ws v:annotated_rhs) d:fdebug? c:fconv? (-ws f:fspec / -ws) "}"
    -> new Interpolation{Value: $v, Str: text($s), Debug: text($d), Conversion: text($c), FormatSpec: $f}
def fdebug = ws "=" ws
// The conversion character must follow the '!' immediately.
def fconv = -ws "!" c:@(?sra) !idcont -> $c
// A format spec: literal text (no doubled braces) and replacement fields.
def fspec: JoinedStr = ":" [lv = lv + 8192] ps:fspec_part* -> new JoinedStr{Values: $ps}
def fspec_part: StrPart = fspec_raw_text / fspec_text / ffield
def fspec_text: FStringMiddle = [lv / 4096 % 2 == 0] ((?^'"\\{}\n\r\u{0})+ / fquote / fesc)+
def fspec_raw_text: FStringRawMiddle = [lv / 4096 % 2 == 1] ((?^'"\\{}\n\r\u{0})+ / fquote / frawesc)+

// ============================================================================
// Numbers
// ============================================================================

// A number may be followed by an identifier character only if a keyword that can follow a number
// starts there (CPython's verify_end_of_number): `1if x else 2`, `0x1for x in y`.
def number: Constant = (hex_lit / oct_lit / bin_lit / dec_number) num_end
def real_number: Constant = (hex_lit / oct_lit / bin_lit / dec_real) !(?jJ) num_end
def imag_number: Constant = (pointfloat exponent? / digitpart exponent?) (?jJ) num_end
def hex_lit = "0" (?xX) ("_"? (?0-9a-fA-F))+
def oct_lit = "0" (?oO) ("_"? (?0-7))+
def bin_lit = "0" (?bB) ("_"? (?01))+
def dec_number = pointfloat exponent? (?jJ)? / digitpart exponent (?jJ)? / digitpart (?jJ) / nonzero_int / zero_int
def dec_real = pointfloat exponent? / digitpart exponent / nonzero_int / zero_int
def pointfloat = digitpart "." digitpart? / "." digitpart
def exponent = (?eE) (?+\-)? digitpart
def digitpart = (?0-9) ("_"? (?0-9))*
def nonzero_int = (?1-9) ("_"? (?0-9))*
// Decimal integers other than zero may not start with 0.
def zero_int = "0" ("_"? "0")* !(?xXoObB)
def num_end = &("and" / "else" / "for" / "i" (?fns) / "or" / "not") / !(?a-zA-Z0-9_)

// ============================================================================
// Names and keywords
// ============================================================================

// A name: a letter or '_' then letters, digits and '_' (Unicode XID_Start and XID_Continue), that is
// not a keyword. The soft keywords (match, case, type, _) are names.
def ident = @(!keyword idstart idcont*)
def identifier: Identifier = ident
def idstart = (?a-zA-Z_) / &(?\u{80}-\u{10FFFF}) idstart_other #error(message="invalid character")
def idcont = (?a-zA-Z0-9_) / &(?\u{80}-\u{10FFFF}) idcont_other #error(message="invalid character")
def keyword = ("False" / "None" / "True" / "and" / "assert" / "async" / "as" / "await" / "break" / "class"
    / "continue" / "def" / "del" / "elif" / "else" / "except" / "finally" / "for" / "from" / "global" / "if"
    / "import" / "in" / "is" / "lambda" / "nonlocal" / "not" / "or" / "pass" / "raise" / "return" / "try"
    / "while" / "with" / "yield") !idcont

def kw_as = "as" !idcont
def kw_assert = "assert" !idcont
def kw_async = "async" !idcont
def kw_await = "await" !idcont
def kw_break = "break" !idcont
def kw_case = "case" !idcont
def kw_class = "class" !idcont
def kw_continue = "continue" !idcont
def kw_def = "def" !idcont
def kw_del = "del" !idcont
def kw_elif = "elif" !idcont
def kw_else = "else" !idcont
def kw_except = "except" !idcont
def kw_finally = "finally" !idcont
def kw_for = "for" !idcont
def kw_from = "from" !idcont
def kw_global = "global" !idcont
def kw_if = "if" !idcont
def kw_import = "import" !idcont
def kw_in = "in" !idcont
def kw_lambda = "lambda" !idcont
def kw_match = "match" !idcont
def kw_nonlocal = "nonlocal" !idcont
def kw_pass = "pass" !idcont
def kw_raise = "raise" !idcont
def kw_return = "return" !idcont
def kw_try = "try" !idcont
def kw_type = "type" !idcont
def kw_while = "while" !idcont
def kw_with = "with" !idcont
def kw_yield = "yield" !idcont

// The characters of Unicode 16.0 (as in CPython 3.14) other than ASCII that may start and continue
