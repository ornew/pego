// CEL, the Common Expression Language (https://github.com/google/cel-spec/blob/master/doc/langdef.md), parsed into a
// typed AST.
//
// The rules follow the grammar of the specification, and where it is silent the ANTLR grammar of cel-go, which
// decides in practice what is an expression: the tests compare the AST of every expression of a large corpus with
// cel-go's, and check that the ones cel-go rejects are rejected (see the README). Tokens are separated by whitespace
// and comments (ws). No rule consumes whitespace after its last token, so that the span of each value ends where its
// text does.
//
// Some rules differ from the productions of the specification for speed, each with a comment on why and on what
// it measurably changed. The first version of this grammar, which wrote the productions as they stand (an
// alternative for each kind of literal at an operand, a message tried before a call before an identifier, a rule for
// each character class), took 39% more time to recognize and 16% more to build the AST of typical expressions, and
// 38% and 24% more on a long one (the benchmarks of testdata/bench; see the README for the method).
package cel

type Ident = { Text string }
type Name = { Text string }
type IntLit = { Text string }
type UintLit = { Text string }
type DoubleLit = { Text string }
type StringLit = { Text string }
type BytesLit = { Text string }
type BoolLit = { Text string }
type NullLit = { Text string }

type Paren = { X Expr }
type Select = { X Expr; Field Name; Optional bool }
type Index = { X Expr; Index Expr; Optional bool }
type Call = { Target *Expr; Func Ident; Args []Expr }
type Unary = { Op node[string]; X Expr }
type Binary = { Left Expr; Op node[string]; Right Expr }
type Conditional = { Cond Expr; Then Expr; Else Expr }
type ListLit = { Elems []Expr }
type MapLit = { Entries []Entry }
type Entry = { Key Expr; Value Expr; Optional bool }
type MessageLit = { Type Ident; Fields []Field }
type Field = { Name Name; Value Expr; Optional bool }
type Optional = { X Expr }

type Expr ~ Ident | IntLit | UintLit | DoubleLit | StringLit | BytesLit | BoolLit | NullLit | Paren | Select | Index | Call | Unary | Binary | Conditional | ListLit | MapLit | MessageLit | Optional

rule main Expr = ws e:expr ws $$ => $e

// ---- Operators ----

// Expr = ConditionalOr ["?" ConditionalOr ":" Expr] and a level for each of the other precedences, all left
// associative. The then branch is parsed at the level of ||, as the production says. A rule for each level, with
// the operands folded to the left, took as long as a Operators Rule.
rule expr Expr = operators {
    skip ws
    operand unary
    level { infix right "?" ws then:level(expr, or) ws ":" => Conditional{Cond: $lhs, Then: $then, Else: $rhs} }
    level or { infix left "||" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "&&" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "<=" / "<" / ">=" / ">" / "==" / "!=" / ("in" ![A-Za-z0-9_]) #atomic => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "+" / "-" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "*" / "/" / "%" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
}

// Unary = Member | "!" {"!"} Member | "-" {"-"} Member. A run of operators is one rule, nested from the first to
// the last, as ANTLR reads (ops+='!')+ member: that is why "--9223372036854775808" is an error (the literal is
// 9223372036854775808 after two negations), where a literal with a sign, "-9223372036854775808", is not (see
// primary), and why "-1.f()" is a call on the literal -1.
rule unary Expr = member / not_unary / neg_unary
rule not_unary Expr = ops:(o:"!" -ws)+ m:member => foldr($m, $ops, (acc, i) => Unary{Op: i.$o, X: acc})
rule neg_unary Expr = ops:(o:"-" -ws)+ m:member => foldr($m, $ops, (acc, i) => Unary{Op: i.$o, X: acc})

// Member = Primary | Member "." SELECTOR ["(" [ExprList] ")"] | Member "[" Expr "]", with the optional forms ".?" and
// "[?". A call is longer than the selection of its name, so it wins where both match. The optional marker is a
// capture, and Optional says whether it matched, so that three lines do the work of five: the Operators Rule loop tries every
// line at the end of every operand, and five took 13% more time to build the AST of a long expression. A left
// recursive rule for each suffix took 51% more time to recognize typical expressions and 70% more a long one.
rule member Expr = operators {
    skip ws
    operand primary
    level {
        postfix "." ws q:"?"? ws f:name => Select{X: $lhs, Field: $f, Optional: len($q) > 0}
        postfix "." ws f:name_plain ws "(" ws as:args? ws ")" => Call{Target: $lhs, Func: $f, Args: concat($as)}
        postfix "[" ws q:"?"? ws i:expr ws "]" => Index{X: $lhs, Index: $i, Optional: len($q) > 0}
    }
}

// ---- Primary expressions ----

// Primary = ["."] IDENT ["(" [ExprList] ")"] | "(" Expr ")" | "[" ... "]" | "{" ... "}" | ["."] SELECTOR {"." SELECTOR}
// "{" ... "}" | LITERAL. The alternative is chosen by the first character, with lookaheads, which cost one test and
// record nothing in the message of a syntax error (expected_start makes up for it): a name, for example, has to fail
// ten literals before it is read as an identifier otherwise. Without them, Recognize took 26% more time.
rule primary Expr = (
    &[A-Za-z_] v:(word_lit / message / ident_only / call) / &[0-9] v:(int_plain / double / uint / int) / &["'] v:string / &"." v:(double / message / call / ident) / &"-" v:(double / int) / v:(paren / list / map / expected_start)
) => $v
// It never matches: it only makes the error message of an operand list the characters that an operand starts with,
// which the lookaheads of the alternatives above do not record (lookaheads leave out of the message what they test).
rule expected_start IntLit = t:(![A-Za-z_] [A-Za-z_] / ![0-9] [0-9] / !["'] ["'] / !"." "." / !"-" "-") #atomic => IntLit{Text: text($t)}
// A word that is a literal: true, false, null, a raw string r"..." or a bytes literal b"...".
rule word_lit Expr = &[tf] v:bool / &"n" v:null / &[rR] v:string / &[bB] v:bytes => $v

rule paren Paren = "(" ws e:expr ws ")" => Paren{X: $e}

// An identifier that is not called, then a call: a call first took 4% more time.
rule ident_only Ident = i:ident !(ws "(") => $i
rule ident Ident = t:(("." ws)? name_global) #atomic => Ident{Text: text($t)}
rule call Call = f:ident ws "(" ws as:args? ws ")" => Call{Target: nil, Func: $f, Args: concat($as)}
rule args = first:expr rest:(-ws -"," -ws x:expr)* => concat(list($first), map($rest, (r) => r.$x))

rule list ListLit = "[" ws es:elems? ws ","? ws "]" => ListLit{Elems: concat($es)}
rule elems = first:elem rest:(-ws -"," -ws x:elem)* => concat(list($first), map($rest, (r) => r.$x))
rule elem Expr = optional / expr
rule optional Optional = "?" ws x:expr => Optional{X: $x}

rule map MapLit = "{" ws es:entries? ws ","? ws "}" => MapLit{Entries: concat($es)}
rule entries = first:entry rest:(-ws -"," -ws x:entry)* => concat(list($first), map($rest, (r) => r.$x))
rule entry Entry = opt_entry / plain_entry
rule opt_entry Entry = "?" ws k:expr ws ":" ws v:expr => Entry{Key: $k, Value: $v, Optional: true}
rule plain_entry Entry = k:expr ws ":" ws v:expr => Entry{Key: $k, Value: $v, Optional: false}

// A message is a possibly dotted name followed by "{". Its parts may be reserved words (a name that is not a
// keyword), unlike a variable or a function. Most operands that start with a name are not a message, so a lookahead
// reads the name by character classes before the rule reads it as names, which saves 3% of the time.
rule message MessageLit = (
    &(("." ws)? [A-Za-z_] [A-Za-z0-9_]* (ws "." ws [A-Za-z_] [A-Za-z0-9_]*)* ws "{")
    t:type_name ws "{" ws fs:fields? ws ","? ws "}"
) => MessageLit{Type: $t, Fields: concat($fs)}
rule type_name Ident = t:(("." ws)? name_plain (ws "." ws name_plain)*) #atomic => Ident{Text: text($t)}
rule fields = first:field rest:(-ws -"," -ws x:field)* => concat(list($first), map($rest, (r) => r.$x))
rule field Field = opt_field / plain_field
rule opt_field Field = "?" ws n:name ws ":" ws v:expr => Field{Name: $n, Value: $v, Optional: true}
rule plain_field Field = n:name ws ":" ws v:expr => Field{Name: $n, Value: $v, Optional: false}

// ---- Literals ----
//
// A literal is what the lexer of cel-go reads as one token, longest first: a float is tried before an unsigned and
// a signed integer. The sign of a number is part of the literal (and may be followed by whitespace and comments);
// a sign before an unsigned integer is a negation.

rule bool BoolLit = t:(("true" / "false") ![A-Za-z0-9_]) #atomic => BoolLit{Text: text($t)}
rule null NullLit = t:("null" ![A-Za-z0-9_]) #atomic => NullLit{Text: text($t)}

// Most integers are decimal, and not followed by anything that could continue a number.
rule int_plain IntLit = t:([0-9]+ ![0-9a-zA-Z_.]) #atomic => IntLit{Text: text($t)}
rule sign = "-" ws
rule double DoubleLit = t:(sign? ([0-9]+ "." [0-9]+ exponent? / [0-9]+ exponent / "." [0-9]+ exponent?)) #atomic => DoubleLit{Text: text($t)}
rule exponent = [eE] [+\-]? [0-9]+
rule uint UintLit = t:(("0x" [0-9a-fA-F]+ / [0-9]+) [uU]) #atomic => UintLit{Text: text($t)}
rule int IntLit = t:(sign? ("0x" [0-9a-fA-F]+ / [0-9]+) ![uU]) #atomic => IntLit{Text: text($t)}

// Strings: single or triple quotes, raw or with escape sequences, and a b prefix for bytes. A triple-quoted string
// ends at the first closing triple quote. Escapes are checked here as cel-go's unescape does, which rejects them
// after the lexer has read them: a surrogate in \u and \U, a code point over 10FFFF, and \u and \U in bytes.
rule string StringLit = t:([rR] &["'] raw_body / str_body) #atomic => StringLit{Text: text($t)}
rule bytes BytesLit = t:([bB] ([rR] &["'] raw_body / bytes_body)) #atomic => BytesLit{Text: text($t)}

rule raw_body = "\"\"\"" (!"\"\"\"" .)* "\"\"\"" / "'''" (!"'''" .)* "'''" / "\"" [^"\n\r]* "\"" / "'" [^'\n\r]* "'"

// The quote is read once, then whether it opens three.
rule str_body = (
    "\"" ("\"\"" (str_esc / [^"\\]+ / "\"" !"\"\"")* "\"\"\"" / (str_esc / [^"\\\n\r]+)* "\"")
    / "'" ("''" (str_esc / [^'\\]+ / "'" !"''")* "'''" / (str_esc / [^'\\\n\r]+)* "'")
)
rule bytes_body = (
    "\"" ("\"\"" (bytes_esc / [^"\\]+ / "\"" !"\"\"")* "\"\"\"" / (bytes_esc / [^"\\\n\r]+)* "\"")
    / "'" ("''" (bytes_esc / [^'\\]+ / "'" !"''")* "'''" / (bytes_esc / [^'\\\n\r]+)* "'")
)

rule bytes_esc = "\\" ([abfnrtv"'\\?`] / [0-3] [0-7] [0-7] / [xX] hex hex)
rule str_esc = (
    bytes_esc
    / "\\u" !([dD] [89a-fA-F]) hex hex hex hex
    / "\\U" !("0000" [dD] [89a-fA-F]) "00" ("0" hex #repeat(5) / "10" hex #repeat(4))
)
rule hex = [0-9a-fA-F]

// ---- Names ----
//
// Characters are tested by classes written out, since a rule for each of them costs a call: a rule for the
// characters of a name took 10% more time to recognize typical expressions.

// A name that is not one of the keywords true, false, null and in: a selector, a field, a method and a part of a message.
rule name_plain Ident = t:(!(("true" / "false" / "null" / "in") ![A-Za-z0-9_]) [A-Za-z_] [A-Za-z0-9_]*) #atomic => Ident{Text: text($t)}
// A variable or a function must not be a reserved word either.
rule name_global = (
    !(("true" / "false" / "null" / "in" / "as" / "break" / "const" / "continue" / "else" / "for" / "function" / "if" / "import" / "let" / "loop" / "package" / "namespace" / "return" / "var" / "void" / "while") ![A-Za-z0-9_])
    [A-Za-z_] [A-Za-z0-9_]*
)
// A field may be escaped with backquotes.
rule name Name = t:(name_plain / "`" [A-Za-z0-9_.\-/ ]+ "`") #atomic => Name{Text: text($t)}

// Whitespace and comments. It calls no other rule: a rule that does is memoized, and a ws that called another rule
// for its body took 14% more time to recognize typical expressions.
rule ws = [ \t\r\n\u{c}]* ("//" [^\n]* [ \t\r\n\u{c}]*)*
