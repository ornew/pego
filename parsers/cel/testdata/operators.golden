Conditional{Cond: Binary{Left: Call{Args: ["g" Binary{Left: "g", Op: "in", Right: ListLit{Elems: ["\"admin\"" "\"ops\""]}}], Func: "exists", Target: Select{Field: "groups", Optional: false, X: Select{Field: "claims", Optional: false, X: Select{Field: "auth", Optional: false, X: "request"}}}}, Op: "&&", Right: Unary{Op: "!", X: Paren{X: Binary{Left: Select{Field: "name", Optional: false, X: "resource"}, Op: "==", Right: "\"x\""}}}}, Else: "\"no\"", Then: "\"yes\""}
