Conditional{Cond: Binary{Left: Call{Args: [Ident("g") Binary{Left: Ident("g"), Op: "in", Right: ListLit{Elems: [StringLit("\"admin\"") StringLit("\"ops\"")]}}], Func: Ident("exists"), Target: Select{Field: Name("groups"), Optional: false, X: Select{Field: Name("claims"), Optional: false, X: Select{Field: Name("auth"), Optional: false, X: Ident("request")}}}}, Op: "&&", Right: Unary{Op: "!", X: Paren{X: Binary{Left: Select{Field: Name("name"), Optional: false, X: Ident("resource")}, Op: "==", Right: StringLit("\"x\"")}}}}, Else: StringLit("\"no\""), Then: StringLit("\"yes\"")}
