// CSV (RFC 4180), parsed into a typed AST.
//
// The syntax is the RFC's, with the leniencies of encoding/csv: records end with CRLF or LF; a CR is
// data unless it ends a line or the input; fields hold any character but the RFC's delimiters. A
// byte order mark at the start is skipped. An empty line is a record with one empty field, as in the
// RFC's grammar (Records in csv.go drops such records, as encoding/csv does). Records can be consumed
// one at a time with the engine thanks to #stream (pego parse -stream); generated parsers ignore it.
package csv

type File struct { Records []Record }
type Record struct { Fields []Field }
type Field terminal  // the raw field: a quoted field keeps its quotes and doubled ""

def main: File = -"\u{feff}"? rs:record* #stream $$ -> new File{Records: $rs}

// A record's span includes its line break (its fields end at the End of the last one): a rule that
// leaves the line break out (`!$$ r:record eol -> $r`) makes ParseAST about 7% slower.
def record: Record = !$$ first:field rest:(-"," f:field)* eol
    -> new Record{Fields: concat(list($first), map($rest, (r) => $r.f))}

// A quoted field, then an unquoted one: runs of ordinary characters separated by the rare ones ("" in
// a quoted field, a CR that does not end the line in an unquoted one). Written inline rather than as
// rules of their own, and as runs rather than a repetition of a choice ((?^")+ / "\"\""), it makes
// ParseAST about 8% faster and Recognize about 25%.
def field: Field = "\"" (?^")* ("\"\"" (?^")*)* "\""
    / (?^,"\r\n)* ("\r" &(?^\n) (?^,"\r\n)*)*

def eol = "\r\n" / "\n" / "\r"? $$
