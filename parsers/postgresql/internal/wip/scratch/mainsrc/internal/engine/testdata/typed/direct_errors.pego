// Direct rules of the typed runtime: predicates reading captures, #error, recovered errors of a
// callee undone when the caller backtracks (and replayed from the memo), anchors, bounded
// repetitions, ., _ and _|_, and choices whose later alternatives can never be tried.
type Name terminal
type T struct { Open Name, Close Name, Note *Name, Tail *Match, Pick *Match, Ws []Match }
type D struct { Ts []T, End *Match }
def main: D = ^^ ts:(t:tag ";" / t:tag ".")* e:end $$ -> new D{Ts: map($ts, (x) => $x.t), End: $e}
def tag: T = "<" a:name ">" ("w" _|_ / "w")? b:name [text($a) == text($b)] #error(message="mismatched") n:note?
    k:("Q"? / "Z") ws:(-"," w:@(?0-9){2,3})* "\n"? x:(@(^ "!") / @$ / _)
    -> new T{Open: $a, Close: $b, Note: $n, Tail: $k, Pick: $x, Ws: map($ws, (y) => $y.w)}
def note: Name = "/" m:rname -> $m
def rname: Name = (?a-z)+ #recover(skip=(?0-9)+)
def end = @(.{0,2} "\n"?)
def name: Name = (?a-z)+
