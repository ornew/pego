// PostgreSQL 18 SQL, parsed into a typed AST.
//
// The grammar follows gram.y and scan.l of the PostgreSQL 18 parser (the productions of gram.y are
// restructured where a PEG needs it, and a comment says why), and the types follow the nodes of its raw
// parse tree (src/include/nodes/parsenodes.h and primnodes.h) with the same names and fields, so that a
// tree can be compared with the one libpg_query returns (see rawjson.go). They differ from the raw tree
// where the parser's actions inspect and rewrite nodes that were built before (merging ORDER BY into a
// select, splitting the qualifiers of a column, folding a negative number, ...); rawjson.go makes the
// same changes when it converts a tree. Names and strings are kept as source text (Ident, Sconst, ...);
// the functions of postgresql.go decode them.
//
// Tokens consume the white space and comments that follow them, so a node starts at its first token and
// ends after the white space that follows its last token.
package postgresql

// ---- Tokens: values keep their source text ----

type Ident terminal   // a name: unquoted (any case), "quoted", U&"unicode", or a keyword used as a name
type OpTok terminal   // an operator
type Iconst terminal  // an integer literal that fits in an int32
type Fconst terminal  // any other number
type Sconst terminal  // a string literal: 'text', E'text', U&'text', $$text$$
type Bconst terminal  // B'101'
type Xconst terminal  // X'1F'
type Param terminal   // $1

// ---- Values of the raw tree that have no source text ----

type String struct { Sval string }
type Integer struct { Ival int }
type Boolean struct { Boolval bool }
// A List node: a list that is a value of its own, not the field of a node.
type NodeList struct { Items []Any }
type A_Star struct { }

// A name in a list of names: a source name, an operator, or a name the parser makes up (pg_catalog).
type Str = String | Ident | OpTok

// ---- Expressions ----

type ConstVal = String | Ident | Integer | Iconst | Fconst | Sconst | Bconst | Xconst | Boolean | SignedNum
type A_Const struct { Isnull bool, Val *ConstVal }
type ParamRef struct { Number Param }
type ColumnRef struct { Fields []ColField }
type ColField = Ident | A_Star
type Indirection = Ident | A_Star | A_Indices
type A_Indices struct { IsSlice bool, Lidx *Expr, Uidx *Expr }
type A_Indirection struct { Arg Expr, Indirection []Indirection }
type A_ArrayExpr struct { Elements []Expr }
type A_Expr struct { Kind string, Name []Str, Lexpr *Expr, Rexpr *Expr }
type BoolExpr struct { Boolop string, Args []Expr }
type FuncCall struct {
    Funcname []Str, Args []Expr, AggOrder []SortBy, AggFilter *Expr, Over *WindowDef,
    AggWithinGroup bool, AggStar bool, AggDistinct bool, FuncVariadic bool, Funcformat string
}
type NamedArgExpr struct { Arg Expr, Name Ident, Argnumber int }
type TypeCast struct { Arg Expr, TypeName TypeName }
type CollateClause struct { Arg Expr, Collname []Ident }
type SubLink struct { SubLinkType string, Testexpr *Expr, OperName []Str, Subselect SelectStmt }
type CaseExpr struct { Arg *Expr, Args []CaseWhen, Defresult *Expr }
type CaseWhen struct { Expr Expr, Result Expr }
type RowExpr struct { Args []Expr, RowFormat string }
type CoalesceExpr struct { Args []Expr }
type MinMaxExpr struct { Op string, Args []Expr }
type SQLValueFunction struct { Op string, Typmod *Iconst }
type NullTest struct { Arg Expr, Nulltesttype string }
type BooleanTest struct { Arg Expr, Booltesttype string }
type SetToDefault struct { }
type GroupingFunc struct { Args []Expr }
type MergeSupportFunc struct { }

type TreatExpr struct { Arg Expr, TypeName TypeName }
type GroupingSet struct { Kind string, Content []Expr }

type Expr = A_Const | ParamRef | ColumnRef | A_Indirection | A_ArrayExpr | A_Expr | BoolExpr | FuncCall |
    NamedArgExpr | TypeCast | CollateClause | SubLink | CaseExpr | RowExpr | CoalesceExpr | MinMaxExpr |
    SQLValueFunction | NullTest | BooleanTest | SetToDefault | GroupingFunc | MergeSupportFunc | NodeList |
    TreatExpr | GroupingSet | MultiAssignRef | CurrentOfExpr | ExprD

type ArrayBound = Integer | Iconst
type TypeName struct {
    Names []Str, Setof bool, PctType bool, Typmods []Expr, Typemod int, ArrayBounds []ArrayBound
}

type SortBy struct { Node Expr, SortbyDir string, SortbyNulls string, UseOp []Str }
type WindowDef struct {
    Name *Ident, Refname *Ident, PartitionClause []Expr, OrderClause []SortBy, FrameOptions int,
    StartOffset *Expr, EndOffset *Expr
}

// ---- Queries ----

type Alias struct { Aliasname Ident, Colnames []Ident }
type RangeVar struct {
    Catalogname *Ident, Schemaname *Ident, Relname Ident, Inh bool, Relpersistence string, Alias *Alias
}
type ResTarget struct { Name *Ident, Indirection []Indirection, Val *Expr }
type WithClause struct { Ctes []CommonTableExpr, Recursive bool }
type CommonTableExpr struct {
    Ctename Ident, Aliascolnames []Ident, Ctematerialized string, Ctequery DmlStmt,
    SearchClause *CTESearchClause, CycleClause *CTECycleClause
}
type CTESearchClause struct { SearchColList []Ident, SearchBreadthFirst bool, SearchSeqColumn Ident }
type CTECycleClause struct {
    CycleColList []Ident, CycleMarkColumn Ident, CycleMarkValue Expr, CycleMarkDefault Expr, CyclePathColumn Ident
}
type IntoClause struct {
    Rel RangeVar, ColNames []Ident, AccessMethod *Ident, Options []DefElem, OnCommit string, TableSpaceName *Ident,
    SkipData bool
}
type LockingClause struct { LockedRels []RangeVar, Strength string, WaitPolicy string }
type SelectStmt struct {
    Distinct bool, DistinctOn []Expr, IntoClause *IntoClause, TargetList []ResTarget, FromClause []TableRef,
    WhereClause *Expr, GroupClause []Expr, GroupDistinct bool, HavingClause *Expr, WindowClause []WindowDef,
    ValuesLists []NodeList, SortClause []SortBy, LimitOffset *Expr, LimitCount *Expr, LimitWithTies bool,
    LockingClause []LockingClause, WithClause *WithClause, Op string, All bool, Larg *SelectStmt,
    Rarg *SelectStmt
}

type Script struct { Stmts []RawStmt }
type RawStmt struct { Stmt Stmt }
type DmlStmt = SelectStmt | InsertStmt | UpdateStmt | DeleteStmt | MergeStmt
// Stmt: every statement. StmtA, StmtB and StmtC are the unions of the statements of the other files.
type Stmt = DmlStmt | StmtC2 | StmtA | StmtB | StmtC | StmtB2

type RangeSubselect struct { Lateral bool, Subquery SelectStmt, Alias *Alias }
type RangeFunction struct {
    Lateral bool, Ordinality bool, IsRowsfrom bool, Functions []RangeFuncItem, Alias *Alias, Coldeflist []ColumnDef
}
type RangeFuncItem struct { Func Expr, Coldeflist []ColumnDef }
type RangeTableSample struct { Relation RangeVar, Method []Ident, Args []Expr, Repeatable *Expr }
type JoinExpr struct {
    Jointype string, IsNatural bool, Larg *TableRef, Rarg *TableRef, UsingClause []Ident,
    JoinUsingAlias *Alias, Quals *Expr, Alias *Alias
}
type TableRef = RangeVar | RangeSubselect | RangeFunction | JoinExpr | RangeTableSample | TableRefD

// The union of all node types is generated: see the end of the file.

// ---- Types of the statements and the rules they share ----

type MultiAssignRef struct { Source Expr, Colno int, Ncolumns int }
type CurrentOfExpr struct { CursorName Ident }
type ReturningOption struct { Option string, Value Ident }
type ReturningClause struct { Options []ReturningOption, Exprs []ResTarget }
type InferClause struct { IndexElems []IndexElem, WhereClause *Expr, Conname *Ident }
type OnConflictClause struct { Action string, Infer *InferClause, TargetList []ResTarget, WhereClause *Expr }
type IndexElem struct {
    Name *Ident, Expr *Expr, Indexcolname *Ident, Collation []Ident, Opclass []Ident, Opclassopts []DefElem,
    Ordering string, NullsOrdering string
}
type InsertStmt struct {
    Relation RangeVar, Cols []ResTarget, SelectStmt *SelectStmt, OnConflictClause *OnConflictClause,
    ReturningClause *ReturningClause, WithClause *WithClause, Override string
}
type UpdateStmt struct {
    Relation RangeVar, TargetList []ResTarget, WhereClause *Expr, FromClause []TableRef,
    ReturningClause *ReturningClause, WithClause *WithClause
}
type DeleteStmt struct {
    Relation RangeVar, UsingClause []TableRef, WhereClause *Expr, ReturningClause *ReturningClause,
    WithClause *WithClause
}
type MergeWhenClause struct {
    MatchKind string, CommandType string, Override string, Condition *Expr, TargetList []ResTarget,
    Values []Expr
}
type MergeStmt struct {
    Relation RangeVar, SourceRelation TableRef, JoinCondition Expr, MergeWhenClauses []MergeWhenClause,
    ReturningClause *ReturningClause, WithClause *WithClause
}

// A signed number in an option (NumericOnly, SignedIconst): rawjson.go folds the sign into the number.
type Num = Iconst | Fconst
type SignedNum struct { Negative bool, Number Num }
type NumericOnly = Iconst | Fconst | SignedNum
type SignedIconst = Iconst | SignedNum

type DefArg = TypeName | Ident | NodeList | NumericOnly | Sconst | String | Boolean | Integer | A_Const | A_Star
type DefName = Ident | String
type DefElem struct { Defnamespace *Ident, Defname DefName, Arg *DefArg, Defaction string }
type RoleSpec struct { Roletype string, Rolename *Ident }
type FunctionParameter struct { Name *Ident, ArgType TypeName, Mode string, Defexpr *Expr }
// ObjectWithArgs: objargs, the types of the arguments that are not OUT, is computed from Objfuncargs
type ObjectWithArgs struct {
    Objname []Str, Objargs []ObjArg, Objfuncargs []FunctionParameter, ArgsUnspecified bool, Aggr *AggrArgs
}

// ==== Lexical rules (scan.l) ====
//
// There is no separate scanner: every token rule consumes the white space and comments (s) that follow
// it, so a node starts at its first token and ends after the white space that follows its last one.
// Keywords are matched case-insensitively and must not be followed by an identifier character; the rules
// of the keywords (and the lists that exclude them from names) are generated at the end of this file.

// White space and comments: space, \t, \n, \r, \f and \v, "--" to the end of the line, and nested
// "/* */" comments. The fast path is plain white space.
def s = (? \t\n\r\f\v)* (("--" (?^\n\r)* / block_comment) (? \t\n\r\f\v)*)*
def block_comment = "/*" ((?^*/)+ / block_comment / "*" !"/" / "/" !"*")* "*/"

def ident_start = (?A-Za-z_\u{80}-\u{10FFFF})
def ident_cont = (?A-Za-z0-9_$\u{80}-\u{10FFFF})

// ---- Punctuation and operators ----
//
// An operator is a run of the characters ~!@#^&|`?+-*/%<>= that stops before "--" or "/*". As in scan.l,
// a run that ends in + or - and has none of the characters ~!@#^&|`?% loses those trailing characters
// (so that "=-" is = and -), and a run that is exactly one of the self characters, <=, >=, <>, != or =>
// is that token and not an operator (Op).
def cstart = "--" / "/*"
def opc = !cstart (?~!@#%^&|`?+\-*/<>=)
def pm = !cstart (?+\-)
def plain_end = pm* !opc

def COMMA = "," s
def LP = "(" s
def RP = ")" s
def LB = "[" s
def RB = "]" s
def SEMI = ";" s
def COLON = ":" !(?:=) s
def DOT = "." !(?0-9.) s
def TYPECAST = "::" s
def COLON_EQUALS = ":=" s
def PLUS = "+" &plain_end s
def MINUS = "-" &plain_end s
def STAR = "*" &plain_end s
def SLASH = "/" &plain_end s
def LT = "<" &plain_end s
def GT = ">" &plain_end s
def EQ = "=" &plain_end s
def PERCENT = "%" !opc s
def CARET = "^" !opc s
def LESS_EQUALS = "<=" &plain_end s
def GREATER_EQUALS = ">=" &plain_end s
def EQUALS_GREATER = "=>" &plain_end s
def NOT_EQUALS = ("<>" &plain_end / "!=" !opc) s

// An operator other than the tokens above. t is its text, without the white space after it.
def Op: OpTok = t:op_text s -> $t
def op_text: OpTok =
    !(("<=" / ">=" / "<>" / "=>") &plain_end) !(("!=" / "%" / "^") !opc)
    ( &((!cstart (?*/<>=+\-))* !cstart (?~!@#%^&|`?)) opc+
    / opc (pm* !cstart (?*/<>=))+ )

// ---- Identifiers ----

// A word, unless it is an E, B, X or N string or a U& literal. "n'x'" is the keyword NCHAR and a string.
def word = !((?eEbBxXnN) "'" / (?uU) "&" (?'")) ident_start ident_cont*
def quoted_ident = "\"" ((?^")+ / "\"\"")+ "\""
// U&"..." with an optional UESCAPE 'c'
def uident = (?uU) "&" "\"" ((?^")+ / "\"\"")+ "\"" (s (?uU)(?sS)(?cC)(?aA)(?pP)(?eE) !ident_cont s uescape_char)?
def uescape_char = "'" (?^0-9a-fA-F+'" \t\n\r\f\v) "'"

// IDENT: a name that is not a keyword.
def IDENT: Ident = t:ident_text s -> $t
def ident_text: Ident = quoted_ident / uident / !reserved_or_type_func_word !col_name_word word

// ColId: any name that is not a reserved or type_func_name keyword.
def ColId: Ident = t:colid_text s -> $t
def colid_text: Ident = quoted_ident / uident / !reserved_or_type_func_word word
// type_function_name: a name that is not a reserved or column-name keyword.
def type_function_name: Ident = t:tfn_text s -> $t
def tfn_text: Ident = quoted_ident / uident / !reserved_or_col_name_word word
// NonReservedWord: a name that is not a reserved keyword.
def NonReservedWord: Ident = t:nrw_text s -> $t
def nrw_text: Ident = quoted_ident / uident / !reserved_word word
// ColLabel: any name or keyword.
def ColLabel: Ident = t:collabel_text s -> $t
def collabel_text: Ident = quoted_ident / uident / word
// BareColLabel: a name or a keyword that may follow an expression without AS.
def BareColLabel: Ident = t:bare_text s -> $t
// FORMAT followed by JSON is the token FORMAT_LA of gram.y (the start of FORMAT JSON), not a label
def bare_text: Ident = quoted_ident / uident / !label_only_word !(FORMAT JSON) word

// ---- Numbers ----
//
// ICONST is an integer literal that fits in an int32, FCONST every other number. Underscores may separate
// digits. A number must not be followed by an identifier character ("1a" is an error), and an integer not
// by a fraction. The size of a decimal integer is compared with 2147483647 after its leading zeros; the
// other forms (with underscores, 0x, 0o, 0b) are integers if they have at most 9 characters, which is
// exact for them up to 7 hexadecimal, 9 octal... digits, and treats the larger ones that would fit as FCONST.
def decinteger = (?0-9) ("_"? (?0-9))*
def hexinteger = "0" (?xX) ("_"? (?0-9a-fA-F))+
def octinteger = "0" (?oO) ("_"? (?0-7))+
def bininteger = "0" (?bB) ("_"? (?01))+
def numeric = decinteger "." !"." decinteger? / "." decinteger
def real = (decinteger !("." !".") / numeric) (?eE) (?+\-)? decinteger
def number_end = !ident_start

// hexadecimal, octal and binary integers that fit in an int32 (the digits after the leading zeros are at
// most 7 hexadecimal digits, or 8 with a first digit of at most 7; 10 octal, or 11 starting with 1; 30
// binary, or 31 starting with 1)
def int32_hex = "0" (?xX) ( ("_"? "0")+ !("_"? (?0-9a-fA-F))
    / ("_"? "0")* "_"? (?1-9a-fA-F) ("_"? (?0-9a-fA-F)){0,6} !("_"? (?0-9a-fA-F))
    / ("_"? "0")* "_"? (?1-7) ("_"? (?0-9a-fA-F)){7} !("_"? (?0-9a-fA-F)) )
def int32_oct = "0" (?oO) ( ("_"? "0")+ !("_"? (?0-7))
    / ("_"? "0")* "_"? (?1-7) ("_"? (?0-7)){0,9} !("_"? (?0-7))
    / ("_"? "0")* "_"? "1" ("_"? (?0-7)){10} !("_"? (?0-7)) )
def int32_bin = "0" (?bB) ( ("_"? "0")+ !("_"? (?01))
    / ("_"? "0")* "_"? "1" ("_"? (?01)){0,30} !("_"? (?01)) )

def Iconst: Iconst = t:iconst_text s -> $t
def iconst_text: Iconst =
    ( "0"* d:@((?1-9) (?0-9)*) [len($d) < 10 || (len($d) == 10 && text($d) <= "2147483647")] / "0"+ ) number_end !("." !".")
    / &(int32_hex / int32_oct / int32_bin) (hexinteger / octinteger / bininteger) number_end
    / x:@decinteger [len($x) <= 9] number_end !("." !".")
def Fconst: Fconst = t:fconst_text s -> $t
def fconst_text: Fconst =
    (real / numeric) number_end
    / !iconst_text (hexinteger / octinteger / bininteger / decinteger) number_end !("." !".")

// A positional parameter, $1.
def PARAM: Param = t:param_text s -> $t
def param_text: Param = "$" (?0-9)+ number_end

// ---- Strings ----
//
// SCONST: 'text' ('' is a quote), E'text' with backslash escapes, U&'text' with an optional UESCAPE, and
// dollar-quoted $tag$text$tag$. Adjacent strings that are separated by white space with a newline are
// one string. The Sconst keeps the source text; Value decodes it.
def sq_text = ((?^')+ / "''")*
def e_text = ((?^\\')+ / "''" / e_escape)*
def e_escape = "\\" ( "u" hex4 / "U" hex4 hex4 / "x" hex hex? / (?0-7) (?0-7)? (?0-7)? / (?^0-7uUx) / "x" )
def hex = (?0-9a-fA-F)
def hex4 = hex hex hex hex
// white space with at least one newline, between the parts of one string
def str_cont = ((? \t\f\v) / "--" (?^\n\r)*)* (?\n\r) ((? \t\n\r\f\v)+ / "--" (?^\n\r)* (?\n\r))*
def Sconst: Sconst = t:sconst_text s -> $t
def sconst_text: Sconst = sq_string / e_string / u_string / dollar_string
def sq_string = "'" sq_text "'" (str_cont "'" sq_text "'")*
def e_string = (?eE) "'" e_text "'" (str_cont "'" e_text "'")*
def u_string = (?uU) "&'" sq_text "'" (str_cont "'" sq_text "'")*
    (s (?uU)(?sS)(?cC)(?aA)(?pP)(?eE) !ident_cont s uescape_char)?
def dollar_string = "$" t:dollar_tag "$" [dolq = text($t)] dollar_body "$" dollar_tag "$"
def dollar_tag = (?A-Za-z_\u{80}-\u{10FFFF}) (?A-Za-z0-9_\u{80}-\u{10FFFF})* / _
def dollar_body = ((?^$)+ / !dollar_end "$")*
def dollar_end = "$" e:dollar_tag "$" [text($e) == dolq]
// B'101' and X'1F'
def Bconst: Bconst = t:bconst_text s -> $t
def bconst_text: Bconst = (?bB) "'" (?^')* "'" (str_cont "'" (?^')* "'")*
def Xconst: Xconst = t:xconst_text s -> $t
def xconst_text: Xconst = (?xX) "'" (?^')* "'" (str_cont "'" (?^')* "'")*

// ==== Names ====

def name = ColId
def attr_name = ColLabel
def any_name: []Ident = first:ColId rest:(-DOT x:attr_name)* -> concat(list($first), map($rest, (r) => $r.x))
def attrs: []Ident = xs:(-DOT x:attr_name)+ -> map($xs, (r) => $r.x)
def name_list: []Ident = first:name rest:(-COMMA x:name)* -> concat(list($first), map($rest, (r) => $r.x))

// func_name: a type_function_name, or ColId followed by attributes
def func_name: []Ident = func_name_qualified / func_name_simple
def func_name_qualified: []Ident = first:ColId rest:(-DOT x:attr_name)+ -> concat(list($first), map($rest, (r) => $r.x))
def func_name_simple: []Ident = x:type_function_name -> list($x)

// qualified_name: the RangeVar of one, two or three names
def qualified_name: RangeVar = qualified_name3 / qualified_name2 / qualified_name1
def qualified_name1: RangeVar = r:ColId
    -> new RangeVar{Relname: $r, Inh: true, Relpersistence: "p"}
def qualified_name2: RangeVar = &(ColId DOT) s:ColId -DOT r:attr_name
    -> new RangeVar{Schemaname: $s, Relname: $r, Inh: true, Relpersistence: "p"}
def qualified_name3: RangeVar = &(ColId DOT attr_name DOT) c:ColId -DOT s:attr_name -DOT r:attr_name
    -> new RangeVar{Catalogname: $c, Schemaname: $s, Relname: $r, Inh: true, Relpersistence: "p"}
def qualified_name_list: []RangeVar = first:qualified_name rest:(-COMMA x:qualified_name)*
    -> concat(list($first), map($rest, (r) => $r.x))

// ==== Constants ====

// AexprConst. The typed forms (a type name and a string) come after the literals.
def AexprConst: Expr = iconst_expr / fconst_expr / sconst_expr / bconst_expr / xconst_expr / typed_const
    / true_expr / false_expr / null_expr
def iconst_expr: A_Const = v:Iconst -> new A_Const{Val: $v}
def fconst_expr: A_Const = v:Fconst -> new A_Const{Val: $v}
def sconst_expr: A_Const = v:Sconst -> new A_Const{Val: $v}
def bconst_expr: A_Const = v:Bconst -> new A_Const{Val: $v}
def xconst_expr: A_Const = v:Xconst -> new A_Const{Val: $v}
def true_expr: A_Const = TRUE -> new A_Const{Val: new Boolean{Boolval: true}}
def false_expr: A_Const = FALSE -> new A_Const{Val: new Boolean{Boolval: false}}
def null_expr: A_Const = NULL -> new A_Const{Isnull: true}

// A string cast to a type: type 'text', with the type a keyword, an interval or a name.
def typed_const: TypeCast = interval_const / interval_prec_const / const_typename_const / func_modifiers_const / func_name_const
def const_typename_const: TypeCast = [setof = false] [consttype = true] t:typename_core v:Sconst
    -> new TypeCast{Arg: new A_Const{Val: $v}, TypeName: $t}
def func_name_const: TypeCast = n:func_name v:Sconst
    -> new TypeCast{Arg: new A_Const{Val: $v}, TypeName: new TypeName{Names: $n, Typemod: -1}}
def func_modifiers_const: TypeCast = n:func_name LP a:expr_list RP v:Sconst
    -> new TypeCast{Arg: new A_Const{Val: $v}, TypeName: new TypeName{Names: $n, Typmods: $a, Typemod: -1}}
def interval_const: TypeCast = INTERVAL v:Sconst tm:interval_fields?
    -> new TypeCast{Arg: new A_Const{Val: $v}, TypeName: new TypeName{Names: list(new String{Sval: "pg_catalog"}, new String{Sval: "interval"}), Typmods: concat($tm), Typemod: -1}}
def interval_prec_const: TypeCast = INTERVAL -LP p:Iconst -RP v:Sconst
    -> new TypeCast{Arg: new A_Const{Val: $v}, TypeName: new TypeName{Names: list(new String{Sval: "pg_catalog"}, new String{Sval: "interval"}), Typmods: list(new A_Const{Val: new Integer{Ival: 32767}}, new A_Const{Val: $p}), Typemod: -1}}

// ==== Type names ====
//
// The raw parser builds the TypeName of a SimpleTypename and then sets arrayBounds and setof on it. Here
// one rule, typename_core, matches every form of a type name and builds the node; the variable setof is
// set by SETOF, and the variable consttype restricts the rule to the keyword types that may be followed
// by a string constant (and removes the defaults for CHAR and BIT without length).

def Typename: TypeName = typename_setof / typename_plain
def typename_setof: TypeName = SETOF [setof = true] [consttype = false] t:typename_core -> $t
def typename_plain: TypeName = [setof = false] [consttype = false] t:typename_core -> $t
def SimpleTypename: TypeName = typename_plain
def type_list: []TypeName = first:Typename rest:(-COMMA x:Typename)* -> concat(list($first), map($rest, (r) => $r.x))

def typename_core: TypeName =
    ( n:ty_int4 / n:ty_int2 / n:ty_int8 / n:ty_float4 / n:ty_float8 / n:ty_bool
    / n:ty_numeric tm:opt_type_modifiers?
    / n:ty_varbit tm:opt_type_modifiers?
    / n:ty_bit tm:opt_type_modifiers
    / n:ty_bit d:bit_default?
    / n:ty_varchar tm:char_length?
    / n:ty_bpchar tm:char_length
    / n:ty_bpchar d:char_default?
    / TIMESTAMP tm:time_precision? WITH TIME ZONE n:ty_timestamptz
    / TIMESTAMP tm:time_precision? (WITHOUT TIME ZONE)? n:ty_timestamp
    / TIME tm:time_precision? WITH TIME ZONE n:ty_timetz
    / TIME tm:time_precision? (WITHOUT TIME ZONE)? n:ty_time
    / n:ty_json
    / [!consttype] INTERVAL n:ty_interval tm:interval_typmods?
    / [!consttype] n:generic_name tm:opt_type_modifiers? )
    ab:array_suffix?
    -> new TypeName{Names: $n, Setof: setof, Typmods: concat($tm, $d), Typemod: -1, ArrayBounds: concat($ab)}

def generic_name: []Ident = first:type_function_name rest:(-DOT x:attr_name)* -> concat(list($first), map($rest, (r) => $r.x))
def opt_type_modifiers: []Expr = -LP l:expr_list -RP -> $l

def ty_int4: []Str = (INT / INTEGER) -> list(new String{Sval: "pg_catalog"}, new String{Sval: "int4"})
def ty_int2: []Str = SMALLINT -> list(new String{Sval: "pg_catalog"}, new String{Sval: "int2"})
def ty_int8: []Str = BIGINT -> list(new String{Sval: "pg_catalog"}, new String{Sval: "int8"})
def ty_bool: []Str = BOOLEAN -> list(new String{Sval: "pg_catalog"}, new String{Sval: "bool"})
def ty_numeric: []Str = (DECIMAL / DEC / NUMERIC) -> list(new String{Sval: "pg_catalog"}, new String{Sval: "numeric"})
def ty_json: []Str = JSON -> list(new String{Sval: "pg_catalog"}, new String{Sval: "json"})
def ty_interval: []Str = _ -> list(new String{Sval: "pg_catalog"}, new String{Sval: "interval"})
def ty_timestamp: []Str = _ -> list(new String{Sval: "pg_catalog"}, new String{Sval: "timestamp"})
def ty_timestamptz: []Str = _ -> list(new String{Sval: "pg_catalog"}, new String{Sval: "timestamptz"})
def ty_time: []Str = _ -> list(new String{Sval: "pg_catalog"}, new String{Sval: "time"})
def ty_timetz: []Str = _ -> list(new String{Sval: "pg_catalog"}, new String{Sval: "timetz"})
// REAL, FLOAT and FLOAT(p): the precision 1..24 is float4 and 25..53 float8 (the others are errors)
def ty_float4: []Str = ty_real / ty_float_p24
def ty_real: []Str = REAL -> list(new String{Sval: "pg_catalog"}, new String{Sval: "float4"})
def ty_float_p24: []Str = FLOAT -LP &float_p24 Iconst -RP -> list(new String{Sval: "pg_catalog"}, new String{Sval: "float4"})
def ty_float8: []Str = ty_double / ty_float_p53 / ty_float_plain
def ty_double: []Str = DOUBLE PRECISION -> list(new String{Sval: "pg_catalog"}, new String{Sval: "float8"})
def ty_float_p53: []Str = FLOAT -LP &float_p53 Iconst -RP -> list(new String{Sval: "pg_catalog"}, new String{Sval: "float8"})
def ty_float_plain: []Str = FLOAT !LP -> list(new String{Sval: "pg_catalog"}, new String{Sval: "float8"})
def float_p24 = "0"* ("1" (?0-9) / "2" (?0-4) / (?1-9)) !(?0-9_)
def float_p53 = "0"* ("2" (?5-9) / (?34) (?0-9) / "5" (?0-3)) !(?0-9_)

// BIT, BIT VARYING, CHAR, VARCHAR and their synonyms
def ty_varbit: []Str = BIT VARYING -> list(new String{Sval: "pg_catalog"}, new String{Sval: "varbit"})
def ty_bit: []Str = BIT -> list(new String{Sval: "pg_catalog"}, new String{Sval: "bit"})
def bit_default: []Expr = [!consttype] _ -> list(new A_Const{Val: new Integer{Ival: 1}})
def ty_varchar: []Str = ((CHARACTER / CHAR / NCHAR) VARYING / VARCHAR / NATIONAL (CHARACTER / CHAR) VARYING)
    -> list(new String{Sval: "pg_catalog"}, new String{Sval: "varchar"})
def ty_bpchar: []Str = (CHARACTER / CHAR / NCHAR / NATIONAL (CHARACTER / CHAR))
    -> list(new String{Sval: "pg_catalog"}, new String{Sval: "bpchar"})
def char_length: []Expr = -LP v:Iconst -RP -> list(new A_Const{Val: $v})
def char_default: []Expr = [!consttype] _ -> list(new A_Const{Val: new Integer{Ival: 1}})
def time_precision: []Expr = -LP v:Iconst -RP -> list(new A_Const{Val: $v})

// Array bounds: [] and [n] after the type, or ARRAY and ARRAY[n]
def array_suffix: []ArrayBound = [!consttype] x:(array_dims / array_keyword) -> $x
def array_dims: []ArrayBound = xs:array_dim+ -> $xs
def array_dim: ArrayBound = array_dim_unsized / array_dim_sized
def array_dim_unsized: Integer = -LB -RB -> new Integer{Ival: -1}
def array_dim_sized: Iconst = -LB n:Iconst -RB -> $n
def array_keyword: []ArrayBound = array_keyword_sized / array_keyword_plain
def array_keyword_sized: []ArrayBound = ARRAY -LB n:Iconst -RB -> list($n)
def array_keyword_plain: []ArrayBound = ARRAY -> list(new Integer{Ival: -1})

// The fields of an interval type, as a bit mask (INTERVAL_MASK of YEAR, MONTH, ... added together).
// interval_typmods is the typmods of the type name (INTERVAL(p) is the full range with a precision).
def interval_typmods: []Expr = interval_fields / interval_full_precision
def interval_full_precision: []Expr = -LP p:Iconst -RP
    -> list(new A_Const{Val: new Integer{Ival: 32767}}, new A_Const{Val: $p})
def interval_fields: []Expr =
    ( YEAR [m = 4] (TO MONTH [m = 6])?
    / MONTH [m = 2]
    / DAY [m = 8] (TO (HOUR [m = 1032] / MINUTE [m = 3080] / SECOND [m = 7176] p:interval_precision?))?
    / HOUR [m = 1024] (TO (MINUTE [m = 3072] / SECOND [m = 7168] p:interval_precision?))?
    / MINUTE [m = 2048] (TO SECOND [m = 6144] p:interval_precision?)?
    / SECOND [m = 4096] p:interval_precision? )
    -> concat(list(new A_Const{Val: new Integer{Ival: m}}), $p)
def interval_precision: []Expr = -LP v:Iconst -RP -> list(new A_Const{Val: $v})

// ==== Expressions ====
//
// a_expr and b_expr are Pratt expressions; their levels are the precedence declarations of gram.y, from
// the loosest (OR) to the tightest (the :: cast). The operators that gram.y gives a precedence of their
// own (+, -, <, ...) are written out; the others (Op) share a level. Things that the precedence of
// bison decides for a LALR parser are decided here by the order of the alternatives and by the operand
// of an operator: the operand of LIKE and BETWEEN is a_expr(opl), which parses only the operators that
// bind tighter than they do (those of the level opl and above).

def expr_list: []Expr = first:a_expr rest:(-COMMA x:a_expr)* -> concat(list($first), map($rest, (r) => $r.x))

def a_expr: Expr = pratt {
    operand overlaps_expr
    operand c_expr
    operand default_expr

    level { infix left OR -> new BoolExpr{Boolop: "OR_EXPR", Args: list($lhs, $rhs)} }
    level { infix left AND -> new BoolExpr{Boolop: "AND_EXPR", Args: list($lhs, $rhs)} }
    level { prefix NOT -> new BoolExpr{Boolop: "NOT_EXPR", Args: list($rhs)} }

    // IS NULL, IS TRUE, ... (they may follow each other) and IS DISTINCT FROM
    level {
        postfix IS NULL -> new NullTest{Arg: $lhs, Nulltesttype: "IS_NULL"}
        postfix ISNULL -> new NullTest{Arg: $lhs, Nulltesttype: "IS_NULL"}
        postfix IS NOT NULL -> new NullTest{Arg: $lhs, Nulltesttype: "IS_NOT_NULL"}
        postfix NOTNULL -> new NullTest{Arg: $lhs, Nulltesttype: "IS_NOT_NULL"}
        postfix IS TRUE -> new BooleanTest{Arg: $lhs, Booltesttype: "IS_TRUE"}
        postfix IS NOT TRUE -> new BooleanTest{Arg: $lhs, Booltesttype: "IS_NOT_TRUE"}
        postfix IS FALSE -> new BooleanTest{Arg: $lhs, Booltesttype: "IS_FALSE"}
        postfix IS NOT FALSE -> new BooleanTest{Arg: $lhs, Booltesttype: "IS_NOT_FALSE"}
        postfix IS UNKNOWN -> new BooleanTest{Arg: $lhs, Booltesttype: "IS_UNKNOWN"}
        postfix IS NOT UNKNOWN -> new BooleanTest{Arg: $lhs, Booltesttype: "IS_NOT_UNKNOWN"}
        infix none IS DISTINCT FROM -> new A_Expr{Kind: "AEXPR_DISTINCT", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none IS NOT DISTINCT FROM -> new A_Expr{Kind: "AEXPR_NOT_DISTINCT", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: $rhs}
        postfix IS DOCUMENT -> new XmlExpr{Op: "IS_DOCUMENT", Args: list($lhs), Xmloption: "XMLOPTION_DOCUMENT"}
        postfix IS NOT DOCUMENT -> new BoolExpr{Boolop: "NOT_EXPR", Args: list(new XmlExpr{Op: "IS_DOCUMENT", Args: list($lhs), Xmloption: "XMLOPTION_DOCUMENT"})}
        postfix IS NORMALIZED -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "is_normalized"}), Args: list($lhs), Funcformat: "COERCE_SQL_SYNTAX"}
        postfix IS f:unicode_normal_form NORMALIZED -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "is_normalized"}), Args: list($lhs, $f), Funcformat: "COERCE_SQL_SYNTAX"}
        postfix IS NOT NORMALIZED -> new BoolExpr{Boolop: "NOT_EXPR", Args: list(new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "is_normalized"}), Args: list($lhs), Funcformat: "COERCE_SQL_SYNTAX"})}
        postfix IS NOT f:unicode_normal_form NORMALIZED -> new BoolExpr{Boolop: "NOT_EXPR", Args: list(new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "is_normalized"}), Args: list($lhs, $f), Funcformat: "COERCE_SQL_SYNTAX"})}
        postfix IS t:json_is_tail -> new JsonIsPredicate{Expr: $lhs, Format: new JsonFormat{}, ItemType: $t.ItemType, UniqueKeys: $t.UniqueKeys}
        postfix IS NOT t:json_is_tail -> new BoolExpr{Boolop: "NOT_EXPR", Args: list(new JsonIsPredicate{Expr: $lhs, Format: new JsonFormat{}, ItemType: $t.ItemType, UniqueKeys: $t.UniqueKeys})}
    }

    level {
        infix none LT -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "<"}), Lexpr: $lhs, Rexpr: $rhs}
        infix none GT -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: ">"}), Lexpr: $lhs, Rexpr: $rhs}
        infix none EQ -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none LESS_EQUALS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "<="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none GREATER_EQUALS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: ">="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none NOT_EQUALS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "<>"}), Lexpr: $lhs, Rexpr: $rhs}
    }

    // BETWEEN, IN, LIKE, ILIKE, SIMILAR TO: the operand is a_expr(opl), and a second operator of this
    // level may not follow (they do not chain)
    level {
        postfix BETWEEN ASYMMETRIC? l:b_expr AND r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_BETWEEN", Name: list(new String{Sval: "BETWEEN"}), Lexpr: $lhs, Rexpr: new NodeList{Items: list($l, $r)}}
        postfix NOT BETWEEN ASYMMETRIC? l:b_expr AND r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_NOT_BETWEEN", Name: list(new String{Sval: "NOT BETWEEN"}), Lexpr: $lhs, Rexpr: new NodeList{Items: list($l, $r)}}
        postfix BETWEEN SYMMETRIC l:b_expr AND r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_BETWEEN_SYM", Name: list(new String{Sval: "BETWEEN SYMMETRIC"}), Lexpr: $lhs, Rexpr: new NodeList{Items: list($l, $r)}}
        postfix NOT BETWEEN SYMMETRIC l:b_expr AND r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_NOT_BETWEEN_SYM", Name: list(new String{Sval: "NOT BETWEEN SYMMETRIC"}), Lexpr: $lhs, Rexpr: new NodeList{Items: list($l, $r)}}
        postfix IN q:select_with_parens !between_level_op
            -> new SubLink{SubLinkType: "ANY_SUBLINK", Testexpr: $lhs, Subselect: $q}
        postfix NOT IN q:select_with_parens !between_level_op
            -> new BoolExpr{Boolop: "NOT_EXPR", Args: list(new SubLink{SubLinkType: "ANY_SUBLINK", Testexpr: $lhs, Subselect: $q})}
        postfix IN LP l:expr_list RP !between_level_op
            -> new A_Expr{Kind: "AEXPR_IN", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: new NodeList{Items: $l}}
        postfix NOT IN LP l:expr_list RP !between_level_op
            -> new A_Expr{Kind: "AEXPR_IN", Name: list(new String{Sval: "<>"}), Lexpr: $lhs, Rexpr: new NodeList{Items: $l}}
        postfix LIKE r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_LIKE", Name: list(new String{Sval: "~~"}), Lexpr: $lhs, Rexpr: $r}
        postfix LIKE r:a_expr(opl) ESCAPE e:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_LIKE", Name: list(new String{Sval: "~~"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "like_escape"}), Args: list($r, $e), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix NOT LIKE r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_LIKE", Name: list(new String{Sval: "!~~"}), Lexpr: $lhs, Rexpr: $r}
        postfix NOT LIKE r:a_expr(opl) ESCAPE e:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_LIKE", Name: list(new String{Sval: "!~~"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "like_escape"}), Args: list($r, $e), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix ILIKE r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_ILIKE", Name: list(new String{Sval: "~~*"}), Lexpr: $lhs, Rexpr: $r}
        postfix ILIKE r:a_expr(opl) ESCAPE e:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_ILIKE", Name: list(new String{Sval: "~~*"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "like_escape"}), Args: list($r, $e), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix NOT ILIKE r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_ILIKE", Name: list(new String{Sval: "!~~*"}), Lexpr: $lhs, Rexpr: $r}
        postfix NOT ILIKE r:a_expr(opl) ESCAPE e:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_ILIKE", Name: list(new String{Sval: "!~~*"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "like_escape"}), Args: list($r, $e), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix SIMILAR TO r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_SIMILAR", Name: list(new String{Sval: "~"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "similar_to_escape"}), Args: list($r), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix SIMILAR TO r:a_expr(opl) ESCAPE e:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_SIMILAR", Name: list(new String{Sval: "~"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "similar_to_escape"}), Args: list($r, $e), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix NOT SIMILAR TO r:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_SIMILAR", Name: list(new String{Sval: "!~"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "similar_to_escape"}), Args: list($r), Funcformat: "COERCE_EXPLICIT_CALL"}}
        postfix NOT SIMILAR TO r:a_expr(opl) ESCAPE e:a_expr(opl) !between_level_op
            -> new A_Expr{Kind: "AEXPR_SIMILAR", Name: list(new String{Sval: "!~"}), Lexpr: $lhs, Rexpr: new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "similar_to_escape"}), Args: list($r, $e), Funcformat: "COERCE_EXPLICIT_CALL"}}
    }

    // Other operators; the postfix forms are a comparison operator followed by ANY, SOME or ALL and a
    // subquery or a parenthesized expression.
    level opl {
        postfix o:subquery_Op (ANY / SOME) q:select_with_parens
            -> new SubLink{SubLinkType: "ANY_SUBLINK", Testexpr: $lhs, OperName: $o, Subselect: $q}
        postfix o:subquery_Op ALL q:select_with_parens
            -> new SubLink{SubLinkType: "ALL_SUBLINK", Testexpr: $lhs, OperName: $o, Subselect: $q}
        postfix o:subquery_Op (ANY / SOME) LP r:a_expr RP
            -> new A_Expr{Kind: "AEXPR_OP_ANY", Name: $o, Lexpr: $lhs, Rexpr: $r}
        postfix o:subquery_Op ALL LP r:a_expr RP
            -> new A_Expr{Kind: "AEXPR_OP_ALL", Name: $o, Lexpr: $lhs, Rexpr: $r}
        infix left o:qual_Op -> new A_Expr{Kind: "AEXPR_OP", Name: $o, Lexpr: $lhs, Rexpr: $rhs}
        prefix o:qual_Op -> new A_Expr{Kind: "AEXPR_OP", Name: $o, Rexpr: $rhs}
    }
    level {
        infix left PLUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "+"}), Lexpr: $lhs, Rexpr: $rhs}
        infix left MINUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "-"}), Lexpr: $lhs, Rexpr: $rhs}
    }
    level {
        infix left STAR -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "*"}), Lexpr: $lhs, Rexpr: $rhs}
        infix left SLASH -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "/"}), Lexpr: $lhs, Rexpr: $rhs}
        infix left PERCENT -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "%"}), Lexpr: $lhs, Rexpr: $rhs}
    }
    level { infix left CARET -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "^"}), Lexpr: $lhs, Rexpr: $rhs} }
    level {
        infix left AT TIME ZONE -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "timezone"}), Args: list($rhs, $lhs), Funcformat: "COERCE_SQL_SYNTAX"}
        postfix AT LOCAL -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "timezone"}), Args: list($lhs), Funcformat: "COERCE_SQL_SYNTAX"}
    }
    level { postfix COLLATE n:any_name -> new CollateClause{Arg: $lhs, Collname: $n} }
    level {
        prefix PLUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "+"}), Rexpr: $rhs}
        prefix MINUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "-"}), Rexpr: $rhs}
    }
    level { postfix TYPECAST t:Typename -> new TypeCast{Arg: $lhs, TypeName: $t} }
}
// An operator of the level of BETWEEN and the like: it may not follow another one
def between_level_op = NOT? (BETWEEN / IN / LIKE / ILIKE / SIMILAR)

// b_expr: the expressions that may appear where a_expr would be ambiguous (the bounds of BETWEEN, the
// default of a column, ...). It has no AND, OR, NOT, IN, LIKE, COLLATE, AT or IS NULL.
def b_expr: Expr = pratt {
    operand c_expr

    level {
        infix none IS DISTINCT FROM -> new A_Expr{Kind: "AEXPR_DISTINCT", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none IS NOT DISTINCT FROM -> new A_Expr{Kind: "AEXPR_NOT_DISTINCT", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: $rhs}
        postfix IS DOCUMENT -> new XmlExpr{Op: "IS_DOCUMENT", Args: list($lhs), Xmloption: "XMLOPTION_DOCUMENT"}
        postfix IS NOT DOCUMENT -> new BoolExpr{Boolop: "NOT_EXPR", Args: list(new XmlExpr{Op: "IS_DOCUMENT", Args: list($lhs), Xmloption: "XMLOPTION_DOCUMENT"})}
    }
    level {
        infix none LT -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "<"}), Lexpr: $lhs, Rexpr: $rhs}
        infix none GT -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: ">"}), Lexpr: $lhs, Rexpr: $rhs}
        infix none EQ -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none LESS_EQUALS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "<="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none GREATER_EQUALS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: ">="}), Lexpr: $lhs, Rexpr: $rhs}
        infix none NOT_EQUALS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "<>"}), Lexpr: $lhs, Rexpr: $rhs}
    }
    level {
        infix left o:qual_Op -> new A_Expr{Kind: "AEXPR_OP", Name: $o, Lexpr: $lhs, Rexpr: $rhs}
        prefix o:qual_Op -> new A_Expr{Kind: "AEXPR_OP", Name: $o, Rexpr: $rhs}
    }
    level {
        infix left PLUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "+"}), Lexpr: $lhs, Rexpr: $rhs}
        infix left MINUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "-"}), Lexpr: $lhs, Rexpr: $rhs}
    }
    level {
        infix left STAR -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "*"}), Lexpr: $lhs, Rexpr: $rhs}
        infix left SLASH -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "/"}), Lexpr: $lhs, Rexpr: $rhs}
        infix left PERCENT -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "%"}), Lexpr: $lhs, Rexpr: $rhs}
    }
    level { infix left CARET -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "^"}), Lexpr: $lhs, Rexpr: $rhs} }
    level {
        prefix PLUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "+"}), Rexpr: $rhs}
        prefix MINUS -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "-"}), Rexpr: $rhs}
    }
    level { postfix TYPECAST t:Typename -> new TypeCast{Arg: $lhs, TypeName: $t} }
}

def default_expr: SetToDefault = DEFAULT -> new SetToDefault{}
// row OVERLAPS row: both rows have exactly two elements
def overlaps_expr: FuncCall = a:row_pair OVERLAPS b:row_pair
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "overlaps"}), Args: concat($a, $b), Funcformat: "COERCE_SQL_SYNTAX"}
def row_pair: []Expr = row_pair_explicit / row_pair_implicit
def row_pair_explicit: []Expr = ROW -LP x:a_expr -COMMA y:a_expr -RP -> list($x, $y)
def row_pair_implicit: []Expr = -LP x:a_expr -COMMA y:a_expr -RP -> list($x, $y)

// ---- Operators ----

def math_text: OpTok = "<=" &plain_end / ">=" &plain_end / "<>" &plain_end / "!=" !opc
    / "+" &plain_end / "-" &plain_end / "*" &plain_end / "/" &plain_end / "<" &plain_end / ">" &plain_end
    / "=" &plain_end / "%" !opc / "^" !opc
def MathOp: OpTok = t:math_text s -> $t
def all_Op = Op / MathOp
// OPERATOR(schema.op): a schema-qualified operator
def any_operator: []Str = any_operator_qualified / any_operator_simple
def any_operator_simple: []Str = x:all_Op -> list($x)
def any_operator_qualified: []Str = first:ColId -DOT rest:any_operator -> concat(list($first), $rest)
def qual_Op: []Str = qual_op_plain / qual_op_schema
def qual_op_plain: []Str = o:Op -> list($o)
def qual_op_schema: []Str = OPERATOR -LP n:any_operator -RP -> $n
def qual_all_Op: []Str = qual_all_plain / qual_op_schema
def qual_all_plain: []Str = o:all_Op -> list($o)
def subquery_Op: []Str = qual_all_plain / qual_op_schema / op_like / op_not_like / op_ilike / op_not_ilike
def op_like: []Str = LIKE -> list(new String{Sval: "~~"})
def op_not_like: []Str = NOT LIKE -> list(new String{Sval: "!~~"})
def op_ilike: []Str = ILIKE -> list(new String{Sval: "~~*"})
def op_not_ilike: []Str = NOT ILIKE -> list(new String{Sval: "!~~*"})

// ==== Primary expressions (c_expr) and function calls ====
//
// The alternatives are ordered so that the common cases (column references) are tried first and
// guarded by what follows them: a name followed by "(" is a function call, and a name followed by a
// string is a type name and a constant; the keyword forms (CASE, COALESCE, ...) and those come after.

def c_expr: Expr = c_ident / c_paren / c_dollar / AexprConst
def c_ident: Expr = &(ident_start / "\"") x:(columnref_plain_guarded / func_call_expr / bool_null_expr / special_expr / typed_const
    / sconst_expr / bconst_expr / xconst_expr) -> $x
def c_paren: Expr = &"(" x:(sublink_indirect / sublink_expr / implicit_row_expr / paren_indirect / paren_expr) -> $x
def c_dollar: Expr = &"$" x:(param_indirect / param_plain / sconst_expr) -> $x

// A column reference not followed by "(" or a string: the common case
def columnref_plain_guarded: Expr = x:columnref !"(" !sconst_text -> $x

def bool_null_expr: A_Const = true_expr / false_expr / null_expr

def special_expr: Expr = case_expr / exists_expr / array_sublink / array_literal / explicit_row_expr / grouping_expr
    / func_expr_common_subexpr

// ---- Column references and indirection ----

// A name, the fields selected from it and, when there is a subscript, A_Indirection applied to it
def columnref: Expr = columnref_indirect / columnref_simple
def columnref_simple: ColumnRef = c:ColId fs:field_sel* -> new ColumnRef{Fields: concat(list($c), $fs)}
def columnref_indirect: A_Indirection = c:ColId fs:field_sel* ind:subscript_tail
    -> new A_Indirection{Arg: new ColumnRef{Fields: concat(list($c), $fs)}, Indirection: $ind}
def field_sel: ColField = dot_name / dot_star
def dot_name: Ident = -DOT x:attr_name -> $x
def dot_star: A_Star = -DOT STAR !(DOT / LB) -> new A_Star{}
def indirection_el: Indirection = dot_name / dot_star / subscript
def indirection: []Indirection = xs:indirection_el+ -> $xs
def subscript_tail: []Indirection = x:subscript xs:indirection_el* -> concat(list($x), $xs)
def subscript: A_Indices = subscript_index / subscript_slice
def subscript_index: A_Indices = -LB e:a_expr -RB -> new A_Indices{Uidx: $e}
def subscript_slice: A_Indices = -LB l:a_expr? -COLON u:a_expr? -RB -> new A_Indices{IsSlice: true, Lidx: $l, Uidx: $u}

def param_indirect: A_Indirection = p:PARAM ind:indirection -> new A_Indirection{Arg: new ParamRef{Number: $p}, Indirection: $ind}
def param_plain: ParamRef = p:PARAM -> new ParamRef{Number: $p}

// ---- Parentheses, subqueries, rows ----

def paren_indirect: A_Indirection = -LP e:a_expr -RP ind:indirection -> new A_Indirection{Arg: $e, Indirection: $ind}
def paren_expr: Expr = -LP e:a_expr -RP -> $e
def sublink_expr: SubLink = q:select_with_parens -> new SubLink{SubLinkType: "EXPR_SUBLINK", Subselect: $q}
def sublink_indirect: A_Indirection = q:select_with_parens ind:indirection
    -> new A_Indirection{Arg: new SubLink{SubLinkType: "EXPR_SUBLINK", Subselect: $q}, Indirection: $ind}
def exists_expr: SubLink = EXISTS q:select_with_parens -> new SubLink{SubLinkType: "EXISTS_SUBLINK", Subselect: $q}
def array_sublink: SubLink = ARRAY q:select_with_parens -> new SubLink{SubLinkType: "ARRAY_SUBLINK", Subselect: $q}
def array_literal: A_ArrayExpr = ARRAY a:array_expr -> $a
def array_expr: A_ArrayExpr = -LB l:(array_expr_list / expr_list)? -RB -> new A_ArrayExpr{Elements: concat($l)}
def array_expr_list: []A_ArrayExpr = first:array_expr rest:(-COMMA x:array_expr)* -> concat(list($first), map($rest, (r) => $r.x))
def explicit_row_expr: RowExpr = ROW -LP l:expr_list? -RP -> new RowExpr{Args: concat($l), RowFormat: "COERCE_EXPLICIT_CALL"}
def implicit_row_expr: RowExpr = -LP first:a_expr rest:(-COMMA x:a_expr)+ -RP
    -> new RowExpr{Args: concat(list($first), map($rest, (r) => $r.x)), RowFormat: "COERCE_IMPLICIT_CAST"}
def grouping_expr: GroupingFunc = GROUPING -LP l:expr_list -RP -> new GroupingFunc{Args: $l}

// ---- CASE ----

def case_expr: CaseExpr = CASE a:a_expr? ws:when_clause+ d:case_default? END
    -> new CaseExpr{Arg: $a, Args: $ws, Defresult: $d}
def when_clause: CaseWhen = WHEN c:a_expr THEN r:a_expr -> new CaseWhen{Expr: $c, Result: $r}
def case_default: Expr = ELSE e:a_expr -> $e

// ---- Function calls ----

def func_call_expr: Expr = f:func_expr !sconst_text -> $f
def func_expr: Expr = func_call_over / json_agg_expr

// The call with its WITHIN GROUP, FILTER and OVER clauses. The arguments are, in the forms of gram.y:
// (), (*), (DISTINCT list), (ALL list), (VARIADIC e), (list), (list, VARIADIC e), each with an
// optional ORDER BY.
def func_call_over: FuncCall =
    n:func_name -LP
    ( st:STAR
    / d:DISTINCT a1:func_arg_list o1:opt_sort_clause
    / -ALL a2:func_arg_list o2:opt_sort_clause
    / a3:variadic_arg o3:opt_sort_clause
    / a4:func_arg_list v4:comma_variadic? o4:opt_sort_clause )?
    -RP
    wg:within_group_ok? fc:filter_ok? ov:over_ok?
    [len($wg) == 0 || (len($o1) + len($o2) + len($o3) + len($o4) == 0 && len($d) == 0 && len($a3) + len($v4) == 0)]
    -> new FuncCall{Funcname: $n, Args: concat($a1, $a2, $a3, $a4, $v4), AggOrder: concat($o1, $o2, $o3, $o4, $wg),
        AggFilter: $fc, Over: $ov, AggWithinGroup: len($wg) > 0, AggStar: len($st) > 0, AggDistinct: len($d) > 0,
        FuncVariadic: len($a3) + len($v4) > 0, Funcformat: "COERCE_EXPLICIT_CALL"}
def variadic_arg: []Expr = VARIADIC e:func_arg_expr -> list($e)
def comma_variadic: []Expr = -COMMA v:variadic_arg -> $v
def func_arg_list: []Expr = first:func_arg_expr rest:(-COMMA x:func_arg_expr)* -> concat(list($first), map($rest, (r) => $r.x))
def func_arg_list_opt: []Expr = l:func_arg_list? -> concat($l)
def func_arg_expr: Expr = [windowless = false] x:(named_arg / a_expr) -> $x
// WITHIN GROUP, FILTER and OVER are not allowed where a function call is windowless
def within_group_ok: []SortBy = ![windowless] x:within_group_clause -> $x
def filter_ok: Expr = ![windowless] x:filter_clause -> $x
def over_ok: WindowDef = ![windowless] x:over_clause -> $x
def named_arg: NamedArgExpr = n:param_name -(COLON_EQUALS / EQUALS_GREATER) e:a_expr -> new NamedArgExpr{Arg: $e, Name: $n, Argnumber: -1}
def param_name = type_function_name

def within_group_clause: []SortBy = WITHIN GROUP -LP s:sort_clause -RP -> $s
def filter_clause: Expr = FILTER -LP WHERE e:a_expr -RP -> $e
def over_clause: WindowDef = over_spec / over_name
def over_spec: WindowDef = OVER &LP w:window_def -> $w
def over_name: WindowDef = OVER n:ColId -> new WindowDef{Name: $n, FrameOptions: 1058}

// ==== Functions with special syntax (func_expr_common_subexpr) ====

def func_expr_common_subexpr: Expr =
    collation_for / sql_value_function / cast_expr / extract_expr / normalize_expr / overlay_expr / position_expr
    / substring_expr / treat_expr / trim_expr / nullif_expr / coalesce_expr / greatest_expr / least_expr
    / merge_action_expr / xmljson_expr

def collation_for: FuncCall = COLLATION FOR -LP e:a_expr -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "pg_collation_for"}), Args: list($e), Funcformat: "COERCE_SQL_SYNTAX"}

def sql_value_function: Expr = svf_simple / svf_time_n / system_user_expr
def svf_simple: SQLValueFunction = svf_date / svf_time / svf_timestamp / svf_localtime / svf_localtimestamp
    / svf_current_role / svf_current_user / svf_session_user / svf_user / svf_catalog / svf_schema
def svf_date: SQLValueFunction = CURRENT_DATE -> new SQLValueFunction{Op: "SVFOP_CURRENT_DATE"}
def svf_time: SQLValueFunction = CURRENT_TIME !LP -> new SQLValueFunction{Op: "SVFOP_CURRENT_TIME"}
def svf_timestamp: SQLValueFunction = CURRENT_TIMESTAMP !LP -> new SQLValueFunction{Op: "SVFOP_CURRENT_TIMESTAMP"}
def svf_localtime: SQLValueFunction = LOCALTIME !LP -> new SQLValueFunction{Op: "SVFOP_LOCALTIME"}
def svf_localtimestamp: SQLValueFunction = LOCALTIMESTAMP !LP -> new SQLValueFunction{Op: "SVFOP_LOCALTIMESTAMP"}
def svf_current_role: SQLValueFunction = CURRENT_ROLE -> new SQLValueFunction{Op: "SVFOP_CURRENT_ROLE"}
def svf_current_user: SQLValueFunction = CURRENT_USER -> new SQLValueFunction{Op: "SVFOP_CURRENT_USER"}
def svf_session_user: SQLValueFunction = SESSION_USER -> new SQLValueFunction{Op: "SVFOP_SESSION_USER"}
def svf_user: SQLValueFunction = USER -> new SQLValueFunction{Op: "SVFOP_USER"}
def svf_catalog: SQLValueFunction = CURRENT_CATALOG -> new SQLValueFunction{Op: "SVFOP_CURRENT_CATALOG"}
def svf_schema: SQLValueFunction = CURRENT_SCHEMA -> new SQLValueFunction{Op: "SVFOP_CURRENT_SCHEMA"}
def svf_time_n: SQLValueFunction = svf_time_p / svf_timestamp_p / svf_localtime_p / svf_localtimestamp_p
def svf_time_p: SQLValueFunction = CURRENT_TIME -LP n:Iconst -RP -> new SQLValueFunction{Op: "SVFOP_CURRENT_TIME_N", Typmod: $n}
def svf_timestamp_p: SQLValueFunction = CURRENT_TIMESTAMP -LP n:Iconst -RP -> new SQLValueFunction{Op: "SVFOP_CURRENT_TIMESTAMP_N", Typmod: $n}
def svf_localtime_p: SQLValueFunction = LOCALTIME -LP n:Iconst -RP -> new SQLValueFunction{Op: "SVFOP_LOCALTIME_N", Typmod: $n}
def svf_localtimestamp_p: SQLValueFunction = LOCALTIMESTAMP -LP n:Iconst -RP -> new SQLValueFunction{Op: "SVFOP_LOCALTIMESTAMP_N", Typmod: $n}
def system_user_expr: FuncCall = SYSTEM_USER
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "system_user"}), Funcformat: "COERCE_SQL_SYNTAX"}

def cast_expr: TypeCast = CAST -LP e:a_expr AS t:Typename -RP -> new TypeCast{Arg: $e, TypeName: $t}
def treat_expr: TreatExpr = TREAT -LP e:a_expr AS t:Typename -RP -> new TreatExpr{Arg: $e, TypeName: $t}

def extract_expr: FuncCall = EXTRACT -LP a:extract_arg FROM e:a_expr -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "extract"}), Args: list($a, $e), Funcformat: "COERCE_SQL_SYNTAX"}
def extract_arg: A_Const = ea_ident / ea_year / ea_month / ea_day / ea_hour / ea_minute / ea_second / ea_sconst
def ea_ident: A_Const = x:IDENT -> new A_Const{Val: $x}
def ea_sconst: A_Const = x:Sconst -> new A_Const{Val: $x}
def ea_year: A_Const = YEAR -> new A_Const{Val: new String{Sval: "year"}}
def ea_month: A_Const = MONTH -> new A_Const{Val: new String{Sval: "month"}}
def ea_day: A_Const = DAY -> new A_Const{Val: new String{Sval: "day"}}
def ea_hour: A_Const = HOUR -> new A_Const{Val: new String{Sval: "hour"}}
def ea_minute: A_Const = MINUTE -> new A_Const{Val: new String{Sval: "minute"}}
def ea_second: A_Const = SECOND -> new A_Const{Val: new String{Sval: "second"}}

def normalize_expr: FuncCall = normalize_form / normalize_plain
def normalize_plain: FuncCall = NORMALIZE -LP e:a_expr -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "normalize"}), Args: list($e), Funcformat: "COERCE_SQL_SYNTAX"}
def normalize_form: FuncCall = NORMALIZE -LP e:a_expr -COMMA f:unicode_normal_form -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "normalize"}), Args: list($e, $f), Funcformat: "COERCE_SQL_SYNTAX"}
def unicode_normal_form: A_Const = nf_c / nf_d / nf_kc / nf_kd
def nf_c: A_Const = NFC -> new A_Const{Val: new String{Sval: "NFC"}}
def nf_d: A_Const = NFD -> new A_Const{Val: new String{Sval: "NFD"}}
def nf_kc: A_Const = NFKC -> new A_Const{Val: new String{Sval: "NFKC"}}
def nf_kd: A_Const = NFKD -> new A_Const{Val: new String{Sval: "NFKD"}}

// OVERLAY and SUBSTRING also accept a plain argument list, as a function named like them
def overlay_expr: FuncCall = overlay_special / overlay_plain
def overlay_special: FuncCall = OVERLAY -LP a:a_expr PLACING b:a_expr FROM c:a_expr d:overlay_for? -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "overlay"}), Args: concat(list($a, $b, $c), $d), Funcformat: "COERCE_SQL_SYNTAX"}
def overlay_for: []Expr = FOR e:a_expr -> list($e)
def overlay_plain: FuncCall = OVERLAY -LP l:func_arg_list_opt -RP
    -> new FuncCall{Funcname: list(new String{Sval: "overlay"}), Args: $l, Funcformat: "COERCE_EXPLICIT_CALL"}

def position_expr: FuncCall = POSITION -LP a:b_expr IN b:b_expr -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "position"}), Args: list($b, $a), Funcformat: "COERCE_SQL_SYNTAX"}

def substring_expr: FuncCall = substring_special / substring_plain
def substring_special: FuncCall = SUBSTRING -LP l:substr_list -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "substring"}), Args: $l, Funcformat: "COERCE_SQL_SYNTAX"}
def substring_plain: FuncCall = SUBSTRING -LP l:func_arg_list_opt -RP
    -> new FuncCall{Funcname: list(new String{Sval: "substring"}), Args: $l, Funcformat: "COERCE_EXPLICIT_CALL"}
def substr_list: []Expr = substr_from_for / substr_for_from / substr_from / substr_for / substr_similar
def substr_from_for: []Expr = a:a_expr FROM b:a_expr FOR c:a_expr -> list($a, $b, $c)
def substr_for_from: []Expr = a:a_expr FOR b:a_expr FROM c:a_expr -> list($a, $c, $b)
def substr_from: []Expr = a:a_expr FROM b:a_expr -> list($a, $b)
def substr_for: []Expr = a:a_expr FOR b:a_expr
    -> list($a, new A_Const{Val: new Integer{Ival: 1}}, new TypeCast{Arg: $b, TypeName: new TypeName{Names: list(new String{Sval: "pg_catalog"}, new String{Sval: "int4"}), Typemod: -1}})
def substr_similar: []Expr = a:a_expr SIMILAR b:a_expr ESCAPE c:a_expr -> list($a, $b, $c)

def trim_expr: FuncCall = trim_both / trim_leading / trim_trailing / trim_plain
def trim_both: FuncCall = TRIM -LP BOTH l:trim_list -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "btrim"}), Args: $l, Funcformat: "COERCE_SQL_SYNTAX"}
def trim_leading: FuncCall = TRIM -LP LEADING l:trim_list -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "ltrim"}), Args: $l, Funcformat: "COERCE_SQL_SYNTAX"}
def trim_trailing: FuncCall = TRIM -LP TRAILING l:trim_list -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "rtrim"}), Args: $l, Funcformat: "COERCE_SQL_SYNTAX"}
def trim_plain: FuncCall = TRIM -LP l:trim_list -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "btrim"}), Args: $l, Funcformat: "COERCE_SQL_SYNTAX"}
def trim_list: []Expr = trim_a_from / trim_from / expr_list
def trim_a_from: []Expr = a:a_expr FROM l:expr_list -> concat($l, list($a))
def trim_from: []Expr = FROM l:expr_list -> $l

def nullif_expr: A_Expr = NULLIF -LP a:a_expr -COMMA b:a_expr -RP
    -> new A_Expr{Kind: "AEXPR_NULLIF", Name: list(new String{Sval: "="}), Lexpr: $a, Rexpr: $b}
def coalesce_expr: CoalesceExpr = COALESCE -LP l:expr_list -RP -> new CoalesceExpr{Args: $l}
def greatest_expr: MinMaxExpr = GREATEST -LP l:expr_list -RP -> new MinMaxExpr{Op: "IS_GREATEST", Args: $l}
def least_expr: MinMaxExpr = LEAST -LP l:expr_list -RP -> new MinMaxExpr{Op: "IS_LEAST", Args: $l}
def merge_action_expr: MergeSupportFunc = MERGE_ACTION -LP -RP -> new MergeSupportFunc{}

// ==== SELECT ====
//
// In the raw parser the clauses after a query (ORDER BY, LIMIT, FOR UPDATE, WITH) are put into the node of
// the query that precedes them. A PEG cannot change a node it has built, so select_core builds the node
// once, with everything: the body (SELECT ..., VALUES, TABLE, a chain of UNION/INTERSECT/EXCEPT or a
// parenthesized query) and the clauses that follow it. A set operation is built from its last operator:
// ue_head and i_head are the chains before it (each step requires another operator to follow, so the
// chain stops before the last one). The operands of a set operation have no clauses after them (the
// variable tails_ok is false for them). A parenthesized query followed by clauses is a SelectStmt with only
// Larg, which rawjson.go merges into one node as the raw parser does.

def SelectStmt: SelectStmt = select_no_parens / select_with_parens
def select_with_parens: SelectStmt = select_parens_plain / select_parens_nested
def select_parens_plain: SelectStmt = -LP q:select_no_parens -RP -> $q
def select_parens_nested: SelectStmt = -LP q:select_with_parens -RP -> $q
def select_no_parens: SelectStmt = [tails_ok = true] x:select_core -> $x
def select_operand: SelectStmt = [tails_ok = false] x:select_core -> $x
// select_clause: an operand of a set operation
def sop: SelectStmt = select_with_parens / select_operand
// the intersect chain, whose operands bind tighter than UNION and EXCEPT
def ic_operand: SelectStmt = i_chain
def i_chain: SelectStmt = i_step / sop
def i_step: SelectStmt = l:i_chain INTERSECT a:ALL? -DISTINCT? r:sop
    -> new SelectStmt{Op: "SETOP_INTERSECT", All: len($a) > 0, Larg: $l, Rarg: $r}
// the chains before the last operator
def ue_head: SelectStmt = ue_union / ue_except / ue_first
def ue_first: SelectStmt = x:ic_operand &(UNION / EXCEPT) -> $x
def ue_union: SelectStmt = l:ue_head UNION a:ALL? -DISTINCT? r:ic_operand &(UNION / EXCEPT)
    -> new SelectStmt{Op: "SETOP_UNION", All: len($a) > 0, Larg: $l, Rarg: $r}
def ue_except: SelectStmt = l:ue_head EXCEPT a:ALL? -DISTINCT? r:ic_operand &(UNION / EXCEPT)
    -> new SelectStmt{Op: "SETOP_EXCEPT", All: len($a) > 0, Larg: $l, Rarg: $r}
def i_head: SelectStmt = i_head_step / i_head_first
def i_head_first: SelectStmt = x:sop &INTERSECT -> $x
def i_head_step: SelectStmt = l:i_head INTERSECT a:ALL? -DISTINCT? r:sop &INTERSECT
    -> new SelectStmt{Op: "SETOP_INTERSECT", All: len($a) > 0, Larg: $l, Rarg: $r}

def no_setop = [!tails_ok] / !(UNION / INTERSECT / EXCEPT)
def with_if_tails: WithClause = [tails_ok] w:with_clause -> $w
def sort_if_tails: []SortBy = [tails_ok] s:sort_clause -> $s
def locking_if_tails: []LockingClause = [tails_ok] l:locking_clause -> $l

def select_core: SelectStmt =
    [k = "SETOP_NONE"] [ties = false] [paren = false]
    w:with_if_tails?
    ( SELECT (-ALL / d:DISTINCT don:distinct_on?)? tl:target_list? ic:into_clause? fr:from_clause? wh:where_clause?
          (GROUP BY (gd:DISTINCT / -ALL)? gr:group_by_list)? hv:having_clause? wd:window_clause?
          [len($d) == 0 || len($tl) > 0] no_setop
    / VALUES vl:values_lists no_setop
    / TABLE tf:table_from ts:table_star no_setop
    / [tails_ok] l:ue_head (UNION [k = "SETOP_UNION"] / EXCEPT [k = "SETOP_EXCEPT"]) a:ALL? -DISTINCT? r:ic_operand
    / [tails_ok] l:i_head INTERSECT [k = "SETOP_INTERSECT"] a:ALL? -DISTINCT? r:sop !(UNION / EXCEPT)
    / [tails_ok] [paren = true] l:select_with_parens )
    sc:sort_if_tails?
    lk1:locking_if_tails?
    ( [tails_ok]
      ( ( LIMIT lc:limit_value / FETCH first_or_next (lc:fetch_one / lc:select_fetch_first_value) row_or_rows (ONLY / WITH TIES [ties = true]) )
        ( OFFSET oc:offset_rows / OFFSET oc:select_offset_value )?
      / ( OFFSET oc:offset_rows / OFFSET oc:select_offset_value )
        ( LIMIT lc:limit_value / FETCH first_or_next (lc:fetch_one / lc:select_fetch_first_value) row_or_rows (ONLY / WITH TIES [ties = true]) )? )
    )?
    lk2:locking_if_tails?
    [len($lk1) == 0 || len($lk2) == 0]
    [!ties || paren || len($sc) > 0]
    [!paren || len($w) + len($sc) + len($lk1) + len($lk2) + len(text($lc)) + len(text($oc)) > 0]
    -> new SelectStmt{DistinctOn: concat($don), Distinct: len($d) > 0, TargetList: concat($tl, $ts), IntoClause: $ic, FromClause: concat($fr, $tf),
        WhereClause: $wh, GroupClause: concat($gr), GroupDistinct: len($gd) > 0, HavingClause: $hv, WindowClause: concat($wd), ValuesLists: concat($vl), SortClause: concat($sc),
        LimitOffset: $oc, LimitCount: $lc, LimitWithTies: ties, LockingClause: concat($lk1, $lk2), WithClause: $w,
        Op: k, All: len($a) > 0, Larg: $l, Rarg: $r}

// ---- Clauses of a query ----

def distinct_on: []Expr = ON -LP l:expr_list -RP -> $l
def target_list: []ResTarget = first:target_el rest:(-COMMA x:target_el)* -> concat(list($first), map($rest, (r) => $r.x))
def target_el: ResTarget = target_as / target_bare / target_plain / target_star
def target_as: ResTarget = e:a_expr AS n:ColLabel -> new ResTarget{Name: $n, Val: $e}
def target_bare: ResTarget = e:a_expr n:BareColLabel -> new ResTarget{Name: $n, Val: $e}
def target_plain: ResTarget = e:a_expr -> new ResTarget{Val: $e}
def target_star: ResTarget = STAR -> new ResTarget{Val: new ColumnRef{Fields: list(new A_Star{})}}
def table_star: []ResTarget = _ -> list(new ResTarget{Val: new ColumnRef{Fields: list(new A_Star{})}})
def table_from: []TableRef = r:relation_expr -> list($r)

def into_clause: IntoClause = INTO r:opt_temp_table_name -> new IntoClause{Rel: $r, OnCommit: "ONCOMMIT_NOOP"}
// OptTempTableName: a table name with its persistence
def opt_temp_table_name: RangeVar = temp_table_name / unlogged_table_name / table_table_name / qualified_name
def temp_table_name: RangeVar =
    (TEMPORARY / TEMP / LOCAL TEMPORARY / LOCAL TEMP / GLOBAL TEMPORARY / GLOBAL TEMP) TABLE? n:qualified_name
    -> new RangeVar{Catalogname: $n.Catalogname, Schemaname: $n.Schemaname, Relname: $n.Relname, Inh: true, Relpersistence: "t"}
def unlogged_table_name: RangeVar = UNLOGGED TABLE? n:qualified_name
    -> new RangeVar{Catalogname: $n.Catalogname, Schemaname: $n.Schemaname, Relname: $n.Relname, Inh: true, Relpersistence: "u"}
def table_table_name: RangeVar = TABLE n:qualified_name -> $n

def from_clause: []TableRef = FROM l:from_list -> $l
def from_list: []TableRef = first:table_ref rest:(-COMMA x:table_ref)* -> concat(list($first), map($rest, (r) => $r.x))
def where_clause: Expr = WHERE e:a_expr -> $e
def having_clause: Expr = HAVING e:a_expr -> $e

def group_by_list: []Expr = first:group_by_item rest:(-COMMA x:group_by_item)* -> concat(list($first), map($rest, (r) => $r.x))
def group_by_item: Expr = grouping_set_empty / rollup_clause / cube_clause / grouping_sets_clause / a_expr
def grouping_set_empty: GroupingSet = -LP -RP -> new GroupingSet{Kind: "GROUPING_SET_EMPTY"}
def rollup_clause: GroupingSet = ROLLUP -LP l:expr_list -RP -> new GroupingSet{Kind: "GROUPING_SET_ROLLUP", Content: $l}
def cube_clause: GroupingSet = CUBE -LP l:expr_list -RP -> new GroupingSet{Kind: "GROUPING_SET_CUBE", Content: $l}
def grouping_sets_clause: GroupingSet = GROUPING SETS -LP l:group_by_list -RP -> new GroupingSet{Kind: "GROUPING_SET_SETS", Content: $l}

// ---- ORDER BY, LIMIT, FOR UPDATE ----

def sort_clause: []SortBy = ORDER BY l:sortby_list -> $l
def opt_sort_clause: []SortBy = l:sort_clause? -> concat($l)
def sortby_list: []SortBy = first:sortby rest:(-COMMA x:sortby)* -> concat(list($first), map($rest, (r) => $r.x))
def sortby: SortBy = sortby_using / sortby_dir
def sortby_using: SortBy = [n = "SORTBY_NULLS_DEFAULT"] e:a_expr USING o:qual_all_Op (NULLS FIRST [n = "SORTBY_NULLS_FIRST"] / NULLS LAST [n = "SORTBY_NULLS_LAST"])?
    -> new SortBy{Node: $e, SortbyDir: "SORTBY_USING", SortbyNulls: n, UseOp: $o}
def sortby_dir: SortBy = [d = "SORTBY_DEFAULT"] [n = "SORTBY_NULLS_DEFAULT"] e:a_expr
    (ASC [d = "SORTBY_ASC"] / DESC [d = "SORTBY_DESC"])? (NULLS FIRST [n = "SORTBY_NULLS_FIRST"] / NULLS LAST [n = "SORTBY_NULLS_LAST"])?
    -> new SortBy{Node: $e, SortbyDir: d, SortbyNulls: n}

def limit_value: Expr = a_expr / limit_all
def limit_all: A_Const = ALL -> new A_Const{Isnull: true}
def select_offset_value: Expr = a_expr
def offset_rows: Expr = x:select_fetch_first_value row_or_rows -> $x
def fetch_one: A_Const = &((ROW / ROWS) (ONLY / WITH TIES)) _ -> new A_Const{Val: new Integer{Ival: 1}}
// FETCH FIRST n ROWS ONLY: a c_expr or a signed number
def select_fetch_first_value: Expr = c_expr / signed_fetch_value
def signed_fetch_value: A_Expr = signed_plus / signed_minus
def signed_plus: A_Expr = PLUS v:i_or_f_const -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "+"}), Rexpr: $v}
def signed_minus: A_Expr = MINUS v:i_or_f_const -> new A_Expr{Kind: "AEXPR_OP", Name: list(new String{Sval: "-"}), Rexpr: $v}
def i_or_f_const: A_Const = iconst_expr / fconst_expr
def row_or_rows = ROW / ROWS
def first_or_next = FIRST / NEXT

def locking_clause: []LockingClause = for_locking_items / for_read_only
def for_read_only: []LockingClause = FOR READ ONLY -> list()
def for_locking_items: []LockingClause = xs:for_locking_item+ -> $xs
def for_locking_item: LockingClause = [st = "LCS_FORUPDATE"] [wp = "LockWaitBlock"]
    ( FOR UPDATE / FOR NO KEY UPDATE [st = "LCS_FORNOKEYUPDATE"] / FOR SHARE [st = "LCS_FORSHARE"] / FOR KEY SHARE [st = "LCS_FORKEYSHARE"] )
    rels:locked_rels? (NOWAIT [wp = "LockWaitError"] / SKIP LOCKED [wp = "LockWaitSkip"])?
    -> new LockingClause{LockedRels: concat($rels), Strength: st, WaitPolicy: wp}
def locked_rels: []RangeVar = OF l:locked_rel_list -> $l
def locked_rel_list: []RangeVar = qualified_name_list

def values_lists: []NodeList = first:values_row rest:(-COMMA x:values_row)* -> concat(list($first), map($rest, (r) => $r.x))
def values_row: NodeList = -LP l:expr_list -RP -> new NodeList{Items: $l}

// ---- WITH ----

def with_clause: WithClause = WITH r:RECURSIVE? l:cte_list -> new WithClause{Ctes: $l, Recursive: len($r) > 0}
def opt_with_clause: WithClause = with_clause
def cte_list: []CommonTableExpr = first:common_table_expr rest:(-COMMA x:common_table_expr)* -> concat(list($first), map($rest, (r) => $r.x))
def common_table_expr: CommonTableExpr = [mat = "CTEMaterializeDefault"] n:name cols:opt_name_list? AS (MATERIALIZED [mat = "CTEMaterializeAlways"] / NOT MATERIALIZED [mat = "CTEMaterializeNever"])?
    -LP q:PreparableStmt -RP s:search_clause? c:cycle_clause?
    -> new CommonTableExpr{Ctename: $n, Aliascolnames: concat($cols), Ctematerialized: mat, Ctequery: $q, SearchClause: $s, CycleClause: $c}
def opt_name_list: []Ident = -LP l:name_list -RP -> $l
def search_clause: CTESearchClause = search_depth / search_breadth
def search_depth: CTESearchClause = SEARCH DEPTH FIRST BY l:column_list SET n:ColId
    -> new CTESearchClause{SearchColList: $l, SearchBreadthFirst: false, SearchSeqColumn: $n}
def search_breadth: CTESearchClause = SEARCH BREADTH FIRST BY l:column_list SET n:ColId
    -> new CTESearchClause{SearchColList: $l, SearchBreadthFirst: true, SearchSeqColumn: $n}
def column_list: []Ident = first:ColId rest:(-COMMA x:ColId)* -> concat(list($first), map($rest, (r) => $r.x))
def cycle_clause: CTECycleClause = cycle_values / cycle_plain
def cycle_values: CTECycleClause = CYCLE l:column_list SET m:ColId TO v:AexprConst DEFAULT d:AexprConst USING p:ColId
    -> new CTECycleClause{CycleColList: $l, CycleMarkColumn: $m, CycleMarkValue: $v, CycleMarkDefault: $d, CyclePathColumn: $p}
def cycle_plain: CTECycleClause = CYCLE l:column_list SET m:ColId USING p:ColId
    -> new CTECycleClause{CycleColList: $l, CycleMarkColumn: $m, CycleMarkValue: new A_Const{Val: new Boolean{Boolval: true}}, CycleMarkDefault: new A_Const{Val: new Boolean{Boolval: false}}, CyclePathColumn: $p}

// ---- FROM items ----

// A table reference: a table_primary followed by joins, folded to the left. The right operand of
// CROSS JOIN and NATURAL JOIN is a table_primary, that of a join with ON or USING any table_ref (in
// "a JOIN b JOIN c ON x ON y" the second JOIN belongs to b). A join part is a JoinExpr without its left
// operand.
def table_ref: TableRef = first:table_primary rest:join_part*
    -> foldl($first, $rest, (acc, i) => new JoinExpr{Jointype: $i.Jointype, IsNatural: $i.IsNatural, Larg: $acc, Rarg: $i.Rarg, UsingClause: $i.UsingClause, JoinUsingAlias: $i.JoinUsingAlias, Quals: $i.Quals})
// joined_table: a table_ref that has at least one join
def joined_table: JoinExpr = first:table_primary p:join_part rest:join_part*
    -> foldl(new JoinExpr{Jointype: $p.Jointype, IsNatural: $p.IsNatural, Larg: $first, Rarg: $p.Rarg, UsingClause: $p.UsingClause, JoinUsingAlias: $p.JoinUsingAlias, Quals: $p.Quals},
        $rest, (acc, i) => new JoinExpr{Jointype: $i.Jointype, IsNatural: $i.IsNatural, Larg: $acc, Rarg: $i.Rarg, UsingClause: $i.UsingClause, JoinUsingAlias: $i.JoinUsingAlias, Quals: $i.Quals})
def join_part: JoinExpr = join_cross / join_natural / join_qual
def join_cross: JoinExpr = CROSS JOIN r:table_primary -> new JoinExpr{Jointype: "JOIN_INNER", Rarg: $r}
def join_qual: JoinExpr = [jt = "JOIN_INNER"]
    (FULL [jt = "JOIN_FULL"] OUTER? / LEFT [jt = "JOIN_LEFT"] OUTER? / RIGHT [jt = "JOIN_RIGHT"] OUTER? / INNER)? JOIN r:table_ref
    (ON qe:a_expr / USING -LP un:name_list -RP ua:join_using_alias?)
    -> new JoinExpr{Jointype: jt, Rarg: $r, UsingClause: concat($un), JoinUsingAlias: $ua, Quals: $qe}
def join_using_alias: Alias = AS n:ColId -> new Alias{Aliasname: $n}
def join_natural: JoinExpr = [jt = "JOIN_INNER"] NATURAL
    (FULL [jt = "JOIN_FULL"] OUTER? / LEFT [jt = "JOIN_LEFT"] OUTER? / RIGHT [jt = "JOIN_RIGHT"] OUTER? / INNER)? JOIN r:table_primary
    -> new JoinExpr{Jointype: jt, IsNatural: true, Rarg: $r}

def table_primary: TableRef = relation_table / sample_table / func_table_ref / subselect_table / paren_join_alias / paren_join / xmljson_table

// relation_expr: a table name, with * (the same as without it) or ONLY
def relation_expr: RangeVar = rel_only_paren / rel_only / rel_plain
def rel_plain: RangeVar = r:qualified_name -STAR? -> $r
def rel_only: RangeVar = ONLY n:qualified_name
    -> new RangeVar{Catalogname: $n.Catalogname, Schemaname: $n.Schemaname, Relname: $n.Relname, Inh: false, Relpersistence: "p"}
def rel_only_paren: RangeVar = ONLY -LP n:qualified_name -RP
    -> new RangeVar{Catalogname: $n.Catalogname, Schemaname: $n.Schemaname, Relname: $n.Relname, Inh: false, Relpersistence: "p"}
def relation_expr_list: []RangeVar = first:relation_expr rest:(-COMMA x:relation_expr)* -> concat(list($first), map($rest, (r) => $r.x))
// relation_expr opt_alias_clause
def relation_alias: RangeVar = r:relation_expr !"(" a:alias_clause?
    -> new RangeVar{Catalogname: $r.Catalogname, Schemaname: $r.Schemaname, Relname: $r.Relname, Inh: $r.Inh, Relpersistence: $r.Relpersistence, Alias: $a}
def relation_table: RangeVar = !(ROWS FROM LP) r:relation_alias !TABLESAMPLE -> $r
def sample_table: RangeTableSample = r:relation_alias TABLESAMPLE m:func_name -LP a:expr_list -RP rp:repeatable_clause?
    -> new RangeTableSample{Relation: $r, Method: $m, Args: $a, Repeatable: $rp}
def repeatable_clause: Expr = REPEATABLE -LP e:a_expr -RP -> $e

def subselect_table: RangeSubselect = lat:LATERAL? q:select_with_parens a:alias_clause?
    -> new RangeSubselect{Lateral: len($lat) > 0, Subquery: $q, Alias: $a}
def paren_join: JoinExpr = -LP j:joined_table -RP -> $j
def paren_join_alias: JoinExpr = -LP j:joined_table -RP a:alias_clause
    -> new JoinExpr{Jointype: $j.Jointype, IsNatural: $j.IsNatural, Larg: $j.Larg, Rarg: $j.Rarg, UsingClause: $j.UsingClause, JoinUsingAlias: $j.JoinUsingAlias, Quals: $j.Quals, Alias: $a}

def alias_clause: Alias = -AS? n:ColId cl:alias_cols? -> new Alias{Aliasname: $n, Colnames: concat($cl)}
def alias_cols: []Ident = -LP l:name_list -RP -> $l
def alias_name_only: Alias = n:ColId -> new Alias{Aliasname: $n}

// Function calls in FROM: func_expr_windowless with WITH ORDINALITY and an alias or a column list.
def func_table_ref: RangeFunction = func_table_plain / func_table_rows_from
def func_table_plain: RangeFunction = lat:LATERAL? f:func_expr_windowless o:with_ordinality?
    ( -AS -LP cd:table_func_element_list -RP / -AS al:alias_name_only -LP cd:table_func_element_list -RP / al:alias_name_only -LP cd:table_func_element_list -RP / al:alias_clause )?
    -> new RangeFunction{Lateral: len($lat) > 0, Ordinality: len($o) > 0, Functions: list(new RangeFuncItem{Func: $f}), Alias: $al, Coldeflist: concat($cd)}
def func_table_rows_from: RangeFunction = lat:LATERAL? ROWS FROM -LP l:rowsfrom_list -RP o:with_ordinality?
    ( -AS -LP cd:table_func_element_list -RP / -AS al:alias_name_only -LP cd:table_func_element_list -RP / al:alias_name_only -LP cd:table_func_element_list -RP / al:alias_clause )?
    -> new RangeFunction{Lateral: len($lat) > 0, Ordinality: len($o) > 0, IsRowsfrom: true, Functions: $l, Alias: $al, Coldeflist: concat($cd)}
def with_ordinality = WITH ORDINALITY
def rowsfrom_list: []RangeFuncItem = first:rowsfrom_item rest:(-COMMA x:rowsfrom_item)* -> concat(list($first), map($rest, (r) => $r.x))
def rowsfrom_item: RangeFuncItem = f:func_expr_windowless cd:rowsfrom_coldef? -> new RangeFuncItem{Func: $f, Coldeflist: concat($cd)}
def rowsfrom_coldef: []ColumnDef = AS -LP l:table_func_element_list -RP -> $l
def table_func_element_list: []ColumnDef = first:table_func_element rest:(-COMMA x:table_func_element)* -> concat(list($first), map($rest, (r) => $r.x))
def table_func_element: ColumnDef = n:ColId t:Typename c:opt_collate_clause? -> new ColumnDef{Colname: $n, TypeName: $t, CollClause: $c, IsLocal: true}
def opt_collate_clause: CollateClause = COLLATE n:any_name -> new CollateClause{Collname: $n}

// func_expr_windowless: a function call without WITHIN GROUP, FILTER and OVER
def func_expr_windowless: Expr = [windowless = true] f:func_expr_w -> $f
def func_expr_w: Expr = func_call_over / func_special_w / json_agg_expr
def func_special_w: Expr = [windowless = false] f:func_expr_common_subexpr -> $f

// ---- Windows ----

def window_clause: []WindowDef = WINDOW l:window_definition_list -> $l
def window_definition_list: []WindowDef = first:window_definition rest:(-COMMA x:window_definition)* -> concat(list($first), map($rest, (r) => $r.x))
def window_definition: WindowDef = &(ColId AS) w:window_def -> $w

// A window specification, with its name in a WINDOW clause, with the frame options of frame_extent
// computed in the variable fo: the bits of FRAMEOPTION_* of parsenodes.h. fm is the unit of the frame
// (RANGE, ROWS or GROUPS, with FRAMEOPTION_NONDEFAULT), fs and fe the bits of its start and its end.
// The checks are those of frame_extent.
def window_def: WindowDef =
    wn:window_name_as?
    -LP rn:existing_window_name? pc:partition_by? oc:opt_sort_clause
    [fo = 1058]
    ( ( RANGE [fm = 3] / ROWS [fm = 5] / GROUPS [fm = 9] )
      ( BETWEEN
        ( UNBOUNDED PRECEDING [fs = 32] / UNBOUNDED FOLLOWING [fs = 128] / CURRENT ROW [fs = 512]
        / so:a_expr PRECEDING [fs = 2048] / so:a_expr FOLLOWING [fs = 8192] )
        AND
        ( UNBOUNDED PRECEDING [fe = 64] / UNBOUNDED FOLLOWING [fe = 256] / CURRENT ROW [fe = 1024]
        / eo:a_expr PRECEDING [fe = 4096] / eo:a_expr FOLLOWING [fe = 16384] )
        [fs != 128] [fe != 64] [!(fs == 512 && fe == 4096)] [!(fs == 8192 && (fe == 4096 || fe == 1024))]
        [fo = fm + 16 + fs + fe]
      / ( UNBOUNDED PRECEDING [fs = 32] / UNBOUNDED FOLLOWING [fs = 128] / CURRENT ROW [fs = 512]
        / so:a_expr PRECEDING [fs = 2048] / so:a_expr FOLLOWING [fs = 8192] )
        [fs != 128] [fs != 8192] [fo = fm + fs + 1024] )
      ( EXCLUDE CURRENT ROW [fo = fo + 32768] / EXCLUDE GROUP [fo = fo + 65536] / EXCLUDE TIES [fo = fo + 131072] / EXCLUDE NO OTHERS )?
    )?
    -RP
    -> new WindowDef{Name: $wn, Refname: $rn, PartitionClause: concat($pc), OrderClause: $oc, FrameOptions: fo, StartOffset: $so, EndOffset: $eo}
def window_name_as: Ident = n:ColId AS -> $n
// PARTITION, RANGE, ROWS and GROUPS start the specification, they are not the name of an existing window
def existing_window_name: Ident = !(PARTITION / RANGE / ROWS / GROUPS) n:ColId -> $n
def partition_by: []Expr = PARTITION BY l:expr_list -> $l

// ==== INSERT, UPDATE, DELETE, MERGE ====

def PreparableStmt: DmlStmt = stmt_dml

def InsertStmt: InsertStmt = [ov = ""] w:with_clause? INSERT INTO t:insert_target
    ( c:insert_columns? (OVERRIDING (USER [ov = "OVERRIDING_USER_VALUE"] / SYSTEM [ov = "OVERRIDING_SYSTEM_VALUE"]) VALUE)? sel:SelectStmt
    / DEFAULT VALUES )
    oc:on_conflict_clause? rt:returning_clause?
    -> new InsertStmt{Relation: $t, Cols: concat($c), SelectStmt: $sel, OnConflictClause: $oc, ReturningClause: $rt, WithClause: $w, Override: ov}
def insert_target: RangeVar = qualified_name_as / qualified_name
def qualified_name_as: RangeVar = n:qualified_name AS a:ColId
    -> new RangeVar{Catalogname: $n.Catalogname, Schemaname: $n.Schemaname, Relname: $n.Relname, Inh: true, Relpersistence: "p", Alias: new Alias{Aliasname: $a}}
def insert_columns: []ResTarget = -LP l:insert_column_list -RP -> $l
def insert_column_list: []ResTarget = first:set_target rest:(-COMMA x:set_target)* -> concat(list($first), map($rest, (r) => $r.x))
// set_target and insert_column_item: a column with an indirection
def set_target: ResTarget = n:ColId ind:indirection? -> new ResTarget{Name: $n, Indirection: concat($ind)}

def on_conflict_clause: OnConflictClause = on_conflict_update / on_conflict_nothing
def on_conflict_update: OnConflictClause = ON CONFLICT i:conf_expr? DO UPDATE SET l:set_clause_list w:where_clause?
    -> new OnConflictClause{Action: "ONCONFLICT_UPDATE", Infer: $i, TargetList: $l, WhereClause: $w}
def on_conflict_nothing: OnConflictClause = ON CONFLICT i:conf_expr? DO NOTHING
    -> new OnConflictClause{Action: "ONCONFLICT_NOTHING", Infer: $i}
def conf_expr: InferClause = conf_index / conf_constraint
def conf_index: InferClause = -LP l:index_params -RP w:where_clause? -> new InferClause{IndexElems: $l, WhereClause: $w}
def conf_constraint: InferClause = ON CONSTRAINT n:name -> new InferClause{Conname: $n}

def returning_clause: ReturningClause = RETURNING o:returning_with? l:target_list -> new ReturningClause{Options: concat($o), Exprs: $l}
def returning_with: []ReturningOption = WITH -LP first:returning_option rest:(-COMMA x:returning_option)* -RP
    -> concat(list($first), map($rest, (r) => $r.x))
def returning_option: ReturningOption = (OLD [k = "RETURNING_OPTION_OLD"] / NEW [k = "RETURNING_OPTION_NEW"]) AS n:ColId
    -> new ReturningOption{Option: k, Value: $n}

def DeleteStmt: DeleteStmt = w:with_clause? DELETE FROM r:relation_expr_opt_alias u:using_clause? wh:where_or_current_clause? rt:returning_clause?
    -> new DeleteStmt{Relation: $r, UsingClause: concat($u), WhereClause: $wh, ReturningClause: $rt, WithClause: $w}
def using_clause: []TableRef = USING l:from_list -> $l
def where_or_current_clause: Expr = where_current_of / where_clause
def where_current_of: CurrentOfExpr = WHERE CURRENT OF n:cursor_name -> new CurrentOfExpr{CursorName: $n}
def cursor_name = name
// relation_expr opt_alias_clause for UPDATE and DELETE: [AS] name; the name is not SET without AS
def relation_expr_opt_alias: RangeVar = r:relation_expr a:dml_alias?
    -> new RangeVar{Catalogname: $r.Catalogname, Schemaname: $r.Schemaname, Relname: $r.Relname, Inh: $r.Inh, Relpersistence: $r.Relpersistence, Alias: $a}
def dml_alias: Alias = (AS / !SET) n:ColId -> new Alias{Aliasname: $n}

def UpdateStmt: UpdateStmt = w:with_clause? UPDATE r:relation_expr_opt_alias SET l:set_clause_list f:from_clause? wh:where_or_current_clause? rt:returning_clause?
    -> new UpdateStmt{Relation: $r, TargetList: $l, FromClause: concat($f), WhereClause: $wh, ReturningClause: $rt, WithClause: $w}
def set_clause_list: []ResTarget = first:set_clause rest:(-COMMA x:set_clause)* -> foldl($first, $rest, (acc, i) => concat($acc, $i.x))
def set_clause: []ResTarget = set_clause_single / set_clause_multi
def set_clause_single: []ResTarget = t:set_target -EQ e:a_expr -> list(new ResTarget{Name: $t.Name, Indirection: $t.Indirection, Val: $e})
// (a, b) = expr: every target gets a MultiAssignRef with its position
def set_clause_multi: []ResTarget = -LP ts:insert_column_list -RP -EQ e:a_expr
    -> foldl(list(), $ts, (acc, t) => concat($acc, list(new ResTarget{Name: $t.Name, Indirection: $t.Indirection, Val: new MultiAssignRef{Source: $e, Colno: len($acc) + 1, Ncolumns: len($ts)}})))

def MergeStmt: MergeStmt = w:with_clause? MERGE INTO r:relation_expr_opt_alias USING s:table_ref ON c:a_expr l:merge_when_clause+ rt:returning_clause?
    -> new MergeStmt{Relation: $r, SourceRelation: $s, JoinCondition: $c, MergeWhenClauses: $l, ReturningClause: $rt, WithClause: $w}
def merge_when_clause: MergeWhenClause = merge_update / merge_delete / merge_insert / merge_nothing
def merge_update: MergeWhenClause = WHEN (MATCHED [mk = "MERGE_WHEN_MATCHED"] / NOT MATCHED BY SOURCE [mk = "MERGE_WHEN_NOT_MATCHED_BY_SOURCE"])
    c:merge_cond? THEN UPDATE SET l:set_clause_list
    -> new MergeWhenClause{MatchKind: mk, CommandType: "CMD_UPDATE", Override: "OVERRIDING_NOT_SET", Condition: $c, TargetList: $l}
def merge_delete: MergeWhenClause = WHEN (MATCHED [mk = "MERGE_WHEN_MATCHED"] / NOT MATCHED BY SOURCE [mk = "MERGE_WHEN_NOT_MATCHED_BY_SOURCE"])
    c:merge_cond? THEN DELETE
    -> new MergeWhenClause{MatchKind: mk, CommandType: "CMD_DELETE", Override: "OVERRIDING_NOT_SET", Condition: $c}
def merge_insert: MergeWhenClause = [ov = "OVERRIDING_NOT_SET"] WHEN NOT MATCHED (BY TARGET)? c:merge_cond? THEN INSERT
    cols:insert_columns? (OVERRIDING (USER [ov = "OVERRIDING_USER_VALUE"] / SYSTEM [ov = "OVERRIDING_SYSTEM_VALUE"]) VALUE)?
    ( VALUES -LP v:expr_list -RP / DEFAULT VALUES )
    -> new MergeWhenClause{MatchKind: "MERGE_WHEN_NOT_MATCHED_BY_TARGET", CommandType: "CMD_INSERT", Override: ov, Condition: $c, TargetList: concat($cols), Values: concat($v)}
def merge_nothing: MergeWhenClause = WHEN (MATCHED [mk = "MERGE_WHEN_MATCHED"] / NOT MATCHED BY SOURCE [mk = "MERGE_WHEN_NOT_MATCHED_BY_SOURCE"] / NOT MATCHED (BY TARGET)? [mk = "MERGE_WHEN_NOT_MATCHED_BY_TARGET"])
    c:merge_cond? THEN DO NOTHING
    -> new MergeWhenClause{MatchKind: mk, CommandType: "CMD_NOTHING", Condition: $c}
def merge_cond: Expr = AND e:a_expr -> $e

// ---- Index elements (CREATE INDEX, ON CONFLICT, exclusion constraints) ----

def index_params: []IndexElem = first:index_elem rest:(-COMMA x:index_elem)* -> concat(list($first), map($rest, (r) => $r.x))
def index_elem: IndexElem = index_elem_name / index_elem_func / index_elem_expr
def index_elem_name: IndexElem = c:ColId !"(" o:index_elem_options
    -> new IndexElem{Name: $c, Collation: $o.Collation, Opclass: $o.Opclass, Opclassopts: $o.Opclassopts, Ordering: $o.Ordering, NullsOrdering: $o.NullsOrdering}
def index_elem_func: IndexElem = e:func_expr_windowless o:index_elem_options
    -> new IndexElem{Expr: $e, Collation: $o.Collation, Opclass: $o.Opclass, Opclassopts: $o.Opclassopts, Ordering: $o.Ordering, NullsOrdering: $o.NullsOrdering}
def index_elem_expr: IndexElem = -LP e:a_expr -RP o:index_elem_options
    -> new IndexElem{Expr: $e, Collation: $o.Collation, Opclass: $o.Opclass, Opclassopts: $o.Opclassopts, Ordering: $o.Ordering, NullsOrdering: $o.NullsOrdering}
// the options of an index element; the node is a template (its other fields are empty)
def index_elem_options: IndexElem = index_elem_options_reloptions / index_elem_options_plain
def index_elem_options_plain: IndexElem = [d = "SORTBY_DEFAULT"] [n = "SORTBY_NULLS_DEFAULT"] c:opt_collate? o:any_name?
    (ASC [d = "SORTBY_ASC"] / DESC [d = "SORTBY_DESC"])? (NULLS FIRST [n = "SORTBY_NULLS_FIRST"] / NULLS LAST [n = "SORTBY_NULLS_LAST"])?
    -> new IndexElem{Collation: concat($c), Opclass: concat($o), Ordering: d, NullsOrdering: n}
def index_elem_options_reloptions: IndexElem = [d = "SORTBY_DEFAULT"] [n = "SORTBY_NULLS_DEFAULT"] c:opt_collate? o:any_name ro:reloptions
    (ASC [d = "SORTBY_ASC"] / DESC [d = "SORTBY_DESC"])? (NULLS FIRST [n = "SORTBY_NULLS_FIRST"] / NULLS LAST [n = "SORTBY_NULLS_LAST"])?
    -> new IndexElem{Collation: concat($c), Opclass: $o, Opclassopts: $ro, Ordering: d, NullsOrdering: n}
def opt_collate: []Ident = COLLATE n:any_name -> $n

// ==== Rules shared by the statements ====

// ---- Numbers in options ----
// A signed number: the sign is kept apart, rawjson.go folds it into the value (SignedNum is not a node of
// the raw tree)
def NumericOnly: NumericOnly = fconst_only / signed_fconst / SignedIconst
// B1 change: a rule typed Fconst without an action would hold the white space after the number
def fconst_only: Fconst = f:Fconst -> $f
def signed_fconst: SignedNum = (PLUS [neg = false] / MINUS [neg = true]) n:Fconst -> new SignedNum{Negative: neg, Number: $n}
def SignedIconst: SignedIconst = Iconst / signed_iconst
def signed_iconst: SignedNum = (PLUS [neg = false] / MINUS [neg = true]) n:Iconst -> new SignedNum{Negative: neg, Number: $n}
def NumericOnly_list: []NumericOnly = first:NumericOnly rest:(-COMMA x:NumericOnly)* -> concat(list($first), map($rest, (r) => $r.x))

// ---- Options: DefElem ----
//
// def_arg is the value of an option: a type, a reserved keyword, an operator, a number, a string or NONE.
// B1 change: OPERATOR(...) before func_type (OPERATOR is also a name, but OPERATOR followed by "(" is always the
// operator in gram.y), and NumericOnly before the operators (a sign followed by a number is a number)
def def_arg: DefArg = def_arg_opcall / func_type / reserved_keyword_ident / NumericOnly / def_arg_op / Sconst / def_arg_none
def def_arg_opcall: NodeList = o:qual_op_schema -> new NodeList{Items: $o}
def def_arg_op: NodeList = o:qual_all_Op -> new NodeList{Items: $o}
def def_arg_none: String = NONE -> new String{Sval: "none"}
def reserved_keyword_ident: Ident = t:reserved_keyword_text s -> $t
def reserved_keyword_text: Ident = &reserved_word word

def def_elem: DefElem = def_elem_arg / def_elem_plain
def def_elem_arg: DefElem = n:ColLabel -EQ a:def_arg -> new DefElem{Defname: $n, Arg: $a, Defaction: "DEFELEM_UNSPEC"}
def def_elem_plain: DefElem = n:ColLabel -> new DefElem{Defname: $n, Defaction: "DEFELEM_UNSPEC"}
def def_list: []DefElem = first:def_elem rest:(-COMMA x:def_elem)* -> concat(list($first), map($rest, (r) => $r.x))
def definition: []DefElem = -LP l:def_list -RP -> $l
def opt_definition: []DefElem = WITH d:definition -> $d

// reloptions: (name [= value], ...) with optional namespace (ns.name)
def reloptions: []DefElem = -LP first:reloption_elem rest:(-COMMA x:reloption_elem)* -RP -> concat(list($first), map($rest, (r) => $r.x))
def opt_reloptions: []DefElem = WITH r:reloptions -> $r
def reloption_elem: DefElem = reloption_ns_arg / reloption_ns / reloption_arg / reloption_plain
def reloption_ns_arg: DefElem = ns:ColLabel -DOT n:ColLabel -EQ a:def_arg -> new DefElem{Defnamespace: $ns, Defname: $n, Arg: $a, Defaction: "DEFELEM_UNSPEC"}
def reloption_ns: DefElem = ns:ColLabel -DOT n:ColLabel -> new DefElem{Defnamespace: $ns, Defname: $n, Defaction: "DEFELEM_UNSPEC"}
def reloption_arg: DefElem = n:ColLabel -EQ a:def_arg -> new DefElem{Defname: $n, Arg: $a, Defaction: "DEFELEM_UNSPEC"}
def reloption_plain: DefElem = n:ColLabel -> new DefElem{Defname: $n, Defaction: "DEFELEM_UNSPEC"}

// ---- Roles ----
//
// RoleSpec: a role name (PUBLIC is the pseudo-role), CURRENT_ROLE, CURRENT_USER or SESSION_USER.
def RoleSpec: RoleSpec = role_public / role_current_role / role_current_user / role_session_user / role_name
def role_public: RoleSpec = PUBLIC_WORD -> new RoleSpec{Roletype: "ROLESPEC_PUBLIC"}
def role_current_role: RoleSpec = CURRENT_ROLE -> new RoleSpec{Roletype: "ROLESPEC_CURRENT_ROLE"}
def role_current_user: RoleSpec = CURRENT_USER -> new RoleSpec{Roletype: "ROLESPEC_CURRENT_USER"}
def role_session_user: RoleSpec = SESSION_USER -> new RoleSpec{Roletype: "ROLESPEC_SESSION_USER"}
def role_name: RoleSpec = !NONE_WORD n:NonReservedWord -> new RoleSpec{Roletype: "ROLESPEC_CSTRING", Rolename: $n}
def role_list: []RoleSpec = first:RoleSpec rest:(-COMMA x:RoleSpec)* -> concat(list($first), map($rest, (r) => $r.x))
// the words PUBLIC and NONE: unquoted in any case, or quoted in lower case
def PUBLIC_WORD = ((?pP)(?uU)(?bB)(?lL)(?iI)(?cC) / "\"public\"") !ident_cont s
def NONE_WORD = ((?nN)(?oO)(?nN)(?eE) / "\"none\"") !ident_cont s

// ---- Functions and operators as the objects of statements ----

// A function argument: [mode] [name] type, or name mode type
def func_arg: FunctionParameter = [m = "FUNC_PARAM_DEFAULT"]
    ( ( IN OUT [m = "FUNC_PARAM_INOUT"] / IN [m = "FUNC_PARAM_IN"] / OUT [m = "FUNC_PARAM_OUT"] / INOUT [m = "FUNC_PARAM_INOUT"] / VARIADIC [m = "FUNC_PARAM_VARIADIC"] )
      ( n:param_name t:func_type / t:func_type )
    / n:param_name ( IN OUT [m = "FUNC_PARAM_INOUT"] / IN [m = "FUNC_PARAM_IN"] / OUT [m = "FUNC_PARAM_OUT"] / INOUT [m = "FUNC_PARAM_INOUT"] / VARIADIC [m = "FUNC_PARAM_VARIADIC"] ) t:func_type
    / n:param_name t:func_type
    / t:func_type )
    -> new FunctionParameter{Name: $n, ArgType: $t, Mode: m}
def func_args: []FunctionParameter = -LP l:func_arg_list_p? -RP -> concat($l)
def func_arg_list_p: []FunctionParameter = first:func_arg rest:(-COMMA x:func_arg)* -> concat(list($first), map($rest, (r) => $r.x))

// func_type: a type name, or a column type name%TYPE
// B1 change: the %TYPE forms come first (Typename would match the name and leave %TYPE unparsed)
def func_type: TypeName = func_type_pct_setof / func_type_pct / Typename
def func_type_pct: TypeName = n:type_function_name a:attrs -PERCENT TYPE
    -> new TypeName{Names: concat(list($n), $a), PctType: true, Typemod: -1}
def func_type_pct_setof: TypeName = SETOF n:type_function_name a:attrs -PERCENT TYPE
    -> new TypeName{Names: concat(list($n), $a), PctType: true, Setof: true, Typemod: -1}

// function_with_argtypes: name(args), or just a name. rawjson.go computes objargs from objfuncargs
// (the types of the arguments that are not OUT).
def function_with_argtypes: ObjectWithArgs = fwa_args / fwa_type_func_keyword / fwa_name
def fwa_args: ObjectWithArgs = n:func_name a:func_args -> new ObjectWithArgs{Objname: $n, Objfuncargs: $a}
def fwa_type_func_keyword: ObjectWithArgs = w:type_func_name_ident -> new ObjectWithArgs{Objname: list($w), ArgsUnspecified: true}
def fwa_name: ObjectWithArgs = n:func_name_any -> new ObjectWithArgs{Objname: $n, ArgsUnspecified: true}
def type_func_name_ident: Ident = t:type_func_name_text s -> $t
def type_func_name_text: Ident = &type_func_name_word word
def func_name_any: []Ident = first:ColId rest:(-DOT x:attr_name)* -> concat(list($first), map($rest, (r) => $r.x))
def function_with_argtypes_list: []ObjectWithArgs = first:function_with_argtypes rest:(-COMMA x:function_with_argtypes)*
    -> concat(list($first), map($rest, (r) => $r.x))

// ==== More rules shared by the statements ====

type DropBehavior terminal   // CASCADE or RESTRICT (rawjson.go maps the keyword to DROP_CASCADE and DROP_RESTRICT)
type NoneArg struct { }      // NONE in the argument types of an operator
type ObjArg = TypeName | NoneArg
// An aggregate's arguments: the direct arguments before ORDER BY, the ordered ones after it. (*) has none.
type AggrArgs struct { Args []FunctionParameter, OrderedArgs []FunctionParameter, Star bool, OrderBy bool }

def drop_behavior: DropBehavior = CASCADE / RESTRICT
def opt_column_list: []Ident = -LP l:column_list -RP -> $l
def any_name_list: [][]Ident = first:any_name rest:(-COMMA x:any_name)* -> concat(list($first), map($rest, (r) => $r.x))

// aggregate_with_argtypes: name(args) of an aggregate
def aggr_args: AggrArgs = aggr_args_star / aggr_args_order / aggr_args_list_order / aggr_args_plain
def aggr_args_star: AggrArgs = -LP -STAR -RP -> new AggrArgs{Star: true}
def aggr_args_order: AggrArgs = -LP ORDER BY o:aggr_arg_list -RP -> new AggrArgs{OrderedArgs: $o, OrderBy: true}
// B1 change: makeOrderedSetArgs: a VARIADIC last direct argument needs exactly one VARIADIC ordered argument (gram.y also
// requires the same type, which is not checked here)
def aggr_args_list_order: AggrArgs = -LP l:aggr_arg_list ORDER BY o:aggr_arg_list -RP
    [!foldl(false, $l, (acc, p) => $p.Mode == "FUNC_PARAM_VARIADIC") || (len($o) == 1 && foldl(false, $o, (acc, p) => $p.Mode == "FUNC_PARAM_VARIADIC"))]
    -> new AggrArgs{Args: $l, OrderedArgs: $o, OrderBy: true}
def aggr_args_plain: AggrArgs = -LP l:aggr_arg_list -RP -> new AggrArgs{Args: $l}
def aggr_arg_list: []FunctionParameter = first:aggr_arg rest:(-COMMA x:aggr_arg)* -> concat(list($first), map($rest, (r) => $r.x))
// aggregates cannot have output arguments
def aggr_arg: FunctionParameter = a:func_arg [$a.Mode != "FUNC_PARAM_OUT" && $a.Mode != "FUNC_PARAM_INOUT"] -> $a
def aggregate_with_argtypes: ObjectWithArgs = n:func_name a:aggr_args -> new ObjectWithArgs{Objname: $n, Aggr: $a}
def aggregate_with_argtypes_list: []ObjectWithArgs = first:aggregate_with_argtypes rest:(-COMMA x:aggregate_with_argtypes)*
    -> concat(list($first), map($rest, (r) => $r.x))

// operator_with_argtypes: an operator and the types of its one or two operands (NONE for a missing one)
def operator_with_argtypes: ObjectWithArgs = o:any_operator a:oper_argtypes -> new ObjectWithArgs{Objname: $o, Objargs: $a}
def oper_argtypes: []ObjArg = oper_args_both / oper_args_none_left / oper_args_none_right
def oper_args_both: []ObjArg = -LP a:Typename -COMMA b:Typename -RP -> list($a, $b)
def oper_args_none_left: []ObjArg = -LP NONE -COMMA b:Typename -RP -> list(new NoneArg{}, $b)
def oper_args_none_right: []ObjArg = -LP a:Typename -COMMA NONE -RP -> list($a, new NoneArg{})
def operator_with_argtypes_list: []ObjectWithArgs = first:operator_with_argtypes rest:(-COMMA x:operator_with_argtypes)*
    -> concat(list($first), map($rest, (r) => $r.x))

// NonReservedWord_or_Sconst: a name or a string constant
type NameOrString = Ident | Sconst
def NonReservedWord_or_Sconst: NameOrString = NonReservedWord / Sconst

// stub: replaced by the statements of group A
type StmtStubA struct { }
type StmtA = StmtStubA
type ColumnDef struct { Colname Ident, TypeName TypeName, CollClause *CollateClause, IsLocal bool }
def stmt_a: StmtA = "@@never@@" -> new StmtStubA{}
// ==== CREATE FUNCTION / PROCEDURE, ALTER FUNCTION, CREATE CAST, CREATE TRANSFORM ====

// FUNCTION and PROCEDURE share the rule: only a function has RETURNS (gram.y has four productions).
// RETURNS NULL ON NULL INPUT is an option, not a return type: func_type cannot start with NULL.
def CreateFunctionStmt: CreateFunctionStmt =
    CREATE r:(OR REPLACE)? (FUNCTION [ip = false] / PROCEDURE [ip = true])
    n:func_name a:func_args_with_defaults rt:func_returns o:createfunc_opt_item* b:routine_body?
    [!ip || !$rt.Declared]
    [!$rt.Table || foldl(true, $a, (acc, p) => $acc && ($p.Mode == "FUNC_PARAM_DEFAULT" || $p.Mode == "FUNC_PARAM_IN" || $p.Mode == "FUNC_PARAM_VARIADIC"))]
    -> new CreateFunctionStmt{IsProcedure: ip, Replace: len($r) > 0, Funcname: $n, Parameters: concat($a, $rt.Parameters),
        ReturnType: $rt.Type, Options: $o, SqlBody: $b}

def func_args_with_defaults: []FunctionParameter = -LP l:func_arg_with_default_list? -RP -> concat($l)
def func_arg_with_default_list: []FunctionParameter = first:func_arg_with_default rest:(-COMMA x:func_arg_with_default)*
    -> concat(list($first), map($rest, (r) => $r.x))
def func_arg_with_default: FunctionParameter = a:func_arg ((DEFAULT / EQ) e:a_expr)?
    -> new FunctionParameter{Name: $a.Name, ArgType: $a.ArgType, Mode: $a.Mode, Defexpr: $e}

// RETURNS TABLE (...): the columns become parameters, the result is that column's type or record (setof)
def func_returns: FuncReturns = returns_table_many / returns_table_one / returns_type / returns_none
def returns_type: FuncReturns = RETURNS t:func_type -> new FuncReturns{Declared: true, Table: false, Type: $t}
def returns_none: FuncReturns = _ -> new FuncReturns{Declared: false, Table: false}
def returns_table_one: FuncReturns = RETURNS TABLE -LP c:table_func_column -RP
    -> new FuncReturns{Declared: true, Table: true, Parameters: list($c),
        Type: new TypeName{Names: $c.ArgType.Names, Setof: true, PctType: $c.ArgType.PctType, Typmods: $c.ArgType.Typmods,
            Typemod: $c.ArgType.Typemod, ArrayBounds: $c.ArgType.ArrayBounds}}
def returns_table_many: FuncReturns = RETURNS TABLE -LP first:table_func_column rest:(-COMMA x:table_func_column)+ -RP
    -> new FuncReturns{Declared: true, Table: true, Parameters: concat(list($first), map($rest, (r) => $r.x)),
        Type: new TypeName{Names: list(new String{Sval: "pg_catalog"}, new String{Sval: "record"}), Setof: true, Typemod: -1}}
def table_func_column: FunctionParameter = n:param_name t:func_type
    -> new FunctionParameter{Name: $n, ArgType: $t, Mode: "FUNC_PARAM_TABLE"}

// The options common to CREATE FUNCTION and ALTER FUNCTION
def common_func_opt_item: DefElemK = func_opt_flag / func_opt_vol / func_opt_cost / func_opt_support / func_opt_set / func_opt_parallel
def func_opt_flag: DefElemK =
    ( CALLED ON NULL INPUT [n = "strict"] [v = false]
    / RETURNS NULL ON NULL INPUT [n = "strict"] [v = true]
    / STRICT [n = "strict"] [v = true]
    / EXTERNAL? SECURITY [n = "security"] (DEFINER [v = true] / INVOKER [v = false])
    / LEAKPROOF [n = "leakproof"] [v = true]
    / NOT LEAKPROOF [n = "leakproof"] [v = false] )
    -> new DefElemK{Defname: n, Arg: new Boolean{Boolval: v}}
def func_opt_vol: DefElemK = (IMMUTABLE [v = "immutable"] / STABLE [v = "stable"] / VOLATILE [v = "volatile"])
    -> new DefElemK{Defname: "volatility", Arg: new String{Sval: v}}
def func_opt_cost: DefElemK = (COST [n = "cost"] / ROWS [n = "rows"]) v:NumericOnly -> new DefElemK{Defname: n, Arg: $v}
def func_opt_support: DefElemK = SUPPORT n:any_name -> new DefElemK{Defname: "support", Arg: new NodeList{Items: $n}}
def func_opt_set: DefElemK = s:FunctionSetResetClause -> new DefElemK{Defname: "set", Arg: $s}
def func_opt_parallel: DefElemK = PARALLEL v:ColId -> new DefElemK{Defname: "parallel", Arg: $v}

def createfunc_opt_item: DefElemK = func_opt_as / func_opt_language / func_opt_transform / func_opt_window / common_func_opt_item
def func_opt_as: DefElemK = AS a:Sconst b:func_as_second? -> new DefElemK{Defname: "as", Arg: new NodeList{Items: concat(list($a), $b)}}
def func_as_second: []Sconst = -COMMA x:Sconst -> list($x)
def func_opt_language: DefElemK = LANGUAGE v:NonReservedWord_or_Sconst -> new DefElemK{Defname: "language", Arg: $v}
def func_opt_transform: DefElemK = TRANSFORM first:transform_type rest:(-COMMA x:transform_type)*
    -> new DefElemK{Defname: "transform", Arg: new NodeList{Items: concat(list($first), map($rest, (r) => $r.x))}}
def transform_type: TypeName = FOR TYPE t:Typename -> $t
def func_opt_window: DefElemK = WINDOW -> new DefElemK{Defname: "window", Arg: new Boolean{Boolval: true}}

// RETURN expr, or BEGIN ATOMIC statements END. The statements are those of the core (`stmt`) and RETURN; empty
// statements are dropped. The body is a list holding the list of statements, so that an empty body can be told
// from no body.
def routine_body: FuncBody = ReturnStmt / begin_atomic
def ReturnStmt: ReturnStmt = RETURN e:a_expr -> new ReturnStmt{Returnval: $e}
def begin_atomic: NodeList = BEGIN ATOMIC -SEMI* xs:(x:routine_body_stmt -SEMI+)* END
    -> new NodeList{Items: list(new NodeList{Items: map($xs, (r) => $r.x)})}
def routine_body_stmt: BodyStmt = stmt / ReturnStmt

def AlterFunctionStmt: AlterFunctionStmt =
    ALTER (FUNCTION [k = "OBJECT_FUNCTION"] / PROCEDURE [k = "OBJECT_PROCEDURE"] / ROUTINE [k = "OBJECT_ROUTINE"])
    f:function_with_argtypes a:common_func_opt_item+ RESTRICT?
    -> new AlterFunctionStmt{Objtype: k, Func: $f, Actions: $a}

// ---- CREATE CAST, CREATE TRANSFORM and their DROP statements ----

def CreateCastStmt: CreateCastStmt = [c = "COERCION_EXPLICIT"] [io = false]
    CREATE CAST -LP s:Typename AS t:Typename -RP
    (WITH FUNCTION f:function_with_argtypes / WITHOUT FUNCTION / WITH INOUT [io = true])
    (AS (IMPLICIT [c = "COERCION_IMPLICIT"] / ASSIGNMENT [c = "COERCION_ASSIGNMENT"]))?
    -> new CreateCastStmt{Sourcetype: $s, Targettype: $t, Func: $f, Context: c, Inout: io}

def DropCastStmt: DropStmt = DROP CAST ie:(IF EXISTS)? -LP s:Typename AS t:Typename -RP b:drop_behavior?
    -> new DropStmt{Objects: list(new NodeList{Items: list($s, $t)}), RemoveType: "OBJECT_CAST", Behavior: $b, MissingOk: len($ie) > 0}

def CreateTransformStmt: CreateTransformStmt = CREATE r:(OR REPLACE)? TRANSFORM FOR t:Typename LANGUAGE l:name
    -LP (fr:transform_from (-COMMA to:transform_to)? / to:transform_to (-COMMA fr:transform_from)?) -RP
    -> new CreateTransformStmt{Replace: len($r) > 0, TypeName: $t, Lang: $l, Fromsql: $fr, Tosql: $to}
def transform_from: ObjectWithArgs = FROM SQL WITH FUNCTION f:function_with_argtypes -> $f
def transform_to: ObjectWithArgs = TO SQL WITH FUNCTION f:function_with_argtypes -> $f

def DropTransformStmt: DropStmt = DROP TRANSFORM ie:(IF EXISTS)? FOR t:Typename LANGUAGE l:name b:drop_behavior?
    -> new DropStmt{Objects: list(new NodeList{Items: list($t, $l)}), RemoveType: "OBJECT_TRANSFORM", Behavior: $b, MissingOk: len($ie) > 0}
// ==== CREATE AGGREGATE / OPERATOR / TYPE / TEXT SEARCH / COLLATION, ALTER TYPE, operator classes ====

// DefineStmt. CREATE TYPE with AS (composite, enum, range) are other nodes: see below. The old-style aggregate
// definition (CREATE AGGREGATE name (basetype = ...)) has no argument list.
def DefineStmt: DefineStmt = [os = false]
    CREATE
    ( r:(OR REPLACE)? AGGREGATE [k = "OBJECT_AGGREGATE"] n:func_name
        (a:aggr_args d:definition / [os = true] d:old_aggr_definition)
    / OPERATOR [k = "OBJECT_OPERATOR"] n:any_operator d:definition
    / TYPE [k = "OBJECT_TYPE"] n:any_name d:definition?
    / TEXT SEARCH (PARSER [k = "OBJECT_TSPARSER"] / DICTIONARY [k = "OBJECT_TSDICTIONARY"]
        / TEMPLATE [k = "OBJECT_TSTEMPLATE"] / CONFIGURATION [k = "OBJECT_TSCONFIGURATION"]) n:any_name d:definition
    / COLLATION [k = "OBJECT_COLLATION"] ine:(IF NOT EXISTS)? n:any_name d:(definition / collation_from) )
    -> new DefineStmt{Kind: k, Oldstyle: os, Defnames: $n, Args: $a, Definition: concat($d), IfNotExists: len($ine) > 0, Replace: len($r) > 0}

def collation_from: []DefElemK = FROM n:any_name -> list(new DefElemK{Defname: "from", Arg: new NodeList{Items: $n}})
def old_aggr_definition: []DefElem = -LP first:old_aggr_elem rest:(-COMMA x:old_aggr_elem)* -RP
    -> concat(list($first), map($rest, (r) => $r.x))
// the name of an old-style aggregate option is an IDENT (not a keyword)
def old_aggr_elem: DefElem = n:IDENT -EQ a:def_arg -> new DefElem{Defname: $n, Arg: $a, Defaction: "DEFELEM_UNSPEC"}

def CompositeTypeStmt: CompositeTypeStmt = CREATE TYPE r:qualified_name AS -LP l:table_func_element_list? -RP
    -> new CompositeTypeStmt{Typevar: new RangeVar{Catalogname: $r.Catalogname, Schemaname: $r.Schemaname, Relname: $r.Relname, Relpersistence: "p"}, Coldeflist: concat($l)}
def CreateEnumStmt: CreateEnumStmt = CREATE TYPE n:any_name AS ENUM -LP l:enum_val_list? -RP
    -> new CreateEnumStmt{TypeName: $n, Vals: concat($l)}
def enum_val_list: []Sconst = first:Sconst rest:(-COMMA x:Sconst)* -> concat(list($first), map($rest, (r) => $r.x))
def CreateRangeStmt: CreateRangeStmt = CREATE TYPE n:any_name AS RANGE d:definition -> new CreateRangeStmt{TypeName: $n, Params: $d}

// ALTER TYPE: enum values (DROP VALUE is rejected by the parser) and SET (options)
def AlterEnumStmt: AlterEnumStmt = alter_enum_add / alter_enum_rename
def alter_enum_add: AlterEnumStmt = [after = true] ALTER TYPE n:any_name ADD VALUE ine:(IF NOT EXISTS)? v:Sconst
    (BEFORE nb:Sconst [after = false] / AFTER nb:Sconst)?
    -> new AlterEnumStmt{TypeName: $n, NewVal: $v, NewValNeighbor: $nb, NewValIsAfter: after, SkipIfNewValExists: len($ine) > 0}
def alter_enum_rename: AlterEnumStmt = ALTER TYPE n:any_name RENAME VALUE o:Sconst TO v:Sconst
    -> new AlterEnumStmt{TypeName: $n, OldVal: $o, NewVal: $v}
def AlterTypeStmt: AlterTypeStmt = ALTER TYPE n:any_name SET -LP l:operator_def_list -RP -> new AlterTypeStmt{TypeName: $n, Options: $l}

// ALTER OPERATOR ... SET (...): the options of ALTER TYPE too. NONE as a value is no value.
def AlterOperatorStmt: AlterOperatorStmt = ALTER OPERATOR o:operator_with_argtypes SET -LP l:operator_def_list -RP
    -> new AlterOperatorStmt{Opername: $o, Options: $l}
def operator_def_list: []DefElem = first:operator_def_elem rest:(-COMMA x:operator_def_elem)* -> concat(list($first), map($rest, (r) => $r.x))
def operator_def_elem: DefElem = operator_def_none / def_elem
def operator_def_none: DefElem = n:ColLabel -EQ -NONE -> new DefElem{Defname: $n, Defaction: "DEFELEM_UNSPEC"}

// ---- Operator classes and families ----

def CreateOpClassStmt: CreateOpClassStmt = CREATE OPERATOR CLASS n:any_name d:DEFAULT? FOR TYPE t:Typename USING a:name
    (FAMILY x:any_name)? AS l:opclass_item_list
    -> new CreateOpClassStmt{Opclassname: $n, Opfamilyname: concat($x), Amname: $a, Datatype: $t, Items: $l, IsDefault: len($d) > 0}
def opclass_item_list: []CreateOpClassItem = first:opclass_item rest:(-COMMA x:opclass_item)* -> concat(list($first), map($rest, (r) => $r.x))
def opclass_item: CreateOpClassItem = opclass_item_oper / opclass_item_func / opclass_item_storage
def opclass_item_oper: CreateOpClassItem = OPERATOR n:Iconst o:(operator_with_argtypes / opclass_oper_bare)
    (FOR SEARCH / FOR ORDER BY f:any_name)?
    -> new CreateOpClassItem{Itemtype: 1, Name: $o, Number: $n, OrderFamily: concat($f)}
def opclass_oper_bare: ObjectWithArgs = o:any_operator -> new ObjectWithArgs{Objname: $o}
def opclass_item_func: CreateOpClassItem = FUNCTION n:Iconst (-LP a:type_list -RP)? f:function_with_argtypes
    -> new CreateOpClassItem{Itemtype: 2, Name: $f, Number: $n, ClassArgs: concat($a)}
def opclass_item_storage: CreateOpClassItem = STORAGE t:Typename -> new CreateOpClassItem{Itemtype: 3, Storedtype: $t}

def CreateOpFamilyStmt: CreateOpFamilyStmt = CREATE OPERATOR FAMILY n:any_name USING a:name
    -> new CreateOpFamilyStmt{Opfamilyname: $n, Amname: $a}
def AlterOpFamilyStmt: AlterOpFamilyStmt = [dr = false] ALTER OPERATOR FAMILY n:any_name USING a:name
    (ADD l:opclass_item_list / DROP [dr = true] l:opclass_drop_list)
    -> new AlterOpFamilyStmt{Opfamilyname: $n, Amname: $a, IsDrop: dr, Items: $l}
def opclass_drop_list: []CreateOpClassItem = first:opclass_drop rest:(-COMMA x:opclass_drop)* -> concat(list($first), map($rest, (r) => $r.x))
def opclass_drop: CreateOpClassItem = (OPERATOR [it = 1] / FUNCTION [it = 2]) n:Iconst -LP a:type_list -RP
    -> new CreateOpClassItem{Itemtype: it, Number: $n, ClassArgs: $a}

def DropOpClassStmt: DropStmt = DROP OPERATOR CLASS ie:(IF EXISTS)? n:any_name USING a:name b:drop_behavior?
    -> new DropStmt{Objects: list(new NodeList{Items: concat(list($a), $n)}), RemoveType: "OBJECT_OPCLASS", Behavior: $b, MissingOk: len($ie) > 0}
def DropOpFamilyStmt: DropStmt = DROP OPERATOR FAMILY ie:(IF EXISTS)? n:any_name USING a:name b:drop_behavior?
    -> new DropStmt{Objects: list(new NodeList{Items: concat(list($a), $n)}), RemoveType: "OBJECT_OPFAMILY", Behavior: $b, MissingOk: len($ie) > 0}

// ---- Text search, conversions, collations ----

def AlterTSDictionaryStmt: AlterTSDictionaryStmt = ALTER TEXT SEARCH DICTIONARY n:any_name d:definition
    -> new AlterTSDictionaryStmt{Dictname: $n, Options: $d}

// ALTER TEXT SEARCH CONFIGURATION: the dictionaries are lists of names, the token types a list of names
def AlterTSConfigurationStmt: AlterTSConfigurationStmt = [ov = false] [rp = false] [me = false]
    ALTER TEXT SEARCH CONFIGURATION c:any_name
    ( ADD MAPPING FOR t:name_list WITH d:ts_dict_list [k = "ALTER_TSCONFIG_ADD_MAPPING"]
    / ALTER MAPPING
        ( FOR t:name_list (WITH d:ts_dict_list [k = "ALTER_TSCONFIG_ALTER_MAPPING_FOR_TOKEN"] [ov = true]
            / REPLACE d:ts_dict_pair [k = "ALTER_TSCONFIG_REPLACE_DICT_FOR_TOKEN"] [rp = true])
        / REPLACE d:ts_dict_pair [k = "ALTER_TSCONFIG_REPLACE_DICT"] [rp = true] )
    / DROP MAPPING (IF EXISTS [me = true])? FOR t:name_list [k = "ALTER_TSCONFIG_DROP_MAPPING"] )
    -> new AlterTSConfigurationStmt{Kind: k, Cfgname: $c, Tokentype: concat($t), Dicts: concat($d), Override: ov, Replace: rp, MissingOk: me}
def ts_dict: NodeList = n:any_name -> new NodeList{Items: $n}
def ts_dict_list: []NodeList = first:ts_dict rest:(-COMMA x:ts_dict)* -> concat(list($first), map($rest, (r) => $r.x))
def ts_dict_pair: []NodeList = a:ts_dict WITH b:ts_dict -> list($a, $b)

def CreateConversionStmt: CreateConversionStmt = CREATE d:DEFAULT? CONVERSION n:any_name FOR a:Sconst TO b:Sconst FROM f:any_name
    -> new CreateConversionStmt{ConversionName: $n, ForEncodingName: $a, ToEncodingName: $b, FuncName: $f, Def: len($d) > 0}

def AlterCollationStmt: AlterCollationStmt = ALTER COLLATION n:any_name REFRESH VERSION -> new AlterCollationStmt{Collname: $n}
// ==== CREATE LANGUAGE, CREATE/ALTER EXTENSION, CREATE ACCESS METHOD ====

def CreateAmStmt: CreateAmStmt = CREATE ACCESS METHOD n:name TYPE (INDEX [t = "i"] / TABLE [t = "t"]) HANDLER h:handler_name
    -> new CreateAmStmt{Amname: $n, HandlerName: $h, Amtype: t}

// This ought to be func_name, but that conflicts in gram.y: simple names are used instead.
def handler_name: []Ident = n:name a:attrs? -> concat(list($n), $a)
def opt_procedural = PROCEDURAL?

// CREATE LANGUAGE with a handler is a CreatePLangStmt. Without one it is CREATE EXTENSION (OR REPLACE means
// IF NOT EXISTS, TRUSTED is ignored).
def CreatePLangStmt: CreatePLangStmt = CREATE r:(OR REPLACE)? t:TRUSTED? opt_procedural LANGUAGE n:name HANDLER h:handler_name
    (INLINE i:handler_name)? (VALIDATOR v:handler_name / NO VALIDATOR)?
    -> new CreatePLangStmt{Replace: len($r) > 0, Plname: $n, Plhandler: $h, Plinline: concat($i), Plvalidator: concat($v), Pltrusted: len($t) > 0}

def CreateExtensionStmt: CreateExtensionStmt = create_language_ext / create_extension
def create_language_ext: CreateExtensionStmt = CREATE r:(OR REPLACE)? TRUSTED? opt_procedural LANGUAGE n:name !HANDLER
    -> new CreateExtensionStmt{Extname: $n, IfNotExists: len($r) > 0}
def create_extension: CreateExtensionStmt = CREATE EXTENSION ine:(IF NOT EXISTS)? n:name WITH? o:create_extension_opt_item*
    -> new CreateExtensionStmt{Extname: $n, IfNotExists: len($ine) > 0, Options: $o}
// CREATE EXTENSION ... FROM is no longer supported (an error in gram.y)
def create_extension_opt_item: DefElemK = ext_opt_schema / ext_opt_version / ext_opt_cascade
def ext_opt_schema: DefElemK = SCHEMA n:name -> new DefElemK{Defname: "schema", Arg: $n}
def ext_opt_version: DefElemK = VERSION v:NonReservedWord_or_Sconst -> new DefElemK{Defname: "new_version", Arg: $v}
def ext_opt_cascade: DefElemK = CASCADE -> new DefElemK{Defname: "cascade", Arg: new Boolean{Boolval: true}}

def AlterExtensionStmt: AlterExtensionStmt = ALTER EXTENSION n:name UPDATE o:alter_extension_opt_item*
    -> new AlterExtensionStmt{Extname: $n, Options: $o}
def alter_extension_opt_item: DefElemK = TO v:NonReservedWord_or_Sconst -> new DefElemK{Defname: "new_version", Arg: $v}

// ALTER EXTENSION name ADD/DROP object: the object type is the keyword(s) written
def AlterExtensionContentsStmt: AlterExtensionContentsStmt = ALTER EXTENSION n:name (ADD [act = 1] / DROP [act = -1]) o:ext_obj
    -> new AlterExtensionContentsStmt{Extname: $n, Action: act, Objtype: $o.Objtype, Object: $o.Object}
def ext_obj: ExtObj = ext_obj_name / ext_obj_any / ext_obj_func / ext_obj_agg / ext_obj_oper / ext_obj_type / ext_obj_cast
    / ext_obj_opclass / ext_obj_transform
def ext_obj_name: ExtObj = t:object_type_name o:name -> new ExtObj{Objtype: $t, Object: $o}
def ext_obj_any: ExtObj = t:object_type_any_name o:any_name -> new ExtObj{Objtype: $t, Object: new NodeList{Items: $o}}
def ext_obj_func: ExtObj = t:ext_func_type o:function_with_argtypes -> new ExtObj{Objtype: $t, Object: $o}
def ext_func_type: ObjectType = FUNCTION / PROCEDURE / ROUTINE
def ext_obj_agg: ExtObj = t:ext_agg_type o:aggregate_with_argtypes -> new ExtObj{Objtype: $t, Object: $o}
def ext_agg_type: ObjectType = AGGREGATE
def ext_obj_oper: ExtObj = t:ext_oper_type o:operator_with_argtypes -> new ExtObj{Objtype: $t, Object: $o}
def ext_oper_type: ObjectType = OPERATOR
def ext_obj_type: ExtObj = t:ext_type_type o:Typename -> new ExtObj{Objtype: $t, Object: $o}
def ext_type_type: ObjectType = DOMAIN / TYPE
def ext_obj_cast: ExtObj = t:ext_cast_type -LP a:Typename AS b:Typename -RP -> new ExtObj{Objtype: $t, Object: new NodeList{Items: list($a, $b)}}
def ext_cast_type: ObjectType = CAST
def ext_obj_opclass: ExtObj = t:ext_opclass_type n:any_name USING a:name -> new ExtObj{Objtype: $t, Object: new NodeList{Items: concat(list($a), $n)}}
def ext_opclass_type: ObjectType = OPERATOR CLASS / OPERATOR FAMILY
def ext_obj_transform: ExtObj = t:ext_transform_type FOR a:Typename LANGUAGE l:name
    -> new ExtObj{Objtype: $t, Object: new NodeList{Items: list($a, $l)}}
def ext_transform_type: ObjectType = TRANSFORM
// ==== Group B1: functions, procedures, casts, transforms, user-defined types and operators,
// operator classes and families, text search objects, collations, languages, extensions ====
//
// The statements of this file build the nodes of the raw parse tree with the names and fields of
// parsenodes.h (see 00-types.pego). A few helper types are not nodes of the raw tree: the converter
// (ext/b1-*.py) turns them into what libpg_query returns.

// A DefElem whose name is a constant of the grammar (makeDefElem("strict", ...)): the converter makes a DefElem
// of it. DefElem itself keeps the name as source text (Ident).
type KArg = Boolean | String | Ident | Sconst | NumericOnly | NodeList | VariableSetStmt
type DefElemK struct { Defname string, Arg *KArg }
// the options of a DefineStmt: written by the user (DefElem) or made up by the grammar (DefElemK)
type DefItem = DefElem | DefElemK

type ReturnStmt struct { Returnval Expr }
type FuncBody = ReturnStmt | NodeList
type BodyStmt = Stmt | ReturnStmt
type CreateFunctionStmt struct {
    IsProcedure bool, Replace bool, Funcname []Ident, Parameters []FunctionParameter, ReturnType *TypeName,
    Options []DefElemK, SqlBody *FuncBody
}
// RETURNS of CREATE FUNCTION: the declared type, or RETURNS TABLE (which adds parameters). Not a raw node.
type FuncReturns struct { Declared bool, Table bool, Parameters []FunctionParameter, Type *TypeName }
type AlterFunctionStmt struct { Objtype string, Func ObjectWithArgs, Actions []DefElemK }

type CreateCastStmt struct { Sourcetype TypeName, Targettype TypeName, Func *ObjectWithArgs, Context string, Inout bool }
type CreateTransformStmt struct { Replace bool, TypeName TypeName, Lang Ident, Fromsql *ObjectWithArgs, Tosql *ObjectWithArgs }


type DefineStmt struct {
    Kind string, Oldstyle bool, Defnames []Str, Args *AggrArgs, Definition []DefItem, IfNotExists bool, Replace bool
}
type CompositeTypeStmt struct { Typevar RangeVar, Coldeflist []ColumnDef }
type CreateEnumStmt struct { TypeName []Ident, Vals []Sconst }
type CreateRangeStmt struct { TypeName []Ident, Params []DefElem }
type AlterEnumStmt struct {
    TypeName []Ident, OldVal Sconst, NewVal Sconst, NewValNeighbor *Sconst, NewValIsAfter bool, SkipIfNewValExists bool
}
type AlterTypeStmt struct { TypeName []Ident, Options []DefElem }

type CreateOpClassItem struct {
    Itemtype int, Name *ObjectWithArgs, Number Iconst, OrderFamily []Ident, ClassArgs []TypeName, Storedtype *TypeName
}
type CreateOpClassStmt struct {
    Opclassname []Ident, Opfamilyname []Ident, Amname Ident, Datatype TypeName, Items []CreateOpClassItem, IsDefault bool
}
type CreateOpFamilyStmt struct { Opfamilyname []Ident, Amname Ident }
type AlterOpFamilyStmt struct { Opfamilyname []Ident, Amname Ident, IsDrop bool, Items []CreateOpClassItem }
type AlterOperatorStmt struct { Opername ObjectWithArgs, Options []DefElem }

type AlterTSDictionaryStmt struct { Dictname []Ident, Options []DefElem }
type AlterTSConfigurationStmt struct {
    Kind string, Cfgname []Ident, Tokentype []Ident, Dicts []NodeList, Override bool, Replace bool, MissingOk bool
}
type CreateConversionStmt struct {
    ConversionName []Ident, ForEncodingName Sconst, ToEncodingName Sconst, FuncName []Ident, Def bool
}
type AlterCollationStmt struct { Collname []Ident }

type CreatePLangStmt struct {
    Replace bool, Plname Ident, Plhandler []Ident, Plinline []Ident, Plvalidator []Ident, Pltrusted bool
}
type CreateExtensionStmt struct { Extname Ident, IfNotExists bool, Options []DefElemK }
type AlterExtensionStmt struct { Extname Ident, Options []DefElemK }
type ExtObject = Ident | NodeList | ObjectWithArgs | TypeName
type AlterExtensionContentsStmt struct { Extname Ident, Action int, Objtype ObjectType, Object ExtObject }
// the object of ALTER EXTENSION ... ADD/DROP: its type and what names it. Not a raw node.
type ExtObj struct { Objtype ObjectType, Object ExtObject }
type CreateAmStmt struct { Amname Ident, HandlerName []Ident, Amtype string }

type StmtB = CreateFunctionStmt | AlterFunctionStmt | CreateCastStmt | CreateTransformStmt | DropStmt | DefineStmt |
    CompositeTypeStmt | CreateEnumStmt | CreateRangeStmt | AlterEnumStmt | AlterTypeStmt | CreateOpClassStmt |
    CreateOpFamilyStmt | AlterOpFamilyStmt | AlterOperatorStmt | AlterTSDictionaryStmt | AlterTSConfigurationStmt |
    CreateConversionStmt | AlterCollationStmt | CreatePLangStmt | CreateExtensionStmt | AlterExtensionStmt |
    AlterExtensionContentsStmt | CreateAmStmt

def stmt_b: StmtB =
    CreateFunctionStmt / AlterFunctionStmt / CreateCastStmt / DropCastStmt / CreateTransformStmt / DropTransformStmt
    / CompositeTypeStmt / CreateEnumStmt / CreateRangeStmt / DefineStmt
    / AlterEnumStmt / AlterTypeStmt / CreateOpClassStmt / CreateOpFamilyStmt / AlterOpFamilyStmt / DropOpClassStmt
    / DropOpFamilyStmt / AlterOperatorStmt / AlterTSDictionaryStmt / AlterTSConfigurationStmt / CreateConversionStmt
    / AlterCollationStmt / CreatePLangStmt / CreateExtensionStmt / AlterExtensionStmt / AlterExtensionContentsStmt
    / CreateAmStmt
// ---- COPY ----

// COPY table [(columns)] FROM|TO file [USING DELIMITERS 'c'] [WITH] options [WHERE ...], and COPY (query) TO.
// The options are, in this order: BINARY (old syntax), DELIMITERS (old syntax), then the options. The checks
// of gram.y: PROGRAM needs a file name, and WHERE only goes with FROM.
def CopyStmt: CopyStmt = copy_table / copy_query
def copy_table: CopyStmt = [isfrom = false] COPY b:copy_binary{0,1} r:qualified_name c:opt_column_list? (FROM [isfrom = true] / TO)
    p:PROGRAM? (f:SconstStr / STDIN / STDOUT) d:copy_delimiter{0,1} WITH? o:copy_options w:where_clause?
    [len($p) == 0 || len($f) > 0] [isfrom || $w == nil]
    -> new CopyStmt{Relation: $r, Attlist: concat($c), IsFrom: isfrom, IsProgram: len($p) > 0, Filename: $f,
        Options: concat($b, $d, $o), WhereClause: $w}
def copy_query: CopyStmt = COPY -LP q:PreparableStmt -RP TO p:PROGRAM? (f:SconstStr / STDIN / STDOUT) WITH? o:copy_options
    [len($p) == 0 || len($f) > 0]
    -> new CopyStmt{Query: $q, IsProgram: len($p) > 0, Filename: $f, Options: $o}
def copy_binary: DefElem = BINARY -> new DefElem{Defname: new String{Sval: "format"}, Arg: new String{Sval: "binary"}}
def copy_delimiter: DefElem = USING? DELIMITERS v:Sconst -> new DefElem{Defname: new String{Sval: "delimiter"}, Arg: $v}
// the options: (generic, comma separated) or the old keywords
def copy_options: []DefElem = copy_generic_options / copy_opt_list
def copy_opt_list: []DefElem = xs:copy_opt_item* -> $xs
def copy_generic_options: []DefElem = -LP first:copy_generic_opt_elem rest:(-COMMA x:copy_generic_opt_elem)* -RP
    -> concat(list($first), map($rest, (r) => $r.x))
// FORMAT followed by JSON is the token FORMAT_LA, which is not a ColLabel
def copy_generic_opt_elem: DefElem = !(FORMAT JSON) n:ColLabel a:copy_generic_opt_arg? -> new DefElem{Defname: $n, Arg: $a}
def copy_generic_opt_arg: DefArg = opt_boolean_or_string / NumericOnly / copy_star / copy_default / copy_arg_list
def copy_star: A_Star = STAR -> new A_Star{}
def copy_default: String = DEFAULT -> new String{Sval: "default"}
def copy_arg_list: NodeList = -LP first:opt_boolean_or_string rest:(-COMMA x:opt_boolean_or_string)* -RP
    -> new NodeList{Items: concat(list($first), map($rest, (r) => $r.x))}
// the old syntax
def copy_opt_item: DefElem = copy_opt_flag / copy_opt_format / copy_opt_str / copy_opt_force
def copy_opt_flag: DefElem = (FREEZE [n = "freeze"] / HEADER [n = "header"])
    -> new DefElem{Defname: new String{Sval: n}, Arg: new Boolean{Boolval: true}}
def copy_opt_format: DefElem = (BINARY [v = "binary"] / CSV [v = "csv"])
    -> new DefElem{Defname: new String{Sval: "format"}, Arg: new String{Sval: v}}
def copy_opt_str: DefElem =
    ( (DELIMITER [n = "delimiter"] / NULL [n = "null"] / QUOTE [n = "quote"] / ESCAPE [n = "escape"]) AS? / ENCODING [n = "encoding"] )
    v:Sconst -> new DefElem{Defname: new String{Sval: n}, Arg: $v}
def copy_opt_force: DefElem = FORCE (QUOTE [n = "force_quote"] / NOT NULL [n = "force_not_null"] / NULL [n = "force_null"])
    a:(copy_star / copy_columns) -> new DefElem{Defname: new String{Sval: n}, Arg: $a}
def copy_columns: NodeList = l:column_list -> new NodeList{Items: $l}

// ---- EXPLAIN, VACUUM, ANALYZE, CLUSTER, REINDEX ----

// A flag of the old syntax that stands for an option without a value: the variable want says which one is
// allowed here (the flags of VACUUM come in this order only).
def flag_opt: DefElem =
    ([want == "full"] FULL / [want == "freeze"] FREEZE / [want == "verbose"] VERBOSE / [want == "analyze"] analyze_keyword
    / [want == "concurrently"] CONCURRENTLY)
    -> new DefElem{Defname: new String{Sval: want}}
def analyze_keyword = ANALYZE / ANALYSE
def paren_options: []DefElem = -LP l:utility_option_list -RP -> $l
def utility_option_list: []DefElem = first:utility_option_elem rest:(-COMMA x:utility_option_elem)*
    -> concat(list($first), map($rest, (r) => $r.x))
def utility_option_elem: DefElem = n:(NonReservedWord / analyze_name) a:(opt_boolean_or_string / NumericOnly)?
    -> new DefElem{Defname: $n, Arg: $a}
def analyze_name: String = analyze_keyword -> new String{Sval: "analyze"}

def ExplainStmt: ExplainStmt =
    EXPLAIN (o:paren_options / [want = "analyze"] a:flag_opt{1} [want = "verbose"] v:flag_opt{0,1} / [want = "verbose"] v:flag_opt{1})?
    q:ExplainableStmt -> new ExplainStmt{Query: $q, Options: concat($o, $a, $v)}
def ExplainableStmt: ExplainableStmt = stmt_dml / DeclareCursorStmt / CreateAsStmt / CreateMatViewStmt / RefreshMatViewStmt / ExecuteStmt

def VacuumStmt: VacuumStmt = VACUUM
    ( o:paren_options
    / [want = "full"] a:flag_opt{0,1} [want = "freeze"] b:flag_opt{0,1} [want = "verbose"] c:flag_opt{0,1} [want = "analyze"] d:flag_opt{0,1} )
    r:vacuum_relation_list?
    -> new VacuumStmt{Options: concat($o, $a, $b, $c, $d), Rels: concat($r), IsVacuumcmd: true}
def AnalyzeStmt: VacuumStmt = analyze_keyword (o:paren_options / [want = "verbose"] v:flag_opt{0,1}) r:vacuum_relation_list?
    -> new VacuumStmt{Options: concat($o, $v), Rels: concat($r)}
def vacuum_relation_list: []VacuumRelation = first:vacuum_relation rest:(-COMMA x:vacuum_relation)*
    -> concat(list($first), map($rest, (r) => $r.x))
def vacuum_relation: VacuumRelation = r:relation_expr c:opt_name_list? -> new VacuumRelation{Relation: $r, VaCols: concat($c)}

def ClusterStmt: ClusterStmt = cluster_paren / cluster_plain
def cluster_paren: ClusterStmt = CLUSTER o:paren_options (r:qualified_name (USING i:name)?)?
    -> new ClusterStmt{Relation: $r, Indexname: $i, Params: $o}
// CLUSTER index ON table is the syntax before 8.3
def cluster_plain: ClusterStmt = CLUSTER [want = "verbose"] v:flag_opt{0,1} (i:name ON r:qualified_name / r:qualified_name (USING i:name)?)?
    -> new ClusterStmt{Relation: $r, Indexname: $i, Params: $v}

def ReindexStmt: ReindexStmt = REINDEX o:paren_options? [want = "concurrently"]
    ( (INDEX [k = "REINDEX_OBJECT_INDEX"] / TABLE [k = "REINDEX_OBJECT_TABLE"]) c:flag_opt{0,1} r:qualified_name
    / SCHEMA [k = "REINDEX_OBJECT_SCHEMA"] c:flag_opt{0,1} nm:name
    / (SYSTEM [k = "REINDEX_OBJECT_SYSTEM"] / DATABASE [k = "REINDEX_OBJECT_DATABASE"]) c:flag_opt{0,1} nm:ColId? )
    -> new ReindexStmt{Kind: k, Relation: $r, Name: $nm, Params: concat($o, $c)}

// ---- LOCK, TRUNCATE ----

// The lock mode is the number of the lock level: ACCESS SHARE is 1 up to ACCESS EXCLUSIVE, the default, 8.
def LockStmt: LockStmt = LOCK TABLE? l:relation_expr_list [m = 8]
    (IN (ACCESS SHARE [m = 1] / ROW SHARE [m = 2] / ROW EXCLUSIVE [m = 3] / SHARE UPDATE EXCLUSIVE [m = 4]
        / SHARE ROW EXCLUSIVE [m = 6] / SHARE [m = 5] / EXCLUSIVE [m = 7] / ACCESS EXCLUSIVE [m = 8]) MODE)?
    nw:NOWAIT? -> new LockStmt{Relations: $l, Mode: m, Nowait: len($nw) > 0}
def TruncateStmt: TruncateStmt = TRUNCATE TABLE? l:relation_expr_list [rs = false] (CONTINUE IDENTITY / RESTART IDENTITY [rs = true])?
    b:drop_behavior? -> new TruncateStmt{Relations: $l, RestartSeqs: rs, Behavior: $b}

// ---- Prepared statements and cursors ----

def PrepareStmt: PrepareStmt = PREPARE n:name t:prep_types? AS q:PreparableStmt
    -> new PrepareStmt{Name: $n, Argtypes: concat($t), Query: $q}
def prep_types: []TypeName = -LP l:type_list -RP -> $l
type ExecuteOrCreateTableAs = ExecuteStmt | CreateTableAsStmt
def ExecuteStmt: ExecuteOrCreateTableAs = execute_plain / execute_ctas
def execute_plain: ExecuteStmt = EXECUTE n:name p:execute_params? -> new ExecuteStmt{Name: $n, Params: concat($p)}
def execute_params: []Expr = -LP l:expr_list -RP -> $l
// CREATE TABLE ... AS EXECUTE is a CreateTableAsStmt: the persistence and WITH [NO] DATA are put into the
// IntoClause as in gram.y
def execute_ctas: CreateTableAsStmt = [ine = false] CREATE p:OptTemp TABLE (IF NOT EXISTS [ine = true])? t:create_as_target AS
    EXECUTE n:name a:execute_params? d:opt_with_data
    -> new CreateTableAsStmt{Query: new ExecuteStmt{Name: $n, Params: concat($a)}, Objtype: "OBJECT_TABLE", IfNotExists: ine,
        Into: new IntoClause{Rel: new RangeVar{Catalogname: $t.Rel.Catalogname, Schemaname: $t.Rel.Schemaname, Relname: $t.Rel.Relname,
            Inh: $t.Rel.Inh, Relpersistence: $p.Relpersistence, Alias: $t.Rel.Alias}, ColNames: $t.ColNames, AccessMethod: $t.AccessMethod,
            Options: $t.Options, OnCommit: $t.OnCommit, TableSpaceName: $t.TableSpaceName, SkipData: $d.SkipData}}
def DeallocateStmt: DeallocateStmt = DEALLOCATE [al = false] (PREPARE (ALL [al = true] / n:name) / ALL [al = true] / n:name)
    -> new DeallocateStmt{Name: $n, Isall: al}

def DeclareCursorStmt: DeclareCursorStmt = DECLARE n:cursor_name o:cursor_option* CURSOR [hold = 0] (WITH HOLD [hold = 32] / WITHOUT HOLD)? FOR q:SelectStmt
    -> new DeclareCursorStmt{Portalname: $n, Query: $q,
        Options: 256 + hold + foldl(0, $o, (acc, i) => $acc + $i.Bit - $i.Bit * (($acc / $i.Bit) % 2))}
// the bits of CURSOR_OPT_*; an option given twice counts once
def cursor_option: CursorOption =
    (NO SCROLL [b = 4] / SCROLL [b = 2] / BINARY [b = 1] / ASENSITIVE [b = 16] / INSENSITIVE [b = 8]) -> new CursorOption{Bit: b}

// FETCH and MOVE: the direction and the count. A count that the statement gives is kept in Count.
def FetchStmt: FetchStmt = [mv = false] (FETCH / MOVE [mv = true]) a:fetch_args
    -> new FetchStmt{Direction: $a.Direction, HowMany: $a.HowMany, Count: $a.Count, Portalname: $a.Portalname, Ismove: mv}
def fetch_args: FetchStmt = [d = "FETCH_FORWARD"] [h = 1]
    ( NEXT c:from_cursor
    / PRIOR [d = "FETCH_BACKWARD"] c:from_cursor
    / FIRST [d = "FETCH_ABSOLUTE"] c:from_cursor
    / LAST [d = "FETCH_ABSOLUTE"] [h = -1] c:from_cursor
    / ABSOLUTE [d = "FETCH_ABSOLUTE"] n:SignedIconst c:from_cursor
    / RELATIVE [d = "FETCH_RELATIVE"] n:SignedIconst c:from_cursor
    / n:SignedIconst c:from_cursor
    / ALL [h = 9223372036854775807] c:from_cursor
    / FORWARD (ALL [h = 9223372036854775807] / n:SignedIconst)? c:from_cursor
    / BACKWARD [d = "FETCH_BACKWARD"] (ALL [h = 9223372036854775807] / n:SignedIconst)? c:from_cursor
    / c:from_cursor )
    -> new FetchStmt{Direction: d, HowMany: h, Count: $n, Portalname: $c}
def from_cursor: Ident = (FROM / IN)? c:cursor_name -> $c
def ClosePortalStmt: ClosePortalStmt = CLOSE (ALL / n:cursor_name) -> new ClosePortalStmt{Portalname: $n}

// ---- LISTEN, NOTIFY, LOAD, DO, CALL ----

def ListenStmt: ListenStmt = LISTEN n:ColId -> new ListenStmt{Conditionname: $n}
def UnlistenStmt: UnlistenStmt = UNLISTEN (STAR / n:ColId) -> new UnlistenStmt{Conditionname: $n}
def NotifyStmt: NotifyStmt = NOTIFY n:ColId (COMMA p:SconstStr)? -> new NotifyStmt{Conditionname: $n, Payload: $p}
def LoadStmt: LoadStmt = LOAD f:SconstStr -> new LoadStmt{Filename: $f}
def DoStmt: DoStmt = DO l:dostmt_opt_item+ -> new DoStmt{Args: $l}
def dostmt_opt_item: DefElem = ([n = "as"] a:Sconst / LANGUAGE [n = "language"] a:NonReservedWord_or_Sconst)
    -> new DefElem{Defname: new String{Sval: n}, Arg: $a}
// CALL takes a function call without WITHIN GROUP, FILTER and OVER (func_application)
def CallStmt: CallStmt = CALL [windowless = true] f:func_call_over -> new CallStmt{Funccall: $f}
// ==== Utility statements (group C1) ====
//
// SET/RESET/SHOW, transactions, COPY, EXPLAIN, VACUUM/ANALYZE, CLUSTER, REINDEX, LOCK, TRUNCATE, cursors,
// PREPARE/EXECUTE, LISTEN/NOTIFY, LOAD, DO, CALL and ALTER SYSTEM. The nodes have the names and fields of
// the raw tree. Where the raw parser computes a value that the grammar cannot (a name joined with dots,
// the sign of a number in a count), the node keeps the source form and the converter does the same.

type StmtC = VariableSetStmt | VariableShowStmt | ConstraintsSetStmt | CheckPointStmt | DiscardStmt |
    TransactionStmt | CopyStmt | ExplainStmt | VacuumStmt | ClusterStmt | ReindexStmt | LockStmt | PrepareStmt |
    ExecuteStmt | CreateTableAsStmt | DeallocateStmt | DeclareCursorStmt | FetchStmt | ClosePortalStmt |
    ListenStmt | UnlistenStmt | NotifyStmt | LoadStmt | DoStmt | CallStmt | TruncateStmt | AlterSystemStmt

// A string constant that is a plain string (not a String node) in the raw tree: the filename of COPY, the
// gid of PREPARE TRANSACTION, the payload of NOTIFY. rawjson.go decodes it.
type SconstStr terminal
def SconstStr: SconstStr = t:sconst_str_text s -> $t
def sconst_str_text: SconstStr = sconst_text

type VarArg = A_Const | TypeCast | DefElem
// Kind is VAR_SET_VALUE (the default), VAR_SET_DEFAULT, VAR_SET_CURRENT, VAR_SET_MULTI, VAR_RESET or
// VAR_RESET_ALL. Name is a list of names that the converter joins with dots (var_name is a dotted name).
type VariableSetStmt struct { Kind string, Name []Str, Args []VarArg, JumbleArgs bool, IsLocal bool }
type VariableShowStmt struct { Name []Str }
type ConstraintsSetStmt struct { Constraints []RangeVar, Deferred bool }
type CheckPointStmt struct { }
type DiscardStmt struct { Target string }
type TransactionStmt struct { Kind string, Options []DefElem, SavepointName *Ident, Gid *SconstStr, Chain bool }
type CopyStmt struct {
    Relation *RangeVar, Query *DmlStmt, Attlist []Ident, IsFrom bool, IsProgram bool, Filename *SconstStr,
    Options []DefElem, WhereClause *Expr
}
type ExplainableStmt = DmlStmt | DeclareCursorStmt | CreateTableAsStmt | RefreshMatViewStmt | ExecuteStmt
type ExplainStmt struct { Query ExplainableStmt, Options []DefElem }
type VacuumRelation struct { Relation RangeVar, VaCols []Ident }
type VacuumStmt struct { Options []DefElem, Rels []VacuumRelation, IsVacuumcmd bool }
type ClusterStmt struct { Relation *RangeVar, Indexname *Ident, Params []DefElem }
type ReindexStmt struct { Kind string, Relation *RangeVar, Name *Ident, Params []DefElem }
type LockStmt struct { Relations []RangeVar, Mode int, Nowait bool }
type PrepareStmt struct { Name Ident, Argtypes []TypeName, Query DmlStmt }
type ExecuteStmt struct { Name Ident, Params []Expr }
type DeallocateStmt struct { Name *Ident, Isall bool }
type DeclareCursorStmt struct { Portalname Ident, Options int, Query SelectStmt }
// HowMany is the count of FETCH when it is not given in the statement (1, -1 for LAST, FETCH_ALL); Count
// is the count that the statement gives, which the converter folds into howMany.
type FetchStmt struct { Direction string, HowMany int, Count *SignedIconst, Portalname Ident, Ismove bool }
type ClosePortalStmt struct { Portalname *Ident }
type ListenStmt struct { Conditionname Ident }
type UnlistenStmt struct { Conditionname *Ident }
type NotifyStmt struct { Conditionname Ident, Payload *SconstStr }
type LoadStmt struct { Filename SconstStr }
type DoStmt struct { Args []DefElem }
type CallStmt struct { Funccall FuncCall }
type TruncateStmt struct { Relations []RangeVar, RestartSeqs bool, Behavior *DropBehavior }
type AlterSystemStmt struct { Setstmt VariableSetStmt }
type CursorOption struct { Bit int }
type BoolOrString = String | Ident | Sconst

// The statements of this group. TransactionStmtLegacy (BEGIN and END) is only valid at the top level of a
// script: gram.y does not accept it in the body of a BEGIN ATOMIC routine, which uses stmt.
def stmt_c: StmtC =
    TransactionStmt / TransactionStmtLegacy / ConstraintsSetStmt / VariableSetStmt / VariableResetStmt / VariableShowStmt
    / AlterSystemStmt / CheckPointStmt / DiscardStmt / CopyStmt / ExplainStmt / VacuumStmt / AnalyzeStmt / ClusterStmt
    / ReindexStmt / LockStmt / PrepareStmt / ExecuteStmt / DeallocateStmt / DeclareCursorStmt / FetchStmt
    / ClosePortalStmt / ListenStmt / UnlistenStmt / NotifyStmt / LoadStmt / DoStmt / CallStmt / TruncateStmt

// ---- SET, RESET and SHOW ----

// SET [LOCAL | SESSION] set_rest. The three forms are alternatives of the choice so that a variable named
// local or session still works (SET session TO x).
def VariableSetStmt: VariableSetStmt = [loc = false] SET (LOCAL [loc = true] r:set_rest / SESSION r:set_rest / r:set_rest)
    -> new VariableSetStmt{Kind: $r.Kind, Name: $r.Name, Args: $r.Args, JumbleArgs: $r.JumbleArgs, IsLocal: loc}
// set_rest: the node has no is_local; VariableSetStmt sets it.
def set_rest: VariableSetStmt = set_transaction / set_rest_more
def set_transaction: VariableSetStmt =
    (TRANSACTION [nm = "TRANSACTION"] / SESSION CHARACTERISTICS AS TRANSACTION [nm = "SESSION CHARACTERISTICS"])
    l:transaction_mode_list
    -> new VariableSetStmt{Kind: "VAR_SET_MULTI", Name: list(new String{Sval: nm}), Args: $l, JumbleArgs: true}
// The generic form comes first: SET names TO x and SET time TO x are variables, not NAMES and TIME ZONE.
def set_rest_more: VariableSetStmt = generic_set / set_from_current / set_time_zone / set_special
def generic_set: VariableSetStmt = [k = "VAR_SET_VALUE"] n:var_name (TO / EQ) (l:var_list / DEFAULT [k = "VAR_SET_DEFAULT"])
    -> new VariableSetStmt{Kind: k, Name: $n, Args: concat($l)}
def set_from_current: VariableSetStmt = n:var_name FROM CURRENT -> new VariableSetStmt{Kind: "VAR_SET_CURRENT", Name: $n}
def set_time_zone: VariableSetStmt = [k = "VAR_SET_VALUE"] TIME ZONE ((DEFAULT / LOCAL) [k = "VAR_SET_DEFAULT"] / z:zone_value{1})
    -> new VariableSetStmt{Kind: k, Name: list(new String{Sval: "timezone"}), Args: concat($z), JumbleArgs: true}
// SET CATALOG 'x' is an error in gram.y ("current database cannot be changed") and is not accepted here.
def set_special: VariableSetStmt = [k = "VAR_SET_VALUE"] [j = false]
    ( SCHEMA [nm = "search_path"] a:sconst_expr{1}
    / NAMES [nm = "client_encoding"] (a:sconst_expr{1} / DEFAULT [k = "VAR_SET_DEFAULT"] / _ [k = "VAR_SET_DEFAULT"])
    / ROLE [nm = "role"] a:nrw_const{1}
    / SESSION AUTHORIZATION [nm = "session_authorization"] (a:nrw_const{1} / DEFAULT [k = "VAR_SET_DEFAULT"])
    / XML OPTION [nm = "xmloption"] [j = true] a:xmloption_const{1}
    / TRANSACTION SNAPSHOT [nm = "TRANSACTION SNAPSHOT"] [k = "VAR_SET_MULTI"] a:sconst_expr{1} )
    -> new VariableSetStmt{Kind: k, Name: list(new String{Sval: nm}), Args: concat($a), JumbleArgs: j}
def nrw_const: A_Const = v:NonReservedWord_or_Sconst -> new A_Const{Val: $v}
def xmloption_const: A_Const = (DOCUMENT [d = "DOCUMENT"] / CONTENT [d = "CONTENT"]) -> new A_Const{Val: new String{Sval: d}}

def var_name: []Str = first:ColId rest:(-DOT x:ColId)* -> concat(list($first), map($rest, (r) => $r.x))
def var_list: []VarArg = first:var_value rest:(-COMMA x:var_value)* -> concat(list($first), map($rest, (r) => $r.x))
def var_value: A_Const = v:(opt_boolean_or_string / NumericOnly) -> new A_Const{Val: $v}
// TRUE, FALSE and ON are keywords of their own; the other values (OFF too) are names or strings.
def opt_boolean_or_string: BoolOrString = bool_word / NonReservedWord_or_Sconst
def bool_word: String = (TRUE [b = "true"] / FALSE [b = "false"] / ON [b = "on"]) -> new String{Sval: b}

// The value of SET TIME ZONE: a string, a name that is not a keyword, an interval limited to HOUR and MINUTE
// (the check of gram.y), or a number.
def zone_value: VarArg = sconst_expr / zone_ident / zone_interval / zone_number
def zone_ident: A_Const = v:IDENT -> new A_Const{Val: $v}
def zone_number: A_Const = v:NumericOnly -> new A_Const{Val: $v}
def zone_interval: TypeCast = zone_interval_hm / interval_prec_const
def zone_interval_hm: TypeCast = INTERVAL v:Sconst m:interval_hm?
    -> new TypeCast{Arg: new A_Const{Val: $v}, TypeName: new TypeName{
        Names: list(new String{Sval: "pg_catalog"}, new String{Sval: "interval"}), Typmods: concat($m), Typemod: -1}}
def interval_hm: []Expr = (HOUR [m = 1024] (TO MINUTE [m = 3072])? / MINUTE [m = 2048])
    -> list(new A_Const{Val: new Integer{Ival: m}})

def VariableResetStmt: VariableSetStmt = RESET r:(reset_special / generic_reset) -> $r
def reset_special: VariableSetStmt = n:special_name -> new VariableSetStmt{Kind: "VAR_RESET", Name: $n}
def generic_reset: VariableSetStmt = [k = "VAR_RESET"] (ALL [k = "VAR_RESET_ALL"] / n:var_name)
    -> new VariableSetStmt{Kind: k, Name: concat($n)}
def special_name: []Str =
    (TIME ZONE [nm = "timezone"] / TRANSACTION ISOLATION LEVEL [nm = "transaction_isolation"] / SESSION AUTHORIZATION [nm = "session_authorization"])
    -> list(new String{Sval: nm})
def VariableShowStmt: VariableShowStmt = SHOW n:(special_name / show_all / var_name) -> new VariableShowStmt{Name: $n}
def show_all: []Str = ALL -> list(new String{Sval: "all"})

// SET and RESET in the definition of a function or a role: SET without LOCAL
def SetResetClause: VariableSetStmt = set_clause_set / VariableResetStmt
def set_clause_set: VariableSetStmt = SET r:set_rest -> $r
def FunctionSetResetClause: VariableSetStmt = function_set_clause / VariableResetStmt
def function_set_clause: VariableSetStmt = SET r:set_rest_more -> $r

def ConstraintsSetStmt: ConstraintsSetStmt = [d = false] SET CONSTRAINTS (ALL / l:qualified_name_list) (DEFERRED [d = true] / IMMEDIATE)
    -> new ConstraintsSetStmt{Constraints: concat($l), Deferred: d}
def AlterSystemStmt: AlterSystemStmt = ALTER SYSTEM (SET s:generic_set / RESET s:generic_reset) -> new AlterSystemStmt{Setstmt: $s}
def CheckPointStmt: CheckPointStmt = CHECKPOINT -> new CheckPointStmt{}
def DiscardStmt: DiscardStmt = DISCARD
    (ALL [t = "DISCARD_ALL"] / (TEMP / TEMPORARY) [t = "DISCARD_TEMP"] / PLANS [t = "DISCARD_PLANS"] / SEQUENCES [t = "DISCARD_SEQUENCES"])
    -> new DiscardStmt{Target: t}

// ---- Transactions ----

// The statements that are not in a BEGIN ATOMIC body are TransactionStmtLegacy: BEGIN and END.
def TransactionStmt: TransactionStmt = [legacy = false] x:(txn_prepared / txn_rollback_to / txn_end / txn_savepoint / txn_start) -> $x
def TransactionStmtLegacy: TransactionStmt = [legacy = true] x:(txn_begin / txn_end) -> $x
def txn_prepared: TransactionStmt =
    (PREPARE TRANSACTION [k = "TRANS_STMT_PREPARE"] / COMMIT PREPARED [k = "TRANS_STMT_COMMIT_PREPARED"] / ROLLBACK PREPARED [k = "TRANS_STMT_ROLLBACK_PREPARED"])
    g:SconstStr -> new TransactionStmt{Kind: k, Gid: $g}
def txn_rollback_to: TransactionStmt = ROLLBACK (WORK / TRANSACTION)? TO (SAVEPOINT c:ColId / c:ColId)
    -> new TransactionStmt{Kind: "TRANS_STMT_ROLLBACK_TO", SavepointName: $c}
def txn_end: TransactionStmt = [ch = false]
    ( [!legacy] (ABORT [k = "TRANS_STMT_ROLLBACK"] / COMMIT [k = "TRANS_STMT_COMMIT"] / ROLLBACK [k = "TRANS_STMT_ROLLBACK"])
    / [legacy] END [k = "TRANS_STMT_COMMIT"] )
    (WORK / TRANSACTION)? (AND (CHAIN [ch = true] / NO CHAIN))?
    -> new TransactionStmt{Kind: k, Chain: ch}
def txn_savepoint: TransactionStmt =
    ( SAVEPOINT [k = "TRANS_STMT_SAVEPOINT"] c:ColId / RELEASE [k = "TRANS_STMT_RELEASE"] (SAVEPOINT c:ColId / c:ColId) )
    -> new TransactionStmt{Kind: k, SavepointName: $c}
def txn_start: TransactionStmt = START TRANSACTION l:transaction_mode_list? -> new TransactionStmt{Kind: "TRANS_STMT_START", Options: concat($l)}
def txn_begin: TransactionStmt = BEGIN (WORK / TRANSACTION)? l:transaction_mode_list?
    -> new TransactionStmt{Kind: "TRANS_STMT_BEGIN", Options: concat($l)}
// Modes are separated by commas, or by nothing.
def transaction_mode_list: []DefElem = first:transaction_mode_item rest:(COMMA? x:transaction_mode_item)*
    -> concat(list($first), map($rest, (r) => $r.x))
def transaction_mode_item: DefElem = mode_isolation / mode_flag
def mode_isolation: DefElem = ISOLATION LEVEL
    (READ UNCOMMITTED [v = "read uncommitted"] / READ COMMITTED [v = "read committed"] / REPEATABLE READ [v = "repeatable read"] / SERIALIZABLE [v = "serializable"])
    -> new DefElem{Defname: new String{Sval: "transaction_isolation"}, Arg: new A_Const{Val: new String{Sval: v}}}
def mode_flag: DefElem =
    (READ ONLY [n = "transaction_read_only"] [i = 1] / READ WRITE [n = "transaction_read_only"] [i = 0]
    / DEFERRABLE [n = "transaction_deferrable"] [i = 1] / NOT DEFERRABLE [n = "transaction_deferrable"] [i = 0])
    -> new DefElem{Defname: new String{Sval: n}, Arg: new A_Const{Val: new Integer{Ival: i}}}
// ==== XML and JSON: expressions with special syntax and the tables XMLTABLE and JSON_TABLE ====
//
// The nodes are those of the raw tree (primnodes.h, parsenodes.h): XmlExpr, XmlSerialize, the Json*
// constructors and functions, RangeTableFunc and JsonTable. The helper nonterminals of gram.y that only
// choose an enumerator (json_wrapper_behavior, json_quotes_clause_opt, ...) return a String node that holds
// its name, and the null and key uniqueness clauses return a Boolean: a rule cannot return a bare string or
// boolean, and a variable set by a rule is not visible to the rule that called it.

type XmlExpr struct { Op string, Name *Ident, NamedArgs []ResTarget, Args []Expr, Xmloption string }
type XmlSerialize struct { Xmloption string, Expr Expr, TypeName TypeName, Indent bool }
type JsonFormat struct { FormatType string, Encoding string }
type JsonReturning struct { Format JsonFormat }
type JsonOutput struct { TypeName TypeName, Returning JsonReturning }
type JsonValueExpr struct { RawExpr Expr, Format JsonFormat }
type JsonKeyValue struct { Key Expr, Value JsonValueExpr }
type JsonArgument struct { Val JsonValueExpr, Name Ident }
type JsonBehavior struct { Btype string, Expr *Expr }
type JsonObjectConstructor struct { Exprs []JsonKeyValue, Output *JsonOutput, AbsentOnNull bool, Unique bool }
type JsonArrayConstructor struct { Exprs []JsonValueExpr, Output *JsonOutput, AbsentOnNull bool }
type JsonArrayQueryConstructor struct { Query SelectStmt, Output *JsonOutput, Format JsonFormat, AbsentOnNull bool }
type JsonParseExpr struct { Expr JsonValueExpr, Output *JsonOutput, UniqueKeys bool }
type JsonScalarExpr struct { Expr Expr, Output *JsonOutput }
type JsonSerializeExpr struct { Expr JsonValueExpr, Output *JsonOutput }
type JsonFuncExpr struct {
    Op string, ContextItem JsonValueExpr, Pathspec Expr, Passing []JsonArgument, Output *JsonOutput,
    OnEmpty *JsonBehavior, OnError *JsonBehavior, Wrapper string, Quotes string
}
type JsonAggConstructor struct { Output *JsonOutput, AggFilter *Expr, AggOrder []SortBy, Over *WindowDef }
type JsonObjectAgg struct { Constructor JsonAggConstructor, Arg JsonKeyValue, AbsentOnNull bool, Unique bool }
type JsonArrayAgg struct { Constructor JsonAggConstructor, Arg JsonValueExpr, AbsentOnNull bool }
type JsonIsPredicate struct { Expr Expr, Format JsonFormat, ItemType string, UniqueKeys bool }
// ON EMPTY and ON ERROR behaviors (json_behavior_clause_opt): not a node of the raw tree
type JsonBehaviors struct { OnEmpty *JsonBehavior, OnError *JsonBehavior }
type ExprD = XmlExpr | XmlSerialize | JsonObjectConstructor | JsonArrayConstructor | JsonArrayQueryConstructor |
    JsonParseExpr | JsonScalarExpr | JsonSerializeExpr | JsonFuncExpr | JsonObjectAgg | JsonArrayAgg | JsonIsPredicate

type RangeTableFuncCol struct {
    Colname Ident, TypeName *TypeName, ForOrdinality bool, IsNotNull bool, Colexpr *Expr, Coldefexpr *Expr
}
type RangeTableFunc struct {
    Lateral bool, Docexpr Expr, Rowexpr Expr, Namespaces []ResTarget, Columns []RangeTableFuncCol, Alias *Alias
}
type JsonTablePathSpec struct { String A_Const, Name *Ident }
type JsonTableColumn struct {
    Coltype string, Name *Ident, TypeName *TypeName, Pathspec *JsonTablePathSpec, Format *JsonFormat, Wrapper string,
    Quotes string, Columns []JsonTableColumn, OnEmpty *JsonBehavior, OnError *JsonBehavior
}
type JsonTable struct {
    Lateral bool, ContextItem JsonValueExpr, Pathspec JsonTablePathSpec, Passing []JsonArgument,
    Columns []JsonTableColumn, OnError *JsonBehavior, Alias *Alias
}
type TableRefD = RangeTableFunc | JsonTable
// The options of an XMLTABLE column, added up: the options may come in any order but each at most once.
// Nn is 1 for NOT NULL and 10 for NULL (the sum tells whether both were given). Nil is never set.
type XmlColOpts struct { Def []Expr, Path []Expr, Nn int, Nil *Expr }

// ---- The functions of func_expr_common_subexpr ----
//
// The windowless variable is reset for the arguments: a window function is allowed there.
def xmljson_expr: Expr = [windowless = false] x:(xmlconcat_expr / xmlelement_expr / xmlexists_expr / xmlforest_expr
    / xmlparse_expr / xmlpi_expr / xmlroot_expr / xmlserialize_expr / json_object_expr / json_array_expr
    / json_parse_expr / json_scalar_expr / json_serialize_expr / json_query_expr / json_exists_expr
    / json_value_func_expr) -> $x

// ---- XML ----

def xmlconcat_expr: XmlExpr = XMLCONCAT -LP l:expr_list -RP -> new XmlExpr{Op: "IS_XMLCONCAT", Args: $l}
def xmlelement_expr: XmlExpr = XMLELEMENT -LP NAME n:ColLabel
    (-COMMA (a:xml_attributes -COMMA l:expr_list / a:xml_attributes / l:expr_list))? -RP
    -> new XmlExpr{Op: "IS_XMLELEMENT", Name: $n, NamedArgs: concat($a), Args: concat($l)}
def xmlexists_expr: FuncCall = XMLEXISTS -LP a:c_expr b:xmlexists_argument -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "xmlexists"}), Args: list($a, $b), Funcformat: "COERCE_SQL_SYNTAX"}
def xmlforest_expr: XmlExpr = XMLFOREST -LP l:xml_attribute_list -RP -> new XmlExpr{Op: "IS_XMLFOREST", NamedArgs: $l}
def xmlparse_expr: XmlExpr = XMLPARSE -LP d:document_or_content e:a_expr [ws = false]
    (PRESERVE WHITESPACE [ws = true] / STRIP WHITESPACE)? -RP
    -> new XmlExpr{Op: "IS_XMLPARSE", Args: list($e, new A_Const{Val: new Boolean{Boolval: ws}}), Xmloption: $d.Sval}
def xmlpi_expr: XmlExpr = XMLPI -LP NAME n:ColLabel a:xmlpi_content? -RP
    -> new XmlExpr{Op: "IS_XMLPI", Name: $n, Args: concat($a)}
def xmlpi_content: []Expr = -COMMA e:a_expr -> list($e)
// VERSION NO VALUE is a null constant; STANDALONE becomes an integer constant (YES 0, NO 1, NO VALUE 2, omitted 3)
def xmlroot_expr: XmlExpr = XMLROOT -LP e:a_expr -COMMA v:xml_root_version [sa = 3]
    (-COMMA STANDALONE (YES [sa = 0] / NO [sa = 1] (VALUE [sa = 2])?))? -RP
    -> new XmlExpr{Op: "IS_XMLROOT", Args: list($e, $v, new A_Const{Val: new Integer{Ival: sa}})}
def xml_root_version: Expr = xml_version_none / xml_version_expr
def xml_version_none: A_Const = VERSION NO VALUE -> new A_Const{Isnull: true}
def xml_version_expr: Expr = VERSION e:a_expr -> $e
def xmlserialize_expr: XmlSerialize = XMLSERIALIZE -LP d:document_or_content e:a_expr AS t:SimpleTypename [ind = false]
    (INDENT [ind = true] / NO INDENT)? -RP [len($t.ArrayBounds) == 0]
    -> new XmlSerialize{Xmloption: $d.Sval, Expr: $e, TypeName: $t, Indent: ind}

def xml_attributes: []ResTarget = XMLATTRIBUTES -LP l:xml_attribute_list -RP -> $l
def xml_attribute_list: []ResTarget = first:xml_attribute_el rest:(-COMMA x:xml_attribute_el)*
    -> concat(list($first), map($rest, (r) => $r.x))
def xml_attribute_el: ResTarget = e:a_expr (-AS n:ColLabel)? -> new ResTarget{Name: $n, Val: $e}
// document_or_content: the name of the XmlOptionType enumerator
def document_or_content: String = [x = "XMLOPTION_DOCUMENT"] (DOCUMENT / CONTENT [x = "XMLOPTION_CONTENT"]) -> new String{Sval: x}
def xmlexists_argument: Expr = PASSING -xml_passing_mech? c:c_expr -xml_passing_mech? -> $c
def xml_passing_mech = BY (REF / VALUE)

// ---- XMLTABLE ----

def xmltable: RangeTableFunc = lat:LATERAL? XMLTABLE -LP (XMLNAMESPACES -LP ns:xml_namespace_list -RP -COMMA)?
    r:c_expr d:xmlexists_argument COLUMNS cols:xmltable_column_list -RP a:alias_clause?
    -> new RangeTableFunc{Lateral: len($lat) > 0, Docexpr: $d, Rowexpr: $r, Namespaces: concat($ns), Columns: $cols, Alias: $a}
def xml_namespace_list: []ResTarget = first:xml_namespace_el rest:(-COMMA x:xml_namespace_el)*
    -> concat(list($first), map($rest, (r) => $r.x))
def xml_namespace_el: ResTarget = (DEFAULT e:b_expr / e:b_expr AS n:ColLabel) -> new ResTarget{Name: $n, Val: $e}
def xmltable_column_list: []RangeTableFuncCol = first:xmltable_column_el rest:(-COMMA x:xmltable_column_el)*
    -> concat(list($first), map($rest, (r) => $r.x))
def xmltable_column_el: RangeTableFuncCol = xml_col_ordinality / xml_col_typed
def xml_col_ordinality: RangeTableFuncCol = n:ColId FOR ORDINALITY -> new RangeTableFuncCol{Colname: $n, ForOrdinality: true}
def xml_col_typed: RangeTableFuncCol = n:ColId t:Typename o:xml_col_opts
    [len($o.Def) <= 1 && len($o.Path) <= 1 && ($o.Nn == 0 || $o.Nn == 1 || $o.Nn == 10)]
    -> new RangeTableFuncCol{Colname: $n, TypeName: $t, IsNotNull: $o.Nn == 1,
        Colexpr: foldl($o.Nil, $o.Path, (a, i) => $i), Coldefexpr: foldl($o.Nil, $o.Def, (a, i) => $i)}
def xml_col_opts: XmlColOpts = xs:xml_col_opt*
    -> foldl(new XmlColOpts{Nn: 0}, $xs, (a, i) => new XmlColOpts{Def: concat($a.Def, $i.Def), Path: concat($a.Path, $i.Path), Nn: $a.Nn + $i.Nn})
// An option name is an IDENT: only the quoted names "default" and "path" are accepted (anything else is an error)
def xml_col_opt: XmlColOpts = [nn = 0]
    ( (DEFAULT / "\"default\"" s) d:b_expr_list1 / (PATH / "\"path\"" s) p:b_expr_list1 / NOT NULL [nn = 1] / NULL [nn = 10] )
    -> new XmlColOpts{Def: concat($d), Path: concat($p), Nn: nn}
def b_expr_list1: []Expr = e:b_expr -> list($e)

// ---- JSON: the pieces ----

def json_value_expr: JsonValueExpr = e:a_expr f:json_format_opt -> new JsonValueExpr{RawExpr: $e, Format: $f}
def json_value_expr_list: []JsonValueExpr = first:json_value_expr rest:(-COMMA x:json_value_expr)*
    -> concat(list($first), map($rest, (r) => $r.x))
// FORMAT JSON [ENCODING name]: the encoding is utf8, utf16 or utf32 in any case, quoted or not
def json_format: JsonFormat = FORMAT JSON e:json_encoding_opt -> new JsonFormat{FormatType: "JS_FORMAT_JSON", Encoding: $e.Sval}
def json_encoding_opt: String = json_encoding / json_encoding_none
def json_encoding_none: String = _ -> new String{Sval: "JS_ENC_DEFAULT"}
def json_encoding: String = ENCODING w:json_enc_word
    ([$w.V == "utf8"] [enc = "JS_ENC_UTF8"] / [$w.V == "utf16"] [enc = "JS_ENC_UTF16"] / [$w.V == "utf32"] [enc = "JS_ENC_UTF32"])
    -> new String{Sval: enc}
def json_enc_word: LcWord = (-"\"" w:lcword -"\"" / w:lcword) s -> $w
def json_format_opt: JsonFormat = json_format / json_format_none
def json_format_none: JsonFormat = _ -> new JsonFormat{}
def json_returning: JsonOutput = RETURNING t:Typename f:json_format_opt
    -> new JsonOutput{TypeName: $t, Returning: new JsonReturning{Format: $f}}
// NULL ON NULL and ABSENT ON NULL: the default is false for an object and true for an array
def json_absent_obj: Boolean = [a = false] (NULL ON NULL / ABSENT ON NULL [a = true])? -> new Boolean{Boolval: a}
def json_absent_arr: Boolean = [a = true] (NULL ON NULL [a = false] / ABSENT ON NULL)? -> new Boolean{Boolval: a}
// WITH UNIQUE [KEYS] is true; WITHOUT UNIQUE [KEYS] and the empty clause are false
def json_unique: Boolean = [u = false] ((WITH UNIQUE [u = true] / WITHOUT UNIQUE) KEYS?)? -> new Boolean{Boolval: u}
def json_kv: JsonKeyValue = (k:c_expr VALUE / k:a_expr COLON) v:json_value_expr -> new JsonKeyValue{Key: $k, Value: $v}
def json_kv_list: []JsonKeyValue = first:json_kv rest:(-COMMA x:json_kv)* -> concat(list($first), map($rest, (r) => $r.x))
def json_passing: []JsonArgument = PASSING first:json_argument rest:(-COMMA x:json_argument)*
    -> concat(list($first), map($rest, (r) => $r.x))
def json_argument: JsonArgument = v:json_value_expr AS n:ColLabel -> new JsonArgument{Val: $v, Name: $n}
// the wrapper: WITH [CONDITIONAL | UNCONDITIONAL] [ARRAY] WRAPPER is unconditional by default
def json_wrapper: String = [w = "JSW_UNSPEC"]
    (WITHOUT ARRAY? WRAPPER [w = "JSW_NONE"] / WITH [w = "JSW_UNCONDITIONAL"] (CONDITIONAL [w = "JSW_CONDITIONAL"] / UNCONDITIONAL)? ARRAY? WRAPPER)?
    -> new String{Sval: w}
def json_quotes: String = [q = "JS_QUOTES_UNSPEC"]
    ((KEEP [q = "JS_QUOTES_KEEP"] / OMIT [q = "JS_QUOTES_OMIT"]) QUOTES (ON SCALAR STRING)?)? -> new String{Sval: q}
def json_behavior: JsonBehavior = [b = ""]
    ( DEFAULT e:a_expr [b = "JSON_BEHAVIOR_DEFAULT"] / ERROR [b = "JSON_BEHAVIOR_ERROR"] / NULL [b = "JSON_BEHAVIOR_NULL"]
    / TRUE [b = "JSON_BEHAVIOR_TRUE"] / FALSE [b = "JSON_BEHAVIOR_FALSE"] / UNKNOWN [b = "JSON_BEHAVIOR_UNKNOWN"]
    / EMPTY ARRAY [b = "JSON_BEHAVIOR_EMPTY_ARRAY"] / EMPTY OBJECT [b = "JSON_BEHAVIOR_EMPTY_OBJECT"]
    / EMPTY [b = "JSON_BEHAVIOR_EMPTY_ARRAY"] )
    -> new JsonBehavior{Btype: b, Expr: $e}
// json_behavior_clause_opt: [behavior ON EMPTY] [behavior ON ERROR]
def json_behaviors: JsonBehaviors = (e:json_behavior ON EMPTY (r:json_behavior ON ERROR)? / r:json_behavior ON ERROR)?
    -> new JsonBehaviors{OnEmpty: $e, OnError: $r}

// ---- JSON: constructors and query functions ----

def json_object_expr: Expr = json_object_kv / json_object_empty / json_object_legacy
def json_object_kv: JsonObjectConstructor = JSON_OBJECT -LP l:json_kv_list a:json_absent_obj u:json_unique o:json_returning? -RP
    -> new JsonObjectConstructor{Exprs: $l, AbsentOnNull: $a.Boolval, Unique: $u.Boolval, Output: $o}
def json_object_empty: JsonObjectConstructor = JSON_OBJECT -LP o:json_returning? -RP -> new JsonObjectConstructor{Output: $o}
// the legacy json_object(text[]) and json_object(keys, values): a function call
def json_object_legacy: FuncCall = JSON_OBJECT -LP l:func_arg_list -RP
    -> new FuncCall{Funcname: list(new String{Sval: "pg_catalog"}, new String{Sval: "json_object"}), Args: $l, Funcformat: "COERCE_EXPLICIT_CALL"}
def json_array_expr: Expr = json_array_values / json_array_query / json_array_empty
def json_array_values: JsonArrayConstructor = JSON_ARRAY -LP l:json_value_expr_list a:json_absent_arr o:json_returning? -RP
    -> new JsonArrayConstructor{Exprs: $l, Output: $o, AbsentOnNull: $a.Boolval}
def json_array_query: JsonArrayQueryConstructor = JSON_ARRAY -LP q:select_no_parens f:json_format_opt o:json_returning? -RP
    -> new JsonArrayQueryConstructor{Query: $q, Output: $o, Format: $f, AbsentOnNull: true}
def json_array_empty: JsonArrayConstructor = JSON_ARRAY -LP o:json_returning? -RP
    -> new JsonArrayConstructor{Output: $o, AbsentOnNull: true}
def json_parse_expr: JsonParseExpr = JSON -LP e:json_value_expr u:json_unique -RP
    -> new JsonParseExpr{Expr: $e, UniqueKeys: $u.Boolval}
def json_scalar_expr: JsonScalarExpr = JSON_SCALAR -LP e:a_expr -RP -> new JsonScalarExpr{Expr: $e}
def json_serialize_expr: JsonSerializeExpr = JSON_SERIALIZE -LP e:json_value_expr o:json_returning? -RP
    -> new JsonSerializeExpr{Expr: $e, Output: $o}
def json_query_expr: JsonFuncExpr = JSON_QUERY -LP c:json_value_expr -COMMA p:a_expr ps:json_passing? o:json_returning?
    w:json_wrapper q:json_quotes b:json_behaviors -RP
    -> new JsonFuncExpr{Op: "JSON_QUERY_OP", ContextItem: $c, Pathspec: $p, Passing: concat($ps), Output: $o, Wrapper: $w.Sval,
        Quotes: $q.Sval, OnEmpty: $b.OnEmpty, OnError: $b.OnError}
def json_exists_expr: JsonFuncExpr = JSON_EXISTS -LP c:json_value_expr -COMMA p:a_expr ps:json_passing? (e:json_behavior ON ERROR)? -RP
    -> new JsonFuncExpr{Op: "JSON_EXISTS_OP", ContextItem: $c, Pathspec: $p, Passing: concat($ps), OnError: $e}
def json_value_func_expr: JsonFuncExpr = JSON_VALUE -LP c:json_value_expr -COMMA p:a_expr ps:json_passing? o:json_returning?
    b:json_behaviors -RP
    -> new JsonFuncExpr{Op: "JSON_VALUE_OP", ContextItem: $c, Pathspec: $p, Passing: concat($ps), Output: $o,
        OnEmpty: $b.OnEmpty, OnError: $b.OnError}

// ---- JSON_OBJECTAGG and JSON_ARRAYAGG, with FILTER and OVER (not in a windowless call) ----
//
// The arguments are parsed with windowless false (wl keeps the caller's value for FILTER and OVER).
def json_agg_expr: Expr = json_objectagg_expr / json_arrayagg_expr
def json_objectagg_expr: JsonObjectAgg = [wl = windowless] JSON_OBJECTAGG -LP [windowless = false]
    kv:json_kv a:json_absent_obj u:json_unique o:json_returning? -RP [windowless = wl] fc:filter_ok? ov:over_ok?
    -> new JsonObjectAgg{Constructor: new JsonAggConstructor{Output: $o, AggFilter: $fc, Over: $ov}, Arg: $kv,
        AbsentOnNull: $a.Boolval, Unique: $u.Boolval}
def json_arrayagg_expr: JsonArrayAgg = [wl = windowless] JSON_ARRAYAGG -LP [windowless = false]
    v:json_value_expr (ORDER BY ob:sortby_list)? a:json_absent_arr o:json_returning? -RP [windowless = wl] fc:filter_ok? ov:over_ok?
    -> new JsonArrayAgg{Constructor: new JsonAggConstructor{Output: $o, AggFilter: $fc, AggOrder: concat($ob), Over: $ov}, Arg: $v,
        AbsentOnNull: $a.Boolval}

// ---- IS JSON (the tail after IS [NOT], used by the a_expr operators): the type and the uniqueness ----
def json_is_tail: JsonIsPredicate = [it = "JS_TYPE_ANY"]
    JSON (VALUE / ARRAY [it = "JS_TYPE_ARRAY"] / OBJECT [it = "JS_TYPE_OBJECT"] / SCALAR [it = "JS_TYPE_SCALAR"])? u:json_unique
    -> new JsonIsPredicate{Format: new JsonFormat{}, ItemType: it, UniqueKeys: $u.Boolval}

// ---- JSON_TABLE ----

def json_table: JsonTable = lat:LATERAL? JSON_TABLE -LP c:json_value_expr -COMMA p:json_path (-AS n:name)? ps:json_passing?
    COLUMNS -LP cols:json_table_column_list -RP (e:json_behavior ON ERROR)? -RP a:alias_clause?
    -> new JsonTable{Lateral: len($lat) > 0, ContextItem: $c, Pathspec: new JsonTablePathSpec{String: $p, Name: $n},
        Passing: concat($ps), Columns: $cols, OnError: $e, Alias: $a}
// the path of JSON_TABLE must be a string constant (the reference checks it in the action), possibly in parentheses
def json_path: A_Const = json_path_plain / json_path_paren
def json_path_plain: A_Const = v:Sconst -> new A_Const{Val: $v}
def json_path_paren: A_Const = -LP x:json_path -RP -> $x
def json_table_column_list: []JsonTableColumn = first:json_table_column rest:(-COMMA x:json_table_column)*
    -> concat(list($first), map($rest, (r) => $r.x))
def json_table_column: JsonTableColumn = jt_ordinality / jt_nested / jt_exists / jt_regular
def jt_ordinality: JsonTableColumn = n:ColId FOR ORDINALITY -> new JsonTableColumn{Coltype: "JTC_FOR_ORDINALITY", Name: $n}
def jt_nested: JsonTableColumn = NESTED PATH? p:Sconst (-AS n:name)? COLUMNS -LP cols:json_table_column_list -RP
    -> new JsonTableColumn{Coltype: "JTC_NESTED", Pathspec: new JsonTablePathSpec{String: new A_Const{Val: $p}, Name: $n}, Columns: $cols}
def jt_exists: JsonTableColumn = n:ColId t:Typename EXISTS p:json_col_path? (e:json_behavior ON ERROR)?
    -> new JsonTableColumn{Coltype: "JTC_EXISTS", Name: $n, TypeName: $t, Format: new JsonFormat{}, Wrapper: "JSW_NONE",
        Quotes: "JS_QUOTES_UNSPEC", Pathspec: $p, OnError: $e}
// a regular column, or one with FORMAT JSON (JTC_FORMATTED)
def jt_regular: JsonTableColumn = [ct = "JTC_REGULAR"] n:ColId t:Typename (&FORMAT [ct = "JTC_FORMATTED"])? f:json_format_opt
    p:json_col_path? w:json_wrapper q:json_quotes b:json_behaviors
    -> new JsonTableColumn{Coltype: ct, Name: $n, TypeName: $t, Format: $f, Pathspec: $p, Wrapper: $w.Sval, Quotes: $q.Sval,
        OnEmpty: $b.OnEmpty, OnError: $b.OnError}
def json_col_path: JsonTablePathSpec = PATH s:Sconst -> new JsonTablePathSpec{String: new A_Const{Val: $s}}

// xmltable and json_table with their alias, as the alternatives of table_ref
def xmljson_table: TableRefD = xmltable / json_table
// ==== Foreign data: FDW, SERVER, USER MAPPING, IMPORT FOREIGN SCHEMA ====

type CreateFdwStmt struct { Fdwname Ident, FuncOptions []DefElem, Options []DefElem }
type AlterFdwStmt struct { Fdwname Ident, FuncOptions []DefElem, Options []DefElem }
type CreateForeignServerStmt struct {
    Servername Ident, Servertype *Sconst, Version *Sconst, Fdwname Ident, IfNotExists bool, Options []DefElem
}
type AlterForeignServerStmt struct { Servername Ident, Version *Sconst, Options []DefElem, HasVersion bool }
type ImportForeignSchemaStmt struct {
    ServerName Ident, RemoteSchema Ident, LocalSchema Ident, ListType string, TableList []RangeVar, Options []DefElem
}
type CreateUserMappingStmt struct { User RoleSpec, Servername Ident, IfNotExists bool, Options []DefElem }
type AlterUserMappingStmt struct { User RoleSpec, Servername Ident, Options []DefElem }
type DropUserMappingStmt struct { User RoleSpec, Servername Ident, MissingOk bool }

// ---- Generic options (FDW, SERVER, USER MAPPING and the foreign table statements) ----

def create_generic_options: []DefElem = OPTIONS -LP l:generic_option_list -RP -> $l
def generic_option_list: []DefElem = first:generic_option_elem rest:(-COMMA x:generic_option_elem)*
    -> concat(list($first), map($rest, (r) => $r.x))
def alter_generic_options: []DefElem = OPTIONS -LP l:alter_generic_option_list -RP -> $l
def alter_generic_option_list: []DefElem = first:alter_generic_option_elem rest:(-COMMA x:alter_generic_option_elem)*
    -> concat(list($first), map($rest, (r) => $r.x))
// DROP name, SET name value, ADD name value, or name value. An option may be called set, add or drop.
def alter_generic_option_elem: DefElem = [a = "DEFELEM_UNSPEC"]
    ( DROP n:generic_option_name [a = "DEFELEM_DROP"]
    / SET [a = "DEFELEM_SET"] n:generic_option_name v:generic_option_arg
    / ADD [a = "DEFELEM_ADD"] n:generic_option_name v:generic_option_arg
    / n:generic_option_name v:generic_option_arg )
    -> new DefElem{Defname: $n, Arg: $v, Defaction: a}
def generic_option_elem: DefElem = n:generic_option_name v:generic_option_arg -> new DefElem{Defname: $n, Arg: $v}
def generic_option_name = ColLabel
// the spec only requires string literals
def generic_option_arg = Sconst

// ---- FOREIGN DATA WRAPPER ----

def CreateFdwStmt: CreateFdwStmt = CREATE FOREIGN DATA WRAPPER n:name f:fdw_option* o:create_generic_options?
    -> new CreateFdwStmt{Fdwname: $n, FuncOptions: $f, Options: concat($o)}
// without options after the function options this is the second form: only function options
def AlterFdwStmt: AlterFdwStmt = ALTER FOREIGN DATA WRAPPER n:name f:fdw_option* o:alter_generic_options? [len($f) + len($o) > 0]
    -> new AlterFdwStmt{Fdwname: $n, FuncOptions: $f, Options: concat($o)}
def fdw_option: DefElem = fdw_option_handler / fdw_option_no
def fdw_option_handler: DefElem = (HANDLER [n = "handler"] / VALIDATOR [n = "validator"]) h:handler_name
    -> new DefElem{Defname: new String{Sval: n}, Arg: new NodeList{Items: $h}}
def fdw_option_no: DefElem = NO (HANDLER [n = "handler"] / VALIDATOR [n = "validator"])
    -> new DefElem{Defname: new String{Sval: n}}

// ---- SERVER ----

// VERSION 'v' or VERSION NULL; the optional version is (VERSION (Sconst / NULL)) where it occurs
def CreateForeignServerStmt: CreateForeignServerStmt = CREATE SERVER [ine = false] (IF NOT EXISTS [ine = true])? n:name
    (TYPE t:Sconst)? (VERSION (v:Sconst / NULL))? FOREIGN DATA WRAPPER w:name o:create_generic_options?
    -> new CreateForeignServerStmt{Servername: $n, Servertype: $t, Version: $v, Fdwname: $w, IfNotExists: ine, Options: concat($o)}
def AlterForeignServerStmt: AlterForeignServerStmt = ALTER SERVER n:name [hv = false] (VERSION (v:Sconst / NULL) [hv = true])?
    o:alter_generic_options? [hv || len($o) > 0]
    -> new AlterForeignServerStmt{Servername: $n, Version: $v, Options: concat($o), HasVersion: hv}

// ---- IMPORT FOREIGN SCHEMA ----

def ImportForeignSchemaStmt: ImportForeignSchemaStmt = [lt = "FDW_IMPORT_SCHEMA_ALL"] IMPORT FOREIGN SCHEMA r:name
    ((LIMIT TO [lt = "FDW_IMPORT_SCHEMA_LIMIT_TO"] / EXCEPT [lt = "FDW_IMPORT_SCHEMA_EXCEPT"]) -LP l:relation_expr_list -RP)?
    FROM SERVER s:name INTO d:name o:create_generic_options?
    -> new ImportForeignSchemaStmt{ServerName: $s, RemoteSchema: $r, LocalSchema: $d, ListType: lt, TableList: concat($l), Options: concat($o)}

// ---- USER MAPPING ----

// auth_ident: a role, or USER (the current user)
def auth_ident: RoleSpec = RoleSpec / auth_user
def auth_user: RoleSpec = USER -> new RoleSpec{Roletype: "ROLESPEC_CURRENT_USER"}

def CreateUserMappingStmt: CreateUserMappingStmt = CREATE USER MAPPING [ine = false] (IF NOT EXISTS [ine = true])? FOR u:auth_ident SERVER s:name
    o:create_generic_options?
    -> new CreateUserMappingStmt{User: $u, Servername: $s, IfNotExists: ine, Options: concat($o)}
def DropUserMappingStmt: DropUserMappingStmt = DROP USER MAPPING i:(IF EXISTS)? FOR u:auth_ident SERVER s:name
    -> new DropUserMappingStmt{User: $u, Servername: $s, MissingOk: len($i) > 0}
def AlterUserMappingStmt: AlterUserMappingStmt = ALTER USER MAPPING FOR u:auth_ident SERVER s:name o:alter_generic_options
    -> new AlterUserMappingStmt{User: $u, Servername: $s, Options: $o}
// ==== Logical replication: PUBLICATION and SUBSCRIPTION ====

type PublicationTable struct { Relation RangeVar, WhereClause *Expr, Columns []Ident }
type PublicationObjSpec struct { Pubobjtype string, Name *Ident, Pubtable *PublicationTable }
type CreatePublicationStmt struct { Pubname Ident, Options []DefElem, Pubobjects []PublicationObjSpec, ForAllTables bool }
type AlterPublicationStmt struct {
    Pubname Ident, Options []DefElem, Pubobjects []PublicationObjSpec, ForAllTables bool, Action string
}
type CreateSubscriptionStmt struct { Subname Ident, Conninfo Sconst, Publication []Ident, Options []DefElem }
type AlterSubscriptionStmt struct {
    Kind string, Subname Ident, Conninfo *Sconst, Publication []Ident, Options []DefElem
}
type DropSubscriptionStmt struct { Subname Ident, MissingOk bool, Behavior *DropBehavior }

// ---- PUBLICATION ----

def CreatePublicationStmt: CreatePublicationStmt = [fat = false] CREATE PUBLICATION n:name
    (FOR (ALL TABLES [fat = true] / l:pub_obj_list))? o:opt_definition?
    -> new CreatePublicationStmt{Pubname: $n, Options: concat($o), Pubobjects: concat($l), ForAllTables: fat}
def AlterPublicationStmt: AlterPublicationStmt = [a = ""] ALTER PUBLICATION n:name
    ( SET d:definition / (ADD [a = "AP_AddObjects"] / DROP [a = "AP_DropObjects"] / SET [a = "AP_SetObjects"]) l:pub_obj_list )
    -> new AlterPublicationStmt{Pubname: $n, Options: concat($d), Pubobjects: concat($l), Action: a}

// The objects of a publication: TABLE t [(columns)] [WHERE (...)], TABLES IN SCHEMA s, or CURRENT_SCHEMA. A
// name without keyword continues the kind of the item before it (gram.y rewrites the list afterwards, in
// preprocess_pubobj_list); the variable pk holds the kind of the previous item ("" before the first). After a
// table, an item is a table (with columns and a filter, ONLY, * and a schema); after a schema it is a plain
// schema name or CURRENT_SCHEMA, and a column list, a filter or a qualified name is an error there.
def pub_obj_list: []PublicationObjSpec = [pk = ""] l:pub_obj_chain -> $l
def pub_obj_chain: []PublicationObjSpec = o:PublicationObjSpec [pk = $o.Pubobjtype] r:pub_obj_more?
    -> concat(list($o), $r)
def pub_obj_more: []PublicationObjSpec = -COMMA l:pub_obj_chain -> $l
def PublicationObjSpec: PublicationObjSpec = pub_table / pub_cur_schema / pub_schema / pub_cont_table / pub_cont_schema / pub_cont_cur_schema
def pub_table: PublicationObjSpec = TABLE r:relation_expr c:opt_column_list? w:pub_where?
    -> new PublicationObjSpec{Pubobjtype: "PUBLICATIONOBJ_TABLE", Pubtable: new PublicationTable{Relation: $r, Columns: concat($c), WhereClause: $w}}
def pub_where: Expr = WHERE -LP e:a_expr -RP -> $e
def pub_cur_schema: PublicationObjSpec = TABLES IN SCHEMA CURRENT_SCHEMA
    -> new PublicationObjSpec{Pubobjtype: "PUBLICATIONOBJ_TABLES_IN_CUR_SCHEMA"}
def pub_schema: PublicationObjSpec = TABLES IN SCHEMA n:ColId
    -> new PublicationObjSpec{Pubobjtype: "PUBLICATIONOBJ_TABLES_IN_SCHEMA", Name: $n}
def pub_cont_table: PublicationObjSpec = [pk == "PUBLICATIONOBJ_TABLE"] r:relation_expr c:opt_column_list? w:pub_where?
    -> new PublicationObjSpec{Pubobjtype: "PUBLICATIONOBJ_TABLE", Pubtable: new PublicationTable{Relation: $r, Columns: concat($c), WhereClause: $w}}
def pub_cont_schema: PublicationObjSpec = [pk != "" && pk != "PUBLICATIONOBJ_TABLE"] n:ColId
    -> new PublicationObjSpec{Pubobjtype: "PUBLICATIONOBJ_TABLES_IN_SCHEMA", Name: $n}
def pub_cont_cur_schema: PublicationObjSpec = [pk != "" && pk != "PUBLICATIONOBJ_TABLE"] CURRENT_SCHEMA
    -> new PublicationObjSpec{Pubobjtype: "PUBLICATIONOBJ_TABLES_IN_CUR_SCHEMA"}

// ---- SUBSCRIPTION ----

def CreateSubscriptionStmt: CreateSubscriptionStmt = CREATE SUBSCRIPTION n:name CONNECTION c:Sconst PUBLICATION p:name_list o:opt_definition?
    -> new CreateSubscriptionStmt{Subname: $n, Conninfo: $c, Publication: $p, Options: concat($o)}
def AlterSubscriptionStmt: AlterSubscriptionStmt = alter_sub_enabled / alter_sub_general
def alter_sub_general: AlterSubscriptionStmt = [k = ""] ALTER SUBSCRIPTION n:name
    ( SET (d:definition / PUBLICATION [k = "ALTER_SUBSCRIPTION_SET_PUBLICATION"] p:name_list o:opt_definition?)
    / CONNECTION c:Sconst [k = "ALTER_SUBSCRIPTION_CONNECTION"]
    / REFRESH PUBLICATION [k = "ALTER_SUBSCRIPTION_REFRESH"] o:opt_definition?
    / ADD PUBLICATION [k = "ALTER_SUBSCRIPTION_ADD_PUBLICATION"] p:name_list o:opt_definition?
    / DROP PUBLICATION [k = "ALTER_SUBSCRIPTION_DROP_PUBLICATION"] p:name_list o:opt_definition?
    / SKIP [k = "ALTER_SUBSCRIPTION_SKIP"] d:definition )
    -> new AlterSubscriptionStmt{Kind: k, Subname: $n, Conninfo: $c, Publication: concat($p), Options: concat($d, $o)}
def alter_sub_enabled: AlterSubscriptionStmt = ALTER SUBSCRIPTION n:name (ENABLE [e = true] / DISABLE [e = false])
    -> new AlterSubscriptionStmt{Kind: "ALTER_SUBSCRIPTION_ENABLED", Subname: $n,
        Options: list(new DefElem{Defname: new String{Sval: "enabled"}, Arg: new Boolean{Boolval: e}})}
def DropSubscriptionStmt: DropSubscriptionStmt = DROP SUBSCRIPTION i:(IF EXISTS)? n:name b:drop_behavior?
    -> new DropSubscriptionStmt{Subname: $n, MissingOk: len($i) > 0, Behavior: $b}
// ==== Triggers, event triggers, rules and policies ====

type CreateEventTrigStmt struct { Trigname Ident, Eventname Ident, Whenclause []DefElem, Funcname []Ident }
type AlterEventTrigStmt struct { Trigname Ident, Tgenabled string }
// A trigger's argument: a number, a string or a name; the converter turns the numbers into strings
type TrgArgNum struct { Val Num }
type TriggerFuncArg = TrgArgNum | Ident | Sconst
type TriggerTransition struct { Name Ident, IsNew bool, IsTable bool }
type CreateTrigStmt struct {
    Replace bool, Isconstraint bool, Trigname Ident, Relation RangeVar, Funcname []Ident, Args []TriggerFuncArg, Row bool,
    Timing int, Events int, Columns []Ident, WhenClause *Expr, TransitionRels []TriggerTransition, Deferrable bool,
    Initdeferred bool, Constrrel *RangeVar
}
type RuleActionStmt = SelectStmt | InsertStmt | UpdateStmt | DeleteStmt | NotifyStmt
type RuleStmt struct {
    Relation RangeVar, Rulename Ident, WhereClause *Expr, Event string, Instead bool, Actions []RuleActionStmt, Replace bool
}
type CreatePolicyStmt struct {
    PolicyName Ident, Table RangeVar, CmdName string, Permissive bool, Roles []RoleSpec, Qual *Expr, WithCheck *Expr
}
type AlterPolicyStmt struct { PolicyName Ident, Table RangeVar, Roles []RoleSpec, Qual *Expr, WithCheck *Expr }

// ---- CREATE TRIGGER ----

def CreateTrigStmt: CreateTrigStmt = trigger_regular / trigger_constraint
// The timing and the events are bit masks, as in the C code: ROW 1, BEFORE 2, INSERT 4, DELETE 8, UPDATE 16,
// TRUNCATE 32, INSTEAD 64 (AFTER is 0). Without FOR EACH, a trigger is a statement trigger.
def trigger_regular: CreateTrigStmt = [t = 0] [row = false]
    CREATE r:b2_or_replace? TRIGGER n:name (BEFORE [t = 2] / AFTER [t = 0] / INSTEAD OF [t = 64]) ev:trigger_events
    ON rel:qualified_name tr:trigger_referencing? (FOR EACH? (ROW [row = true] / STATEMENT [row = false]))? w:trigger_when?
    EXECUTE (FUNCTION / PROCEDURE) f:func_name -LP a:trigger_func_args? -RP
    -> new CreateTrigStmt{Replace: len($r) > 0, Trigname: $n, Relation: $rel, Funcname: $f, Args: concat($a), Row: row, Timing: t,
        Events: $ev.Events, Columns: $ev.Columns, WhenClause: $w, TransitionRels: concat($tr)}
// CREATE CONSTRAINT TRIGGER: AFTER, FOR EACH ROW, and the attributes of a constraint (OR REPLACE is an error)
def trigger_constraint: CreateTrigStmt =
    CREATE CONSTRAINT TRIGGER n:name AFTER ev:trigger_events ON rel:qualified_name (FROM cr:qualified_name)? cas:trigger_cas
    FOR EACH ROW w:trigger_when? EXECUTE (FUNCTION / PROCEDURE) f:func_name -LP a:trigger_func_args? -RP
    -> new CreateTrigStmt{Isconstraint: true, Trigname: $n, Relation: $rel, Funcname: $f, Args: concat($a), Row: true,
        Events: $ev.Events, Columns: $ev.Columns, WhenClause: $w, Deferrable: ($cas.Ival / 2) % 2 == 1 || ($cas.Ival / 8) % 2 == 1,
        Initdeferred: ($cas.Ival / 8) % 2 == 1, Constrrel: $cr}

// The events: INSERT, DELETE, UPDATE [OF columns] and TRUNCATE joined by OR, each at most once. Events is the
// mask, Sum the mask with a repeated event counted twice (so a repetition is Events != Sum).
type TrgEv struct { Events int, Sum int, Columns []Ident }
def trigger_events: TrgEv = e:trigger_events_list [$e.Events == $e.Sum] -> $e
def trigger_events_list: TrgEv = first:trigger_event rest:(-OR x:trigger_event)*
    -> foldl($first, $rest, (acc, i) => new TrgEv{Events: $acc.Events + $i.x.Events * (1 - ($acc.Events / $i.x.Events) % 2), Sum: $acc.Sum + $i.x.Sum, Columns: concat($acc.Columns, $i.x.Columns)})
def trigger_event: TrgEv = (INSERT [b = 4] / DELETE [b = 8] / UPDATE [b = 16] (OF c:column_list)? / TRUNCATE [b = 32])
    -> new TrgEv{Events: b, Sum: b, Columns: concat($c)}
def trigger_referencing: []TriggerTransition = REFERENCING l:trigger_transition+ -> $l
def trigger_transition: TriggerTransition = (NEW [n = true] / OLD [n = false]) (TABLE [t = true] / ROW [t = false]) AS? r:ColId
    -> new TriggerTransition{Name: $r, IsNew: n, IsTable: t}
def trigger_when: Expr = WHEN -LP e:a_expr -RP -> $e
def trigger_func_args: []TriggerFuncArg = first:trigger_func_arg rest:(-COMMA x:trigger_func_arg)*
    -> concat(list($first), map($rest, (r) => $r.x))
def trigger_func_arg: TriggerFuncArg = trigger_arg_num / Sconst / ColLabel
def trigger_arg_num: TrgArgNum = v:(Iconst / Fconst) -> new TrgArgNum{Val: $v}
// The attributes of a constraint trigger: a mask of NOT DEFERRABLE 1, DEFERRABLE 2, INITIALLY IMMEDIATE 4 and
// INITIALLY DEFERRED 8; contradictions are errors (NOT VALID and the others are errors for a trigger).
def trigger_cas: Integer = c:trigger_cas_list [$c.Ival % 4 != 3 && ($c.Ival / 4) % 4 != 3 && $c.Ival % 2 + ($c.Ival / 8) % 2 != 2] -> $c
def trigger_cas_list: Integer = l:trigger_cas_elem*
    -> foldl(new Integer{Ival: 0}, $l, (acc, i) => new Integer{Ival: $acc.Ival + $i.Ival * (1 - ($acc.Ival / $i.Ival) % 2)})
def trigger_cas_elem: Integer = (NOT DEFERRABLE [b = 1] / DEFERRABLE [b = 2] / INITIALLY IMMEDIATE [b = 4] / INITIALLY DEFERRED [b = 8])
    -> new Integer{Ival: b}

// ---- CREATE EVENT TRIGGER, ALTER EVENT TRIGGER ----

def CreateEventTrigStmt: CreateEventTrigStmt = CREATE EVENT TRIGGER n:name ON e:ColLabel w:event_trigger_when? EXECUTE (FUNCTION / PROCEDURE)
    f:func_name -LP -RP
    -> new CreateEventTrigStmt{Trigname: $n, Eventname: $e, Whenclause: concat($w), Funcname: $f}
def event_trigger_when: []DefElem = WHEN first:event_trigger_when_item rest:(-AND x:event_trigger_when_item)*
    -> concat(list($first), map($rest, (r) => $r.x))
def event_trigger_when_item: DefElem = n:ColId IN -LP first:Sconst rest:(-COMMA x:Sconst)* -RP
    -> new DefElem{Defname: $n, Arg: new NodeList{Items: concat(list($first), map($rest, (r) => $r.x))}}
def AlterEventTrigStmt: AlterEventTrigStmt = ALTER EVENT TRIGGER n:name
    (ENABLE (REPLICA [e = "R"] / ALWAYS [e = "A"] / _ [e = "O"]) / DISABLE [e = "D"])
    -> new AlterEventTrigStmt{Trigname: $n, Tgenabled: e}

// ---- CREATE RULE ----

def RuleStmt: RuleStmt = [ins = false] CREATE r:b2_or_replace? RULE n:name AS ON
    (SELECT [ev = "CMD_SELECT"] / UPDATE [ev = "CMD_UPDATE"] / DELETE [ev = "CMD_DELETE"] / INSERT [ev = "CMD_INSERT"])
    TO rel:qualified_name w:where_clause? DO (INSTEAD [ins = true] / ALSO)? a:rule_actions
    -> new RuleStmt{Relation: $rel, Rulename: $n, WhereClause: $w, Event: ev, Instead: ins, Actions: $a, Replace: len($r) > 0}
def rule_actions: []RuleActionStmt = rule_nothing / rule_single / rule_multi
def rule_nothing: []RuleActionStmt = NOTHING -> list()
def rule_single: []RuleActionStmt = a:RuleActionStmt -> list($a)
// (stmt; stmt; ...): empty statements are dropped
def rule_multi: []RuleActionStmt = -LP -SEMI* l:rule_multi_body? -RP -> concat($l)
def rule_multi_body: []RuleActionStmt = first:RuleActionStmt rest:(-SEMI+ x:RuleActionStmt)* -SEMI*
    -> concat(list($first), map($rest, (r) => $r.x))
def RuleActionStmt: RuleActionStmt = SelectStmt / InsertStmt / UpdateStmt / DeleteStmt / NotifyStmt

// ---- CREATE POLICY, ALTER POLICY ----

def CreatePolicyStmt: CreatePolicyStmt = [perm = true] [cmd = "all"] CREATE POLICY n:name ON t:qualified_name
    (AS (policy_permissive [perm = true] / policy_restrictive [perm = false]))?
    (FOR (ALL [cmd = "all"] / SELECT [cmd = "select"] / INSERT [cmd = "insert"] / UPDATE [cmd = "update"] / DELETE [cmd = "delete"]))?
    r:policy_roles q:policy_using? c:policy_check?
    -> new CreatePolicyStmt{PolicyName: $n, Table: $t, CmdName: cmd, Permissive: perm, Roles: $r, Qual: $q, WithCheck: $c}
def AlterPolicyStmt: AlterPolicyStmt = ALTER POLICY n:name ON t:qualified_name r:policy_to? q:policy_using? c:policy_check? b2_end
    -> new AlterPolicyStmt{PolicyName: $n, Table: $t, Roles: concat($r), Qual: $q, WithCheck: $c}
// PERMISSIVE and RESTRICTIVE are IDENT in gram.y, any other word is an error
def policy_permissive = w:b2_word [$w.V == "permissive"]
def policy_restrictive = w:b2_word [$w.V == "restrictive"]
def policy_to: []RoleSpec = TO l:role_list -> $l
// CREATE POLICY without TO applies to PUBLIC
def policy_roles: []RoleSpec = policy_to / policy_public
def policy_public: []RoleSpec = _ -> list(new RoleSpec{Roletype: "ROLESPEC_PUBLIC"})
def policy_using: Expr = USING -LP e:a_expr -RP -> $e
def policy_check: Expr = WITH CHECK -LP e:a_expr -RP -> $e
// ==== Group B2: roles, databases, tablespaces, foreign data, publications, subscriptions, triggers, rules, policies ====
//
// CREATE/ALTER/DROP of ROLE, USER, GROUP, DATABASE, TABLESPACE, FOREIGN DATA WRAPPER, SERVER, USER MAPPING,
// PUBLICATION, SUBSCRIPTION, EVENT TRIGGER, TRIGGER, RULE and POLICY, IMPORT FOREIGN SCHEMA, DROP OWNED and
// REASSIGN OWNED. (CREATE ASSERTION is not here: gram.y always reports it as not implemented, so no tree
// exists for it and the grammar rejects it.) The files 64-b-fdw, 64-c-pub and 64-d-trigger have the rest.

type StmtB2 = CreateRoleStmt | AlterRoleStmt | AlterRoleSetStmt | DropRoleStmt | DropOwnedStmt | ReassignOwnedStmt |
    CreatedbStmt | AlterDatabaseStmt | AlterDatabaseRefreshCollStmt | AlterDatabaseSetStmt | DropdbStmt |
    CreateTableSpaceStmt | DropTableSpaceStmt | AlterTableSpaceOptionsStmt |
    CreateFdwStmt | AlterFdwStmt | CreateForeignServerStmt | AlterForeignServerStmt | ImportForeignSchemaStmt |
    CreateUserMappingStmt | AlterUserMappingStmt | DropUserMappingStmt |
    CreatePublicationStmt | AlterPublicationStmt | CreateSubscriptionStmt | AlterSubscriptionStmt | DropSubscriptionStmt |
    CreateEventTrigStmt | AlterEventTrigStmt | CreateTrigStmt | RuleStmt | CreatePolicyStmt | AlterPolicyStmt

// The alternatives start with the same keywords in some cases: the specific ones come first (USER MAPPING
// before USER role), and the statements whose last part is optional end with b2_end, so that a statement of
// another group that begins the same way (ALTER ROLE r RENAME TO ...) is not cut short.
def stmt_b2: StmtB2 =
    CreateUserMappingStmt / AlterUserMappingStmt / DropUserMappingStmt
    / CreateRoleStmt / AlterRoleSetStmt / AlterRoleStmt / AlterGroupStmt / DropRoleStmt / DropOwnedStmt / ReassignOwnedStmt
    / CreatedbStmt / AlterDatabaseStmt / AlterDatabaseRefreshCollStmt / AlterDatabaseSetStmt / DropdbStmt
    / CreateTableSpaceStmt / DropTableSpaceStmt / AlterTblSpcStmt
    / CreateFdwStmt / AlterFdwStmt / CreateForeignServerStmt / AlterForeignServerStmt / ImportForeignSchemaStmt
    / CreatePublicationStmt / AlterPublicationStmt / CreateSubscriptionStmt / AlterSubscriptionStmt / DropSubscriptionStmt
    / CreateEventTrigStmt / AlterEventTrigStmt / CreateTrigStmt / RuleStmt / CreatePolicyStmt / AlterPolicyStmt

// The end of a statement (without consuming it)
def b2_end = &(SEMI / $$)
def b2_or_replace = OR REPLACE
def b2_with = WITH

// ==== Roles ====

type CreateRoleStmt struct { StmtType string, Role Ident, Options []DefElem }
type AlterRoleStmt struct { Role RoleSpec, Options []DefElem, Action int }
type AlterRoleSetStmt struct { Role *RoleSpec, Database *Ident, Setstmt VariableSetStmt }
type DropRoleStmt struct { Roles []RoleSpec, MissingOk bool }
type DropOwnedStmt struct { Roles []RoleSpec, Behavior *DropBehavior }
type ReassignOwnedStmt struct { Roles []RoleSpec, Newrole RoleSpec }

// RoleId: a role name that is not PUBLIC, NONE or one of the pseudo-roles (CURRENT_USER and the others are
// reserved words, and NonReservedWord does not match them)
def RoleId: Ident = !PUBLIC_WORD !NONE_WORD n:NonReservedWord -> $n

def CreateRoleStmt: CreateRoleStmt = CREATE
    (ROLE [t = "ROLESTMT_ROLE"] / USER [t = "ROLESTMT_USER"] / GROUP [t = "ROLESTMT_GROUP"])
    n:RoleId b2_with? o:create_role_elem*
    -> new CreateRoleStmt{StmtType: t, Role: $n, Options: $o}
def AlterRoleStmt: AlterRoleStmt = ALTER (ROLE / USER) r:RoleSpec b2_with? o:alter_role_elem* b2_end
    -> new AlterRoleStmt{Role: $r, Options: $o, Action: 1}
def AlterGroupStmt: AlterRoleStmt = ALTER GROUP r:RoleSpec (ADD [a = 1] / DROP [a = -1]) USER l:role_list
    -> new AlterRoleStmt{Role: $r, Options: list(new DefElem{Defname: new String{Sval: "rolemembers"}, Arg: new NodeList{Items: $l}}), Action: a}
def AlterRoleSetStmt: AlterRoleSetStmt = ALTER (ROLE / USER) (r:RoleSpec / ALL) (IN DATABASE n:name)? s:SetResetClause
    -> new AlterRoleSetStmt{Role: $r, Database: $n, Setstmt: $s}
def DropRoleStmt: DropRoleStmt = DROP (ROLE / USER / GROUP) i:(IF EXISTS)? l:role_list
    -> new DropRoleStmt{Roles: $l, MissingOk: len($i) > 0}
def DropOwnedStmt: DropOwnedStmt = DROP OWNED BY l:role_list b:drop_behavior? -> new DropOwnedStmt{Roles: $l, Behavior: $b}
def ReassignOwnedStmt: ReassignOwnedStmt = REASSIGN OWNED BY l:role_list TO r:RoleSpec -> new ReassignOwnedStmt{Roles: $l, Newrole: $r}

// The options of CREATE ROLE and ALTER ROLE: DefElems with made-up names and Boolean, Integer, String or
// list values. gram.y writes the flags (SUPERUSER, NOLOGIN, ...) as IDENT, so they are not keywords here
// either; UNENCRYPTED PASSWORD and the other words are errors in gram.y, and not matched.
def alter_role_elem: DefElem = role_password / role_password_null / role_inherit / role_connlimit / role_valid_until
    / role_list_opt / role_flag
def create_role_elem: DefElem = alter_role_elem / role_sysid / role_list_create
def role_password: DefElem = (ENCRYPTED)? PASSWORD s:Sconst
    -> new DefElem{Defname: new String{Sval: "password"}, Arg: $s}
def role_password_null: DefElem = PASSWORD NULL -> new DefElem{Defname: new String{Sval: "password"}}
def role_inherit: DefElem = INHERIT -> new DefElem{Defname: new String{Sval: "inherit"}, Arg: new Boolean{Boolval: true}}
def role_connlimit: DefElem = CONNECTION LIMIT n:SignedIconst
    -> new DefElem{Defname: new String{Sval: "connectionlimit"}, Arg: $n}
def role_valid_until: DefElem = VALID UNTIL s:Sconst -> new DefElem{Defname: new String{Sval: "validUntil"}, Arg: $s}
def role_list_opt: DefElem = USER l:role_list -> new DefElem{Defname: new String{Sval: "rolemembers"}, Arg: new NodeList{Items: $l}}
def role_sysid: DefElem = SYSID n:Iconst -> new DefElem{Defname: new String{Sval: "sysid"}, Arg: $n}
def role_list_create: DefElem =
    (ADMIN [n = "adminmembers"] / ROLE [n = "rolemembers"] / IN (ROLE / GROUP) [n = "addroleto"]) l:role_list
    -> new DefElem{Defname: new String{Sval: n}, Arg: new NodeList{Items: $l}}
// superuser, nosuperuser, createrole, ..., noinherit (IDENT in gram.y): unquoted in any case, or quoted in lower case
def role_flag: DefElem = w:b2_word
    ( [$w.V == "superuser" || $w.V == "nosuperuser"] [n = "superuser"] [b = $w.V == "superuser"]
    / [$w.V == "createrole" || $w.V == "nocreaterole"] [n = "createrole"] [b = $w.V == "createrole"]
    / [$w.V == "createdb" || $w.V == "nocreatedb"] [n = "createdb"] [b = $w.V == "createdb"]
    / [$w.V == "replication" || $w.V == "noreplication"] [n = "isreplication"] [b = $w.V == "replication"]
    / [$w.V == "login" || $w.V == "nologin"] [n = "canlogin"] [b = $w.V == "login"]
    / [$w.V == "bypassrls" || $w.V == "nobypassrls"] [n = "bypassrls"] [b = $w.V == "bypassrls"]
    / [$w.V == "noinherit"] [n = "inherit"] [b = false] )
    -> new DefElem{Defname: new String{Sval: n}, Arg: new Boolean{Boolval: b}}
// A word that is an IDENT in gram.y: unquoted (the word folded to lower case), or quoted in lower case
def b2_word: LcWord = b2_word_plain / b2_word_quoted
def b2_word_plain: LcWord = x:lcword s -> $x
def b2_word_quoted: LcWord = -"\"" r:@((?a-z)+) -"\"" s -> new LcWord{V: text($r)}

// ==== Databases ====

type CreatedbStmt struct { Dbname Ident, Options []DefElem }
type AlterDatabaseStmt struct { Dbname Ident, Options []DefElem }
type AlterDatabaseRefreshCollStmt struct { Dbname Ident }
type AlterDatabaseSetStmt struct { Dbname Ident, Setstmt VariableSetStmt }
type DropdbStmt struct { Dbname Ident, MissingOk bool, Options []DefElem }

def CreatedbStmt: CreatedbStmt = CREATE DATABASE n:name b2_with? o:createdb_opt_item*
    -> new CreatedbStmt{Dbname: $n, Options: $o}
// ALTER DATABASE name [WITH] options (possibly none), SET TABLESPACE, REFRESH COLLATION VERSION
def AlterDatabaseStmt: AlterDatabaseStmt = alter_db_tablespace / alter_db_options
def alter_db_tablespace: AlterDatabaseStmt = ALTER DATABASE n:name SET TABLESPACE t:name
    -> new AlterDatabaseStmt{Dbname: $n, Options: list(new DefElem{Defname: new String{Sval: "tablespace"}, Arg: $t})}
def alter_db_options: AlterDatabaseStmt = ALTER DATABASE n:name b2_with? o:createdb_opt_item* b2_end
    -> new AlterDatabaseStmt{Dbname: $n, Options: $o}
def AlterDatabaseRefreshCollStmt: AlterDatabaseRefreshCollStmt = ALTER DATABASE n:name REFRESH COLLATION VERSION
    -> new AlterDatabaseRefreshCollStmt{Dbname: $n}
def AlterDatabaseSetStmt: AlterDatabaseSetStmt = ALTER DATABASE n:name s:SetResetClause
    -> new AlterDatabaseSetStmt{Dbname: $n, Setstmt: $s}
def DropdbStmt: DropdbStmt = DROP DATABASE i:(IF EXISTS)? n:name o:drop_options?
    -> new DropdbStmt{Dbname: $n, MissingOk: len($i) > 0, Options: concat($o)}
def drop_options: []DefElem = b2_with? -LP first:drop_option rest:(-COMMA x:drop_option)* -RP
    -> concat(list($first), map($rest, (r) => $r.x))
// the only drop option is FORCE
def drop_option: DefElem = FORCE -> new DefElem{Defname: new String{Sval: "force"}}

// An option of CREATE DATABASE: name [=] value. The name is an IDENT or one of a few keywords (gram.y does not
// use ColId because of conflicts with ALTER DATABASE SET); CONNECTION LIMIT is connection_limit.
// The value is NumericOnly, a boolean or string, or DEFAULT (no value).
def createdb_opt_item: DefElem = n:createdb_opt_name b2_equal? (v:NumericOnly / v:b2_bool_or_string / DEFAULT)
    -> new DefElem{Defname: $n, Arg: $v}
def createdb_opt_name: DefName = createdb_opt_keyword / createdb_opt_ident
// (the keywords that start another ALTER DATABASE are not option names here, IDENT of gram.y is no keyword at all)
def createdb_opt_ident: Ident = !(CONNECTION / SET / RESET / REFRESH / RENAME) n:IDENT -> $n
def createdb_opt_keyword: String =
    (CONNECTION LIMIT [n = "connection_limit"] / ENCODING [n = "encoding"] / LOCATION [n = "location"] / OWNER [n = "owner"]
    / TABLESPACE [n = "tablespace"] / TEMPLATE [n = "template"])
    -> new String{Sval: n}
def b2_equal = EQ
def b2_bool_or_string: DefArg = b2_true / b2_false / b2_on / NonReservedWord_or_Sconst
def b2_true: String = TRUE -> new String{Sval: "true"}
def b2_false: String = FALSE -> new String{Sval: "false"}
def b2_on: String = ON -> new String{Sval: "on"}

// ==== Tablespaces ====

type CreateTableSpaceStmt struct { Tablespacename Ident, Owner *RoleSpec, Location Sconst, Options []DefElem }
type DropTableSpaceStmt struct { Tablespacename Ident, MissingOk bool }
type AlterTableSpaceOptionsStmt struct { Tablespacename Ident, Options []DefElem, IsReset bool }

def CreateTableSpaceStmt: CreateTableSpaceStmt = CREATE TABLESPACE n:name (OWNER r:RoleSpec)? LOCATION l:Sconst ro:opt_reloptions?
    -> new CreateTableSpaceStmt{Tablespacename: $n, Owner: $r, Location: $l, Options: concat($ro)}
def DropTableSpaceStmt: DropTableSpaceStmt = DROP TABLESPACE i:(IF EXISTS)? n:name
    -> new DropTableSpaceStmt{Tablespacename: $n, MissingOk: len($i) > 0}
def AlterTblSpcStmt: AlterTableSpaceOptionsStmt = ALTER TABLESPACE n:name (SET [r = false] / RESET [r = true]) o:reloptions
    -> new AlterTableSpaceOptionsStmt{Tablespacename: $n, Options: $o, IsReset: r}
// ==== Generic object statements (group C2) ====
//
// DROP, ALTER ... RENAME TO / OWNER TO / SET SCHEMA / DEPENDS ON EXTENSION, COMMENT, SECURITY LABEL, GRANT,
// REVOKE and ALTER DEFAULT PRIVILEGES. gram.y has one production per kind of object (about 60 for
// RenameStmt); here the kinds are grouped by the shape of what follows the keywords, and the kind itself is a
// terminal of type ObjectType (the words that name it, such as MATERIALIZED VIEW), which the converter maps to
// the ObjectType enumerator of the raw tree (OBJECT_MATVIEW). Where the raw parser sets an enumerator without
// a keyword of its own, the action sets the string.
//
// The statements that the raw parser makes from the same words in different contexts differ in the kinds of
// objects they accept. The variable op tells the shared rules which statement calls them (r: RENAME,
// c: RENAME COLUMN, o: OWNER TO, s: SET SCHEMA), sl is true in SECURITY LABEL, and dflt is true in ALTER
// DEFAULT PRIVILEGES (the same GRANT and REVOKE, with a kind of objects instead of objects).
//
// Because the choice of the statement commits to the first alternative that matches, these statements must not
// come after a statement that can match only a prefix of them: ALTER ROLE r (all options are optional) would
// take the beginning of ALTER ROLE r RENAME TO s. Put stmt_c2 before the statements of the other groups.

type ObjectType terminal
// An object type: the terminal of the words (mapped by the converter) or the enumerator itself
type ObjType = ObjectType | string
// A name of a function parameter: a.b.c is the string "a.b.c"
type ParamName struct { Names []Ident }
// What the raw parser stores in the object (or objects) of these statements, a name list being a List node
type ObjNode = NodeList | Ident | TypeName | ObjectWithArgs | RangeVar | NumericOnly | ParamName

type DropStmt struct { Objects []ObjNode, RemoveType ObjType, Behavior *DropBehavior, MissingOk bool, Concurrent bool }
type RenameStmt struct {
    RenameType ObjType, RelationType *ObjType, Relation *RangeVar, Object *ObjNode, Subname *Ident, Newname Ident,
    Behavior *DropBehavior, MissingOk bool
}
type AlterObjectSchemaStmt struct { ObjectType ObjType, Relation *RangeVar, Object *ObjNode, Newschema Ident, MissingOk bool }
type AlterOwnerStmt struct { ObjectType ObjType, Object ObjNode, Newowner RoleSpec }
type AlterObjectDependsStmt struct { ObjectType ObjType, Relation *RangeVar, Object *ObjNode, Extname Ident, Remove bool }
type CommentStmt struct { Objtype ObjType, Object ObjNode, Comment *Sconst }
type SecLabelStmt struct { Objtype ObjType, Object ObjNode, Provider *NameOrString, Label *Sconst }
// A privilege name: SELECT, a name, or "alter system"
type PrivName = Ident | string
type AccessPriv struct { PrivName *PrivName, Cols []Ident }
type GrantStmt struct {
    IsGrant bool, Targtype string, Objtype ObjType, Objects []ObjNode, Privileges []AccessPriv, Grantees []RoleSpec,
    GrantOption bool, Grantor *RoleSpec, Behavior *DropBehavior
}
// An option of GRANT role (WITH ADMIN OPTION, INHERIT FALSE, ...): a DefElem with a Boolean
type RoleOpt struct { Name Ident, Value bool }
type GrantRoleStmt struct {
    GrantedRoles []AccessPriv, GranteeRoles []RoleSpec, IsGrant bool, Opt []RoleOpt, Grantor *RoleSpec,
    Behavior *DropBehavior
}
// An option of ALTER DEFAULT PRIVILEGES: the DefElem "schemas" or "roles"
type DefaclOpt struct { Schemas []Ident, Roles []RoleSpec }
type AlterDefaultPrivilegesStmt struct { Options []DefaclOpt, Action GrantStmt }

type StmtC2 = DropStmt | RenameStmt | AlterObjectSchemaStmt | AlterOwnerStmt | AlterObjectDependsStmt | CommentStmt |
    SecLabelStmt | GrantStmt | GrantRoleStmt | AlterDefaultPrivilegesStmt
def stmt_c2: StmtC2 = DropStmt / RenameStmt / AlterObjectSchemaStmt / AlterOwnerStmt / AlterObjectDependsStmt
    / CommentStmt / SecLabelStmt / GrantStmt / GrantRoleStmt / AlterDefaultPrivilegesStmt

// ---- Kinds of objects ----

def object_type_any_name: ObjectType = TABLE / SEQUENCE / VIEW / MATERIALIZED VIEW / INDEX / FOREIGN TABLE / COLLATION
    / CONVERSION / STATISTICS / TEXT SEARCH (PARSER / DICTIONARY / TEMPLATE / CONFIGURATION)
def object_type_name: ObjectType = drop_type_name / DATABASE / ROLE / SUBSCRIPTION / TABLESPACE
def drop_type_name: ObjectType = ACCESS METHOD / EVENT TRIGGER / EXTENSION / FOREIGN DATA WRAPPER / opt_procedural LANGUAGE
    / PUBLICATION / SCHEMA / SERVER
def object_type_name_on_any_name: ObjectType = POLICY / RULE / TRIGGER

// the kinds of objects by what follows them (see alter_obj)
def ot_aggr: ObjectType = AGGREGATE
def ot_routine: ObjectType = FUNCTION / PROCEDURE / ROUTINE
def ot_oper: ObjectType = OPERATOR
def ot_opclass: ObjectType = OPERATOR (CLASS / FAMILY)
def ot_type: ObjectType = TYPE / DOMAIN
def ot_any: ObjectType = COLLATION / CONVERSION / DOMAIN / STATISTICS / TYPE / TEXT SEARCH (DICTIONARY / CONFIGURATION)
def ot_any_rs: ObjectType = TEXT SEARCH (PARSER / TEMPLATE)
def ot_name: ObjectType = FOREIGN DATA WRAPPER / SERVER / EVENT TRIGGER / PUBLICATION / SUBSCRIPTION / opt_procedural LANGUAGE
def ot_name_own: ObjectType = DATABASE / SCHEMA / TABLESPACE
def ot_large: ObjectType = LARGE OBJECT

// ---- Objects: the names of what the statements refer to ----

def any_name_obj: NodeList = n:any_name -> new NodeList{Items: $n}
def any_name_nodes: []NodeList = l:any_name_list -> map($l, (n) => new NodeList{Items: $n})
// opclass_obj: any_name USING name, which the raw parser stores as (name, ...any_name)
def opclass_obj: NodeList = a:any_name USING n:name -> new NodeList{Items: concat(list($n), $a)}
// name ON any_name, stored as (...any_name, name)
def name_on_obj: NodeList = n:name ON a:any_name -> new NodeList{Items: concat($a, list($n))}

// The object of COMMENT, SECURITY LABEL and ALTER ... : its kind and the node
type ObjSpec struct { ObjType ObjType, Object ObjNode }
// alter_obj: the objects of RENAME TO (op r), OWNER TO (o) and SET SCHEMA (s) that are not relations
def alter_obj: ObjSpec =
    ( t:ot_aggr o:aggregate_with_argtypes
    / t:ot_routine o:function_with_argtypes
    / [op == "o" || op == "s"] t:ot_oper o:operator_with_argtypes
    / t:ot_opclass o:opclass_obj
    / t:ot_any o:any_name_obj
    / [op != "o"] t:ot_any_rs o:any_name_obj
    / [op != "s"] t:ot_name o:name
    / [op == "o"] t:ot_name_own o:name
    / [op == "s"] t:ot_ext o:name
    / [op == "o"] t:ot_large o:NumericOnly )
    -> new ObjSpec{ObjType: $t, Object: $o}
def ot_ext: ObjectType = EXTENSION

// alter_rel: the relations of RENAME TO, RENAME COLUMN (op c) and SET SCHEMA, with IF EXISTS
type RelSpec struct { ObjType ObjType, Rel RangeVar, Missing bool }
def alter_rel: RelSpec =
    ( t:ot_tab m:(IF EXISTS)? r:relation_expr
    / t:ot_view m:(IF EXISTS)? r:qualified_name
    / [op != "c"] t:ot_seq m:(IF EXISTS)? r:qualified_name
    / [op == "r"] t:ot_index m:(IF EXISTS)? r:qualified_name )
    -> new RelSpec{ObjType: $t, Rel: $r, Missing: len($m) > 0}
def ot_tab: ObjectType = TABLE / FOREIGN TABLE
def ot_view: ObjectType = VIEW / MATERIALIZED VIEW
def ot_seq: ObjectType = SEQUENCE
def ot_index: ObjectType = INDEX

// ---- DROP ----

def DropStmt: DropStmt = drop_index_conc / drop_any / drop_name / drop_on / drop_type / drop_args
def drop_index_conc: DropStmt = DROP INDEX CONCURRENTLY m:(IF EXISTS)? l:any_name_nodes b:drop_behavior?
    -> new DropStmt{Objects: $l, RemoveType: "OBJECT_INDEX", Behavior: $b, MissingOk: len($m) > 0, Concurrent: true}
def drop_any: DropStmt = DROP t:object_type_any_name m:(IF EXISTS)? l:any_name_nodes b:drop_behavior?
    -> new DropStmt{Objects: $l, RemoveType: $t, Behavior: $b, MissingOk: len($m) > 0}
def drop_name: DropStmt = DROP t:drop_type_name m:(IF EXISTS)? l:name_list b:drop_behavior?
    -> new DropStmt{Objects: $l, RemoveType: $t, Behavior: $b, MissingOk: len($m) > 0}
// DROP POLICY | RULE | TRIGGER name ON table: the object is (...table, name)
def drop_on: DropStmt = DROP t:object_type_name_on_any_name m:(IF EXISTS)? n:name ON a:any_name b:drop_behavior?
    -> new DropStmt{Objects: list(new NodeList{Items: concat($a, list($n))}), RemoveType: $t, Behavior: $b, MissingOk: len($m) > 0}
def drop_type: DropStmt = DROP t:ot_type m:(IF EXISTS)? l:type_list b:drop_behavior?
    -> new DropStmt{Objects: $l, RemoveType: $t, Behavior: $b, MissingOk: len($m) > 0}
// RemoveFuncStmt, RemoveAggrStmt and RemoveOperStmt
def drop_args: DropStmt = DROP ( t:ot_routine [k = 1] / t:ot_aggr [k = 2] / t:ot_oper [k = 3] ) m:(IF EXISTS)?
    ( [k == 1] f:function_with_argtypes_list / [k == 2] a:aggregate_with_argtypes_list / [k == 3] o:operator_with_argtypes_list )
    b:drop_behavior?
    -> new DropStmt{Objects: concat($f, $a, $o), RemoveType: $t, Behavior: $b, MissingOk: len($m) > 0}

// ---- ALTER ... RENAME TO ----

def RenameStmt: RenameStmt = rename_obj / rename_rel / rename_col / rename_sub / rename_cstr / rename_domcstr / rename_on / rename_attr
def rename_obj: RenameStmt = ALTER [op = "r"] s:alter_obj RENAME TO n:name
    -> new RenameStmt{RenameType: $s.ObjType, Object: $s.Object, Newname: $n}
def rename_rel: RenameStmt = ALTER [op = "r"] s:alter_rel RENAME TO n:name
    -> new RenameStmt{RenameType: $s.ObjType, Relation: $s.Rel, Newname: $n, MissingOk: $s.Missing}
def rename_col: RenameStmt = ALTER [op = "c"] s:alter_rel RENAME COLUMN? c:name TO n:name
    -> new RenameStmt{RenameType: "OBJECT_COLUMN", RelationType: $s.ObjType, Relation: $s.Rel, Subname: $c, Newname: $n, MissingOk: $s.Missing}
// the names of databases, schemas and tablespaces and of roles (RoleId: not public, none, ...) are subnames
def rename_sub: RenameStmt = ALTER ( t:ot_name_own s:name RENAME TO n:name / t:ot_role s:RoleId RENAME TO n:RoleId )
    -> new RenameStmt{RenameType: $t, Subname: $s, Newname: $n}
def ot_role: ObjectType = GROUP / ROLE / USER
def rename_cstr: RenameStmt = ALTER TABLE m:(IF EXISTS)? r:relation_expr RENAME CONSTRAINT c:name TO n:name
    -> new RenameStmt{RenameType: "OBJECT_TABCONSTRAINT", Relation: $r, Subname: $c, Newname: $n, MissingOk: len($m) > 0}
def rename_domcstr: RenameStmt = ALTER DOMAIN a:any_name RENAME CONSTRAINT c:name TO n:name
    -> new RenameStmt{RenameType: "OBJECT_DOMCONSTRAINT", Object: new NodeList{Items: $a}, Subname: $c, Newname: $n}
def rename_on: RenameStmt = ALTER ( t:ot_policy m:(IF EXISTS)? / t:ot_rule_trigger ) s:name ON r:qualified_name RENAME TO n:name
    -> new RenameStmt{RenameType: $t, Relation: $r, Subname: $s, Newname: $n, MissingOk: len($m) > 0}
def ot_policy: ObjectType = POLICY
def ot_rule_trigger: ObjectType = RULE / TRIGGER
// ALTER TYPE name RENAME ATTRIBUTE: the type is a RangeVar (makeRangeVarFromAnyName)
def rename_attr: RenameStmt = ALTER TYPE r:qualified_name RENAME ATTRIBUTE s:name TO n:name b:drop_behavior?
    -> new RenameStmt{RenameType: "OBJECT_ATTRIBUTE", RelationType: "OBJECT_TYPE", Subname: $s, Newname: $n, Behavior: $b,
        Relation: new RangeVar{Catalogname: $r.Catalogname, Schemaname: $r.Schemaname, Relname: $r.Relname, Relpersistence: "p"}}

// ---- ALTER ... OWNER TO, SET SCHEMA, DEPENDS ON EXTENSION ----

def AlterOwnerStmt: AlterOwnerStmt = ALTER [op = "o"] s:alter_obj OWNER TO r:RoleSpec
    -> new AlterOwnerStmt{ObjectType: $s.ObjType, Object: $s.Object, Newowner: $r}

def AlterObjectSchemaStmt: AlterObjectSchemaStmt = schema_obj / schema_rel
def schema_obj: AlterObjectSchemaStmt = ALTER [op = "s"] s:alter_obj SET SCHEMA n:name
    -> new AlterObjectSchemaStmt{ObjectType: $s.ObjType, Object: $s.Object, Newschema: $n}
def schema_rel: AlterObjectSchemaStmt = ALTER [op = "s"] s:alter_rel SET SCHEMA n:name
    -> new AlterObjectSchemaStmt{ObjectType: $s.ObjType, Relation: $s.Rel, Newschema: $n, MissingOk: $s.Missing}

def AlterObjectDependsStmt: AlterObjectDependsStmt = depends_routine / depends_trigger / depends_rel
def depends_routine: AlterObjectDependsStmt = ALTER t:ot_routine o:function_with_argtypes r:depends_on_ext
    -> new AlterObjectDependsStmt{ObjectType: $t, Object: $o, Extname: $r.Name, Remove: $r.No}
def depends_trigger: AlterObjectDependsStmt = ALTER TRIGGER n:name ON q:qualified_name r:depends_on_ext
    -> new AlterObjectDependsStmt{ObjectType: "OBJECT_TRIGGER", Relation: $q, Object: new NodeList{Items: list($n)}, Extname: $r.Name, Remove: $r.No}
def depends_rel: AlterObjectDependsStmt = ALTER ( MATERIALIZED VIEW [t = "OBJECT_MATVIEW"] / INDEX [t = "OBJECT_INDEX"] ) q:qualified_name r:depends_on_ext
    -> new AlterObjectDependsStmt{ObjectType: t, Relation: $q, Extname: $r.Name, Remove: $r.No}
// [NO] DEPENDS ON EXTENSION name
type DependsOn struct { No bool, Name Ident }
def depends_on_ext: DependsOn = no:NO? DEPENDS ON EXTENSION n:name -> new DependsOn{No: len($no) > 0, Name: $n}

// ---- COMMENT and SECURITY LABEL ----

def CommentStmt: CommentStmt = COMMENT ON [sl = false] s:obj_spec IS (t:Sconst / NULL)
    -> new CommentStmt{Objtype: $s.ObjType, Object: $s.Object, Comment: $t}
def SecLabelStmt: SecLabelStmt = SECURITY LABEL p:opt_provider? ON [sl = true] s:obj_spec IS (l:Sconst / NULL)
    -> new SecLabelStmt{Objtype: $s.ObjType, Object: $s.Object, Provider: $p, Label: $l}
def opt_provider: NameOrString = FOR n:NonReservedWord_or_Sconst -> $n

// obj_spec: the object of COMMENT ON (sl false) and of SECURITY LABEL (sl true, fewer kinds)
def obj_spec: ObjSpec = obj_spec_simple / obj_cstr_dom / obj_cstr_tab / obj_transform / obj_cast
def obj_spec_simple: ObjSpec =
    ( t:comment_any_type o:any_name_obj
    / t:object_type_name o:name
    / t:ot_type o:Typename
    / t:ot_aggr o:aggregate_with_argtypes
    / t:ot_routine o:function_with_argtypes
    / [!sl] t:ot_oper o:operator_with_argtypes
    / t:ot_large o:NumericOnly
    / [!sl] t:object_type_name_on_any_name o:name_on_obj
    / [!sl] t:ot_opclass o:opclass_obj )
    -> new ObjSpec{ObjType: $t, Object: $o}
def comment_any_type: ObjectType = object_type_any_name / COLUMN
// the table or domain of a constraint (the raw parser makes the domain a TypeName)
def obj_cstr_dom: ObjSpec = [!sl] CONSTRAINT n:name ON DOMAIN a:any_name
    -> new ObjSpec{ObjType: "OBJECT_DOMCONSTRAINT", Object: new NodeList{Items: list(new TypeName{Names: $a, Typemod: -1}, $n)}}
def obj_cstr_tab: ObjSpec = [!sl] CONSTRAINT n:name ON a:any_name
    -> new ObjSpec{ObjType: "OBJECT_TABCONSTRAINT", Object: new NodeList{Items: concat($a, list($n))}}
def obj_transform: ObjSpec = [!sl] TRANSFORM FOR t:Typename LANGUAGE n:name
    -> new ObjSpec{ObjType: "OBJECT_TRANSFORM", Object: new NodeList{Items: list($t, $n)}}
def obj_cast: ObjSpec = [!sl] CAST -LP a:Typename AS b:Typename -RP
    -> new ObjSpec{ObjType: "OBJECT_CAST", Object: new NodeList{Items: list($a, $b)}}

// ---- GRANT and REVOKE ----

def GrantStmt: GrantStmt = [dflt = false] a:acl_action -> $a
// GRANT and REVOKE of a privilege on objects, or (in ALTER DEFAULT PRIVILEGES, dflt true) on a kind of objects
def acl_action: GrantStmt = grant_stmt / revoke_stmt
def grant_stmt: GrantStmt = GRANT p:privileges ON t:acl_target TO g:grantee_list
    o:(WITH GRANT OPTION)? b:granted_by? [!dflt || $b == nil]
    -> new GrantStmt{IsGrant: true, Targtype: $t.TargType, Objtype: $t.ObjType, Objects: $t.Objs, Privileges: $p, Grantees: $g, GrantOption: len($o) > 0, Grantor: $b}
def revoke_stmt: GrantStmt = REVOKE o:(GRANT OPTION FOR)? p:privileges ON t:acl_target FROM g:grantee_list b:granted_by? [!dflt || $b == nil] d:drop_behavior?
    -> new GrantStmt{Targtype: $t.TargType, Objtype: $t.ObjType, Objects: $t.Objs, Privileges: $p, Grantees: $g, GrantOption: len($o) > 0, Grantor: $b, Behavior: $d}
def granted_by: RoleSpec = GRANTED BY r:RoleSpec -> $r
def grantee_list: []RoleSpec = first:grantee rest:(-COMMA x:grantee)* -> concat(list($first), map($rest, (r) => $r.x))
def grantee: RoleSpec = GROUP? r:RoleSpec -> $r

// privileges: ALL [PRIVILEGES] [(columns)] (the list of privileges is empty for ALL), or a list of privileges
def privileges: []AccessPriv = privilege_list / all_priv_cols / all_priv
def all_priv_cols: []AccessPriv = ALL PRIVILEGES? -LP c:column_list -RP -> list(new AccessPriv{Cols: $c})
def all_priv: []AccessPriv = ALL PRIVILEGES? -> list()
def privilege_list: []AccessPriv = first:privilege rest:(-COMMA x:privilege)* -> concat(list($first), map($rest, (r) => $r.x))
def privilege: AccessPriv = privilege_alter_system / privilege_name
def privilege_alter_system: AccessPriv = ALTER SYSTEM -> new AccessPriv{PrivName: "alter system"}
def privilege_name: AccessPriv = n:(priv_keyword / ColId) c:opt_column_list? -> new AccessPriv{PrivName: $n, Cols: concat($c)}
// the reserved keywords that are privilege names
def priv_keyword: Ident = t:priv_keyword_text s -> $t
def priv_keyword_text: Ident = &(SELECT / REFERENCES / CREATE) word

// privilege_target: the objects of GRANT and REVOKE
type PrivTarget struct { TargType string, ObjType ObjType, Objs []ObjNode }
def acl_target: PrivTarget = defacl_target / privilege_target
def defacl_target: PrivTarget = [dflt] t:defacl_privilege_target -> new PrivTarget{TargType: "ACL_TARGET_DEFAULTS", ObjType: $t}
def defacl_privilege_target: ObjectType = TABLES / FUNCTIONS / ROUTINES / SEQUENCES / TYPES / SCHEMAS / LARGE OBJECTS
def privilege_target: PrivTarget = [!dflt] [tt = "ACL_TARGET_OBJECT"]
    ( t:ot_all IN SCHEMA [tt = "ACL_TARGET_ALL_IN_SCHEMA"] o:name_list
    / t:ot_pt_rel o:qualified_name_list
    / t:ot_pt_name o:name_list
    / t:ot_routine o:function_with_argtypes_list
    / t:ot_pt_type o:any_name_nodes
    / t:ot_large o:NumericOnly_list
    / t:ot_param o:parameter_name_list
    / t:ot_table_default o:qualified_name_list )
    -> new PrivTarget{TargType: tt, ObjType: $t, Objs: $o}
def ot_all: ObjectType = ALL (TABLES / SEQUENCES / FUNCTIONS / PROCEDURES / ROUTINES)
def ot_pt_rel: ObjectType = TABLE / SEQUENCE
// no keyword: a table (last, as most keywords of the alternatives before it can be table names)
def ot_table_default: ObjectType = _
def ot_pt_name: ObjectType = FOREIGN DATA WRAPPER / FOREIGN SERVER / DATABASE / LANGUAGE / SCHEMA / TABLESPACE
def ot_pt_type: ObjectType = DOMAIN / TYPE
def ot_param: ObjectType = PARAMETER
def parameter_name_list: []ParamName = first:parameter_name rest:(-COMMA x:parameter_name)* -> concat(list($first), map($rest, (r) => $r.x))
def parameter_name: ParamName = first:ColId rest:(-DOT x:ColId)* -> new ParamName{Names: concat(list($first), map($rest, (r) => $r.x))}

// GRANT role TO role: the roles are parsed as privileges
def GrantRoleStmt: GrantRoleStmt = grant_role / revoke_role
def grant_role: GrantRoleStmt = GRANT l:privilege_list TO r:role_list o:grant_role_opts? b:granted_by?
    -> new GrantRoleStmt{GrantedRoles: $l, GranteeRoles: $r, IsGrant: true, Opt: concat($o), Grantor: $b}
def grant_role_opts: []RoleOpt = WITH first:grant_role_opt rest:(-COMMA x:grant_role_opt)* -> concat(list($first), map($rest, (r) => $r.x))
def grant_role_opt: RoleOpt = n:ColLabel ( OPTION [v = true] / TRUE [v = true] / FALSE [v = false] ) -> new RoleOpt{Name: $n, Value: v}
def revoke_role: GrantRoleStmt = REVOKE o:revoke_role_opt? l:privilege_list FROM r:role_list b:granted_by? d:drop_behavior?
    -> new GrantRoleStmt{GrantedRoles: $l, GranteeRoles: $r, Opt: concat($o), Grantor: $b, Behavior: $d}
def revoke_role_opt: []RoleOpt = n:ColId OPTION FOR -> list(new RoleOpt{Name: $n, Value: false})

// ---- ALTER DEFAULT PRIVILEGES ----

def AlterDefaultPrivilegesStmt: AlterDefaultPrivilegesStmt = ALTER DEFAULT PRIVILEGES o:defacl_option* [dflt = true] a:acl_action
    -> new AlterDefaultPrivilegesStmt{Options: $o, Action: $a}
def defacl_option: DefaclOpt = ( IN SCHEMA s:name_list / FOR (ROLE / USER) r:role_list )
    -> new DefaclOpt{Schemas: concat($s), Roles: concat($r)}

// ==== Statements ====

// The start rule: statements separated by semicolons (empty statements are dropped).
def main: Script =
    s -SEMI* xs:(x:raw_stmt (-SEMI+ / $$))* $$
    -> new Script{Stmts: map($xs, (r) => $r.x)}
def raw_stmt: RawStmt = st:stmt -> new RawStmt{Stmt: $st}
def stmt: Stmt = stmt_dml / stmt_c2 / stmt_a / stmt_b / stmt_c / stmt_b2
def stmt_dml: DmlStmt = SelectStmt / InsertStmt / UpdateStmt / DeleteStmt / MergeStmt
// Stubs of rules that other groups own (group A: CREATE TABLE AS, CREATE MATERIALIZED VIEW, REFRESH). The
// coordinator deletes this file when the groups are merged. The names are those of gram.y.

// The IntoClause (the core's type, extended with the fields of the raw node) and the persistence and the
// data flag that group A's rules return.
type CreateTableAsStmt struct { Query ExecuteOrCreateTableAsQuery, Into IntoClause, Objtype string, IsSelectInto bool, IfNotExists bool }
type ExecuteOrCreateTableAsQuery = SelectStmt | ExecuteStmt
type RefreshMatViewStmt struct { Concurrent bool, SkipData bool, Relation RangeVar }
// OptTemp: the relpersistence of the table ("t", "u" or "p"); opt_with_data: SkipData is true for WITH NO DATA
type OptTempValue struct { Relpersistence string }
type WithDataValue struct { SkipData bool }

def CreateAsStmt: CreateTableAsStmt = "@@never@@" -> new CreateTableAsStmt{}
def CreateMatViewStmt: CreateTableAsStmt = "@@never@@" -> new CreateTableAsStmt{}
def RefreshMatViewStmt: RefreshMatViewStmt = "@@never@@" -> new RefreshMatViewStmt{}
def create_as_target: IntoClause = "@@never@@" -> new IntoClause{}
def OptTemp: OptTempValue = "@@never@@" -> new OptTempValue{}
def opt_with_data: WithDataValue = "@@never@@" -> new WithDataValue{}

// BEGIN GENERATED KEYWORDS (python3 internal/refgen/keywords.py update postgresql.pego)
// A word folded to lower case: the keywords are matched by comparing it with their lower-case spelling. The
// word is read once: the rule is memoized at its position, so all the keywords that are tried there share it.
// lowercase runs are appended as they are, the upper-case letters one by one, a non-ASCII letter as a mark
// that no keyword has.
type LcWord struct { V string }
def lcword: LcWord = w:lcword_read -> $w
def lcword_read: LcWord = &(?A-Za-z_\u{80}-\u{10FFFF}) [lw = ""]
    ( r:@((?a-z0-9_$)+) [lw = lw + text($r)]
    / (?A) [lw = lw + "a"]/ (?B) [lw = lw + "b"] / (?C) [lw = lw + "c"] / (?D) [lw = lw + "d"]
    / (?E) [lw = lw + "e"]/ (?F) [lw = lw + "f"] / (?G) [lw = lw + "g"] / (?H) [lw = lw + "h"]
    / (?I) [lw = lw + "i"]/ (?J) [lw = lw + "j"] / (?K) [lw = lw + "k"] / (?L) [lw = lw + "l"]
    / (?M) [lw = lw + "m"]/ (?N) [lw = lw + "n"] / (?O) [lw = lw + "o"] / (?P) [lw = lw + "p"]
    / (?Q) [lw = lw + "q"]/ (?R) [lw = lw + "r"] / (?S) [lw = lw + "s"] / (?T) [lw = lw + "t"]
    / (?U) [lw = lw + "u"]/ (?V) [lw = lw + "v"] / (?W) [lw = lw + "w"] / (?X) [lw = lw + "x"]
    / (?Y) [lw = lw + "y"]/ (?Z) [lw = lw + "z"]
    / (?\u{80}-\u{10FFFF}) [lw = lw + "\u{80}"] )+
    -> new LcWord{V: lw}
// A keyword rule sets the variable kwid to the keyword, and kw matches the word that follows if it is the one.
def kw = w:lcword [$w.V == kwid] s

def ABORT = &(?Aa) [kwid = "abort"] kw
def ABSENT = &(?Aa) [kwid = "absent"] kw
def ABSOLUTE = &(?Aa) [kwid = "absolute"] kw
def ACCESS = &(?Aa) [kwid = "access"] kw
def ADD = &(?Aa) [kwid = "add"] kw
def ADMIN = &(?Aa) [kwid = "admin"] kw
def AFTER = &(?Aa) [kwid = "after"] kw
def AGGREGATE = &(?Aa) [kwid = "aggregate"] kw
def ALL = &(?Aa) [kwid = "all"] kw
def ALSO = &(?Aa) [kwid = "also"] kw
def ALTER = &(?Aa) [kwid = "alter"] kw
def ALWAYS = &(?Aa) [kwid = "always"] kw
def ANALYSE = &(?Aa) [kwid = "analyse"] kw
def ANALYZE = &(?Aa) [kwid = "analyze"] kw
def AND = &(?Aa) [kwid = "and"] kw
def ANY = &(?Aa) [kwid = "any"] kw
def ARRAY = &(?Aa) [kwid = "array"] kw
def AS = &(?Aa) [kwid = "as"] kw
def ASC = &(?Aa) [kwid = "asc"] kw
def ASENSITIVE = &(?Aa) [kwid = "asensitive"] kw
def ASSIGNMENT = &(?Aa) [kwid = "assignment"] kw
def ASYMMETRIC = &(?Aa) [kwid = "asymmetric"] kw
def AT = &(?Aa) [kwid = "at"] kw
def ATOMIC = &(?Aa) [kwid = "atomic"] kw
def ATTRIBUTE = &(?Aa) [kwid = "attribute"] kw
def AUTHORIZATION = &(?Aa) [kwid = "authorization"] kw
def BACKWARD = &(?Bb) [kwid = "backward"] kw
def BEFORE = &(?Bb) [kwid = "before"] kw
def BEGIN = &(?Bb) [kwid = "begin"] kw
def BETWEEN = &(?Bb) [kwid = "between"] kw
def BIGINT = &(?Bb) [kwid = "bigint"] kw
def BINARY = &(?Bb) [kwid = "binary"] kw
def BIT = &(?Bb) [kwid = "bit"] kw
def BOOLEAN = &(?Bb) [kwid = "boolean"] kw
def BOTH = &(?Bb) [kwid = "both"] kw
def BREADTH = &(?Bb) [kwid = "breadth"] kw
def BY = &(?Bb) [kwid = "by"] kw
def CALL = &(?Cc) [kwid = "call"] kw
def CALLED = &(?Cc) [kwid = "called"] kw
def CASCADE = &(?Cc) [kwid = "cascade"] kw
def CASE = &(?Cc) [kwid = "case"] kw
def CAST = &(?Cc) [kwid = "cast"] kw
def CHAIN = &(?Cc) [kwid = "chain"] kw
def CHAR = &(?Cc) [kwid = "char"] kw
def CHARACTER = &(?Cc) [kwid = "character"] kw
def CHARACTERISTICS = &(?Cc) [kwid = "characteristics"] kw
def CHECK = &(?Cc) [kwid = "check"] kw
def CHECKPOINT = &(?Cc) [kwid = "checkpoint"] kw
def CLASS = &(?Cc) [kwid = "class"] kw
def CLOSE = &(?Cc) [kwid = "close"] kw
def CLUSTER = &(?Cc) [kwid = "cluster"] kw
def COALESCE = &(?Cc) [kwid = "coalesce"] kw
def COLLATE = &(?Cc) [kwid = "collate"] kw
def COLLATION = &(?Cc) [kwid = "collation"] kw
def COLUMN = &(?Cc) [kwid = "column"] kw
def COLUMNS = &(?Cc) [kwid = "columns"] kw
def COMMENT = &(?Cc) [kwid = "comment"] kw
def COMMIT = &(?Cc) [kwid = "commit"] kw
def COMMITTED = &(?Cc) [kwid = "committed"] kw
def CONCURRENTLY = &(?Cc) [kwid = "concurrently"] kw
def CONDITIONAL = &(?Cc) [kwid = "conditional"] kw
