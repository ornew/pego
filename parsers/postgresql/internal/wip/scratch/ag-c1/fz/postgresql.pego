// The categories of keywords that cannot be names: tests on the lower-case word.
def reserved_word = &(?Aa) w:lcword [$w.V == "all" || $w.V == "analyse" || $w.V == "analyze" || $w.V == "and" || $w.V == "any" || $w.V == "array" || $w.V == "as" || $w.V == "asc" || $w.V == "asymmetric"]
    / &(?Bb) w:lcword [$w.V == "both"]
    / &(?Cc) w:lcword [$w.V == "case" || $w.V == "cast" || $w.V == "check" || $w.V == "collate" || $w.V == "column" || $w.V == "constraint" || $w.V == "create" || $w.V == "current_catalog" || $w.V == "current_date" || $w.V == "current_role" || $w.V == "current_time" || $w.V == "current_timestamp" || $w.V == "current_user"]
    / &(?Dd) w:lcword [$w.V == "default" || $w.V == "deferrable" || $w.V == "desc" || $w.V == "distinct" || $w.V == "do"]
    / &(?Ee) w:lcword [$w.V == "else" || $w.V == "end" || $w.V == "except"]
    / &(?Ff) w:lcword [$w.V == "false" || $w.V == "fetch" || $w.V == "for" || $w.V == "foreign" || $w.V == "from"]
    / &(?Gg) w:lcword [$w.V == "grant" || $w.V == "group"]
    / &(?Hh) w:lcword [$w.V == "having"]
    / &(?Ii) w:lcword [$w.V == "in" || $w.V == "initially" || $w.V == "intersect" || $w.V == "into"]
    / &(?Ll) w:lcword [$w.V == "lateral" || $w.V == "leading" || $w.V == "limit" || $w.V == "localtime" || $w.V == "localtimestamp"]
    / &(?Nn) w:lcword [$w.V == "not" || $w.V == "null"]
    / &(?Oo) w:lcword [$w.V == "offset" || $w.V == "on" || $w.V == "only" || $w.V == "or" || $w.V == "order"]
    / &(?Pp) w:lcword [$w.V == "placing" || $w.V == "primary"]
    / &(?Rr) w:lcword [$w.V == "references" || $w.V == "returning"]
    / &(?Ss) w:lcword [$w.V == "select" || $w.V == "session_user" || $w.V == "some" || $w.V == "symmetric" || $w.V == "system_user"]
    / &(?Tt) w:lcword [$w.V == "table" || $w.V == "then" || $w.V == "to" || $w.V == "trailing" || $w.V == "true"]
    / &(?Uu) w:lcword [$w.V == "union" || $w.V == "unique" || $w.V == "user" || $w.V == "using"]
    / &(?Vv) w:lcword [$w.V == "variadic"]
    / &(?Ww) w:lcword [$w.V == "when" || $w.V == "where" || $w.V == "window" || $w.V == "with"]
def type_func_name_word = &(?Aa) w:lcword [$w.V == "authorization"]
    / &(?Bb) w:lcword [$w.V == "binary"]
    / &(?Cc) w:lcword [$w.V == "collation" || $w.V == "concurrently" || $w.V == "cross" || $w.V == "current_schema"]
    / &(?Ff) w:lcword [$w.V == "freeze" || $w.V == "full"]
    / &(?Ii) w:lcword [$w.V == "ilike" || $w.V == "inner" || $w.V == "is" || $w.V == "isnull"]
    / &(?Jj) w:lcword [$w.V == "join"]
    / &(?Ll) w:lcword [$w.V == "left" || $w.V == "like"]
    / &(?Nn) w:lcword [$w.V == "natural" || $w.V == "notnull"]
    / &(?Oo) w:lcword [$w.V == "outer" || $w.V == "overlaps"]
    / &(?Rr) w:lcword [$w.V == "right"]
    / &(?Ss) w:lcword [$w.V == "similar"]
    / &(?Tt) w:lcword [$w.V == "tablesample"]
    / &(?Vv) w:lcword [$w.V == "verbose"]
def col_name_word = &(?Bb) w:lcword [$w.V == "between" || $w.V == "bigint" || $w.V == "bit" || $w.V == "boolean"]
    / &(?Cc) w:lcword [$w.V == "char" || $w.V == "character" || $w.V == "coalesce"]
    / &(?Dd) w:lcword [$w.V == "dec" || $w.V == "decimal"]
    / &(?Ee) w:lcword [$w.V == "exists" || $w.V == "extract"]
    / &(?Ff) w:lcword [$w.V == "float"]
    / &(?Gg) w:lcword [$w.V == "greatest" || $w.V == "grouping"]
    / &(?Ii) w:lcword [$w.V == "inout" || $w.V == "int" || $w.V == "integer" || $w.V == "interval"]
    / &(?Jj) w:lcword [$w.V == "json" || $w.V == "json_array" || $w.V == "json_arrayagg" || $w.V == "json_exists" || $w.V == "json_object" || $w.V == "json_objectagg" || $w.V == "json_query" || $w.V == "json_scalar" || $w.V == "json_serialize" || $w.V == "json_table" || $w.V == "json_value"]
    / &(?Ll) w:lcword [$w.V == "least"]
    / &(?Mm) w:lcword [$w.V == "merge_action"]
    / &(?Nn) w:lcword [$w.V == "national" || $w.V == "nchar" || $w.V == "none" || $w.V == "normalize" || $w.V == "nullif" || $w.V == "numeric"]
    / &(?Oo) w:lcword [$w.V == "out" || $w.V == "overlay"]
    / &(?Pp) w:lcword [$w.V == "position" || $w.V == "precision"]
    / &(?Rr) w:lcword [$w.V == "real" || $w.V == "row"]
    / &(?Ss) w:lcword [$w.V == "setof" || $w.V == "smallint" || $w.V == "substring"]
    / &(?Tt) w:lcword [$w.V == "time" || $w.V == "timestamp" || $w.V == "treat" || $w.V == "trim"]
    / &(?Vv) w:lcword [$w.V == "values" || $w.V == "varchar"]
    / &(?Xx) w:lcword [$w.V == "xmlattributes" || $w.V == "xmlconcat" || $w.V == "xmlelement" || $w.V == "xmlexists" || $w.V == "xmlforest" || $w.V == "xmlnamespaces" || $w.V == "xmlparse" || $w.V == "xmlpi" || $w.V == "xmlroot" || $w.V == "xmlserialize" || $w.V == "xmltable"]
def label_only_word = &(?Aa) w:lcword [$w.V == "array" || $w.V == "as"]
    / &(?Cc) w:lcword [$w.V == "char" || $w.V == "character" || $w.V == "create"]
    / &(?Dd) w:lcword [$w.V == "day"]
    / &(?Ee) w:lcword [$w.V == "except"]
    / &(?Ff) w:lcword [$w.V == "fetch" || $w.V == "filter" || $w.V == "for" || $w.V == "from"]
    / &(?Gg) w:lcword [$w.V == "grant" || $w.V == "group"]
    / &(?Hh) w:lcword [$w.V == "having" || $w.V == "hour"]
    / &(?Ii) w:lcword [$w.V == "intersect" || $w.V == "into"]
    / &(?Ll) w:lcword [$w.V == "limit"]
    / &(?Mm) w:lcword [$w.V == "minute" || $w.V == "month"]
    / &(?Oo) w:lcword [$w.V == "offset" || $w.V == "on" || $w.V == "order" || $w.V == "over" || $w.V == "overlaps"]
    / &(?Pp) w:lcword [$w.V == "precision"]
    / &(?Rr) w:lcword [$w.V == "returning"]
    / &(?Ss) w:lcword [$w.V == "second"]
    / &(?Tt) w:lcword [$w.V == "to"]
    / &(?Uu) w:lcword [$w.V == "union"]
    / &(?Vv) w:lcword [$w.V == "varying"]
    / &(?Ww) w:lcword [$w.V == "where" || $w.V == "window" || $w.V == "with" || $w.V == "within" || $w.V == "without"]
    / &(?Yy) w:lcword [$w.V == "year"]
def reserved_or_type_func_word = &(?Aa) w:lcword [$w.V == "all" || $w.V == "analyse" || $w.V == "analyze" || $w.V == "and" || $w.V == "any" || $w.V == "array" || $w.V == "as" || $w.V == "asc" || $w.V == "asymmetric" || $w.V == "authorization"]
    / &(?Bb) w:lcword [$w.V == "binary" || $w.V == "both"]
    / &(?Cc) w:lcword [$w.V == "case" || $w.V == "cast" || $w.V == "check" || $w.V == "collate" || $w.V == "collation" || $w.V == "column" || $w.V == "concurrently" || $w.V == "constraint" || $w.V == "create" || $w.V == "cross" || $w.V == "current_catalog" || $w.V == "current_date" || $w.V == "current_role" || $w.V == "current_schema" || $w.V == "current_time" || $w.V == "current_timestamp" || $w.V == "current_user"]
    / &(?Dd) w:lcword [$w.V == "default" || $w.V == "deferrable" || $w.V == "desc" || $w.V == "distinct" || $w.V == "do"]
    / &(?Ee) w:lcword [$w.V == "else" || $w.V == "end" || $w.V == "except"]
    / &(?Ff) w:lcword [$w.V == "false" || $w.V == "fetch" || $w.V == "for" || $w.V == "foreign" || $w.V == "freeze" || $w.V == "from" || $w.V == "full"]
    / &(?Gg) w:lcword [$w.V == "grant" || $w.V == "group"]
    / &(?Hh) w:lcword [$w.V == "having"]
    / &(?Ii) w:lcword [$w.V == "ilike" || $w.V == "in" || $w.V == "initially" || $w.V == "inner" || $w.V == "intersect" || $w.V == "into" || $w.V == "is" || $w.V == "isnull"]
    / &(?Jj) w:lcword [$w.V == "join"]
    / &(?Ll) w:lcword [$w.V == "lateral" || $w.V == "leading" || $w.V == "left" || $w.V == "like" || $w.V == "limit" || $w.V == "localtime" || $w.V == "localtimestamp"]
    / &(?Nn) w:lcword [$w.V == "natural" || $w.V == "not" || $w.V == "notnull" || $w.V == "null"]
    / &(?Oo) w:lcword [$w.V == "offset" || $w.V == "on" || $w.V == "only" || $w.V == "or" || $w.V == "order" || $w.V == "outer" || $w.V == "overlaps"]
    / &(?Pp) w:lcword [$w.V == "placing" || $w.V == "primary"]
    / &(?Rr) w:lcword [$w.V == "references" || $w.V == "returning" || $w.V == "right"]
    / &(?Ss) w:lcword [$w.V == "select" || $w.V == "session_user" || $w.V == "similar" || $w.V == "some" || $w.V == "symmetric" || $w.V == "system_user"]
    / &(?Tt) w:lcword [$w.V == "table" || $w.V == "tablesample" || $w.V == "then" || $w.V == "to" || $w.V == "trailing" || $w.V == "true"]
    / &(?Uu) w:lcword [$w.V == "union" || $w.V == "unique" || $w.V == "user" || $w.V == "using"]
    / &(?Vv) w:lcword [$w.V == "variadic" || $w.V == "verbose"]
    / &(?Ww) w:lcword [$w.V == "when" || $w.V == "where" || $w.V == "window" || $w.V == "with"]
def reserved_or_col_name_word = &(?Aa) w:lcword [$w.V == "all" || $w.V == "analyse" || $w.V == "analyze" || $w.V == "and" || $w.V == "any" || $w.V == "array" || $w.V == "as" || $w.V == "asc" || $w.V == "asymmetric"]
    / &(?Bb) w:lcword [$w.V == "between" || $w.V == "bigint" || $w.V == "bit" || $w.V == "boolean" || $w.V == "both"]
    / &(?Cc) w:lcword [$w.V == "case" || $w.V == "cast" || $w.V == "char" || $w.V == "character" || $w.V == "check" || $w.V == "coalesce" || $w.V == "collate" || $w.V == "column" || $w.V == "constraint" || $w.V == "create" || $w.V == "current_catalog" || $w.V == "current_date" || $w.V == "current_role" || $w.V == "current_time" || $w.V == "current_timestamp" || $w.V == "current_user"]
    / &(?Dd) w:lcword [$w.V == "dec" || $w.V == "decimal" || $w.V == "default" || $w.V == "deferrable" || $w.V == "desc" || $w.V == "distinct" || $w.V == "do"]
    / &(?Ee) w:lcword [$w.V == "else" || $w.V == "end" || $w.V == "except" || $w.V == "exists" || $w.V == "extract"]
    / &(?Ff) w:lcword [$w.V == "false" || $w.V == "fetch" || $w.V == "float" || $w.V == "for" || $w.V == "foreign" || $w.V == "from"]
    / &(?Gg) w:lcword [$w.V == "grant" || $w.V == "greatest" || $w.V == "group" || $w.V == "grouping"]
    / &(?Hh) w:lcword [$w.V == "having"]
    / &(?Ii) w:lcword [$w.V == "in" || $w.V == "initially" || $w.V == "inout" || $w.V == "int" || $w.V == "integer" || $w.V == "intersect" || $w.V == "interval" || $w.V == "into"]
    / &(?Jj) w:lcword [$w.V == "json" || $w.V == "json_array" || $w.V == "json_arrayagg" || $w.V == "json_exists" || $w.V == "json_object" || $w.V == "json_objectagg" || $w.V == "json_query" || $w.V == "json_scalar" || $w.V == "json_serialize" || $w.V == "json_table" || $w.V == "json_value"]
    / &(?Ll) w:lcword [$w.V == "lateral" || $w.V == "leading" || $w.V == "least" || $w.V == "limit" || $w.V == "localtime" || $w.V == "localtimestamp"]
    / &(?Mm) w:lcword [$w.V == "merge_action"]
    / &(?Nn) w:lcword [$w.V == "national" || $w.V == "nchar" || $w.V == "none" || $w.V == "normalize" || $w.V == "not" || $w.V == "null" || $w.V == "nullif" || $w.V == "numeric"]
    / &(?Oo) w:lcword [$w.V == "offset" || $w.V == "on" || $w.V == "only" || $w.V == "or" || $w.V == "order" || $w.V == "out" || $w.V == "overlay"]
    / &(?Pp) w:lcword [$w.V == "placing" || $w.V == "position" || $w.V == "precision" || $w.V == "primary"]
    / &(?Rr) w:lcword [$w.V == "real" || $w.V == "references" || $w.V == "returning" || $w.V == "row"]
