// CUE (The CUE Language Specification), parsed into a typed AST modeled on cuelang.org/go/cue/ast.
//
// The grammar follows the scanner and the parser of cuelang.org/go/cue (v0.17.1), which implement the
// specification, together with the details that only they define; see the README for the differences.
//
// Whitespace and commas. CUE inserts a comma after a line's final token when that token is an identifier,
// keyword, number, string, attribute, bottom, ")", "]", "}", "?" or "..."; a comment acts like a newline.
// Rules do not skip whitespace around themselves; the rule that sequences tokens decides what may follow:
//   - sp skips blanks (no line break) and is used after a token that ends a line with a comma (see above),
//     where the rest of the line decides whether a comma comes;
//   - ws skips everything, comments included, and is used after the other tokens;
//   - comma is a comma: a "," or the one inserted at a line break, a comment or the end of the input.
//     A line break before a "," or ":" inserts nothing, which the rules of "," and ":" say.
// A parenthesized expression, an index and an argument list therefore end on the line of their last token
// (before the closing bracket), as in the reference parser.
//
// Experiments. The attributes @experiment(...) before the package clause change the syntax: the variables
// ex_try, ex_alias and ex_open say which of try (the else and otherwise clauses), aliasv2 (the postfix
// alias, and no prefix aliases) and explicitopen (the postfix "...") are enabled.
package cue

// --- Declarations ---
type File struct { Decls []Decl }
type Package struct { Name Ident }
type ImportDecl struct { Lparen *Match, Specs []ImportSpec }
type ImportSpec struct { Name *Ident, Path String }
type Field struct { Label Label, Alias *PostfixAlias, Constraint *Match, Value Expr, Attrs []Attribute }
type PostfixAlias struct { Label *Ident, Field Ident }
type EmbedDecl struct { Expr Expr }
type LetClause struct { Ident Ident, Expr Expr }
type Ellipsis struct { Type *Expr }
type Comprehension struct { Clauses []Clause, Value StructLit, Fallback *FallbackClause }
type ForClause struct { Key *Ident, Value Ident, Source Expr }
type IfClause struct { Condition Expr }
type TryClause struct { Ident *Ident, Expr *Expr }
type FallbackClause struct { Body StructLit }

// --- Expressions ---
type Ident terminal      // an identifier, or a keyword used as one
type Int terminal
type Float terminal
type String terminal     // a string or bytes literal, with its quotes, hashes and escapes
type Bool terminal
type Null terminal
type Bottom terminal     // _|_
type Attribute terminal  // @name(...)
type Interpolation struct { Elts []Expr }  // String fragments and the expressions between them
type StructLit struct { Elts []Decl }
type ListLit struct { Elts []Expr }
type ParenExpr struct { X Expr }
type SelectorExpr struct { X Expr, Sel Selector }
type IndexExpr struct { X Expr, Index Expr, Rbrack Match }
type SliceExpr struct { X Expr, Low *Expr, High *Expr }
type CallExpr struct { Fun Expr, Args []Expr }
type UnaryExpr struct { Op Match, X Expr }
type BinaryExpr struct { X Expr, Op Match, Y Expr }
type PostfixExpr struct { X Expr, Op Match }
type Alias struct { Ident Ident, Expr Expr }

type StrLit = String | Interpolation
type Number = Int | Float
type Selector = Ident | String
type Label = Ident | String | Interpolation | Bool | Null | ParenExpr | ListLit | Alias
type Decl = Package | Attribute | ImportDecl | Field | EmbedDecl | LetClause | Ellipsis | Comprehension
type Clause = ForClause | IfClause | LetClause | TryClause
type Expr = Ident | Int | Float | String | Bool | Null | Bottom | Interpolation | StructLit | ListLit
    | ParenExpr | SelectorExpr | IndexExpr | SliceExpr | CallExpr | UnaryExpr | BinaryExpr | PostfixExpr
    | Alias | Ellipsis | Comprehension

// ===================================================================
// Source file
// ===================================================================

def main: File = "\u{feff}"? ws
    &(ns:exp_names) [ex_try = foldl(false, $ns, (a, n) => $a || text($n) == "try")]
    [ex_alias = foldl(false, $ns, (a, n) => $a || text($n) == "aliasv2")]
    [ex_open = foldl(false, $ns, (a, n) => $a || text($n) == "explicitopen")]
    as1:(a:attribute sep)* pkg:(p:package_clause sep){0,1} !("package" !idchar) as2:(a:attribute sep)*
    is:(i:import_decl sep)* !("import" !idchar) ds:decls $$
    -> new File{Decls: concat(map($as1, (x) => $x.a), map($pkg, (x) => $x.p), map($as2, (x) => $x.a),
        map($is, (x) => $x.i), $ds)}

// The experiments of the file: the names in the @experiment attributes before the package clause. An
// unknown name, or a list that does not consist of names, is an error.
def exp_names: []Match = xs:(a:exp_item sep)* !"@" -> foldl(list(), $xs, (acc, i) => concat($acc, $i.a))
def exp_item: []Match = exp_attr / plain_attr
def plain_attr: []Match = !"@experiment(" attribute -> list()
def exp_attr: []Match = "@experiment(" l:exp_list? ")" -> concat($l)
def exp_list: []Match = ws first:exp_name rest:(ws "," ws m:exp_name)* ws
    -> concat(list($first), map($rest, (r) => $r.m))
def exp_name = @(("testing" / "accepted_" / "structcmp" / "explicitopen" / "aliasv2" / "try" / "shortcircuit") !idchar)

def package_clause: Package = "package" !idchar sp n:ident
    [!(text($n) >= "#" && text($n) < "$") && !(text($n) >= "_#" && text($n) < "_$")]
    -> new Package{Name: $n}

def import_decl: ImportDecl = import_paren / import_single
def import_paren: ImportDecl = "import" !idchar sp lp:"(" ws ss:(s:import_spec isep)* ")"
    -> new ImportDecl{Lparen: $lp, Specs: map($ss, (x) => $x.s)}
def import_single: ImportDecl = "import" !idchar sp s:import_spec -> new ImportDecl{Specs: list($s)}
def import_spec: ImportSpec = n:import_name? p:import_path -> new ImportSpec{Name: $n, Path: $p}
def import_name: Ident = i:ident sp
    [!(text($i) >= "__" && text($i) < "_\u{60}") && !(text($i) >= "#" && text($i) < "$")
        && !(text($i) >= "_#" && text($i) < "_$")] -> $i
// An import path: a double-quoted string of graphic characters other than the ones that cannot occur in
// a path, with an optional ":" and the name of the package, which is not checked. Escape sequences are
// not accepted.
def import_path: String = import_dq / import_sq
def import_dq: String = "\"" (?^\u{0}-\u{20}!"#$%&'(\)*,:;<=>?[\\\]^\u{60}{|}\u{7f}-\u{a0}\u{ad}\u{fffd}\u{2000}-\u{200f}\u{2028}-\u{202f}\u{205f}-\u{206f}\u{3000}\u{feff})+
    (":" (?^":\\\n\u{0}\u{feff})*)? "\""
def import_sq: String = "'" (?^\u{0}-\u{20}!"#$%&'(\)*,:;<=>?[\\\]^\u{60}{|}\u{7f}-\u{a0}\u{ad}\u{fffd}\u{2000}-\u{200f}\u{2028}-\u{202f}\u{205f}-\u{206f}\u{3000}\u{feff})+
    (":" (?^':\\\n\u{0}\u{feff})*)? "'"
def isep = comma / sp &(")" / "}")

// ===================================================================
// Whitespace, commas
// ===================================================================

def sp = (? \t\r)*
def nlws = (? \t\r\n)*
def ws = ((? \t\r\n)+ / comment)*
def comment = "//" (?^\n\u{0}\u{feff})*
// A comma, explicit or inserted. A line break before an explicit comma inserts nothing.
def comma = sp ("," ws / "\n" nlws "," ws / ("\n" / &"//" / $$) ws)
// A comma that is inserted (inside the parentheses of an interpolation).
def icomma = sp ("\n" / &"//" / $$) ws
// The end of a declaration: a comma, or the closing brace of the struct.
def sep = comma / sp &"}"
// ":" after a token that ends a line (a line break before it inserts no comma) and after "!" (which does not).
def colon_ec = sp ("\n" nlws)? ":" ws
def colon_ne = ws ":" ws
def colon_ahead = sp ("\n" nlws)? ":"

// ===================================================================
// Declarations
// ===================================================================

def decls: []Decl = ds:(d:decl_item)* -> map($ds, (x) => $x.d)
def decl_item: Decl = item_normal / item_tail
def item_normal: Decl = d:decl sep -> $d
// A label followed by a postfix alias or a "?" or "!" (not a field, since no ":" follows) and then a comma,
// a closing brace or the end of the input is an embedding of the label, which the reference parser accepts
// (it drops the rest).
def item_tail: Decl = e:embed_tail -postfix_alias_at? -tail_mark? sep -> $e
def embed_tail: EmbedDecl = l:label_plain
    &(postfix_alias_at (sp "?" after_ec / sp "!" after_ne / after_ec) / sp "?" after_ec / sp "!" after_ne)
    -> new EmbedDecl{Expr: $l}
def after_ec = sp ("," / "}" / "\n" / "//" / $$)
def after_ne = ws ("," / "}" / $$)
def tail_mark = sp "?" / sp "!" ws

def decl: Decl = ellipsis_decl / attribute / let_decl / comprehension / field / embed_decl

def ellipsis_decl: Ellipsis = "..." -> new Ellipsis{}

def let_decl: LetClause = "let" !idchar sp i:ident [!(text($i) >= "__" && text($i) < "_\u{60}")] sp "=" ws e:expr
    -> new LetClause{Ident: $i, Expr: $e}

def embed_decl: EmbedDecl = embed_plain / embed_bare
def embed_plain: EmbedDecl = !kw4 !func_bare e:expr -> new EmbedDecl{Expr: $e}
// for, if and let used as identifiers, where they are not followed by a clause (let: or a closing brace).
def embed_bare: EmbedDecl = k:(bare_for / bare_if / bare_let) -> new EmbedDecl{Expr: $k}
def kw4 = ("for" / "if" / "let" / "try") !idchar
def func_bare = "func" !idchar sp ("," / "\n" / "//" / $$ / "}")
def bare_for: Ident = "for" !idchar &(sp ("," / "\n" / "//" / $$))
def bare_if: Ident = "if" !idchar &(sp ("," / "\n" / "//" / $$))
def bare_let: Ident = "let" !idchar !(sp ident) &(sp ("," / "\n" / "//" / $$ / "}"))

// --- Fields ---
def field: Field = l:label [!(text($l) >= "__" && text($l) < "_\u{60}")] al:postfix_alias_at?
    ( sp c:"?" colon_ec / sp c:"!" colon_ne / colon_ec ) v:field_value as:attrs
    -> new Field{Label: $l, Alias: $al, Constraint: $c, Value: $v, Attrs: $as}
// A field of the chain a: b: c, which declares no more than the labels (a "__" label is only checked
// at the start of the chain).
def nfield: Field = l:label al:postfix_alias_at?
    ( sp c:"?" colon_ec / sp c:"!" colon_ne / colon_ec ) v:field_value as:attrs
    -> new Field{Label: $l, Alias: $al, Constraint: $c, Value: $v, Attrs: $as}
def field_value: Expr = nested / alias_value / expr
def nested: StructLit = f:nfield -> new StructLit{Elts: list($f)}
def alias_value: Alias = [!ex_alias] i:ident_any sp "=" ws e:expr
    [!(text($i) >= "__" && text($i) < "_\u{60}")] -> new Alias{Ident: $i, Expr: $e}
def attrs: []Attribute = as:(sp a:attribute)* -> map($as, (x) => $x.a)

def postfix_alias_at: PostfixAlias = sp p:postfix_alias -> $p
def postfix_alias: PostfixAlias = alias_dual / alias_paren / alias_simple
def alias_dual: PostfixAlias = [ex_alias] "~" ws "(" ws k:ident comma v:ident sp ")" -> new PostfixAlias{Label: $k, Field: $v}
def alias_paren: PostfixAlias = [ex_alias] "~" ws "(" ws f:ident sp ")" -> new PostfixAlias{Field: $f}
def alias_simple: PostfixAlias = [ex_alias] "~" ws f:ident -> new PostfixAlias{Field: $f}

// --- Labels ---
def label: Label = alias_label / label_plain
def label_plain: Label = ident_label / strlit / bool_lit / null_lit / paren_expr / pattern_list
def ident_label: Ident = ident / kw_label
def kw_label: Ident = ("in" / "else" / "fallback" / "otherwise" / "func") !idchar / for_label / if_label / let_label
def for_label: Ident = "for" !idchar &(sp (":" / "=" !(?=~) / "?" / "!" !(?=~) / "," / "\n" / "//" / $$))
def if_label: Ident = "if" !idchar &(sp (":" / "=" !(?=~) / "?" / "," / "\n" / "//" / $$ / "!" ws ":"))
def let_label: Ident = "let" !idchar !(sp ident)
def alias_label: Alias = [!ex_alias] i:ident_label sp "=" ws r:alias_rhs
    [!(text($i) >= "__" && text($i) < "_\u{60}")] -> new Alias{Ident: $i, Expr: $r}
def alias_rhs: Expr = ident_any / strlit / number / bool_lit / null_lit / paren_expr / list_lit
def ident_any: Ident = ident / kwident / bool_ident
def bool_ident: Ident = ("true" / "false" / "null") !idchar
// A pattern constraint: a list of exactly one element.
def pattern_list: ListLit = pattern_list_e / pattern_list_d
def pattern_list_e: ListLit = "[" ws e:list_elem (comma / sp) "]" -> new ListLit{Elts: list($e)}
def pattern_list_d: ListLit = "[" ws d:list_dots (comma / sp) "]" -> new ListLit{Elts: list($d)}

// --- Comprehensions ---
// A comprehension with a single if or try clause takes else; one with other clauses takes otherwise.
def comprehension: Comprehension = comp_single / comp_multi
def comp_single: Comprehension = !gate_for_if c:(if_clause / try_clause) clause_gap v:struct_lit f:fb_else?
    -> new Comprehension{Clauses: list($c), Value: $v, Fallback: $f}
def comp_multi: Comprehension = first:start_clause rest:(clause_gap c:clause)* clause_gap v:struct_lit f:fb_other?
    -> new Comprehension{Clauses: concat(list($first), map($rest, (x) => $x.c)), Value: $v, Fallback: $f}
def fb_else: FallbackClause = sp f:else_clause -> $f
def fb_other: FallbackClause = sp f:otherwise_clause -> $f
def else_clause: FallbackClause = [ex_try] "else" !idchar sp b:struct_lit -> new FallbackClause{Body: $b}
def otherwise_clause: FallbackClause = [ex_try] ("otherwise" / "fallback") !idchar sp b:struct_lit
    -> new FallbackClause{Body: $b}
def clause_gap = comma / sp
// for and if start a comprehension unless the next token makes them identifiers.
def gate_for_if = "for" !idchar &(sp (":" / "=" !(?=~) / "?" / "!" !(?=~) / "," / "\n" / "//" / $$))
    / "if" !idchar &(sp (":" / "=" !(?=~) / "?" / "," / "\n" / "//" / $$ / "!" ws ":"))
def start_clause: Clause = !gate_for_if c:(for_clause / if_clause / try_clause) -> $c
def clause: Clause = for_clause / if_clause / let_decl / try_clause
def for_clause: ForClause = for_kv / for_v
def for_kv: ForClause = "for" !idchar sp k:ident [!(text($k) >= "__" && text($k) < "_\u{60}")] comma
    v:ident [!(text($v) >= "__" && text($v) < "_\u{60}")] sp "in" !idchar sp s:expr
    -> new ForClause{Key: $k, Value: $v, Source: $s}
def for_v: ForClause = "for" !idchar sp v:ident [!(text($v) >= "__" && text($v) < "_\u{60}")] sp "in" !idchar sp s:expr
    -> new ForClause{Value: $v, Source: $s}
def if_clause: IfClause = "if" !idchar sp c:expr -> new IfClause{Condition: $c}
def try_clause: TryClause = try_assign / try_plain
def try_assign: TryClause = "try" !idchar sp i:ident sp "=" ws e:expr -> new TryClause{Ident: $i, Expr: $e}
def try_plain: TryClause = "try" !idchar -> new TryClause{}

// ===================================================================
// Expressions
// ===================================================================

def struct_lit: StructLit = "{" ws ds:decls "}" -> new StructLit{Elts: $ds}

def list_lit: ListLit = "[" ws es:(e:list_elem esep)* d:(x:list_dots esep){0,1} "]"
    -> new ListLit{Elts: concat(map($es, (x) => $x.e), map($d, (x) => $x.x))}
def esep = comma / sp &"]"
def list_elem: Expr = comprehension / alias_elem / elem_expr / bare_for_if
def elem_expr: Expr = !gate_kw3 e:expr -> $e
def gate_kw3 = ("for" / "if" / "try") !idchar
def bare_for_if: Ident = "for" !idchar &(sp (":" / "=" !(?=~) / "?" / "!" !(?=~) / "," / "\n" / "//" / $$))
    / "if" !idchar &(sp (":" / "=" !(?=~) / "?" / "," / "\n" / "//" / $$ / "!" ws ":"))
def alias_elem: Alias = [!ex_alias] i:(ident / kwident / bool_ident / bare_for_if) sp "=" ws e:expr
    [!(text($i) >= "__" && text($i) < "_\u{60}")] -> new Alias{Ident: $i, Expr: $e}
def list_dots: Ellipsis = "..." t:dots_type? -> new Ellipsis{Type: $t}
def dots_type: Expr = sp x:expr -> $x

def paren_expr: ParenExpr = "(" ws e:expr sp ")" -> new ParenExpr{X: $e}

def expr: Expr = pratt {
    skip sp
    operand bottom
    operand i:ident sp q:"?" !colon_ahead -> new PostfixExpr{X: $i, Op: $q}
    operand ident
    operand number
    operand struct_lit
    operand list_lit
    operand strlit
    operand paren_expr
    operand bool_lit
    operand null_lit
    operand kwident

    level { infix left o:"|" ws -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { infix left o:"&" ws -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { infix left o:"||" ws -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { infix left o:"&&" ws -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { infix left o:@("==" / "!=" / "=~" / "!~" / "<=" / ">=" / "<" !"-" / ">") ws
        -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { infix left o:("+" / "-") ws -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { infix left o:@("*" / "/" !"/") ws -> new BinaryExpr{X: $lhs, Op: $o, Y: $rhs} }
    level { prefix &(?+\-!*<>=) o:@("+" / "-" / "!=" / "!~" / "!" / "*" / "<=" / ">=" / "<" !"-" / ">" / "=~" / "==") ws
        -> new UnaryExpr{Op: $o, X: $rhs} }
    level {
        postfix "." ws s:selector sp q:"?" -> new PostfixExpr{X: new SelectorExpr{X: $lhs, Sel: $s}, Op: $q}
        postfix "." ws s:selector -> new SelectorExpr{X: $lhs, Sel: $s}
        postfix "[" ws i:expr (comma / sp) r:"]" sp q:"?" -> new PostfixExpr{X: new IndexExpr{X: $lhs, Index: $i, Rbrack: $r}, Op: $q}
        postfix "[" ws i:expr (comma / sp) r:"]" -> new IndexExpr{X: $lhs, Index: $i, Rbrack: $r}
        postfix "[" ws lo:expr? colon_ec hi:expr? sp "]" -> new SliceExpr{X: $lhs, Low: $lo, High: $hi}
        postfix "(" ws as:(a:expr asep)* ")" -> new CallExpr{Fun: $lhs, Args: map($as, (x) => $x.a)}
        postfix [ex_open] o:"..." -> new PostfixExpr{X: $lhs, Op: $o}
    }
}
def asep = comma / sp &")"
def selector: Selector = ident / kwident / bool_ident_sel / sel_string
def bool_ident_sel: Ident = ("true" / "false" / "null") !idchar
def sel_string: String = !"\"\"" "\"" dqbody "\""
// An expression inside the parentheses of an interpolation: it may be followed by an inserted comma.
def interp_expr: Expr = ws e:expr (icomma / sp) &")" -> $e

// ===================================================================
// Attributes
// ===================================================================

def attribute: Attribute = "@" idchars sp "(" attr_body ")"
def attr_body = ((? \t\r\n)+ / comment / attr_group / attr_tok)*
def attr_group = "(" attr_body ")" / "[" attr_body "]" / "{" attr_body "}"
def attr_tok = attr_str / number !"_" / "_|_" / ident_text / attribute / "..." / "." !"." / (?:;?~+\-*/<>=!&|,)
def attr_str = dq_plain / sq_plain / gstr_plain

// ===================================================================
// Identifiers and keywords
// ===================================================================

def idchar = (?a-zA-Z0-9_$) / uidchar
def uidchar = !(?\u{0}-\u{7f}) (uletter / udigit)
def idchars = (?a-zA-Z0-9_$)* (uidchar (?a-zA-Z0-9_$)*)*
def idstart = (?a-zA-Z$) / !(?\u{0}-\u{7f}) uletter
def digit_any = (?0-9) / !(?\u{0}-\u{7f}) udigit
// An identifier is a letter, "$" or "_", then letters, digits, "_" and "$", with an optional "#" or "_#"
// before it; "#" followed by a digit is an identifier of its own.
def ident_text = "#" hashrest / "_" ("#" hashrest / !"_#" idchars) / idstart idchars
def hashrest = &digit_any / idchar+ / !(?"'#)
def ident: Ident = !kw ident_text
def kw = ("if" / "else" / "for" / "in" / "let" / "try" / "fallback" / "otherwise" / "func" / "true" / "false" / "null") !idchar
// The keywords that are not values, used as identifiers.
def kwident: Ident = ("if" / "else" / "for" / "in" / "let" / "try" / "fallback" / "otherwise" / "func") !idchar
def bool_lit: Bool = ("true" / "false") !idchar
def null_lit: Null = "null" !idchar
def bottom: Bottom = "_|_"

// ===================================================================
// Numbers
// ===================================================================

def number: Number = based / float_lit / int_lit
def hexd = (?0-9a-fA-F)
def based: Int = "0" ((?xX) "_"? hexd ("_"? hexd)* / "b" "_"? (?01) ("_"? (?01))* / "o" "_"? (?0-7) ("_"? (?0-7))*)
def d10 = (?0-9) ("_"? (?0-9))*
def dec_ip = (?1-9) ("_"? (?0-9))*
def fracpart = "." !"." ("_"? (?0-9) ("_"? (?0-9))*)?
def exppart = (?eE) (?+\-)? "_"? (?0-9) ("_"? (?0-9))*
def mult = (?KMGTP) "i"?
def float_lit: Float = (dec_ip / "0" d10?) (fracpart (exppart / !mult) / exppart) / "." d10 (exppart / !mult)
def int_lit: Int = (dec_ip / "0") (fracpart mult / mult)? / "." d10 mult

// ===================================================================
// Strings
// ===================================================================

def strlit: StrLit = &(?"'#) s:str_any -> $s
def str_any: StrLit = dq_plain / dq_interp / sq_plain / sq_interp / gstring
def hexd4 = hexd hexd hexd hexd
def bigu = "000" hexd hexd hexd hexd hexd / "0010" hexd hexd hexd hexd
def esc_dq = (?abfnrtv\\/") / "u" hexd4 / "U" bigu
def esc_sq = (?abfnrtv\\/') / "u" hexd4 / "U" bigu / "x" hexd hexd / (?0-3) (?0-7) (?0-7)

// "..." without hashes on a single line.
def dqbody = ((?^"\\\n\u{0}\u{feff})+ / "\\" esc_dq)*
def dq_plain: String = !"\"\"\"" "\"" dqbody "\""
def dq_open: String = !"\"\"\"" "\"" dqbody "\\("
def dq_mid: String = ")" dqbody "\\("
def dq_end: String = ")" dqbody "\""
def dq_interp: Interpolation = f:dq_open t:dq_rest -> new Interpolation{Elts: concat(list($f), $t)}
def dq_rest: []Expr = dq_more / dq_last
def dq_more: []Expr = e:interp_expr m:dq_mid t:dq_rest -> concat(list($e, $m), $t)
def dq_last: []Expr = e:interp_expr z:dq_end -> list($e, $z)

// '...' without hashes on a single line.
def sqbody = ((?^'\\\n\u{0}\u{feff})+ / "\\" esc_sq)*
def sq_plain: String = !"'''" "'" sqbody "'"
def sq_open: String = !"'''" "'" sqbody "\\("
def sq_mid: String = ")" sqbody "\\("
def sq_end: String = ")" sqbody "'"
def sq_interp: Interpolation = f:sq_open t:sq_rest -> new Interpolation{Elts: concat(list($f), $t)}
def sq_rest: []Expr = sq_more / sq_last
def sq_more: []Expr = e:interp_expr m:sq_mid t:sq_rest -> concat(list($e, $m), $t)
def sq_last: []Expr = e:interp_expr z:sq_end -> list($e, $z)

// The other strings: those with hashes, and the multi-line ones. They read the variables nh, the number of
// hashes, and qs, the quote character (" or '), which the rule of the string defines; k counts hashes down.
// A closing quote is followed by the hashes; an escape is a backslash followed by as many hashes (fewer
// and the backslash is an ordinary character), and a multi-line string closes at a quote of its own on a
// line of its own, whose indentation must be a prefix of the indentation of every other line that is not empty.
def gstring: StrLit = gtriple / gml_plain / gml_interp / gsl_plain / gsl_interp
def qc = c:@(?"') [text($c) == qs]
def hx = [k > 0] "#" [k = k - 1] hx / [k == 0]
def hashes = [k = nh] hx
def g_escbody = [qs == "\""] esc_dq / [qs == "'"] esc_sq
def gs_esc = "\\" h:@"#"* ([len($h) < nh] / [len($h) == nh] g_escbody)
def g_interp_open = "\\" h:@"#"* [len($h) == nh] "("
def g_interp_skip = g_interp_open ws expr (icomma / sp) ")"
def ml_nl = "\n" / "\r\n"
def ml_close_tail = qc qc qc hashes

// #"""#: a single quote between triple quotes and hashes.
def gtriple: String = hs:@"#"+ [nh = len($hs)] qo:@(?"') [qs = text($qo)] qc qc hashes

// On a single line.
def gs_body = ((?^\n\\\u{0}\u{feff}"')+ / gs_quote / gs_esc)*
def gs_quote = c:@(?"') ([text($c) != qs] / [text($c) == qs] &(h:@"#"* [len($h) < nh]))
def gsl_plain: String = hs:@"#"* [nh = len($hs)] qo:@(?"') [qs = text($qo)] !(qc qc) gs_body qc hashes
def gsl_open: String = "#"* (?"') !(qc qc) gs_body g_interp_open
def gsl_mid: String = ")" gs_body g_interp_open
def gsl_end: String = ")" gs_body qc hashes
def gsl_interp: Interpolation = &(hs:@"#"* qo:@(?"')) [nh = len($hs)] [qs = text($qo)] f:gsl_open t:gsl_rest
    -> new Interpolation{Elts: concat(list($f), $t)}
def gsl_rest: []Expr = gsl_more / gsl_last
def gsl_more: []Expr = e:interp_expr m:gsl_mid t:gsl_rest -> concat(list($e, $m), $t)
def gsl_last: []Expr = e:interp_expr z:gsl_end -> list($e, $z)

// On several lines.
def ml_body = ((?^\n\\\u{0}\u{feff})+ / gs_esc)*
def ml_body_i = ((?^\n\\\u{0}\u{feff})+ / g_interp_skip / gs_esc)*
def ml_line = lead:@(? \t)* !ml_close_tail body:@ml_body "\n"
def ml_line_i = lead:@(? \t)* !ml_close_tail body:@ml_body_i "\n"
def ml_close: Match = c:@(? \t)* qc qc qc hashes -> $c
def gml_plain: String = hs:@"#"* [nh = len($hs)] qo:@(?"') [qs = text($qo)] qc qc ml_nl ls:ml_line* cw:ml_close
    [foldl(true, $ls, (a, l) => $a && (len($l.lead) == 0 && len($l.body) == 0
        || text($l.lead) >= text($cw) && text($l.lead) < text($cw) + "\u{10ffff}"))]
def gml_check: Match = "#"* (?"') qc qc ml_nl ls:ml_line_i* cw:ml_close
    [foldl(true, $ls, (a, l) => $a && (len($l.lead) == 0 && len($l.body) == 0
        || text($l.lead) >= text($cw) && text($l.lead) < text($cw) + "\u{10ffff}"))] -> $cw
def ml_frag = ((?^\n\\\u{0}\u{feff})+ / gs_esc / "\n" (? \t)* !ml_close_tail)*
def gml_open: String = "#"* (?"') qc qc ml_nl (? \t)* !ml_close_tail ml_frag g_interp_open
def gml_mid: String = ")" ml_frag g_interp_open
def gml_end: String = ")" ml_frag "\n" (? \t)* ml_close_tail
def gml_interp: Interpolation = &(hs:@"#"* qo:@(?"')) [nh = len($hs)] [qs = text($qo)] &gml_check f:gml_open t:gml_rest
    -> new Interpolation{Elts: concat(list($f), $t)}
def gml_rest: []Expr = gml_more / gml_last
def gml_more: []Expr = e:interp_expr m:gml_mid t:gml_rest -> concat(list($e, $m), $t)
def gml_last: []Expr = e:interp_expr z:gml_end -> list($e, $z)
def gstr_plain: String = gtriple / gml_plain / gsl_plain

// ===================================================================
// Unicode letters and digits above ASCII (see internal/unitab)
// ===================================================================
