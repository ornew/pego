// TypeScript 5.9 (and the ECMAScript 2025 it includes) as the TypeScript 5.9 compiler's parser accepts it,
// parsed into a typed AST modeled on the compiler's: each type is named after the SyntaxKind of its node.
// The start rule main parses a .ts file, or a .tsx file (JSX instead of <T>x type assertions) when the input
// starts with the character NUL (U+0000), which no TypeScript file can start with: the Go package prepends it
// for ParseTSX and moves the positions back, so that one generated parser serves both. After it, U+0001 parses
// the top level in the await context, as the compiler reparses the statements of a module that contain await
// (ParseFile does it for modules).
//
// The grammar follows the compiler's parser (src/compiler/parser.ts) function by function, so that it
// accepts what the parser accepts without a syntactic diagnostic: it is as lenient as the parser is (most
// "grammar errors" are reported by the checker and are not syntax errors here), and it decides the
// ambiguities the way the parser does (arrow functions, type arguments in expressions, <T>x and JSX,
// contextual keywords, automatic semicolon insertion).
//
// Whitespace. Rules do not skip whitespace around themselves, so that every node spans exactly its tokens;
// the caller skips what may come before. ws skips any whitespace and comments; sp skips them without
// crossing a line terminator (a /* */ comment containing one counts as a line terminator). Where the
// compiler checks scanner.hasPrecedingLineBreak() (ASI, restricted productions, contextual keywords), the
// grammar uses sp, or nl to test for a line break before the next token.
//
// Context. The parser's context flags are kept in one int variable, ctx, as a set of bits:
//     1 yield context, 2 await context, 4 disallow `in`, 8 decorator context,
//     16 no return type on arrow functions (allowReturnTypeInArrowFunction = false),
//     32 disallow conditional types, 64 JSX (a .tsx file).
// One variable rather than seven: rules that read variables are memoized per value, and each read and
// definition walks the variable environment, so a single variable keeps both cheap.
// Tests are written [ctx / 4 % 2 == 1] (bit 4 set); a bit b is cleared with ctx - ctx / b % 2 * b.
//
// Performance. The grammar follows the compiler's order of alternatives, which tries what is rare before what is
// common, and a rule that fails at once still costs a call and records what it expected. What paid, measured
// as rule calls (pego profile) and as time on the benchmarks of the package (see the README):
//   - A silent lookahead of the next character in front of an alternative or an operator (&(?...)), which
//     records no expectation: the operators of binaryExpression and the postfix operators of the
//     left-hand side, whose Operators Rule loops try every operator after every operand; the ws and sp rules, which
//     are called twice a token; the modifiers, the unary operators and the update expressions.
//   - Dispatch by the first character or word: primaryExpression and nonArrayType try identifiers and type
//     references first (they are the most common, and cannot be mistaken for a keyword); the statements that
//     start with a keyword, a brace, ";" or "@" are apart from expression statements; assignmentExpressionInner
//     tests for each of its alternatives; reservedWord tests the first letter.
//   - One parse where the compiler's order parsed twice and relied on the memo: a union, an intersection or a
//     conditional type, and a conditional expression, are a fold over the optional tail of their first operand
//     (the same for ++ and --) instead of an alternative that parses the operand, fails and parses it again.
//   - No rule call per character of an identifier (identifierRest).
// Together they take the rule calls on 300 KB of the TypeScript compiler's own JavaScript from 1.66 M to 0.59 M,
// and the parse time of lib.dom.d.ts and of the compiler to about half.
// What did not pay: ws and sp matching one character at a time inside a lookahead, and ordering the alternatives
// of statement by frequency.
// The #error labels of primaryExpression and nonArrayType replace the long lists of tokens the silent tests no
// longer record by "expected an expression" and "expected a type"; they cost nothing measurable.
package typescript

// ===================================================================
// Types
// ===================================================================

// --- Terminals ---
type Identifier = { Text string }
type PrivateIdentifier = { Text string }
type Token = { Text string }           // a punctuation or keyword token (QuestionToken, PlusToken, ...)
type Modifier = { Text string }        // a modifier keyword (ExportKeyword, ...)
type KeywordTypeNode = { Text string } // any, number, void, ... (AnyKeyword, NumberKeyword, ...)
type ThisTypeNode = { Text string }    // this as a type (ThisType)
type NumericLiteral = { Text string }
type BigIntLiteral = { Text string }
type StringLiteral = { Text string } // with its quotes
type RegularExpressionLiteral = { Text string }
type NoSubstitutionTemplateLiteral = { Text string } // with its backquotes
type TemplateHead = { Text string }                  // from ` to ${
type TemplateMiddle = { Text string }                // from } to ${
type TemplateTail = { Text string }                  // from } to `
type ThisExpression = { Text string }                // ThisKeyword
type SuperExpression = { Text string }               // SuperKeyword
type NullLiteral = { Text string }                   // NullKeyword
type BooleanLiteral = { Text string }                // TrueKeyword or FalseKeyword
type ImportExpression = { Text string }              // ImportKeyword, the callee of import(...)
type OmittedExpression = { Text string }             // an empty slot of an array literal or pattern
type JsxText = { Text string }
type JsxOpeningFragment = { Text string }
type JsxClosingFragment = { Text string }
type EmptyStatement = { Text string }
type DebuggerStatement = { Text string }
type SemicolonClassElement = { Text string }
type EndOfFileToken = { Text string }
type JSDocAllType = { Text string }
type JSDocUnknownType = { Text string }

// --- Names ---
type QualifiedName = { Left EntityName; Right Identifier }
type ComputedPropertyName = { Expression Expression }

// --- Signature elements ---
type TypeParameter = {
    Modifiers  []ModifierLike
    Name       Identifier
    Constraint *TypeNode
    Default    *TypeNode
    Expression *Expression // a constraint that is an expression (extends +1), which the checker reports
}
type Parameter = {
    Modifiers      []ModifierLike
    DotDotDotToken *Token
    Name           *BindingName
    QuestionToken  *Token // Name is nil only in JSDoc function types
    Type           *TypeNode
    Initializer    *Expression
}
type Decorator = { Expression Expression }

// --- Type members ---
type PropertySignature = {
    Modifiers     []ModifierLike
    Name          PropertyName
    QuestionToken *Token
    Type          *TypeNode
    Initializer   *Expression
}
type MethodSignature = {
    Modifiers      []ModifierLike
    Name           PropertyName
    QuestionToken  *Token
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           *TypeNode
}
type CallSignature = { TypeParameters []TypeParameter; Parameters []Parameter; Type *TypeNode }
type ConstructSignature = { TypeParameters []TypeParameter; Parameters []Parameter; Type *TypeNode }
type IndexSignature = { Modifiers []ModifierLike; Parameters []Parameter; Type *TypeNode }

// --- Class members ---
type PropertyDeclaration = {
    Modifiers        []ModifierLike
    Name             PropertyName
    QuestionToken    *Token
    ExclamationToken *Token
    Type             *TypeNode
    Initializer      *Expression
}
type MethodDeclaration = {
    Modifiers        []ModifierLike
    AsteriskToken    *Token
    Name             PropertyName
    QuestionToken    *Token
    ExclamationToken *Token
    TypeParameters   []TypeParameter
    Parameters       []Parameter
    Type             *TypeNode
    Body             *Block
}
type ClassStaticBlockDeclaration = { Modifiers []ModifierLike; Body Block }
type Constructor = {
    Modifiers      []ModifierLike
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           *TypeNode
    Body           *Block
}
type GetAccessor = {
    Modifiers      []ModifierLike
    Name           PropertyName
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           *TypeNode
    Body           *Block
}
type SetAccessor = {
    Modifiers      []ModifierLike
    Name           PropertyName
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           *TypeNode
    Body           *Block
}

// --- Types ---
type TypePredicate = { AssertsModifier *Token; ParameterName TypePredicateParameterName; Type *TypeNode }
type TypeReference = { TypeName EntityName; TypeArguments []TypeNode }
type FunctionType = { TypeParameters []TypeParameter; Parameters []Parameter; Type TypeNode }
type ConstructorType = {
    Modifiers      []ModifierLike
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           TypeNode
}
type TypeQuery = { ExprName EntityName; TypeArguments []TypeNode }
type TypeLiteral = { Members []TypeElement }
type ArrayType = { ElementType TypeNode }
type TupleType = { Elements []TypeNode }
type OptionalType = { Type TypeNode }
type RestType = { Type TypeNode }
type UnionType = { Types []TypeNode }
type IntersectionType = { Types []TypeNode }
type ConditionalType = { CheckType TypeNode; ExtendsType TypeNode; TrueType TypeNode; FalseType TypeNode }
type InferType = { TypeParameter TypeParameter }
type ParenthesizedType = { Type TypeNode }
type TypeOperator = { Operator string; Type TypeNode } // Operator is keyof, unique or readonly
type IndexedAccessType = { ObjectType TypeNode; IndexType TypeNode }
type MappedType = {
    ReadonlyToken *Token
    TypeParameter TypeParameter
    NameType      *TypeNode
    QuestionToken *Token
    Type          *TypeNode
    Members       []TypeElement
}
type LiteralType = { Literal LiteralTypeLiteral }
type NamedTupleMember = { DotDotDotToken *Token; Name Identifier; QuestionToken *Token; Type TypeNode }
type TemplateLiteralType = { Head TemplateHead; TemplateSpans []TemplateLiteralTypeSpan }
type TemplateLiteralTypeSpan = { Type TypeNode; Literal TemplateMiddleOrTail }
type ImportType = {
    Argument      TypeNode
    Attributes    *ImportAttributes
    Qualifier     *EntityName
    TypeArguments []TypeNode
    IsTypeOf      bool
}
type JSDocNullableType = { Type TypeNode; Postfix bool }
type JSDocNonNullableType = { Type TypeNode; Postfix bool }
type JSDocFunctionType = { Parameters []Parameter; Type *TypeNode }

// --- Binding patterns ---
type ObjectBindingPattern = { Elements []BindingElement }
type ArrayBindingPattern = { Elements []ArrayBindingElement }
type BindingElement = {
    DotDotDotToken *Token
    PropertyName   *PropertyName
    Name           BindingName
    Initializer    *Expression
}

// --- Expressions ---
type ArrayLiteralExpression = { Elements []Expression }
type ObjectLiteralExpression = { Properties []ObjectLiteralElement }
type PropertyAssignment = {
    Modifiers        []ModifierLike
    Name             PropertyName
    QuestionToken    *Token
    ExclamationToken *Token
    Initializer      Expression
}
type ShorthandPropertyAssignment = {
    Modifiers                   []ModifierLike
    Name                        Identifier
    QuestionToken               *Token
    ExclamationToken            *Token
    EqualsToken                 *Token
    ObjectAssignmentInitializer *Expression
}
type SpreadAssignment = { Expression Expression }
type PropertyAccessExpression = { Expression Expression; QuestionDotToken *Token; Name MemberName }
type ElementAccessExpression = { Expression Expression; QuestionDotToken *Token; ArgumentExpression Expression }
type CallExpression = {
    Expression       Expression
    QuestionDotToken *Token
    TypeArguments    []TypeNode
    Arguments        []Expression
}
type NewExpression = { Expression Expression; TypeArguments []TypeNode; Arguments *[]Expression } // Arguments is nil without parentheses
type TaggedTemplateExpression = {
    Tag              Expression
    QuestionDotToken *Token
    TypeArguments    []TypeNode
    Template         TemplateLiteral
}
type TypeAssertionExpression = { Type TypeNode; Expression Expression }
type ParenthesizedExpression = { Expression Expression }
type FunctionExpression = {
    Modifiers      []ModifierLike
    AsteriskToken  *Token
    Name           *Identifier
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           *TypeNode
    Body           Block
}
type ArrowFunction = {
    Modifiers              []ModifierLike
    TypeParameters         []TypeParameter
    Parameters             []Parameter
    Type                   *TypeNode
    EqualsGreaterThanToken Token
    Body                   ConciseBody
}
type DeleteExpression = { Expression Expression }
type TypeOfExpression = { Expression Expression }
type VoidExpression = { Expression Expression }
type AwaitExpression = { Expression Expression }
type PrefixUnaryExpression = { Operator string; Operand Expression }
type PostfixUnaryExpression = { Operand Expression; Operator string }
type BinaryExpression = { Left Expression; OperatorToken Token; Right Expression }
type ConditionalExpression = {
    Condition     Expression
    QuestionToken Token
    WhenTrue      Expression
    ColonToken    Token
    WhenFalse     Expression
}
type TemplateExpression = { Head TemplateHead; TemplateSpans []TemplateSpan }
type TemplateSpan = { Expression Expression; Literal TemplateMiddleOrTail }
type YieldExpression = { AsteriskToken *Token; Expression *Expression }
type SpreadElement = { Expression Expression }
type ClassExpression = {
    Modifiers       []ModifierLike
    Name            *Identifier
    TypeParameters  []TypeParameter
    HeritageClauses []HeritageClause
    Members         []ClassElement
}
type ExpressionWithTypeArguments = { Expression Expression; TypeArguments []TypeNode }
type AsExpression = { Expression Expression; Type TypeNode }
type SatisfiesExpression = { Expression Expression; Type TypeNode }
type NonNullExpression = { Expression Expression }
type MetaProperty = { KeywordToken string; Name Identifier } // KeywordToken is new or import

// --- JSX ---
type JsxElement = { OpeningElement JsxOpeningElement; Children []JsxChild; ClosingElement JsxClosingElement }
type JsxSelfClosingElement = { TagName JsxTagName; TypeArguments []TypeNode; Attributes JsxAttributes }
type JsxOpeningElement = { TagName JsxTagName; TypeArguments []TypeNode; Attributes JsxAttributes }
type JsxClosingElement = { TagName JsxTagName }
type JsxFragment = {
    OpeningFragment JsxOpeningFragment
    Children        []JsxChild
    ClosingFragment JsxClosingFragment
}
type JsxAttributes = { Properties []JsxAttributeLike }
type JsxAttribute = { Name JsxAttributeName; Initializer *JsxAttributeValue }
type JsxSpreadAttribute = { Expression Expression }
type JsxExpression = { DotDotDotToken *Token; Expression *Expression }
type JsxNamespacedName = { Namespace Identifier; Name Identifier }

// --- Statements ---
type SourceFile = { Statements []Statement; EndOfFileToken EndOfFileToken }
type Block = { Statements []Statement }
type VariableStatement = { Modifiers []ModifierLike; DeclarationList VariableDeclarationList }
type VariableDeclarationList = { Keyword string; Declarations []VariableDeclaration } // var, let, const, using or await using
type VariableDeclaration = {
    Name             BindingName
    ExclamationToken *Token
    Type             *TypeNode
    Initializer      *Expression
}
type ExpressionStatement = { Expression Expression }
type IfStatement = { Expression Expression; ThenStatement Statement; ElseStatement *Statement }
type DoStatement = { Statement Statement; Expression Expression }
type WhileStatement = { Expression Expression; Statement Statement }
type ForStatement = {
    Initializer *ForInitializer
    Condition   *Expression
    Incrementor *Expression
    Statement   Statement
}
type ForInStatement = { Initializer ForInitializer; Expression Expression; Statement Statement }
type ForOfStatement = {
    AwaitModifier *Token
    Initializer   ForInitializer
    Expression    Expression
    Statement     Statement
}
type ContinueStatement = { Label *Identifier }
type BreakStatement = { Label *Identifier }
type ReturnStatement = { Expression *Expression }
type WithStatement = { Expression Expression; Statement Statement }
type SwitchStatement = { Expression Expression; CaseBlock CaseBlock }
type CaseBlock = { Clauses []CaseOrDefaultClause }
type CaseClause = { Expression Expression; Statements []Statement }
type DefaultClause = { Statements []Statement }
type LabeledStatement = { Label Identifier; Statement Statement }
type ThrowStatement = { Expression Expression }
type TryStatement = { TryBlock Block; CatchClause *CatchClause; FinallyBlock *Block }
type CatchClause = { VariableDeclaration *VariableDeclaration; Block Block }

// --- Declarations ---
type FunctionDeclaration = {
    Modifiers      []ModifierLike
    AsteriskToken  *Token
    Name           *Identifier
    TypeParameters []TypeParameter
    Parameters     []Parameter
    Type           *TypeNode
    Body           *Block
}
type ClassDeclaration = {
    Modifiers       []ModifierLike
    Name            *Identifier
    TypeParameters  []TypeParameter
    HeritageClauses []HeritageClause
    Members         []ClassElement
}
type HeritageClause = { Token string; Types []ExpressionWithTypeArguments } // Token is extends or implements
type InterfaceDeclaration = {
    Modifiers       []ModifierLike
    Name            Identifier
    TypeParameters  []TypeParameter
    HeritageClauses []HeritageClause
    Members         []TypeElement
}
type TypeAliasDeclaration = {
    Modifiers      []ModifierLike
    Name           Identifier
    TypeParameters []TypeParameter
    Type           TypeNode
}
type EnumDeclaration = { Modifiers []ModifierLike; Name Identifier; Members []EnumMember }
type EnumMember = { Name PropertyName; Initializer *Expression }
type ModuleDeclaration = { Modifiers []ModifierLike; Name ModuleName; Body *ModuleBody }
type ModuleBlock = { Statements []Statement }
type NamespaceExportDeclaration = { Modifiers []ModifierLike; Name Identifier }
type ImportEqualsDeclaration = {
    Modifiers       []ModifierLike
    Name            Identifier
    ModuleReference ModuleReference
    IsTypeOnly      bool
}
type ExternalModuleReference = { Expression Expression }
type ImportDeclaration = {
    Modifiers       []ModifierLike
    ImportClause    *ImportClause
    ModuleSpecifier Expression
    Attributes      *ImportAttributes
}
type ImportClause = { Name *Identifier; NamedBindings *NamedImportBindings; PhaseModifier string } // PhaseModifier is type, defer or empty
type NamespaceImport = { Name Identifier }
type NamedImports = { Elements []ImportSpecifier }
type ImportSpecifier = { PropertyName *ModuleExportName; Name Identifier; IsTypeOnly bool }
type ImportAttributes = { Elements []ImportAttribute; Token string } // Token is with or assert
type ImportAttribute = { Name ImportAttributeName; Value Expression }
type ExportAssignment = { Modifiers []ModifierLike; Expression Expression; IsExportEquals bool }
type ExportDeclaration = {
    Modifiers       []ModifierLike
    ExportClause    *NamedExportBindings
    ModuleSpecifier *Expression
    Attributes      *ImportAttributes
    IsTypeOnly      bool
}
type NamedExports = { Elements []ExportSpecifier }
type NamespaceExport = { Name ModuleExportName }
type ExportSpecifier = { PropertyName *ModuleExportName; Name ModuleExportName; IsTypeOnly bool }

// --- Unions ---
type EntityName ~ Identifier | QualifiedName
type PropertyName ~ Identifier | StringLiteral | NumericLiteral | BigIntLiteral | ComputedPropertyName | PrivateIdentifier | NoSubstitutionTemplateLiteral
type MemberName ~ Identifier | PrivateIdentifier
type BindingName ~ Identifier | ObjectBindingPattern | ArrayBindingPattern
type ArrayBindingElement ~ BindingElement | OmittedExpression
type ModifierLike ~ Modifier | Decorator
type TypePredicateParameterName ~ Identifier | ThisTypeNode
type LiteralTypeLiteral ~ StringLiteral | NumericLiteral | BigIntLiteral | BooleanLiteral | NullLiteral | PrefixUnaryExpression | NoSubstitutionTemplateLiteral
type TemplateMiddleOrTail ~ TemplateMiddle | TemplateTail
type TemplateLiteral ~ NoSubstitutionTemplateLiteral | TemplateExpression
type TypeNode ~ KeywordTypeNode | ThisTypeNode | TypePredicate | TypeReference | FunctionType | ConstructorType | TypeQuery | TypeLiteral | ArrayType | TupleType | OptionalType | RestType | UnionType | IntersectionType | ConditionalType | InferType | ParenthesizedType | TypeOperator | IndexedAccessType | MappedType | LiteralType | NamedTupleMember | TemplateLiteralType | ImportType | JSDocAllType | JSDocUnknownType | JSDocNullableType | JSDocNonNullableType | JSDocFunctionType
type TypeElement ~ CallSignature | ConstructSignature | PropertySignature | MethodSignature | IndexSignature | GetAccessor | SetAccessor
type ClassElement ~ PropertyDeclaration | MethodDeclaration | Constructor | SemicolonClassElement | GetAccessor | SetAccessor | IndexSignature | ClassStaticBlockDeclaration
type ObjectLiteralElement ~ PropertyAssignment | ShorthandPropertyAssignment | SpreadAssignment | MethodDeclaration | GetAccessor | SetAccessor
type Expression ~ Identifier | PrivateIdentifier | NumericLiteral | BigIntLiteral | StringLiteral | RegularExpressionLiteral | NoSubstitutionTemplateLiteral | TemplateExpression | ThisExpression | SuperExpression | NullLiteral | BooleanLiteral | ImportExpression | OmittedExpression | ArrayLiteralExpression | ObjectLiteralExpression | PropertyAccessExpression | ElementAccessExpression | CallExpression | NewExpression | TaggedTemplateExpression | TypeAssertionExpression | ParenthesizedExpression | FunctionExpression | ArrowFunction | DeleteExpression | TypeOfExpression | VoidExpression | AwaitExpression | PrefixUnaryExpression | PostfixUnaryExpression | BinaryExpression | ConditionalExpression | YieldExpression | SpreadElement | ClassExpression | ExpressionWithTypeArguments | AsExpression | SatisfiesExpression | NonNullExpression | MetaProperty | JsxElement | JsxSelfClosingElement | JsxFragment
type ConciseBody ~ Block | Expression
type Statement ~ Block | EmptyStatement | VariableStatement | ExpressionStatement | IfStatement | DoStatement | WhileStatement | ForStatement | ForInStatement | ForOfStatement | ContinueStatement | BreakStatement | ReturnStatement | WithStatement | SwitchStatement | LabeledStatement | ThrowStatement | TryStatement | DebuggerStatement | FunctionDeclaration | ClassDeclaration | InterfaceDeclaration | TypeAliasDeclaration | EnumDeclaration | ModuleDeclaration | ImportEqualsDeclaration | ImportDeclaration | ExportAssignment | ExportDeclaration | NamespaceExportDeclaration
type ForInitializer ~ VariableDeclarationList | Expression
type CaseOrDefaultClause ~ CaseClause | DefaultClause
type ModuleName ~ Identifier | StringLiteral
type ModuleBody ~ ModuleBlock | ModuleDeclaration
type ModuleReference ~ Identifier | QualifiedName | ExternalModuleReference
type NamedImportBindings ~ NamespaceImport | NamedImports
type NamedExportBindings ~ NamedExports | NamespaceExport
type ModuleExportName ~ Identifier | StringLiteral
type ImportAttributeName ~ Identifier | StringLiteral
type JsxChild ~ JsxText | JsxExpression | JsxElement | JsxSelfClosingElement | JsxFragment
type JsxAttributeLike ~ JsxAttribute | JsxSpreadAttribute
type JsxAttributeName ~ Identifier | JsxNamespacedName
type JsxAttributeValue ~ StringLiteral | JsxExpression | JsxElement | JsxSelfClosingElement | JsxFragment
type JsxTagName ~ Identifier | ThisExpression | JsxNamespacedName | PropertyAccessExpression
type JsxTagNameStart ~ Identifier | ThisExpression

// ===================================================================
// Source files
// ===================================================================

rule main SourceFile = ("\u{0}" {ctx := 64} / {ctx := 0}) ("\u{1}" {ctx := ctx + 2})? f:sourceFile => $f

rule sourceFile SourceFile = (
    hashbang? -ws ss:(s:topLevelStatement -ws)* e:endOfFile
) => SourceFile{Statements: map($ss, (x) => x.$s), EndOfFileToken: $e}
// When the top level is in the await context (a module, see main), the compiler reparses only the statements
// that may contain await: not import and export declarations, enums and namespaces, which keep the script's
// context (their await is an identifier).
rule topLevelStatement Statement = awaitFreeTopLevelStatement / otherTopLevelStatement
rule otherTopLevelStatement Statement = !({ctx / 2 % 2 == 1} topLevelAwaitFreeStart) s:statement => $s
rule awaitFreeTopLevelStatement Statement = (
    {ctx / 2 % 2 == 1} &topLevelAwaitFreeStart {ctx := ctx - 2} s:statement
) => $s
rule topLevelAwaitFreeStart = (modifierKeyword -ws)* ("import" !idPart !(-ws [(.]) / "export" !idPart -ws (("type" !idPart -ws)? [=*{] / ("default" / "as") !idPart) / ("enum" / "namespace" / "module" / "global") !idPart)
rule endOfFile EndOfFileToken = t:($$) #atomic => EndOfFileToken{Text: text($t)}
rule hashbang = "#!" [^\n\r\u{2028}\u{2029}]*

// ===================================================================
// Statements (parseStatement)
// ===================================================================

// The keyword decides; the contextual keywords of declarations (type, namespace, declare, ...) start a
// declaration only when isStartOfDeclaration says so, and an expression statement otherwise.
rule statement Statement = (
    &statementSpecialStart s:specialStatement / !statementSpecialStart s:plainStatement
) => $s
// A statement that starts with a brace, ";", "@", a keyword or a contextual keyword of declarations (which may also
// start an expression). If none of them matches, the statement is not tried as a plain one (a block followed by
// "=" is an error, not an expression statement).
rule specialStatement Statement = (
    block / emptyStatement / variableStatement / plainFunctionDeclaration
    / plainClassDeclaration / ifStatement / doStatement / whileStatement / forStatement / continueStatement / breakStatement
    / returnStatement / withStatement / switchStatement / throwStatement / tryStatement / debuggerStatement
    / decoratedDeclaration / contextualDeclaration / expressionOrLabeledStatement
)
rule statementSpecialStart = [{;@] / &[abcdefgilmnoprstuvw] (statementKeyword / declarationKeyword) !idPart
rule statementKeyword = (
    "var" / "let" / "using" / "await" / "function" / "class" / "if" / "do" / "while" / "for"
    / "continue" / "break" / "return" / "with" / "switch" / "throw" / "try" / "debugger"
)
// Any other statement is an expression statement or a labeled statement.
rule plainStatement Statement = s:(labeledStatement / expressionStatement) => $s
rule plainFunctionDeclaration FunctionDeclaration = &("function" !idPart) d:functionDeclaration => $d
rule plainClassDeclaration ClassDeclaration = &("class" !idPart) d:classDeclaration => $d
rule decoratedDeclaration Statement = &"@" d:declaration => $d
rule contextualDeclaration Statement = &(declarationKeyword !idPart) &declarationStart d:declaration => $d
rule declarationKeyword = (
    "async" / "interface" / "type" / "module" / "namespace" / "declare" / "const" / "enum"
    / "export" / "import" / "private" / "protected" / "public" / "abstract" / "accessor" / "static" / "readonly"
    / "global"
)

// "=" after a block is an error (parseBlock): {a} = b is not a destructuring assignment.
rule block Block = "{" -ws ss:(s:statement -ws)* "}" !(-ws "=" ![=>]) => Block{Statements: map($ss, (x) => x.$s)}
rule emptyStatement EmptyStatement = t:(";") #atomic => EmptyStatement{Text: text($t)}

// var, let x, using x and await using x without modifiers (isLetDeclaration, isUsingDeclaration, ...)
rule variableStatement VariableStatement = (
    &variableStatementStart l:variableDeclarationList eos
) => VariableStatement{DeclarationList: $l}
rule variableStatementStart = (
    "var" !idPart / "let" !idPart letFollows / "using" !idPart usingFollows
    / "await" !idPart -ws "using" !idPart usingFollows
)
// let declares before an identifier or a pattern, on any line
rule letFollows = -ws (bindingIdentifier / [\[{])
// using declares before an identifier or {, on the same line
rule usingFollows = sp (bindingIdentifier / "{")

rule ifStatement IfStatement = (
    "if" !idPart -ws "(" -ws e:expressionAllowIn -ws ")" -ws t:statement
    (-ws "else" !idPart -ws s:statement)?
) => IfStatement{Expression: $e, ThenStatement: $t, ElseStatement: $s}
// The ";" after do-while is optional, without automatic semicolon insertion.
rule doStatement DoStatement = (
    "do" !idPart -ws s:statement -ws "while" !idPart -ws "(" -ws e:expressionAllowIn
    -ws ")" (-ws ";")?
) => DoStatement{Statement: $s, Expression: $e}
rule whileStatement WhileStatement = (
    "while" !idPart -ws "(" -ws e:expressionAllowIn -ws ")" -ws s:statement
) => WhileStatement{Expression: $e, Statement: $s}
rule withStatement WithStatement = (
    "with" !idPart -ws "(" -ws e:expressionAllowIn -ws ")" -ws s:statement
) => WithStatement{Expression: $e, Statement: $s}

// for, for-in, for-of and for await (parseForOrForInOrForOfStatement)
rule forStatement Statement = forOfStatement / forInStatement / forClassicStatement
rule forOfStatement ForOfStatement = (
    "for" !idPart (-ws t:awaitToken)? -ws "(" -ws i:forInitializer -ws
    "of" !idPart -ws e:assignmentExpressionAllowIn -ws ")" -ws s:statement
) => ForOfStatement{AwaitModifier: $t, Initializer: $i, Expression: $e, Statement: $s}
rule forInStatement ForInStatement = (
    "for" !idPart -ws "(" -ws i:forInitializer -ws "in" !idPart -ws
    e:expressionAllowIn -ws ")" -ws s:statement
) => ForInStatement{Initializer: $i, Expression: $e, Statement: $s}
rule forClassicStatement ForStatement = (
    "for" !idPart -ws "(" -ws i:forInitializer? -ws ";" -ws
    c:expressionAllowIn? -ws ";" -ws n:expressionAllowIn? -ws ")" -ws s:statement
) => ForStatement{Initializer: $i, Condition: $c, Incrementor: $n, Statement: $s}
rule awaitToken Token = t:("await" !idPart) #atomic => Token{Text: text($t)}
// The initializer is parsed with `in` disallowed, so that for (x in y) is a for-in statement.
rule forInitializer ForInitializer = {ctx := ctx - ctx / 4 % 2 * 4 + 4} i:(forDeclarationList / expression) => $i
rule forDeclarationList VariableDeclarationList = (
    &(("var" / "let" / "const") !idPart / "using" !idPart forUsingFollows / "await" !idPart -ws "using" !idPart usingFollows)
    l:variableDeclarationList
) => $l
// using of is a declaration before =, ; or : (disallowOf)
rule forUsingFollows = -ws "of" !idPart -ws [=;:] / sp !("of" !idPart) (bindingIdentifier / "{")

rule continueStatement ContinueStatement = (
    "continue" !idPart (!canParseSemicolon -ws n:identifier)? eos
) => ContinueStatement{Label: $n}
rule breakStatement BreakStatement = (
    "break" !idPart (!canParseSemicolon -ws n:identifier)? eos
) => BreakStatement{Label: $n}
rule returnStatement ReturnStatement = (
    "return" !idPart (!canParseSemicolon -ws e:expressionAllowIn)? eos
) => ReturnStatement{Expression: $e}
rule throwStatement ThrowStatement = (
    "throw" !idPart (!nlAhead -ws &d:(expressionAllowIn #atomic) e:expressionAllowIn / &nlAhead &(-ws e:missingIdentifier))
    (eos / {text($d) == "declare"})
) => ThrowStatement{Expression: $e}
rule missingIdentifier Identifier = t:(_) #atomic => Identifier{Text: text($t)}
rule debuggerStatement DebuggerStatement = t:("debugger" !idPart eos) #atomic => DebuggerStatement{Text: text($t)}

rule switchStatement SwitchStatement = (
    "switch" !idPart -ws "(" -ws e:expressionAllowIn -ws ")" -ws b:caseBlock
) => SwitchStatement{Expression: $e, CaseBlock: $b}
rule caseBlock CaseBlock = (
    "{" -ws cs:(c:caseOrDefaultClause -ws)* "}"
) => CaseBlock{Clauses: map($cs, (x) => x.$c)}
rule caseOrDefaultClause CaseOrDefaultClause = caseClause / defaultClause
rule caseClause CaseClause = (
    "case" !idPart -ws e:expressionAllowIn -ws ":" ss:(-ws s:clauseStatement)*
) => CaseClause{Expression: $e, Statements: map($ss, (x) => x.$s)}
rule defaultClause DefaultClause = (
    "default" !idPart -ws ":" ss:(-ws s:clauseStatement)*
) => DefaultClause{Statements: map($ss, (x) => x.$s)}
rule clauseStatement Statement = !(("case" / "default") !idPart) s:statement => $s

rule tryStatement TryStatement = (
    "try" !idPart -ws b:block (-ws cc:catchClause)?
    (-ws "finally" !idPart -ws fb:block)? {$cc != nil || $fb != nil}
) => TryStatement{TryBlock: $b, CatchClause: $cc, FinallyBlock: $fb}
rule catchClause CatchClause = (
    "catch" !idPart (-ws "(" -ws d:variableDeclaration -ws ")")? -ws b:block
) => CatchClause{VariableDeclaration: $d, Block: $b}

// An expression statement, or a labeled statement if the expression is an identifier followed by ":"
// (parseExpressionOrLabeledStatement).
// An expression statement does not start with "{", "@", function or class (isStartOfExpressionStatement).
rule expressionOrLabeledStatement Statement = (
    !(&(declarationKeyword !idPart) declarationStart)
    !variableStatementStart !([{@] / ("function" / "class") !idPart)
    s:(labeledStatement / expressionStatement / declareStatement)
) => $s
rule labeledStatement LabeledStatement = (
    &([a-zA-Z$_\\\u{80}-\u{10ffff}] identifierRest -ws ":") l:identifier -ws ":" -ws s:statement
) => LabeledStatement{Label: $l, Statement: $s}
rule expressionStatement ExpressionStatement = e:expressionAllowIn eos => ExpressionStatement{Expression: $e}
// The identifier declare needs no terminator: the parser reports no missing ";" after it
// (parseErrorForMissingSemicolonAfter), and goes on with the next statement on the same line.
rule declareStatement ExpressionStatement = (
    &x:(expressionAllowIn #atomic) {text($x) == "declare"} e:declareIdentifier
) => ExpressionStatement{Expression: $e}
rule declareIdentifier Identifier = t:("declare" !idPart) #atomic => Identifier{Text: text($t)}

// A statement terminator (parseSemicolon): ";", or nothing before a line break, "}" or the end of input.
rule eos = -ws ";" / &canParseSemicolon
rule canParseSemicolon = sp ([;}\n\r\u{2028}\u{2029}] / "/*" / $$)
// A line break before the next token: sp stops at a line terminator, or at a /* */ comment containing one.
rule nlAhead = sp ([\n\r\u{2028}\u{2029}] / "/*")

// ===================================================================
// Declarations (isStartOfDeclaration, parseDeclaration)
// ===================================================================

// isDeclaration: modifiers on the same line followed by a declaration keyword.
// (declarationStart and typeStart recurse at the end, after a modifier or "(", so pego lint hints that a Document
// would evaluate them again after an edit; they are lookaheads over a few tokens of a generated parser.)
rule declarationStart = (
    ("var" / "let" / "const" / "function" / "class" / "enum") !idPart
    / "using" !idPart usingFollows
    / "await" !idPart -ws "using" !idPart usingFollows
    / ("interface" / "type" / "defer") !idPart sp identifier
    / ("module" / "namespace") !idPart sp (identifier / ["'])
    / "declare" !idPart sp "type" !idPart
    / ("abstract" / "accessor" / "async" / "declare" / "private" / "protected" / "public" / "readonly") !idPart
      !nlAhead -ws declarationStart
    / "global" !idPart -ws ("{" / !anyKeyword identifierName / "export" !idPart)
    / "import" !idPart -ws ("defer" !idPart / ["'*{#] / idStart)
    / "export" !idPart -ws ("type" !idPart -ws)? ([=*{@] / ("default" / "as") !idPart)
    / "export" !idPart -ws declarationStart
    / "static" !idPart -ws declarationStart
)

rule declaration Statement = (
    variableStatementWithModifiers / functionDeclaration / classDeclaration
    / interfaceDeclaration / typeAliasDeclaration / enumDeclaration / moduleDeclaration
    / importEqualsDeclaration / importDeclaration / exportAssignment / namespaceExportDeclaration
    / exportDeclaration
)

rule variableStatementWithModifiers VariableStatement = (
    m:modifiers
    &(("var" / "let" / "const" / "using") !idPart / "await" !idPart -ws "using" !idPart)
    l:variableDeclarationList eos
) => VariableStatement{Modifiers: $m, DeclarationList: $l}

// --- Variables ---
// for (let of x) declares nothing (canFollowContextualOfKeyword).
rule variableDeclarationList VariableDeclarationList = (
    k:declarationListKeyword
    (!(-ws "of" !idPart -ws identifier -ws ")") -ws d:variableDeclarations / &(-ws "of" !idPart -ws identifier -ws ")") / !(-ws ([{\[#] / bindingIdentifier)))
) => VariableDeclarationList{Keyword: text($k), Declarations: concat($d)}
rule declarationListKeyword = (("var" / "let" / "const" / "using") !idPart / "await" -ws "using" !idPart) #atomic
rule variableDeclarations = (
    first:variableDeclaration rest:(-ws "," -ws d:variableDeclaration)*
    (-ws "," !(-ws ([{\[#] / bindingIdentifier)))?
) => concat(list($first), map($rest, (r) => r.$d))
// The definite assignment x! is not parsed in a for initializer (where `in` is disallowed).
rule variableDeclaration VariableDeclaration = (
    (n:bindingIdentifier ({ctx / 4 % 2 == 0} -sp x:exclamationToken)? / n:bindingPattern) ty:typeAnnotation?
    (!(-ws ("in" / "of") !idPart) v:initializer)?
) => VariableDeclaration{Name: $n, ExclamationToken: $x, Type: $ty, Initializer: $v}
rule initializer = -ws "=" ![=>] -ws e:assignmentExpression => $e
rule typeAnnotation = -ws ":" -ws t:typeNode => $t

// --- Binding patterns ---
rule bindingName BindingName = bindingIdentifier / bindingPattern
rule bindingPattern BindingName = objectBindingPattern / arrayBindingPattern
rule objectBindingPattern ObjectBindingPattern = (
    "{" -ws {ctx := ctx - ctx / 4 % 2 * 4}
    es:bindingElementList? -ws "}"
) => ObjectBindingPattern{Elements: concat($es)}
rule bindingElement BindingElement = bindingElementWithPropertyName / bindingElementShorthand
rule bindingElementWithPropertyName BindingElement = (
    (t:dotDotDotToken -ws)? p:propertyName -ws ":" -ws
    n:bindingName i:initializer?
) => BindingElement{DotDotDotToken: $t, PropertyName: $p, Name: $n, Initializer: $i}
rule bindingElementShorthand BindingElement = (
    (t:dotDotDotToken -ws)? n:bindingName i:initializer?
) => BindingElement{DotDotDotToken: $t, Name: $n, Initializer: $i}
rule arrayBindingPattern ArrayBindingPattern = (
    "[" -ws {ctx := ctx - ctx / 4 % 2 * 4}
    es:arrayBindingElementList? -ws "]"
) => ArrayBindingPattern{Elements: concat($es)}
rule arrayBindingElement ArrayBindingElement = omittedExpression / bindingElementShorthand
rule omittedExpression OmittedExpression = t:(&",") #atomic => OmittedExpression{Text: text($t)}

// --- Functions ---
// The name may be left out only with the default modifier (export default function () {}). The
// parameters and the body are parsed in the yield context of a generator and the await context of an
// async function.
rule functionDeclaration FunctionDeclaration = (
    (&dm:defaultModifierScan)? (&am:asyncModifierScan)?
    m:modifiers "function" !idPart (-ws s:asteriskToken)? (-ws i:bindingIdentifier)? {$i != nil || $dm != nil}
    {ctx := ctx - ctx % 32 + len($s) + len($am) / 5 * 2}
    (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => FunctionDeclaration{Modifiers: $m, AsteriskToken: $s, Name: $i, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule defaultModifierScan = (
    (!("default" !idPart) (decorator / modifier / staticModifier) -ws)* d:("default" !idPart) #atomic
) => $d
rule asyncModifierScan = (
    (!("async" !idPart) (decorator / modifier / staticModifier) -ws)* a:("async" !idPart) #atomic
) => $a

rule parameterList = "(" -ws ps:parameters? -ws ")" => concat($ps)
rule parameters = (
    first:parameter rest:(-ws "," -ws p:parameter)* (-ws ",")?
) => concat(list($first), map($rest, (r) => r.$p))
rule parameter Parameter = thisParameter / regularParameter
rule thisParameter Parameter = n:thisIdentifier t:typeAnnotation? => Parameter{Name: $n, Type: $t}
rule thisIdentifier Identifier = t:("this" !idPart) #atomic => Identifier{Text: text($t)}
rule regularParameter Parameter = (
    m:modifiers (dt:dotDotDotToken -ws)? n:bindingName (-ws qt:questionToken)?
    t:typeAnnotation? i:initializer?
) => Parameter{Modifiers: $m, DotDotDotToken: $dt, Name: $n, QuestionToken: $qt, Type: $t, Initializer: $i}
// A return type allows conditional types again (allowConditionalTypesAnd).
rule returnType = -ws ":" -ws {ctx := ctx - ctx / 32 % 2 * 32} t:typeOrTypePredicate => $t

// --- Classes ---
rule classDeclaration ClassDeclaration = (
    m:modifiers "class" !idPart (-ws i:className)?
    (-ws t:typeParameters)? (-ws hc:heritageClauses)? -ws "{" -ws ms:classMembers "}"
) => ClassDeclaration{Modifiers: $m, Name: $i, TypeParameters: concat($t), HeritageClauses: concat($hc), Members: $ms}
rule classExpression ClassExpression = (
    m:modifiers "class" !idPart (-ws i:className)?
    (-ws t:typeParameters)? (-ws hc:heritageClauses)? -ws "{" -ws ms:classMembers "}"
) => ClassExpression{Modifiers: $m, Name: $i, TypeParameters: concat($t), HeritageClauses: concat($hc), Members: $ms}
// class implements X {} has no name (isImplementsClause)
rule className Identifier = !("implements" !idPart -ws idStart) i:bindingIdentifier => $i

rule heritageClauses = (
    first:heritageClause rest:(-ws h:heritageClause)*
) => concat(list($first), map($rest, (r) => r.$h))
rule heritageClause HeritageClause = (
    t:(("extends" / "implements") !idPart) #atomic
    (&(-ws heritageElementStart) -ws l:heritageTypes / !(-ws heritageElementStart))
) => HeritageClause{Token: text($t), Types: concat($l)}
// isListElement for HeritageClauseElement
rule heritageElementStart = (
    "{" -ws !("}" !(-ws ([,{] / ("extends" / "implements") !idPart)))
    / !"{" !(("extends" / "implements") !idPart -ws expressionStart) leftHandSideExpressionStart
)
// isStartOfLeftHandSideExpression
rule leftHandSideExpressionStart = (
    [0-9"'`(\[{/] / "." [0-9]
    / ("this" / "super" / "null" / "true" / "false" / "function" / "class" / "new") !idPart
    / "import" !idPart -ws [(<.]
    / !reservedWord idStart
)
rule heritageTypes = (
    first:expressionWithTypeArguments rest:(-ws "," -ws e:expressionWithTypeArguments)*
    (-ws "," !(-ws heritageElementStart))?
) => concat(list($first), map($rest, (r) => r.$e))
// An element is a left-hand side expression and its type arguments; {} is an element only before
// ",", "{", extends or implements (isValidHeritageClauseObjectLiteral).
rule expressionWithTypeArguments ExpressionWithTypeArguments = (
    !(("extends" / "implements") !idPart -ws expressionStart)
    !("{" -ws "}" !(-ws ([,{] / ("extends" / "implements") !idPart)))
    e:heritageExpression (-ws t:typeArguments)?
) => ExpressionWithTypeArguments{Expression: $e, TypeArguments: concat($t)}

rule classMembers = ms:(&(classMemberStart / ";") m:classElement -ws)* => map($ms, (x) => x.$m)
// isClassMemberStart: a decorator, a class member modifier (public, static, ...) after other modifiers, "*",
// "[", or a name; a keyword (other than get and set) or a modifier taken for a name only before what can
// follow a property or method name.
rule classMemberStart = (
    "@"
    / (nonMemberModifier -ws)* (memberModifier / [*\[] / literalPropertyNameToken -ws "[" / ("get" / "set") !idPart / !anyKeyword literalPropertyNameToken / literalPropertyNameToken classMemberNameFollows)
    / nonMemberModifier (-ws nonMemberModifier)* classMemberNameFollows
)
rule nonMemberModifier = ("abstract" / "async" / "const" / "declare" / "default" / "export" / "in" / "out") !idPart
rule memberModifier = ("public" / "private" / "protected" / "readonly" / "static" / "override" / "accessor") !idPart
rule classMemberNameFollows = -ws [(<!:=?] / canParseSemicolon
rule classElement ClassElement = semicolonClassElement / classStaticBlock / classAccessor / classMemberNotAccessor
rule classAccessor ClassElement = &(classModifiers accessorKeyword) m:(getAccessor / setAccessor) => $m
rule classMemberNotAccessor ClassElement = (
    !(classModifiers accessorKeyword)
    m:(constructorDeclaration / classIndexSignature / methodDeclaration / propertyDeclaration)
) => $m
// get or set before a name: an accessor
rule accessorKeyword = ("get" / "set") !idPart &(-ws canFollowGetOrSet)
rule semicolonClassElement SemicolonClassElement = t:(";") #atomic => SemicolonClassElement{Text: text($t)}
rule classStaticBlock ClassStaticBlockDeclaration = (
    m:classModifiers "static" !idPart -ws &"{"
    {ctx := ctx - ctx % 32 + 2} b:block
) => ClassStaticBlockDeclaration{Modifiers: $m, Body: $b}
rule getAccessor GetAccessor = (
    m:classModifiers "get" !idPart &(-ws canFollowGetOrSet) -ws n:propertyName
    {ctx := ctx - ctx % 32} (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => GetAccessor{Modifiers: $m, Name: $n, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule setAccessor SetAccessor = (
    m:classModifiers "set" !idPart &(-ws canFollowGetOrSet) -ws n:propertyName
    {ctx := ctx - ctx % 32} (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => SetAccessor{Modifiers: $m, Name: $n, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule canFollowGetOrSet = "[" / literalPropertyNameStart
// A constructor is named constructor, or "constructor" before "(" (parseConstructorName).
rule constructorDeclaration Constructor = (
    m:classModifiers constructorName {ctx := ctx - ctx % 32}
    (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => Constructor{Modifiers: $m, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule constructorName = "constructor" !idPart / ("\"constructor\"" / "'constructor'") &(-ws "(")
rule classIndexSignature IndexSignature = (
    m:classModifiers &indexSignatureStart "[" -ws ps:parameters? -ws "]"
    t:typeAnnotation? typeMemberSemicolon
) => IndexSignature{Modifiers: $m, Parameters: concat($ps), Type: $t}
// A method has "*", or "(" or "<" after its name; anything else named is a property
// (parsePropertyOrMethodDeclaration).
rule methodDeclaration MethodDeclaration = (
    (&am:asyncModifierScan)? m:classModifiers !constructorName
    (s:asteriskToken -ws)? n:propertyName (-ws qt:questionToken)? ({$s != nil} / &(-ws [(<]))
    {ctx := ctx - ctx % 32 + len($s) + len($am) / 5 * 2}
    (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => MethodDeclaration{Modifiers: $m, AsteriskToken: $s, Name: $n, QuestionToken: $qt, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
// The initializer is parsed outside the yield and await contexts, with `in` allowed; "@" or "(" on the
// same line after the property is an error (parseSemicolonAfterPropertyName).
rule propertyDeclaration PropertyDeclaration = (
    m:classModifiers !constructorName n:propertyName
    (-ws qt:questionToken / -sp x:exclamationToken)? t:typeAnnotation?
    (-ws "=" ![=>] -ws {ctx := ctx - ctx % 8} v:assignmentExpression)? !(-sp [@(]) eos
) => PropertyDeclaration{Modifiers: $m, Name: $n, QuestionToken: $qt, ExclamationToken: $x, Type: $t, Initializer: $v}

// --- Interfaces, type aliases, enums ---
rule interfaceDeclaration InterfaceDeclaration = (
    m:modifiers "interface" !idPart -ws n:identifier
    (-ws t:typeParameters)? (-ws hc:heritageClauses)? -ws ms:objectTypeMembers
) => InterfaceDeclaration{Modifiers: $m, Name: $n, TypeParameters: concat($t), HeritageClauses: concat($hc), Members: $ms}
// type T = intrinsic declares an intrinsic type (tryParse(parseKeywordAndNoDot)).
rule typeAliasDeclaration TypeAliasDeclaration = (
    m:modifiers "type" !idPart !nlAhead -ws n:identifier
    (-ws t:typeParameters)? -ws "=" -ws ty:(intrinsicKeyword / typeNode) eos
) => TypeAliasDeclaration{Modifiers: $m, Name: $n, TypeParameters: concat($t), Type: $ty}
rule intrinsicKeyword KeywordTypeNode = t:("intrinsic" !idPart !(-ws ".")) #atomic => KeywordTypeNode{Text: text($t)}
rule enumDeclaration EnumDeclaration = (
    m:modifiers "enum" !idPart -ws n:identifier -ws "{" -ws
    {ctx := ctx - ctx % 4} ms:enumMemberList? -ws "}"
) => EnumDeclaration{Modifiers: $m, Name: $n, Members: concat($ms)}
rule enumMember EnumMember = (
    n:propertyName (-ws "=" ![=>] -ws v:assignmentExpressionAllowIn)?
) => EnumMember{Name: $n, Initializer: $v}

// --- Modules ---
rule moduleDeclaration ModuleDeclaration = namespaceDeclaration / externalModuleDeclaration / globalDeclaration
rule namespaceDeclaration ModuleDeclaration = (
    m:modifiers ("namespace" / "module") !idPart -ws n:identifier
    b:namespaceBody
) => ModuleDeclaration{Modifiers: $m, Name: $n, Body: $b}
rule namespaceBody ModuleBody = -ws "." -ws d:nestedNamespace / -ws d:moduleBlock => $d
rule nestedNamespace ModuleDeclaration = n:identifierNameOrPrivate b:namespaceBody => ModuleDeclaration{Name: $n, Body: $b}
rule externalModuleDeclaration ModuleDeclaration = (
    m:modifiers "module" !idPart -ws n:stringLiteral
    (-ws mb:moduleBlock / eos)
) => ModuleDeclaration{Modifiers: $m, Name: $n, Body: $mb}
rule globalDeclaration ModuleDeclaration = (
    m:modifiers n:globalIdentifier (-ws mb:moduleBlock / eos)
) => ModuleDeclaration{Modifiers: $m, Name: $n, Body: $mb}
rule globalIdentifier Identifier = t:("global" !idPart) #atomic => Identifier{Text: text($t)}
rule moduleBlock ModuleBlock = "{" -ws ss:(s:statement -ws)* "}" => ModuleBlock{Statements: map($ss, (x) => x.$s)}

// --- Imports ---
// import x = require("m"), import type x = N.M
rule importEqualsDeclaration ImportEqualsDeclaration = (
    m:modifiers "import" !idPart -ws
    (tt:"type" !idPart -ws &identifier)? n:identifier -ws "=" ![=>] -ws r:moduleReference eos
) => ImportEqualsDeclaration{Modifiers: $m, Name: $n, ModuleReference: $r, IsTypeOnly: $tt != nil}
rule moduleReference ModuleReference = externalModuleReference / entityName
rule externalModuleReference ExternalModuleReference = (
    "require" !idPart -ws "(" -ws e:moduleSpecifier -ws ")"
) => ExternalModuleReference{Expression: $e}
rule importDeclaration ImportDeclaration = (
    m:modifiers "import" !idPart -ws
    (ic:importClause -ws "from" !idPart -ws / "defer" !idPart -ws !(identifier / [*{,=]) / !identifier ![*{])
    s:moduleSpecifier (-sp at:importAttributes)? eos
) => ImportDeclaration{Modifiers: $m, ImportClause: $ic, ModuleSpecifier: $s, Attributes: $at}
// The phase modifier: import type ... and import defer ... (parseImportDeclarationOrImportEqualsDeclaration)
rule importClause ImportClause = (
    (pk:importPhase -ws)? (n:identifier (-ws "," -ws b:namedImportBindings)? / b:namedImportBindings)
) => ImportClause{Name: $n, NamedBindings: $b, PhaseModifier: text($pk)}
rule importPhase = ("type" !idPart &(-ws ("from" !idPart -ws ("from" !idPart / "=" !"=") / !("from" !idPart) (identifier / [*{]))) / "defer" !idPart &(-ws ("from" !idPart !(-ws ["']) / !("from" !idPart) ![,=]))) #atomic
rule namedImportBindings NamedImportBindings = namespaceImport / namedImports
rule namespaceImport NamespaceImport = "*" -ws "as" !idPart -ws n:identifier => NamespaceImport{Name: $n}
rule namedImports NamedImports = (
    "{" -ws es:importSpecifierList? -ws "}"
) => NamedImports{Elements: concat($es)}
// The type modifier and as (parseImportOrExportSpecifier): type as as x, type as x, type as, type x as y, x as y
rule importSpecifier ImportSpecifier = (
    importSpecifierTypeAsAs / importSpecifierTypeAsName / importSpecifierTypeAs
    / importSpecifierType / importSpecifierPlain
)
rule importSpecifierTypeAsAs ImportSpecifier = (
    "type" !idPart -ws p:asIdentifier -ws "as" !idPart -ws n:importedName
) => ImportSpecifier{PropertyName: $p, Name: $n, IsTypeOnly: true}
rule importSpecifierTypeAsName ImportSpecifier = (
    p:typeIdentifier -ws "as" !idPart -ws n:importedName
) => ImportSpecifier{PropertyName: $p, Name: $n}
rule importSpecifierTypeAs ImportSpecifier = (
    "type" !idPart -ws n:asIdentifier !(-ws moduleExportNameStart)
) => ImportSpecifier{Name: $n, IsTypeOnly: true}
rule importSpecifierType ImportSpecifier = (
    "type" !idPart -ws &moduleExportNameStart
    (p:moduleExportName -ws "as" !idPart -ws n:importedName / n:importedName)
) => ImportSpecifier{PropertyName: $p, Name: $n, IsTypeOnly: true}
rule importSpecifierPlain ImportSpecifier = (
    p:moduleExportName -ws "as" !idPart -ws n:importedName / n:importedName
) => ImportSpecifier{PropertyName: $p, Name: $n}
rule typeIdentifier Identifier = t:("type" !idPart) #atomic => Identifier{Text: text($t)}
rule importedName Identifier = t:(identifier / privateName) #atomic => Identifier{Text: text($t)}
rule privateName Identifier = t:("#" ([a-zA-Z$_] / idStartOther) identifierRest) #atomic => Identifier{Text: text($t)}
rule asIdentifier Identifier = t:("as" !idPart) #atomic => Identifier{Text: text($t)}
rule moduleExportName ModuleExportName = stringLiteral / identifierNameOrPrivate
rule moduleExportNameStart = idStart / "#" / ["']
rule moduleSpecifier Expression = stringLiteral / expression
// with { ... } or assert { ... } on the same line as the module specifier
rule importAttributes ImportAttributes = (
    t:(("with" / "assert") !idPart) #atomic -ws a:importAttributesBraces
) => ImportAttributes{Elements: $a, Token: text($t)}
rule importAttributesBraces = (
    "{" -ws es:importAttributeList? -ws "}"
) => concat($es)
rule importAttribute ImportAttribute = (
    n:(stringLiteral / identifierNameOrPrivate) -ws ":" -ws v:assignmentExpression
) => ImportAttribute{Name: $n, Value: $v}

// --- Exports ---
// export = x and export default x, in the await context
rule exportAssignment ExportAssignment = (
    m:modifiers "export" !idPart -ws k:("=" ![=>] / "default" !idPart) -ws
    {ctx := ctx - ctx / 2 % 2 * 2 + 2} e:assignmentExpression eos
) => ExportAssignment{Modifiers: $m, Expression: $e, IsExportEquals: text($k) == "="}
rule namespaceExportDeclaration NamespaceExportDeclaration = (
    m:modifiers "export" !idPart -ws "as" !idPart -ws
    "namespace" !idPart -ws n:identifier eos
) => NamespaceExportDeclaration{Modifiers: $m, Name: $n}
rule exportDeclaration ExportDeclaration = exportStarDeclaration / exportNamedDeclaration
rule exportStarDeclaration ExportDeclaration = (
    m:modifiers "export" !idPart -ws (tt:"type" !idPart -ws)?
    (c:namespaceExport / "*") -ws "from" !idPart -ws {ctx := ctx - ctx / 2 % 2 * 2 + 2} s:moduleSpecifier
    (-sp at:importAttributes)? eos
) => ExportDeclaration{Modifiers: $m, ExportClause: $c, ModuleSpecifier: $s, Attributes: $at, IsTypeOnly: $tt != nil}
rule exportNamedDeclaration ExportDeclaration = (
    m:modifiers "export" !idPart -ws (tt:"type" !idPart -ws)?
    c:namedExports (-ws "from" !idPart -ws {ctx := ctx - ctx / 2 % 2 * 2 + 2} s:moduleSpecifier (-sp at:importAttributes)?)? eos
) => ExportDeclaration{Modifiers: $m, ExportClause: $c, ModuleSpecifier: $s, Attributes: $at, IsTypeOnly: $tt != nil}
rule namespaceExport NamespaceExport = "*" -ws "as" !idPart -ws n:moduleExportName => NamespaceExport{Name: $n}
rule namedExports NamedExports = (
    "{" -ws es:exportSpecifierList? -ws "}"
) => NamedExports{Elements: concat($es)}
rule exportSpecifier ExportSpecifier = (
    exportSpecifierTypeAsAs / exportSpecifierTypeAsName / exportSpecifierTypeAs
    / exportSpecifierType / exportSpecifierPlain
)
rule exportSpecifierTypeAsAs ExportSpecifier = (
    "type" !idPart -ws p:asIdentifier -ws "as" !idPart -ws
    n:moduleExportName
) => ExportSpecifier{PropertyName: $p, Name: $n, IsTypeOnly: true}
rule exportSpecifierTypeAsName ExportSpecifier = (
    p:typeIdentifier -ws "as" !idPart -ws n:moduleExportName
) => ExportSpecifier{PropertyName: $p, Name: $n}
rule exportSpecifierTypeAs ExportSpecifier = (
    "type" !idPart -ws n:asIdentifier !(-ws moduleExportNameStart)
) => ExportSpecifier{Name: $n, IsTypeOnly: true}
rule exportSpecifierType ExportSpecifier = (
    "type" !idPart -ws &moduleExportNameStart
    (p:moduleExportName -ws "as" !idPart -ws n:moduleExportName / n:moduleExportName)
) => ExportSpecifier{PropertyName: $p, Name: $n, IsTypeOnly: true}
rule exportSpecifierPlain ExportSpecifier = (
    p:moduleExportName -ws "as" !idPart -ws n:moduleExportName / n:moduleExportName
) => ExportSpecifier{PropertyName: $p, Name: $n}

// ===================================================================
// Modifiers and decorators (parseModifiers)
// ===================================================================

// Decorators, modifiers, and after modifiers more decorators and modifiers. Each modifier keyword is a
// modifier only before what can follow a modifier (nextTokenCanFollowModifier), so that public or
// declare stay names elsewhere; static is a modifier once.
rule modifiers = (
    (&"@" d1:decoratorList)? m1:modifierList? ({len($m1) > 0} d2:decoratorList m2:modifierList?)?
) => concat($d1, $m1, $d2, $m2)
rule decoratorList = ds:(d:decorator -ws)+ => map($ds, (x) => x.$d)
rule modifierList = (
    b:(&[acdeiopr] m:modifier -ws)* s:staticModifierList? a:(&[acdeiopr] m:modifier -ws)*
    {len($b) > 0 || len($s) > 0}
) => concat(map($b, (x) => x.$m), $s, map($a, (x) => x.$m))
rule staticModifierList = &"s" m:staticModifier -ws => list($m)
rule modifier Modifier = t:(
    "export" !idPart &(-ws exportModifierFollows)
    / "default" !idPart &(-ws defaultModifierFollows)
    / "const" !idPart &(-ws "enum" !idPart)
    / ("abstract" / "accessor" / "async" / "declare" / "in" / "out" / "override" / "private" / "protected" / "public" / "readonly") !idPart &(sp canFollowModifier)
) #atomic => Modifier{Text: text($t)}
rule staticModifier Modifier = t:("static" !idPart &(-ws canFollowModifier)) #atomic => Modifier{Text: text($t)}
rule exportModifierFollows = (
    "default" !idPart -ws defaultModifierFollows
    / "type" !idPart -ws canFollowExportModifier
    / !(("default" / "type") !idPart) canFollowExportModifier
)
rule canFollowExportModifier = "@" / !([*{] / "as" !idPart) canFollowModifier
rule defaultModifierFollows = (
    ("class" / "function" / "interface") !idPart / "@"
    / "abstract" !idPart sp "class" !idPart / "async" !idPart sp "function" !idPart
)
rule canFollowModifier = [\[{*] / "..." / literalPropertyNameStart
rule literalPropertyNameStart = idStart / "#" / ["'0-9] / "." [0-9]

// Class members also take const as a modifier, and static before "{" starts a static block.
rule classModifiers = (
    (&"@" d1:decoratorList)? m1:classModifierList? ({len($m1) > 0} d2:decoratorList m2:classModifierList?)?
) => concat($d1, $m1, $d2, $m2)
rule classModifierList = (
    b:(&[acdeiopr] m:classModifier -ws)* s:classStaticModifierList?
    a:(&[acdeiopr] m:classModifier -ws)* {len($b) > 0 || len($s) > 0}
) => concat(map($b, (x) => x.$m), $s, map($a, (x) => x.$m))
rule classStaticModifierList = &"s" m:classStaticModifier -ws => list($m)
rule classModifier Modifier = t:("const" !idPart &(sp canFollowModifier) / modifier) #atomic => Modifier{Text: text($t)}
rule classStaticModifier Modifier = t:("static" !idPart !(-ws "{") &(-ws canFollowModifier)) #atomic => Modifier{Text: text($t)}

// Type members take no decorators; type parameters take const, in and out.
rule typeMemberModifiers = ms:modifierList? => concat($ms)
rule typeParameterModifiers = (
    b:(&[acdeiopr] m:classModifier -ws)* s:staticModifierList?
    a:(&[acdeiopr] m:classModifier -ws)*
) => concat(map($b, (x) => x.$m), $s, map($a, (x) => x.$m))

// A decorator is a left-hand side expression in the decorator context, where "[" is not an element access.
rule decorator Decorator = (
    "@" -ws {ctx := ctx - ctx / 8 % 2 * 8 + 8} e:leftHandSideExpression
) => Decorator{Expression: $e}

// ===================================================================
// Expressions
// ===================================================================

// parseExpression: a comma expression, outside the decorator context
rule expression Expression = {ctx := ctx - ctx / 8 % 4 * 8} e:commaExpression => $e
// allowInAnd(parseExpression)
rule expressionAllowIn Expression = {ctx := ctx - ctx / 4 % 8 * 4} e:commaExpression => $e
rule commaExpression Expression = (
    first:assignmentExpressionInner rest:(-ws o:commaToken -ws e:assignmentExpressionInner)*
) => foldl($first, $rest, (acc, r) => BinaryExpression{Left: acc, OperatorToken: r.$o, Right: r.$e})
// parseAssignmentExpressionOrHigher(allowReturnTypeInArrowFunction = true)
rule assignmentExpression Expression = {ctx := ctx - ctx / 8 % 4 * 8} e:assignmentExpressionInner => $e
rule assignmentExpressionAllowIn Expression = {ctx := ctx - ctx / 4 % 8 * 4} e:assignmentExpressionInner => $e

// parseAssignmentExpressionOrHigher: a yield expression, an arrow function, an assignment to a left-hand
// side expression, or a conditional expression.
rule assignmentExpressionInner Expression = &"yield" e:yieldExpression / &("async" !idPart / [(<]) e:arrowFunction / &"async" e:asyncSimpleArrowFunction / &([a-zA-Z$_\\\u{80}-\u{10ffff}] identifierRest -ws "=>") e:simpleArrowFunction / e:assignment / e:conditionalOrBinaryExpression => $e

// yield is an expression in the yield context, or before an identifier, keyword or literal on the
// same line; its operand must be on the same line.
rule yieldExpression YieldExpression = (
    "yield" !idPart ({ctx % 2 == 1} / &(sp identifierOrKeywordOrLiteralStart))
    (-sp !nlStart (at:asteriskToken -ws)? e:assignmentExpression)?
) => YieldExpression{AsteriskToken: $at, Expression: $e}
rule identifierOrKeywordOrLiteralStart = idStart / "#" / [0-9"'] / "." [0-9]
rule nlStart = [\n\r\u{2028}\u{2029}] / "/*"

rule assignment BinaryExpression = (
    l:leftHandSideExpression -ws &[>*<&|?+\-/%\^=] o:assignmentOperator -ws r:assignmentExpressionInner
) => BinaryExpression{Left: $l, OperatorToken: $o, Right: $r}
rule assignmentOperator Token = t:(
    ">>>=" / "**=" / "<<=" / ">>=" / "&&=" / "||=" / "??=" / "+=" / "-=" / "*=" / "/="
    / "%=" / "&=" / "|=" / "^=" / "=" ![=>]
) #atomic => Token{Text: text($t)}

// The true branch allows `in` and arrow functions without a return type (allowReturnTypeInArrowFunction
// = false), and is outside the decorator context.
rule conditionalOrBinaryExpression Expression = (
    c:binaryExpression
    rest:(-ws q:conditionalQuestionToken -ws t:conditionalWhenTrue -ws k:colonToken -ws f:conditionalWhenFalse)*
) => foldl($c, $rest, (acc, r) => ConditionalExpression{Condition: acc, QuestionToken: r.$q, WhenTrue: r.$t, ColonToken: r.$k, WhenFalse: r.$f})
rule conditionalWhenTrue Expression = {ctx := ctx - ctx / 4 % 8 * 4 + 16} e:assignmentExpressionInner => $e
rule conditionalWhenFalse Expression = e:assignmentExpressionInner => $e
rule conditionalQuestionToken Token = t:("?" !"?" !("." ![0-9])) #atomic => Token{Text: text($t)}

// --- Arrow functions (tryParseParenthesizedArrowFunctionExpression, isParenthesizedArrowFunctionExpression) ---
// In a .tsx file, <T> starts JSX; a generic arrow function needs <T,>, <T = ...> or <T extends ...>.
rule arrowFunction ArrowFunction = (
    ml:arrowAsyncModifier? !arrowParenthesisIsNotParameterList
    {ctx := ctx - ctx % 4 + len($ml) * 2} (t:arrowTypeParameters -ws)? &"(" ps:parameterList rt:returnType? -ws
    a:equalsGreaterThanToken -ws b:arrowBody ({ctx / 16 % 2 == 0} / {$rt == nil} / &(-ws ":"))
) => ArrowFunction{Modifiers: concat($ml), TypeParameters: concat($t), Parameters: $ps, Type: $rt, EqualsGreaterThanToken: $a, Body: $b}
rule arrowAsyncModifier = m:asyncKeywordModifier -sp &[(<] => list($m)
rule asyncKeywordModifier Modifier = t:("async" !idPart) #atomic => Modifier{Text: text($t)}
rule arrowTypeParameters = (
    &("<" -ws ("const" !idPart / identifier)) ({ctx < 64} / &tsxArrowTypeParametersStart)
    tp:typeParameters
) => $tp
rule tsxArrowTypeParametersStart = (
    "<" -ws ("const" !idPart -ws)? identifier -ws
    ("extends" !idPart -ws ![=>/] / [,=])
)
// (yield) and (await) are not parameter lists where yield and await are not identifiers.
rule arrowParenthesisIsNotParameterList = "(" -ws ("yield" !idPart {ctx % 2 == 1} / "await" !idPart {ctx / 2 % 2 == 1} / !(!("async" !idPart) modifierKeyword -ws identifier) (identifier / "this" !idPart) -ws ![:?,=)])
// x => ..., with the parameter an identifier in the current context
rule simpleArrowFunction ArrowFunction = (
    p:simpleArrowParameter -ws a:equalsGreaterThanToken -ws {ctx := ctx - ctx % 4}
    b:arrowBody
) => ArrowFunction{Parameters: list($p), EqualsGreaterThanToken: $a, Body: $b}
rule simpleArrowParameter Parameter = n:identifier => Parameter{Name: $n}
// async x => ..., all on one line
rule asyncSimpleArrowFunction ArrowFunction = (
    m:asyncKeywordModifier -sp ![\n\r\u{2028}\u{2029}] p:simpleArrowParameter -sp
    a:equalsGreaterThanToken -ws {ctx := ctx - ctx % 4 + 2} b:arrowBody
) => ArrowFunction{Modifiers: list($m), Parameters: list($p), EqualsGreaterThanToken: $a, Body: $b}
rule arrowBody ConciseBody = block / assignmentExpressionInner

// --- Binary expressions (parseBinaryExpressionRest) ---
// The levels are those of getBinaryOperatorPrecedence; as and satisfies take a type on the same line.
// skip is sp and each operator skips the whitespace before it, so that `as` can require no line break.
// Every operator is tried after every operand, so each starts with a silent test of the character where it can
// start (&(?...): a line break or "/" for the whitespace and comments before it, or a character of the operator),
// which fails without a rule call or an expectation. For the same reason skip, which the Operators Rule loop runs before
// each operator and operand, is sp behind a silent test of whether it has anything to skip (here and in the other
// Operators Rules).
rule binaryExpression Expression = operators {
    skip &[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] sp
    operand unaryExpression
    level {
        infix left &[\n\r\u{2028}\u{2029}/?|] -ws o:coalesceOrToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/&] -ws o:ampersandAmpersandToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/|] -ws o:barToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/\^] -ws o:caretToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/&] -ws o:ampersandToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/=!] -ws o:equalityToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/<>i] -ws o:relationalToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
        postfix &[a] "as" !idPart #cut -ws t:typeNode => AsExpression{Expression: $lhs, Type: $t}
        postfix &[s] "satisfies" !idPart #cut -ws t:typeNode => SatisfiesExpression{Expression: $lhs, Type: $t}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/<>] -ws o:shiftToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/+\-] -ws o:additiveToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix left &[\n\r\u{2028}\u{2029}/*%] -ws o:multiplicativeToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
    level {
        infix right &[\n\r\u{2028}\u{2029}/*] -ws o:asteriskAsteriskToken #cut -ws => BinaryExpression{Left: $lhs, OperatorToken: $o, Right: $rhs}
    }
}
// Operator tokens, each not the start of a longer token (maximal munch).
rule coalesceOrToken Token = t:("??" !"=" / "||" !"=") #atomic => Token{Text: text($t)}
rule ampersandAmpersandToken Token = t:("&&" !"=") #atomic => Token{Text: text($t)}
rule barToken Token = t:("|" ![|=]) #atomic => Token{Text: text($t)}
rule caretToken Token = t:("^" !"=") #atomic => Token{Text: text($t)}
rule ampersandToken Token = t:("&" ![&=]) #atomic => Token{Text: text($t)}
rule equalityToken Token = t:("===" / "!==" / "==" / "!=") #atomic => Token{Text: text($t)}
// In a .tsx file, </ is the start of a closing tag.
rule relationalToken Token = t:(
    "<=" / ">=" / "<" ![<=] !({ctx >= 64} "/" !"*") / ">" ![>=]
    / "instanceof" !idPart / {ctx / 4 % 2 == 0} "in" !idPart
) #atomic => Token{Text: text($t)}
rule shiftToken Token = t:(">>>" !"=" / ">>" ![>=] / "<<" !"=") #atomic => Token{Text: text($t)}
rule additiveToken Token = t:("+" ![+=] / "-" ![\-=]) #atomic => Token{Text: text($t)}
rule multiplicativeToken Token = t:("*" ![*=] / "/" !"=" / "%" !"=") #atomic => Token{Text: text($t)}
rule asteriskAsteriskToken Token = t:("**" !"=") #atomic => Token{Text: text($t)}
// isBinaryOperator
rule binaryOperatorStart = (
    coalesceOrToken / ampersandAmpersandToken / barToken / caretToken / ampersandToken
    / equalityToken / relationalToken / shiftToken / additiveToken / multiplicativeToken / asteriskAsteriskToken
    / ("as" / "satisfies") !idPart
)

// --- Unary expressions (parseUnaryExpressionOrHigher) ---
// A unary operator other than ++ and -- may not be the left operand of **.
rule unaryExpression Expression = &[+\-~!<dtva] &unaryOperatorStart u:simpleUnaryExpression !(-ws "**" !"=") / !(&[+\-~!<dtva] unaryOperatorStart) u:updateExpression => $u
rule unaryOperatorStart = (
    &[+\-~!<dtva]
    ("+" !"+" / "-" !"-" / [~!] / ("delete" / "typeof" / "void" / "await") !idPart / {ctx < 64} "<")
)
rule simpleUnaryExpression Expression = (
    prefixUnaryExpression / deleteExpression / typeOfExpression / voidExpression
    / typeAssertion / jsxUnaryExpression / awaitExpression / updateExpression
)
rule prefixUnaryExpression PrefixUnaryExpression = (
    o:("+" !"+" / "-" !"-" / "~" / "!") #atomic -ws e:simpleUnaryExpression
) => PrefixUnaryExpression{Operator: text($o), Operand: $e}
rule deleteExpression DeleteExpression = "delete" !idPart -ws e:simpleUnaryExpression => DeleteExpression{Expression: $e}
rule typeOfExpression TypeOfExpression = "typeof" !idPart -ws e:simpleUnaryExpression => TypeOfExpression{Expression: $e}
rule voidExpression VoidExpression = "void" !idPart -ws e:simpleUnaryExpression => VoidExpression{Expression: $e}
// await is an expression in the await context, or before an identifier, keyword or literal on the same line.
rule awaitExpression AwaitExpression = (
    "await" !idPart ({ctx / 2 % 2 == 1} / &(sp identifierOrKeywordOrLiteralStart))
    -ws e:simpleUnaryExpression
) => AwaitExpression{Expression: $e}
// <T>x, only in a .ts file
rule typeAssertion TypeAssertionExpression = (
    {ctx < 64} "<" ![<=] -ws t:typeNode -ws ">" -ws e:simpleUnaryExpression
) => TypeAssertionExpression{Type: $t, Expression: $e}
rule jsxUnaryExpression Expression = {ctx >= 64} &"<" e:jsxElementOrFragment => $e

// parseUpdateExpression
rule updateExpression Expression = &[+\-] e:prefixUpdateExpression / {ctx >= 64} &"<" e:jsxPrimaryExpression / e:postfixOrLeftHandSideExpression => $e
// A left-hand side expression, parsed once, and one ++ or -- after it on the same line.
rule postfixOrLeftHandSideExpression Expression = (
    e:leftHandSideExpression rest:(-sp o:("++" / "--") #atomic)*
    {len($rest) <= 1}
) => foldl($e, $rest, (acc, r) => PostfixUnaryExpression{Operand: acc, Operator: text(r.$o)})
rule prefixUpdateExpression PrefixUnaryExpression = (
    o:("++" / "--") #atomic -ws e:leftHandSideExpression
) => PrefixUnaryExpression{Operator: text($o), Operand: $e}
// JSX in an expression, which may not be followed by "<" ("JSX expressions must have one parent element").
rule jsxPrimaryExpression Expression = (
    {ctx >= 64} &("<" -ws (idStart / ">")) e:jsxElementOrFragment
    !(-ws "<" ![<=])
) => $e

// --- Left-hand side expressions (parseLeftHandSideExpressionOrHigher, parseMemberExpressionRest,
// parseCallExpressionRest) ---
// Type arguments in an expression are taken only before what can follow them
// (canFollowTypeArgumentsInExpression); otherwise < is a comparison.
// As in binaryExpression, each postfix operator starts with a silent test of its first character (or of a line
// break or "/" before it), and the operand that is almost always the one, primaryExpression, comes first.
rule leftHandSideExpression Expression = operators {
    skip &[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] sp
    operand primaryExpression
    operand superExpression
    operand importCallee
    operand importMetaProperty
    level {
        postfix &[\n\r\u{2028}\u{2029}/.] -ws "." ![0-9.] #cut -ws n:memberName => PropertyAccessExpression{Expression: $lhs, Name: $n}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws n:identifierName => PropertyAccessExpression{Expression: $lhs, QuestionDotToken: $q, Name: $n}
        postfix &[\n\r\u{2028}\u{2029}/\[] -ws {ctx / 8 % 2 == 0} "[" #cut -ws e:expressionAllowIn -ws "]" => ElementAccessExpression{Expression: $lhs, ArgumentExpression: $e}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws "[" -ws e:expressionAllowIn -ws "]" => ElementAccessExpression{Expression: $lhs, QuestionDotToken: $q, ArgumentExpression: $e}
        postfix &[\n\r\u{2028}\u{2029}/<`] -ws (t:typeArgumentsInExpression -ws)? &"`" #cut l:taggedTemplate => TaggedTemplateExpression{Tag: $lhs, TypeArguments: concat($t), Template: $l}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws (t:typeArgumentsInExpression -ws)? l:taggedTemplate => TaggedTemplateExpression{Tag: $lhs, QuestionDotToken: $q, TypeArguments: concat($t), Template: $l}
        postfix &[!] "!" !"=" => NonNullExpression{Expression: $lhs}
        postfix &[\n\r\u{2028}\u{2029}/<] -ws t:typeArgumentsInExpression => ExpressionWithTypeArguments{Expression: $lhs, TypeArguments: $t}
        postfix &[\n\r\u{2028}\u{2029}/<(] -ws (t:typeArgumentsInExpression -ws)? &"(" #cut a:arguments => CallExpression{Expression: $lhs, TypeArguments: concat($t), Arguments: $a}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws (t:typeArgumentsInExpression -ws)? a:arguments => CallExpression{Expression: $lhs, QuestionDotToken: $q, TypeArguments: concat($t), Arguments: $a}
    }
}
// The same without instantiation expressions, for heritage clauses, which take type arguments of their own.
rule heritageExpression Expression = operators {
    skip &[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] sp
    operand primaryExpression
    operand superExpression
    operand importCallee
    operand importMetaProperty
    level {
        postfix &[\n\r\u{2028}\u{2029}/.] -ws "." ![0-9.] #cut -ws n:memberName => PropertyAccessExpression{Expression: $lhs, Name: $n}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws n:identifierName => PropertyAccessExpression{Expression: $lhs, QuestionDotToken: $q, Name: $n}
        postfix &[\n\r\u{2028}\u{2029}/\[] -ws {ctx / 8 % 2 == 0} "[" #cut -ws e:expressionAllowIn -ws "]" => ElementAccessExpression{Expression: $lhs, ArgumentExpression: $e}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws "[" -ws e:expressionAllowIn -ws "]" => ElementAccessExpression{Expression: $lhs, QuestionDotToken: $q, ArgumentExpression: $e}
        postfix &[\n\r\u{2028}\u{2029}/<`] -ws (t:typeArgumentsInExpression -ws)? &"`" #cut l:taggedTemplate => TaggedTemplateExpression{Tag: $lhs, TypeArguments: concat($t), Template: $l}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws (t:typeArgumentsInExpression -ws)? l:taggedTemplate => TaggedTemplateExpression{Tag: $lhs, QuestionDotToken: $q, TypeArguments: concat($t), Template: $l}
        postfix &[!] "!" !"=" => NonNullExpression{Expression: $lhs}
        postfix &[\n\r\u{2028}\u{2029}/<(] -ws (t:typeArgumentsInExpression -ws)? &"(" #cut a:arguments => CallExpression{Expression: $lhs, TypeArguments: concat($t), Arguments: $a}
        postfix &[\n\r\u{2028}\u{2029}/?] -ws q:questionDotToken #cut -ws (t:typeArgumentsInExpression -ws)? a:arguments => CallExpression{Expression: $lhs, QuestionDotToken: $q, TypeArguments: concat($t), Arguments: $a}
    }
}
// The target of new: member accesses, element accesses, tagged templates and non-null assertions, without
// calls or optional chains (parseMemberExpressionRest with allowOptionalChain = false).
rule newTarget Expression = operators {
    skip &[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] sp
    operand primaryExpression
    operand superKeyword
    level {
        postfix &[\n\r\u{2028}\u{2029}/.] -ws "." ![0-9.] #cut -ws n:memberName => PropertyAccessExpression{Expression: $lhs, Name: $n}
        postfix &[\n\r\u{2028}\u{2029}/\[] -ws {ctx / 8 % 2 == 0} "[" #cut -ws e:expressionAllowIn -ws "]" => ElementAccessExpression{Expression: $lhs, ArgumentExpression: $e}
        postfix &[\n\r\u{2028}\u{2029}/<`] -ws (t:typeArgumentsInExpression -ws)? &"`" #cut l:taggedTemplate => TaggedTemplateExpression{Tag: $lhs, TypeArguments: concat($t), Template: $l}
        postfix &[!] "!" !"=" => NonNullExpression{Expression: $lhs}
    }
}
rule memberName MemberName = privateIdentifier / identifierName
rule questionDotToken Token = t:("?." ![0-9]) #atomic => Token{Text: text($t)}

// parseTypeArgumentsInExpression: "<" types ">" not followed by ">" or "=", then what can follow type
// arguments: "(" or a template; else not "<", ">", "+" or "-", and a line break, a binary operator or
// something that cannot start an expression. An instantiation expression may not be followed by a
// property access, so "." and "?." before a name are excluded too.
rule typeArgumentsInExpression = (
    "<" -ws {ctx := ctx - ctx % 4} ts:typeList? -ws ">" ![>=] &typeArgumentsCanFollow
) => concat($ts)
rule typeArgumentsCanFollow = (
    -ws [(`]
    / !(-ws ("<" ![<=] / ">" / "+" ![+=] / "-" ![\-=] / "." ![0-9] / "?." ![0-9] -ws idStart))
      (nlAhead / -ws binaryOperatorStart / !(-ws expressionStart))
)
// isStartOfExpression
rule expressionStart = (
    [0-9"'`(\[{/~!#@] / "<" ![<=] / "+" !"=" / "-" !"=" / "." [0-9]
    / ("this" / "super" / "null" / "true" / "false" / "function" / "class" / "new" / "delete" / "typeof" / "void")
      !idPart
    / "import" !idPart -ws [(<.]
    / !reservedWord idStart
    / binaryOperatorStart
)

rule arguments = "(" -ws {ctx := ctx - ctx / 4 % 8 * 4} as:argumentList? -ws ")" => concat($as)
rule argumentList = (
    first:argument rest:(-ws "," -ws a:argument)* (-ws ",")?
) => concat(list($first), map($rest, (r) => r.$a))
rule argument Expression = spreadElement / assignmentExpressionInner
rule spreadElement SpreadElement = "..." -ws e:assignmentExpression => SpreadElement{Expression: $e}

// super must be followed by "(", "." or "["
rule superExpression SuperExpression = t:("super" !idPart &(-ws [(.\[])) #atomic => SuperExpression{Text: text($t)}
rule superKeyword SuperExpression = t:("super" !idPart) #atomic => SuperExpression{Text: text($t)}
rule importCallee ImportExpression = t:("import" !idPart &(-ws [(<])) #atomic => ImportExpression{Text: text($t)}
rule importMetaProperty MetaProperty = (
    "import" !idPart -ws "." -ws n:identifierNameOrPrivate
) => MetaProperty{KeywordToken: "import", Name: $n}

// --- Primary expressions (parsePrimaryExpression) ---
// An identifier is the most common primary expression, and it cannot be mistaken for a keyword (async function is
// a function expression). The first character tells words from the rest; (?a-zA-Z$_\\\u{80}-\u{10FFFF})
// is the start of an identifier, or a character that may turn out not to be.
rule primaryExpression Expression = (
    (&[a-zA-Z$_\\\u{80}-\u{10ffff}] e:wordPrimary / e:symbolPrimary)
    @error(message="expected an expression")
) => $e
rule wordPrimary Expression = !("async" !idPart -sp "function" !idPart) e:identifier / e:thisKeyword / e:nullKeyword / e:booleanKeyword / e:functionExpression / e:classExpressionPrimary / e:newExpression => $e
rule symbolPrimary Expression = (
    stringLiteral / numericOrBigIntLiteral / noSubstitutionTemplateLiteral
    / templateExpression / parenthesizedExpression / arrayLiteralExpression / objectLiteralExpression
    / classExpressionPrimary / regularExpressionLiteral / privateIdentifier
)
rule numericOrBigIntLiteral Expression = &[0-9.] e:(numericLiteral / bigIntLiteral) => $e
rule thisKeyword ThisExpression = t:("this" !idPart) #atomic => ThisExpression{Text: text($t)}
rule nullKeyword NullLiteral = t:("null" !idPart) #atomic => NullLiteral{Text: text($t)}
rule booleanKeyword BooleanLiteral = t:(("true" / "false") !idPart) #atomic => BooleanLiteral{Text: text($t)}
rule parenthesizedExpression ParenthesizedExpression = (
    "(" -ws e:expressionAllowIn -ws ")"
) => ParenthesizedExpression{Expression: $e}
// An element is a spread, an expression or an omitted expression (a hole).
rule arrayLiteralExpression ArrayLiteralExpression = (
    "[" -ws {ctx := ctx - ctx / 8 % 4 * 8}
    es:arrayElementList? -ws "]"
) => ArrayLiteralExpression{Elements: concat($es)}
rule arrayElement Expression = spreadElement / assignmentExpressionInner / omittedExpression
rule objectLiteralExpression ObjectLiteralExpression = (
    "{" -ws
    ps:objectLiteralElementList? -ws "}"
) => ObjectLiteralExpression{Properties: concat($ps)}
// parseObjectLiteralElement
rule objectLiteralElement ObjectLiteralElement = spreadAssignment / objectAccessor / objectMemberNotAccessor
rule objectAccessor ObjectLiteralElement = &(modifiers accessorKeyword) m:(objectGetAccessor / objectSetAccessor) => $m
rule objectMemberNotAccessor ObjectLiteralElement = (
    !(modifiers accessorKeyword)
    m:(objectMethod / shorthandPropertyAssignment / propertyAssignment)
) => $m
rule objectLiteralElementStart = [\[*.] / literalPropertyNameStart
rule spreadAssignment SpreadAssignment = "..." -ws e:assignmentExpression => SpreadAssignment{Expression: $e}
rule objectGetAccessor GetAccessor = (
    m:modifiers "get" !idPart &(-ws canFollowGetOrSet) -ws n:propertyName
    {ctx := ctx - ctx % 32} (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => GetAccessor{Modifiers: $m, Name: $n, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule objectSetAccessor SetAccessor = (
    m:modifiers "set" !idPart &(-ws canFollowGetOrSet) -ws n:propertyName
    {ctx := ctx - ctx % 32} (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => SetAccessor{Modifiers: $m, Name: $n, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule objectMethod MethodDeclaration = (
    (&am:asyncModifierScan)? m:modifiers (s:asteriskToken -ws)? n:propertyName
    (-ws qt:questionToken)? (-ws xt:exclamationToken)? ({$s != nil} / &(-ws [(<]))
    {ctx := ctx - ctx % 32 + len($s) + len($am) / 5 * 2}
    (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") eos)
) => MethodDeclaration{Modifiers: $m, AsteriskToken: $s, Name: $n, QuestionToken: $qt, ExclamationToken: $xt, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
// An identifier not followed by ":" is a shorthand property, with an optional = initializer.
rule shorthandPropertyAssignment ShorthandPropertyAssignment = (
    m:modifiers n:identifier (-ws qt:questionToken)?
    (-ws xt:exclamationToken)? !(-ws ":") (-ws eq:equalsToken -ws {ctx := ctx - ctx / 4 % 2 * 4} v:assignmentExpression)?
) => ShorthandPropertyAssignment{Modifiers: $m, Name: $n, QuestionToken: $qt, ExclamationToken: $xt, EqualsToken: $eq, ObjectAssignmentInitializer: $v}
rule propertyAssignment PropertyAssignment = (
    m:modifiers n:propertyName (-ws qt:questionToken)?
    (-ws xt:exclamationToken)? -ws ":" -ws {ctx := ctx - ctx / 4 % 2 * 4} v:assignmentExpression
) => PropertyAssignment{Modifiers: $m, Name: $n, QuestionToken: $qt, ExclamationToken: $xt, Initializer: $v}

rule functionExpression FunctionExpression = (
    ml:asyncFunctionModifier? "function" !idPart (-ws s:asteriskToken)?
    {ctx := ctx - ctx % 32 + len($s) + len($ml) * 2} (-ws i:bindingIdentifier)? (-ws t:typeParameters)? -ws
    ps:parameterList rt:returnType? -ws b:block
) => FunctionExpression{Modifiers: concat($ml), AsteriskToken: $s, Name: $i, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $b}
rule asyncFunctionModifier = m:asyncKeywordModifier -sp &("function" !idPart) => list($m)
// class ... or decorators and class (parseDecoratedExpression)
rule classExpressionPrimary ClassExpression = &("class" !idPart / "@") c:classExpression => $c

// new.target, or new and a member expression with optional type arguments and arguments
// (parseNewExpressionOrNewDotTarget); new x?.y is an error.
rule newExpression Expression = newTargetMetaProperty / newExpressionWithTarget
rule newTargetMetaProperty MetaProperty = (
    "new" !idPart -ws "." -ws n:identifierNameOrPrivate
) => MetaProperty{KeywordToken: "new", Name: $n}
rule newExpressionWithTarget NewExpression = (
    "new" !idPart -ws e:newTarget (-ws t:typeArgumentsInExpression)?
    !(-ws "?." ![0-9]) (-ws as:arguments)?
) => NewExpression{Expression: $e, TypeArguments: concat($t), Arguments: $as}

// --- Templates ---
// An untagged template must have valid escape sequences; a tagged one may have any.
rule templateExpression TemplateExpression = (
    h:templateHead ss:templateSpans
) => TemplateExpression{Head: $h, TemplateSpans: $ss}
rule templateSpans = ms:(-ws m:templateSpanMiddle)* -ws t:templateSpanTail => concat(map($ms, (x) => x.$m), list($t))
rule templateSpanMiddle TemplateSpan = e:expressionAllowIn -ws l:templateMiddle => TemplateSpan{Expression: $e, Literal: $l}
rule templateSpanTail TemplateSpan = e:expressionAllowIn -ws l:templateTail => TemplateSpan{Expression: $e, Literal: $l}
rule taggedTemplate TemplateLiteral = rawNoSubstitutionTemplateLiteral / rawTemplateExpression
rule rawTemplateExpression TemplateExpression = (
    h:rawTemplateHead ss:rawTemplateSpans
) => TemplateExpression{Head: $h, TemplateSpans: $ss}
rule rawTemplateSpans = ms:(-ws m:rawTemplateSpanMiddle)* -ws t:rawTemplateSpanTail => concat(map($ms, (x) => x.$m), list($t))
rule rawTemplateSpanMiddle TemplateSpan = (
    e:expressionAllowIn -ws l:rawTemplateMiddle
) => TemplateSpan{Expression: $e, Literal: $l}
rule rawTemplateSpanTail TemplateSpan = (
    e:expressionAllowIn -ws l:rawTemplateTail
) => TemplateSpan{Expression: $e, Literal: $l}

// ===================================================================
// JSX (parseJsxElementOrSelfClosingElementOrFragment)
// ===================================================================

rule jsxElementOrFragment Expression = jsxSelfClosingElement / jsxElement / jsxFragment
rule jsxSelfClosingElement JsxSelfClosingElement = (
    "<" -ws n:jsxElementName (-ws t:typeArguments)? -ws
    a:jsxAttributes -ws "/" -ws ">"
) => JsxSelfClosingElement{TagName: $n, TypeArguments: concat($t), Attributes: $a}
// The closing tag must name the opening tag.
rule jsxElement JsxElement = (
    &("<" -ws on:(jsxElementName #atomic)) o:jsxOpeningElement cs:jsxChild*
    &("</" -ws cn:(jsxElementName #atomic)) c:jsxClosingElement {text($on) == text($cn)}
) => JsxElement{OpeningElement: $o, Children: $cs.Value, ClosingElement: $c}
rule jsxOpeningElement JsxOpeningElement = (
    "<" -ws n:jsxElementName (-ws t:typeArguments)? -ws a:jsxAttributes
    -ws ">"
) => JsxOpeningElement{TagName: $n, TypeArguments: concat($t), Attributes: $a}
rule jsxClosingElement JsxClosingElement = "</" -ws n:jsxElementName -ws ">" => JsxClosingElement{TagName: $n}
rule jsxFragment JsxFragment = (
    o:jsxOpeningFragment cs:jsxChild* c:jsxClosingFragment
) => JsxFragment{OpeningFragment: $o, Children: $cs.Value, ClosingFragment: $c}
rule jsxOpeningFragment JsxOpeningFragment = t:("<" -ws ">") #atomic => JsxOpeningFragment{Text: text($t)}
rule jsxClosingFragment JsxClosingFragment = t:("</" -ws ">") #atomic => JsxClosingFragment{Text: text($t)}

// A tag name: an identifier with dashes, a namespaced name, this, or a member access.
rule jsxElementName JsxTagName = jsxNamespacedName / jsxMemberName
rule jsxMemberName JsxTagName = (
    first:jsxTagNameStart rest:(-ws "." -ws n:identifierName)*
) => foldl($first, $rest, (acc, r) => PropertyAccessExpression{Expression: acc, Name: r.$n})
rule jsxTagNameStart JsxTagNameStart = jsxThis / jsxIdentifier
rule jsxThis ThisExpression = t:("this" !(idPart / "-")) #atomic => ThisExpression{Text: text($t)}
rule jsxIdentifier Identifier = t:("#"? idStart (idPart / "-")*) #atomic => Identifier{Text: text($t)}
rule jsxNamespacedName JsxNamespacedName = (
    s:jsxIdentifier -ws ":" -ws n:jsxIdentifier
) => JsxNamespacedName{Namespace: $s, Name: $n}

rule jsxAttributes JsxAttributes = (
    ps:jsxAttributeLikeList?
) => JsxAttributes{Properties: concat($ps)}
rule jsxAttributeLike JsxAttributeLike = jsxSpreadAttribute / jsxAttribute
rule jsxAttribute JsxAttribute = (
    n:jsxAttributeName (-ws "=" -ws i:jsxAttributeValue)?
) => JsxAttribute{Name: $n, Initializer: $i}
rule jsxAttributeName JsxAttributeName = jsxNamespacedName / jsxIdentifier
rule jsxAttributeValue JsxAttributeValue = jsxAttributeString / jsxAttributeExpression / jsxElementOrFragmentValue
rule jsxElementOrFragmentValue JsxAttributeValue = jsxSelfClosingElement / jsxElement / jsxFragment
rule jsxAttributeString StringLiteral = t:("\"" [^"]* "\"" / "'" [^']* "'") #atomic => StringLiteral{Text: text($t)}
rule jsxAttributeExpression JsxExpression = "{" -ws e:expression? -ws "}" => JsxExpression{Expression: $e}
rule jsxSpreadAttribute JsxSpreadAttribute = (
    "{" -ws "..." -ws e:expression -ws "}"
) => JsxSpreadAttribute{Expression: $e}

// Children: text (where ">" and "}" are errors), {expressions} and elements.
rule jsxChild JsxChild = jsxText / jsxChildExpression / jsxChildElement
rule jsxText JsxText = t:([^{}<>]+) #atomic => JsxText{Text: text($t)}
rule jsxChildExpression JsxExpression = (
    "{" -ws (dt:dotDotDotToken -ws)? e:expression? -ws "}"
) => JsxExpression{DotDotDotToken: $dt, Expression: $e}
rule jsxChildElement JsxChild = !"</" e:(jsxSelfClosingElement / jsxElement / jsxFragment) => $e

// ===================================================================
// Types (parseType)
// ===================================================================

// Types are parsed outside the yield and await contexts.
rule typeNode TypeNode = {ctx := ctx - ctx % 4} t:typeInner => $t
rule typeInner TypeNode = functionType / constructorType / conditionalOrHigher
// The extends type of a conditional type and the constraint of infer disallow conditional types.
rule typeNoConditional TypeNode = {ctx := ctx - ctx / 32 % 2 * 32 + 32} t:typeInner => $t
rule typeAllowConditional TypeNode = {ctx := ctx - ctx / 32 % 2 * 32} t:typeInner => $t
// A union or intersection type, parsed once, and the conditional type it may check (extends ... ? ... : ...).
rule conditionalOrHigher TypeNode = (
    c:unionOrHigher
    rest:({ctx / 32 % 2 == 0} -sp "extends" !idPart -ws e:typeNoConditional -ws "?" -ws t:typeAllowConditional -ws ":" -ws f:typeAllowConditional)*
) => foldl($c, $rest, (acc, r) => ConditionalType{CheckType: acc, ExtendsType: r.$e, TrueType: r.$t, FalseType: r.$f})
rule typeOrTypePredicate TypeNode = typePredicate / typeNode
rule typePredicate TypePredicate = (
    n:identifier -sp "is" !idPart -ws t:typeNode
) => TypePredicate{ParameterName: $n, Type: $t}

rule functionType FunctionType = (
    &[(<] (&"<" / &unambiguousFunctionTypeStart) (t:typeParameters -ws)? ps:parameterList
    -ws "=>" -ws r:returnTypeOfType
) => FunctionType{TypeParameters: concat($t), Parameters: $ps, Type: $r}
rule constructorType ConstructorType = (
    &(("abstract" / "new") !idPart) (am:abstractModifier -ws)? "new" !idPart -ws (t:typeParameters -ws)?
    ps:parameterList -ws "=>" -ws r:returnTypeOfType
) => ConstructorType{Modifiers: concat($am), TypeParameters: concat($t), Parameters: $ps, Type: $r}
rule abstractModifier = m:abstractKeywordModifier => list($m)
rule abstractKeywordModifier Modifier = t:("abstract" !idPart) #atomic => Modifier{Text: text($t)}
rule returnTypeOfType TypeNode = {ctx := ctx - ctx / 32 % 2 * 32} t:typeOrTypePredicate => $t

// A leading | or & makes a union or intersection of one type.
// A | or & after a type is always followed by a type: a failed one is an error, not the end of the type.
rule unionOrHigher TypeNode = u:leadingUnionType / u:plainOrUnionType => $u
rule leadingUnionType UnionType = (
    barToken -ws f:intersectionOrHigher r:(-ws barToken -ws t:intersectionOrHigher)*
    !(-ws barToken)
) => UnionType{Types: concat(list($f), map($r, (x) => x.$t))}
rule plainOrUnionType TypeNode = (
    f:intersectionOrHigher
    more:(ts:(-ws barToken -ws t:intersectionOrHigher)+)* !(-ws barToken)
) => foldl($f, $more, (acc, m) => UnionType{Types: concat(list(acc), map(m.$ts, (x) => x.$t))})
rule intersectionOrHigher TypeNode = u:leadingIntersectionType / u:plainOrIntersectionType => $u
rule leadingIntersectionType IntersectionType = (
    ampersandToken -ws f:typeOperatorOrHigher
    r:(-ws ampersandToken -ws t:typeOperatorOrHigher)* !(-ws ampersandToken)
) => IntersectionType{Types: concat(list($f), map($r, (x) => x.$t))}
rule plainOrIntersectionType TypeNode = (
    f:typeOperatorOrHigher
    more:(ts:(-ws ampersandToken -ws t:typeOperatorOrHigher)+)* !(-ws ampersandToken)
) => foldl($f, $more, (acc, m) => IntersectionType{Types: concat(list(acc), map(m.$ts, (x) => x.$t))})

rule typeOperatorOrHigher TypeNode = (
    &(("keyof" / "unique" / "readonly" / "infer") !idPart) t:(typeOperator / inferType) / !(("keyof" / "unique" / "readonly" / "infer") !idPart) t:postfixTypeAllowConditional
) => $t
rule postfixTypeAllowConditional TypeNode = {ctx := ctx - ctx / 32 % 2 * 32} t:postfixType => $t
rule typeOperator TypeOperator = (
    o:(("keyof" / "unique" / "readonly") !idPart) #atomic -ws t:typeOperatorOrHigher
) => TypeOperator{Operator: text($o), Type: $t}
rule inferType InferType = "infer" !idPart -ws p:inferTypeParameter => InferType{TypeParameter: $p}
// infer T extends C: the constraint is kept unless a conditional type may follow and "?" does.
rule inferTypeParameter TypeParameter = (
    n:identifier
    (-ws "extends" !idPart -ws ct:typeNoConditional ({ctx / 32 % 2 == 1} / !(-ws "?")))?
) => TypeParameter{Name: $n, Constraint: $ct}

// Array types, indexed access types and the JSDoc postfixes ! and ?, on the same line.
rule postfixType TypeNode = operators {
    skip &[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] sp
    operand nonArrayType
    level {
        postfix "[" -ws "]" => ArrayType{ElementType: $lhs}
        postfix "[" -ws &typeStart i:typeNode -ws "]" => IndexedAccessType{ObjectType: $lhs, IndexType: $i}
        postfix "!" !"=" => JSDocNonNullableType{Type: $lhs, Postfix: true}
        postfix "?" !"?" !("." ![0-9]) !(-ws typeStart) => JSDocNullableType{Type: $lhs, Postfix: true}
    }
}
// The same without the postfix ?, for the optional elements of tuples.
rule postfixTypeNoQuestion TypeNode = operators {
    skip &[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] sp
    operand nonArrayType
    level {
        postfix "[" -ws "]" => ArrayType{ElementType: $lhs}
        postfix "[" -ws &typeStart i:typeNode -ws "]" => IndexedAccessType{ObjectType: $lhs, IndexType: $i}
        postfix "!" !"=" => JSDocNonNullableType{Type: $lhs, Postfix: true}
    }
}

// parseNonArrayType
// The first character tells words, whose alternatives are tried in the compiler's order, from the rest.
rule nonArrayType TypeNode = (
    (&[a-zA-Z$_\\\u{80}-\u{10ffff}] t:wordType / t:symbolType)
    @error(message="expected a type")
) => $t
// A word that is not one of those of the other types (keywords, literals, this, typeof, import, asserts, function)
// is a type reference.
rule wordType TypeNode = &(("any" / "unknown" / "string" / "number" / "bigint" / "symbol" / "boolean" / "undefined" / "never" / "object" / "void" / "true" / "false" / "null" / "this" / "typeof" / "import" / "asserts" / "function") !idPart) t:specialWordType / t:typeReference => $t
rule specialWordType TypeNode = (
    keywordType / literalType / thisTypePredicate / thisType / importType / typeQuery
    / assertsTypePredicate / jsdocFunctionType / functionTypeReference / typeReference
)
rule symbolType TypeNode = (
    literalType / mappedType / typeLiteral / tupleType / parenthesizedType
    / templateLiteralType / jsdocAllType / jsdocUnknownType / jsdocNullableType / jsdocNonNullableType / typeReference
)
// A keyword type, unless followed by "." (then it is a type reference)
rule keywordType KeywordTypeNode = t:(
    ("any" / "unknown" / "string" / "number" / "bigint" / "symbol" / "boolean" / "undefined" / "never" / "object") !idPart !(-ws ".")
    / "void" !idPart
) #atomic => KeywordTypeNode{Text: text($t)}
rule literalType LiteralType = l:(stringLiteral / numericLiteral / bigIntLiteral / booleanKeyword / nullKeyword / noSubstitutionTemplateLiteral / negativeLiteral) => LiteralType{Literal: $l}
rule negativeLiteral PrefixUnaryExpression = (
    "-" -ws l:(numericLiteral / bigIntLiteral)
) => PrefixUnaryExpression{Operator: "-", Operand: $l}
rule thisType ThisTypeNode = t:("this" !idPart) #atomic => ThisTypeNode{Text: text($t)}
rule thisTypePredicate TypePredicate = (
    n:thisType -sp "is" !idPart -ws t:typeNode
) => TypePredicate{ParameterName: $n, Type: $t}
// asserts x, asserts x is T, asserts this
rule assertsTypePredicate TypePredicate = (
    a:assertsToken &(sp identifierOrKeywordStart) -sp
    n:(thisType / identifier) (-ws "is" !idPart -ws ty:typeNode)?
) => TypePredicate{AssertsModifier: $a, ParameterName: $n, Type: $ty}
rule assertsToken Token = t:("asserts" !idPart) #atomic => Token{Text: text($t)}
rule identifierOrKeywordStart = idStart / "#"
rule typeQuery TypeQuery = (
    "typeof" !idPart -ws n:entityNameAllowReserved (-sp t:typeArguments)?
) => TypeQuery{ExprName: $n, TypeArguments: concat($t)}
rule importType ImportType = (
    o:("typeof" !idPart -ws)? "import" !idPart -ws "(" -ws a:typeNode
    (-ws "," -ws "{" -ws ("with" / "assert") !idPart -ws ":" -ws i:importTypeAttributes (-ws ",")? -ws "}")? -ws ")"
    (-ws "." -ws qn:entityNameAllowReserved)? (-sp t:typeArguments)?
) => ImportType{Argument: $a, Attributes: $i, Qualifier: $qn, TypeArguments: concat($t), IsTypeOf: $o != nil}
rule importTypeAttributes ImportAttributes = a:importAttributesBraces => ImportAttributes{Elements: $a, Token: "with"}
// Type arguments start at a "<" on the same line, and must follow then.
rule typeReference TypeReference = (
    !(("typeof" / "void" / "this" / "import" / "true" / "false" / "null" / "keyof" / "unique" / "readonly" / "infer" / "new" / "function") !idPart) !("asserts" !idPart sp identifierOrKeywordStart)
    n:entityNameAllowReserved (-ws "." &(-sp "<"))? (-sp t:typeArguments / !(-sp "<"))
) => TypeReference{TypeName: $n, TypeArguments: concat($t)}
rule functionTypeReference TypeReference = n:functionIdentifier !(-ws "(") => TypeReference{TypeName: $n}
rule functionIdentifier Identifier = t:("function" !idPart) #atomic => Identifier{Text: text($t)}
rule parenthesizedType ParenthesizedType = (
    !unambiguousFunctionTypeStart "(" -ws t:typeNode -ws ")"
) => ParenthesizedType{Type: $t}
// "(" before ")", "...", or a parameter name (after modifiers) before ":", ",", "?", "=" or ") =>"
rule unambiguousFunctionTypeStart = "(" -ws (")" / "..." / typeMemberModifiers (identifier / "this" !idPart / bindingPattern) -ws ([:,?=] / ")" -ws "=>"))
rule templateLiteralType TemplateLiteralType = (
    h:templateHead ss:templateTypeSpans
) => TemplateLiteralType{Head: $h, TemplateSpans: $ss}
rule templateTypeSpans = (
    ms:(-ws m:templateTypeSpanMiddle)* -ws t:templateTypeSpanTail
) => concat(map($ms, (x) => x.$m), list($t))
rule templateTypeSpanMiddle TemplateLiteralTypeSpan = (
    t:typeNode -ws l:templateMiddle
) => TemplateLiteralTypeSpan{Type: $t, Literal: $l}
rule templateTypeSpanTail TemplateLiteralTypeSpan = (
    t:typeNode -ws l:templateTail
) => TemplateLiteralTypeSpan{Type: $t, Literal: $l}

// JSDoc types, which the parser accepts in .ts files (the checker reports them)
rule jsdocAllType JSDocAllType = t:("*" !"*") #atomic => JSDocAllType{Text: text($t)}
rule jsdocUnknownType JSDocUnknownType = t:("?" &(-ws [,})>=|])) #atomic => JSDocUnknownType{Text: text($t)}
rule jsdocNullableType JSDocNullableType = "?" -ws t:typeNode => JSDocNullableType{Type: $t}
rule jsdocNonNullableType JSDocNonNullableType = "!" -ws t:nonArrayType => JSDocNonNullableType{Type: $t}
rule jsdocFunctionType JSDocFunctionType = (
    "function" !idPart -ws "(" -ws ps:jsdocParameterList?
    -ws ")" rt:returnType?
) => JSDocFunctionType{Parameters: concat($ps), Type: $rt}
rule jsdocParameter Parameter = (i:jsdocParameterName -ws ":" -ws)? t:typeNode => Parameter{Name: $i, Type: $t}
rule jsdocParameterName Identifier = t:(("this" / "new") !idPart) #atomic => Identifier{Text: text($t)}

rule entityName EntityName = (
    first:identifier rest:(-ws "." -ws n:identifier)*
) => foldl($first, $rest, (acc, r) => QualifiedName{Left: acc, Right: r.$n})
rule entityNameAllowReserved EntityName = (
    first:identifierNameOrPrivate rest:(-ws "." -ws n:identifierName)*
) => foldl($first, $rest, (acc, r) => QualifiedName{Left: acc, Right: r.$n})

rule typeArguments = "<" -ws ts:typeList? -ws ">" => concat($ts)
// Each type starts as a type does (isListElement for TypeArguments): A<class> is an error.
rule typeList = (
    &typeStart first:typeNode rest:(-ws "," -ws &typeStart t:typeNode)* (-ws ",")?
) => concat(list($first), map($rest, (r) => r.$t))
rule typeParameters = (
    "<" -ws ps:typeParameterList? -ws ">"
) => concat($ps)
// The constraint is an expression when it starts an expression but no type (as in JSDoc, which the parser
// accepts here too).
rule typeParameter TypeParameter = (
    m:typeParameterModifiers n:identifier
    (-ws "extends" !idPart -ws (&(typeStart / !expressionStart) ct:typeNode / !typeStart ex:unaryExpression))?
    (-ws "=" ![=>] -ws dt:typeNode)?
) => TypeParameter{Modifiers: $m, Name: $n, Constraint: $ct, Default: $dt, Expression: $ex}

// --- Tuples ---
rule tupleType TupleType = (
    "[" -ws es:tupleElementList? -ws "]"
) => TupleType{Elements: concat($es)}
rule tupleElement TypeNode = namedTupleMember / tupleElementType
rule namedTupleMember NamedTupleMember = (
    (dt:dotDotDotToken -ws)? n:identifierNameOrPrivate (-ws qt:questionToken)? -ws ":"
    -ws t:tupleElementType
) => NamedTupleMember{DotDotDotToken: $dt, Name: $n, QuestionToken: $qt, Type: $t}
// T? before "," or "]" is an optional element (the parser turns a postfix JSDocNullableType into it).
rule tupleElementType TypeNode = restType / optionalType / typeNode
rule restType RestType = "..." -ws t:typeNode => RestType{Type: $t}
rule optionalType OptionalType = t:postfixTypeNoQuestion -sp "?" &(-ws [,\]]) => OptionalType{Type: $t}

// --- Object types ---
rule typeLiteral TypeLiteral = !mappedTypeStart m:objectTypeMembers => TypeLiteral{Members: $m}
rule objectTypeMembers = "{" -ws ms:(&typeMemberStart m:typeMember -ws)* "}" => map($ms, (x) => x.$m)
// isTypeMemberStart: "(", "<", get, set, "[" after modifiers, or a name (or a modifier taken for one) before
// "(", "<", "?", ":", "," or a statement terminator.
rule typeMemberStart = (
    [(<] / ("get" / "set") !idPart
    / (modifierKeyword -ws)* "["
    / (modifierKeyword -ws)* literalPropertyNameToken typeMemberNameFollows
    / modifierKeyword (-ws modifierKeyword)* typeMemberNameFollows
)
rule typeMemberNameFollows = nlAhead / -ws ([(<?:,;}] / $$)
rule literalPropertyNameToken = identifierName / privateIdentifier / stringLiteral / numericLiteral / bigIntLiteral
// isStartOfMappedType
rule mappedTypeStart = "{" -ws ([+\-] -ws "readonly" !idPart / ("readonly" !idPart -ws)? "[" -ws identifier -ws "in" !idPart)
rule mappedType MappedType = (
    &mappedTypeStart "{" -ws (rt:mappedReadonlyToken -ws)? "[" -ws p:mappedTypeParameter
    (-ws "as" !idPart -ws nt:typeNode)? -ws "]" (-ws qt:mappedQuestionToken)? t:typeAnnotation? eos -ws
    ms:(&typeMemberStart m:typeMember -ws)* "}"
) => MappedType{ReadonlyToken: $rt, TypeParameter: $p, NameType: $nt, QuestionToken: $qt, Type: $t, Members: map($ms, (x) => x.$m)}
rule mappedTypeParameter TypeParameter = (
    n:identifierNameOrPrivate -ws "in" !idPart -ws c:typeNode
) => TypeParameter{Name: $n, Constraint: $c}
rule mappedReadonlyToken Token = t:(mappedPlusMinusReadonly / readonlyToken) => $t
rule mappedPlusMinusReadonly Token = t:plusMinusToken -ws "readonly" !idPart => $t
rule mappedQuestionToken Token = t:(mappedPlusMinusQuestion / questionToken) => $t
rule mappedPlusMinusQuestion Token = t:plusMinusToken -ws "?" => $t
rule plusMinusToken Token = t:([+\-]) #atomic => Token{Text: text($t)}
rule readonlyToken Token = t:("readonly" !idPart) #atomic => Token{Text: text($t)}

// parseTypeMember
rule typeMember TypeElement = callSignature / constructSignature / typeAccessor / typeMemberNotAccessor
rule typeAccessor TypeElement = &(typeMemberModifiers accessorKeyword) m:(typeGetAccessor / typeSetAccessor) => $m
rule typeMemberNotAccessor TypeElement = (
    !(typeMemberModifiers accessorKeyword)
    m:(typeIndexSignature / methodSignature / propertySignature)
) => $m
rule callSignature CallSignature = (
    (t:typeParameters -ws)? ps:parameterList rt:returnType? typeMemberSemicolon
) => CallSignature{TypeParameters: concat($t), Parameters: $ps, Type: $rt}
rule constructSignature ConstructSignature = (
    "new" !idPart -ws &[(<] (t:typeParameters -ws)? ps:parameterList
    rt:returnType? typeMemberSemicolon
) => ConstructSignature{TypeParameters: concat($t), Parameters: $ps, Type: $rt}
rule typeGetAccessor GetAccessor = (
    m:typeMemberModifiers "get" !idPart &(-ws canFollowGetOrSet) -ws n:propertyName
    (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") typeMemberSemicolon)
) => GetAccessor{Modifiers: $m, Name: $n, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule typeSetAccessor SetAccessor = (
    m:typeMemberModifiers "set" !idPart &(-ws canFollowGetOrSet) -ws n:propertyName
    (-ws t:typeParameters)? -ws ps:parameterList rt:returnType? (-ws fb:block / !(-ws "{") typeMemberSemicolon)
) => SetAccessor{Modifiers: $m, Name: $n, TypeParameters: concat($t), Parameters: $ps, Type: $rt, Body: $fb}
rule typeIndexSignature IndexSignature = (
    m:typeMemberModifiers &indexSignatureStart "[" -ws ps:parameters? -ws "]"
    t:typeAnnotation? typeMemberSemicolon
) => IndexSignature{Modifiers: $m, Parameters: concat($ps), Type: $t}
// isUnambiguouslyIndexSignature
rule indexSignatureStart = "[" -ws ("..." / "]" / modifierKeyword -ws identifier / identifier -ws ([:,] / "?" -ws [:,\]]))
rule modifierKeyword = ("abstract" / "accessor" / "async" / "const" / "declare" / "default" / "export" / "in" / "out" / "override" / "private" / "protected" / "public" / "readonly" / "static") !idPart
rule methodSignature MethodSignature = (
    m:typeMemberModifiers n:propertyName (-ws qt:questionToken)? -ws &[(<]
    (t:typeParameters -ws)? ps:parameterList rt:returnType? typeMemberSemicolon
) => MethodSignature{Modifiers: $m, Name: $n, QuestionToken: $qt, TypeParameters: concat($t), Parameters: $ps, Type: $rt}
rule propertySignature PropertySignature = (
    m:typeMemberModifiers n:propertyName (-ws qt:questionToken)?
    t:typeAnnotation? i:initializer? typeMemberSemicolon
) => PropertySignature{Modifiers: $m, Name: $n, QuestionToken: $qt, Type: $t, Initializer: $i}
// "," or a statement terminator (parseTypeMemberSemicolon)
rule typeMemberSemicolon = -ws "," / eos

// isStartOfType (used where "?" might be a postfix type operator)
// (Like declarationStart, a lookahead that recurses after "(".)
rule typeStart = (
    ("any" / "unknown" / "string" / "number" / "bigint" / "boolean" / "readonly" / "symbol" / "unique" / "void" / "undefined" / "null" / "this" / "typeof" / "never" / "true" / "false" / "object" / "new" / "infer" / "import" / "asserts" / "function") !idPart
    / [{\[<|&"'0-9*?!`] / "..." / "." [0-9]
    / "-" -ws ([0-9] / "." [0-9])
    / "(" -ws ([)\[{@.#] / modifierKeyword / typeStart / bindingIdentifier)
    / !reservedWord idStart
)

// ===================================================================
// Names and literals
// ===================================================================

rule propertyName PropertyName = (
    stringLiteral / numericLiteral / bigIntLiteral / computedPropertyName
    / privateIdentifier / identifierName
)
rule computedPropertyName ComputedPropertyName = (
    "[" -ws e:expressionAllowIn -ws "]"
) => ComputedPropertyName{Expression: $e}

// --- Tokens ---
rule questionToken Token = t:("?") #atomic => Token{Text: text($t)}
rule exclamationToken Token = t:("!" !"=") #atomic => Token{Text: text($t)}
rule asteriskToken Token = t:("*") #atomic => Token{Text: text($t)}
rule dotDotDotToken Token = t:("...") #atomic => Token{Text: text($t)}
rule equalsGreaterThanToken Token = t:("=>") #atomic => Token{Text: text($t)}
rule colonToken Token = t:(":") #atomic => Token{Text: text($t)}
rule equalsToken Token = t:("=" ![=>]) #atomic => Token{Text: text($t)}
rule commaToken Token = t:(",") #atomic => Token{Text: text($t)}

// --- Identifiers ---
// An identifier is not a reserved word, nor yield in the yield context or await in the await context
// (isIdentifier). A binding identifier may be yield or await (isBindingIdentifier).
rule identifier Identifier = (
    !(&[bcdefinrstvw] reservedWord) !("yield" !idPart {ctx % 2 == 1}) !("await" !idPart {ctx / 2 % 2 == 1})
    i:identifierName
) => $i
rule bindingIdentifier Identifier = !(&[bcdefinrstvw] reservedWord) i:identifierName => $i
rule identifierName Identifier = t:(([a-zA-Z$_] / idStartOther) identifierRest) #atomic => Identifier{Text: text($t)}
rule privateIdentifier PrivateIdentifier = t:("#" ([a-zA-Z$_] / idStartOther) identifierRest) #atomic => PrivateIdentifier{Text: text($t)}
rule identifierNameOrPrivate Identifier = t:("#"? ([a-zA-Z$_] / idStartOther) identifierRest) #atomic => Identifier{Text: text($t)}
// Every keyword, reserved or contextual
rule anyKeyword = ("abstract" / "accessor" / "any" / "asserts" / "assert" / "async" / "as" / "await" / "bigint" / "boolean" / "break" / "case" / "catch" / "class" / "constructor" / "const" / "continue" / "debugger" / "declare" / "default" / "defer" / "delete" / "do" / "else" / "enum" / "export" / "extends" / "false" / "finally" / "for" / "from" / "function" / "get" / "global" / "if" / "implements" / "import" / "infer" / "instanceof" / "interface" / "intrinsic" / "in" / "is" / "keyof" / "let" / "module" / "namespace" / "never" / "new" / "null" / "number" / "object" / "of" / "out" / "override" / "package" / "private" / "protected" / "public" / "readonly" / "require" / "return" / "satisfies" / "set" / "static" / "string" / "super" / "switch" / "symbol" / "this" / "throw" / "true" / "try" / "typeof" / "type" / "undefined" / "unique" / "unknown" / "using" / "var" / "void" / "while" / "with" / "yield") !idPart
// The first letter selects the words to try.
rule reservedWord = (&"b" "break" / &"c" ("case" / "catch" / "class" / "const" / "continue") / &"d" ("debugger" / "default" / "delete" / "do") / &"e" ("else" / "enum" / "export" / "extends") / &"f" ("false" / "finally" / "for" / "function") / &"i" ("if" / "import" / "instanceof" / "in") / &"n" ("new" / "null") / &"r" "return" / &"s" ("super" / "switch") / &"t" ("this" / "throw" / "true" / "try" / "typeof") / &"v" ("var" / "void") / &"w" ("while" / "with")) !idPart
// The rest of an identifier: runs of ASCII identifier characters, which are most of them, without a rule call
// per character, and the escapes and non-ASCII characters between them.
rule identifierRest = [a-zA-Z0-9$_]* (&[\\\u{80}-\u{10ffff}] ("\\u" identifierPartEscape / uniIdPart) [a-zA-Z0-9$_]*)*
rule idStart = [a-zA-Z$_] / idStartOther
rule idStartOther = "\\u" identifierStartEscape / uniIdStart
rule idPart = [a-zA-Z0-9$_] / "\\u" identifierPartEscape / uniIdPart
// An escape in an identifier stands for an identifier character: exactly for ASCII values; any value from
// U+0080 is accepted (the Unicode tables are not applied to escapes).
rule identifierStartEscape = (
    "00" asciiIdentifierStartHex / !"00" !surrogate hex hex hex hex / "00" [89a-fA-F] hex
    / "{" "0"* (asciiIdentifierStartHex "}" / nonASCIIBraced)
)
rule identifierPartEscape = (
    "00" (asciiIdentifierStartHex / "3" [0-9]) / !"00" !surrogate hex hex hex hex / "00" [89a-fA-F] hex
    / "{" "0"* (asciiIdentifierStartHex "}" / "3" [0-9] "}" / nonASCIIBraced)
)
rule surrogate = [dD] [89a-fA-F]
// $, A-Z, _, a-z
rule asciiIdentifierStartHex = "24" / "4" [1-9a-fA-F] / "5" [0-9aA] / "5" [fF] / "6" [1-9a-fA-F] / "7" [0-9aA]
// 80 to 10FFFF, after leading zeros
rule nonASCIIBraced = [89a-fA-F] hex "}" / [1-9a-fA-F] hex hex hex? hex? "}" / "10" hex hex hex hex "}"
rule unicodeEscape = hex hex hex hex / unicodeBraced
// \u{...} with a value up to 10FFFF
rule unicodeBraced = "{" ("0"* [1-9a-fA-F] hex? hex? hex? hex? "}" / "0"* "10" hex hex hex hex "}" / "0"+ "}")
rule hex = [0-9a-fA-F]

// --- Numbers (scanNumber) ---
// A literal may not be followed by an identifier; 0 may not be followed by a digit (no legacy octal
// literals, no decimals with leading zeros).
rule numericLiteral NumericLiteral = t:((hexLiteral / binaryLiteral / octalLiteral / decimalLiteral) !idStart) #atomic => NumericLiteral{Text: text($t)}
rule bigIntLiteral BigIntLiteral = t:((hexLiteral / binaryLiteral / octalLiteral / decimalInteger) "n" !idStart) #atomic => BigIntLiteral{Text: text($t)}
rule decimalLiteral = decimalInteger ("." decimalDigits?)? exponentPart? / "." decimalDigits exponentPart?
rule decimalInteger = "0" ![0-9_] / [1-9] ("_"? [0-9])*
rule decimalDigits = [0-9] ("_"? [0-9])*
rule exponentPart = [eE] [+\-]? decimalDigits
rule hexLiteral = "0" [xX] hex ("_"? hex)*
rule binaryLiteral = "0" [bB] [01] ("_"? [01])*
rule octalLiteral = "0" [oO] [0-7] ("_"? [0-7])*

// --- Strings (scanString, scanEscapeSequence) ---
// Octal escapes, \8 and \9 are errors; \0 is allowed when no digit follows.
rule stringLiteral StringLiteral = t:("\"" ([^"\\\n\r]+ / escapeSequence)* "\"" / "'" ([^'\\\n\r]+ / escapeSequence)* "'") #atomic => StringLiteral{Text: text($t)}
rule escapeSequence = "\\" ([^0-9xu\n\r\u{2028}\u{2029}] / "0" ![0-9] / "x" hex hex / "u" unicodeEscape / "\r\n" / [\n\r\u{2028}\u{2029}])

// --- Templates (scanTemplateAndSetTokenValue) ---
rule noSubstitutionTemplateLiteral NoSubstitutionTemplateLiteral = t:("`" templateCharacters "`") #atomic => NoSubstitutionTemplateLiteral{Text: text($t)}
rule templateHead TemplateHead = t:("`" templateCharacters "${") #atomic => TemplateHead{Text: text($t)}
rule templateMiddle TemplateMiddle = t:("}" templateCharacters "${") #atomic => TemplateMiddle{Text: text($t)}
rule templateTail TemplateTail = t:("}" templateCharacters "`") #atomic => TemplateTail{Text: text($t)}
rule templateCharacters = ([^`\\$]+ / "$" !"{" / escapeSequence)*
rule rawNoSubstitutionTemplateLiteral NoSubstitutionTemplateLiteral = t:("`" rawTemplateCharacters "`") #atomic => NoSubstitutionTemplateLiteral{Text: text($t)}
rule rawTemplateHead TemplateHead = t:("`" rawTemplateCharacters "${") #atomic => TemplateHead{Text: text($t)}
rule rawTemplateMiddle TemplateMiddle = t:("}" rawTemplateCharacters "${") #atomic => TemplateMiddle{Text: text($t)}
rule rawTemplateTail TemplateTail = t:("}" rawTemplateCharacters "`") #atomic => TemplateTail{Text: text($t)}
rule rawTemplateCharacters = ([^`\\$]+ / "$" !"{" / "\\" .)*

// --- Regular expressions (reScanSlashToken) ---
// The body up to an unescaped "/" outside a class, on one line, and any identifier characters as flags;
// the parser does not check the pattern or the flags.
rule regularExpressionLiteral RegularExpressionLiteral = t:("/" ![*/] ([^/\\\[\n\r\u{2028}\u{2029}]+ / "\\" [^\n\r\u{2028}\u{2029}] / "[" ([^\]\\\n\r\u{2028}\u{2029}]+ / "\\" [^\n\r\u{2028}\u{2029}])* "]")+ "/" ([a-zA-Z0-9$_] / uniIdPart)*) #atomic => RegularExpressionLiteral{Text: text($t)}

// --- Whitespace and comments ---
// The whitespace characters of isWhiteSpaceSingleLine, and the line terminators of isLineBreak. Most calls find
// none, so a silent test of the next character comes first (it must include "/", the start of a comment).
rule ws = (&[ \t\n\r\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}/] ([ \t\n\r\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}]+ / "//" [^\n\r\u{2028}\u{2029}]* / "/*" (!"*/" .)* "*/"))*
rule sp = (&[ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}/] ([ \t\u{b}\u{c}\u{a0}\u{85}\u{1680}\u{2000}-\u{200b}\u{202f}\u{205f}\u{3000}\u{feff}]+ / "//" [^\n\r\u{2028}\u{2029}]* / "/*" (!"*/" [^\n\r\u{2028}\u{2029}])* "*/"))*

// Comma-separated lists, with an optional trailing comma
rule arrayBindingElementList = f:arrayBindingElement r:(-ws "," -ws e:arrayBindingElement)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule arrayElementList = f:arrayElement r:(-ws "," -ws e:arrayElement)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule bindingElementList = f:bindingElement r:(-ws "," -ws e:bindingElement)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule enumMemberList = f:enumMember r:(-ws "," -ws e:enumMember)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule exportSpecifierList = f:exportSpecifier r:(-ws "," -ws e:exportSpecifier)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule importAttributeList = f:importAttribute r:(-ws "," -ws e:importAttribute)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule importSpecifierList = f:importSpecifier r:(-ws "," -ws e:importSpecifier)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule jsdocParameterList = f:jsdocParameter r:(-ws "," -ws p:jsdocParameter)* => concat(list($f), map($r, (x) => x.$p))
rule jsxAttributeLikeList = f:jsxAttributeLike r:(-ws a:jsxAttributeLike)* => concat(list($f), map($r, (x) => x.$a))
rule objectLiteralElementList = (
    &objectLiteralElementStart f:objectLiteralElement
    r:(-ws "," -ws &objectLiteralElementStart e:objectLiteralElement)* (-ws ",")?
) => concat(list($f), map($r, (x) => x.$e))
rule tupleElementList = &typeStart f:tupleElement r:(-ws "," -ws &typeStart e:tupleElement)* (-ws ",")? => concat(list($f), map($r, (x) => x.$e))
rule typeParameterList = (
    &typeParameterStart f:typeParameter r:(-ws "," -ws &typeParameterStart p:typeParameter)* (-ws ",")?
) => concat(list($f), map($r, (x) => x.$p))
rule typeParameterStart = ("in" / "const") !idPart / identifier

// Unicode ID_Start and ID_Continue beyond ASCII, as TypeScript's tables have them (unicodeESNextIdentifierStart
// and unicodeESNextIdentifierPart); the first class rejects ASCII quickly.
