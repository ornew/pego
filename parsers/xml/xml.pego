// XML 1.0 (Fifth Edition), https://www.w3.org/TR/xml/, parsed into a typed AST.
//
// The grammar follows the productions of the specification (their numbers are given in brackets) for a
// document entity with an internal DTD subset, the part of XML that a non-validating processor reads
// without fetching external entities. It checks the syntax, the Char production everywhere, and the
// element type match. The other well-formedness constraints need the declarations of the DTD (entities
// declared, no recursion, no "<" in attribute values, ...) or a set of names (unique attributes); xml.go
// checks them after the parse.
//
// Character classes spell out Char ([2]) minus the characters a production excludes, so that no rule
// accepts a code point outside Char. Text (character data, attribute values, comments, ...) is kept as
// it is in the input; the helpers of xml.go normalize line ends and expand references.
package xml

// [1] document ::= prolog element Misc*
// [22] prolog ::= XMLDecl? Misc* (doctypedecl Misc*)?
type Document = {
    Decl    *XMLDecl
    Prolog  []Misc // comments and processing instructions before the root element, around the doctype
    Doctype *Doctype
    Root    Element
    Epilog  []Misc // comments and processing instructions after the root element
}

type XMLDecl = { Version Version; Encoding *EncName; Standalone *YesNo }
type Version terminal
type EncName terminal
type YesNo terminal
type Misc ~ Comment | PI

type Doctype = { Name Name; ExternalID *ExternalID; Subset []Decl }
type ExternalID = { Public *PubidLiteral; System *SystemLiteral }
type PubidLiteral terminal  // between the quotes
type SystemLiteral terminal // between the quotes
type Decl ~ ElementDecl | AttlistDecl | EntityDecl | NotationDecl | PI | Comment | PERef
type PERef terminal // "%name;"

type ElementDecl = { Name Name; Content ContentSpec }
type ContentSpec ~ Keyword | Mixed | Choice | Sequence
type Keyword terminal // EMPTY, ANY, CDATA, ID, ..., #REQUIRED, #IMPLIED, #FIXED
type Mixed = { Names []Name }
type Choice = { Items []Particle; Occur *Occurrence }
type Sequence = { Items []Particle; Occur *Occurrence }
type NameParticle = { Name Name; Occur *Occurrence }
type Particle ~ NameParticle | Choice | Sequence
type Occurrence terminal // ?, * or +

type AttlistDecl = { Name Name; Defs []AttDef }
type AttDef = { Name Name; Type AttType; Default *Keyword; Value *AttValue }
type AttType ~ Keyword | Enumeration | NotationType
type Enumeration = { Values []Nmtoken }
type NotationType = { Names []Name }
type Nmtoken terminal

type EntityDecl = { Parameter bool; Name Name; Value *EntityValue; ExternalID *ExternalID; NData *Name }
type EntityValue terminal // between the quotes
type NotationDecl = { Name Name; ExternalID ExternalID }

type Element = { Name Name; Attrs []Attribute; Content []Content }
type Attribute = { Name Name; Value AttValue }
type AttValue terminal // between the quotes
type Content ~ Element | CharData | EntityRef | CharRef | CDSect | PI | Comment
type CharData terminal
type EntityRef terminal // "&name;"
type CharRef terminal   // "&#...;"
type CDSect terminal    // between "<![CDATA[" and "]]>"
type PI = { Target Name; Data *PIData }
type PIData terminal
type Comment terminal // between "<!--" and "-->"
type Name terminal

// A byte order mark (U+FEFF) may precede the document (Appendix F).
rule main Document = (
    "\u{feff}"? d:xml_decl? p1:misc_list dt:doctype? p2:misc_list r:element e:misc_list $$
) => Document{Decl: $d, Prolog: concat($p1, $p2), Doctype: $dt, Root: $r, Epilog: $e}

// [27] Misc ::= Comment | PI | S
rule misc_list = ms:(-ws m:misc)* -ws => map($ms, (x) => x.m)
rule misc Misc = comment / pi

// [23] XMLDecl ::= '<?xml' VersionInfo EncodingDecl? SDDecl? S? '?>'
rule xml_decl XMLDecl = (
    "<?xml" v:version_info e:encoding_decl? sd:sd_decl? ws "?>"
) => XMLDecl{Version: $v, Encoding: $e, Standalone: $sd}
// [24] VersionInfo, [26] VersionNum ::= '1.' [0-9]+
rule version_info = s "version" eq ("\"" v:version_num "\"" / "'" v:version_num "'") => $v
rule version_num Version = "1." [0-9]+
// [80] EncodingDecl, [81] EncName ::= [A-Za-z] ([A-Za-z0-9._] | '-')*
rule encoding_decl = s "encoding" eq ("\"" e:enc_name "\"" / "'" e:enc_name "'") => $e
rule enc_name EncName = [A-Za-z] [A-Za-z0-9._\-]*
// [32] SDDecl
rule sd_decl = s "standalone" eq ("\"" v:yes_no "\"" / "'" v:yes_no "'") => $v
rule yes_no YesNo = "yes" / "no"
// [25] Eq ::= S? '=' S?
rule eq = ws "=" ws

// [15] Comment ::= '<!--' ((Char - '-') | ('-' (Char - '-')))* '-->'
rule comment = "<!--" c:comment_text "-->" => $c
rule comment_text Comment = ([.-\u{d7ff} -,\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / "-" [.-\u{d7ff} -,\n\t\r\u{e000}-�𐀀-\u{10ffff}])*

// [16] PI ::= '<?' PITarget (S (Char* - (Char* '?>' Char*)))? '?>'
// [17] PITarget ::= Name - (('X' | 'x') ('M' | 'm') ('L' | 'l'))
// The predicate fails at the end of a reserved target, so that its message is the error reported for a
// misplaced XML declaration (a lookahead before the name would record no position).
rule pi PI = (
    "<?" t:name {text($t) != "xml" && text($t) != "xmL" && text($t) != "xMl" && text($t) != "xML" && text($t) != "Xml" && text($t) != "XmL" && text($t) != "XMl" && text($t) != "XML"}
    @error(message="the processing instruction target xml is reserved (an XML declaration must come first)")
    (s d:pi_data)? "?>"
) => PI{Target: $t, Data: $d}
rule pi_data PIData = ([@-\u{d7ff} ->\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / "?" !">")*

// [28] doctypedecl ::= '<!DOCTYPE' S Name (S ExternalID)? S? ('[' intSubset ']' S?)? '>'
rule doctype Doctype = (
    "<!DOCTYPE" s n:name (s x:external_id)? ws ("[" ds:int_subset "]" ws)? ">"
) => Doctype{Name: $n, ExternalID: $x, Subset: concat($ds)}
// [28b] intSubset ::= (markupdecl | DeclSep)*, [28a] DeclSep ::= PEReference | S,
// [29] markupdecl ::= elementdecl | AttlistDecl | EntityDecl | NotationDecl | PI | Comment.
// In the internal subset, parameter-entity references occur only between declarations (WFC: PEs in
// Internal Subset), so none of the declarations below accepts one.
rule int_subset = ds:(-ws d:decl)* -ws => map($ds, (x) => x.d)
rule decl Decl = element_decl / attlist_decl / entity_decl / notation_decl / pi / comment / pe_ref
// [69] PEReference ::= '%' Name ';'
rule pe_ref PERef = "%" name ";"

// [75] ExternalID ::= 'SYSTEM' S SystemLiteral | 'PUBLIC' S PubidLiteral S SystemLiteral
rule external_id ExternalID = system_id / public_id
rule system_id ExternalID = "SYSTEM" s l:system_literal => ExternalID{System: $l}
rule public_id ExternalID = "PUBLIC" s p:pubid_literal s l:system_literal => ExternalID{Public: $p, System: $l}
// [11] SystemLiteral ::= ('"' [^"]* '"') | ("'" [^']* "'")
rule system_literal = "\"" l:system_dq "\"" / "'" l:system_sq "'" => $l
rule system_dq SystemLiteral = [#-\u{d7ff} -!\n\t\r\u{e000}-�𐀀-\u{10ffff}]*
rule system_sq SystemLiteral = [(-\u{d7ff} -&\n\t\r\u{e000}-�𐀀-\u{10ffff}]*
// [12] PubidLiteral, [13] PubidChar ::= #x20 | #xD | #xA | [a-zA-Z0-9] | [-'()+,./:=?;!*#@$_%]
rule pubid_literal = "\"" l:pubid_dq "\"" / "'" l:pubid_sq "'" => $l
rule pubid_dq PubidLiteral = [a-zA-Z0-9 \r\n\-'()+,./:=?;!*#@$_%]*
rule pubid_sq PubidLiteral = [a-zA-Z0-9 \r\n\-()+,./:=?;!*#@$_%]*

// [45] elementdecl ::= '<!ELEMENT' S Name S contentspec S? '>'
// [46] contentspec ::= 'EMPTY' | 'ANY' | Mixed | children
rule element_decl ElementDecl = "<!ELEMENT" s n:name s c:content_spec ws ">" => ElementDecl{Name: $n, Content: $c}
rule content_spec ContentSpec = kw_empty / kw_any / mixed / choice / sequence
rule kw_empty Keyword = "EMPTY"
rule kw_any Keyword = "ANY"
// [51] Mixed ::= '(' S? '#PCDATA' (S? '|' S? Name)* S? ')*' | '(' S? '#PCDATA' S? ')'
rule mixed Mixed = (
    "(" ws "#PCDATA" ns:(-ws -"|" -ws n:name)* ws (")*" / ")" {len($ns) == 0})
) => Mixed{Names: map($ns, (x) => x.n)}
// [47] children ::= (choice | seq) ('?' | '*' | '+')?, [48] cp ::= (Name | choice | seq) ('?' | '*' | '+')?
// [49] choice ::= '(' S? cp ( S? '|' S? cp )+ S? ')', [50] seq ::= '(' S? cp ( S? ',' S? cp )* S? ')'
rule choice Choice = (
    "(" ws f:cp rs:(-ws -"|" -ws c:cp)+ ws ")" o:occurrence?
) => Choice{Items: concat(list($f), map($rs, (x) => x.c)), Occur: $o}
rule sequence Sequence = (
    "(" ws f:cp rs:(-ws -"," -ws c:cp)* ws ")" o:occurrence?
) => Sequence{Items: concat(list($f), map($rs, (x) => x.c)), Occur: $o}
rule cp Particle = name_particle / choice / sequence
rule name_particle NameParticle = n:name o:occurrence? => NameParticle{Name: $n, Occur: $o}
rule occurrence Occurrence = [*+?]

// [52] AttlistDecl ::= '<!ATTLIST' S Name AttDef* S? '>'
// [53] AttDef ::= S Name S AttType S DefaultDecl
// [60] DefaultDecl ::= '#REQUIRED' | '#IMPLIED' | (('#FIXED' S)? AttValue)
rule attlist_decl AttlistDecl = (
    "<!ATTLIST" s n:name ds:(-s d:att_def)* ws ">"
) => AttlistDecl{Name: $n, Defs: map($ds, (x) => x.d)}
rule att_def AttDef = (
    n:name s t:att_type s (k:kw_required / (k:kw_fixed s)? v:att_value)
) => AttDef{Name: $n, Type: $t, Default: $k, Value: $v}
rule kw_required Keyword = "#REQUIRED" / "#IMPLIED"
rule kw_fixed Keyword = "#FIXED"
// [54] AttType ::= StringType | TokenizedType | EnumeratedType
rule att_type AttType = kw_type / notation_type / enumeration
rule kw_type Keyword = "CDATA" / "IDREFS" / "IDREF" / "ID" / "ENTITY" / "ENTITIES" / "NMTOKENS" / "NMTOKEN"
// [58] NotationType ::= 'NOTATION' S '(' S? Name (S? '|' S? Name)* S? ')'
rule notation_type NotationType = (
    "NOTATION" s "(" ws f:name rs:(-ws -"|" -ws n:name)* ws ")"
) => NotationType{Names: concat(list($f), map($rs, (x) => x.n))}
// [59] Enumeration ::= '(' S? Nmtoken (S? '|' S? Nmtoken)* S? ')'
rule enumeration Enumeration = (
    "(" ws f:nmtoken rs:(-ws -"|" -ws n:nmtoken)* ws ")"
) => Enumeration{Values: concat(list($f), map($rs, (x) => x.n))}

// [70] EntityDecl ::= GEDecl | PEDecl
// [71] GEDecl ::= '<!ENTITY' S Name S EntityDef S? '>', [73] EntityDef ::= EntityValue | (ExternalID NDataDecl?)
// [72] PEDecl ::= '<!ENTITY' S '%' S Name S PEDef S? '>', [74] PEDef ::= EntityValue | ExternalID
rule entity_decl EntityDecl = ge_decl / pe_decl
rule ge_decl EntityDecl = (
    "<!ENTITY" s n:name s (v:entity_value / x:external_id (s "NDATA" s nd:name)?) ws ">"
) => EntityDecl{Parameter: false, Name: $n, Value: $v, ExternalID: $x, NData: $nd}
rule pe_decl EntityDecl = (
    "<!ENTITY" s "%" s n:name s (v:entity_value / x:external_id) ws ">"
) => EntityDecl{Parameter: true, Name: $n, Value: $v, ExternalID: $x}
// [9] EntityValue ::= '"' ([^%&"] | PEReference | Reference)* '"' | "'" ([^%&'] | PEReference | Reference)* "'"
// without PEReference, which the internal subset does not allow inside a declaration.
rule entity_value = "\"" v:entity_dq "\"" / "'" v:entity_sq "'" => $v
rule entity_dq EntityValue = (['-\u{d7ff} -!#-$\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / reference)*
rule entity_sq EntityValue = ([(-\u{d7ff} -$\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / reference)*

// [82] NotationDecl ::= '<!NOTATION' S Name S (ExternalID | PublicID) S? '>', [83] PublicID ::= 'PUBLIC' S PubidLiteral
rule notation_decl NotationDecl = "<!NOTATION" s n:name s x:notation_id ws ">" => NotationDecl{Name: $n, ExternalID: $x}
rule notation_id ExternalID = system_id / public_notation
rule public_notation ExternalID = "PUBLIC" s p:pubid_literal (s l:system_literal)? => ExternalID{Public: $p, System: $l}

// [39] element ::= EmptyElemTag | STag content ETag
// [40] STag ::= '<' Name (S Attribute)* S? '>', [44] EmptyElemTag ::= '<' Name (S Attribute)* S? '/>'
// [42] ETag ::= '</' Name S? '>' (WFC: Element Type Match)
// One rule for both forms, so that the start tag is not parsed twice.
rule element Element = (
    "<" n:name as:(-s a:attribute)* ws ("/>" / ">" cs:content "</" e:name {text($e) == text($n)} @error(message="mismatched end tag") ws ">")
) => Element{Name: $n, Attrs: map($as, (x) => x.a), Content: concat($cs)}
// [41] Attribute ::= Name Eq AttValue
rule attribute Attribute = n:name eq v:att_value => Attribute{Name: $n, Value: $v}
// [10] AttValue ::= '"' ([^<&"] | Reference)* '"' | "'" ([^<&'] | Reference)* "'"
rule att_value = "\"" v:att_dq "\"" / "'" v:att_sq "'" => $v
rule att_dq AttValue = ([=-\u{d7ff}'-; -!#-%\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / reference)*
rule att_sq AttValue = ([=-\u{d7ff}(-; -%\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / reference)*

// [43] content ::= CharData? ((element | Reference | CDSect | PI | Comment) CharData?)*
rule content = content_item*
rule content_item Content = char_data / markup
// Content ends at an end tag: the lookahead saves trying (and memoizing) every alternative there, which
// makes ParseAST about 10% faster and Recognize about 30%.
rule markup Content = !"</" c:(element / reference / comment / cdsect / pi) => $c
// [14] CharData ::= [^<&]* - ([^<&]* ']]>' [^<&]*)
rule char_data CharData = ([\^-\u{d7ff}=-\\'-; -%\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / "]" !"]>")+
// [18] CDSect ::= CDStart CData CDEnd, [20] CData ::= (Char* - (Char* ']]>' Char*))
rule cdsect = "<![CDATA[" c:cdata "]]>" => $c
rule cdata CDSect = ([\^-\u{d7ff} -\\\n\t\r\u{e000}-�𐀀-\u{10ffff}]+ / "]" !"]>")*

// [67] Reference ::= EntityRef | CharRef, [68] EntityRef ::= '&' Name ';'
// [66] CharRef ::= '&#' [0-9]+ ';' | '&#x' [0-9a-fA-F]+ ';'
rule reference = char_ref / entity_ref
rule char_ref CharRef = "&#x" [0-9a-fA-F]+ ";" / "&#" [0-9]+ ";"
rule entity_ref EntityRef = "&" name ";"

// [5] Name ::= NameStartChar (NameChar)*
// [4] NameStartChar ::= ":" | [A-Z] | "_" | [a-z] | [#xC0-#xD6] | [#xD8-#xF6] | [#xF8-#x2FF] | [#x370-#x37D]
//     | [#x37F-#x1FFF] | [#x200C-#x200D] | [#x2070-#x218F] | [#x2C00-#x2FEF] | [#x3001-#xD7FF] | [#xF900-#xFDCF]
//     | [#xFDF0-#xFFFD] | [#x10000-#xEFFFF]
// [4a] NameChar ::= NameStartChar | "-" | "." | [0-9] | #xB7 | [#x0300-#x036F] | [#x203F-#x2040]
// The name characters are an inline class rather than a call of name_char, which makes ParseAST about
// 7% faster.
rule name Name = (
    [a-zA-Z_:À-ÖØ-öø-˿Ͱ-ͽͿ-\u{1fff}\u{200c}-\u{200d}⁰-\u{218f}Ⰰ-\u{2fef}、-\u{d7ff}豈-﷏ﷰ-�𐀀-\u{effff}]
    [a-zA-Z0-9_:.\-·À-ÖØ-öø-ͽͿ-\u{1fff}\u{200c}-\u{200d}‿-⁀⁰-\u{218f}Ⰰ-\u{2fef}、-\u{d7ff}豈-﷏ﷰ-�𐀀-\u{effff}]*
)
rule name_char = [a-zA-Z0-9_:.\-·À-ÖØ-öø-ͽͿ-\u{1fff}\u{200c}-\u{200d}‿-⁀⁰-\u{218f}Ⰰ-\u{2fef}、-\u{d7ff}豈-﷏ﷰ-�𐀀-\u{effff}]
// [7] Nmtoken ::= (NameChar)+
rule nmtoken Nmtoken = name_char+

// [3] S ::= (#x20 | #x9 | #xD | #xA)+
rule s = [ \t\r\n]+
rule ws = [ \t\r\n]*
