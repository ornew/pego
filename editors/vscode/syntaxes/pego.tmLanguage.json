{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PEGO",
  "scopeName": "source.pego",
  "fileTypes": [
    "pego"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#package"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#rule-definition"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.pego",
          "patterns": [
            {
              "include": "#comment-block"
            }
          ]
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.pego"
        }
      ]
    },
    "package": {
      "match": "(?:^|(?<=;))[ \\t]*(package)[ \\t]+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.package.pego"
        },
        "2": {
          "name": "entity.name.namespace.pego"
        }
      }
    },
    "type-definition": {
      "patterns": [
        {
          "comment": "type Name struct { Field Type, ... }",
          "begin": "(?:^|(?<=;))[ \\t]*(type)[ \\t]+([\\p{L}_][\\p{L}\\p{Nd}_]*)[ \\t]+(struct)[ \\t]*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.pego"
            },
            "2": {
              "name": "entity.name.type.pego"
            },
            "3": {
              "name": "storage.type.struct.pego"
            },
            "4": {
              "name": "punctuation.definition.block.begin.pego"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.pego"
            }
          },
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#field"
            },
            {
              "include": "#type-expression"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.pego"
            }
          ]
        },
        {
          "comment": "A type alias; only its own parenthesized type permits continuation.",
          "begin": "(?:^|(?<=;))[ \\t]*(type)[ \\t]+([\\p{L}_][\\p{L}\\p{Nd}_]*)[ \\t]*(=)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.pego"
            },
            "2": {
              "name": "entity.name.type.pego"
            },
            "3": {
              "name": "keyword.operator.assignment.pego"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ],
          "end": "(?=;)|$"
        },
        {
          "comment": "type Name terminal, and a type definition being written",
          "match": "(?:^|(?<=;))[ \\t]*(type)\\b(?:[ \\t]+([\\p{L}_][\\p{L}\\p{Nd}_]*)(?:[ \\t]+(terminal|struct)\\b)?)?",
          "captures": {
            "1": {
              "name": "storage.type.pego"
            },
            "2": {
              "name": "entity.name.type.pego"
            },
            "3": {
              "name": "storage.type.$3.pego"
            }
          }
        }
      ]
    },
    "field": {
      "comment": "The name of a struct field: the first identifier on a line, or after { or ,",
      "match": "(?:^|(?<=[{,]))\\s*([\\p{L}_][\\p{L}\\p{Nd}_]*)",
      "captures": {
        "1": {
          "name": "variable.other.property.pego"
        }
      }
    },
    "type-expression": {
      "patterns": [
        {
          "include": "#type-parenthesized"
        },
        {
          "include": "#comment"
        },
        {
          "match": "\\b(int|string|bool|node|terminal|Match|Seq|List|Operator|Error)\\b",
          "name": "support.type.builtin.pego"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{Nd}_]*",
          "name": "entity.name.type.pego"
        },
        {
          "match": "\\[\\]|\\*",
          "name": "keyword.operator.type.pego"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.union.pego"
        },
        {
          "match": "[()]",
          "name": "punctuation.parenthesis.pego"
        }
      ]
    },
    "rule-definition": {
      "patterns": [
        {
          "comment": "rule name Type =, with an optional type",
          "begin": "(?:^|(?<=;))[ \\t]*(rule)[ \\t]+([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "beginCaptures": {
            "1": {
              "name": "storage.type.function.pego"
            },
            "2": {
              "name": "entity.name.function.pego"
            }
          },
          "end": "(=)|(?=;)|$",
          "endCaptures": {
            "1": {
              "name": "keyword.operator.assignment.pego"
            }
          },
          "patterns": [
            {
              "include": "#type-expression"
            }
          ]
        },
        {
          "match": "(?:^|(?<=;))[ \\t]*(rule)\\b",
          "captures": {
            "1": {
              "name": "storage.type.function.pego"
            }
          }
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#char-class"
        },
        {
          "include": "#operators-rule"
        },
        {
          "include": "#value-action"
        },
        {
          "include": "#level-call"
        },
        {
          "include": "#peg-group"
        },
        {
          "include": "#predicate"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#constructor"
        },
        {
          "include": "#builtin-function"
        },
        {
          "include": "#capture-label"
        },
        {
          "include": "#capture-reference"
        },
        {
          "include": "#member"
        },
        {
          "include": "#number"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.pego"
        }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.pego"
        }
      },
      "name": "string.quoted.double.pego",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|[ntrfvab0]|[^A-Za-z0-9])",
          "name": "constant.character.escape.pego"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.pego"
        }
      ]
    },
    "char-class": {
      "comment": "[a-z_], [^a-z]",
      "begin": "(\\[(?!\\]))(\\^)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.character-class.begin.pego"
        },
        "2": {
          "name": "keyword.operator.negation.pego"
        }
      },
      "end": "(\\])|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.character-class.end.pego"
        }
      },
      "name": "string.regexp.character-class.pego",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "match": "(?<!\\[|\\[\\^)-(?!\\])",
          "name": "keyword.operator.range.pego"
        }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "comment": "@attribute(args) or #pragma(args)",
          "begin": "([@#])([\\p{L}_][\\p{L}\\p{Nd}_]*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.pego"
            },
            "2": {
              "name": "entity.other.attribute-name.pego"
            },
            "3": {
              "name": "punctuation.parenthesis.begin.pego"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.parenthesis.end.pego"
            }
          },
          "patterns": [
            {
              "match": "([\\p{L}_][\\p{L}\\p{Nd}_]*)\\s*(=)(?!=)",
              "captures": {
                "1": {
                  "name": "variable.parameter.attribute.pego"
                },
                "2": {
                  "name": "keyword.operator.assignment.pego"
                }
              }
            },
            {
              "include": "#parenthesized"
            },
            {
              "include": "#body"
            }
          ]
        },
        {
          "match": "([@#])([\\p{L}_][\\p{L}\\p{Nd}_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.pego"
            },
            "2": {
              "name": "entity.other.attribute-name.pego"
            }
          },
          "comment": ""
        }
      ]
    },
    "parenthesized": {
      "comment": "A group inside attribute arguments, so that its ) does not end them",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parenthesized"
        },
        {
          "include": "#body"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(true|false|nil)\\b",
          "name": "constant.language.pego"
        }
      ]
    },
    "builtin-function": {
      "match": "\\b(len|text|foldl|foldr|map|list|concat)(?=\\()",
      "name": "support.function.builtin.pego"
    },
    "capture-label": {
      "comment": "label:expr and constructor fields Type{Field: value}",
      "match": "([\\p{L}_][\\p{L}\\p{Nd}_]*)(:)(?![=])",
      "captures": {
        "1": {
          "name": "variable.other.capture.pego"
        },
        "2": {
          "name": "punctuation.separator.capture.pego"
        }
      }
    },
    "capture-reference": {
      "match": "\\$(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|[0-9]+)",
      "name": "variable.parameter.capture.pego"
    },
    "member": {
      "match": "(\\.)([\\p{L}_][\\p{L}\\p{Nd}_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.pego"
        },
        "2": {
          "name": "variable.other.property.pego"
        }
      }
    },
    "number": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.integer.pego"
    },
    "operator": {
      "patterns": [
        {
          "match": "\\.\\.\\.",
          "name": "constant.language.default-action.pego"
        },
        {
          "match": "=>",
          "name": "keyword.operator.arrow.pego"
        },
        {
          "match": ":=",
          "name": "keyword.operator.assignment.pego"
        },
        {
          "match": "_\\|_",
          "name": "constant.language.bottom.pego"
        },
        {
          "match": "--",
          "name": "keyword.control.cut.pego"
        },
        {
          "match": "\\^\\^|\\$\\$|\\^|\\$",
          "name": "keyword.operator.anchor.pego"
        },
        {
          "match": "(?<![\\p{L}\\p{Nd}_])_(?![\\p{L}\\p{Nd}_])",
          "name": "constant.language.top.pego"
        },
        {
          "match": "==|!=|<=|>=|&&|\\|\\||<|>|%",
          "name": "keyword.operator.pego"
        },
        {
          "match": "[*+?]",
          "name": "keyword.operator.quantifier.pego"
        },
        {
          "match": "/",
          "name": "keyword.operator.choice.pego"
        },
        {
          "match": "[&!]",
          "name": "keyword.operator.lookahead.pego"
        },
        {
          "match": "-",
          "name": "keyword.operator.discard.pego"
        },
        {
          "match": "\\.",
          "name": "constant.language.any.pego"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.pego"
        },
        {
          "match": "[{}()\\[\\],;]",
          "name": "punctuation.pego"
        }
      ]
    },
    "comment-block": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.pego",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "constructor": {
      "match": "\\b[\\p{L}_][\\p{L}\\p{Nd}_]*(?=\\s*\\{)",
      "name": "entity.name.type.pego"
    },
    "predicate": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.predicate-action.pego",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.predicate.begin.pego"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.predicate.end.pego"
        }
      },
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "type-parenthesized": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#type-expression"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#value-constructor"
        },
        {
          "include": "#value-parenthesized"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#builtin-function"
        },
        {
          "include": "#capture-reference"
        },
        {
          "include": "#member"
        },
        {
          "include": "#number"
        },
        {
          "include": "#operator"
        }
      ]
    },
    "value-parenthesized": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "value-constructor": {
      "begin": "\\b([\\p{L}_][\\p{L}\\p{Nd}_]*)[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.pego"
        },
        "2": {
          "name": "punctuation.definition.block.begin.pego"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.pego"
        }
      },
      "patterns": [
        {
          "include": "#value-field"
        },
        {
          "include": "#value"
        }
      ]
    },
    "value-field": {
      "match": "\\b([\\p{L}_][\\p{L}\\p{Nd}_]*)[ \\t]*(:)(?!=)",
      "captures": {
        "1": {
          "name": "variable.other.property.pego"
        },
        "2": {
          "name": "punctuation.separator.key-value.pego"
        }
      }
    },
    "value-action": {
      "begin": "(=>)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.arrow.pego"
        }
      },
      "end": "(?=[;})])|$",
      "name": "meta.value-action.pego",
      "patterns": [
        {
          "include": "#value-action-block"
        },
        {
          "include": "#value"
        }
      ]
    },
    "value-action-block": {
      "begin": "\\{",
      "end": "\\}",
      "name": "meta.value-action-block.pego",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "peg-group": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#body"
        }
      ]
    },
    "operators-rule": {
      "begin": "(?<==)[ \\t]*(operators)[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.operators-rule.pego"
        },
        "2": {
          "name": "punctuation.definition.block.begin.pego"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#level-declaration"
        },
        {
          "include": "#operators-header"
        },
        {
          "include": "#body"
        }
      ]
    },
    "level-declaration": {
      "begin": "(?:^|(?<=[;{]))[ \\t]*(level)\\b(?:[ \\t]+([\\p{L}_][\\p{L}\\p{Nd}_]*))?[ \\t]*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.operators-rule.pego"
        },
        "2": {
          "name": "entity.name.level.pego"
        },
        "3": {
          "name": "punctuation.definition.block.begin.pego"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#operators-header"
        },
        {
          "include": "#body"
        }
      ]
    },
    "operators-header": {
      "patterns": [
        {
          "match": "(?:^|(?<=[;{]))[ \\t]*(infix)[ \\t]+(left|right|none)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.operators-rule.pego"
            },
            "2": {
              "name": "keyword.other.associativity.pego"
            }
          }
        },
        {
          "match": "(?:^|(?<=[;{]))[ \\t]*(skip|operand|level|prefix|postfix|infix)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.operators-rule.pego"
            }
          }
        }
      ]
    },
    "level-call": {
      "match": "\\b(level)(?=\\()",
      "captures": {
        "1": {
          "name": "keyword.control.operators-rule.pego"
        }
      }
    }
  }
}
