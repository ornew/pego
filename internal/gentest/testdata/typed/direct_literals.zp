// Direct rules of the typed runtime: literals compared in place (one to four code points) or by
// matchLiteral (longer ones, and in Bytes), non-ASCII ones, and literals cut off by the end of the
// input.
type W = { A *node[string]; B *node[string]; C *node[string]; D *node[string] }
rule main W = (
    a:("é" / "ab") b:("→→" / "→") c:("abcd" / "abc") d:("abcde" / "ab")? $$
) => W{A: $a, B: $b, C: $c, D: $d}
