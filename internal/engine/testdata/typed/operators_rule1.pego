type Number = { Text string }
type Binary = { Left Expr; Op node[string]; Right Expr }
type Unary = { Op node[string]; X *Expr }
type Post = { X Expr; Op node[_]; Args []Expr }
type Expr ~ Number | Binary | Unary | Post
rule main Expr = e:expr ws $$ => $e
rule expr Expr = operators {
    skip ws
    operand number
    operand "(" #cut e:expr ws ")" => $e
    operand v1:"[" e:expr? ws "]" => Unary{Op: $v1, X: $e}
    level { infix left o:("+" / "-") ws => Binary{Left: $lhs, Op: $o, Right: $rhs} }
    level { infix left "*" / "/" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { prefix "-" => Unary{Op: $op, X: $rhs} }
    level {
        postfix "!" => Post{X: $lhs, Op: $op, Args: list()}
        postfix "{" #cut a:(x:expr ws ",")* ws "}" => Post{X: $lhs, Op: $op, Args: map($a, (q) => q.$x)}
    }
    level { infix right "^" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
}
rule number Number = t:([0-9]+ #recover(skip=[a-z]+)) #atomic => Number{Text: text($t)}
rule ws = [ ]*
