// Direct rules of the typed runtime: captures restored when a choice, an optional or a repetition
// element fails after setting them (also captures inside & in a repetition without a scope of its
// own), an environment restored when an alternative that bound a variable fails, and
// first-character tests of alternatives after one that read further characters; a plain rule that
// binds a variable (bump) restores the environment when it returns.
type Name = node[string]
type A = { X *Name; Y *Name; Z *Name; Q *Name; W *Name; P []Name; Last *Name; Mode int; Sign *node[string] }
type L = { Items []A }
var m int
rule main L = {m := 0} xs:(a:alt -";"?)* $$ => L{Items: map($xs, (e) => e.$a)}
rule alt A = (
    (x:name "+" y:name "!" / x:name "+" z:name)
    ("(" q:name ")")? ("(" w:name ".")?
    ("[" ps:(&p:name name ",")* last:name "]")?
    ({m := 1} "<" / ">")? bump? s:("-" [0-9] "!" / "-" [0-9] "?" / "+")? #atomic
) => A{X: $x, Y: $y, Z: $z, Q: $q, W: $w, P: map($ps, (e) => e.$p), Last: $last, Mode: m, Sign: $s}
rule name Name = ([a-z]+) #atomic
rule bump = {m := 7} "~"
