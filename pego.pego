// PEGO grammar syntax and typed source tree.
// Source forms are preserved before semantic validation and compilation.
package pego

type Ident terminal
type Int terminal
type String terminal
type True terminal
type False terminal
type Nil terminal
type CaptureRef terminal
type VarRef terminal

type File = { Package *PackageStmt; Defs []Def; Comments []Comment; TrailingComments []Comment; Text string }
type PackageStmt ~ Package | Error
type Package = { Name Ident; Comments []Comment; Source SourceMetadata }
type PackageBody = { Name Ident }
// Ownership is constructed at syntax boundaries; the adapter only converts spans.
type SourceSpan ~ PackageBody | TypeDefBody
type SourceMetadata = { Span SourceSpan; Leading string; Trailing string; Detached []SourceComment }
type SourceComment = { Text string }
type SourceBoundary = { Trailing string; Leading string; Detached []SourceComment; HasNext bool }
type Def ~ TypeDef | RuleDef | Error
type TypeDef = { Name Ident; Spec TypeSpec; Comments []Comment; SourceSpan TypeDefBody }
type TypeDefBody = { Name Ident; Spec TypeSpec }
type TypeSpec ~ TypeAliasSpec | TerminalSpec | StructSpec
type TypeAliasSpec = { Type Type }
type TerminalSpec = {}
type StructSpec = { Fields []FieldSpec; Comments []Comment }
type FieldSpec ~ Field | Error
type Field = { Name Ident; Type Type; Comments []Comment }
type Type ~ TypeRef | TypeApp | TypeGroup | TupleType | StructType | OptionalType | ListType | UnionType | IntersectionType | Bottom
type TypeRef = { Name Ident }
type TypeApp = { Name Ident; Args []Type } // T[U]
type TypeGroup = { Type Type }
type TupleType = { Types []Type } // (), (T,), (T, U)
type StructType = { Fields []FieldSpec; Comments []Comment } // { A T; B U }
type OptionalType = { Type Type }
type ListType = { Type Type }
type UnionType = { L Type; R Type }
type IntersectionType = { L Type; R Type }

type Comment ~ CommentGroup | InlineComment
type CommentGroup = { Lines []Match }
type InlineComment = { Start Match; Body Match; End Match }
type RuleDef = { Name Ident; Type *Type; Expr RuleExpr; Action *Action; Comments []Comment }
type RuleExpr ~ (
  RuleRef | LevelCall | RuleGroup | InlineAction | Sequence | Choice
  | Discard | Lookahead | Top | Bottom | BeginLine | BeginInput | EndLine | EndInput
  | Any | Cut | String | CharClass | Optional | ZeroOrMore | OneOrMore
  | Repeat | Capture | Predicate | Atomic | Stream | MissingPragma | Recover | Attributed | OperatorsRule
)
type RuleRef = { Name Ident }
type LevelCall = { Rule Ident; Level Ident }
type RuleGroup = { Expr RuleExpr }
type InlineAction = { Expr RuleExpr; Action Action }
type Sequence = { L RuleExpr; R RuleExpr }
type Choice = { L RuleExpr; R RuleExpr }
type Discard = { X RuleExpr }
type Lookahead = { Op string; X RuleExpr }
type Top terminal
type Bottom terminal
type BeginLine terminal
type BeginInput terminal
type EndLine terminal
type EndInput terminal
type Any terminal
type Cut terminal
type CharClass = { Not bool; Items []CharClassItem }
type CharClassItem ~ Char | CharRng
type Char terminal
type CharRng = { Start Char; End Char }
type Optional = { X RuleExpr }
type ZeroOrMore = { X RuleExpr }
type OneOrMore = { X RuleExpr }
type Repeat = { X RuleExpr; Min *Int; Max *Int; Range bool }
type Capture = { Name Ident; Expr RuleExpr }
type Predicate = { Actions []ActionStmt; Comments []Comment }
type Atomic = { X RuleExpr }
type Stream = { X RuleExpr }
type MissingPragma = { X RuleExpr }
type Recover = { X RuleExpr; Skip RuleExpr }
type Attributed = { X RuleExpr; Attr Attr }
type Attr = { Name Ident; Args []*AttrValue; KwArgs []AttrNamed }
type AttrValue ~ Int | String | True | False | Nil | RuleExpr
// Slots keep an omitted positional argument distinct from the end of a list.
type AttrSlot = { Value *AttrValue }
type AttrNamed = { Name Ident; Value AttrValue }
type AttrArgs = { Args []*AttrValue; KwArgs []AttrNamed }

type OperatorsRule = { Items []OperatorsStmt; Comments []Comment }
type OperatorsStmt ~ OperatorsSkip | OperatorsOperand | OperatorsLevel | Error
type OperatorsSkip = { Expr RuleExpr; Comments []Comment }
type OperatorsOperand = { Expr RuleExpr; Action *Action; Comments []Comment }
type OperatorsLevel = { Name *Ident; Operators []OpsOperator; Comments []Comment }
type OpsOperator ~ Prefix | Postfix | Infix | Error
type Prefix = { Expr RuleExpr; Action *Action; Comments []Comment }
type Postfix = { Expr RuleExpr; Action *Action; Comments []Comment }
type Infix = { Assoc string; Expr RuleExpr; Action *Action; Comments []Comment }

type Action ~ ActionExpr | ActionBlock | DefaultAction
type ActionStmt ~ ActionAssign | ActionExpr | Error
type ActionAssign = { Name Ident; Expr ActionExpr }
type ActionBlock = { Actions []ActionStmt; Comments []Comment }
type DefaultAction terminal
type ActionExpr ~ (
  Int | String | True | False | Nil | CaptureRef | VarRef
  | BinaryOp | UnaryOp | FieldAccess | CaptureAccess | Cast | Call | Constructor | ListConstructor | TerminalConstructor | ActionGroup | Lambda
)
type BinaryOp = { Op string; L ActionExpr; R ActionExpr }
type UnaryOp = { Op string; X ActionExpr }
type FieldAccess = { X ActionExpr; Name Ident }
type CaptureAccess = { X ActionExpr; Capture CaptureRef } // x.$y
type Cast = { X ActionExpr; Type Type } // x.(T)
type Call = { X ActionExpr; Args []ActionExpr }
type Constructor = { X ActionExpr; Inits []InitField; Comments []Comment }
type ListConstructor = { Elem Type; Items []ActionExpr; Comments []Comment }
type TerminalConstructor = { Type VarRef; Args []ActionExpr; Comments []Comment }
type InitField = { Name Ident; Val ActionExpr; Comments []Comment }
type ActionGroup = { Expr ActionExpr }
type Lambda = { Params []Ident; Body ActionExpr }

// File and statements. Delimiter-owned expressions enable multiline trivia;
// declaration and item lists keep physical newlines as statement boundaries.
rule main File = f:file => $f
rule file File = (
  &cs:source_comments &src:(.* #atomic) f:file_contents
) => File{
  Package: $f.Package,
  Defs: $f.Defs,
  Comments: $cs,
  TrailingComments: $f.TrailingComments,
  Text: text($src),
}
rule file_contents File = (
  {ml := false}
  pkg:package_entry?
  defs:(-empty_stmts d:def_stmt)*
  -empty_stmts tc:comments $$
) => File{Package: $pkg, Defs: map($defs, (x) => x.$d), TrailingComments: $tc}
rule empty_stmts = (";" -comments)*
rule package_entry PackageStmt = &(comments "package" !ident_char) p:(package_stmt #recover(skip=stmt_sync)) => $p
rule package_stmt Package = (
  &lead:source_remaining cs:comments
  body:package_body &tail:source_package_tail tc:stmt_end
) => Package{Name: $body.Name, Comments: concat($cs, $tc), Source: SourceMetadata{
  Span: $body, Leading: $lead.Leading, Detached: $lead.Detached, Trailing: $tail.Trailing,
}}
rule package_body PackageBody = (
  "package" -word_end #cut name:(ident @error(message="expected package name"))
) => PackageBody{Name: $name}
rule source_package_tail SourceBoundary = -";"? b:source_after_boundary => $b
rule def_stmt Def = (
  !(comments $$)
  d:((type_def_stmt / rule_def_stmt / _|_ @error(message="expected type or rule declaration")) #recover(skip=stmt_sync))
) => $d
rule stmt_end []Comment = (
  cs:horizontal tail:(stmt_sep @error(message="expected semicolon, newline, or end of file"))
) => concat($cs, $tail)
rule item_end []Comment = (
  cs:horizontal tail:(item_sep @error(message="expected semicolon, newline, or closing brace"))
) => concat($cs, $tail)
rule field_end []Comment = (
  cs:horizontal tail:(field_sep @error(message="expected semicolon, newline, or closing brace"))
) => concat($cs, $tail)
rule stmt_sep []Comment = block_sep / empty_stmt_sep
rule item_sep []Comment = block_sep / empty_item_sep
rule field_sep []Comment = block_sep / empty_field_sep
rule block_sep []Comment = c:block_with_line => list($c)
rule empty_stmt_sep []Comment = (";" / nl / &$$) => list()
rule empty_item_sep []Comment = (";" / nl / &"}") => list()
rule empty_field_sep []Comment = (";" / nl / &"}") => list()
// Recovery consumes its own separator and stops before the next item.
rule stmt_sync = -comments (sync_token / !(";" / nl) .)* (";" / nl / &$$)
rule item_sync = -comments (sync_token / !(";" / nl / "}") .)* (";" / nl / &"}" / &$$)
rule field_sync = -comments (sync_token / !(";" / nl / "}") .)* (";" / nl / &"}" / &$$)

// Completed literals, nested comments and groups do not end recovery.
rule sync_token = string / char_class / inline_comment / comment_line / sync_paren / sync_brace
rule sync_paren = "(" (sync_token / !("(" / ")" / nl) .)* ")"
rule sync_brace = "{" (sync_token / !("{" / "}" / nl) .)* "}"

// Types. Union is the weakest operation; list and optional prefixes nest.
rule type_def_stmt TypeDef = (
  cs:comments d:type_def_body tc:stmt_end
) => TypeDef{Name: $d.Name, Spec: $d.Spec, Comments: concat($cs, $tc), SourceSpan: $d}
// The body starts at the keyword and ends before the statement separator.
// Its typed node retains the actual parse span without repeating recovery.
rule type_def_body TypeDefBody = (
  "type" -word_end #cut name:(ident @error(message="expected type name")) -ws
  spec:(type_spec @error(message="expected '= {', '~' or terminal"))
) => TypeDefBody{Name: $name, Spec: $spec}
rule type_spec TypeSpec = struct_spec / terminal_spec / type_alias_spec
rule struct_spec StructSpec = (
  "=" -ws "{" #cut {ml := false} fields:(f:field_spec)* cs:comments
  -("}" @error(message="expected closing brace for struct"))
) => StructSpec{Fields: map($fields, (x) => x.$f), Comments: $cs}
rule field_spec FieldSpec = !(comments "}") f:(field #recover(skip=field_sync)) => $f
rule field Field = (
  cs:comments name:(ident @error(message="expected field name")) -ws
  t:(type_expr @error(message="expected field type")) tc:field_end
) => Field{Name: $name, Type: $t, Comments: concat($cs, $tc)}
rule terminal_spec TerminalSpec = "terminal" !ident_char => TerminalSpec{}
rule type_alias_spec TypeAliasSpec = "~" -ws t:type_expr => TypeAliasSpec{Type: $t}
rule type_expr Type = operators {
  skip ws
  operand bottom
  operand name:ident args:type_args => TypeApp{Name: $name, Args: $args}
  operand name:ident => TypeRef{Name: $name}
  operand t:type_group => $t
  operand t:struct_type => $t
  level union { infix left "|" => UnionType{L: $lhs, R: $rhs} }
  level meet { infix left "&" => IntersectionType{L: $lhs, R: $rhs} }
  level prefix {
    prefix "[]" => ListType{Type: $rhs}
    prefix "*" => OptionalType{Type: $rhs}
  }
}

// An unnamed struct type has the fields of a struct definition.
rule struct_type StructType = (
  "{" {ml := false} fields:(f:field_spec)* cs:comments
  -("}" @error(message="expected closing brace for struct"))
) => StructType{Fields: map($fields, (x) => x.$f), Comments: $cs}

// The brackets of type arguments follow the name directly.
rule type_args []Type = (
  "[" {ml := true} -ws first:type_expr rest:(-ws "," -ws t:type_expr)* -ws ","? -ws "]"
) => concat(list($first), map($rest, (x) => x.$t))

// A rule of its own keeps ml from reaching the rest of the type. Parentheses
// around one type without a comma group it; any other parentheses form a tuple.
rule type_group Type = type_paren / type_tuple
rule type_paren TypeGroup = "(" {ml := true} -ws t:type_expr -ws ")" => TypeGroup{Type: $t}
rule type_tuple TupleType = (
  "(" {ml := true} -ws ts:(t:type_expr -ws "," -ws)* last:type_expr? -ws ")"
) => TupleType{Types: concat(map($ts, (x) => x.$t), filter(list($last), (x) => x != nil)).([]Type)}

// Rule expressions. The empty infix operator represents adjacency, so
// juxtaposition does not need a separate sequence parser or require a space.
rule rule_def_stmt RuleDef = (
  cs:comments "rule" -word_end #cut name:(ident @error(message="expected rule name")) -ws t:type_expr? -ws
  -("=" @error(message="expected '=' after rule header")) -ws x:(ops_rule_expr / rule_expr)
  @error(message="expected rule expression") -ws a:whole_action? tc:stmt_end
) => RuleDef{Name: $name, Type: $t, Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule whole_action Action = "=>" -ws a:(action @error(message="expected value action after '=>'")) => $a
rule rule_expr RuleExpr = operators {
  skip ws
  operand rule_group / predicate / level_call / bottom / top / begin_input / begin_line / end_input / end_line / any / cut / string / char_class / rule_ref
  level ordered_choice { infix left "/" => Choice{L: $lhs, R: $rhs} }
  level sequence { infix left _ => Sequence{L: $lhs, R: $rhs} }
  level prefix {
    prefix name:ident ":" => Capture{Name: $name, Expr: $rhs}
    prefix "&" / "!" => Lookahead{Op: text($op), X: $rhs}
    prefix "-" !("-" / ">") => Discard{X: $rhs}
  }
  level suffix {
    postfix "?" => Optional{X: $lhs}
    postfix "*" => ZeroOrMore{X: $lhs}
    postfix "+" => OneOrMore{X: $lhs}
    postfix "#atomic" !ident_char (empty_args / !("(")) => Atomic{X: $lhs}
    postfix "#stream" !ident_char (empty_args / !("(")) => Stream{X: $lhs}
    postfix "#missing" !ident_char !("(") => MissingPragma{X: $lhs}
    postfix "#repeat" !ident_char bounds:repeat_args => Repeat{X: $lhs, Min: $bounds.Min, Max: $bounds.Max, Range: $bounds.Range}
    postfix "#recover" !ident_char sync:recover_args => Recover{X: $lhs, Skip: $sync}
    postfix a:attr => Attributed{X: $lhs, Attr: $a}
  }
}
rule rule_group RuleGroup = (
  "(" {ml := true} -ws x:(inline_action / rule_expr) -ws
  -(")" @error(message="expected closing parenthesis for rule group"))
) => RuleGroup{Expr: $x}
rule inline_action InlineAction = x:rule_expr -ws "=>" -ws a:action => InlineAction{Expr: $x, Action: $a}
rule rule_ref RuleRef = name:ident !"(" => RuleRef{Name: $name}
rule level_call LevelCall = (
  "level(" {ml := true} -ws #cut name:(ident @error(message="expected target rule in level call")) -ws
  -("," @error(message="expected comma in level call")) -ws
  lev:(ident @error(message="expected level name")) -ws
  -(")" @error(message="expected closing parenthesis for level call"))
) => LevelCall{Rule: $name, Level: $lev}
rule top Top = "_" !ident_char
rule bottom Bottom = "_|_"
rule begin_input BeginInput = "^^"
rule begin_line BeginLine = "^"
rule end_input EndInput = "$$"
rule end_line EndLine = "$" !(ident_start / digit)
rule any Any = "."
rule cut Cut = "#cut" !ident_char !"("
rule predicate Predicate = b:action_block => Predicate{Actions: $b.Actions, Comments: $b.Comments}

// Postfix pragmas have dedicated payloads. Metadata attributes retain ordered
// positional slots and named arguments, including explicit and omitted nils.
type RepeatBounds = { Min *Int; Max *Int; Range bool }
rule repeat_args RepeatBounds = (
  "(" {ml := true} -ws b:(repeat_range / repeat_count) -ws
  -(")" @error(message="expected closing parenthesis for #repeat"))
) => $b
rule repeat_range RepeatBounds = repeat_from / repeat_to
rule repeat_from RepeatBounds = min:repeat_int -ws "," -ws max:repeat_int? => RepeatBounds{Min: $min, Max: $max, Range: true}
rule repeat_to RepeatBounds = "," -ws max:repeat_int => RepeatBounds{Max: $max, Range: true}
rule repeat_count RepeatBounds = n:repeat_int => RepeatBounds{Min: $n, Max: $n, Range: false}
rule repeat_int Int = (digit+ / "-" -ws "0"+ !digit) #atomic
rule recover_args RuleExpr = (
  "(" {ml := true} -ws -("skip" @error(message="expected skip= in #recover")) -word_end
  -("=" @error(message="expected '=' after skip")) -ws x:rule_expr -ws
  -(")" @error(message="expected closing parenthesis for #recover"))
) => $x
rule empty_args = "(" {ml := true} -ws ")"
rule attr Attr = (
  "@" name:(ident @error(message="expected attribute name")) args:(attr_args / attr_no_args)
) => Attr{Name: $name, Args: $args.Args, KwArgs: $args.KwArgs}
rule attr_args AttrArgs = (
  "(" {ml := true} -ws a:(attr_no_values / attr_named_args / attr_mixed_args) -ws
  -(")" @error(message="expected closing parenthesis for attribute arguments"))
) => $a
rule attr_named_args AttrArgs = (
  first:attr_named rest:(-ws "," -ws n:attr_named)* (-ws "," -ws)?
) => AttrArgs{Args: list(), KwArgs: concat(list($first), map($rest, (x) => x.$n))}
rule attr_mixed_args AttrArgs = (
  first:attr_slot rest:(-ws "," -ws a:attr_slot)* named:(attr_named_tail / attr_empty_args)
) => AttrArgs{Args: concat(list($first.Value), map($rest, (x) => x.$a.Value)), KwArgs: $named.KwArgs}
rule attr_no_args AttrArgs = !"(" => AttrArgs{Args: list(), KwArgs: list()}
rule attr_no_values AttrArgs = &")" => AttrArgs{Args: list(), KwArgs: list()}
rule attr_empty_args AttrArgs = _ => AttrArgs{Args: list(), KwArgs: list()}
rule attr_named_tail AttrArgs = -ws "," -ws n:attr_named_args => $n
rule attr_slot AttrSlot = !(ident -ws "=") v:attr_value? => AttrSlot{Value: $v}
rule attr_named AttrNamed = (
  name:ident -ws "=" -ws v:(attr_value @error(message="expected attribute argument value"))
) => AttrNamed{Name: $name, Value: $v}
rule attr_value AttrValue = true / false / nil / signed_int / string / rule_expr
rule signed_int Int = ("-" -ws)? digit+ #atomic

// Operators Rule items and each level recover independently. An absent level
// name remains nil; level(rule, name) can target only named levels.
rule ops_rule_expr OperatorsRule = (
  "operators" !ident_char -ws &"{" #cut "{" {ml := false} items:(-empty_stmts i:ops_stmt)* -empty_stmts
  cs:comments -("}" @error(message="expected closing brace for operators"))
) => OperatorsRule{Items: map($items, (x) => x.$i), Comments: $cs}
rule ops_stmt OperatorsStmt = (
  !(comments "}")
  s:((ops_skip_stmt / ops_operand_stmt / ops_level_stmt / _|_ @error(message="expected skip, operand, or level")) #recover(skip=item_sync))
) => $s
rule ops_skip_stmt OperatorsSkip = (
  cs:comments "skip" -word_end #cut x:(rule_expr @error(message="expected skip expression")) tc:item_end
) => OperatorsSkip{Expr: $x, Comments: concat($cs, $tc)}
rule ops_operand_stmt OperatorsOperand = (
  cs:comments "operand" -word_end #cut x:(rule_expr @error(message="expected operand expression")) -ws
  a:whole_action? tc:item_end
) => OperatorsOperand{Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule ops_level_stmt OperatorsLevel = (
  cs:comments "level" -word_end #cut name:ident? -ws
  -("{" @error(message="expected opening brace for level")) xs:(-empty_stmts o:ops_operator)*
  -empty_stmts tc:comments -("}" @error(message="expected closing brace for level")) end:item_end
) => OperatorsLevel{Name: $name, Operators: map($xs, (x) => x.$o), Comments: concat($cs, $tc, $end)}
rule ops_operator OpsOperator = (
  !(comments "}")
  s:((ops_prefix / ops_postfix / ops_infix / _|_ @error(message="expected prefix, postfix, or infix")) #recover(skip=item_sync))
) => $s
rule ops_prefix Prefix = (
  cs:comments "prefix" -word_end #cut x:(rule_expr @error(message="expected prefix expression")) -ws
  a:whole_action? tc:item_end
) => Prefix{Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule ops_postfix Postfix = (
  cs:comments "postfix" -word_end #cut x:(rule_expr @error(message="expected postfix expression")) -ws
  a:whole_action? tc:item_end
) => Postfix{Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule ops_infix Infix = (
  cs:comments "infix" -word_end #cut
  assoc:(("left" / "right" / "none") @error(message="expected left, right, or none associativity"))
  -word_end x:(rule_expr @error(message="expected infix expression")) -ws a:whole_action? tc:item_end
) => Infix{Assoc: text($assoc), Expr: $x, Action: $a, Comments: concat($cs, $tc)}

// Predicate Actions and Value Actions share statement syntax. The source AST
// retains unsupported blocks and inline actions for later compilation checks.
rule action Action = default_action / action_block / action_expr
rule default_action DefaultAction = "..."
rule action_block ActionBlock = (
  "{" {ml := false} xs:(s:action_block_stmt)* cs:comments
  -("}" @error(message="expected closing brace for action block"))
) => ActionBlock{Actions: map($xs, (x) => x.$s), Comments: $cs}
rule action_block_stmt ActionStmt = !(comments "}") x:(action_block_value #recover(skip=item_sync)) => $x
rule action_block_value ActionStmt = -comments x:action_stmt -item_end => $x
rule action_stmt ActionStmt = action_assign_stmt / action_expr
rule action_assign_stmt ActionAssign = (
  name:ident -ws ":=" -ws x:(action_expr @error(message="expected assignment value"))
) => ActionAssign{Name: $name, Expr: $x}
rule action_expr ActionExpr = lambda / action_ops
rule action_ops ActionExpr = operators {
  skip ws
  operand list_constructor / terminal_constructor / constructor / call / action_group / int / string / true / false / nil / capture_ref / var_ref
  level disjunction { infix left "||" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level conjunction { infix left "&&" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level comparison { infix none "==" / "!=" / "<=" / ">=" / "<" / ">" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level addition { infix left "+" / "-" !("-" / ">") => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level multiplication { infix left "*" / "/" / "%" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level unary { prefix "-" !"-" / "!" !"=" => UnaryOp{Op: text($op), X: $rhs} }
  // x[i] indexes a list. The reference parser takes "[" as an index only directly after a name,
  // a capture, ")" or "]", and reads it as a character class elsewhere. This grammar is looser
  // both ways: skip ws accepts "x [i]", and a rule body accepts "name[a-z]" as a reference
  // followed by a character class, which the reference parser rejects.
  level field_access {
    postfix "." -ws c:capture_ref => CaptureAccess{X: $lhs, Capture: $c}
    postfix "." -ws t:cast_type => Cast{X: $lhs, Type: $t}
    postfix "." -ws name:ident => FieldAccess{X: $lhs, Name: $name}
    postfix "[" -ws i:action_expr -ws "]" => BinaryOp{Op: "[]", L: $lhs, R: $i}
  }
}
// A rule of its own keeps ml from reaching the rest of the action.
rule cast_type Type = "(" {ml := true} -ws t:type_expr -ws ")" => $t
rule lambda Lambda = (
  "(" {ml := true} -ws names:lambda_params? -ws ")" -ws "=>" -ws x:action_expr
) => Lambda{Params: concat($names), Body: $x}
rule lambda_params []Ident = first:ident rest:(-ws "," -ws name:ident)* => concat(list($first), map($rest, (x) => x.$name))
rule action_group ActionGroup = (
  "(" {ml := true} -ws x:action_expr -ws
  -(")" @error(message="expected closing parenthesis for action expression"))
) => ActionGroup{Expr: $x}
rule call Call = (
  name:var_name "(" {ml := true} -ws #cut args:action_args? -ws
  -(")" @error(message="expected closing parenthesis for function call"))
) => Call{X: $name, Args: concat($args)}
rule action_args []ActionExpr = (
  first:action_expr rest:(-ws "," -ws x:action_expr)* (-ws "," -ws)?
) => concat(list($first), map($rest, (x) => x.$x))
rule list_constructor ListConstructor = (
  "[]" -ws #cut elem:level(type_expr, prefix) -ws
  -("{" @error(message="expected opening brace for list constructor")) {ml := true} -ws
  items:action_args? cs:comments -("}" @error(message="expected closing brace for list constructor"))
) => ListConstructor{Elem: $elem, Items: concat($items), Comments: $cs}
rule terminal_constructor TerminalConstructor = (
  name:var_name -ws "{" {ml := true} -ws !("}" / ident -ws ":") #cut
  args:action_args cs:comments -("}" @error(message="expected closing brace for terminal constructor"))
) => TerminalConstructor{Type: $name, Args: $args, Comments: $cs}
rule constructor Constructor = (
  name:var_name -ws "{" {ml := true} -ws #cut fields:constructor_fields? cs:comments
  -("}" @error(message="expected closing brace for constructor"))
) => Constructor{X: $name, Inits: concat($fields), Comments: $cs}
rule constructor_fields []InitField = (
  first:init_field rest:(-ws "," -ws f:init_field)* (-ws "," -ws)?
) => concat(list($first), map($rest, (x) => x.$f))
rule init_field InitField = (
  cs:comments name:(ident @error(message="expected initializer field name")) -ws -":" -ws
  x:(action_expr @error(message="expected initializer value"))
) => InitField{Name: $name, Val: $x, Comments: $cs}
rule int Int = digit+ #atomic
rule true True = "true" !ident_char
rule false False = "false" !ident_char
rule nil Nil = "nil" !ident_char
rule capture_ref CaptureRef = "$" ident #atomic
rule var_name VarRef = ident
rule var_ref VarRef = ident !"("

// Trivia. Space is discarded before and after each retained comment, keeping
// the resulting list homogeneous without introducing nil whitespace elements.
rule ws []Comment = ({ml} cs:comments / cs:horizontal) => $cs
rule comments []Comment = -space* xs:(c:comment -space*)* => map($xs, (x) => x.$c)
rule horizontal []Comment = -space_no_line* xs:(c:(line_comment / block_no_line) -space_no_line*)* => map($xs, (x) => x.$c)
rule word_end = !ident_char -ws
rule space_no_line = !nl space
rule nl = "\r\n" / [\r\n]
rule space = [ \t\n\u{b}\u{c}\r\u{85}\u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}]
// A lexical comment view retains trivia inside parsing and action expressions.
// Incomplete tokens remain available to the error-recovering structural pass.
rule source_comments []Comment = -source_non_comment* xs:(c:comment -source_non_comment*)* $$ => map($xs, (x) => x.$c)
rule source_non_comment = source_string / source_class / incomplete_comment / !("//" / "/*") .
rule source_string = "\"" ("\\" . / [^"\\\n])* "\""?
rule source_class = "[" ("\\" . / [^\]\\\n])* "]"?
rule incomplete_comment = !inline_comment "/*" .* $$
rule comment Comment = comment_group / inline_comment
rule comment_group CommentGroup = (
  first:comment_line rest:(-nl -space_no_line* c:comment_line)*
) => CommentGroup{Lines: concat(list($first), map($rest, (x) => x.$c))}
rule line_comment CommentGroup = c:comment_line => CommentGroup{Lines: list($c)}
rule comment_line Match = ("//" [^\n\r]*) #atomic
rule inline_comment InlineComment = (
  start:"/*" body:(inline_comment / !("/*" / "*/") .)* #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule block_no_line InlineComment = (
  start:"/*" body:(block_no_line / !("/*" / "*/" / nl) .)* #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule block_with_line InlineComment = (
  start:"/*"
  body:((block_no_line / !("/*" / "*/" / nl) .)* (nl / block_with_line) (inline_comment / !("/*" / "*/") .)*)
  #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule ident Ident = (ident_start ident_char*) #atomic
rule ident_start = [a-zA-Z_]
rule ident_char = [a-zA-Z0-9_]
rule digit = [0-9]
rule string String = "\"" ("\\" escape_char / [^"\\\n])* "\"" #atomic
rule char_class CharClass = (
  "[" not:"^"? items:(char_class_rng / char_class_chr)+
  -("]" @error(message="expected closing bracket for character class"))
) => CharClass{Not: $not != nil, Items: $items.Value}
rule char_class_rng CharRng = start:char_class_chr "-" !"]" end:char_class_chr => CharRng{Start: $start, End: $end}
rule char_class_chr Char = ("\\" escape_char / [^\]\\\n]) #atomic
rule escape_char = "u{" [0-9a-fA-F]+ "}" / "u" [0-9a-fA-F] #repeat(4) / [ntrfvab0] / [^a-zA-Z0-9]

// Normalized declaration ownership, independent of raw formatter comments.
rule source_after_boundary SourceBoundary = (
  source_inline_line_boundary / source_inline_block_boundary / source_ambiguous_block_boundary
  / source_newline_boundary / source_remaining
)
rule source_inline_line_boundary SourceBoundary = (
  -source_horizontal c:source_line_comment b:source_remaining
) => SourceBoundary{Trailing: $c.Text, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_inline_block_boundary SourceBoundary = (
  -source_horizontal c:source_block_comment &(source_horizontal (source_nl / source_comment_start / $$))
  b:source_remaining
) => SourceBoundary{Trailing: $c.Text, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
// One inline block ending on the next token's line is ambiguous, not trailing.
rule source_ambiguous_block_boundary SourceBoundary = (
  -source_horizontal c:source_block_comment -source_horizontal &source_next_token
) => SourceBoundary{Trailing: "", Leading: "", Detached: list($c), HasNext: true}
rule source_newline_boundary SourceBoundary = (
  -source_horizontal -source_nl -source_horizontal c:(source_first_trailing / source_empty_comment) b:source_remaining
) => SourceBoundary{Trailing: $c.Text, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}

// A first standalone group can trail the previous declaration when a blank
// line, another group, or the end of a scope flushes it before the next token.
rule source_first_trailing SourceComment = (
  c:source_line_group &source_line_flush / c:source_block_comment &source_block_flush
) => $c
rule source_remaining SourceBoundary = source_scope_tail / source_next_boundary
rule source_scope_tail SourceBoundary = (
  -source_space* xs:(c:source_comment -source_space*)* &source_scope_end
) => SourceBoundary{Trailing: "", Leading: "", Detached: map($xs, (x) => x.$c), HasNext: false}
rule source_next_boundary SourceBoundary = (
  -source_space* detached:(c:source_detached_group -source_space*)* lead:(source_leading_group / source_empty_comment) -source_space* &source_next_token
) => SourceBoundary{Trailing: "", Leading: $lead.Text, Detached: map($detached, (x) => x.$c), HasNext: true}
rule source_empty_comment SourceComment = _ => SourceComment{Text: ""}
rule source_detached_group SourceComment = (
  c:source_line_group &source_line_flush / c:source_block_comment &source_block_flush
) => $c
rule source_leading_group SourceComment = c:source_comment -source_space* &source_next_token => $c
rule source_line_flush = source_horizontal (source_nl / "/*" / source_scope_end)
rule source_block_flush = source_horizontal (source_nl source_horizontal (source_nl / source_comment_start / source_scope_end) / source_comment_start / source_scope_end)
rule source_next_token = !(source_space / source_comment_start / source_scope_end) .
rule source_scope_end = ")" / "]" / "}" / $$
rule source_comment_start = "//" / "/*"
rule source_comment SourceComment = source_line_group / source_block_comment
rule source_line_group SourceComment = (
  first:source_line_comment rest:(-source_horizontal c:source_line_comment)*
) => SourceComment{Text: foldl($first.Text, $rest, (s, x) => s + x.$c.Text)}
rule source_line_comment SourceComment = "//" body:[^\r\n]* end:source_nl? => SourceComment{Text: text($body) + text($end)}
rule source_block_comment SourceComment = (
  "/*" first:source_block_line rest:(line:source_nl -source_horizontal -source_block_star? body:source_block_line)* "*/"
) => SourceComment{Text: foldl($first.Text, $rest, (s, x) => s + text(x.$line) + x.$body.Text)}
rule source_block_star = "*" !"/"
rule source_block_line SourceComment = xs:(c:source_block_piece)* => SourceComment{Text: foldl("", $xs, (s, x) => s + x.$c.Text)}
rule source_block_piece SourceComment = source_nested_piece / source_character_piece
rule source_nested_piece SourceComment = c:source_block_comment => SourceComment{Text: "/*" + $c.Text + "*/"}
rule source_character_piece SourceComment = c:(!(source_nl / "*/" / "/*") .) #atomic => SourceComment{Text: text($c)}
rule source_nl = "\r\n" / [\r\n]
rule source_horizontal = source_horizontal_char*
rule source_horizontal_char = [ \t\u{b}\u{c}\u{85}\u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}]
rule source_space = source_horizontal_char / source_nl
