// PEGO grammar syntax and typed source tree.
// Source forms are preserved before semantic validation and compilation.
package pego

type Ident terminal
type Int terminal
type String terminal
type True terminal
type False terminal
type Nil terminal
type CaptureRef terminal
type VarRef terminal

type File struct { Package *PackageStmt, Defs []Def, Comments []Comment, TrailingComments []Comment, Text string }
type PackageStmt = Package | Error
type Package struct { Name Ident, Comments []Comment }
type Def = TypeDef | RuleDef | Error
type TypeDef struct { Name Ident, Spec TypeSpec, Comments []Comment }
type TypeSpec = TypeAliasSpec | TerminalSpec | StructSpec
type TypeAliasSpec struct { Type Type }
type TerminalSpec struct {}
type StructSpec struct { Fields []FieldSpec, Comments []Comment }
type FieldSpec = Field | Error
type Field struct { Name Ident, Type Type, Comments []Comment }
type Type = TypeRef | TypeGroup | OptionalType | ListType | UnionType
type TypeRef struct { Name Ident }
type TypeGroup struct { Type Type }
type OptionalType struct { Type Type }
type ListType struct { Type Type }
type UnionType struct { L Type, R Type }

type Comment = CommentGroup | InlineComment
type CommentGroup struct { Lines []Match }
type InlineComment struct { Start Match, Body Match, End Match }
type RuleDef struct { Name Ident, Type *Type, Expr RuleExpr, Action *Action, Comments []Comment }
type RuleExpr = (
  RuleRef | LevelCall | RuleGroup | InlineAction | Sequence | Choice
  | Discard | Lookahead | Top | Bottom | BeginLine | BeginInput | EndLine | EndInput
  | Any | Cut | String | CharClass | Optional | ZeroOrMore | OneOrMore
  | Repeat | Capture | Predicate | Atomic | Stream | Recover | Attributed | OperatorsRule
)
type RuleRef struct { Name Ident }
type LevelCall struct { Rule Ident, Level Ident }
type RuleGroup struct { Expr RuleExpr }
type InlineAction struct { Expr RuleExpr, Action Action }
type Sequence struct { L RuleExpr, R RuleExpr }
type Choice struct { L RuleExpr, R RuleExpr }
type Discard struct { X RuleExpr }
type Lookahead struct { Op string, X RuleExpr }
type Top terminal
type Bottom terminal
type BeginLine terminal
type BeginInput terminal
type EndLine terminal
type EndInput terminal
type Any terminal
type Cut terminal
type CharClass struct { Not bool, Items []CharClassItem }
type CharClassItem = Char | CharRng
type Char terminal
type CharRng struct { Start Char, End Char }
type Optional struct { X RuleExpr }
type ZeroOrMore struct { X RuleExpr }
type OneOrMore struct { X RuleExpr }
type Repeat struct { X RuleExpr, Min *Int, Max *Int, Range bool }
type Capture struct { Name Ident, Expr RuleExpr }
type Predicate struct { Actions []ActionStmt, Comments []Comment }
type Atomic struct { X RuleExpr }
type Stream struct { X RuleExpr }
type Recover struct { X RuleExpr, Skip RuleExpr }
type Attributed struct { X RuleExpr, Attr Attr }
type Attr struct { Name Ident, Args []*AttrValue, KwArgs []AttrNamed }
type AttrValue = Int | String | True | False | Nil | RuleExpr
// Slots keep an omitted positional argument distinct from the end of a list.
type AttrSlot struct { Value *AttrValue }
type AttrNamed struct { Name Ident, Value AttrValue }
type AttrArgs struct { Args []*AttrValue, KwArgs []AttrNamed }

type OperatorsRule struct { Items []OperatorsStmt, Comments []Comment }
type OperatorsStmt = OperatorsSkip | OperatorsOperand | OperatorsLevel | Error
type OperatorsSkip struct { Expr RuleExpr, Comments []Comment }
type OperatorsOperand struct { Expr RuleExpr, Action *Action, Comments []Comment }
type OperatorsLevel struct { Name *Ident, Operators []OpsOperator, Comments []Comment }
type OpsOperator = Prefix | Postfix | Infix | Error
type Prefix struct { Expr RuleExpr, Action *Action, Comments []Comment }
type Postfix struct { Expr RuleExpr, Action *Action, Comments []Comment }
type Infix struct { Assoc string, Expr RuleExpr, Action *Action, Comments []Comment }

type Action = ActionExpr | ActionBlock | DefaultAction
type ActionStmt = ActionAssign | ActionExpr | Error
type ActionAssign struct { Name Ident, Expr ActionExpr }
type ActionBlock struct { Actions []ActionStmt, Comments []Comment }
type DefaultAction terminal
type ActionExpr = (
  Int | String | True | False | Nil | CaptureRef | VarRef
  | BinaryOp | UnaryOp | FieldAccess | Call | Constructor | ActionGroup | Lambda
)
type BinaryOp struct { Op string, L ActionExpr, R ActionExpr }
type UnaryOp struct { Op string, X ActionExpr }
type FieldAccess struct { X ActionExpr, Name Ident }
type Call struct { X ActionExpr, Args []ActionExpr }
type Constructor struct { X ActionExpr, Inits []InitField, Comments []Comment }
type InitField struct { Name Ident, Val ActionExpr, Comments []Comment }
type ActionGroup struct { Expr ActionExpr }
type Lambda struct { Params []Ident, Body ActionExpr }

// File and statements. Delimiter-owned expressions enable multiline trivia;
// declaration and item lists keep physical newlines as statement boundaries.
rule main File = f:file => $f
rule file File = (
  &cs:source_comments f:file_contents
) => File{
  Package: $f.Package,
  Defs: $f.Defs,
  Comments: $cs,
  TrailingComments: $f.TrailingComments,
  Text: text($f),
}
rule file_contents File = (
  {ml := false}
  pkg:package_entry?
  defs:(-empty_stmts d:def_stmt)*
  -empty_stmts tc:comments $$
) => File{Package: $pkg, Defs: map($defs, (x) => $x.d), TrailingComments: $tc}
rule empty_stmts = (";" -comments)*
rule package_entry PackageStmt = &(comments "package" !ident_char) p:(package_stmt #recover(skip=stmt_sync)) => $p
rule package_stmt Package = (
  cs:comments "package" -word_end -- name:(ident @error(message="expected package name")) tc:stmt_end
) => Package{Name: $name, Comments: concat($cs, $tc)}
rule def_stmt Def = (
  !(comments $$)
  d:((type_def_stmt / rule_def_stmt / _|_ @error(message="expected type or rule declaration")) #recover(skip=stmt_sync))
) => $d
rule stmt_end []Comment = (
  cs:horizontal tail:(stmt_separator @error(message="expected semicolon, newline, or end of file"))
) => concat($cs, $tail)
rule item_end []Comment = (
  cs:horizontal tail:(item_separator @error(message="expected semicolon, newline, or closing brace"))
) => concat($cs, $tail)
rule field_end []Comment = (
  cs:horizontal tail:(field_separator @error(message="expected comma, newline, or closing brace"))
) => concat($cs, $tail)
rule stmt_separator []Comment = block_separator / empty_stmt_separator
rule item_separator []Comment = block_separator / empty_item_separator
rule field_separator []Comment = block_separator / empty_field_separator
rule block_separator []Comment = c:block_with_line => list($c)
rule empty_stmt_separator []Comment = (";" / nl / &$$) => list()
rule empty_item_separator []Comment = (";" / nl / &"}") => list()
rule empty_field_separator []Comment = ("," / nl / &"}") => list()
// Recovery consumes its own separator and stops before the next item.
rule stmt_sync = -comments (sync_token / !(";" / nl) .)* (";" / nl / &$$)
rule item_sync = -comments (sync_token / !(";" / nl / "}") .)* (";" / nl / &"}" / &$$)
rule field_sync = -comments (sync_token / !("," / nl / "}") .)* ("," / nl / &"}" / &$$)

// Completed literals, nested comments and groups do not end recovery.
rule sync_token = string / char_class / inline_comment / comment_line / sync_paren / sync_brace
rule sync_paren = "(" (sync_token / !("(" / ")" / nl) .)* ")"
rule sync_brace = "{" (sync_token / !("{" / "}" / nl) .)* "}"

// Types. Union is the weakest operation; list and optional prefixes nest.
rule type_def_stmt TypeDef = (
  cs:comments "type" -word_end -- name:(ident @error(message="expected type name")) -ws
  spec:(type_spec @error(message="expected struct, terminal, or type alias")) tc:stmt_end
) => TypeDef{Name: $name, Spec: $spec, Comments: concat($cs, $tc)}
rule type_spec TypeSpec = struct_spec / terminal_spec / type_alias_spec
rule struct_spec StructSpec = (
  "struct" -word_end -- "{" {ml := false} fields:(f:field_spec)* cs:comments
  -("}" @error(message="expected closing brace for struct"))
) => StructSpec{Fields: map($fields, (x) => $x.f), Comments: $cs}
rule field_spec FieldSpec = !(comments "}") f:(field #recover(skip=field_sync)) => $f
rule field Field = (
  cs:comments name:(ident @error(message="expected field name")) -ws
  t:(type_expr @error(message="expected field type")) tc:field_end
) => Field{Name: $name, Type: $t, Comments: concat($cs, $tc)}
rule terminal_spec TerminalSpec = "terminal" !ident_char => TerminalSpec{}
rule type_alias_spec TypeAliasSpec = "=" -ws t:type_expr => TypeAliasSpec{Type: $t}
rule type_expr Type = operators {
  skip ws
  operand name:ident => TypeRef{Name: $name}
  operand "(" {ml := true} -ws t:type_expr -ws ")" => TypeGroup{Type: $t}
  level union { infix left "|" => UnionType{L: $lhs, R: $rhs} }
  level prefix {
    prefix "[]" => ListType{Type: $rhs}
    prefix "*" => OptionalType{Type: $rhs}
  }
}

// Parsing expressions. The empty infix operator represents adjacency, so
// juxtaposition does not need a separate sequence parser or require a space.
rule rule_def_stmt RuleDef = (
  cs:comments "rule" -word_end -- name:(ident @error(message="expected rule name")) -ws t:type_expr? -ws
  -("=" @error(message="expected '=' after rule header")) -ws x:(ops_rule_expr / rule_expr)
  @error(message="expected rule expression") -ws a:whole_action? tc:stmt_end
) => RuleDef{Name: $name, Type: $t, Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule whole_action Action = "=>" -ws a:(action @error(message="expected value action after '=>'")) => $a
rule rule_expr RuleExpr = operators {
  skip ws
  operand rule_group / predicate / level_call / bottom / top / begin_input / begin_line / end_input / end_line / any / cut / string / char_class / rule_ref
  level ordered_choice { infix left "/" => Choice{L: $lhs, R: $rhs} }
  level sequence { infix left _ => Sequence{L: $lhs, R: $rhs} }
  level prefix {
    prefix name:ident ":" => Capture{Name: $name, Expr: $rhs}
    prefix "&" / "!" => Lookahead{Op: text($op), X: $rhs}
    prefix "-" !("-" / ">") => Discard{X: $rhs}
  }
  level suffix {
    postfix "?" => Optional{X: $lhs}
    postfix "*" => ZeroOrMore{X: $lhs}
    postfix "+" => OneOrMore{X: $lhs}
    postfix "#" -ws "atomic" !ident_char (empty_args / !("(")) => Atomic{X: $lhs}
    postfix "#" -ws "stream" !ident_char (empty_args / !("(")) => Stream{X: $lhs}
    postfix "#" -ws "repeat" !ident_char -ws bounds:repeat_args => Repeat{X: $lhs, Min: $bounds.Min, Max: $bounds.Max, Range: $bounds.Range}
    postfix "#" -ws "recover" !ident_char -ws sync:recover_args => Recover{X: $lhs, Skip: $sync}
    postfix a:attr => Attributed{X: $lhs, Attr: $a}
  }
}
rule rule_group RuleGroup = (
  "(" {ml := true} -ws x:(inline_action / rule_expr) -ws
  -(")" @error(message="expected closing parenthesis for rule group"))
) => RuleGroup{Expr: $x}
rule inline_action InlineAction = x:rule_expr -ws "=>" -ws a:action => InlineAction{Expr: $x, Action: $a}
rule rule_ref RuleRef = name:ident !"(" => RuleRef{Name: $name}
rule level_call LevelCall = (
  "level(" {ml := true} -ws -- name:(ident @error(message="expected target rule in level call")) -ws
  -("," @error(message="expected comma in level call")) -ws
  lev:(ident @error(message="expected level name")) -ws
  -(")" @error(message="expected closing parenthesis for level call"))
) => LevelCall{Rule: $name, Level: $lev}
rule top Top = "_" !ident_char
rule bottom Bottom = "_|_"
rule begin_input BeginInput = "^^"
rule begin_line BeginLine = "^"
rule end_input EndInput = "$$"
rule end_line EndLine = "$" !(ident_start / digit)
rule any Any = "."
rule cut Cut = "--"
rule predicate Predicate = b:action_block => Predicate{Actions: $b.Actions, Comments: $b.Comments}

// Postfix pragmas have dedicated payloads. Metadata attributes retain ordered
// positional slots and named arguments, including explicit and omitted nils.
type RepeatBounds struct { Min *Int, Max *Int, Range bool }
rule repeat_args RepeatBounds = (
  "(" {ml := true} -ws b:(repeat_range / repeat_count) -ws
  -(")" @error(message="expected closing parenthesis for #repeat"))
) => $b
rule repeat_range RepeatBounds = repeat_from / repeat_to
rule repeat_from RepeatBounds = min:repeat_int -ws "," -ws max:repeat_int? => RepeatBounds{Min: $min, Max: $max, Range: true}
rule repeat_to RepeatBounds = "," -ws max:repeat_int => RepeatBounds{Max: $max, Range: true}
rule repeat_count RepeatBounds = n:repeat_int => RepeatBounds{Min: $n, Max: $n, Range: false}
rule repeat_int Int = (digit+ / "-" -ws "0"+ !digit) #atomic
rule recover_args RuleExpr = (
  "(" {ml := true} -ws -("skip" @error(message="expected skip= in #recover")) -word_end
  -("=" @error(message="expected '=' after skip")) -ws x:rule_expr -ws
  -(")" @error(message="expected closing parenthesis for #recover"))
) => $x
rule empty_args = "(" {ml := true} -ws ")"
rule attr Attr = (
  "@" name:(ident @error(message="expected attribute name")) args:(attr_args / attr_no_args)
) => Attr{Name: $name, Args: $args.Args, KwArgs: $args.KwArgs}
rule attr_args AttrArgs = (
  "(" {ml := true} -ws a:(attr_no_values / attr_named_args / attr_mixed_args) -ws
  -(")" @error(message="expected closing parenthesis for attribute arguments"))
) => $a
rule attr_named_args AttrArgs = (
  first:attr_named rest:(-ws "," -ws n:attr_named)* (-ws "," -ws)?
) => AttrArgs{Args: list(), KwArgs: concat(list($first), map($rest, (x) => $x.n))}
rule attr_mixed_args AttrArgs = (
  first:attr_slot rest:(-ws "," -ws a:attr_slot)* named:(attr_named_tail / attr_empty_args)
) => AttrArgs{Args: concat(list($first.Value), map($rest, (x) => $x.a.Value)), KwArgs: $named.KwArgs}
rule attr_no_args AttrArgs = !"(" => AttrArgs{Args: list(), KwArgs: list()}
rule attr_no_values AttrArgs = &")" => AttrArgs{Args: list(), KwArgs: list()}
rule attr_empty_args AttrArgs = _ => AttrArgs{Args: list(), KwArgs: list()}
rule attr_named_tail AttrArgs = -ws "," -ws n:attr_named_args => $n
rule attr_slot AttrSlot = !(ident -ws "=") v:attr_value? => AttrSlot{Value: $v}
rule attr_named AttrNamed = (
  name:ident -ws "=" -ws v:(attr_value @error(message="expected attribute argument value"))
) => AttrNamed{Name: $name, Value: $v}
rule attr_value AttrValue = true / false / nil / signed_int / string / rule_expr
rule signed_int Int = ("-" -ws)? digit+ #atomic

// Operators Rule items and each level recover independently. An absent level
// name remains nil; level(rule, name) can target only named levels.
rule ops_rule_expr OperatorsRule = (
  "operators" !ident_char -ws &"{" -- "{" {ml := false} items:(-empty_stmts i:ops_stmt)* -empty_stmts
  cs:comments -("}" @error(message="expected closing brace for operators"))
) => OperatorsRule{Items: map($items, (x) => $x.i), Comments: $cs}
rule ops_stmt OperatorsStmt = (
  !(comments "}")
  s:((ops_skip_stmt / ops_operand_stmt / ops_level_stmt / _|_ @error(message="expected skip, operand, or level")) #recover(skip=item_sync))
) => $s
rule ops_skip_stmt OperatorsSkip = (
  cs:comments "skip" -word_end -- x:(rule_expr @error(message="expected skip expression")) tc:item_end
) => OperatorsSkip{Expr: $x, Comments: concat($cs, $tc)}
rule ops_operand_stmt OperatorsOperand = (
  cs:comments "operand" -word_end -- x:(rule_expr @error(message="expected operand expression")) -ws
  a:whole_action? tc:item_end
) => OperatorsOperand{Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule ops_level_stmt OperatorsLevel = (
  cs:comments "level" -word_end -- name:ident? -ws
  -("{" @error(message="expected opening brace for level")) xs:(-empty_stmts o:ops_operator)*
  -empty_stmts tc:comments -("}" @error(message="expected closing brace for level")) end:item_end
) => OperatorsLevel{Name: $name, Operators: map($xs, (x) => $x.o), Comments: concat($cs, $tc, $end)}
rule ops_operator OpsOperator = (
  !(comments "}")
  s:((ops_prefix / ops_postfix / ops_infix / _|_ @error(message="expected prefix, postfix, or infix")) #recover(skip=item_sync))
) => $s
rule ops_prefix Prefix = (
  cs:comments "prefix" -word_end -- x:(rule_expr @error(message="expected prefix expression")) -ws
  a:whole_action? tc:item_end
) => Prefix{Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule ops_postfix Postfix = (
  cs:comments "postfix" -word_end -- x:(rule_expr @error(message="expected postfix expression")) -ws
  a:whole_action? tc:item_end
) => Postfix{Expr: $x, Action: $a, Comments: concat($cs, $tc)}
rule ops_infix Infix = (
  cs:comments "infix" -word_end --
  assoc:(("left" / "right" / "none") @error(message="expected left, right, or none associativity"))
  -word_end x:(rule_expr @error(message="expected infix expression")) -ws a:whole_action? tc:item_end
) => Infix{Assoc: text($assoc), Expr: $x, Action: $a, Comments: concat($cs, $tc)}

// Predicate Actions and Value Actions share statement syntax. The source AST
// retains unsupported blocks and inline actions for later compilation checks.
rule action Action = default_action / action_block / action_expr
rule default_action DefaultAction = "..."
rule action_block ActionBlock = (
  "{" {ml := false} xs:(s:action_block_stmt)* cs:comments
  -("}" @error(message="expected closing brace for action block"))
) => ActionBlock{Actions: map($xs, (x) => $x.s), Comments: $cs}
rule action_block_stmt ActionStmt = !(comments "}") x:(action_block_value #recover(skip=item_sync)) => $x
rule action_block_value ActionStmt = -comments x:action_stmt -item_end => $x
rule action_stmt ActionStmt = action_assign_stmt / action_expr
rule action_assign_stmt ActionAssign = (
  name:ident -ws ":=" -ws x:(action_expr @error(message="expected assignment value"))
) => ActionAssign{Name: $name, Expr: $x}
rule action_expr ActionExpr = lambda / action_ops
rule action_ops ActionExpr = operators {
  skip ws
  operand constructor / call / action_group / int / string / true / false / nil / capture_ref / var_ref
  level disjunction { infix left "||" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level conjunction { infix left "&&" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level comparison { infix none "==" / "!=" / "<=" / ">=" / "<" / ">" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level addition { infix left "+" / "-" !("-" / ">") => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level multiplication { infix left "*" / "/" / "%" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
  level unary { prefix "-" !"-" / "!" !"=" => UnaryOp{Op: text($op), X: $rhs} }
  level field_access { postfix "." -ws name:ident => FieldAccess{X: $lhs, Name: $name} }
}
rule lambda Lambda = (
  "(" {ml := true} -ws names:lambda_params? -ws ")" -ws "=>" -ws x:action_expr
) => Lambda{Params: concat($names), Body: $x}
rule lambda_params []Ident = first:ident rest:(-ws "," -ws name:ident)* => concat(list($first), map($rest, (x) => $x.name))
rule action_group ActionGroup = (
  "(" {ml := true} -ws x:action_expr -ws
  -(")" @error(message="expected closing parenthesis for action expression"))
) => ActionGroup{Expr: $x}
rule call Call = (
  name:var_name "(" {ml := true} -ws -- args:action_args? -ws
  -(")" @error(message="expected closing parenthesis for function call"))
) => Call{X: $name, Args: concat($args)}
rule action_args []ActionExpr = first:action_expr rest:(-ws "," -ws x:action_expr)* => concat(list($first), map($rest, (x) => $x.x))
rule constructor Constructor = (
  name:var_name -ws "{" {ml := true} -ws -- fields:constructor_fields? cs:comments
  -("}" @error(message="expected closing brace for constructor"))
) => Constructor{X: $name, Inits: concat($fields), Comments: $cs}
rule constructor_fields []InitField = (
  first:init_field rest:(-ws "," -ws f:init_field)* (-ws "," -ws)?
) => concat(list($first), map($rest, (x) => $x.f))
rule init_field InitField = (
  cs:comments name:(ident @error(message="expected initializer field name")) -ws -":" -ws
  x:(action_expr @error(message="expected initializer value"))
) => InitField{Name: $name, Val: $x, Comments: $cs}
rule int Int = digit+ #atomic
rule true True = "true" !ident_char
rule false False = "false" !ident_char
rule nil Nil = "nil" !ident_char
rule capture_ref CaptureRef = "$" (ident / digit+) #atomic
rule var_name VarRef = ident
rule var_ref VarRef = ident !"("

// Trivia. Space is discarded before and after each retained comment, keeping
// the resulting list homogeneous without introducing nil whitespace elements.
rule ws []Comment = ({ml} cs:comments / cs:horizontal) => $cs
rule comments []Comment = -space* xs:(c:comment -space*)* => map($xs, (x) => $x.c)
rule horizontal []Comment = -space_no_line* xs:(c:(line_comment / block_no_line) -space_no_line*)* => map($xs, (x) => $x.c)
rule word_end = !ident_char -ws
rule space_no_line = !nl space
rule nl = "\r\n" / [\r\n]
rule space = [ \t\n\u{b}\u{c}\r\u{85}\u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}]
// A lexical comment view retains trivia inside parsing and action expressions.
// Incomplete tokens remain available to the error-recovering structural pass.
rule source_comments []Comment = -source_non_comment* xs:(c:comment -source_non_comment*)* $$ => map($xs, (x) => $x.c)
rule source_non_comment = source_string / source_class / incomplete_comment / !("//" / "/*") .
rule source_string = "\"" ("\\" . / [^"\\\n])* "\""?
rule source_class = "[" ("\\" . / [^\]\\\n])* "]"?
rule incomplete_comment = !inline_comment "/*" .* $$
rule comment Comment = comment_group / inline_comment
rule comment_group CommentGroup = (
  first:comment_line rest:(-nl -space_no_line* c:comment_line)*
) => CommentGroup{Lines: concat(list($first), map($rest, (x) => $x.c))}
rule line_comment CommentGroup = c:comment_line => CommentGroup{Lines: list($c)}
rule comment_line Match = ("//" [^\n\r]*) #atomic
rule inline_comment InlineComment = (
  start:"/*" body:(inline_comment / !("/*" / "*/") .)* #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule block_no_line InlineComment = (
  start:"/*" body:(block_no_line / !("/*" / "*/" / nl) .)* #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule block_with_line InlineComment = (
  start:"/*"
  body:((block_no_line / !("/*" / "*/" / nl) .)* (nl / block_with_line) (inline_comment / !("/*" / "*/") .)*)
  #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule ident Ident = (ident_start ident_char*) #atomic
rule ident_start = [a-zA-Z_]
rule ident_char = [a-zA-Z0-9_]
rule digit = [0-9]
rule string String = "\"" ("\\" escape_char / [^"\\\n])* "\"" #atomic
rule char_class CharClass = (
  "[" not:"^"? items:(char_class_rng / char_class_chr)+
  -("]" @error(message="expected closing bracket for character class"))
) => CharClass{Not: $not != nil, Items: $items}
rule char_class_rng CharRng = start:char_class_chr "-" !"]" end:char_class_chr => CharRng{Start: $start, End: $end}
rule char_class_chr Char = ("\\" escape_char / [^\]\\\n]) #atomic
rule escape_char = "u{" [0-9a-fA-F]+ "}" / "u" [0-9a-fA-F] #repeat(4) / [ntrfvab0] / [^a-zA-Z0-9]
