// An outline whose hierarchy is given by indentation. Predicates and a variable track the current indentation.
//
//   fruits
//     apple
//     citrus
//       lemon
//   vegetables
package outline

type Item = {
    Text     Match
    Children []Item
}

rule main = {indent := 0} items:block blank* $$ => $items

// Items at the current indentation.
rule block = (blank* i:item)+ => map($1, (x) => $x.i)

// A line indented exactly at the current depth, followed by its children.
rule item Item = (
    s:spaces {len($s) == indent} text:line eol cs:children?
) => Item{Text: $text, Children: concat($cs)}

// If the next line is indented deeper, read the children with that depth as the new indentation.
// A variable definition is visible only inside this rule, so returning restores the parent's indentation.
rule children = &(blank* s:spaces) {len($s) > indent} {indent := len($s)} b:block => $b

rule spaces = " "* #atomic
rule line = [^\n]+ #atomic
rule eol = "\n" / $$
rule blank = [ \t]* "\n"
