// A subset of XML: declaration, elements, attributes, character data, references, comments and CDATA.
// A predicate checks that each end tag matches its start tag.
package xml

type Element struct { Name Name, Attrs []Attr, Children []Content }
type Attr struct { Name Name, Value AttrValue }
type Name terminal
type AttrValue terminal  // quotes included
type Text terminal       // raw character data, references included
type Comment terminal
type CData terminal
type Content = Element | Text | Comment | CData

def main: Element = decl? misc* root:element misc* $$ -> $root
def decl = "<?xml" (!"?>" .)* "?>"
def misc = (? \t\r\n)+ / comment

def element: Element = empty / pair
def empty: Element = "<" n:name as:attr* ws "/>" -> new Element{Name: $n, Attrs: $as, Children: list()}
def pair: Element = "<" n:name as:attr* ws ">" cs:content*
    "</" e:name [text($e) == text($n)] #error(message="mismatched end tag") ws ">"
    -> new Element{Name: $n, Attrs: $as, Children: $cs}

def attr: Attr = (? \t\r\n)+ n:name ws "=" ws v:value -> new Attr{Name: $n, Value: $v}
def value: AttrValue = "\"" ((?^"<&) / ref)* "\"" / "'" ((?^'<&) / ref)* "'"

def content: Content = element / cdata / comment / chardata
def chardata: Text = ((?^<&) / ref)+
def ref = "&" ((?a-zA-Z)+ / "#x" (?0-9a-fA-F)+ / "#" (?0-9)+) ";"
def comment: Comment = "<!--" (!"--" .)* "-->"
def cdata: CData = "<![CDATA[" (!"]]>" .)* "]]>"

def name: Name = (?a-zA-Z_:) (?a-zA-Z0-9_:.\-)*
def ws = (? \t\r\n)*
