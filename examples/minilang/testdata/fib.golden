Program{Body: [Func{Body: Block{Body: [If{Cond: Binary{Left: Ident("n"), Op: "<", Right: Number("2")}, Else: Block{Body: [Return{Value: Binary{Left: Call{Args: [Binary{Left: Ident("n"), Op: "-", Right: Number("1")}], Fn: Ident("fib")}, Op: "+", Right: Call{Args: [Binary{Left: Ident("n"), Op: "-", Right: Number("2")}], Fn: Ident("fib")}}}]}, Then: Block{Body: [Return{Value: Ident("n")}]}}]}, Name: Ident("fib"), Params: [Ident("n")]} Let{Name: Ident("xs"), Value: ArrayLit{Elems: [Call{Args: [Number("10")], Fn: Ident("fib")} Binary{Left: Unary{Op: "-", X: Call{Args: [Number("3")], Fn: Ident("fib")}}, Op: "*", Right: Number("2")}]}} Let{Name: Ident("i"), Value: Number("0")} While{Body: Block{Body: [ExprStmt{X: Call{Args: [Index{Index: Ident("i"), X: Ident("xs")} Cond{Cond: Binary{Left: Ident("i"), Op: "==", Right: Number("0")}, Else: String("rest"), Then: String("first")}], Fn: Ident("print")}} Assign{Target: Ident("i"), Value: Binary{Left: Ident("i"), Op: "+", Right: Number("1")}}]}, Cond: Binary{Left: Binary{Left: Ident("i"), Op: "<", Right: Call{Args: [Ident("xs")], Fn: Ident("len")}}, Op: "&&", Right: Unary{Op: "!", X: Ident("done")}}} ExprStmt{X: Index{Index: Number("0"), X: Call{Args: [String("a\\\"b")], Fn: Member{Name: Ident("call"), X: Member{Name: Ident("field"), X: Ident("obj")}}}}}]}
