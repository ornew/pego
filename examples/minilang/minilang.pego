// A small programming language. Statements are PEG rules and expressions a Operators Rule, nested in each other.
package mini

type Program = { Body []Stmt }

// --- Statements ---
type Let = { Name Ident; Value Expr }
type Assign = { Target Expr; Value Expr }
type If = { Cond Expr; Then Block; Else *(If | Block) }
type While = { Cond Expr; Body Block }
type Return = { Value *Expr }
type Func = { Name Ident; Params []Ident; Body Block }
type ExprStmt = { X Expr }
type Block = { Body []Stmt }
type Stmt ~ Let | Assign | If | While | Return | Func | ExprStmt | Block

// --- Expressions ---
type Ident terminal
type Number terminal
type String terminal
type Bool terminal
type Binary = { Left Expr; Op Match; Right Expr }
type Unary = { Op Match; X Expr }
type Call = { Fn Expr; Args []Expr }
type Index = { X Expr; Index Expr }
type Member = { X Expr; Name Ident }
type Cond = { Cond Expr; Then Expr; Else Expr }
type ArrayLit = { Elems []Expr }
type Expr ~ Ident | Number | String | Bool | Binary | Unary | Call | Index | Member | Cond | ArrayLit

rule main Program = body:stmts ws $$ => Program{Body: $body}

rule stmts = ss:(-ws s:stmt)* => map($ss, (x) => x.s)
rule block Block = "{" body:stmts ws "}" => Block{Body: $body}

// If a statement fails to parse, skip to the next ";" (or up to the next "{" or "}"), record the error and continue.
rule stmt Stmt = (
    s:(let / func / if / while / return / block / assign / exprStmt)
    #recover(skip=[^;{}\n]+ ";"?)
) => $s

rule let Let = kw_let ws n:name ws "=" v:expr ws ";" => Let{Name: $n, Value: $v}
rule assign Assign = t:expr ws "=" !"=" v:expr ws ";" => Assign{Target: $t, Value: $v}
rule if If = kw_if c:expr ws then:block e:else? => If{Cond: $c, Then: $then, Else: $e}
rule else = ws kw_else ws x:(if / block) => $x
rule while While = kw_while c:expr ws body:block => While{Cond: $c, Body: $body}
rule return Return = kw_return v:expr? ws ";" => Return{Value: $v}
rule func Func = (
    kw_fn ws n:name ws "(" ps:params? ws ")" ws body:block
) => Func{Name: $n, Params: concat($ps), Body: $body}
rule params = first:name rest:(-ws -"," -ws p:name)* => concat(list($first), map($rest, (r) => r.p))
rule exprStmt ExprStmt = x:expr ws ";" => ExprStmt{X: $x}

// --- Expressions (Operators Rule) ---
// When no expression is found, report a message instead of the list of expected alternatives.
rule expr Expr = e:operation @error(message="expected an expression") => $e

rule operation Expr = operators {
    skip ws
    operand number
    operand string
    operand bool
    operand ident
    operand "(" e:operation ws ")" => $e
    operand "[" xs:args? ws "]" => ArrayLit{Elems: concat($xs)}
    level { infix right "?" t:operation ws ":" => Cond{Cond: $lhs, Then: $t, Else: $rhs} }
    level { infix left "||" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "&&" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix none "==" / "!=" / "<=" / ">=" / "<" / ">" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "+" / "-" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "*" / "/" / "%" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { prefix "-" / "!" => Unary{Op: $op, X: $rhs} }
    level {
        postfix "(" xs:args? ws ")" => Call{Fn: $lhs, Args: concat($xs)}
        postfix "[" i:operation ws "]" => Index{X: $lhs, Index: $i}
        postfix "." ws n:name => Member{X: $lhs, Name: $n}
    }
}
rule args = first:expr rest:(-ws -"," x:expr)* => concat(list($first), map($rest, (r) => r.x))

// --- Lexical structure ---
rule ident Ident = !keyword [a-zA-Z_] idchar*
// A name in a declaration, parameter list or member access.
rule name Ident = i:ident @error(message="expected a name") => $i
rule keyword = ("let" / "fn" / "if" / "else" / "while" / "return" / "true" / "false") !idchar
rule idchar = [a-zA-Z0-9_]
rule number Number = [0-9]+ ("." [0-9]+)?
rule string = "\"" s:strchars "\"" => $s
rule strchars String = ([^"\\\n] / "\\" .)*
rule bool Bool = ("true" / "false") !idchar

rule kw_let = "let" !idchar
rule kw_fn = "fn" !idchar
rule kw_if = "if" !idchar
rule kw_else = "else" !idchar
rule kw_while = "while" !idchar
rule kw_return = "return" !idchar

// Whitespace and comments.
rule ws = ([ \t\r\n] / "//" [^\n]*)*
