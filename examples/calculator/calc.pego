// An arithmetic calculator with exponentiation, written with a Operators Rule.
package calc

type Number terminal

type Binary = {
    Left  Expr
    Op    Match
    Right Expr
}

type Unary = {
    Op Match
    X  Expr
}

type Expr ~ Number | Binary | Unary

rule main Expr = e:expr ws $$ => $e

rule expr Expr = operators {
    skip ws
    operand number
    operand "(" e:expr ws ")" => $e
    level { infix left "+" / "-" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { infix left "*" / "/" / "%" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
    level { prefix "-" / "+" => Unary{Op: $op, X: $rhs} }
    level { infix right "^" => Binary{Left: $lhs, Op: $op, Right: $rhs} }
}

rule number Number = [0-9]+ ("." [0-9]+)?
rule ws = [ \t\r\n]*
