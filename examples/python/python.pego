// A realistic subset of Python 3 that builds a typed AST modeled on Python's ast module.
//
// Layout:
//   - Indentation is tracked with the variable `indent` (the width of the current block),
//     as in examples/outline. A block's statements must start at exactly `indent`; a suite
//     opens a deeper block by redefining `indent` inside its own rule, so returning from
//     the rule restores the enclosing width (INDENT/DEDENT without tokens). Widths are
//     counted in characters, so a tab counts as one column.
//   - Implicit line joining is tracked with the variable `nl`: every rule that opens a
//     bracket defines `nl = true`, and the whitespace rule `ws` skips newlines (and
//     comments) only while it is true. Backslash continuations are skipped everywhere.
//   - Blank lines and comment-only lines are ignored wherever a statement may start.
//
// Expressions from `or` up are a Pratt expression with Python's precedence; conditional
// expressions, lambdas and `:=` are handled around it. Chained comparisons and boolean
// operators are built as nested left-associative binary nodes (Compare and BoolOp with
// Left, Op, Right) instead of Python's flat lists, so `a < b < c` is
// Compare(Compare(a, <, b), <, c).
//
// Because the variables make the parse context dependent, no rule is memoized. The grammar
// therefore avoids re-parsing a prefix in ordered choices: a construct whose kind depends
// on what follows its first element (tuple or parenthesized expression, slice or index,
// dict or set, statement kinds after an expression) parses the element once and then
// optional tails captured with `{0,1}`, and folds over those lists to choose the node to
// build (folding over an empty list returns the initial value).
//
// Not supported: match statements, type parameters and `type` aliases (PEP 695), `except*`,
// and the inside of f-string replacement fields (an f-string is one terminal). Some rules
// that CPython checks after parsing are not checked, e.g. the targets of assignments may be
// any expression and a parameter without a default may follow one with a default.
package python

type Module struct { Body []StmtNode }

// --- Statements ---
type FunctionDef struct {
    Name          Identifier
    Args          Arguments
    Body          []StmtNode
    DecoratorList []ExprNode
    Returns       *ExprNode
}
type AsyncFunctionDef struct {
    Name          Identifier
    Args          Arguments
    Body          []StmtNode
    DecoratorList []ExprNode
    Returns       *ExprNode
}
type ClassDef struct {
    Name          Identifier
    Bases         []ExprNode
    Keywords      [](Keyword | Starred)
    Body          []StmtNode
    DecoratorList []ExprNode
}
type Return struct { Value *ExprNode }
type Delete struct { Targets []ExprNode }
type Assign struct { Targets []ExprNode, Value ExprNode }
type AugAssign struct { Target ExprNode, Op Match, Value ExprNode }
type AnnAssign struct { Target ExprNode, Annotation ExprNode, Value *ExprNode }
type For struct { Target ExprNode, Iter ExprNode, Body []StmtNode, OrElse []StmtNode }
type AsyncFor struct { Target ExprNode, Iter ExprNode, Body []StmtNode, OrElse []StmtNode }
type While struct { Test ExprNode, Body []StmtNode, OrElse []StmtNode }
type If struct { Test ExprNode, Body []StmtNode, OrElse []StmtNode }
type With struct { Items []WithItem, Body []StmtNode }
type AsyncWith struct { Items []WithItem, Body []StmtNode }
type Raise struct { Exc *ExprNode, Cause *ExprNode }
type Try struct { Body []StmtNode, Handlers []ExceptHandler, OrElse []StmtNode, FinalBody []StmtNode }
type Assert struct { Test ExprNode, Msg *ExprNode }
type Import struct { Names []Alias }
type ImportFrom struct { Level *Match, Module *DottedName, Names []Alias }
type Global struct { Names []Identifier }
type Nonlocal struct { Names []Identifier }
type Expr struct { Value ExprNode }
type Pass struct {}
type Break struct {}
type Continue struct {}
type StmtNode = FunctionDef | AsyncFunctionDef | ClassDef | Return | Delete | Assign | AugAssign
    | AnnAssign | For | AsyncFor | While | If | With | AsyncWith | Raise | Try | Assert | Import
    | ImportFrom | Global | Nonlocal | Expr | Pass | Break | Continue

// --- Expressions ---
type BoolOp struct { Left ExprNode, Op Match, Right ExprNode }
type NamedExpr struct { Target ExprNode, Value ExprNode }
type BinOp struct { Left ExprNode, Op Match, Right ExprNode }
type UnaryOp struct { Op Match, Operand ExprNode }
type Lambda struct { Args Arguments, Body ExprNode }
type IfExp struct { Test ExprNode, Body ExprNode, OrElse ExprNode }
type Dict struct { Items [](DictItem | DictUnpack) }
type Set struct { Elts []ExprNode }
type ListComp struct { Elt ExprNode, Generators []Comprehension }
type SetComp struct { Elt ExprNode, Generators []Comprehension }
type DictComp struct { Key ExprNode, Value ExprNode, Generators []Comprehension }
type GeneratorExp struct { Elt ExprNode, Generators []Comprehension }
type Await struct { Value ExprNode }
type Yield struct { Value *ExprNode }
type YieldFrom struct { Value ExprNode }
type Compare struct { Left ExprNode, Op Match, Right ExprNode }
// Args holds positional arguments (including *x before any keyword argument); Keywords holds
// keyword arguments, **x (a Keyword without Arg), and any *x after a keyword argument.
type Call struct { Func ExprNode, Args []ExprNode, Keywords [](Keyword | Starred) }
type Attribute struct { Value ExprNode, Attr Identifier }
type Subscript struct { Value ExprNode, Slice ExprNode }
type Starred struct { Value ExprNode }
type ListExpr struct { Elts []ExprNode }
type Tuple struct { Elts []ExprNode }
type Slice struct { Lower *ExprNode, Upper *ExprNode, Step *ExprNode }
type Name terminal
// Numbers, True, False, None, `...`, and string literals without an f prefix. Adjacent
// string literals form a single constant, as in Python; the text keeps the quotes.
type Constant terminal
// Adjacent string literals where at least one has an f prefix (the fields are not parsed).
type JoinedStr terminal
type ExprNode = BoolOp | NamedExpr | BinOp | UnaryOp | Lambda | IfExp | Dict | Set | ListComp
    | SetComp | DictComp | GeneratorExp | Await | Yield | YieldFrom | Compare | Call | Attribute
    | Subscript | Starred | ListExpr | Tuple | Slice | Name | Constant | JoinedStr

// --- Other nodes ---
type Identifier terminal
type DottedName terminal
// Unlike Python, each parameter carries its own default.
type Arguments struct {
    PosOnlyArgs []Arg
    Args        []Arg
    VarArg      *Arg
    KwOnlyArgs  []Arg
    KwArg       *Arg
}
type Arg struct { Arg Identifier, Annotation *ExprNode, Default *ExprNode }
type Keyword struct { Arg *Identifier, Value ExprNode }
type DictItem struct { Key ExprNode, Value ExprNode }
type DictUnpack struct { Value ExprNode }
type Comprehension struct { Async *Match, Target ExprNode, Iter ExprNode, Ifs []ExprNode }
type ExceptHandler struct { Type *ExprNode, Name *Identifier, Body []StmtNode }
type Alias struct { Name terminal, AsName *Identifier }
type WithItem struct { ContextExpr ExprNode, OptionalVars *ExprNode }
// Call arguments before they are attached to a Call or ClassDef.
type Arglist struct { Args []ExprNode, Keywords [](Keyword | Starred) }

// ============================================================================
// Module and blocks
// ============================================================================

def main: Module = [indent = 0] [nl = false] [ann = false] body:block? blank_line* end_of_input
    -> new Module{Body: concat($body)}
// Blocks end at a line that is not indented like them; the module must end there too.
def end_of_input = ((? \t\u{c})* comment? $$) #error(message="unexpected indentation")

// The statements of a block, all starting at column `indent`. Each line yields a list
// (several simple statements may share a line), so the lists are flattened.
def block = blank_line* f:statement_line ls:(blank_line* s:statement_line)*
    -> foldl($f, $ls, (acc, x) => concat($acc, $x.s))
def statement_line = sp:indentation [len($sp) == indent] s:statement -> $s
def statement = compound_line / simple_stmts
def compound_line = c:compound_stmt -> list($c)

// A suite is either simple statements on the same line or an indented block.
def suite = ":" #error(message="expected ':'") ws b:suite_body -> $b
def suite_body = block_suite / simple_stmts
def block_suite = newline b:(indented_block #error(message="expected an indented block")) -> $b
// The next non-blank line must be indented deeper than the enclosing block; its width
// becomes the new `indent` until this rule returns.
def indented_block = &(blank_line* s:indentation) [len($s) > indent] [indent = len($s)] b:block -> $b

// Positions the input at the start of the next non-blank line indented like the current
// block. Used for clauses that continue a compound statement (elif, else, except, ...).
def same_indent = blank_line* s:indentation [len($s) == indent]

// One or more simple statements separated by ";" and ended by a newline.
def simple_stmts = f:simple_stmt r:(ws ";" ws s:simple_stmt)* (ws ";")? ws eol
    -> concat(list($f), map($r, (x) => $x.s))

// A simple statement must be followed by ";" or the end of the line. A line that fails to
// parse is recorded as an error and skipped together with any more deeply indented lines
// that follow (its body, if the broken line was the header of a compound statement).
def simple_stmt: StmtNode = s:(terminated_simple_stmt / compound_probe) #recover(skip=skip_line) -> $s
// Only reached when a line is neither a compound nor a simple statement: parsing the compound
// statement again inside the recovery reports the error where it went the farthest (in a
// broken header such as `def f(x:`) instead of at the start of the line.
def compound_probe: StmtNode = c:compound_stmt _|_ -> $c
def terminated_simple_stmt: StmtNode = s:(pass / break / continue / return / raise / global / nonlocal
    / del / assert / import / from_import / expr_stmt) stmt_end -> $s
// Consumes the trailing spaces and comment, but not the ";" or the newline.
def stmt_end = ws (&(";" / newline / $$)) #error(message="invalid syntax")
def skip_line = (?^\n)+ deeper_line*
def deeper_line = newline blank_line* s:indentation [len($s) > indent] (?^\n)+

// ============================================================================
// Simple statements
// ============================================================================

def pass: Pass = kw_pass -> new Pass{}
def break: Break = kw_break -> new Break{}
def continue: Continue = kw_continue -> new Continue{}
def return: Return = kw_return v:(ws x:star_exprs)? -> new Return{Value: $x}
def raise: Raise = kw_raise v:(ws x:expression c:(ws kw_from ws f:expression)?)?
    -> new Raise{Exc: $x, Cause: $f}
def global: Global = kw_global ws ns:identifiers -> new Global{Names: $ns}
def nonlocal: Nonlocal = kw_nonlocal ws ns:identifiers -> new Nonlocal{Names: $ns}
def identifiers = f:identifier r:(ws "," ws i:identifier)* -> concat(list($f), map($r, (x) => $x.i))
def del: Delete = kw_del ws f:target r:(ws "," ws t:target)* (ws ",")?
    -> new Delete{Targets: concat(list($f), map($r, (x) => $x.t))}
def assert: Assert = kw_assert ws t:expression m:(ws "," ws x:expression)? -> new Assert{Test: $t, Msg: $x}

def import: Import = kw_import ws f:dotted_alias r:(ws "," ws a:dotted_alias)*
    -> new Import{Names: concat(list($f), map($r, (x) => $x.a))}
def dotted_alias: Alias = n:dotted_name a:(ws kw_as ws i:identifier)? -> new Alias{Name: $n, AsName: $i}
def from_import: ImportFrom = kw_from ws l:dots? ws m:dotted_name? [$l != nil || $m != nil]
    ws kw_import #error(message="expected 'import'") ws ns:import_names #error(message="expected names to import")
    -> new ImportFrom{Level: $l, Module: $m, Names: $ns}
def dots = @("."+ (ws "."+)*)
def import_names = paren_import_names / import_star / plain_import_names
def paren_import_names = "(" [nl = true] ws ns:plain_import_names (ws ",")? ws ")" -> $ns
def import_star = s:star_name -> list(new Alias{Name: $s})
def star_name: DottedName = "*"
def plain_import_names = f:import_alias r:(ws "," ws a:import_alias)*
    -> concat(list($f), map($r, (x) => $x.a))
def import_alias: Alias = n:identifier a:(ws kw_as ws i:identifier)? -> new Alias{Name: $n, AsName: $i}
def dotted_name: DottedName = identifier (ws "." ws identifier)*

// An expression statement, possibly followed by exactly one of the tails that turn it into
// an assignment (`a = b = c`), an augmented assignment (`a += 1`), or an annotated
// assignment (`a: int = 1`). The expression is parsed once; the tails are optional lists
// of at most one element, and folding over them picks the statement to build.
def expr_stmt: StmtNode = x:star_exprs_or_yield
    a:(ts:(ws "=" !"=" ws t:star_exprs &(ws "=" !"="))* ws "=" !"=" ws v:assign_value){0,1}
    g:(ws op:augop ws v:assign_value){0,1}
    n:(ws ":" ws ty:expression d:(ws "=" !"=" ws v:assign_value)?){0,1}
    [len($a) + len($g) + len($n) <= 1]
    -> foldl(foldl(foldl(new Expr{Value: $x},
        $a, (acc, t) => new Assign{Targets: concat(list($x), map($t.ts, (q) => $q.t)), Value: $t.v}),
        $g, (acc, t) => new AugAssign{Target: $x, Op: $t.op, Value: $t.v}),
        $n, (acc, t) => new AnnAssign{Target: $x, Annotation: $t.ty, Value: $t.v})
def assign_value: ExprNode = yield_expr / star_exprs
def star_exprs_or_yield: ExprNode = yield_expr / star_exprs
def augop = @("+=" / "-=" / "**=" / "*=" / "@=" / "//=" / "/=" / "%=" / "&=" / "|=" / "^=" / "<<=" / ">>=")

// ============================================================================
// Compound statements
// ============================================================================

def compound_stmt: StmtNode = if / while / for / try / with / funcdef / async_funcdef / classdef
    / async_for / async_with

def if: If = kw_if ws t:named_expr ws b:suite o:elif_else? -> new If{Test: $t, Body: $b, OrElse: concat($o)}
// `elif` is represented as an If in the OrElse of the previous one, as in Python.
def elif_else: []StmtNode = same_indent r:(elif / else) -> $r
def elif = kw_elif ws t:named_expr ws b:suite o:elif_else?
    -> list(new If{Test: $t, Body: $b, OrElse: concat($o)})
def else = kw_else ws b:suite -> $b
def else_clause = same_indent e:else -> $e

def while: While = kw_while ws t:named_expr ws b:suite e:else_clause?
    -> new While{Test: $t, Body: $b, OrElse: concat($e)}
def for: For = kw_for ws t:target_list ws kw_in #error(message="expected 'in'") ws it:star_exprs ws b:suite
    e:else_clause? -> new For{Target: $t, Iter: $it, Body: $b, OrElse: concat($e)}
def async_for: AsyncFor = kw_async ws kw_for ws t:target_list ws kw_in ws it:star_exprs ws b:suite
    e:else_clause? -> new AsyncFor{Target: $t, Iter: $it, Body: $b, OrElse: concat($e)}

def try: Try = kw_try ws b:suite hs:handler* e:else_clause? f:finally?
    [len($hs) > 0 || $f != nil] #error(message="expected 'except' or 'finally'")
    -> new Try{Body: $b, Handlers: $hs, OrElse: concat($e), FinalBody: concat($f)}
def handler: ExceptHandler = same_indent kw_except ws ty:(t:expression n:(ws kw_as ws i:identifier)?)? ws b:suite
    -> new ExceptHandler{Type: $t, Name: $i, Body: $b}
def finally = same_indent kw_finally ws b:suite -> $b

def with: With = kw_with ws is:with_items ws b:suite -> new With{Items: $is, Body: $b}
def async_with: AsyncWith = kw_async ws kw_with ws is:with_items ws b:suite -> new AsyncWith{Items: $is, Body: $b}
// `with (a as b, c as d):` is tried before treating the parenthesis as part of an expression.
def with_items = paren_with_items / with_item_list
def paren_with_items = "(" [nl = true] ws is:with_item_list ws ")" &(ws ":") -> $is
def with_item_list = f:with_item r:(ws "," ws w:with_item)* (ws ",")? -> concat(list($f), map($r, (x) => $x.w))
def with_item: WithItem = e:expression a:(ws kw_as ws t:target)? -> new WithItem{ContextExpr: $e, OptionalVars: $t}

def funcdef: FunctionDef = ds:decorators kw_def ws n:name_def ws a:def_params ws r:returns? ws b:suite
    -> new FunctionDef{Name: $n, Args: $a, Body: $b, DecoratorList: $ds, Returns: $r}
def async_funcdef: AsyncFunctionDef = ds:decorators kw_async ws kw_def ws n:name_def ws a:def_params ws r:returns?
    ws b:suite -> new AsyncFunctionDef{Name: $n, Args: $a, Body: $b, DecoratorList: $ds, Returns: $r}
def returns = "->" ws e:expression -> $e
def classdef: ClassDef = ds:decorators kw_class ws n:name_def ws a:class_args ws b:suite
    -> new ClassDef{Name: $n, Bases: $a.Args, Keywords: $a.Keywords, Body: $b, DecoratorList: $ds}
def class_args: Arglist = call_args / no_args
def no_args: Arglist = "" -> new Arglist{Args: list(), Keywords: list()}

// Each decorator is on its own line, followed by the decorated definition at the same indent.
def decorators = ds:(d:decorator)* -> map($ds, (x) => $x.d)
def decorator = "@" ws e:named_expr ws newline same_indent -> $e

def name_def: Identifier = i:identifier #error(message="expected a name") -> $i

// ============================================================================
// Parameters
// ============================================================================

// Parameters of a def may have annotations; those of a lambda may not (its ":" ends them).
def def_params: Arguments = "(" #error(message="expected '('") [nl = true] [ann = true] ws a:parameters ws
    ")" #error(message="expected ')'") -> $a
def lambda_params: Arguments = [ann = false] a:parameters -> $a

// [positional-only "/"] [regular] ["*" [vararg] [keyword-only]] ["**" kwarg]
def parameters: Arguments =
    po:posonly_params?
    as:param_list
    st:(s:"*" !"*" ws va:param_nodefault? param_end ko:param_list)?
    kw:("**" ws k:param_nodefault param_end)?
    -> new Arguments{PosOnlyArgs: concat($po), Args: $as, VarArg: $va, KwOnlyArgs: concat($ko), KwArg: $k}
def posonly_params = ps:(p:param param_end)+ "/" param_end -> map($ps, (x) => $x.p)
def param_list = ps:(p:param param_end)* -> map($ps, (x) => $x.p)
def param: Arg = n:identifier a:annotation? d:(ws "=" !"=" ws v:expression)?
    -> new Arg{Arg: $n, Annotation: $a, Default: $v}
def param_nodefault: Arg = n:identifier a:annotation? -> new Arg{Arg: $n, Annotation: $a}
def annotation = [ann] ws ":" ws e:expression -> $e
// A parameter is followed by a comma, or ends the list.
def param_end = ws ("," ws / &(")" / ":")) #error(message="expected ',' or ')'")

// ============================================================================
// Expressions
// ============================================================================

// The conditional expression is the weakest operator; it is parsed outside the Pratt
// expression so that its condition is parsed once (an operator part is tried, and its
// sub-expressions parsed, before the precedence check, at every enclosing level).
def expression: ExprNode = d:disjunction t:(ws kw_if ws c:disjunction ws kw_else ws e:expression){0,1}
    -> foldl($d, $t, (acc, x) => new IfExp{Test: $x.c, Body: $d, OrElse: $x.e})
def named_expr: ExprNode = walrus / expression
def walrus: NamedExpr = n:name ws ":=" ws v:expression -> new NamedExpr{Target: $n, Value: $v}
def disjunction: ExprNode = operation
def star_named_expr: ExprNode = starred / named_expr
def starred: Starred = "*" !"*" ws v:operation(bitor) -> new Starred{Value: $v}

// A comma-separated list of expressions forms a Tuple; a single expression without a comma
// is returned as is.
def star_exprs: ExprNode = f:star_named_expr
    t:(r:(ws "," ws e:star_named_expr)+ (ws ",")? / ws ","){0,1}
    -> foldl($f, $t, (acc, x) => new Tuple{Elts: concat(list($f), map($x.r, (y) => $y.e))})

// Assignment and loop targets: like expressions, but without comparisons (so `in` ends them).
def target: ExprNode = starred / operation(bitor)
def target_list: ExprNode = f:target t:(r:(ws "," ws e:target)+ (ws ",")? / ws ","){0,1}
    -> foldl($f, $t, (acc, x) => new Tuple{Elts: concat(list($f), map($x.r, (y) => $y.e))})

def yield_expr: ExprNode = yield_from / yield
def yield_from: YieldFrom = kw_yield ws kw_from ws v:expression -> new YieldFrom{Value: $v}
def yield: Yield = kw_yield v:(ws x:star_exprs)? -> new Yield{Value: $x}

// Python's operator precedence from `or` (the weakest) to the strongest. A lambda is an atom
// whose body extends as far as possible.
def operation: ExprNode = pratt {
    skip ws
    operand atom
    level disj { infix left kw_or -> new BoolOp{Left: $lhs, Op: $op, Right: $rhs} }
    level conj { infix left kw_and -> new BoolOp{Left: $lhs, Op: $op, Right: $rhs} }
    level inversion { prefix kw_not -> new UnaryOp{Op: $op, Operand: $rhs} }
    level comparison { infix left cmp_op -> new Compare{Left: $lhs, Op: $op, Right: $rhs} }
    level bitor { infix left "|" !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs} }
    level bitxor { infix left "^" !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs} }
    level bitand { infix left "&" !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs} }
    level shift { infix left ("<<" / ">>") !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs} }
    level arith { infix left ("+" / "-") !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs} }
    level term {
        infix left ("*" !"*" / "@" / "//" / "/" !"/" / "%") !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs}
    }
    level factor { prefix "+" / "-" / "~" -> new UnaryOp{Op: $op, Operand: $rhs} }
    // `-x ** y` is -(x ** y), and the right operand may itself be unary: `2 ** -1`.
    level power { infix right "**" !"=" -> new BinOp{Left: $lhs, Op: $op, Right: $rhs} }
    level await { prefix kw_await -> new Await{Value: $rhs} }
    level primary {
        postfix a:call_args -> new Call{Func: $lhs, Args: $a.Args, Keywords: $a.Keywords}
        postfix s:subscript -> new Subscript{Value: $lhs, Slice: $s}
        postfix "." ws n:identifier -> new Attribute{Value: $lhs, Attr: $n}
    }
}

def atom: ExprNode = strings / number / constant / lambda / name / paren / list_display / brace_display
    / no_atom
// Never matches; reports a missing expression where an atom should start (errors inside
// an atom that has started keep their own messages).
def no_atom: Name = _|_ #error(message="expected an expression")
def lambda: Lambda = kw_lambda ws a:lambda_params ws ":" #error(message="expected ':'") ws b:expression
    -> new Lambda{Args: $a, Body: $b}

def cmp_op = "==" / "!=" / "<=" / ">=" / "<" !"<" / ">" !">" / kw_in / kw_not ws kw_in
    / kw_is ws kw_not / kw_is

// --- Calls and subscripts ---

def call_args: Arglist = "(" [nl = true] ws
    ps:(p:positional_arg !(ws "=" !"=") arg_end)*
    ks:(k:keyword_arg arg_end)* ([len($ks) > 0] misplaced_positional)?
    ws ")" #error(message="expected ')'")
    -> new Arglist{Args: map($ps, (x) => $x.p), Keywords: map($ks, (x) => $x.k)}
// A lone generator expression argument needs no parentheses of its own: f(x for x in y).
def positional_arg: ExprNode = starred / genexp_arg
def genexp_arg: ExprNode = e:named_expr g:(ws cs:comp_clauses){0,1}
    -> foldl($e, $g, (acc, x) => new GeneratorExp{Elt: $e, Generators: $x.cs})
def keyword_arg = kwarg / double_starred_arg / starred
// Never matches; reports a positional argument after a keyword argument.
def misplaced_positional: Keyword = (e:genexp_arg !(ws "=" !"=") _|_)
    #error(message="positional argument follows keyword argument") -> new Keyword{Value: $e}
def kwarg: Keyword = n:identifier ws "=" !"=" ws v:expression -> new Keyword{Arg: $n, Value: $v}
def double_starred_arg: Keyword = "**" ws v:expression -> new Keyword{Value: $v}
def arg_end = ws ("," ws / &")") #error(message="expected ',' or ')'")

def subscript: ExprNode = "[" [nl = true] ws s:slices ws "]" #error(message="expected ']'") -> $s
def slices: ExprNode = f:slice_item t:(r:(ws "," ws e:slice_item)+ (ws ",")? / ws ","){0,1}
    -> foldl($f, $t, (acc, x) => new Tuple{Elts: concat(list($f), map($x.r, (y) => $y.e))})
def slice_item: ExprNode = lower_slice / upper_slice
def lower_slice: ExprNode = e:star_named_expr t:(ws ":" ws u:expression? (ws ":" ws s:expression?)?){0,1}
    -> foldl($e, $t, (acc, x) => new Slice{Lower: $e, Upper: $x.u, Step: $x.s})
def upper_slice: Slice = ":" ws u:expression? (ws ":" ws s:expression?)? -> new Slice{Upper: $u, Step: $s}

// --- Displays ---

// (), (x), (x,), (x, y), (x for x in y), (yield x)
def paren: ExprNode = "(" [nl = true] ws e:paren_body ws ")" #error(message="expected ')'") -> $e
def paren_body: ExprNode = yield_expr / paren_items / empty_tuple
def empty_tuple: Tuple = &")" -> new Tuple{Elts: list()}
def paren_items: ExprNode = f:star_named_expr
    g:(ws cs:comp_clauses){0,1}
    t:(r:(ws "," ws e:star_named_expr)+ (ws ",")? / ws ","){0,1}
    [len($g) == 0 || len($t) == 0]
    -> foldl(foldl($f,
        $g, (acc, x) => new GeneratorExp{Elt: $f, Generators: $x.cs}),
        $t, (acc, x) => new Tuple{Elts: concat(list($f), map($x.r, (y) => $y.e))})

// [], [x, y], [x for x in y]
def list_display: ExprNode = "[" [nl = true] ws e:list_body ws "]" #error(message="expected ']'") -> $e
def list_body: ExprNode = list_items / empty_list
def empty_list: ListExpr = &"]" -> new ListExpr{Elts: list()}
def list_items: ExprNode = f:star_named_expr
    g:(ws cs:comp_clauses){0,1}
    r:(ws "," ws e:star_named_expr)* (ws ",")?
    [len($g) == 0 || len($r) == 0]
    -> foldl(new ListExpr{Elts: concat(list($f), map($r, (y) => $y.e))},
        $g, (acc, x) => new ListComp{Elt: $f, Generators: $x.cs})

// {}, {k: v, **d}, {k: v for ...}, {x, y}, {x for ...}
def brace_display: ExprNode = "{" [nl = true] ws e:brace_body ws "}" #error(message="expected '}'") -> $e
def brace_body: ExprNode = brace_items / dict_unpack_first / empty_dict
def empty_dict: Dict = &"}" -> new Dict{Items: list()}
// The first element is parsed once. A ":" after it makes the display a dict, and a
// comprehension after the first element (and its value) makes it a comprehension.
def brace_items: ExprNode = f:star_named_expr
    kv:(ws ":" ws v:expression){0,1}
    [isdict = len($kv) > 0]
    g:(ws cs:comp_clauses){0,1}
    dr:([isdict] ws "," ws e:dict_item)*
    sr:([!isdict] ws "," ws e:star_named_expr)*
    (ws ",")?
    [len($g) == 0 || len($dr) + len($sr) == 0]
    -> foldl(
        foldl(new Set{Elts: concat(list($f), map($sr, (y) => $y.e))},
            $kv, (acc, k) => new Dict{Items: concat(list(new DictItem{Key: $f, Value: $k.v}), map($dr, (y) => $y.e))}),
        $g, (acc, x) => foldl(new SetComp{Elt: $f, Generators: $x.cs},
            $kv, (acc2, k) => new DictComp{Key: $f, Value: $k.v, Generators: $x.cs}))
def dict_unpack_first: Dict = f:dict_unpack r:(ws "," ws e:dict_item)* (ws ",")?
    -> new Dict{Items: concat(list($f), map($r, (y) => $y.e))}
def dict_item = key_value / dict_unpack
def key_value: DictItem = k:expression ws ":" ws v:expression -> new DictItem{Key: $k, Value: $v}
def dict_unpack: DictUnpack = "**" ws v:operation(bitor) -> new DictUnpack{Value: $v}

// for/if clauses of comprehensions and generator expressions.
def comp_clauses = cs:(c:comp_clause ws)+ -> map($cs, (x) => $x.c)
def comp_clause: Comprehension = a:kw_async? ws kw_for ws t:target_list ws kw_in ws it:disjunction
    ifs:(ws kw_if ws c:disjunction)*
    -> new Comprehension{Async: $a, Target: $t, Iter: $it, Ifs: map($ifs, (x) => $x.c)}

// ============================================================================
// Lexical structure
// ============================================================================

def name: Name = !keyword idstart idchar*
def identifier: Identifier = !keyword idstart idchar*
def idstart = (?a-zA-Z_\u{80}-\u{10FFFF})
def idchar = (?a-zA-Z0-9_\u{80}-\u{10FFFF})

// "assert" and "async" come before "as" because a choice commits to its first match.
def keyword = ("False" / "None" / "True" / "and" / "assert" / "async" / "as" / "await" / "break"
    / "class" / "continue" / "def" / "del" / "elif" / "else" / "except" / "finally" / "for"
    / "from" / "global" / "if" / "import" / "in" / "is" / "lambda" / "nonlocal" / "not" / "or"
    / "pass" / "raise" / "return" / "try" / "while" / "with" / "yield") !idchar

def constant: Constant = ("True" / "False" / "None") !idchar / "..."

// --- Numbers ---
def number: Constant = imagnumber / floatnumber / integer
def integer = "0" (?xX) ("_"? (?0-9a-fA-F))+ / "0" (?oO) ("_"? (?0-7))+ / "0" (?bB) ("_"? (?01))+ / digits
def digits = (?0-9) ("_"? (?0-9))*
def floatnumber = exponentfloat / pointfloat
def pointfloat = digits? "." digits / digits "."
def exponentfloat = (pointfloat / digits) (?eE) (?+\-)? digits
def imagnumber = (floatnumber / digits) (?jJ)

// --- Strings ---
// Adjacent literals are one constant. If any of them is an f-string, the whole is a JoinedStr.
// The lookahead keeps a name such as `r` or `f` from being reported as an unterminated prefix.
def strings: ExprNode = &((?rRbBuUfF){0,2} (?"')) s:(plain_strings / joined_strings) -> $s
def plain_strings: Constant = plain_string (ws plain_string)* !(ws fstring)
def joined_strings: JoinedStr = string (ws string)*
def string = fstring / plain_string
def plain_string = string_prefix? string_body
def string_prefix = (?rR) (?bB) / (?bB) (?rR) / (?rRbBuU)
def string_body = "\"\"\"" (!"\"\"\"" ("\\" . / .))* "\"\"\"" #error(message="unterminated triple-quoted string")
    / "'''" (!"'''" ("\\" . / .))* "'''" #error(message="unterminated triple-quoted string")
    / "\"" ("\\" . / (?^"\\\n))* "\"" #error(message="unterminated string literal")
    / "'" ("\\" . / (?^'\\\n))* "'" #error(message="unterminated string literal")

// The replacement fields of f-strings are matched by balancing braces and skipping nested
// string literals, so quotes inside a field (allowed since Python 3.12) do not end the string.
def fstring = fstring_prefix fstring_body
def fstring_prefix = (?rR) (?fF) / (?fF) (?rR) / (?fF)
def fstring_body = "\"\"\"" (!"\"\"\"" fchar)* "\"\"\"" #error(message="unterminated triple-quoted string")
    / "'''" (!"'''" fchar)* "'''" #error(message="unterminated triple-quoted string")
    / "\"" (!(?"\n) fchar)* "\"" #error(message="unterminated string literal")
    / "'" (!(?'\n) fchar)* "'" #error(message="unterminated string literal")
def fchar = "{{" / "}}" / ffield / "\\" . / (?^{})
def ffield = "{" (string / ffield / (?^{}"'))* "}"

// --- Whitespace ---
// Spaces, comments, and backslash continuations; newlines too while inside brackets.
def ws = ((? \t\u{c})+ / comment / "\\" newline / [nl] newline)*
def comment = "#" (?^\r\n)*
def newline = "\r"? "\n"
def eol = (newline / $$) #error(message="expected a newline")
def indentation = @(? \t\u{c})*
def blank_line = (? \t\u{c})* comment? newline

// --- Keywords ---
def kw_and = @("and" !idchar)
def kw_assert = @("assert" !idchar)
def kw_as = @("as" !idchar)
def kw_async = @("async" !idchar)
def kw_await = @("await" !idchar)
def kw_break = @("break" !idchar)
def kw_class = @("class" !idchar)
def kw_continue = @("continue" !idchar)
def kw_def = @("def" !idchar)
def kw_del = @("del" !idchar)
def kw_elif = @("elif" !idchar)
def kw_else = @("else" !idchar)
def kw_except = @("except" !idchar)
def kw_finally = @("finally" !idchar)
def kw_for = @("for" !idchar)
def kw_from = @("from" !idchar)
def kw_global = @("global" !idchar)
def kw_if = @("if" !idchar)
def kw_import = @("import" !idchar)
def kw_in = @("in" !idchar)
def kw_is = @("is" !idchar)
def kw_lambda = @("lambda" !idchar)
def kw_nonlocal = @("nonlocal" !idchar)
def kw_not = @("not" !idchar)
def kw_or = @("or" !idchar)
def kw_pass = @("pass" !idchar)
def kw_raise = @("raise" !idchar)
def kw_return = @("return" !idchar)
def kw_try = @("try" !idchar)
def kw_while = @("while" !idchar)
def kw_with = @("with" !idchar)
def kw_yield = @("yield" !idchar)
