// ZeroParse grammar syntax and typed source tree.
// Source forms are preserved before semantic validation and compilation.
package zp

// ml reports whether line breaks are allowed between tokens inside the enclosing delimiters.
var ml bool

type Ident = node[string]
type Int = node[string]
type String = node[string]
type True = node[string]
type False = node[string]
type Nil = node[string]
type CaptureRef = node[string]
type VarRef = node[string]

type File = { Pkg *PkgDecl; Decls []Decl; Comments []Comment; TrailingComments []Comment; Text string; Head SourceLead; Gaps []CommentGap }
type PkgDecl ~ Pkg | error
type Pkg = { Name Ident; Comments []Comment; Source SourceMetadata }
type PkgBody = { Name Ident }
// Ownership is constructed at syntax boundaries; the adapter only converts spans.
// A statement in a list cannot see the boundary before it, so it records the
// boundary after it: its own trailing group, and the leading and detached groups
// of the next sibling. A container records the boundary after its opening
// delimiter in Head for the first element.
type SourceSpan ~ PkgBody | TypeDefBody | TypeAliasBody | VarDefBody | RuleDefBody | FieldBody | OperatorsSkipBody | OperatorsOperandBody | OperatorsLevelBody | OperatorsOperatorBody | InitFieldBody
type SourceMetadata = { Span SourceSpan; Leading string; Trailing []string; Detached []SourceComment; Next SourceLead }
type SourceItem = { Trailing []string; Next SourceLead }
type SourceLead = { Leading string; Detached []SourceComment; HasNext bool }
type SourceComment = { Text string }
// A gap is the trivia between two tokens that holds at least one comment. Its
// node spans exactly that trivia, so a source node starting where a gap ends
// can lead it and a node ending where a gap starts can trail it. The grammar
// keeps the groups of each gap; the adapter assigns them to owners.
type CommentGap = { Trailing []string; HasTrailing bool; Leading string; Detached []SourceComment; HasNext bool }
type GapFlag = {}
type SourceBoundary = { Trailing []string; Leading string; Detached []SourceComment; HasNext bool }
type Decl ~ TypeDef | TypeAlias | VarDef | RuleDef | error
type TypeDecl ~ TypeDef | TypeAlias
type TypeDef = { Name Ident; Type DefinedType; Comments []Comment; SourceSpan TypeDefBody; Source SourceItem }
type TypeDefBody = { Name Ident; Type DefinedType }
// A type definition defines a struct type or a named node type.
type DefinedType ~ StructType | TypeApp
type TypeAlias = { Name Ident; Type Type; Comments []Comment; SourceSpan TypeAliasBody; Source SourceItem }
type TypeAliasBody = { Name Ident; Type Type }
// A variable definition declares a parser variable: var Name [Type] [= Value].
type VarDef = { Name Ident; Type *Type; Value *ActionExpr; Comments []Comment; SourceSpan VarDefBody; Source SourceItem }
type VarDefBody = { Name Ident; Type *Type; Value *ActionExpr }
type FieldSpec ~ Field | error
type Field = { Name Ident; Type Type; Comments []Comment; SourceSpan FieldBody; Source SourceItem }
type FieldBody = { Name Ident; Type Type }
type Type ~ TypeRef | TypeApp | TypeGroup | TupleType | StructType | OptionalType | ListType | JoinType | MeetType | Bottom
type TypeRef = { Name Ident }
type TypeApp = { Name Ident; Args []Type } // T[U]
type TypeGroup = { Type Type }
type TupleType = { Types []Type }                                             // (), (T,), (T, U)
type StructType = { Fields []FieldSpec; Comments []Comment; Head SourceLead } // { A T; B U }
type OptionalType = { Type Type }
type ListType = { Type Type }
type JoinType = { L Type; R Type }
type MeetType = { L Type; R Type }

type Comment ~ CommentGroup | InlineComment
type CommentGroup = { Lines []node[string] }
type InlineComment = { Start node[string]; Body node[string]; End node[string] }
type RuleDef = { Attrs []Attr; Name Ident; Type *Type; Expr RuleExpr; Action *Action; Comments []Comment; SourceSpan RuleDefBody; Source SourceItem }
type RuleDefBody = { Attrs []Attr; AttrComments []Comment; Name Ident; Type *Type; Expr RuleExpr; Action *Action }
type RuleExpr ~ (
    RuleRef | LevelCall | RuleGroup | InlineAction | Sequence | Choice | Discard | Lookahead | Top | Bottom | BeginLine | BeginInput | EndLine | EndInput | Any | Cut | String | CharClass | Optional | ZeroOrMore | OneOrMore | Repeat | Capture | Predicate | Atomic | Stream | MissingPragma | IgnoreCase | Recover | Attributed | OperatorsRule
)
type RuleRef = { Name Ident }
type LevelCall = { Rule Ident; Level Ident }
type RuleGroup = { Expr RuleExpr }
type InlineAction = { Expr RuleExpr; Action Action }
type Sequence = { L RuleExpr; R RuleExpr }
type Choice = { L RuleExpr; R RuleExpr }
type Discard = { X RuleExpr }
type Lookahead = { Op string; X RuleExpr }
type Top = node[string]
type Bottom = node[string]
type BeginLine = node[string]
type BeginInput = node[string]
type EndLine = node[string]
type EndInput = node[string]
type Any = node[string]
type Cut = node[string]
type CharClass = { Not bool; Items []CharClassItem }
type CharClassItem ~ Char | CharRng
type Char = node[string]
type CharRng = { Start Char; End Char }
type Optional = { X RuleExpr }
type ZeroOrMore = { X RuleExpr }
type OneOrMore = { X RuleExpr }
type Repeat = { X RuleExpr; Min *Int; Max *Int; Range bool }
type Capture = { Name Ident; Expr RuleExpr }
type Predicate = { Actions []ActionStmt; Comments []Comment }
type Atomic = { X RuleExpr }
type Stream = { X RuleExpr }
type MissingPragma = { X RuleExpr }
type IgnoreCase = { X RuleExpr }
type Recover = { X RuleExpr; Skip RuleExpr }
type Attributed = { X RuleExpr; Attr Attr }
type Attr = { Name Ident; Args []*AttrValue; KwArgs []AttrNamed }
type AttrValue ~ Int | String | True | False | Nil | RuleExpr
// Slots keep an omitted positional argument distinct from the end of a list.
type AttrSlot = { Value *AttrValue }
type AttrNamed = { Name Ident; Value AttrValue }
type AttrArgs = { Args []*AttrValue; KwArgs []AttrNamed }

type OperatorsRule = { Items []OperatorsStmt; Comments []Comment; Head SourceLead }
type OperatorsStmt ~ OperatorsSkip | OperatorsOperand | OperatorsLevel | error
type OperatorsSkip = { Expr RuleExpr; Comments []Comment; SourceSpan OperatorsSkipBody; Source SourceItem }
type OperatorsSkipBody = { Expr RuleExpr }
type OperatorsOperand = { Expr RuleExpr; Action *Action; Comments []Comment; SourceSpan OperatorsOperandBody; Source SourceItem }
type OperatorsOperandBody = { Expr RuleExpr; Action *Action }
type OperatorsLevel = { Name *Ident; Operators []OpsOperator; Comments []Comment; Head SourceLead; SourceSpan OperatorsLevelBody; Source SourceItem }
type OperatorsLevelBody = { Name *Ident; Operators []OpsOperator; Head SourceLead; Comments []Comment }
type OpsOperator ~ Prefix | Postfix | Infix | error
type OperatorsOperatorBody = { Assoc string; Expr RuleExpr; Action *Action }
type Prefix = { Expr RuleExpr; Action *Action; Comments []Comment; SourceSpan OperatorsOperatorBody; Source SourceItem }
type Postfix = { Expr RuleExpr; Action *Action; Comments []Comment; SourceSpan OperatorsOperatorBody; Source SourceItem }
type Infix = { Assoc string; Expr RuleExpr; Action *Action; Comments []Comment; SourceSpan OperatorsOperatorBody; Source SourceItem }

type Action ~ ActionExpr | ActionBlock | DefaultAction
type ActionStmt ~ ActionBind | ActionExpr | error
type ActionBind = { Name Ident; Expr ActionExpr }
type ActionBlock = { Actions []ActionStmt; Comments []Comment }
type DefaultAction = node[string]
type ActionExpr ~ (
    Int | String | True | False | Nil | CaptureRef | VarRef | BinaryOp | UnaryOp | FieldAccess | CaptureAccess | Cast | Call | Constructor | ListConstructor | ActionTuple | ActionGroup | Lambda
)
type BinaryOp = { Op string; L ActionExpr; R ActionExpr }
type UnaryOp = { Op string; X ActionExpr }
type FieldAccess = { X ActionExpr; Name Ident }
type CaptureAccess = { X ActionExpr; Capture CaptureRef } // x.$y
type Cast = { X ActionExpr; Type Type }                   // x.(T)
type Call = { X ActionExpr; Args []ActionExpr }
type Constructor = { X ActionExpr; Inits []InitField; Args []ActionExpr; Comments []Comment; Head SourceLead }
type ListConstructor = { Elem Type; Items []ActionExpr; Comments []Comment }
type InitField = { Name Ident; Val ActionExpr; Comments []Comment; SourceSpan InitFieldBody; Source SourceItem }
type InitFieldBody = { Name Ident; Val ActionExpr }
type ActionTuple = { Elems []ActionExpr } // (), (x,), (x, y)
type ActionGroup = { Expr ActionExpr }
type Lambda = { Params []Ident; Body ActionExpr }

// File and statements. Delimiter-owned expressions enable multiline trivia;
// declaration and item lists keep physical newlines as statement boundaries.
@start(default)
rule main File = f:file => $f
@start
rule file File = (
    &cs:source_comments &gaps:source_gaps &src:(.* #atomic) f:file_contents
) => File{
    Pkg: $f.Pkg,
    Decls: $f.Decls,
    Comments: $cs,
    TrailingComments: $f.TrailingComments,
    Text: text($src),
    Head: $f.Head,
    Gaps: $gaps,
}
rule file_contents File = (
    {ml := false}
    &head:source_head
    pkg:package_entry?
    decls:(d:decl)*
    tc:comments $$
) => File{Pkg: $pkg, Decls: map($decls, (x) => x.$d), TrailingComments: $tc, Head: $head}
rule package_entry PkgDecl = &(comments "package" !ident_char) p:(package_stmt #recover(skip=stmt_sync)) => $p
rule package_stmt Pkg = (
    &lead:source_remaining cs:comments
    body:package_body &tail:source_item_tail tc:stmt_end
) => Pkg{
    Name: $body.Name,
    Comments: concat($cs, $tc),
    Source: SourceMetadata{
        Span: $body,
        Leading: $lead.Leading,
        Detached: $lead.Detached,
        Trailing: $tail.Trailing,
        Next: $tail.Next,
    },
}
rule package_body PkgBody = (
    "package" -word_end #cut name:(ident @error(message="expected package name"))
) => PkgBody{Name: $name}
rule decl Decl = (
    !(comments $$)
    d:((type_decl / var_decl / rule_decl / _|_ @error(message="expected type, var or rule declaration")) #recover(skip=stmt_sync))
) => $d
rule stmt_end []Comment = (
    cs:horizontal tail:(stmt_sep @error(message="expected semicolon, newline, or end of file"))
) => concat($cs, $tail)
rule item_end []Comment = (
    cs:horizontal tail:(item_sep @error(message="expected semicolon, newline, or closing brace"))
) => concat($cs, $tail)
rule field_end []Comment = (
    cs:horizontal tail:(field_sep @error(message="expected semicolon, newline, or closing brace"))
) => concat($cs, $tail)
rule stmt_sep []Comment = block_sep / empty_stmt_sep
rule item_sep []Comment = block_sep / empty_item_sep
rule field_sep []Comment = block_sep / empty_field_sep
rule block_sep []Comment = c:block_with_line => list($c)
rule empty_stmt_sep []Comment = (";" / nl / &$$) => list()
rule empty_item_sep []Comment = (";" / nl / &"}") => list()
rule empty_field_sep []Comment = (";" / nl / &"}") => list()
// Recovery consumes its own separator and stops before the next item.
rule stmt_sync = -comments (sync_token / !(";" / nl) .)* (";" / nl / &$$)
rule item_sync = -comments (sync_token / !(";" / nl / "}") .)* (";" / nl / &"}" / &$$)
rule field_sync = -comments (sync_token / !(";" / nl / "}") .)* (";" / nl / &"}" / &$$)

// Completed literals, nested comments and groups do not end recovery.
rule sync_token = string / char_class / inline_comment / comment_line / sync_paren / sync_brace
rule sync_paren = "(" (sync_token / !("(" / ")" / nl) .)* ")"
rule sync_brace = "{" (sync_token / !("{" / "}" / nl) .)* "}"

// Types. Join is the weakest operation; list and optional prefixes nest.
// A type declaration is a type alias (type Name ~ Type) or a type definition
// (type Name = { ... } or type Name = node[T]).
rule type_decl TypeDecl = type_alias / type_def
rule type_alias_head = comments "type" -word_end ident -ws "~"
rule type_alias TypeAlias = (
    &type_alias_head cs:comments d:type_alias_body &tail:source_item_tail tc:stmt_end
) => TypeAlias{Name: $d.Name, Type: $d.Type, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule type_def TypeDef = (
    cs:comments d:type_def_body &tail:source_item_tail tc:stmt_end
) => TypeDef{Name: $d.Name, Type: $d.Type, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
// A body starts at the keyword and ends before the statement separator.
// Its typed node retains the actual parse span without repeating recovery.
rule type_alias_body TypeAliasBody = (
    "type" -word_end #cut name:ident -ws "~" -ws t:(type_expr @error(message="expected type"))
) => TypeAliasBody{Name: $name, Type: $t}
rule type_def_body TypeDefBody = (
    "type" -word_end #cut name:(ident @error(message="expected type name")) -ws
    -(("=" -ws &("{" / "node[")) @error(message="expected '= {', '= node[' or '~'"))
    t:(struct_type / node_type)
) => TypeDefBody{Name: $name, Type: $t}
// The node type of a named node type takes one type argument.
rule node_type TypeApp = (
    &"node[" name:ident "[" {ml := true} -ws arg:type_expr -ws ","? -ws
    -("]" @error(message="a node type takes one type argument"))
) => TypeApp{Name: $name, Args: list($arg)}
rule field_spec FieldSpec = !(comments "}") f:(field #recover(skip=field_sync)) => $f
rule field Field = (
    cs:comments d:field_body &tail:source_item_tail tc:field_end
) => Field{Name: $d.Name, Type: $d.Type, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule field_body FieldBody = (
    name:(ident @error(message="expected field name")) -ws t:(type_expr @error(message="expected field type"))
) => FieldBody{Name: $name, Type: $t}
rule type_expr Type = #operators {
    skip ws
    operand bottom
    operand !retired_type name:ident args:type_args => TypeApp{Name: $name, Args: $args}
    operand !retired_type name:ident => TypeRef{Name: $name}
    operand t:type_group => $t
    operand t:struct_type => $t
    level join { infix left "|" => JoinType{L: $lhs, R: $rhs} }
    level meet { infix left "&" => MeetType{L: $lhs, R: $rhs} }
    level prefix {
        prefix "[]" => ListType{Type: $rhs}
        prefix "*" => OptionalType{Type: $rhs}
    }
}

// An unnamed struct type has the fields of a struct definition.
rule struct_type StructType = (
    "{" {ml := false} &head:source_head_open fields:(f:field_spec)* cs:comments
    -("}" @error(message="expected closing brace for struct"))
) => StructType{Fields: map($fields, (x) => x.$f), Comments: $cs, Head: $head}

// The node type names of earlier versions, and terminal, are not types.
rule retired_type = ("terminal" / "Match" / "Seq" / "List" / "Operator" / "Error") !ident_char

// The brackets of type arguments follow the name directly.
rule type_args []Type = (
    "[" {ml := true} -ws first:type_expr rest:(-ws "," -ws t:type_expr)* -ws ","? -ws "]"
) => concat(list($first), map($rest, (x) => x.$t))

// A rule of its own keeps ml from reaching the rest of the type. Parentheses
// around one type without a comma group it; any other parentheses form a tuple.
rule type_group Type = type_paren / type_tuple
rule type_paren TypeGroup = "(" {ml := true} -ws t:type_expr -ws ")" => TypeGroup{Type: $t}
rule type_tuple TupleType = (
    "(" {ml := true} -ws ts:(t:type_expr -ws "," -ws)* last:type_expr? -ws ")"
) => TupleType{Types: concat(map($ts, (x) => x.$t), filter(list($last), (x) => x != nil)).([]Type)}

// A variable definition gives a name, a type, an initial value, or a type with a value.
rule var_decl VarDef = (
    cs:comments d:var_def_body &tail:source_item_tail tc:stmt_end
) => VarDef{Name: $d.Name, Type: $d.Type, Value: $d.Value, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule var_def_body VarDefBody = (
    "var" -word_end #cut name:(ident @error(message="expected variable name")) t:var_type? v:var_value?
) => VarDefBody{Name: $name, Type: $t, Value: $v}
// The whitespace before the type and the value belongs to them, so a declaration with neither
// ends at its name and does not take in a trailing comment.
rule var_type Type = -ws t:type_expr => $t
rule var_value ActionExpr = -ws "=" -ws a:(action_expr @error(message="expected the initial value")) => $a

// Rule expressions. The empty infix operator represents adjacency, so
// juxtaposition does not need a separate sequence parser or require a space.
rule rule_decl RuleDef = (
    cs:comments d:rule_def_body &tail:source_item_tail tc:stmt_end
) => RuleDef{
    Attrs: $d.Attrs,
    Name: $d.Name,
    Type: $d.Type,
    Expr: $d.Expr,
    Action: $d.Action,
    Comments: concat($cs, $d.AttrComments, $tc),
    SourceSpan: $d,
    Source: $tail,
}
rule rule_def_body RuleDefBody = (
    attrs:(a:attr gap:decl_attr_gap)*
    "rule" -word_end #cut name:(ident @error(message="expected rule name")) -ws t:type_expr? -ws
    -("=" @error(message="expected '=' after rule header")) -ws x:(ops_rule_body / rule_expr)
    @error(message="expected rule expression") a:trailing_action?
) => RuleDefBody{
    Attrs: map($attrs, (x) => x.$a),
    AttrComments: foldl(list(), $attrs, (all, x) => concat(all, x.$gap)),
    Name: $name,
    Type: $t,
    Expr: $x,
    Action: $a,
}
// Declaration attributes may share a line; the last one ends its line before "rule".
rule decl_attr_gap []Comment = decl_attr_same_line / decl_attr_line_end
rule decl_attr_same_line []Comment = cs:horizontal &"@" => $cs
rule decl_attr_line_end []Comment = cs:horizontal -nl rest:comments => concat($cs, $rest)
rule whole_action Action = "=>" -ws a:(action @error(message="expected value action after '=>'")) => $a
// The spacing before an action belongs to the action, so a rule without one ends at its expression.
rule trailing_action Action = -ws a:whole_action => $a
rule rule_expr RuleExpr = #operators {
    skip ws
    operand rule_group / predicate / level_call / bottom / top / begin_input / begin_line / end_input / end_line / any / cut / string / char_class / rule_ref
    level ordered_choice { infix left "/" => Choice{L: $lhs, R: $rhs} }
    level sequence { infix left _ => Sequence{L: $lhs, R: $rhs} }
    level prefix {
        prefix name:ident ":" => Capture{Name: $name, Expr: $rhs}
        prefix "&" / "!" => Lookahead{Op: text($op), X: $rhs}
        prefix "-" !("-" / ">") => Discard{X: $rhs}
    }
    level suffix {
        postfix "?" => Optional{X: $lhs}
        postfix "*" => ZeroOrMore{X: $lhs}
        postfix "+" => OneOrMore{X: $lhs}
        postfix "#atomic" !ident_char (empty_args / !("(")) => Atomic{X: $lhs}
        postfix "#stream" !ident_char (empty_args / !("(")) => Stream{X: $lhs}
        postfix "#missing" !ident_char !("(") => MissingPragma{X: $lhs}
        postfix "#ignorecase" !ident_char !("(") => IgnoreCase{X: $lhs}
        postfix "#repeat" !ident_char bounds:repeat_args => Repeat{X: $lhs, Min: $bounds.Min, Max: $bounds.Max, Range: $bounds.Range}
        postfix "#recover" !ident_char sync:recover_args => Recover{X: $lhs, Skip: $sync}
        postfix a:attr => Attributed{X: $lhs, Attr: $a}
    }
}
rule rule_group RuleGroup = (
    "(" {ml := true} -ws x:(inline_action / rule_expr) -ws
    -(")" @error(message="expected closing parenthesis for rule group"))
) => RuleGroup{Expr: $x}
rule inline_action InlineAction = x:rule_expr -ws "=>" -ws a:action => InlineAction{Expr: $x, Action: $a}
rule rule_ref RuleRef = name:ident !"(" => RuleRef{Name: $name}
rule level_call LevelCall = (
    "level(" {ml := true} -ws #cut name:(ident @error(message="expected target rule in level call")) -ws
    -("," @error(message="expected comma in level call")) -ws
    lev:(ident @error(message="expected level name")) -ws
    -(")" @error(message="expected closing parenthesis for level call"))
) => LevelCall{Rule: $name, Level: $lev}
rule top Top = ("_" !ident_char) #atomic
rule bottom Bottom = ("_|_") #atomic
rule begin_input BeginInput = ("^^") #atomic
rule begin_line BeginLine = ("^") #atomic
rule end_input EndInput = ("$$") #atomic
rule end_line EndLine = ("$" !(ident_start / digit)) #atomic
rule any Any = (".") #atomic
rule cut Cut = ("#cut" !ident_char !"(") #atomic
rule predicate Predicate = b:action_block => Predicate{Actions: $b.Actions, Comments: $b.Comments}

// Postfix pragmas have dedicated payloads. Metadata attributes retain ordered
// positional slots and named arguments, including explicit and omitted nils.
type RepeatBounds = { Min *Int; Max *Int; Range bool }
rule repeat_args RepeatBounds = (
    "(" {ml := true} -ws b:(repeat_range / repeat_count) -ws
    -(")" @error(message="expected closing parenthesis for #repeat"))
) => $b
rule repeat_range RepeatBounds = repeat_from / repeat_to
rule repeat_from RepeatBounds = min:repeat_int -ws "," -ws max:repeat_int? => RepeatBounds{Min: $min, Max: $max, Range: true}
rule repeat_to RepeatBounds = "," -ws max:repeat_int => RepeatBounds{Max: $max, Range: true}
rule repeat_count RepeatBounds = n:repeat_int => RepeatBounds{Min: $n, Max: $n, Range: false}
rule repeat_int Int = (digit+ / "-" -ws "0"+ !digit) #atomic
rule recover_args RuleExpr = (
    "(" {ml := true} -ws -("skip" @error(message="expected skip= in #recover")) -word_end
    -("=" @error(message="expected '=' after skip")) -ws x:rule_expr -ws
    -(")" @error(message="expected closing parenthesis for #recover"))
) => $x
rule empty_args = "(" {ml := true} -ws ")"
rule attr Attr = (
    "@" name:(ident @error(message="expected attribute name")) args:(attr_args / attr_no_args)
) => Attr{Name: $name, Args: $args.Args, KwArgs: $args.KwArgs}
rule attr_args AttrArgs = (
    "(" {ml := true} -ws a:(attr_no_values / attr_named_args / attr_mixed_args) -ws
    -(")" @error(message="expected closing parenthesis for attribute arguments"))
) => $a
rule attr_named_args AttrArgs = (
    first:attr_named rest:(-ws "," -ws n:attr_named)* (-ws "," -ws)?
) => AttrArgs{Args: list(), KwArgs: concat(list($first), map($rest, (x) => x.$n))}
rule attr_mixed_args AttrArgs = (
    first:attr_slot rest:(-ws "," -ws a:attr_slot)* named:(attr_named_tail / attr_trailing_comma)
) => AttrArgs{Args: concat(list($first.Value), map($rest, (x) => x.$a.Value)), KwArgs: $named.KwArgs}
rule attr_no_args AttrArgs = !"(" => AttrArgs{Args: list(), KwArgs: list()}
rule attr_no_values AttrArgs = &")" => AttrArgs{Args: list(), KwArgs: list()}
rule attr_trailing_comma AttrArgs = (-ws "," -ws)? => AttrArgs{Args: list(), KwArgs: list()}
rule attr_named_tail AttrArgs = -ws "," -ws n:attr_named_args => $n
rule attr_slot AttrSlot = !(ident -ws "=") v:attr_value => AttrSlot{Value: $v}
rule attr_named AttrNamed = (
    name:ident -ws "=" -ws v:(attr_value @error(message="expected attribute argument value"))
) => AttrNamed{Name: $name, Value: $v}
rule attr_value AttrValue = true_lit / false_lit / nil_lit / signed_int / string / rule_expr
rule signed_int Int = (("-" -ws)? digit+ #atomic) #atomic

// #ignorecase may follow the block of an Operators Rule on its line, and covers the literals of the
// whole rule. No other pragma may.
rule ops_rule_body RuleExpr = ops_rule_ignorecase / ops_rule_plain
rule ops_rule_ignorecase IgnoreCase = o:ops_rule_expr -ws "#ignorecase" !ident_char !("(") => IgnoreCase{X: $o}
rule ops_rule_plain OperatorsRule = o:ops_rule_expr -(-ws &("#" !("ignorecase" !ident_char)) _|_ @error(message="only #ignorecase may follow an Operators Rule"))? => $o
// Operators Rule items and each level recover independently. An absent level
// name remains nil; level(rule, name) can target only named levels.
rule ops_rule_expr OperatorsRule = (
    "#operators" !ident_char -ws &"{" #cut "{" {ml := false} &head:source_head_open items:(i:ops_stmt)*
    cs:comments -("}" @error(message="expected closing brace for operators"))
) => OperatorsRule{Items: map($items, (x) => x.$i), Comments: $cs, Head: $head}
rule ops_stmt OperatorsStmt = (
    !(comments "}")
    s:((ops_skip_stmt / ops_operand_stmt / ops_level_stmt / _|_ @error(message="expected skip, operand, or level")) #recover(skip=item_sync))
) => $s
rule ops_skip_stmt OperatorsSkip = (
    cs:comments d:ops_skip_body &tail:source_item_tail tc:item_end
) => OperatorsSkip{Expr: $d.Expr, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule ops_skip_body OperatorsSkipBody = (
    "skip" -word_end #cut x:(rule_expr @error(message="expected skip expression"))
) => OperatorsSkipBody{Expr: $x}
rule ops_operand_stmt OperatorsOperand = (
    cs:comments d:ops_operand_body &tail:source_item_tail tc:item_end
) => OperatorsOperand{Expr: $d.Expr, Action: $d.Action, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule ops_operand_body OperatorsOperandBody = (
    "operand" -word_end #cut x:(rule_expr @error(message="expected operand expression")) a:trailing_action?
) => OperatorsOperandBody{Expr: $x, Action: $a}
rule ops_level_stmt OperatorsLevel = (
    cs:comments d:ops_level_body &tail:source_item_tail end:item_end
) => OperatorsLevel{Name: $d.Name, Operators: $d.Operators, Comments: concat($cs, $d.Comments, $end), Head: $d.Head, SourceSpan: $d, Source: $tail}
rule ops_level_body OperatorsLevelBody = (
    "level" -word_end #cut name:ident? -ws
    -("{" @error(message="expected opening brace for level")) &head:source_head_open xs:(o:ops_operator)*
    tc:comments -("}" @error(message="expected closing brace for level"))
) => OperatorsLevelBody{Name: $name, Operators: map($xs, (x) => x.$o), Head: $head, Comments: $tc}
rule ops_operator OpsOperator = (
    !(comments "}")
    s:((ops_prefix / ops_postfix / ops_infix / _|_ @error(message="expected prefix, postfix, or infix")) #recover(skip=item_sync))
) => $s
rule ops_prefix Prefix = (
    cs:comments d:ops_prefix_body &tail:source_item_tail tc:item_end
) => Prefix{Expr: $d.Expr, Action: $d.Action, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule ops_prefix_body OperatorsOperatorBody = (
    "prefix" -word_end #cut x:(rule_expr @error(message="expected prefix expression")) a:trailing_action?
) => OperatorsOperatorBody{Assoc: "", Expr: $x, Action: $a}
rule ops_postfix Postfix = (
    cs:comments d:ops_postfix_body &tail:source_item_tail tc:item_end
) => Postfix{Expr: $d.Expr, Action: $d.Action, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule ops_postfix_body OperatorsOperatorBody = (
    "postfix" -word_end #cut x:(rule_expr @error(message="expected postfix expression")) a:trailing_action?
) => OperatorsOperatorBody{Assoc: "", Expr: $x, Action: $a}
rule ops_infix Infix = (
    cs:comments d:ops_infix_body &tail:source_item_tail tc:item_end
) => Infix{Assoc: $d.Assoc, Expr: $d.Expr, Action: $d.Action, Comments: concat($cs, $tc), SourceSpan: $d, Source: $tail}
rule ops_infix_body OperatorsOperatorBody = (
    "infix" -word_end #cut
    assoc:(("left" / "right" / "none") @error(message="expected left, right, or none associativity"))
    -word_end x:(rule_expr @error(message="expected infix expression")) a:trailing_action?
) => OperatorsOperatorBody{Assoc: text($assoc), Expr: $x, Action: $a}

// Predicate Actions and Value Actions share statement syntax. The source AST
// retains unsupported blocks for later compilation checks.
rule action Action = default_action / action_block / action_expr
rule default_action DefaultAction = ("...") #atomic
rule action_block ActionBlock = (
    "{" {ml := false} xs:(s:action_block_stmt)* cs:comments
    -("}" @error(message="expected closing brace for action block"))
) => ActionBlock{Actions: map($xs, (x) => x.$s), Comments: $cs}
rule action_block_stmt ActionStmt = !(comments "}") x:(action_block_value #recover(skip=item_sync)) => $x
rule action_block_value ActionStmt = -comments x:action_stmt -item_end => $x
rule action_stmt ActionStmt = action_bind_stmt / action_expr
rule action_bind_stmt ActionBind = (
    name:ident -ws ":=" -ws x:(action_expr @error(message="expected binding value"))
) => ActionBind{Name: $name, Expr: $x}
rule action_expr ActionExpr = lambda / action_ops
rule action_ops ActionExpr = #operators {
    skip (!(ws "[" !"]") ws)
    operand list_constructor / constructor / call / action_tuple / action_group / int / string / true_lit / false_lit / nil_lit / capture_ref / var_ref
    level disjunction { infix left "||" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
    level conjunction { infix left "&&" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
    level comparison { infix none "==" / "!=" / "<=" / ">=" / "<" / ">" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
    level addition { infix left "+" / "-" !("-" / ">") => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
    level multiplication { infix left "*" / "/" / "%" => BinaryOp{Op: text($op), L: $lhs, R: $rhs} }
    level unary { prefix "-" !"-" / "!" !"=" => UnaryOp{Op: text($op), X: $rhs} }
    // x[i] indexes a list. The "[" of an index follows its operand directly: the skip leaves
    // white space and comments before a "[" unconsumed, so "x [i]" is an error. A list
    // constructor starts with "[]" and keeps its skip.
    level field_access {
        postfix "." -ws c:capture_ref => CaptureAccess{X: $lhs, Capture: $c}
        postfix "." -ws t:cast_type => Cast{X: $lhs, Type: $t}
        postfix "." -ws name:ident => FieldAccess{X: $lhs, Name: $name}
        postfix i:index_suffix => BinaryOp{Op: "[]", L: $lhs, R: $i}
    }
}
// The brackets of an index open their own delimiter, and a rule of its own keeps ml from
// reaching the rest of the action.
rule index_suffix ActionExpr = "[" {ml := true} -ws i:action_expr -ws "]" => $i
// A rule of its own keeps ml from reaching the rest of the action.
rule cast_type Type = "(" {ml := true} -ws t:type_expr -ws ")" => $t
rule lambda Lambda = names:lambda_head -ws "=>" -ws x:action_expr => Lambda{Params: $names, Body: $x}
// A rule of its own keeps ml from reaching the arrow and the body.
rule lambda_head []Ident = "(" {ml := true} -ws names:lambda_params? -ws ")" => concat($names)
rule lambda_params []Ident = first:lambda_param rest:(-ws "," -ws name:lambda_param)* (-ws ",")? => concat(list($first), map($rest, (x) => x.$name))
// A parameter cannot take the name of a literal, which the literal would hide.
rule lambda_param Ident = !((true_lit / false_lit / nil_lit) -ws &("," / ")")) i:ident => $i
// Parentheses around one expression without a comma group it; any other
// parentheses form a tuple. The tuple rules fail on a group without an error.
rule action_tuple ActionTuple = action_unit / action_elems
rule action_unit ActionTuple = "(" {ml := true} -ws ")" => ActionTuple{Elems: []ActionExpr{}}
rule action_elems ActionTuple = (
    "(" {ml := true} -ws xs:(e:action_expr -ws "," -ws)+ last:action_expr? -ws
    -(")" @error(message="expected closing parenthesis for tuple"))
) => ActionTuple{Elems: concat(map($xs, (x) => x.$e), filter(list($last), (x) => x != nil)).([]ActionExpr)}
rule action_group ActionGroup = (
    "(" {ml := true} -ws x:action_expr -ws
    -(")" @error(message="expected closing parenthesis for action expression"))
) => ActionGroup{Expr: $x}
rule call Call = (
    name:var_name "(" {ml := true} -ws #cut args:action_args? -ws
    -(")" @error(message="expected closing parenthesis for function call"))
) => Call{X: $name, Args: concat($args)}
rule action_args []ActionExpr = (
    first:action_expr rest:(-ws "," -ws x:action_expr)* (-ws "," -ws)?
) => concat(list($first), map($rest, (x) => x.$x))
rule list_constructor ListConstructor = (
    "[]" -ws #cut elem:level(type_expr, prefix) -ws
    -("{" @error(message="expected opening brace for list constructor")) {ml := true} -ws
    items:action_args? cs:comments -("}" @error(message="expected closing brace for list constructor"))
) => ListConstructor{Elem: $elem, Items: concat($items), Comments: $cs}
rule constructor Constructor = (
    name:var_name -ws "{" &head:source_head_open {ml := true} -ws #cut (fields:constructor_fields / args:action_args)? cs:comments
    -("}" @error(message="expected closing brace for constructor"))
) => Constructor{X: $name, Inits: concat($fields), Args: concat($args), Comments: $cs, Head: $head}
rule constructor_fields []InitField = (
    first:init_field rest:(-ws "," -ws f:init_field)* (-ws "," -ws)?
) => concat(list($first), map($rest, (x) => x.$f))
rule init_field InitField = (
    cs:comments d:init_field_body &tail:source_comma_tail
) => InitField{Name: $d.Name, Val: $d.Val, Comments: $cs, SourceSpan: $d, Source: $tail}
rule init_field_body InitFieldBody = (
    name:(ident @error(message="expected initializer field name")) -ws -":" -ws
    x:(action_expr @error(message="expected initializer value"))
) => InitFieldBody{Name: $name, Val: $x}
rule int Int = digit+ #atomic
rule true_lit True = ("true" !ident_char) #atomic
rule false_lit False = ("false" !ident_char) #atomic
rule nil_lit Nil = ("nil" !ident_char) #atomic
rule capture_ref CaptureRef = ("$" ident #atomic) #atomic
rule var_name VarRef = (ident) #atomic
rule var_ref VarRef = (ident !"(") #atomic

// Trivia. Space is discarded before and after each retained comment, keeping
// the resulting list homogeneous without introducing nil whitespace elements.
rule ws []Comment = ({ml} cs:comments / cs:horizontal) => $cs
rule comments []Comment = -space* xs:(c:comment -space*)* => map($xs, (x) => x.$c)
rule horizontal []Comment = -space_no_line* xs:(c:(line_comment / block_no_line) -space_no_line*)* => map($xs, (x) => x.$c)
rule word_end = !ident_char -ws
rule space_no_line = !nl space
rule nl = "\r\n" / [\r\n]
rule space = [ \t\n\u{b}\u{c}\r\u{85}\u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}]
// A lexical comment view retains trivia inside parsing and action expressions.
// Incomplete tokens remain available to the error-recovering structural pass.
rule source_comments []Comment = -source_non_comment* xs:(c:comment -source_non_comment*)* $$ => map($xs, (x) => x.$c)
rule source_non_comment = source_string / source_class / incomplete_comment / !("//" / "/*") .
rule source_string = "\"" ("\\" . / [^"\\\n])* "\""?
rule source_class = "[" ("\\" . / [^\]\\\n])* "]"?
rule incomplete_comment = !inline_comment "/*" .* $$
rule comment Comment = comment_group / inline_comment
rule comment_group CommentGroup = (
    first:comment_line rest:(-nl -space_no_line* c:comment_line)*
) => CommentGroup{Lines: concat(list($first), map($rest, (x) => x.$c))}
rule line_comment CommentGroup = c:comment_line => CommentGroup{Lines: list($c)}
rule comment_line node[string] = ("//" [^\n\r]*) #atomic
rule inline_comment InlineComment = (
    start:"/*" body:(inline_comment / !("/*" / "*/") .)* #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule block_no_line InlineComment = (
    start:"/*" body:(block_no_line / !("/*" / "*/" / nl) .)* #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule block_with_line InlineComment = (
    start:"/*"
    body:((block_no_line / !("/*" / "*/" / nl) .)* (nl / block_with_line) (inline_comment / !("/*" / "*/") .)*)
    #atomic end:"*/"
) => InlineComment{Start: $start, Body: $body, End: $end}
rule ident Ident = (ident_start ident_char*) #atomic
rule ident_start = [a-zA-Z_]
rule ident_char = [a-zA-Z0-9_]
rule digit = [0-9]
rule string String = ("\"" ("\\" escape_char / [^"\\\n])* "\"" #atomic ("i" !ident_char)?) #atomic
rule char_class CharClass = (
    "[" not:"^"? items:(char_class_rng / char_class_chr)+
    -("]" @error(message="expected closing bracket for character class"))
) => CharClass{Not: $not != nil, Items: $items.Value}
rule char_class_rng CharRng = start:char_class_chr "-" !"]" end:char_class_chr => CharRng{Start: $start, End: $end}
rule char_class_chr Char = ("\\" escape_char / [^\]\\\n]) #atomic
rule escape_char = "u{" [0-9a-fA-F]+ "}" / "u" [0-9a-fA-F] #repeat(4) / [ntrfvab0] / [^a-zA-Z0-9]

// Normalized declaration ownership, independent of raw formatter comments.
// The lookahead rules never fail, so recording ownership cannot change what a
// statement accepts: an unrecognizable boundary has no comments and no next owner.
rule source_head SourceLead = b:(source_remaining / source_empty_boundary) => SourceLead{Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_head_open SourceLead = b:(source_after_delimiter_boundary / source_empty_boundary) => SourceLead{Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_empty_boundary SourceBoundary = _ => SourceBoundary{Trailing: list(), Leading: "", Detached: list(), HasNext: false}

// The boundary after a statement. A separator, when present, is a token of its own
// with its own boundary after it: a trailing group there follows the groups before
// the separator, and the next sibling's leading groups come from the boundary after it.
rule source_item_tail SourceItem = (
    source_tail_after_separator_trailing / source_tail_after_separator / source_tail_plain / source_tail_empty
)
rule source_tail_after_separator_trailing SourceItem = (
    t1:source_after_boundary source_semis t2:source_after_boundary_trailing
) => SourceItem{Trailing: concat($t1.Trailing, $t2.Trailing).([]string), Next: SourceLead{Leading: $t2.Leading, Detached: $t2.Detached, HasNext: $t2.HasNext}}
rule source_tail_after_separator SourceItem = (
    t1:source_after_boundary source_semis t2:source_after_boundary
) => SourceItem{Trailing: $t1.Trailing, Next: SourceLead{Leading: $t2.Leading, Detached: $t2.Detached, HasNext: $t2.HasNext}}
rule source_tail_plain SourceItem = (
    t:source_after_boundary
) => SourceItem{Trailing: $t.Trailing, Next: SourceLead{Leading: $t.Leading, Detached: $t.Detached, HasNext: $t.HasNext}}
rule source_tail_empty SourceItem = _ => SourceItem{Trailing: list(), Next: SourceLead{Leading: "", Detached: list(), HasNext: false}}
rule source_semis = ";" (-source_trivia* ";")*
rule source_trivia = source_space / source_line_comment / source_block_comment
// Constructor fields have a comma as their separator.
rule source_comma_tail SourceItem = (
    source_comma_after_separator_trailing / source_comma_after_separator / source_tail_plain / source_tail_empty
)
rule source_comma_after_separator_trailing SourceItem = (
    source_after_boundary "," t2:source_after_boundary_trailing
) => SourceItem{Trailing: $t2.Trailing, Next: SourceLead{Leading: $t2.Leading, Detached: $t2.Detached, HasNext: $t2.HasNext}}
rule source_comma_after_separator SourceItem = (
    t1:source_after_boundary "," t2:source_after_opener_boundary
) => SourceItem{Trailing: $t1.Trailing, Next: SourceLead{Leading: $t2.Leading, Detached: $t2.Detached, HasNext: $t2.HasNext}}

rule source_after_boundary SourceBoundary = (
    source_inline_line_boundary / source_inline_run_boundary / source_inline_block_boundary / source_ambiguous_block_boundary
    / source_newline_boundary / source_remaining
)
rule source_inline_line_boundary SourceBoundary = (
    -source_horizontal c:source_line_comment b:source_remaining
) => SourceBoundary{Trailing: list($c.Text), Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
// The comments on the line of the previous token all trail it when a line break or
// the end of the scope follows them: block comments, then at most one line comment.
rule source_inline_run_boundary SourceBoundary = (
    xs:(-source_horizontal c:source_block_comment)+ y:source_run_tail b:source_remaining
) => SourceBoundary{Trailing: concat(map($xs, (x) => x.$c.Text), $y).([]string), Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_run_tail []string = source_run_line / source_run_end
rule source_run_line []string = -source_horizontal c:source_line_comment => list($c.Text)
rule source_run_end []string = &(source_horizontal (source_nl / source_scope_end)) => list()
rule source_inline_block_boundary SourceBoundary = (
    -source_horizontal c:source_block_comment &(source_horizontal (source_nl / source_comment_start / source_scope_end))
    b:source_remaining
) => SourceBoundary{Trailing: list($c.Text), Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
// The boundary after an opening delimiter or a comma. One inline block ending on
// the next token's line leads that token there.
rule source_after_opener_boundary SourceBoundary = (
    source_inline_line_boundary / source_inline_run_boundary / source_inline_block_boundary / source_opener_block_boundary
    / source_newline_boundary / source_remaining
)
rule source_opener_block_boundary SourceBoundary = (
    -source_horizontal c:source_block_comment -source_horizontal &source_next_token
) => SourceBoundary{Trailing: list(), Leading: $c.Text, Detached: list(), HasNext: true}
// The boundary after an opening delimiter, which is not a node. The comments on its line lead
// the next token as if they were on lines of their own; before a closing delimiter they stay
// the group of the delimiter.
rule source_after_delimiter_boundary SourceBoundary = source_delimiter_scope_boundary / source_remaining
rule source_delimiter_scope_boundary SourceBoundary = &source_scope_run b:source_after_opener_boundary => $b
rule source_scope_run = -source_space* (source_comment -source_space*)* source_scope_end
// One inline block ending on the next token's line is ambiguous, not trailing.
rule source_ambiguous_block_boundary SourceBoundary = (
    -source_horizontal c:source_block_comment -source_horizontal &source_next_token
) => SourceBoundary{Trailing: list(), Leading: "", Detached: list($c), HasNext: true}
rule source_newline_boundary SourceBoundary = (
    -source_horizontal -source_nl -source_horizontal c:source_first_trailing b:source_remaining
) => SourceBoundary{Trailing: list($c.Text), Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
// A boundary that has a trailing group, even an empty one. After a separator it
// replaces the trailing group found before the separator.
rule source_after_boundary_trailing SourceBoundary = (
    source_inline_line_boundary / source_inline_run_boundary / source_inline_block_boundary / source_newline_trailing_boundary
)
rule source_newline_trailing_boundary SourceBoundary = (
    -source_horizontal -source_nl -source_horizontal c:source_first_trailing b:source_remaining
) => SourceBoundary{Trailing: list($c.Text), Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}

// A first standalone group can trail the previous declaration when a blank
// line, another group, or the end of a scope flushes it before the next token.
rule source_first_trailing SourceComment = (
    c:source_line_group &source_line_flush / c:source_block_comment &source_block_flush
) => $c
rule source_remaining SourceBoundary = source_scope_tail / source_next_boundary
rule source_scope_tail SourceBoundary = (
    -source_space* xs:(c:source_comment -source_space*)* &source_scope_end
) => SourceBoundary{Trailing: list(), Leading: "", Detached: map($xs, (x) => x.$c), HasNext: false}
rule source_next_boundary SourceBoundary = (
    -source_space* detached:(c:source_detached_group -source_space*)* lead:(source_leading_group / source_empty_comment) -source_space* &source_next_token
) => SourceBoundary{Trailing: list(), Leading: $lead.Text, Detached: map($detached, (x) => x.$c), HasNext: true}
rule source_empty_comment SourceComment = _ => SourceComment{Text: ""}
rule source_detached_group SourceComment = (
    c:source_line_group &source_line_flush / c:source_block_comment &source_block_flush
) => $c
rule source_leading_group SourceComment = c:source_comment -source_space* &source_next_token => $c
rule source_line_flush = source_horizontal (source_nl / "/*" / source_scope_end)
rule source_block_flush = source_horizontal (source_nl source_horizontal (source_nl / source_comment_start / source_scope_end) / source_comment_start / source_scope_end)
rule source_next_token = !(source_space / source_comment_start / source_scope_end) .
rule source_scope_end = ")" / "]" / "}" / ";" / $$
rule source_comment_start = "//" / "/*"
rule source_comment SourceComment = source_line_group / source_block_comment
rule source_line_group SourceComment = (
    first:source_line_comment rest:(-source_horizontal c:source_line_comment)*
) => SourceComment{Text: foldl($first.Text, $rest, (s, x) => s + x.$c.Text)}
rule source_line_comment SourceComment = "//" body:[^\r\n]* end:source_nl? => SourceComment{Text: text($body) + text($end)}
rule source_block_comment SourceComment = (
    "/*" first:source_block_line rest:(line:source_nl -source_horizontal -source_block_star? body:source_block_line)* "*/"
) => SourceComment{Text: foldl($first.Text, $rest, (s, x) => s + text(x.$line) + x.$body.Text)}
rule source_block_star = "*" !"/"
rule source_block_line SourceComment = xs:(c:source_block_piece)* => SourceComment{Text: foldl("", $xs, (s, x) => s + x.$c.Text)}
rule source_block_piece SourceComment = source_nested_piece / source_character_piece
rule source_nested_piece SourceComment = c:source_block_comment => SourceComment{Text: "/*" + $c.Text + "*/"}
rule source_character_piece SourceComment = c:(!(source_nl / "*/" / "/*") .) #atomic => SourceComment{Text: text($c)}
rule source_nl = "\r\n" / [\r\n]
rule source_horizontal = source_horizontal_char*
rule source_horizontal_char = [ \t\u{b}\u{c}\u{85}\u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}]
rule source_space = source_horizontal_char / source_nl

// Every gap between tokens that holds a comment, in source order. Tokens are
// the characters between trivia; strings and classes hide comment markers.
// A gap at the start of the input has no token before it and so no trailing
// group. The scan never fails, so recording gaps cannot change what is accepted.
rule source_gaps []CommentGap = (
    head:source_gap_head? -source_gap_skip* xs:((-source_delimiter_char g:source_delimiter_gap / -"," g:source_open_gap / g:source_gap) -source_gap_skip*)* $$
) => concat(filter(list($head), (x) => x != nil), map($xs, (x) => x.$g)).([]CommentGap)
// A bracket directly after a name, ")", "]" or "}" is a bracket, not a character class.
rule source_gap_skip = !source_gap_opens (source_string / source_bracket / source_class / incomplete_comment / (source_space+ !(source_line_comment / source_block_comment)) / !(source_space / source_comment_start) .)
// An opening delimiter or a comma followed by a comment: the gap after it belongs to the opener.
rule source_gap_opens = source_open_char &source_gap_run
rule source_open_char = source_bracket / [({,]
rule source_delimiter_char = source_bracket / [({]
rule source_bracket = (ident_char / ")" / "]" / "}") "["
// A gap starts with a comment, after any space, and runs to the next token.
rule source_gap_run = -source_space* (source_line_comment / source_block_comment) (source_space / source_line_comment / source_block_comment)*
rule source_gap_head CommentGap = (
    ^^ &source_gap_run &b:(source_remaining / source_empty_boundary) -source_gap_run
) => CommentGap{Trailing: list(), HasTrailing: false, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_gap CommentGap = (
    &source_gap_run &b:(source_after_boundary / source_empty_boundary) t:source_gap_flag? -source_gap_run
) => CommentGap{Trailing: $b.Trailing, HasTrailing: $t != nil, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_open_gap CommentGap = (
    &source_gap_run &b:(source_after_opener_boundary / source_empty_boundary) t:source_gap_flag? -source_gap_run
) => CommentGap{Trailing: $b.Trailing, HasTrailing: $t != nil, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_delimiter_gap CommentGap = (
    &source_gap_run &b:(source_after_delimiter_boundary / source_empty_boundary) t:source_gap_flag? -source_gap_run
) => CommentGap{Trailing: $b.Trailing, HasTrailing: $t != nil, Leading: $b.Leading, Detached: $b.Detached, HasNext: $b.HasNext}
rule source_gap_flag GapFlag = &source_after_boundary_trailing => GapFlag{}
