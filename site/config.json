    "/docs/optimizations/080-inline-eligible-typed-pratt-lines/": "/docs/optimizations/080-inline-eligible-typed-operators-rule-lines/",
    "/docs/guide/runtime/": "/docs/guide/running-parsers/",
    "/docs/guide/trees-and-actions/": "/docs/guide/shaping-trees/",
    "/docs/guide/expressions/": "/docs/guide/operators-rule/",
