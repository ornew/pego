  "defaults": [
    {
      "match": [
        "README.md",
        "playground/**"
      ],
      "values": {
        "nav": false,
        "search": false
      }
    },
    {
      "match": [
        "docs/optimizations/*.md",
        "docs/optimizations/mechanisms/*.md"
      ],
      "values": {
        "nav": false
      }
    },
    {
      "match": [
        "docs/optimizations/README.md"
      ],
      "values": {
        "nav": true,
        "navTitle": "Optimizations"
      }
    },
    {
      "match": [
        "docs/design/README.md"
      ],
      "values": {
        "navTitle": "Overview"
      }
    }
  ],
  "recordIndexes": [
    {
      "source": "docs/design/README.md",
      "directory": "docs/design",
      "title": "Design Records",
      "introduction": "Each record explains a decision in the design of PEGO and the alternatives that were considered.",
      "includeTemplate": true,
      "tableClass": "design-index",
      "columns": [
        {
          "title": "Record",
          "field": "Title"
        },
        {
          "title": "Status",
          "field": "Status"
        },
        {
          "title": "Date",
          "field": "Date"
        }
      ]
    }
  ],
  "pagerOrder": [
    "docs/design/README.md",
    "examples/README.md",
    "docs/development.md",
    "docs/benchmarks.md",
    "docs/performance.md",
    "docs/optimizations/README.md",
    "docs/commit-messages.md",
    "docs/design/*.md",
    "docs/ref*.md",
    "docs/site.md"
  ],
  "redirects": {
    "/spec/pratt/": "/spec/operators-rule/",
    "/docs/design/005-pratt-expressions/": "/docs/design/005-operators-rule/",
    "/docs/design/050-pratt-skip-control/": "/docs/design/050-operators-rule-skip-control/",
