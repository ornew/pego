{
  "title": "PEGO",
  "lang": "en",
  "repository": "https://github.com/ornew/pego",
  "branch": "main",
  "include": [
    "README.md",
    "docs/**/*.md",
    "spec/*.md",
    "examples/README.md",
    "parsers/README.md",
    "parsers/*/README.md",
    "reference/**/*.md",
    "playground/README.md"
  ],
  "exclude": [
    "**/TEMPLATE.md",
    "docs/optimizations/000-template.md"
  ],
  "prettyURLs": true,
  "directoryLinks": true,
  "repositoryLinks": true,
  "bundledAssets": false,
  "staticDir": "site/static",
  "template": "site/templates/layout.html",
  "tocDepth": 3,
  "pager": "site",
  "markdown": {
    "rawHTML": true,
    "alerts": true,
    "headingLinks": true,
    "headingIDs": "github",
    "alignAttributes": true
  },
  "searchIndex": {
    "path": "search-index.json",
    "text": "html",
    "section": "group",
    "fields": {
      "title": "t",
      "url": "u",
      "section": "s",
      "headings": "h",
      "text": "x"
    }
  },
  "redirectRules": false,
  "sections": [
