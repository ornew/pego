        "examples/README.md",
        "docs/development.md",
        "docs/benchmarks.md",
        "docs/performance.md",
        "docs/optimizations/README.md"
      ],
      "children": [
        {
          "title": "Design Records",
          "match": [
            "docs/design/*.md"
          ],
          "first": [
            "docs/design/README.md"
          ],
          "collapsed": true
        }
      ]
    }
